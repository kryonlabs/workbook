// Exercises the Workbook desktop app on a private X display.
//
// The app runs only under xvfb-run with DISPLAY and WAYLAND_DISPLAY removed,
// so the test can never send input to a real desktop. It checks one captured
// frame, then edits cells with the keyboard and mouse and reads automatic
// and explicit saves back with the headless cell command. Run it from the
// repository root after `make`.
#load "test_support.zi";
#load "csv_table.zi";
#load "screenshot.zi";

RawCurrentDirectory :: (output: *u8, size: u64) -> *u8 #foreign libc "getcwd";
RawChangeDirectory :: (path: *u8) -> s32 #foreign libc "chdir";

AppPath :: "build/workbook-desktop";
CellPath :: "build/cell";
FixturePath :: "tests/fixtures/operators.gnumeric";
WindowName :: "Kryon Ziran";
PrivateMarker :: "WORKBOOK_TEST_PRIVATE_DISPLAY";

// Grid geometry from src/app.zi, in window pixels.
GridLeft :: 76;
GridTop :: 128;
ColumnWidth :: 110;
RowHeight :: 28;

// The toolbar buttons all share one row; the sheet tabs sit under the grid.
ToolbarY :: 30;
TabY :: 538;
TabLeft :: 24;
TabWidth :: 104;

Background :: 0xF8FAFC;
// The fixture theme below is #f8fafc with ink #1e2530, base white, and a
// #3070e0 accent; the app derives its header and selection from those.
HeaderFill :: 0xEDEFF2;
SelectedFill :: 0xCCDCF6;
White :: 0xFFFFFF;

TwoSheets :: #string END
<?xml version="1.0" encoding="UTF-8"?>
<gnm:Workbook xmlns:gnm="http://www.gnumeric.org/v10.dtd">
  <gnm:SheetNameIndex><gnm:SheetName>First</gnm:SheetName><gnm:SheetName>Second</gnm:SheetName></gnm:SheetNameIndex>
  <gnm:Sheets>
    <gnm:Sheet><gnm:Name>First</gnm:Name><gnm:MaxCol>0</gnm:MaxCol><gnm:MaxRow>0</gnm:MaxRow>
      <gnm:Cells><gnm:Cell Row="0" Col="0" ValueType="40">1</gnm:Cell></gnm:Cells>
    </gnm:Sheet>
    <gnm:Sheet><gnm:Name>Second</gnm:Name><gnm:MaxCol>0</gnm:MaxCol><gnm:MaxRow>0</gnm:MaxRow>
      <gnm:Cells><gnm:Cell Row="0" Col="0" ValueType="40">2</gnm:Cell></gnm:Cells>
    </gnm:Sheet>
  </gnm:Sheets>
</gnm:Workbook>
END;

MenuWorkbook :: #string END
<?xml version="1.0" encoding="UTF-8"?>
<gnm:Workbook xmlns:gnm="http://www.gnumeric.org/v10.dtd">
  <gnm:SheetNameIndex><gnm:SheetName>Menu</gnm:SheetName></gnm:SheetNameIndex>
  <gnm:Sheets><gnm:Sheet><gnm:Name>Menu</gnm:Name><gnm:MaxCol>12</gnm:MaxCol><gnm:MaxRow>29</gnm:MaxRow>
    <gnm:Cells>
      <gnm:Cell Row="0" Col="0" ValueType="40">7</gnm:Cell>
      <gnm:Cell Row="1" Col="1" ValueType="40">11</gnm:Cell>
      <gnm:Cell Row="7" Col="10" ValueType="40">42</gnm:Cell>
      <gnm:Cell Row="29" Col="12" ValueType="40">1</gnm:Cell>
    </gnm:Cells>
  </gnm:Sheet></gnm:Sheets>
</gnm:Workbook>
END;

app_pid: s32 = 0;
window_id: [64]u8;
data_directory: [4096]u8;
saved_path: [4096]u8;
log_path: [4096]u8;
absolute_cell_path: [4096]u8;

DesktopAppPath :: () -> string {
    override: string = Environment("WORKBOOK_TEST_APP")
    if override.count > 0 { return override }
    return AppPath
}

HeadlessCellPath :: () -> string {
    if absolute_cell_path[0] != 0 { return TextUntilNul(absolute_cell_path[:]) }
    return CellPath
}

// ---------------------------------------------------------------- xdotool

// Runs xdotool with up to six arguments after its name; empty ones are
// skipped. Any failure stops the test.
Xdotool :: (a: string, b: string, c: string, d: string, e: string, f: string) {
    arguments: [7]string
    count: s32 = 1
    arguments[0] = "xdotool"
    if a.count > 0 {
        arguments[count] = a
        count += 1
    }
    if b.count > 0 {
        arguments[count] = b
        count += 1
    }
    if c.count > 0 {
        arguments[count] = c
        count += 1
    }
    if d.count > 0 {
        arguments[count] = d
        count += 1
    }
    if e.count > 0 {
        arguments[count] = e
        count += 1
    }
    if f.count > 0 {
        arguments[count] = f
        count += 1
    }
    if RunQuiet(arguments[0:count]) != 0 {
        WriteText(2, "xdotool ")
        WriteText(2, a)
        WriteText(2, " failed\n")
        ShowLog()
        Fail("an input event could not be sent")
    }
}

NumberText :: (buffer: []u8, value: s32) -> string {
    SetText(buffer, "")
    AppendNumber(buffer, value)
    return TextUntilNul(buffer)
}

WindowId :: () -> string {
    return TextUntilNul(window_id[:])
}

ShowLog :: () {
    log: [8192]u8
    length: s32 = ReadWholeFile(TextUntilNul(log_path[:]), log[:])
    if length > 0 {
        WriteText(2, "--- the app's output:\n")
        WriteText(2, TextView(log[0:length]))
        WriteText(2, "\n---\n")
    }
}

Key :: (name: string) {
    Xdotool("key", name, "", "", "", "")
    SleepMilliseconds(200)
}

TypeText :: (text: string) {
    Xdotool("type", "--delay", "90", text, "", "")
    SleepMilliseconds(250)
}

MoveMouse :: (x: s32, y: s32) {
    x_text: [16]u8
    y_text: [16]u8
    Xdotool("mousemove", "--window", WindowId(), NumberText(x_text[:], x),
        NumberText(y_text[:], y), "")
    SleepMilliseconds(200)
}

// Clicks a button. It is held for a few frames, as a hand holds it: a Kryon
// button activates on a release that follows a press it saw.
Press :: (x: s32, y: s32) {
    MoveMouse(x, y)
    Xdotool("mousedown", "1", "", "", "", "")
    SleepMilliseconds(120)
    Xdotool("mouseup", "1", "", "", "", "")
    SleepMilliseconds(300)
}

// Opens the cell menu with the secondary button, held for a few frames.
RightClick :: (x: s32, y: s32) {
    MoveMouse(x, y)
    Xdotool("mousedown", "3", "", "", "", "")
    SleepMilliseconds(120)
    Xdotool("mouseup", "3", "", "", "", "")
    SleepMilliseconds(400)
}

QuickRightClick :: (x: s32, y: s32) {
    MoveMouse(x, y)
    Xdotool("click", "3", "", "", "", "")
    SleepMilliseconds(400)
}

// Capture our private test window, including the open menu. Force RGB8 so the
// same PNG reader used by the frame test can inspect it.
ExpectMenuVisible :: (x: s32, y: s32, width: s32, height: s32) {
    path: [4096]u8
    SetText(path[:], TextUntilNul(data_directory[:]))
    AppendText(path[:], "/menu.png")
    output: [4096]u8
    SetText(output[:], "PNG24:")
    AppendText(output[:], TextUntilNul(path[:]))
    command: [7]string = .{"import", "-window", WindowId(), "-depth", "8",
        "-silent", TextUntilNul(output[:])}
    Check(RunQuiet(command[:]) == 0, "cannot capture the cell menu")
    failure: [256]u8
    Check(ReadScreenshot(TextUntilNul(path[:]), failure[:]), TextUntilNul(failure[:]))
    Check(screenshot_width == width && screenshot_height == height,
        "the desktop window did not resize")
    Check(PixelAt(x + 150, y + 8) == White, "the cell menu panel is not visible")
    Check(DarkPixels(x + 12, y + 4, 48, 26) > 10, "the Cut option is not visible")
    Check(DarkPixels(x + 12, y + 30, 48, 26) > 10, "the Copy option is not visible")
    Check(DarkPixels(x + 12, y + 82, 48, 26) > 10, "the Clear option is not visible")
}

// Chooses a command in the menu just opened at (x, y): its rows are 26 high,
// starting 4 below the pointer, and it opens with Cut, Copy, Paste.
MenuCommand :: (x: s32, y: s32, row: s32) {
    Press(x + 30, y + 17 + row * 26)
}

CellCenterX :: (column: s32) -> s32 {
    return GridLeft + column * ColumnWidth + ColumnWidth / 2
}

CellCenterY :: (row: s32) -> s32 {
    return GridTop + row * RowHeight + RowHeight / 2
}

ClickCell :: (row: s32, column: s32) {
    Press(CellCenterX(column), CellCenterY(row))
}

DoubleClickCell :: (row: s32, column: s32) {
    MoveMouse(CellCenterX(column), CellCenterY(row))
    Xdotool("click", "--repeat", "2", "--delay", "90", "1")
    SleepMilliseconds(300)
}

ToolbarX :: (name: string) -> s32 {
    if name == "Save" { return 42 }
    if name == "Insert row" { return 86 }
    if name == "Delete row" { return 130 }
    if name == "Insert column" { return 174 }
    if name == "Delete column" { return 218 }
    Fail("unknown toolbar button")
    return 0
}

ToolbarButton :: (name: string) {
    Press(ToolbarX(name), ToolbarY)
}

SheetTab :: (index: s32) {
    Press(TabLeft + TabWidth * index + TabWidth / 2, TabY)
}

Save :: () {
    Key("ctrl+s")
    SleepMilliseconds(400)
}

// ------------------------------------------------------------ the session

StartApp :: (directory: string) {
    SetEnvironment("WORKBOOK_DIR", directory)
    SetEnvironment("GELD_DIR", directory)
    LaunchApp(directory, directory)
}

LaunchApp :: (directory: string, data: string) {
    SetText(data_directory[:], directory)
    SetText(saved_path[:], data)
    AppendText(saved_path[:], "/workbook.gnumeric")
    SetText(log_path[:], directory)
    AppendText(log_path[:], "/app.log")
    UnsetEnvironment("KRYON_CAPTURE_PATH")
    command: [1]string = .{DesktopAppPath()}
    app_pid = Spawn(command[:], TextUntilNul(log_path[:]))
    Check(app_pid > 0, "the app could not be started")
    cleanup_pid = app_pid
    FindWindow()
    Xdotool("windowfocus", WindowId(), "", "", "", "")
    SleepMilliseconds(500)
}

FindWindow :: () {
    attempts: s32 = 0
    while attempts < 100 {
        output: [1024]u8
        search: [4]string = .{"xdotool", "search", "--name", WindowName}
        result: CaptureResult = Run(search[:], output[:])
        if result.code == 0 && result.length > 0 {
            end: s32 = 0
            while end < result.length && output[end] != 10 { end += 1 }
            SetText(window_id[:], TextView(output[0:end]))
            return
        }
        if !IsRunning(app_pid) {
            ShowLog()
            Fail("the app exited early")
        }
        SleepMilliseconds(100)
        attempts += 1
    }
    ShowLog()
    Fail("the app window did not appear")
}

// Quits the app with SIGTERM and returns its exit status.
StopApp :: () -> s32 {
    status: s32 = Terminate(app_pid)
    app_pid = 0
    cleanup_pid = 0
    return status
}

// -------------------------------------------------------------- the checks

// The saved workbook's first sheet, evaluated by the cell command, must begin
// with the expected rows (CSV text; empty cells at the end of a row may be
// left out).
ExpectRows :: (expected: string, message: string) {
    Check(PathExists(TextUntilNul(saved_path[:])), "the app did not write workbook.gnumeric")
    output: [65536]u8
    command: [3]string = .{HeadlessCellPath(), "eval", TextUntilNul(saved_path[:])}
    result: CaptureResult = Run(command[:], output[:])
    Check(result.code == 0 && !result.error && !result.truncated,
        "the cell command could not evaluate the saved workbook")
    Check(ParseCsv(0, TextView(output[0:result.length])), "the saved rows are too large")
    Check(ParseCsv(1, expected), "the expected rows are too large")
    heading: [512]u8
    SetText(heading[:], "FAIL: ")
    AppendText(heading[:], message)
    if !CompareCsv(CsvUsedRows(1), "saved", "expected", TextUntilNul(heading[:])) {
        Fail(message)
    }
    SayWith("edit: ", message)
}

// The saved workbook's sheets and their sizes, as `cell info` prints them.
ExpectSizes :: (expected: string, message: string) {
    output: [4096]u8
    command: [3]string = .{HeadlessCellPath(), "info", TextUntilNul(saved_path[:])}
    result: CaptureResult = Run(command[:], output[:])
    Check(result.code == 0 && !result.error, "the cell command could not read the saved workbook")
    actual: string = TextView(output[0:result.length])
    if actual != expected {
        WriteText(2, "sheets and sizes, expected:\n")
        WriteText(2, expected)
        WriteText(2, "got:\n")
        WriteText(2, actual)
        Fail(message)
    }
}

Drive :: (directory: string) -> s32 {
    Check(Environment(PrivateMarker) == "1",
        "the driver sends input events; run the desktop test, which starts it on a private display")
    StartApp(directory)

    // Typing over the selected cell starts an edit; Enter commits and moves
    // down. A formula recalculates from the cell above it.
    TypeText("5")
    Key("Return")
    TypeText("=A1*2")
    Key("Return")
    ExpectRows("5\n10\n", "typed values and a formula save automatically")

    // A click selects a cell; typing replaces its value.
    ClickCell(2, 2)
    TypeText("hello")
    Key("Return")
    ExpectRows("5\n10\n,,hello\n", "click, type, and autosave")

    // Escape leaves a cell as it was.
    ClickCell(0, 1)
    TypeText("zzz")
    Key("Escape")
    ExpectRows("5\n10\n,,hello\n", "Escape cancels an edit")

    // A double click edits the existing formula in place.
    DoubleClickCell(1, 0)
    TypeText("+1")
    Key("Return")
    ExpectRows("5\n11\n,,hello\n", "double click edits a formula")

    // Delete clears the selected cell; the formula below follows it. The
    // export starts at the first row that shows anything, which is now A2.
    ClickCell(0, 0)
    Key("Delete")
    ExpectRows("1\n,,hello\n", "Delete clears a cell")

    // The toolbar buttons edit the sheet's structure at the selection.
    // "hello" sits in row 3 and column C, so the sheet is 3 by 3.
    ExpectSizes("1 sheet(s)\nSheet1: 3 rows x 3 cols\n", "the sheet starts 3 by 3")
    ClickCell(1, 1)
    ToolbarButton("Insert row")
    ExpectSizes("1 sheet(s)\nSheet1: 4 rows x 3 cols\n", "Insert row adds a row")
    ToolbarButton("Delete row")
    ExpectSizes("1 sheet(s)\nSheet1: 3 rows x 3 cols\n", "Delete row removes it")
    ToolbarButton("Insert column")
    ExpectSizes("1 sheet(s)\nSheet1: 3 rows x 4 cols\n", "Insert column adds a column")
    ToolbarButton("Delete column")
    ExpectSizes("1 sheet(s)\nSheet1: 3 rows x 3 cols\n", "Delete column removes it")
    Say("edit: toolbar buttons insert and delete rows and columns")

    // The secondary button opens a menu on the cell under it. Copy takes
    // "hello" from C3 to the system clipboard and Paste puts it in D1.
    RightClick(CellCenterX(2), CellCenterY(2))
    MenuCommand(CellCenterX(2), CellCenterY(2), 1)
    RightClick(CellCenterX(3), CellCenterY(0))
    MenuCommand(CellCenterX(3), CellCenterY(0), 2)
    ExpectRows(",,,hello\n1\n,,hello\n", "the cell menu copies and pastes")
    // Cut takes "hello" out of C3, leaving it on the clipboard.
    RightClick(CellCenterX(2), CellCenterY(2))
    MenuCommand(CellCenterX(2), CellCenterY(2), 0)
    ExpectRows(",,,hello\n1\n", "the cell menu cuts")
    Say("edit: the cell menu copies, pastes, and cuts")

    Check(StopApp() == 0, "the app did not exit cleanly")
    Say("session: the app exited cleanly on SIGTERM")
    return 0
}

DriveTabs :: (directory: string) -> s32 {
    Check(Environment(PrivateMarker) == "1",
        "the driver sends input events; run the desktop test, which starts it on a private display")
    saved: [4096]u8
    SetText(saved[:], directory)
    AppendText(saved[:], "/workbook.gnumeric")
    Check(WriteWholeFile(TextUntilNul(saved[:]), TwoSheets), "cannot write the two-sheet workbook")
    StartApp(directory)
    ExpectSizes("2 sheet(s)\nFirst: 1 rows x 1 cols\nSecond: 1 rows x 1 cols\n", "two sheets to start")

    // The second tab makes that sheet current: an edit lands in it.
    SheetTab(1)
    ClickCell(2, 1)
    TypeText("7")
    Key("Return")
    ExpectSizes("2 sheet(s)\nFirst: 1 rows x 1 cols\nSecond: 3 rows x 2 cols\n", "the second tab edits the second sheet")

    // And back: the first sheet takes the next edit.
    SheetTab(0)
    ClickCell(0, 3)
    TypeText("4")
    Key("Return")
    ExpectSizes("2 sheet(s)\nFirst: 1 rows x 4 cols\nSecond: 3 rows x 2 cols\n", "the first tab edits the first sheet")
    Say("tabs: each tab edits its own sheet")

    Check(StopApp() == 0, "the app did not exit cleanly")
    return 0
}

// Geld must keep the last edit through a restart without Enter or Save, and
// must ignore a generic workbook in its launch directory. A fresh XDG base
// also exercises creation of all the missing data-directory parents.
DriveAutosave :: (directory: string) -> s32 {
    Check(Environment(PrivateMarker) == "1",
        "the autosave driver requires the desktop test's private display")
    root: [4096]u8
    Check(RawCurrentDirectory(*root[0], 4096) != null, "cannot find the repository directory")
    SetText(absolute_cell_path[:], TextUntilNul(root[:]))
    AppendText(absolute_cell_path[:], "/")
    AppendText(absolute_cell_path[:], CellPath)
    app: string = DesktopAppPath()
    if app[0] != #char "/" {
        absolute_app: [4096]u8
        SetText(absolute_app[:], TextUntilNul(root[:]))
        AppendText(absolute_app[:], "/")
        AppendText(absolute_app[:], app)
        SetEnvironment("WORKBOOK_TEST_APP", TextUntilNul(absolute_app[:]))
    }
    import_directory: [4096]u8
    SetText(import_directory[:], directory)
    AppendText(import_directory[:], "/import")
    Check(MakeDirectory(TextUntilNul(import_directory[:])), "cannot create the legacy data directory")
    legacy: [4096]u8
    SetText(legacy[:], TextUntilNul(import_directory[:]))
    AppendText(legacy[:], "/workbook.json")
    legacy_text: string = "{\"rows\":[{\"label\":\"original\",\"units\":5}]}\n"
    Check(WriteWholeFile(TextUntilNul(legacy[:]), legacy_text), "cannot write the legacy workbook")
    generic: [4096]u8
    SetText(generic[:], directory)
    AppendText(generic[:], "/workbook.gnumeric")
    Check(WriteWholeFile(TextUntilNul(generic[:]), TwoSheets), "cannot write the generic workbook")
    xdg: [4096]u8
    SetText(xdg[:], directory)
    AppendText(xdg[:], "/fresh/nested/share")
    geld: [4096]u8
    SetText(geld[:], TextUntilNul(xdg[:]))
    AppendText(geld[:], "/geld")
    SetEnvironment("WORKBOOK_PROFILE", "geld")
    SetEnvironment("XDG_DATA_HOME", TextUntilNul(xdg[:]))
    UnsetEnvironment("WORKBOOK_DIR")
    UnsetEnvironment("GELD_DIR")
    // Launch from beside the generic workbook; it must not become Geld's data.
    working_directory: [4096]u8
    Check(CopyCString(directory, working_directory[:]) &&
        RawChangeDirectory(*working_directory[0]) == 0, "cannot enter the profile test directory")
    LaunchApp(directory, TextUntilNul(geld[:]))
    TypeText("23")
    ExpectRows("23\n", "Geld autosaves an active edit in its own fresh data directory")
    Check(StopApp() == 0, "the autosave app did not exit cleanly")
    LaunchApp(directory, TextUntilNul(geld[:]))
    Key("Return")
    TypeText("+1")
    Key("Return")
    ExpectSavedCell(0, 0, "23+1")
    ClickCell(0, 0)
    TypeText("discard")
    Key("Escape")
    ExpectSavedCell(0, 0, "23+1")
    ClickCell(0, 1)
    TypeText("keep")
    ClickCell(1, 1)
    ExpectSavedCell(0, 1, "keep")
    Key("Delete")
    ClickCell(0, 1)
    Key("Delete")
    ExpectSavedCell(0, 1, "")
    Check(StopApp() == 0, "the autosave app did not exit cleanly")

    // Any other named profile keeps its own data directory the same way.
    budget: [4096]u8
    SetText(budget[:], TextUntilNul(xdg[:]))
    AppendText(budget[:], "/budget")
    SetEnvironment("WORKBOOK_PROFILE", "budget")
    LaunchApp(directory, TextUntilNul(budget[:]))
    TypeText("7")
    ExpectRows("7\n", "a named profile autosaves in its own fresh data directory")
    Check(StopApp() == 0, "the named profile app did not exit cleanly")
    SetEnvironment("WORKBOOK_PROFILE", "geld")

    // An explicit Geld directory imports its legacy JSON once and writes the
    // full spreadsheet format while preserving the original JSON.
    SetEnvironment("GELD_DIR", TextUntilNul(import_directory[:]))
    LaunchApp(directory, TextUntilNul(import_directory[:]))
    steps: s32 = 0
    while steps < 8 {
        Key("Right")
        steps += 1
    }
    TypeText("beyond legacy columns")
    ExpectSavedCell(0, 1, "original")
    ExpectSavedCell(0, 3, "5")
    ExpectSavedCell(0, 8, "beyond legacy columns")
    Check(StopApp() == 0, "the legacy import app did not exit cleanly")
    LaunchApp(directory, TextUntilNul(import_directory[:]))
    ExpectSavedCell(0, 8, "beyond legacy columns")
    ClickCell(0, 1)
    TypeText("updated")
    Save()
    ExpectSavedCell(0, 1, "updated")
    Check(StopApp() == 0, "the reloaded import app did not exit cleanly")
    original: [4096]u8
    length: s32 = ReadWholeFile(TextUntilNul(legacy[:]), original[:])
    Check(length == cast(s32)legacy_text.count && TextView(original[0:length]) == legacy_text,
        "autosaving changed the legacy JSON")

    // A temporarily unavailable data directory must retain pending changes
    // and retry even when the user does not edit again.
    blocker: [4096]u8
    SetText(blocker[:], directory)
    AppendText(blocker[:], "/blocked")
    Check(WriteWholeFile(TextUntilNul(blocker[:]), "temporarily unavailable\n"),
        "cannot create the unavailable-directory fixture")
    retry_directory: [4096]u8
    SetText(retry_directory[:], TextUntilNul(blocker[:]))
    AppendText(retry_directory[:], "/geld")
    SetEnvironment("GELD_DIR", TextUntilNul(retry_directory[:]))
    LaunchApp(directory, TextUntilNul(retry_directory[:]))
    TypeText("retry")
    Check(!PathExists(TextUntilNul(saved_path[:])), "the unavailable directory accepted a save")
    Check(RemoveFile(TextUntilNul(blocker[:])), "cannot restore the data directory")
    SleepMilliseconds(3000)
    ExpectSavedCell(0, 0, "retry")
    Check(StopApp() == 0, "the retry app did not exit cleanly")
    UnsetEnvironment("WORKBOOK_PROFILE")
    UnsetEnvironment("GELD_DIR")
    Say("autosave: live edits, restart, cancellation, selection, Geld and named profile isolation, legacy import, and retry passed")
    return 0
}

ExpectSavedCell :: (row: s32, column: s32, expected: string) {
    saved: *Engine.Workbook = Engine.WorkbookNew()
    Check(Engine.WorkbookLoadFile(saved, cast(*s8)*saved_path[0]) != 0,
        "cannot read the menu test's saved workbook")
    source: *s8 = Engine.WorkbookCellText(saved, 0, row, column)
    actual: string = ""
    if source != null { actual = TextFromCString(cast(*u8)source) }
    Check(actual == expected, "the cell menu changed the wrong cell")
    Engine.WorkbookFree(saved)
}

HeaderWorkbook :: #string END
<?xml version="1.0"?><gnm:Workbook xmlns:gnm="http://www.gnumeric.org/v10.dtd"><gnm:SheetNameIndex><gnm:SheetName>Headers</gnm:SheetName></gnm:SheetNameIndex><gnm:Sheets><gnm:Sheet><gnm:Name>Headers</gnm:Name><gnm:MaxCol>2</gnm:MaxCol><gnm:MaxRow>20</gnm:MaxRow><gnm:Cells><gnm:Cell Row="0" Col="0" ValueType="40">11</gnm:Cell><gnm:Cell Row="0" Col="1" ValueType="40">12</gnm:Cell><gnm:Cell Row="1" Col="1" ValueType="40">22</gnm:Cell><gnm:Cell Row="20" Col="1" ValueType="40">212</gnm:Cell></gnm:Cells></gnm:Sheet></gnm:Sheets></gnm:Workbook>
END;

RowMenuWorkbook :: #string END
<?xml version="1.0"?><gnm:Workbook xmlns:gnm="http://www.gnumeric.org/v10.dtd"><gnm:Sheets><gnm:Sheet><gnm:Name>Rows</gnm:Name><gnm:Cells><gnm:Cell Row="0" Col="1" ValueType="40">12</gnm:Cell><gnm:Cell Row="1" Col="1" ValueType="40">22</gnm:Cell><gnm:Cell Row="1" Col="2">=B2*2</gnm:Cell><gnm:Cell Row="20" Col="1" ValueType="40">212</gnm:Cell></gnm:Cells></gnm:Sheet></gnm:Sheets></gnm:Workbook>
END;

LargeHeaderWorkbook :: #string END
<?xml version="1.0"?><gnm:Workbook xmlns:gnm="http://www.gnumeric.org/v10.dtd"><gnm:Sheets><gnm:Sheet><gnm:Name>Large</gnm:Name><gnm:Cells><gnm:Cell Row="0" Col="0" ValueType="40">1</gnm:Cell><gnm:Cell Row="1" Col="40" ValueType="40">88</gnm:Cell><gnm:Cell Row="220" Col="1" ValueType="40">99</gnm:Cell></gnm:Cells></gnm:Sheet></gnm:Sheets></gnm:Workbook>
END;

ReadOwnedWindowScreenshot :: (path: string) {
    output: [4096]u8; SetText(output[:], "PNG24:"); AppendText(output[:], path)
    command: [7]string = .{"import", "-window", WindowId(), "-depth", "8", "-silent", TextUntilNul(output[:])}
    Check(RunQuiet(command[:]) == 0, "cannot capture the private test window")
    failure: [256]u8
    Check(ReadScreenshot(path, failure[:]), TextUntilNul(failure[:]))
}

// Header clicks select complete axes, including cells beyond the visible grid.
DriveHeaders :: (directory: string) -> s32 {
    Check(Environment(PrivateMarker) == "1", "header checks require the private display")
    fixture: [4096]u8; SetText(fixture[:],directory); AppendText(fixture[:],"/workbook.gnumeric")
    Check(WriteWholeFile(TextUntilNul(fixture[:]),HeaderWorkbook),"cannot write header fixture"); StartApp(directory)
    Press(GridLeft+ColumnWidth+55,GridTop-15)
    capture: [4096]u8; SetText(capture[:],directory); AppendText(capture[:],"/headers.png")
    ReadOwnedWindowScreenshot(TextUntilNul(capture[:]))
    Check(PixelAt(GridLeft+ColumnWidth+90,GridTop+7*RowHeight+20)==SelectedFill,"column selection includes every visible row")
    Check(PixelAt(GridLeft+90,GridTop+7*RowHeight+20)==White,"adjacent column stays unselected")
    Key("ctrl+c"); ClickCell(0,2); Key("ctrl+v"); Save()
    {
    bytes: [65536]u8; evaluate: [3]string=.{HeadlessCellPath(),"eval",TextUntilNul(saved_path[:])}
    result:=Run(evaluate[:],bytes[:]); Check(result.code==0 && ParseCsv(0,TextView(bytes[:result.length])),"cannot read copied column")
    Check(CsvCellText(0,0,2)=="12" && CsvCellText(0,1,2)=="22" && CsvCellText(0,20,2)=="212","copy includes offscreen column cells")
    Press(GridLeft+ColumnWidth+55,GridTop-15); Key("Delete"); Save()
    result=Run(evaluate[:],bytes[:]); Check(result.code==0 && ParseCsv(0,TextView(bytes[:result.length])),"cannot read cleared column")
    Check(CsvCellText(0,0,1)=="" && CsvCellText(0,1,1)=="" && CsvCellText(0,20,1)=="","delete clears the entire column")
    Check(CsvCellText(0,0,0)=="11" && CsvCellText(0,20,2)=="212","column delete preserves neighboring columns")
    Press(GridLeft-30,GridTop+14); Key("Delete"); Save()
    result=Run(evaluate[:],bytes[:]); Check(result.code==0 && ParseCsv(0,TextView(bytes[:result.length])),"cannot read cleared row")
    // CSV export begins at the first nonempty row, now row 2.
    Check(CsvCellText(0,0,0)=="" && CsvCellText(0,0,2)=="22","row number selects the whole row")
    Check(CsvCellText(0,19,2)=="212","row delete preserves other rows")
    Check(StopApp()==0,"header test app exits cleanly")
    }

    // Right-clicking a row number targets that row, regardless of the active cell.
    Check(WriteWholeFile(TextUntilNul(fixture[:]),RowMenuWorkbook),"cannot write row menu fixture"); StartApp(directory)
    x: s32 = cast(s32)(GridLeft-30); y:=CellCenterY(1)
    QuickRightClick(x,y)
    ReadOwnedWindowScreenshot(TextUntilNul(capture[:]))
    Check(DarkPixels(x+12,y+4,110,26)>10 && DarkPixels(x+12,y+30,110,26)>10,"both insertion options are visible")
    Check(PixelAt(GridLeft+3*ColumnWidth+90,CellCenterY(1))==SelectedFill,"right-click selects the complete row")
    copied: [3]string=.{"cp",TextUntilNul(capture[:]),"build/row-menu.png"}; Check(RunQuiet(copied[:])==0,"cannot keep private row menu preview")
    MenuCommand(x,y,0); Save()
    ExpectSavedCell(0,1,"12"); ExpectSavedCell(1,1,""); ExpectSavedCell(2,1,"22"); ExpectSavedCell(2,2,"=B3*2"); ExpectSavedCell(21,1,"212")
    y=CellCenterY(2); RightClick(x,y); MenuCommand(x,y,1); Save()
    ExpectSavedCell(2,1,"22"); ExpectSavedCell(3,1,""); ExpectSavedCell(2,2,"=B3*2"); ExpectSavedCell(22,1,"212")
    y=CellCenterY(3); QuickRightClick(x,y); MenuCommand(x,y,2); Save()
    ExpectSavedCell(2,1,"22"); ExpectSavedCell(21,1,"212")
    Check(StopApp()==0,"row menu test app exits cleanly")

    // Whole selections also cover imported cells past the editor's view limits.
    Check(WriteWholeFile(TextUntilNul(fixture[:]),LargeHeaderWorkbook),"cannot write large header fixture"); StartApp(directory)
    Press(GridLeft-30,CellCenterY(1)); Key("Delete"); Save()
    ExpectSavedCell(1,40,""); ExpectSavedCell(220,1,"99")
    Press(GridLeft+ColumnWidth+55,GridTop-15); Key("Delete"); Save()
    ExpectSavedCell(220,1,""); ExpectSavedCell(0,0,"1")
    Check(StopApp()==0,"large header test app exits cleanly")
    Say("headers: whole selections, offscreen cells, row insert above/below, formulas and neighboring data passed"); return 0
}

DriveMenus :: (directory: string) -> s32 {
    Check(Environment(PrivateMarker) == "1",
        "the menu driver requires the desktop test's private display")
    fixture: [4096]u8
    SetText(fixture[:], directory)
    AppendText(fixture[:], "/workbook.gnumeric")
    Check(WriteWholeFile(TextUntilNul(fixture[:]), MenuWorkbook), "cannot write the menu fixture")
    manager_log: [4096]u8
    SetText(manager_log[:], directory)
    AppendText(manager_log[:], "/window-manager.log")
    manager_command: [3]string = .{"xfwm4", "--sm-client-disable", "--compositor=off"}
    manager_pid: s32 = Spawn(manager_command[:], TextUntilNul(manager_log[:]))
    Check(manager_pid > 0, "cannot start the private window manager")
    SleepMilliseconds(500)
    StartApp(directory)
    Xdotool("windowmove", WindowId(), "20", "20", "", "")

    helper_log: [4096]u8
    SetText(helper_log[:], directory)
    AppendText(helper_log[:], "/focus-helper.log")
    helper_command: [6]string = .{"xmessage", "-title", "WorkbookFocusProbe",
        "-geometry", "180x70+1400+900", "Private focus test"}
    helper_pid: s32 = Spawn(helper_command[:], TextUntilNul(helper_log[:]))
    Check(helper_pid > 0, "cannot start the focus helper")
    helper_window: [64]u8
    attempts: s32 = 0
    while attempts < 100 {
        output: [1024]u8
        search: [5]string = .{"xdotool", "search", "--onlyvisible", "--name",
            "^WorkbookFocusProbe$"}
        result: CaptureResult = Run(search[:], output[:])
        if result.code == 0 && result.length > 0 {
            end: s32 = 0
            while end < result.length && output[end] != 10 { end += 1 }
            SetText(helper_window[:], TextView(output[0:end]))
            break
        }
        SleepMilliseconds(100)
        attempts += 1
    }
    Check(helper_window[0] != 0, "the focus helper window did not appear")
    Xdotool("windowactivate", "--sync", TextUntilNul(helper_window[:]), "", "", "")
    SleepMilliseconds(200)

    // No windowfocus: the first right-click must both activate Workbook and
    // show the menu on B2, even though A1 was selected before losing focus.
    QuickRightClick(CellCenterX(1), CellCenterY(1))
    ExpectMenuVisible(CellCenterX(1), CellCenterY(1), 960, 600)
    MenuCommand(CellCenterX(1), CellCenterY(1), 1)
    QuickRightClick(CellCenterX(3), CellCenterY(0))
    MenuCommand(CellCenterX(3), CellCenterY(0), 2)
    Save()
    ExpectSavedCell(0, 3, "11")
    QuickRightClick(CellCenterX(1), CellCenterY(1))
    MenuCommand(CellCenterX(1), CellCenterY(1), 3)
    Save()
    ExpectSavedCell(1, 1, "")
    ExpectSavedCell(0, 0, "7")
    RightClick(CellCenterX(0), CellCenterY(0))
    ExpectMenuVisible(CellCenterX(0), CellCenterY(0), 960, 600)
    Key("Escape")

    // K8 is beyond the original window width. The resized drawing and input
    // coordinates must agree, and Clear must still act on that exact cell.
    Xdotool("windowsize", WindowId(), "1440", "900", "", "")
    SleepMilliseconds(500)
    QuickRightClick(CellCenterX(10), CellCenterY(7))
    ExpectMenuVisible(CellCenterX(10), CellCenterY(7), 1440, 900)
    MenuCommand(CellCenterX(10), CellCenterY(7), 3)
    Save()
    ExpectSavedCell(7, 10, "")
    ExpectSavedCell(0, 0, "7")
    Check(StopApp() == 0, "the menu test app did not exit cleanly")
    Terminate(helper_pid)
    Terminate(manager_pid)
    Say("menus: first focus click, visible options, clicked-cell commands, held clicks, and resize passed")
    return 0
}

// ------------------------------------------------------------ the frame check

CheckFrame :: (work: string) {
    directory: [4096]u8
    SetText(directory[:], work)
    AppendText(directory[:], "/frame")
    Check(MakeDirectory(TextUntilNul(directory[:])), "cannot create the frame directory")
    copy: [4096]u8
    SetText(copy[:], TextUntilNul(directory[:]))
    AppendText(copy[:], "/workbook.gnumeric")
    fixture: [65536]u8
    length: s32 = ReadWholeFile(FixturePath, fixture[:])
    Check(length > 0, "cannot read the fixture")
    Check(WriteWholeFile(TextUntilNul(copy[:]), TextView(fixture[0:length])),
        "cannot copy the fixture")
    capture: [4096]u8
    SetText(capture[:], work)
    AppendText(capture[:], "/frame.png")
    SetEnvironment("WORKBOOK_DIR", TextUntilNul(directory[:]))
    SetEnvironment("GELD_DIR", TextUntilNul(directory[:]))
    SetEnvironment("KRYON_CAPTURE_PATH", TextUntilNul(capture[:]))
    command: [5]string = .{"timeout", "120", "xvfb-run", "-a", DesktopAppPath()}
    Check(RunQuiet(command[:]) == 0, "the app could not render a frame")
    UnsetEnvironment("WORKBOOK_DIR")
    UnsetEnvironment("GELD_DIR")
    UnsetEnvironment("KRYON_CAPTURE_PATH")

    failure: [256]u8
    Check(ReadScreenshot(TextUntilNul(capture[:]), failure[:]), TextUntilNul(failure[:]))
    Check(screenshot_width == 960 && screenshot_height == 600, "the frame is not 960 by 600")
    Check(PixelAt(10, 10) == Background, "the window background")
    Check(PixelAt(GridLeft + 90, GridTop - 24) == HeaderFill, "the column header")
    // A1 is selected, B1 is not; the fixture fills A1 ("10") and B1
    // ("alpha") and leaves column F empty.
    Check(PixelAt(GridLeft + 90, GridTop + 20) == SelectedFill, "the selected cell A1")
    Check(PixelAt(GridLeft + ColumnWidth + 90, GridTop + 20) == White, "the unselected cell B1")
    Check(DarkPixels(GridLeft + 2, GridTop + 2, ColumnWidth - 4, RowHeight - 4) > 10,
        "the text of A1")
    Check(DarkPixels(GridLeft + 5 * ColumnWidth + 2, GridTop + 2, ColumnWidth - 4,
        RowHeight - 4) == 0, "the empty cell F1")
    Say("frame: layout, selection, and cell text rendered")
}

// ----------------------------------------------------------------- the run

RunSession :: (self: string, mode: string, directory: string) {
    output: [65536]u8
    command: [13]string = .{"timeout", "240", "xvfb-run", "-a", "-s",
        "-screen 0 1600x1000x24", "dbus-run-session", "--", "env",
        "WORKBOOK_TEST_PRIVATE_DISPLAY=1", self, mode, directory}
    result: CaptureResult = Run(command[:], output[:])
    WriteText(1, TextView(output[0:result.length]))
    Check(result.code == 0 && !result.error, "the desktop session failed")
}

// Points the desktop theme at a fixture, so the app's colors are known and the
// test never depends on the theme of whoever runs it.
InstallFixtureTheme :: (work: string) {
    config: [4096]u8
    data: [4096]u8
    path: [4096]u8
    SetText(config[:], work)
    AppendText(config[:], "/theme-config")
    SetText(data[:], work)
    AppendText(data[:], "/theme-data")
    Check(MakeDirectory(TextUntilNul(config[:])) && MakeDirectory(TextUntilNul(data[:])),
        "cannot create the theme directories")
    SetText(path[:], TextUntilNul(config[:]))
    AppendText(path[:], "/xfce4")
    Check(MakeDirectory(TextUntilNul(path[:])), "cannot create the xfce4 directory")
    AppendText(path[:], "/xfconf")
    Check(MakeDirectory(TextUntilNul(path[:])), "cannot create the xfconf directory")
    AppendText(path[:], "/xfce-perchannel-xml")
    Check(MakeDirectory(TextUntilNul(path[:])), "cannot create the xfconf channel directory")
    AppendText(path[:], "/xsettings.xml")
    Check(WriteWholeFile(TextUntilNul(path[:]),
        "<channel name=\"xsettings\" version=\"1.0\">\n  <property name=\"Net\" type=\"empty\">\n    <property name=\"ThemeName\" type=\"string\" value=\"Fixture\"/>\n  </property>\n</channel>\n"),
        "cannot write xsettings.xml")
    SetText(path[:], TextUntilNul(data[:]))
    AppendText(path[:], "/themes")
    Check(MakeDirectory(TextUntilNul(path[:])), "cannot create the themes directory")
    AppendText(path[:], "/Fixture")
    Check(MakeDirectory(TextUntilNul(path[:])), "cannot create the theme directory")
    AppendText(path[:], "/gtk-3.0")
    Check(MakeDirectory(TextUntilNul(path[:])), "cannot create the gtk-3.0 directory")
    AppendText(path[:], "/gtk.css")
    Check(WriteWholeFile(TextUntilNul(path[:]),
        "@define-color theme_bg_color #f8fafc;\n@define-color theme_fg_color #1e2530;\n@define-color theme_base_color #ffffff;\n@define-color theme_selected_bg_color #3070e0;\n@define-color theme_selected_fg_color #ffffff;\n"),
        "cannot write gtk.css")
    SetEnvironment("XDG_CONFIG_HOME", TextUntilNul(config[:]))
    SetEnvironment("XDG_DATA_HOME", TextUntilNul(data[:]))
    UnsetEnvironment("GTK_THEME")
}

RunAll :: (self: string, menus_only: bool, headers_only: bool = false) -> s32 {
    Check(OnPath("xdotool"), "install xdotool to test the desktop app")
    Check(OnPath("xvfb-run"), "install xvfb-run to test the desktop app")
    Check(OnPath("xfwm4") && OnPath("dbus-run-session") && OnPath("xmessage") &&
        OnPath("import"), "install xfwm4, dbus, x11-utils, and imagemagick to test cell menus")
    Check(IsExecutable(DesktopAppPath()), "the desktop app to test is missing")
    Check(IsExecutable(CellPath), "build first: build/cell is missing")
    // Nothing may reach a real display.
    UnsetEnvironment("DISPLAY")
    UnsetEnvironment("WAYLAND_DISPLAY")
    UnsetEnvironment("XAUTHORITY")
    UnsetEnvironment("KRYON_CAPTURE_PATH")
    UnsetEnvironment("DBUS_SESSION_BUS_ADDRESS")
    UnsetEnvironment("SESSION_MANAGER")
    UnsetEnvironment("SDL_MOUSE_FOCUS_CLICKTHROUGH")
    UnsetEnvironment("WORKBOOK_PROFILE")

    template: [4096]u8
    parent: string = Environment("TMPDIR")
    if parent.count == 0 { parent = "/tmp" }
    SetText(template[:], parent)
    AppendText(template[:], "/workbook-desktop-XXXXXX")
    work_buffer: [4096]u8
    work: string = MakeTemporaryDirectory(template[:])
    Check(work.count > 0, "cannot create a temporary directory")
    SetText(work_buffer[:], work)
    SetText(cleanup_directory[:], work)
    work = TextUntilNul(work_buffer[:])

    InstallFixtureTheme(work)
    if !menus_only && !headers_only {
        CheckFrame(work)
        edit: [4096]u8
        SetText(edit[:], work)
        AppendText(edit[:], "/edit")
        Check(MakeDirectory(TextUntilNul(edit[:])), "cannot create the edit directory")
        RunSession(self, "--drive", TextUntilNul(edit[:]))
        tabs: [4096]u8
        SetText(tabs[:], work)
        AppendText(tabs[:], "/tabs")
        Check(MakeDirectory(TextUntilNul(tabs[:])), "cannot create the tabs directory")
        RunSession(self, "--drive-tabs", TextUntilNul(tabs[:]))
        autosave: [4096]u8
        SetText(autosave[:], work)
        AppendText(autosave[:], "/autosave")
        Check(MakeDirectory(TextUntilNul(autosave[:])), "cannot create the autosave directory")
        RunSession(self, "--drive-autosave", TextUntilNul(autosave[:]))
    }
    headers: [4096]u8; SetText(headers[:],work); AppendText(headers[:],"/headers")
    Check(MakeDirectory(TextUntilNul(headers[:])),"cannot create header test directory")
    RunSession(self,"--drive-headers",TextUntilNul(headers[:]))
    if headers_only { RemoveTree(work); cleanup_directory[0]=0; return 0 }
    menus: [4096]u8
    SetText(menus[:], work)
    AppendText(menus[:], "/menus")
    Check(MakeDirectory(TextUntilNul(menus[:])), "cannot create the menus directory")
    RunSession(self, "--drive-menus", TextUntilNul(menus[:]))

    RemoveTree(work)
    cleanup_directory[0] = 0
    Say("desktop app: rendering, keyboard and mouse editing, and saving passed")
    return 0
}

#program_export
main :: (argc: s32, argv: **s8) -> s32 {
    if argc == 3 && TextFromCString(cast(*u8)argv[1]) == "--drive-headers" { return DriveHeaders(TextFromCString(cast(*u8)argv[2])) }
    if argc == 3 && TextFromCString(cast(*u8)argv[1]) == "--drive" {
        return Drive(TextFromCString(cast(*u8)argv[2]))
    }
    if argc == 3 && TextFromCString(cast(*u8)argv[1]) == "--drive-tabs" {
        return DriveTabs(TextFromCString(cast(*u8)argv[2]))
    }
    if argc == 3 && TextFromCString(cast(*u8)argv[1]) == "--drive-menus" {
        return DriveMenus(TextFromCString(cast(*u8)argv[2]))
    }
    if argc == 3 && TextFromCString(cast(*u8)argv[1]) == "--drive-autosave" {
        return DriveAutosave(TextFromCString(cast(*u8)argv[2]))
    }
    menus_only: bool = argc == 2 && TextFromCString(cast(*u8)argv[1]) == "--menu-only"
    headers_only: bool = argc == 2 && TextFromCString(cast(*u8)argv[1]) == "--headers-only"
    return RunAll(TextFromCString(cast(*u8)argv[0]), menus_only, headers_only)
}
