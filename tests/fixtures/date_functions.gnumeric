<gnm:Cell Row="5" Col="1">=WEEKDAY(DATE(2024,1,1))</gnm:Cell>
<gnm:Cell Row="6" Col="1">=DATE(2024,2,29)</gnm:Cell>
<gnm:Cell Row="7" Col="1">=EDATE(DATE(2023,1,31),1)</gnm:Cell>
<gnm:Cell Row="8" Col="1">=EOMONTH(DATE(2023,1,15),0)</gnm:Cell>
<gnm:Cell Row="9" Col="1">=DATEDIF(A2,A1,"d")</gnm:Cell>
<gnm:Cell Row="10" Col="1">=DATEDIF(A2,A1,"y")</gnm:Cell>
<gnm:Cell Row="11" Col="1">=DATEDIF(DATE(2020,3,15),DATE(2023,5,1),"m")</gnm:Cell>
<gnm:Cell Row="12" Col="1">=DAYS360(DATE(2023,1,1),DATE(2023,12,31))</gnm:Cell>
