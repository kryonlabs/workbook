<gnm:Cell Row="16" Col="1">=SECOND(TIME(13,45,30))</gnm:Cell>
<gnm:Cell Row="17" Col="1">=DATEVALUE("2023-05-15")</gnm:Cell>
<gnm:Cell Row="18" Col="1">=YEAR(DATEVALUE("2023/05/15"))</gnm:Cell>
