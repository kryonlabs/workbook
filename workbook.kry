#import "kryon.h"
#import "engine.h"
#import "kry_json.h"
#import "ctype.h"
#import "stdio.h"
#import "stdlib.h"
#import "string.h"
#import "sys/stat.h"

#enum {
    MAX_ROWS = 200
    MAX_COLS = 40
    CELL_TEXT = 256
    COL_W = 110
    ROW_H = 28
    HEADER_H = 30
    ROW_HDR_W = 52
}

CString :: const char * #type

app "Workbook" {
    size 1180 720
    fps 60
}

state {
    wb: void * = NULL
    sheet_index: int = 0
    selected_row: int = 0
    selected_col: int = 0
    scroll_row: int = 0
    scroll_col: int = 0
    edit_text: [CELL_TEXT] char = ""
    data_path: [1024] char = ""
    data_dir: [1024] char = ""
    status: [256] char = "Ready"
    initialized: int = 0
    dirty: int = 0
}

GridRows :: () -> int {
    n: int = WorkbookSheetRows((Workbook *)wb,sheet_index)
    if n < 8 { n = 8 }
    if n > MAX_ROWS { n = MAX_ROWS }
    return n
}

GridCols :: () -> int {
    n: int = WorkbookSheetColumns((Workbook *)wb,sheet_index)
    if n < 8 { n = 8 }
    if n > MAX_COLS { n = MAX_COLS }
    return n
}

ColName :: (col: int, out: char *, cap: int) {
    if col < 26 {
        snprintf(out,cap,"%c",'A' + col)
        return
    }
    snprintf(out,cap,"%c%c",'A' + col / 26 - 1,'A' + col % 26)
}

LoadLegacyJson :: (path: const char *) -> int {
    text: char * = LoadFileText(path)
    root: KryJson * = NULL
    rows: KryJson * = NULL
    count: int = 0
    i: int = 0
    if text == NULL { return 0 }
    root = kry_json_parse(text)
    if root == NULL { UnloadFileText(text); return 0 }
    rows = kry_json_get(root,"rows")
    count = kry_json_count(rows)
    while i < count {
        item: KryJson * = kry_json_at(rows,i)
        if item != NULL && kry_json_type(item) == KRY_JSON_OBJECT {
            j: int = 0
            while j < 8 {
                value: KryJson * = NULL
                textbuf: [CELL_TEXT] char = ""
                if j == 0 { value = kry_json_get(item,"section") }
                if j == 1 { value = kry_json_get(item,"label") }
                if j == 2 { value = kry_json_get(item,"id") }
                if j == 3 { value = kry_json_get(item,"units") }
                if j == 4 { value = kry_json_get(item,"rate") }
                if j == 5 { value = kry_json_get(item,"pct") }
                if j == 6 { value = kry_json_get(item,"usd") }
                if j == 7 { value = kry_json_get(item,"dusd") }
                if value != NULL && kry_json_type(value) == KRY_JSON_STRING {
                    snprintf(textbuf,sizeof(textbuf),"%s",kry_json_string(value))
                }
else if value != NULL && kry_json_type(value) == KRY_JSON_NUMBER {
                    snprintf(textbuf,sizeof(textbuf),"%.15g",kry_json_number(value))
                }
                if textbuf[0] != 0 { WorkbookSetCell((Workbook *)wb,0,i,j,textbuf) }
                j += 1
            }
        }
        i += 1
    }
    kry_json_free(root)
    UnloadFileText(text)
    return 1
}

load_workbook :: () {
    profile: const char * = getenv("WORKBOOK_PROFILE")
    override: const char * = getenv("WORKBOOK_DIR")
    app_id: const char * = "workbook"
    if profile != NULL && strcmp(profile,"geld") == 0 {
        app_id = "geld"
        override = getenv("GELD_DIR")
    }
    wb = WorkbookNew()
    WorkbookAddSheet((Workbook *)wb,"Sheet1")
    if override != NULL && override[0] != 0 {
        snprintf(data_dir,sizeof(data_dir),"%s",override)
        snprintf(data_path,sizeof(data_path),"%s/workbook.gnumeric",override)
    }
else if FileExists("workbook.gnumeric") {
        copy_text(data_path,sizeof(data_path),"workbook.gnumeric")
    }
else if FileExists("workbook.json") {
        copy_text(data_path,sizeof(data_path),"workbook.json")
    }
else {
        base: const char * = getenv("XDG_DATA_HOME")
        if base != NULL && base[0] != 0 {
            snprintf(data_dir,sizeof(data_dir),"%s/%s",base,app_id)
        }
else {
            home: const char * = getenv("HOME")
            if home == NULL || home[0] == 0 { home = "." }
            snprintf(data_dir,sizeof(data_dir),"%s/.local/share/%s",home,app_id)
        }
        snprintf(data_path,sizeof(data_path),"%s/workbook.gnumeric",data_dir)
    }
    loaded: int = 0
    if FileExists(data_path) {
        len: int = (int)strlen(data_path)
        if len >= 9 && strcmp(data_path + len - 9,".gnumeric") == 0 {
            loaded = WorkbookLoadFile((Workbook *)wb,data_path)
        }
else if len >= 4 && strcmp(data_path + len - 4,".csv") == 0 {
            loaded = WorkbookLoadFile((Workbook *)wb,data_path)
        }
else if len >= 5 && strcmp(data_path + len - 5,".json") == 0 {
            loaded = LoadLegacyJson(data_path)
        }
    }
    if WorkbookSheetCount((Workbook *)wb) == 0 { WorkbookAddSheet((Workbook *)wb,"Sheet1") }
    snprintf(status,sizeof(status),"Loaded %s",data_path)
    dirty = 0
}

copy_text :: (dst: char *, cap: int, src: const char *) {
    if src == NULL { src = "" }
    snprintf(dst,cap,"%s",src)
}

save_workbook :: () {
    len: int = (int)strlen(data_path)
    is_json: int = len > 5 && strcmp(data_path + len - 5,".json") == 0
    ok: int = 0
    if is_json {
        ok = SaveLegacyJson()
    }
else {
        ok = WorkbookWriteGnumeric((Workbook *)wb,data_path)
    }
    if ok {
        snprintf(status,sizeof(status),"Saved %s",data_path)
        dirty = 0
    }
else {
        snprintf(status,sizeof(status),"Could not save %s",data_path)
    }
}

SaveLegacyJson :: () -> int {
    buf: KryJsonBuf = {0}
    keys: [8] CString = {"section","label","id","units","rate","pct","usd","dusd"}
    row: int = 0
    rows: int = WorkbookSheetRows((Workbook *)wb,0)
    kry_json_buf_raw(&buf,"{\"rows\":[")
    while row < rows {
        if row > 0 { kry_json_buf_raw(&buf,",") }
        kry_json_buf_raw(&buf,"{")
        col: int = 0
        while col < 8 {
            if col > 0 { kry_json_buf_raw(&buf,",") }
            kry_json_buf_str(&buf,keys[col])
            kry_json_buf_raw(&buf,":")
            textbuf: [CELL_TEXT] char = ""
            src: CString = WorkbookCellText((Workbook *)wb,0,row,col)
            if src != NULL && src[0] == '=' {
                snprintf(textbuf,sizeof(textbuf),"%s",src + 1)
                kry_json_buf_raw(&buf,"{\"expr\":")
                kry_json_buf_str(&buf,textbuf)
                kry_json_buf_raw(&buf,"}")
            }
else {
                snprintf(textbuf,sizeof(textbuf),"%s",src)
                kry_json_buf_str(&buf,textbuf)
            }
            col += 1
        }
        kry_json_buf_raw(&buf,"}")
        row += 1
    }
    kry_json_buf_raw(&buf,"],\"format\":\"workbook-kry-1\"}\n")
    ok: int = SaveFileText(data_path,kry_json_buf_finish(&buf)) ? 1 : 0
    kry_json_buf_free(&buf)
    return ok
}

select_cell :: () {
    src: CString = WorkbookCellText((Workbook *)wb,sheet_index,selected_row,selected_col)
    copy_text(edit_text,sizeof(edit_text),src)
}

commit_cell :: () {
    WorkbookSetCell((Workbook *)wb,sheet_index,selected_row,selected_col,edit_text)
    WorkbookEvaluate((Workbook *)wb)
    dirty = 1
    snprintf(status,sizeof(status),"Edited %c%d",'A' + selected_col,selected_row + 1)
}

insert_row :: () {
    WorkbookInsertRow((Workbook *)wb,sheet_index,selected_row)
    WorkbookEvaluate((Workbook *)wb)
    dirty = 1
    copy_text(status,sizeof(status),"Row inserted")
}

delete_row :: () {
    WorkbookDeleteRow((Workbook *)wb,sheet_index,selected_row)
    WorkbookEvaluate((Workbook *)wb)
    dirty = 1
    copy_text(status,sizeof(status),"Row deleted")
}

insert_column :: () {
    WorkbookInsertColumn((Workbook *)wb,sheet_index,selected_col)
    WorkbookEvaluate((Workbook *)wb)
    dirty = 1
    copy_text(status,sizeof(status),"Column inserted")
}

delete_column :: () {
    WorkbookDeleteColumn((Workbook *)wb,sheet_index,selected_col)
    WorkbookEvaluate((Workbook *)wb)
    dirty = 1
    copy_text(status,sizeof(status),"Column deleted")
}

col_x :: (col: int) -> int {
    return ROW_HDR_W + (col - scroll_col) * COL_W
}

row_y :: (row: int) -> int {
    return 98 + HEADER_H + (row - scroll_row) * ROW_H
}

draw_table :: () #ui {
    if wb == NULL {
        load_workbook()
        initialized = 1
        select_cell()
    }
    table_x: int = 24
    table_y: int = 98
    table_w: int = 1132
    table_h: int = 548
    visible_rows: int = (table_h - HEADER_H) / ROW_H
    visible_cols: int = (table_w - ROW_HDR_W) / COL_W
    grid_rows: int = GridRows()
    grid_cols: int = GridCols()
    max_row_scroll: int = grid_rows - visible_rows
    max_col_scroll: int = grid_cols - visible_cols
    if max_row_scroll < 0 { max_row_scroll = 0 }
    if max_col_scroll < 0 { max_col_scroll = 0 }
    mouse: Vector2 = GetMousePosition()
    if CheckCollisionPointRec(mouse,(Rectangle){table_x,table_y,table_w,table_h}) {
        wheel: float = GetMouseWheelMove()
        if wheel > 0 { scroll_row -= 1 }
        if wheel < 0 { scroll_row += 1 }
        if scroll_row < 0 { scroll_row = 0 }
        if scroll_row > max_row_scroll { scroll_row = max_row_scroll }
    }

    Text("Workbook",24,17,Text24,GetThemeText())
    if dirty { Text("unsaved",146,23,Text14,GetThemeIcon()) }
    if Button((ButtonProps){.bounds={250,14,82,32},.label="Save",.style=ButtonStylePrimary,.font=Text16,.id=1001}) { save_workbook() }
    if Button((ButtonProps){.bounds={340,14,94,32},.label="Insert row",.style=ButtonStyleSecondary,.font=Text14,.id=1002}) { insert_row() }
    if Button((ButtonProps){.bounds={442,14,94,32},.label="Delete row",.style=ButtonStyleSecondary,.font=Text14,.id=1003}) { delete_row() }
    if Button((ButtonProps){.bounds={544,14,106,32},.label="Insert column",.style=ButtonStyleSecondary,.font=Text14,.id=1004}) { insert_column() }
    if Button((ButtonProps){.bounds={658,14,106,32},.label="Delete column",.style=ButtonStyleSecondary,.font=Text14,.id=1005}) { delete_column() }

    sheet: int = 0
    while sheet < WorkbookSheetCount((Workbook *)wb) {
        label: [160] char = ""
        snprintf(label,sizeof(label),"%s",WorkbookSheetName((Workbook *)wb,sheet))
        x: int = 780 + sheet * 110
        if Button((ButtonProps){.bounds={x,14,104,32},.label=label,.style=sheet == sheet_index ? ButtonStyleTabSelected : ButtonStyleTab,.font=Text14,.id=1100 + sheet}) {
            sheet_index = sheet
            select_cell()
        }
        sheet += 1
    }

    Text("fx",24,61,Text16,GetThemeIcon())
    Rect(52,52,1104,34,GetThemeSurface(),GetThemeButton())
    Text(edit_text,60,61,Text16,GetThemeText())

    Rect(table_x,table_y,table_w,table_h,GetThemeSurface(),GetThemeButton())
    x: int = 0
    col: int = scroll_col
    Rect(table_x,table_y,ROW_HDR_W,HEADER_H,GetThemeButton(),GetThemeIcon())
    while col < scroll_col + visible_cols && col < grid_cols {
        name: [8] char = ""
        ColName(col,name,sizeof(name))
        Rect(col_x(col),table_y,COL_W,HEADER_H,GetThemeButton(),GetThemeIcon())
        Text(name,col_x(col) + 6,table_y + 7,Text14,GetThemeText())
        col += 1
    }

    shown: int = 0
    while shown < visible_rows && scroll_row + shown < grid_rows {
        row: int = scroll_row + shown
        y: int = row_y(row)
        label: [16] char = ""
        Rect(table_x,y,ROW_HDR_W,ROW_H,GetThemeButton(),GetThemeIcon())
        snprintf(label,sizeof(label),"%d",row + 1)
        Text(label,table_x + 6,y + 6,Text14,GetThemeText())
        c: int = scroll_col
        while c < scroll_col + visible_cols && c < grid_cols {
            fill: Color = GetThemeSurface()
            display: [CELL_TEXT] char = ""
            if row == selected_row && c == selected_col { fill = GetThemeButtonHover() }
            Rect(col_x(c),y,COL_W,ROW_H,fill,GetThemeButton())
            WorkbookCellDisplay((Workbook *)wb,sheet_index,row,c,display,sizeof(display))
            if display[0] != 0 {
                Text(display,col_x(c) + 6,y + 6,Text14,GetThemeText())
            }
            c += 1
        }
        shown += 1
    }

    if IsMouseButtonReleased(MOUSE_BUTTON_LEFT) && CheckCollisionPointRec(mouse,(Rectangle){table_x,table_y + HEADER_H,table_w,table_h - HEADER_H}) {
        clicked_row: int = (int)(mouse.y - table_y - HEADER_H) / ROW_H + scroll_row
        clicked_col: int = -1
        cx: int = scroll_col
        while cx < scroll_col + visible_cols && cx < grid_cols {
            if mouse.x >= col_x(cx) && mouse.x < col_x(cx) + COL_W {
                clicked_col = cx
                break
            }
            cx += 1
        }
        if clicked_row >= 0 && clicked_row < grid_rows && clicked_col >= 0 {
            selected_row = clicked_row
            selected_col = clicked_col
            select_cell()
        }
    }
    Text(status,24,674,Text14,GetThemeIcon())
    Text("Enter commits a cell · Ctrl+S saves · formulas start with =",660,674,Text14,GetThemeIcon())
}

WorkbookApp :: (viewport: Rectangle) #ui {
    Screen root: {
        bounds = viewport
        Background(GetThemeBackground())
        if initialized == 0 {
            load_workbook()
            initialized = 1
            select_cell()
        }
        if IsKeyPressed(KEY_BACKSPACE) {
            length: int = (int)strlen(edit_text)
            if length > 0 { edit_text[length-1] = 0 }
        }
        if !IsKeyDown(KEY_LEFT_CONTROL) && !IsKeyDown(KEY_RIGHT_CONTROL) {
            typed: int = GetCharPressed()
            while typed > 0 {
                length: int = (int)strlen(edit_text)
                if typed >= 32 && typed < 127 && length + 1 < CELL_TEXT {
                    edit_text[length] = (char)typed
                    edit_text[length+1] = 0
                }
                typed = GetCharPressed()
            }
        }
        if IsKeyPressed(KEY_ENTER) { commit_cell() }
        if IsKeyPressed(KEY_DELETE) { edit_text[0] = 0; commit_cell() }
        if IsKeyDown(KEY_LEFT_CONTROL) && IsKeyPressed(KEY_S) { save_workbook() }
        draw_table()
    }
}
