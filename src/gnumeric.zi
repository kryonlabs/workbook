// Gnumeric's native document engine owns imported .gnumeric and .ods workbooks.
// Its public C ABI is loaded on demand; the editor and headless driver stay
// Ziran. Keeping the native document retains styles, names, arrays, charts,
// print settings and shared expressions through edits, saves and undo.
NativeArray :: struct { data: **void; count: u32; }
NativePosition :: struct { col: s32; row: s32; }
NativeRange :: struct { start: NativePosition; end: NativePosition; }
NativeSList :: struct { data: *void; next: *NativeSList; }
NativeColor :: struct { go_color: u32; ref_count: s32; is_auto: s32; }
NativeBorder :: struct { line_type: s32; color: *NativeColor; begin_margin: s32; end_margin: s32; width: s32; }
NativeColRowInfo :: struct { size_pts: float64; size_pixels: s32; flags: u32; }

CellMerge :: struct {
    start_row: s32;
    start_col: s32;
    end_row: s32;
    end_col: s32;
    merged: s32;
}

CellStyle :: struct {
    bg_rgba: u32;
    fg_rgba: u32;
    has_bg: s32;
    has_fg: s32;
    bold: s32;
    italic: s32;
    align_h: s32;
    wrap: s32;
    font_size: float32;
    border_top_rgba: u32;
    border_bottom_rgba: u32;
    border_left_rgba: u32;
    border_right_rgba: u32;
    border_top_width: s32;
    border_bottom_width: s32;
    border_left_width: s32;
    border_right_width: s32;
}

SheetTabColor :: struct {
    bg_rgba: u32;
    fg_rgba: u32;
    has_bg: s32;
    has_fg: s32;
}

SheetChart :: struct {
    left_pts: float64;
    top_pts: float64;
    right_pts: float64;
    bottom_pts: float64;
}

