            unused NativeResolveFrom(native_cairo_library, cast(*void)*native_cairo_surface_destroy, "cairo_surface_destroy")
        }
        argv: [2]*s8
        argv[0] = CText("workbook")
        // Gnumeric's start-up adopts the user's locale. Restore Workbook's
        // afterwards, so a decimal comma never reaches its number parser or display.
        saved: [256]s8
        current := NativeSetLocale(NATIVE_LC_ALL, null)
        kept := current != null && TextLength(current) < 256
        if kept { unused MemoryCopy(cast(*void)*saved[0], cast(*void)current, TextLength(current) + 1) }
        unused native_pre_init(1, *argv[0])
        native_initialize()
        native_context = native_new_context()
        native_plugins_init(native_context)
        error: *void
        native_activate(native_plugins(), *error)
        // Optional plugin activation failures do not disable the core reader.
        if error != null { native_error_free(error) }
        if kept { unused NativeSetLocale(NATIVE_LC_ALL, *saved[0]) }
        subtotal: *void = native_function_lookup(CText("SUBTOTAL"), null)
        if subtotal == null { return false }
        native_function_load(subtotal)
        subtotal_callback: NativeFunctionNodes = NativeSubtotal
        subtotal_callback_opaque: *void
        MemoryCopy(cast(*void)*subtotal_callback_opaque, cast(*void)*subtotal_callback, size_of(*void))
        native_function_set_varargs(subtotal, subtotal_callback_opaque, null)
        native_ready = true
        return true
    }
}

NativeRead :: (bytes: *u8, count: s64, uri: *s8 = null, ods: bool = false) -> *void {
    if !NativeReady() { return null }
    input: *void = native_input_memory(bytes, count, 0)
    if input == null { return null }
    io: *void = native_new_io(native_context)
    opener_id: *s8 = ifx ods then CText("Gnumeric_OpenCalc:openoffice") else CText("Gnumeric_XmlIO:sax")
    opener: *void = native_opener(opener_id)
    view: *void
    if opener != null { view = native_read(input, uri, opener, io, null) }
    failed: bool = native_io_failed(io) != 0
    native_release(io)
    native_release(input)
    if failed && view != null { native_release(view); view = null }
    return view
}

// Supply the source URI so Gnumeric can resolve relative workbook links.
NativeReadDocument :: (bytes: *u8, count: s64, path: *s8, ods: bool = false) -> *void {
    if !NativeReady() { return null }
    absolute: *s8 = native_canonical_path(path, null)
    if absolute == null { return null }
    uri: *s8 = native_filename_uri(absolute, null, null)
    native_free(cast(*void)absolute)
    if uri == null { return null }
    view: *void = NativeRead(bytes, count, uri, ods)
    native_free(cast(*void)uri)
    return view
}

NativeClose :: (view: *void) { if view != null { native_release(view) } }

NativeWriteOutput :: (view: *void, output: *void, format: *s8) -> bool {
    saver: *void = native_saver(format)
    if saver == null { return false }
    io: *void = native_new_io(native_context)
    native_write(view, saver, output, io)
    ok: bool = native_io_failed(io) == 0
    if native_output_closed(output) == 0 {
        if native_output_close(output) == 0 { ok = false }
    }
    native_release(io)
    return ok
}

NativeSave :: (view: *void, path: *s8, csv: bool, ods: bool = false) -> s32 {
    error: *void
    // CSV is also written to pipes such as /dev/stdout. The native file
    // output requires a seekable file; its memory output has no such limit.
    output: *void = ifx csv then native_output_memory() else native_output_file(path, *error)
    if output == null {
        if error != null { native_error_release(error) }
        return 0
    }
    previous: *void = native_current_sheet(view)
    if csv { native_focus_sheet(view, native_sheet(native_book(view), 0)) }
    format: *s8 = CText("Gnumeric_XmlIO:sax")
    if csv { format = CText("Gnumeric_stf:stf_csv") }
    else if ods { format = CText("Gnumeric_OpenCalc:odf") }
    ok: bool = NativeWriteOutput(view, output, format)
    if csv {
        native_focus_sheet(view, previous)
        if ok {
            count: s64 = native_output_size(output)
            bytes: *s8 = cast(*s8)MemoryAllocate(cast(u64)count + 1)
            if bytes == null { ok = false }
            else {
                MemoryCopy(cast(*void)bytes, cast(*void)native_output_bytes(output), cast(u64)count)
                bytes[count] = 0
                ok = WriteFileText(path, bytes)
                MemoryFree(cast(*void)bytes)
            }
        }
    }
    native_release(output)
    return ifx ok then 1 else 0
}

NativeClone :: (view: *void) -> *void {
    output: *void = native_output_memory()
    if output == null { return null }
    copy: *void
    if NativeWriteOutput(view, output, CText("Gnumeric_XmlIO:sax")) {
        copy = NativeRead(native_output_bytes(output), native_output_size(output), native_document_uri(native_book(view)))
    }
    native_release(output)
    return copy
}

NativeRefresh :: (wb: *Workbook) -> s32 {
    // All model text is owned by Workbook; native pointers never outlive a
    // call. Rebuilding also picks up dependencies changed by an edit.
    for i: 0..wb.sheet_count - 1 { SheetFree(*wb.sheets[i]) }
    wb.sheet_count = 0
    book: *void = native_book(wb.native)
    native_recalculate(book)
    count: s32 = native_sheet_count(book)
    index: s32 = 0
    while index < count {
        source: *void = native_sheet(book, index)
        name: *s8
        native_get_name(source, CText("name"), *name, null)
        sheet: *Sheet = WorkbookPushSheet(wb, name)
        native_free(cast(*void)name)
        if sheet == null { return 0 }
        positions: *NativeArray = native_positions(source, 0)
        if positions != null {
            at: u32 = 0
            while at < positions.count {
                position: *NativePosition = cast(*NativePosition)positions.data[at]
                node: *void = native_cell(source, position.col, position.row)
                cell: *Cell = CellObtain(sheet, position.row, position.col)
                if cell != null && node != null {
                    cell.text = native_source(node)
                    value: *void = native_value(node)
                    kind: s32 = native_value_type(value)
                    cell.kind = ifx cell.text != null && cell.text[0] == 61 then CELL_FORMULA else CELL_LITERAL
                    cell.computed = 1
                    if kind == 20 || kind == 40 {
                        cell.cached_kind = ifx kind == 20 then VAL_BOOL else VAL_FLOAT
                        cell.cached_number = native_number(value)
                    } else if kind == 50 {
                        cell.cached_kind = VAL_ERROR
                        message: *s8 = native_value_text(value)
                        cell.cached_err = ErrFromText(message)
                        native_free(cast(*void)message)
                    } else if kind == 60 {
                        cell.cached_kind = VAL_STRING
                        cell.cached_text = native_value_text(value)
                    }
                }
                at += 1
            }
            native_array_release(cast(*void)positions)
        }
        SheetExtent(sheet)
        index += 1
    }
    return 1
}

NativeSet :: (wb: *Workbook, index: s32, row: s32, col: s32, text: *s8) -> s32 {
    sheet: *void = native_sheet(native_book(wb.native), index)
    if sheet == null { return 0 }
    cell: *void = native_cell(sheet, col, row)
    // Match Gnumeric: an array cannot be changed one constituent cell at a time.
    if cell != null && native_array_cell(cell) != 0 { return 0 }
    if text == null || text[0] == 0 {
        if cell != null { native_remove(sheet, cell, 0, 1) }
    } else {
        cell = native_fetch(sheet, col, row)
        if cell == null { return 0 }
        native_set_text(cell, text, null)
    }
    return NativeRefresh(wb)
}

NativeShift :: (wb: *Workbook, index: s32, at: s32, rows: bool, insert: bool) -> s32 {
    sheet: *void = native_sheet(native_book(wb.native), index)
    result: s32
    if rows {
        if insert { result = native_insert_rows(sheet, at, 1, null, native_context) }
        else { result = native_delete_rows(sheet, at, 1, null, native_context) }
    } else {
        if insert { result = native_insert_cols(sheet, at, 1, null, native_context) }
        else { result = native_delete_cols(sheet, at, 1, null, native_context) }
    }
    if result != 0 { return 0 }
    return NativeRefresh(wb)
}

NativeRowHidden :: (wb: *Workbook, index: s32, row: s32) -> s32 {
    sheet: *void = native_sheet(native_book(wb.native), index)
    if sheet == null || row < 0 || row >= WB_MAX_ROWS {
        return 0
    }
    return native_row_hidden(sheet, row)
}

NativeSetRowsHidden :: (wb: *Workbook, index: s32, first: s32, last: s32, hidden: s32) -> s32 {
    sheet: *void = native_sheet(native_book(wb.native), index)
    if sheet == null {
        return 0
    }
    native_set_visibility(sheet, 0, ifx hidden == 0 then 1 else 0, first, last)
    return NativeRefresh(wb)
}

NativeDisplay :: (wb: *Workbook, index: s32, row: s32, col: s32, out: *s8, cap: s32) {
    out[0] = 0
    sheet: *void = native_sheet(native_book(wb.native), index)
    cell: *void = native_cell(sheet, col, row)
    if cell == null { return }
    // A number in the General format gets Workbook's grid rule rather than
    // as many digits as fit the column; an explicit number format is kept.
    value: *void = native_value(cell)
    if native_value_type(value) == 40 && native_general(native_format(cell)) != 0 {
        FormatNumber(native_number(value), out, cap)
        RoundForDisplay(out, cap)
        return
    }
    text: *s8 = native_display(cell)
    if text != null {
        FormatText(out, cast(usize)cap, CText("%s"), text)
        native_free(cast(*void)text)
    }
}

NativeAddSheet :: (wb: *Workbook, name: *s8) -> s32 {
    if wb == null || wb.native == null || native_sheet_add == null { return 0 }
    book: *void = native_book(wb.native)
    if book == null { return 0 }
    added: *void = native_sheet_add(book, -1, 256, 65536)
    if added == null { return 0 }
    if name != null && name[0] != 0 && native_set_string != null {
        native_set_string(added, CText("name"), name, null)
    }
    return NativeRefresh(wb)
}

NativeSheetVisible :: (wb: *Workbook, index: s32) -> s32 {
    if wb == null || wb.native == null || native_get_int == null { return 1 }
    sheet: *void = native_sheet(native_book(wb.native), index)
    if sheet == null { return 1 }
    visibility: s32 = 0
    native_get_int(sheet, CText("visibility"), *visibility, null)
    return ifx visibility == 0 then 1 else 0
}

NativeSetSheetVisible :: (wb: *Workbook, index: s32, visible: s32) -> s32 {
    if wb == null || wb.native == null || native_set_int == null { return 0 }
    sheet: *void = native_sheet(native_book(wb.native), index)
    if sheet == null { return 0 }
    native_set_int(sheet, CText("visibility"), ifx visible != 0 then 0 else 1, null)
    return 1
}

NativeColHidden :: (wb: *Workbook, index: s32, col: s32) -> s32 {
    if wb == null || wb.native == null || native_col_hidden == null || col < 0 || col >= WB_MAX_COLS {
        return 0
    }
    sheet: *void = native_sheet(native_book(wb.native), index)
    if sheet == null { return 0 }
    return native_col_hidden(sheet, col)
}

NativeColWidth :: (wb: *Workbook, index: s32, col: s32) -> float32 {
    if wb == null || wb.native == null || native_col_info == null || col < 0 || col >= WB_MAX_COLS {
        return 0.0
    }
    sheet: *void = native_sheet(native_book(wb.native), index)
    if sheet == null { return 0.0 }
    info: *NativeColRowInfo = native_col_info(sheet, col)
    if info == null || (info.flags & 1) != 0 || info.size_pixels <= 0 { return 0.0 }
    // Respect explicit column widths (hard_size) and ODS column styles, while
    // keeping Workbook's default column width for unstyled Gnumeric sheets.
    if (info.flags & 64) == 0 && wb.native_format != 1 { return 0.0 }
    return cast(float32)info.size_pixels
}

NativeRowHeight :: (wb: *Workbook, index: s32, row: s32) -> float32 {
    if wb == null || wb.native == null || native_row_info == null || row < 0 || row >= WB_MAX_ROWS {
        return 0.0
    }
    sheet: *void = native_sheet(native_book(wb.native), index)
    if sheet == null { return 0.0 }
    info: *NativeColRowInfo = native_row_info(sheet, row)
    if info == null || (info.flags & 1) != 0 || info.size_pixels <= 0 { return 0.0 }
    // Respect explicit row heights (hard_size) and tall ODS rows; default body
    // rows keep Workbook's comfortable 22px row height.
    if (info.flags & 64) == 0 && (wb.native_format != 1 || info.size_pixels <= 22) { return 0.0 }
    return cast(float32)info.size_pixels
}

NativeColDistancePts :: (wb: *Workbook, index: s32, from: s32, to: s32) -> float64 {
    if wb == null || wb.native == null || native_col_distance_pts == null { return 0.0 }
    sheet: *void = native_sheet(native_book(wb.native), index)
    if sheet == null { return 0.0 }
    return native_col_distance_pts(sheet, from, to)
}

NativeRowDistancePts :: (wb: *Workbook, index: s32, from: s32, to: s32) -> float64 {
    if wb == null || wb.native == null || native_row_distance_pts == null { return 0.0 }
    sheet: *void = native_sheet(native_book(wb.native), index)
    if sheet == null { return 0.0 }
    return native_row_distance_pts(sheet, from, to)
}

NativeCellMerge :: (wb: *Workbook, index: s32, row: s32, col: s32, out: *CellMerge) -> s32 {
    if out != null { out.* = CellMerge.{} }
    if wb == null || wb.native == null || out == null || native_merge_contains == null ||
    row < 0 || col < 0 || row >= WB_MAX_ROWS || col >= WB_MAX_COLS {
        return 0
    }
    sheet: *void = native_sheet(native_book(wb.native), index)
    if sheet == null { return 0 }
    pos: NativePosition = NativePosition.{.col = col, .row = row}
    found: *NativeRange = native_merge_contains(sheet, *pos)
    if found == null { return 0 }
    out.start_row = found.start.row
    out.start_col = found.start.col
    out.end_row = found.end.row
    out.end_col = found.end.col
    out.merged = 1
    return 1
}

NativeBorderRead :: (style: *void, elem: s32, out_rgba: *u32, out_width: *s32) {
    out_rgba.* = 0
    out_width.* = 0
    if native_style_border == null || style == null { return }
    border: *NativeBorder = native_style_border(style, elem)
    if border == null || border.line_type <= 0 { return }
    t := border.line_type
    w: s32 = 1
    if t == 2 || t == 5 || t == 6 || t == 8 || t == 10 || t == 12 { w = 2 }
    out_width.* = w
    if border.color != null && border.color.is_auto == 0 {
        out_rgba.* = border.color.go_color
    } else {
        out_rgba.* = 0x000000ff
    }
}

NativeSheetTabColor :: (wb: *Workbook, index: s32, out: *SheetTabColor) -> s32 {
    if out != null { out.* = SheetTabColor.{} }
    if wb == null || wb.native == null || out == null || native_get_ptr == null { return 0 }
    sheet: *void = native_sheet(native_book(wb.native), index)
    if sheet == null { return 0 }
    bg_ptr: *void = null
    fg_ptr: *void = null
    native_get_ptr(sheet, CText("tab-background"), *bg_ptr, null)
    native_get_ptr(sheet, CText("tab-foreground"), *fg_ptr, null)
    if bg_ptr != null {
        c := cast(*NativeColor)bg_ptr
        if c.is_auto == 0 {
            out.bg_rgba = c.go_color
            out.has_bg = 1
        }
        if native_color_unref != null { native_color_unref(c) }
    }
    if fg_ptr != null {
        c := cast(*NativeColor)fg_ptr
        if c.is_auto == 0 {
            out.fg_rgba = c.go_color
            out.has_fg = 1
        }
        if native_color_unref != null { native_color_unref(c) }
    }
    return ifx out.has_bg != 0 || out.has_fg != 0 then 1 else 0
}

NativeCellStyle :: (wb: *Workbook, index: s32, row: s32, col: s32, out: *CellStyle) -> s32 {
    if out != null { out.* = CellStyle.{} }
    if wb == null || wb.native == null || out == null || native_style_get == null ||
    row < 0 || col < 0 || row >= WB_MAX_ROWS || col >= WB_MAX_COLS {
        return 0
    }
    sheet: *void = native_sheet(native_book(wb.native), index)
    if sheet == null { return 0 }
    style: *void = native_style_get(sheet, col, row)
    if style == null { return 0 }
    active_style: *void = style
    overlay: *NativeArray = null
    if native_style_conditions != null && native_conditions_eval != null && native_conditions_overlay != null {
        conds: *void = native_style_conditions(style)
        if conds != null {
            ep: NativeEvalPosition
            ep.eval.col = col
            ep.eval.row = row
            ep.sheet = sheet
            matched: s32 = native_conditions_eval(conds, *ep)
            if matched >= 0 {
                overlay = native_conditions_overlay(conds, style)
                if overlay != null && cast(u32)matched < overlay.count && overlay.data[matched] != null {
                    active_style = overlay.data[matched]
                }
            }
        }
    }
    if native_style_pattern != null && native_style_back_color != null {
        if native_style_pattern(active_style) > 0 {
            bg: *NativeColor = native_style_back_color(active_style)
            if bg != null && bg.is_auto == 0 {
                out.bg_rgba = bg.go_color
                out.has_bg = 1
            }
        }
    }
    if native_style_font_color != null {
        fg: *NativeColor = native_style_font_color(active_style)
        if fg != null && fg.is_auto == 0 {
            out.fg_rgba = fg.go_color
            out.has_fg = 1
        }
    }
    // Number-format color overrides (e.g. [Red] for negative values).
    if native_cell_render_color != null {
        cell: *void = native_cell(sheet, col, row)
        if cell != null {
            rc: u32 = native_cell_render_color(cell)
            if rc != 0 && rc != 0x000000ff {
                out.fg_rgba = rc
                out.has_fg = 1
            }
        }
    }
    if native_style_bold != null { out.bold = native_style_bold(active_style) }
    if native_style_italic != null { out.italic = native_style_italic(active_style) }
    if native_style_align_h != null { out.align_h = native_style_align_h(active_style) }
    if native_style_wrap != null { out.wrap = native_style_wrap(active_style) }
    if native_style_font_size != null { out.font_size = cast(float32)native_style_font_size(active_style) }
    // MSTYLE_BORDER_TOP=2, BOTTOM=3, LEFT=4, RIGHT=5
    NativeBorderRead(active_style, 2, *out.border_top_rgba, *out.border_top_width)
    NativeBorderRead(active_style, 3, *out.border_bottom_rgba, *out.border_bottom_width)
    NativeBorderRead(active_style, 4, *out.border_left_rgba, *out.border_left_width)
    NativeBorderRead(active_style, 5, *out.border_right_rgba, *out.border_right_width)
    if overlay != null { native_array_release(cast(*void)overlay) }
    return 1
}

NativeChartCount :: (wb: *Workbook, index: s32) -> s32 {
    if wb == null || wb.native == null || native_graph_type == null ||
    native_sheet_objects == null || native_slist_free == null {
        return 0
    }
    sheet: *void = native_sheet(native_book(wb.native), index)
    if sheet == null { return 0 }
    list: *NativeSList = native_sheet_objects(sheet, null, native_graph_type())
    count: s32 = 0
    node: *NativeSList = list
    while node != null {
        count += 1
        node = node.next
    }
    if list != null { native_slist_free(list) }
    return count
}

NativeChartBounds :: (wb: *Workbook, index: s32, chart_index: s32, out: *SheetChart) -> s32 {
    if out != null { out.* = SheetChart.{} }
    if wb == null || wb.native == null || out == null || chart_index < 0 ||
    native_graph_type == null || native_sheet_objects == null || native_slist_free == null ||
    native_so_anchor == null || native_anchor_to_pts == null {
        return 0
    }
    sheet: *void = native_sheet(native_book(wb.native), index)
    if sheet == null { return 0 }
    list: *NativeSList = native_sheet_objects(sheet, null, native_graph_type())
    node: *NativeSList = list
    at: s32 = 0
    found: *void = null
    while node != null {
        if at == chart_index { found = node.data; break }
        at += 1
        node = node.next
    }
    ok: s32 = 0
    if found != null {
        anchor: *void = native_so_anchor(found)
        if anchor != null {
            pts: [4]float64
            native_anchor_to_pts(anchor, sheet, *pts[0])
            out.left_pts = pts[0]
            out.top_pts = pts[1]
            out.right_pts = pts[2]
            out.bottom_pts = pts[3]
            ok = 1
        }
    }
    if list != null { native_slist_free(list) }
    return ok
}

NativeChartRenderRgba :: (wb: *Workbook, index: s32, chart_index: s32, width: s32, height: s32, out_rgba: []u8) -> s32 {
    if wb == null || wb.native == null || chart_index < 0 || width <= 0 || height <= 0 ||
    out_rgba.count < cast(s64)width * cast(s64)height * 4 ||
    native_graph_type == null || native_sheet_objects == null || native_slist_free == null ||
    native_so_graph_gog == null || native_gog_render == null ||
    native_cairo_surface_create == null || native_cairo_create == null ||
    native_cairo_set_rgb == null || native_cairo_paint == null ||
    native_cairo_flush == null || native_cairo_data == null ||
    native_cairo_stride == null || native_cairo_destroy == null ||
    native_cairo_surface_destroy == null {
        return 0
    }
    sheet: *void = native_sheet(native_book(wb.native), index)
    if sheet == null { return 0 }
    list: *NativeSList = native_sheet_objects(sheet, null, native_graph_type())
    node: *NativeSList = list
    at: s32 = 0
    found: *void = null
    while node != null {
        if at == chart_index { found = node.data; break }
        at += 1
        node = node.next
    }
    gog: *void = ifx found != null then native_so_graph_gog(found) else null
    if list != null { native_slist_free(list) }
    if gog == null { return 0 }
    // CAIRO_FORMAT_ARGB32 = 0 (little-endian BGRA). Paint opaque white first
    // so transparent regions composite cleanly and output alpha is 255.
    surface: *void = native_cairo_surface_create(0, width, height)
    if surface == null { return 0 }
    cr: *void = native_cairo_create(surface)
    if cr == null {
        native_cairo_surface_destroy(surface)
        return 0
    }
    native_cairo_set_rgb(cr, 1.0, 1.0, 1.0)
    native_cairo_paint(cr)
    native_gog_render(gog, cr, cast(float64)width, cast(float64)height)
    native_cairo_flush(surface)
    pixels: *u8 = native_cairo_data(surface)
    stride: s32 = native_cairo_stride(surface)
    ok: s32 = 0
    if pixels != null && stride >= width * 4 {
        y: s32 = 0
        while y < height {
            src_row: *u8 = *pixels[cast(s64)y * cast(s64)stride]
            dst_off: s64 = cast(s64)y * cast(s64)width * 4
            x: s32 = 0
            while x < width {
                sx: s64 = cast(s64)x * 4
                dx: s64 = dst_off + sx
                out_rgba[dx + 0] = src_row[sx + 2]
                out_rgba[dx + 1] = src_row[sx + 1]
                out_rgba[dx + 2] = src_row[sx + 0]
                out_rgba[dx + 3] = 255
                x += 1
            }
            y += 1
        }
        ok = 1
    }
    native_cairo_destroy(cr)
    native_cairo_surface_destroy(surface)
    return ok
}
