// A read-only, CSV-like table for other apps to embed: typed columns, rows
// of cells, a totals row, number and money formatting, column widths fitted
// to the content, cell rectangles for a viewport, and CSV text. The host
// draws the cells, so this module depends on no UI toolkit.
//
// Cell values are plain text: numeric columns hold decimal text such as
// "1234" or "-0.25", and "" for unknown. The table keeps the strings it is
// given without copying; they must outlive it. SheetFree releases only the
// table's own storage.

SheetText :: 0;
SheetNumber :: 1;
SheetMoney :: 2;

SheetHeader :: 0;
SheetBody :: 1;
SheetStripe :: 2;
SheetTotal :: 3;

SheetLeft :: 0;
SheetRight :: 2;

SheetColumn :: struct {
    title: string
    kind: s32
    width: float32
}

SheetTable :: struct {
    columns: Vec(SheetColumn)
    cells: Vec(string)
    rows: s64
    // The first column of the totals row; "" leaves the row out.
    total_label: string
    // Set by SheetFit when numbers must shorten to fit, as in 1.25M.
    compact: bool
}

SheetCell :: struct {
    x: float32
    y: float32
    width: float32
    height: float32
    row: s64
    column: s64
    role: s32
    align: s32
    text: string
}

// The host's text width at a font size.
SheetMeasure :: #type (text: string, size: float32) -> float32;

SheetAddColumn :: (table: *SheetTable, title: string, kind: s32) {
    column: SheetColumn
    column.title = title
    column.kind = kind
    VecPush(table.columns, column)
}

// Adds an empty row and returns its index.
SheetAddRow :: (table: *SheetTable) -> s64 {
    for index: 0..table.columns.count - 1 { VecPush(table.cells, "") }
    table.rows += 1
    return table.rows - 1
}

SheetSet :: (table: *SheetTable, row: s64, column: s64, value: string) {
    if row < 0 || row >= table.rows || column < 0 || column >= table.columns.count { return }
    table.cells[row * table.columns.count + column] = value
}

SheetValue :: (table: *SheetTable, row: s64, column: s64) -> string {
    if row < 0 || row >= table.rows || column < 0 || column >= table.columns.count { return "" }
    return table.cells[row * table.columns.count + column]
}

SheetFree :: (table: *SheetTable) {
    VecFree(table.columns)
    VecFree(table.cells)
    table.rows = 0
}

// ------------------------------------------------------------------ numbers

SheetScale :: 1000000;

// Decimal text in millionths, rounded half away from zero. Anything other
// than an optional sign, digits and one point is not a number.
SheetMicros :: (text: string) -> (value: s64, ok: bool) {
    if text == "" { return 0, false }
    at: s64 = 0
    negative := false
    if text[0] == 45 || text[0] == 43 {
        negative = text[0] == 45
        at = 1
    }
    whole: s64 = 0
    fraction: s64 = 0
    kept: s32 = 0
    digits: s32 = 0
    point := false
    up := false
    while at < text.count {
        c := text[at]
        at += 1
        if c == 46 && !point {
            point = true
            continue
        }
        if c < 48 || c > 57 { return 0, false }
        digit := cast(s64)(c - 48)
        digits += 1
        if !point {
            if whole > 922337203684 { return 0, false }
            whole = whole * 10 + digit
        } else if kept < 6 {
            fraction = fraction * 10 + digit
            kept += 1
        } else if kept == 6 {
            up = digit >= 5
            kept += 1
        }
    }
    if digits == 0 { return 0, false }
    places := ifx kept > 6 then 6 else kept
    while places < 6 {
        fraction *= 10
        places += 1
    }
    value := whole * SheetScale + fraction
    if up { value += 1 }
    return ifx negative then -value else value, true
}

// Whole digits with a comma between each group of three.
SheetGrouped :: (out: *Vec(u8), value: s64) {
    digits: [24]u8
    count: s32 = 0
    rest := value
    while true {
        digits[count] = cast(u8)(48 + rest % 10)
        count += 1
        rest /= 10
        if rest == 0 { break }
    }
    index := count - 1
    while index >= 0 {
        unused VecPush(out.*, digits[index])
        if index > 0 && index % 3 == 0 { unused VecPush(out.*, 44) }
        index -= 1
    }
}

SheetRound :: (micros: s64, unit: s64) -> s64 {
    magnitude := ifx micros < 0 then -micros else micros
    rounded := (magnitude + unit / 2) / unit
    return ifx micros < 0 then -rounded else rounded
}

// A count with separators, as in 1,234,567.
SheetCount :: (micros: s64) -> string {
    out: Vec(u8)
    whole := SheetRound(micros, SheetScale)
    if whole < 0 { BuilderPrint(*out, "-") }
    SheetGrouped(*out, ifx whole < 0 then -whole else whole)
    return BuilderFinish(out)
}

// A count shortened to three significant figures, as in 1.25B or 734K.
SheetShort :: (micros: s64) -> string {
    whole := SheetRound(micros, SheetScale)
    magnitude := ifx whole < 0 then -whole else whole
    if magnitude < 1000 { return SheetCount(micros) }
    out: Vec(u8)
    if whole < 0 { BuilderPrint(*out, "-") }
    units: [4]string = .{"K", "M", "B", "T"}
    unit: s64 = 1000
    step: s32 = 0
    while step < 3 && magnitude >= unit * 1000 - unit / 2 {
        unit *= 1000
        step += 1
    }
    // Hundredths of the unit, then shown with as many decimals as fit in
    // three significant figures.
    hundredths := (magnitude * 100 + unit / 2) / unit
    whole_units := hundredths / 100
    if whole_units >= 100 {
        BuilderPrint(*out, "%", (hundredths + 50) / 100)
    } else if whole_units >= 10 {
        tenths := (hundredths + 5) / 10
        BuilderPrint(*out, "%.%", tenths / 10, tenths % 10)
    } else {
        BuilderPrint(*out, "%.", whole_units)
        if hundredths % 100 < 10 { BuilderPrint(*out, "0") }
        BuilderPrint(*out, "%", hundredths % 100)
    }
    BuilderPrint(*out, "%", units[step])
    return BuilderFinish(out)
}

// Dollars and cents, as in $1,234.57 or -$0.25.
SheetDollars :: (micros: s64) -> string {
    out: Vec(u8)
    cents := SheetRound(micros, 10000)
    magnitude := ifx cents < 0 then -cents else cents
    if cents < 0 { BuilderPrint(*out, "-") }
    BuilderPrint(*out, "$")
    SheetGrouped(*out, magnitude / 100)
    BuilderPrint(*out, ".")
    if magnitude % 100 < 10 { BuilderPrint(*out, "0") }
    BuilderPrint(*out, "%", magnitude % 100)
    return BuilderFinish(out)
}

// Plain decimal text for CSV, with no trailing zeros after the point.
SheetPlain :: (micros: s64) -> string {
    out: Vec(u8)
    magnitude := ifx micros < 0 then -micros else micros
    if micros < 0 { BuilderPrint(*out, "-") }
    BuilderPrint(*out, "%", magnitude / SheetScale)
    fraction := magnitude % SheetScale
    if fraction > 0 {
        digits: [6]u8
        for index: 0..5 {
            digits[5 - index] = cast(u8)(48 + fraction % 10)
            fraction /= 10
        }
        last: s32 = 5
        while digits[last] == 48 { last -= 1 }
        BuilderPrint(*out, ".")
        for index: 0..last { unused VecPush(out, digits[index]) }
    }
    return BuilderFinish(out)
}

SheetFormat :: (table: *SheetTable, kind: s32, micros: s64) -> string {
    if kind == SheetMoney { return SheetDollars(micros) }
    if table.compact { return SheetShort(micros) }
    return SheetCount(micros)
}

// The text a cell shows. Unknown numbers show a dash.
SheetDisplay :: (table: *SheetTable, row: s64, column: s64) -> string {
    value := SheetValue(table, row, column)
    if column < 0 || column >= table.columns.count { return value }
    kind := table.columns[column].kind
    if kind == SheetText { return value }
    if value == "" { return "—" }
    micros, ok := SheetMicros(value)
    if !ok { return value }
    return SheetFormat(table, kind, micros)
}

// The sum of a numeric column's known cells; false when none is known.
SheetSum :: (table: *SheetTable, column: s64) -> (value: s64, ok: bool) {
    if column < 0 || column >= table.columns.count || table.columns[column].kind == SheetText { return 0, false }
    total: s64 = 0
    known := false
    for row: 0..table.rows - 1 {
        micros, ok := SheetMicros(SheetValue(table, row, column))
        if ok {
            total += micros
            known = true
        }
    }
    return total, known
}

SheetTotalText :: (table: *SheetTable, column: s64) -> string {
    if column == 0 { return table.total_label }
    if column < 0 || column >= table.columns.count || table.columns[column].kind == SheetText { return "" }
    total, known := SheetSum(table, column)
    if !known { return "—" }
    return SheetFormat(table, table.columns[column].kind, total)
}

// ------------------------------------------------------------------- layout

SheetWidest :: (table: *SheetTable, column: s64, measure: SheetMeasure, size: float32) -> float32 {
    widest := measure(table.columns[column].title, size)
    for row: 0..table.rows - 1 {
        text := SheetDisplay(table, row, column)
        width := measure(text, size)
        if width > widest { widest = width }
    }
    if table.total_label != "" {
        width := measure(SheetTotalText(table, column), size)
        if width > widest { widest = width }
    }
    return widest
}

SheetNatural :: (table: *SheetTable, measure: SheetMeasure, size: float32, padding: float32) -> float32 {
    total: float32 = 0.0
    for column: 0..table.columns.count - 1 {
        table.columns[column].width = SheetWidest(table, column, measure, size) + padding * 2.0
        total += table.columns[column].width
    }
    return total
}

// Fits the columns to the available width. Numbers keep their full width
// when the text columns can give way; otherwise they shorten. Spare width
// goes to the first text column.
SheetFit :: (table: *SheetTable, measure: SheetMeasure, size: float32, padding: float32, available: float32) {
    if table.columns.count == 0 { return }
    table.compact = false
    total := SheetNatural(table, measure, size, padding)
    floor := measure("Mmmmmmmm", size) + padding * 2.0
    flexible: float32 = 0.0
    fixed: float32 = 0.0
    for column: 0..table.columns.count - 1 {
        width := table.columns[column].width
        if table.columns[column].kind == SheetText && width > floor { flexible += width - floor; fixed += floor } else { fixed += width }
    }
    if total > available && fixed > available {
        table.compact = true
        total = SheetNatural(table, measure, size, padding)
        flexible = 0.0
        fixed = 0.0
        for column: 0..table.columns.count - 1 {
            width := table.columns[column].width
            if table.columns[column].kind == SheetText && width > floor { flexible += width - floor; fixed += floor } else { fixed += width }
        }
    }
    if total > available && flexible > 0.0 {
        // Text columns shrink toward their floor in proportion to their extra.
        keep := available - fixed
        if keep < 0.0 { keep = 0.0 }
        ratio := keep / flexible
        if ratio > 1.0 { ratio = 1.0 }
        for column: 0..table.columns.count - 1 {
            width := table.columns[column].width
            if table.columns[column].kind == SheetText && width > floor { table.columns[column].width = floor + (width - floor) * ratio }
        }
        return
    }
    if total < available {
        target: s64 = 0
        for column: 0..table.columns.count - 1 {
            if table.columns[column].kind == SheetText { target = column; break }
        }
        table.columns[target].width += available - total
    }
}

SheetWidth :: (table: *SheetTable) -> float32 {
    total: float32 = 0.0
    for column: 0..table.columns.count - 1 { total += table.columns[column].width }
    return total
}

// Whole body rows that fit under the header, above the totals row.
SheetVisibleRows :: (table: *SheetTable, row_height: float32, header_height: float32, height: float32) -> s64 {
    room := height - header_height
    if table.total_label != "" { room -= row_height }
    if room <= 0.0 || row_height <= 0.0 { return 0 }
    return cast(s64)(room / row_height)
}

// The first row that keeps a full page of rows on screen.
SheetLastFirstRow :: (table: *SheetTable, visible: s64) -> s64 {
    last := table.rows - visible
    return ifx last > 0 then last else 0
}

SheetPlace :: (cells: *Vec(SheetCell), table: *SheetTable, x: float32, y: float32, height: float32, row: s64, role: s32) {
    left := x
    for column: 0..table.columns.count - 1 {
        cell: SheetCell
        cell.x = left
        cell.y = y
        cell.width = table.columns[column].width
        cell.height = height
        cell.row = row
        cell.column = column
        cell.role = role
        cell.align = ifx table.columns[column].kind == SheetText then SheetLeft else SheetRight
        if role == SheetHeader { cell.text = table.columns[column].title }
        else if role == SheetTotal { cell.text = SheetTotalText(table, column) }
        else { cell.text = SheetDisplay(table, row, column) }
        VecPush(cells.*, cell)
        left += cell.width
    }
}

// The cells of one screen: the header, whole body rows from first_row that
// fit, and the totals row right under them. Header cells have row -1 and
// totals cells row `rows`; every second body row is a stripe.
SheetLayout :: (table: *SheetTable, x: float32, y: float32, row_height: float32, header_height: float32, height: float32, first_row: s64) -> Vec(SheetCell) {
    cells: Vec(SheetCell)
    SheetPlace(*cells, table, x, y, header_height, -1, SheetHeader)
    visible := SheetVisibleRows(table, row_height, header_height, height)
    first := first_row
    if first > SheetLastFirstRow(table, visible) { first = SheetLastFirstRow(table, visible) }
    if first < 0 { first = 0 }
    top := y + header_height
    shown: s64 = 0
    while shown < visible && first + shown < table.rows {
        row := first + shown
        SheetPlace(*cells, table, x, top, row_height, row, ifx row % 2 == 1 then SheetStripe else SheetBody)
        top += row_height
        shown += 1
    }
    if table.total_label != "" { SheetPlace(*cells, table, x, top, row_height, table.rows, SheetTotal) }
    return cells
}

// ---------------------------------------------------------------------- CSV

SheetField :: (out: *Vec(u8), text: string, protect: bool) {
    // A spreadsheet would run a text cell that starts like a formula.
    guard := protect && text.count > 0 && (text[0] == 61 || text[0] == 43 || text[0] == 45 || text[0] == 64)
    quote := guard
    for c: text {
        if c == 44 || c == 34 || c == 10 || c == 13 { quote = true }
    }
    if !quote {
        BuilderPrint(out, "%", text)
        return
    }
    unused VecPush(out.*, 34)
    if guard { unused VecPush(out.*, 39) }
    for c: text {
        if c == 34 { unused VecPush(out.*, 34) }
        unused VecPush(out.*, c)
    }
    unused VecPush(out.*, 34)
}

// RFC 4180 text: the header, every row's values, then the totals row.
SheetCsv :: (table: *SheetTable) -> string {
    out: Vec(u8)
    for column: 0..table.columns.count - 1 {
        if column > 0 { BuilderPrint(*out, ",") }
        SheetField(*out, table.columns[column].title, true)
    }
    BuilderPrint(*out, "\r\n")
    for row: 0..table.rows - 1 {
        for column: 0..table.columns.count - 1 {
            if column > 0 { BuilderPrint(*out, ",") }
            SheetField(*out, SheetValue(table, row, column), table.columns[column].kind == SheetText)
        }
        BuilderPrint(*out, "\r\n")
    }
    if table.total_label != "" {
        for column: 0..table.columns.count - 1 {
            if column > 0 { BuilderPrint(*out, ",") }
            if column == 0 { SheetField(*out, table.total_label, true); continue }
            total, known := SheetSum(table, column)
            if known { BuilderPrint(*out, "%", SheetPlain(total)) }
        }
        BuilderPrint(*out, "\r\n")
    }
    return BuilderFinish(out)
}
