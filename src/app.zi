// Workbook desktop application: profile selection, documents, window title,
// menus and theme around the embeddable editor in src/editor.zi.
Menu :: #import "kryon/menu";
App :: #import "kryon/app";
ContextMenu :: #import "kryon/context_menu";
Box :: #import "kryon/box";
Text :: #import "kryon/text";
Button :: #import "kryon/button";
#import "kryon/geometry"
#import "kryon/session"
#import "kryon/drawing_props"
#import "kryon/control_props"
#import "kryon/text_input"
#import "kryon/input_protocol"
#import "kryon/app_protocol"
Grid :: #import "grid";
using Editor :: #import "editor";
#import "std/byte_text_linux"
#import "std/text_buffer"

RowAddIcon :: #import "mingcute/mingcute_extra_table_row_add";

#if #defined(KRYON_HOSTED_UI) {
    Engine :: #import "portable_engine";
    #import "kryon/app_context"
} else {
    Engine :: #import "engine";
    Desktop :: #import "kryon/desktop_runtime";
    Picker :: #import "kryon/file_picker";
    Json :: #import "std/json_scan";
    SystemStyle :: #import "kryon/SystemTheme";
    SystemThemeLinux :: #import "kryon/SystemThemeLinux";
    #import "kryon/key_input"
    #import "kryon/tree_input"
}

#scope_file

#if !#defined(KRYON_HOSTED_UI) {
    libc :: #system_library "libc";
    EnvironmentValue :: (name: *u8) -> *u8 #foreign libc "getenv";
    PathAccess :: (path: *u8, mode: s32) -> s32 #foreign libc "access";
    OpenFile :: (path: *u8, flags: s32, mode: ..any) -> s32 #foreign libc "open";
    ReadFileBytes :: (descriptor: s32, output: *u8, count: u64) -> s64 #foreign libc "read";
    CloseFile :: (descriptor: s32) -> s32 #foreign libc "close";
    FormatBytes :: (output: *u8, capacity: u64, format: *u8, args: ..any) -> s32 #foreign libc "snprintf";
}

MenuBarHeight :: 26.0;
KeyO :: 79;
KeyS :: 83;
KeyF :: 70;
KeyF10 :: 299;

editor_storage: Editor;
editor: *Editor;
app_started: bool;
menu_state: Menu.MenuState;
menu_key: s32;
menu_modifiers: s32;
menus_block_input: bool;
menu_x: float32;
typed_storage: [128]u8;
dropped_path: [4096]u8;
#if !#defined(KRYON_HOSTED_UI) {
    theme_name: [128]u8;
    theme_frames: s32;
    theme_installed: bool;
}
#if #defined(KRYON_HOSTED_UI) {
    input_pointer: PointerFrame;
    input_secondary: SecondaryPointerFrame;
    input_wheel: float32;
    document_pending: bool;
    document_export: bool;
}

#scope_export

#if #defined(KRYON_HOSTED_UI) {
    #program_export
    Main :: () -> s32 {
        mode := AppMode()
        if mode == APP_IDENTIFY { AppIdentity("workbook", 1); AppDescribe("Workbook", RowAddIcon.Shape); return APP_PROTOCOL }
        if mode == APP_FRAME {
            if !AppSupports("spreadsheet.v1") {
                Text.Draw(AppSession(), Text.Props.{.bounds = AppBounds(), .text = "Update Werkzeug to open Workbook.", .size = Text.Text16})
                return 0
            }
            if !app_started { StartHostedWorkbook(); app_started = true }
            ReadInput()
            input: EditorInput
            input.pointer = input_pointer
            input.secondary = input_secondary
            input.wheel = input_wheel
            input.key = AppKey()
            input.modifiers = AppModifiers()
            input.typed = AppFieldInput().text
            RunHostFrame(AppSession(), AppBounds(), input)
            AppKeyboard(EditorEditingCell(editor))
            input_wheel = 0.0
        }
        if mode == APP_SAVE {
            if !app_started { StartHostedWorkbook(); app_started = true }
            unused EditorSave(editor, true)
        }
        return 0
    }
} else {
    Frame :: (frame: App.Frame) {
        session := Session.{.slot = frame.slot, .epoch = frame.epoch}
        viewport := frame.viewport
        FollowSystemTheme()
        if !app_started { LoadWorkbook(); app_started = true }
        while Desktop.DesktopTakeDroppedFile(dropped_path[:]) { OpenDocument(TextUntilNul(dropped_path[:])) }
        menus_block_input = menu_state.initialized && (menu_state.open_index >= 0 || menu_state.focused)
        if !menus_block_input && !EditorFocused(editor) { EditorSetFocused(editor, true) }
        input := EditorSample(session, EditorBounds(viewport), editor, typed_storage[:], false)
        RunHostFrame(session, viewport, input)
    }

// The desktop program entry sits at column zero so Kryon's project check
// finds it; the hosted build above still enters through its `Main` protocol.
main :: () -> s32 { return App.Run(App.Window.{.title = "Workbook"}, Frame) }
}

#scope_file

// ---------------------------------------------------------------- host frame

EditorBounds :: (viewport: Rectangle) -> Rectangle {
    return Rectangle.{viewport.x, viewport.y + MenuBarHeight, viewport.width, viewport.height - MenuBarHeight}
}

DrawHostBackground :: (session: Session, viewport: Rectangle) {
    bar: Box.Props
    bar.key = cast(u64)990000
    bar.bounds = Rectangle.{viewport.x, viewport.y, viewport.width, MenuBarHeight}
    bar.fill = Grid.GridColor("canvas")
    Box.Draw(session, bar)
}

RunHostFrame :: (session: Session, viewport: Rectangle, input: EditorInput) {
    #if #defined(KRYON_HOSTED_UI) {
        if document_pending {
            response := AppService("document.pick.v1", "{\"op\":\"poll\"}")
            if response != "pending" {
                document_pending = false
                DocumentTransferred(response, document_export)
            }
        }
    }
    menus_block_input = menu_state.initialized && (menu_state.open_index >= 0 || menu_state.focused)
    if !menus_block_input && !EditorFocused(editor) { EditorSetFocused(editor, true) }
    control := (input.modifiers & KeyModifierControl) != 0
    if !menus_block_input && control {
        if input.key == KeyO {
            input.key = 0
            input.typed = ""
            PickDocument(false)
        } else if input.key == KeyS && (input.modifiers & KeyModifierShift) != 0 {
            input.key = 0
            input.typed = ""
            PickDocument(true)
        }
    }
    menu_key = input.key
    menu_modifiers = input.modifiers
    if menus_block_input {
        menu_key, menu_modifiers = HostKey(session, input)
        input.key = 0
        input.typed = ""
        input.blocked = true
        #if !#defined(KRYON_HOSTED_UI) {
            DiscardTyped(session)
        }
    } else if menu_key == KeyF10 || ((menu_modifiers & KeyModifierAlt) != 0 && menu_key == KeyF) {
        input.key = 0
        input.typed = ""
        input.blocked = true
    } else if input.pointer.pressed &&
    PointInBounds(input.pointer.x, input.pointer.y, Rectangle.{viewport.x, viewport.y, viewport.width, MenuBarHeight}) {
        input.blocked = true
    }
    DrawHostBackground(session, viewport)
    unused EditorFrame(session, EditorBounds(viewport), editor, input)
    DrawMenus(session, viewport)
}

#if #defined(KRYON_HOSTED_UI) {
    HostKey :: (session: Session, input: EditorInput) -> (key: s32, modifiers: s32) {
        unused session
        return input.key, input.modifiers
    }
} else {
    HostKey :: (session: Session, input: EditorInput) -> (key: s32, modifiers: s32) {
        if input.key != 0 || input.typed.count > 0 { return input.key, input.modifiers }
        return KeyboardTake(session), KeyboardModifiers(session)
    }

    DiscardTyped :: (session: Session) {
        while TypedCodepointTake(session) != 0 {}
    }
}

// -------------------------------------------------------------------- menus

DrawMenus :: (session: Session, viewport: Rectangle) {
    file: [4]Menu.MenuItem
    file_count: s32 = 3
    file[0] = Menu.MenuItem.{.id = 101, .label = "Open…", .accelerator = "Ctrl+O"}
    file[1] = Menu.MenuItem.{.id = 102, .label = "Save", .accelerator = "Ctrl+S"}
    file[2] = Menu.MenuItem.{.id = 103, .label = "Save As…", .accelerator = "Ctrl+Shift+S"}
    #if #defined(KRYON_HOSTED_UI) {
        if AppSupports("app.bundle.export.v1") {
            file_count = 4
            file[3] = Menu.MenuItem.{.id = 104, .label = "Download Workbook.zx…"}
        }
    }
    edit_items: [9]Menu.MenuItem
    edit_items[0] = Menu.MenuItem.{.id = 201, .label = "Undo", .accelerator = "Ctrl+Z", .disabled = !EditorCanUndo(editor)}
    edit_items[1] = Menu.MenuItem.{.id = 202, .label = "Redo", .accelerator = "Ctrl+Y", .disabled = !EditorCanRedo(editor)}
    edit_items[2].kind = Menu.MenuItemKind.MenuSeparator
    edit_items[3] = Menu.MenuItem.{.id = 1, .label = "Cut", .accelerator = "Ctrl+X"}
    edit_items[4] = Menu.MenuItem.{.id = 2, .label = "Copy", .accelerator = "Ctrl+C"}
    edit_items[5] = Menu.MenuItem.{.id = 3, .label = "Paste", .accelerator = "Ctrl+V", .disabled = !EditorClipboardAvailable()}
    edit_items[6] = Menu.MenuItem.{.id = 4, .label = "Clear contents", .accelerator = "Delete"}
    edit_items[7].kind = Menu.MenuItemKind.MenuSeparator
    edit_items[8] = Menu.MenuItem.{.id = 203, .label = "Select all", .accelerator = "Ctrl+A"}
    view: [2]Menu.MenuItem
    view[0] = Menu.MenuItem.{.id = 301, .label = "Go to first cell", .accelerator = "Ctrl+Home"}
    view[1] = Menu.MenuItem.{.id = 302,
        .label = ifx EditorShowHiddenSheets(editor) then "Hide hidden sheets" else "Show hidden sheets",
        .disabled = EditorHiddenSheetCount(editor) == 0}
    insert: [3]Menu.MenuItem
    insert[0] = Menu.MenuItem.{.id = 6, .label = "Row above"}
    insert[1] = Menu.MenuItem.{.id = 10, .label = "Row below"}
    insert[2] = Menu.MenuItem.{.id = 8, .label = "Column before"}
    sheet: [5]Menu.MenuItem
    sheet[0] = Menu.MenuItem.{.id = 401, .label = "Add sheet"}
    sheet[1] = Menu.MenuItem.{.id = 402, .label = "Previous sheet", .disabled = EditorSheetIndex(editor) == 0}
    sheet[2] = Menu.MenuItem.{.id = 403, .label = "Next sheet", .disabled = EditorSheetIndex(editor) + 1 >= EditorSheetCount(editor)}
    sheet[3] = Menu.MenuItem.{.id = 404, .label = "Recalculate"}
    sheet[4] = Menu.MenuItem.{.id = 405, .label = "Create formula chart from selection"}
    groups: [5]Menu.MenuGroup
    groups[0] = Menu.MenuGroup.{"File", file[:file_count]}
    groups[1] = Menu.MenuGroup.{"Edit", edit_items[:]}
    groups[2] = Menu.MenuGroup.{"View", view[:]}
    groups[3] = Menu.MenuGroup.{"Insert", insert[:]}
    groups[4] = Menu.MenuGroup.{"Sheet", sheet[:]}
    props: Menu.Props
    props.key = cast(u64)1300
    props.bounds = Rectangle.{viewport.x, viewport.y, viewport.width, MenuBarHeight}
    props.focus_requested = menu_key == KeyF10 || ((menu_modifiers & KeyModifierAlt) != 0 && menu_key == KeyF)
    props.input.up = menu_key == KeyUp
    props.input.down = menu_key == KeyDown
    props.input.left = menu_key == KeyLeft
    props.input.right = menu_key == KeyRight
    props.input.enter = menu_key == KeyEnter
    props.input.escape = menu_key == KeyEscape
    result := EditorMenu(session, props, groups[:], *menu_state)
    id := result.activated_id
    if id == 101 { PickDocument(false) }
    if id == 102 { unused EditorSave(editor, true) }
    if id == 103 { PickDocument(true) }
    #if #defined(KRYON_HOSTED_UI) {
        if id == 104 { unused AppService("app.bundle.export.v1", "") }
    }
    if id == 1 { EditorCut(editor) }
    if id == 2 { EditorCopy(editor) }
    if id == 3 { EditorPaste(editor) }
    if id == 4 { EditorClear(editor) }
    if id == 201 { EditorUndo(editor) }
    if id == 202 { EditorRedo(editor) }
    if id == 203 { EditorSelectAll(editor) }
    if id == 301 { EditorGoToFirstCell(editor) }
    if id == 302 { EditorSetShowHiddenSheets(editor, !EditorShowHiddenSheets(editor)) }
    if id == 401 { EditorAddSheet(editor) }
    if id == 402 { EditorSelectSheet(editor, EditorSheetIndex(editor) - 1) }
    if id == 403 { EditorSelectSheet(editor, EditorSheetIndex(editor) + 1) }
    if id == 404 { EditorRecalculate(editor) }
    if id == 405 { EditorCreateFormulaChart(editor) }
    if id == 6 { EditorInsertRow(editor) }
    if id == 10 { EditorInsertRowBelow(editor) }
    if id == 7 { EditorDeleteRow(editor) }
    if id == 8 { EditorInsertColumn(editor) }
    if id == 9 { EditorDeleteColumn(editor) }
}

EditorMenu :: (session: Session, props: Menu.Props, groups: []Menu.MenuGroup, state: *Menu.MenuState) -> Menu.MenuResult {
    #if #defined(KRYON_HOSTED_UI) {
        if !state.initialized { Menu.MenuStateInit(state) }
        result: Menu.MenuResult
        x := props.bounds.x + 2.0
        for index: 0..groups.count - 1 {
            button: Button.Props
            button.key = cast(u64)(1310 + index)
            button.label = groups[index].label
            button.bounds = Rectangle.{x, props.bounds.y, 58.0, 26.0}
            button.size = ControlSize.ControlSizeSmall
            if Button.Draw(session, button) != 0 { state.open_index = ifx state.open_index == index then -1 else cast(s32)index }
            if state.open_index == index { menu_x = x }
            x += 58.0
        }
        if state.open_index >= 0 && state.open_index < groups.count {
            items: [16]ContextMenu.ContextMenuItem
            commands := groups[state.open_index].items
            for index: 0..commands.count - 1 {
                items[index].id = commands[index].id
                items[index].label = commands[index].label
                items[index].disabled = commands[index].disabled
                items[index].separator = commands[index].kind == Menu.MenuItemKind.MenuSeparator
            }
            menu: ContextMenu.Props
            menu.key = cast(u64)(1350 + state.open_index)
            menu.open = true
            menu.x = menu_x
            menu.y = props.bounds.y + 26.0
            menu.escape = props.input.escape
            drawn := ContextMenu.Draw(session, menu, items[:commands.count])
            if !drawn.open { state.open_index = -1 }
            result.activated_id = drawn.activated_id
        }
        result.open_index = state.open_index
        return result
    } else {
        return Menu.Draw(session, props, groups, state)
    }
}

// --------------------------------------------------------------------- text

SetText :: (output: []u8, value: string) {
    output[0] = 0
    AppendText(output, value)
}

AppendText :: (output: []u8, value: string) {
    at: s32 = cast(s32)TextUntilNul(output).count
    index: s32 = 0
    while index < cast(s32)value.count && at + 1 < cast(s32)output.count {
        output[at] = value[index]
        at += 1
        index += 1
    }
    output[at] = 0
}

FileName :: (path: string) -> string {
    at: s32 = cast(s32)path.count
    while at > 0 && path[at - 1] != #char "/" {
        at -= 1
    }
    return path[at:cast(s32)path.count]
}

EndsWith :: (text: string, suffix: string) -> bool {
    if text.count < suffix.count { return false }
    start: s32 = cast(s32)(text.count - suffix.count)
    return text[start:cast(s32)text.count] == suffix
}

UpdateDocumentTitle :: () {
    #if !#defined(KRYON_HOSTED_UI) {
        path_buffer: [4096]u8
        path := EditorPath(editor, path_buffer[:])
        unused Desktop.DesktopSetTitle(FileName(path))
    }
}

// ------------------------------------------------------------------- native

#if !#defined(KRYON_HOSTED_UI) {
    // Styles the app in the desktop's GTK theme and follows it when it changes:
    // the configured theme is looked at again every couple of seconds.
    FollowSystemTheme :: () {
        if theme_installed {
            theme_frames += 1
            if theme_frames < 120 { return }
            theme_frames = 0
        }
        name: string = SystemThemeLinux.SystemThemeName()
        if theme_installed && name == TextUntilNul(theme_name[:]) { return }
        unused SystemStyle.SystemPaletteInstall(SystemThemeLinux.SystemPaletteRead())
        SetText(theme_name[:], name)
        theme_installed = true
    }

    LoadWorkbook :: () {
        book: *Engine.Workbook = Engine.WorkbookNew()
        if book == null {
            EditorInitWithWorkbook(*editor_storage, null, "", true)
            editor = *editor_storage
            EditorSetStatus(editor, "Could not create a workbook")
            return
        }
        application: string = "workbook"
        override: *u8 = EnvironmentValue(CPath("WORKBOOK_DIR"))
        profile: *u8 = EnvironmentValue(CPath("WORKBOOK_PROFILE"))
        profile_name: string = ""
        if profile != null { profile_name = TextFromCString(profile) }
        if StartedAs("geld") { profile_name = "geld" }
        // Any named profile keeps its own data directory, the way geld does.
        if profile_name != "workbook" && ProfileName(profile_name) {
            application = profile_name
            override = null
            if profile_name == "geld" { override = EnvironmentValue(CPath("GELD_DIR")) }
        }
        legacy_profile: bool = application != "workbook"
        path_buffer: [4096]u8
        directory_buffer: [4096]u8
        explicit: [4096]u8
        if OpenFileArgument(explicit[:]) {
            SetText(path_buffer[:], TextUntilNul(explicit[:]))
        } else if override != null && override[0] != 0 {
            legacy_profile = true
            SetText(path_buffer[:], TextFromCString(override))
            AppendText(path_buffer[:], "/workbook.gnumeric")
        } else if application == "workbook" && FileExists("workbook.gnumeric") {
            SetText(path_buffer[:], "workbook.gnumeric")
        } else {
            base: *u8 = EnvironmentValue(CPath("XDG_DATA_HOME"))
            if base != null && base[0] != 0 {
                SetText(directory_buffer[:], TextFromCString(base))
            } else {
                home: *u8 = EnvironmentValue(CPath("HOME"))
                if home != null && home[0] != 0 {
                    SetText(directory_buffer[:], TextFromCString(home))
                } else {
                    SetText(directory_buffer[:], ".")
                }
                AppendText(directory_buffer[:], "/.local/share")
            }
            AppendText(directory_buffer[:], "/")
            AppendText(directory_buffer[:], application)
            SetText(path_buffer[:], TextUntilNul(directory_buffer[:]))
            AppendText(path_buffer[:], "/workbook.gnumeric")
        }
        path: string = TextUntilNul(path_buffer[:])
        imported: bool = false
        legacy: [4096]u8
        if legacy_profile && PathAccess(*path_buffer[0], 0) != 0 && EndsWith(path, ".gnumeric") {
            // Named or explicitly selected profiles may import their old JSON.
            // Ordinary Workbook launches must not load the former finance seed.
            // The original JSON is only read and remains available.
            SetText(legacy[:], path[0:cast(s32)path.count - 8])
            AppendText(legacy[:], "json")
            if PathAccess(*legacy[0], 0) == 0 {
                unused Engine.WorkbookAddSheet(book, Engine.CText("Sheet1"))
                imported = LoadLegacyJson(book, *legacy[0])
            }
        }
        failed: bool = false
        if !imported && PathAccess(*path_buffer[0], 0) == 0 {
            failed = Engine.WorkbookLoadFile(book, Engine.CText(path)) == 0
        }
        // A file supplies its own sheets; a new workbook starts with one.
        if Engine.WorkbookSheetCount(book) == 0 {
            unused Engine.WorkbookAddSheet(book, Engine.CText("Sheet1"))
        }
        EditorInitWithWorkbook(*editor_storage, book, path, failed)
        editor = *editor_storage
        EditorSetFocused(editor, true)
        if failed {
            message: [256]u8
            SetText(message[:], "Could not open ")
            AppendText(message[:], FileName(path))
            EditorSetStatus(editor, TextUntilNul(message[:]))
        }
        UpdateDocumentTitle()
    }

    // Finish and save the current document before replacing it. A failed
    // import leaves the current workbook, its path, selection and undo history
    // intact.
    OpenDocument :: (path: string) {
        if !EditorOpenPath(editor, path) { return }
        EditorSetFocused(editor, true)
        UpdateDocumentTitle()
    }

    PickDocument :: (save: bool) {
        path_buffer: [4096]u8
        props: Picker.FilePickerProps
        props.title = ifx save then "Save Workbook As" else "Open Workbook"
        props.filter = "Spreadsheets | *.ods *.gnumeric *.csv"
        props.save = save
        current_buffer: [4096]u8
        current := EditorPath(editor, current_buffer[:])
        suggestion: [4096]u8
        SetText(suggestion[:], FileName(current))
        props.suggested_name = TextUntilNul(suggestion[:])
        result := Picker.PickFile(props, path_buffer[:])
        if result < 0 { EditorSetStatus(editor, "Could not open the file chooser") }
        if result != 1 { return }
        if !save { OpenDocument(TextUntilNul(path_buffer[:])); return }
        if !DocumentPath(TextUntilNul(path_buffer[:])) {
            if EndsWith(current, ".ods") || EndsWith(current, ".ODS") {
                AppendText(path_buffer[:], ".ods")
            } else {
                AppendText(path_buffer[:], ".gnumeric")
            }
        }
        if EditorSaveAs(editor, TextUntilNul(path_buffer[:])) {
            EditorSetFocused(editor, true)
            UpdateDocumentTitle()
        }
    }

}

// ------------------------------------------------------------------- hosted

#if #defined(KRYON_HOSTED_UI) {
    FollowSystemTheme :: () {}

    StartHostedWorkbook :: () {
        book: *Engine.Workbook = Engine.WorkbookNew()
        path: string = "workbook.gnumeric"
        failed: bool = false
        if book != null {
            loaded := Engine.WorkbookLoadFile(book, Engine.CText(path)) != 0
            failed = !loaded && Engine.DocumentStatus != DOCUMENT_MISSING
            if Engine.WorkbookSheetCount(book) == 0 {
                unused Engine.WorkbookAddSheet(book, Engine.CText("Sheet1"))
            }
        }
        EditorInitWithWorkbook(*editor_storage, book, path, failed)
        editor = *editor_storage
        EditorSetFocused(editor, true)
        if failed { EditorSetStatus(editor, "Could not open workbook.gnumeric") }
    }

    PickDocument :: (save: bool) {
        if document_pending { return }
        if save {
            unused EditorSave(editor, true)
            if EditorDirty(editor) { return }
        }
        response := AppService("document.pick.v1", ifx save then "{\"op\":\"export\",\"name\":\"workbook.gnumeric\",\"filter\":\"Spreadsheet | *.gnumeric\",\"suggested_name\":\"workbook.gnumeric\"}" else "{\"op\":\"import\",\"name\":\"incoming.gnumeric\",\"filter\":\"Spreadsheet | *.gnumeric\"}")
        if response == "pending" {
            document_pending = true
            document_export = save
        } else {
            DocumentTransferred(response, save)
        }
    }

    DocumentTransferred :: (response: string, save: bool) {
        if response == "ready" && !save {
            if EditorOpenPath(editor, "incoming.gnumeric") {
                unused EditorSaveAs(editor, "workbook.gnumeric")
            }
        }
        if response == "error" { EditorSetStatus(editor, "Could not transfer the document") }
    }

    ReadInput :: () {
        value := AppService("input.v1", "frame")
        input_pointer.x = cast(float32)Engine.Number(value, "x")
        input_pointer.y = cast(float32)Engine.Number(value, "y")
        input_pointer.down = Engine.Number(value, "down") != 0
        input_pointer.pressed = Engine.Number(value, "pressed") != 0
        input_pointer.released = Engine.Number(value, "released") != 0
        input_secondary.down = Engine.Number(value, "secondary_down") != 0
        input_secondary.pressed = Engine.Number(value, "secondary_pressed") != 0
        input_secondary.released = Engine.Number(value, "secondary_released") != 0
        input_wheel = cast(float32)Engine.Number(value, "wheel")
    }
}

// ---------------------------------------------------------------- legacy JSON

#if !#defined(KRYON_HOSTED_UI) {
    // The legacy JSON layout stores one object per row with eight named columns.
    LegacyColumn :: (column: s32) -> string {
        if column == 0 { return "section" }
        if column == 1 { return "label" }
        if column == 2 { return "id" }
        if column == 3 { return "units" }
        if column == 4 { return "rate" }
        if column == 5 { return "pct" }
        if column == 6 { return "usd" }
        return "dusd"
    }

    // The expression field that carries a column's formula, when it has one. The
    // text has no leading "=".
    LegacyExpression :: (column: s32) -> string {
        if column == 3 { return "units_expr" }
        if column == 6 { return "usd_expr" }
        if column == 7 { return "dusd_expr" }
        return ""
    }

    // Reads one legacy value into cell text: a string, a number, or a formula
    // (an expression field, or an object with an "expr" field).
    LegacyCell :: (text: string, value: s32, is_expression: bool, cell: []u8) {
        scratch: [256]u8
        at: s32 = value
        formula: bool = is_expression
        scratch[0] = 0
        cell[0] = 0
        if at >= 0 && text[at] == #char "{" {
            at = Json.FieldAt(text, at, "expr")
            formula = true
        }
        if at < 0 { return }
        if text[at] == #char "\"" {
            span: Json.JsonSpan = Json.ReadString(text, at)
            if span.valid { DecodeJsonString(text, span, scratch[:]) }
        } else {
            number: Json.JsonNumber = Json.ReadNumber(text, at)
            if number.valid {
                FormatBytes(*scratch[0], 256, cast(*u8)Engine.CText("%.15g"), number.value)
            }
        }
        if scratch[0] == 0 { return }
        if formula && scratch[0] != #char "=" {
            SetText(cell, "=")
            AppendText(cell, TextUntilNul(scratch[:]))
        } else {
            SetText(cell, TextUntilNul(scratch[:]))
        }
    }

    // The id column holds a ticker: the file names a coin by its market id, so
    // that becomes the coin's ticker, as EUR and PYG already are.
    LegacyTicker :: (cell: []u8) {
        ticker: string = ""
        {
            id: string = TextUntilNul(cell)
            if id == "monero" {
                ticker = "XMR"
            } else if id == "bitcoin" {
                ticker = "BTC"
            } else if id == "ethereum" {
                ticker = "ETH"
            } else if id == "litecoin" {
                ticker = "LTC"
            }
        }
        if ticker != "" {
            SetText(cell, ticker)
        }
    }

    // Imports a legacy workbook.json: the rows, then the pending and final total
    // rows. The file is only read.
    LoadLegacyJson :: (book: *Engine.Workbook, path: *u8) -> bool {
        size: s32 = 0
        bytes: *u8 = Engine.ReadFileBytes(cast(*s8)path, *size)
        if bytes == null { return false }
        text: string = TextFromBytes(BytesFromPointer(bytes, cast(u64)size))
        top: s32 = Json.Space(text, 0)
        rows: s32 = Json.FieldAt(text, top, "rows")
        count: s32 = 0
        if rows >= 0 { count = Json.ArrayCount(text, rows) }
        row: s32 = 0
        while row < count {
            item: s32 = Json.ElementAt(text, rows, row)
            column: s32 = 0
            while item >= 0 && column < 8 {
                cell: [256]u8
                expression: string = LegacyExpression(column)
                found: s32 = -1
                if expression.count > 0 { found = Json.FieldAt(text, item, expression) }
                if found >= 0 {
                    LegacyCell(text, found, true, cell[:])
                } else {
                    LegacyCell(text, Json.FieldAt(text, item, LegacyColumn(column)), false, cell[:])
                }
                if column == 2 { LegacyTicker(cell[:]) }
                if cell[0] != 0 {
                    Engine.WorkbookSetCell(book, 0, row, column, Engine.CText(TextUntilNul(cell[:])))
                }
                column += 1
            }
            row += 1
        }
        pass: s32 = 0
        while pass < 2 {
            totals: s32 = Json.FieldAt(text, top, ifx pass == 0 then "total_pending_cells" else "total_cells")
            if totals >= 0 {
                column: s32 = 0
                while column < 8 {
                    cell: [256]u8
                    LegacyCell(text, Json.ElementAt(text, totals, column), false, cell[:])
                    if cell[0] != 0 {
                        Engine.WorkbookSetCell(book, 0, row, column, Engine.CText(TextUntilNul(cell[:])))
                    }
                    column += 1
                }
                row += 1
            }
            pass += 1
        }
        Engine.FreeFileBytes(bytes)
        Engine.WorkbookEvaluate(book)
        return true
    }

    // Copies a JSON string's contents, decoding its escapes.
    DecodeJsonString :: (text: string, span: Json.JsonSpan, output: []u8) {
        at: s32 = 0
        index: s32 = span.start
        while index < span.end && at + 4 < cast(s32)output.count {
            byte: u8 = text[index]
            if byte != #char "\\" || index + 1 >= span.end {
                output[at] = byte
                at += 1
                index += 1
                continue
            }
            escape: u8 = text[index + 1]
            index += 2
            if escape == #char "n" {
                output[at] = 10
                at += 1
            } else if escape == #char "t" {
                output[at] = 9
                at += 1
            } else if escape == #char "r" {
                output[at] = 13
                at += 1
            } else if escape == #char "b" {
                output[at] = 8
                at += 1
            } else if escape == #char "f" {
                output[at] = 12
                at += 1
            } else if escape == #char "u" && index + 4 <= span.end {
                at = AppendUtf8(output, at, HexValue(text, index))
                index += 4
            } else {
                output[at] = escape
                at += 1
            }
        }
        output[at] = 0
    }

    HexValue :: (text: string, at: s32) -> s32 {
        value: s32 = 0
        index: s32 = 0
        while index < 4 {
            byte: s32 = text[at + index]
            digit: s32 = 0
            if byte >= 48 && byte <= 57 { digit = byte - 48 }
            if byte >= 65 && byte <= 70 { digit = byte - 55 }
            if byte >= 97 && byte <= 102 { digit = byte - 87 }
            value = value * 16 + digit
            index += 1
        }
        return value
    }

    AppendUtf8 :: (output: []u8, at: s32, codepoint: s32) -> s32 {
        if codepoint < 0x80 {
            output[at] = cast(u8)codepoint
            return at + 1
        }
        if codepoint < 0x800 {
            output[at] = cast(u8)(0xC0 | (codepoint >> 6))
            output[at + 1] = cast(u8)(0x80 | (codepoint & 0x3F))
            return at + 2
        }
        if codepoint < 0x10000 {
            output[at] = cast(u8)(0xE0 | (codepoint >> 12))
            output[at + 1] = cast(u8)(0x80 | ((codepoint >> 6) & 0x3F))
            output[at + 2] = cast(u8)(0x80 | (codepoint & 0x3F))
            return at + 3
        }
        output[at] = cast(u8)(0xF0 | (codepoint >> 18))
        output[at + 1] = cast(u8)(0x80 | ((codepoint >> 12) & 0x3F))
        output[at + 2] = cast(u8)(0x80 | ((codepoint >> 6) & 0x3F))
        output[at + 3] = cast(u8)(0x80 | (codepoint & 0x3F))
        return at + 4
    }

    // A profile name is also a directory name: lowercase letters, digits, - and _.
    ProfileName :: (name: string) -> bool {
        if name.count == 0 || name.count > 63 { return false }
        for i: 0..cast(s32)name.count - 1 {
            c: u8 = name[i]
            if !((c >= #char "a" && c <= #char "z") || (c >= #char "0" && c <= #char "9") || c == #char "-" || c == #char "_") { return false }
        }
        return true
    }

    DocumentPath :: (name: string) -> bool {
        if name.count < 4 || name.count >= 4096 { return false }
        tail4: string = name[cast(s32)name.count - 4:cast(s32)name.count]
        if Engine.TextCompareFoldLiteral(Engine.CText(tail4), ".ods") == 0 ||
        Engine.TextCompareFoldLiteral(Engine.CText(tail4), ".csv") == 0 { return true }
        if name.count < 9 { return false }
        suffix: string = name[cast(s32)name.count - 9:cast(s32)name.count]
        return Engine.TextCompareFoldLiteral(Engine.CText(suffix), ".gnumeric") == 0
    }

    // Linux's native host owns main; read its file argument without changing
    // the profile selection for launches that supplied no document.
    OpenFileArgument :: (out: []u8) -> bool {
        command: [8192]u8
        descriptor: s32 = OpenFile(CPath("/proc/self/cmdline"), 0)
        if descriptor < 0 { return false }
        length: s64 = ReadFileBytes(descriptor, *command[0], 8191)
        CloseFile(descriptor)
        if length <= 0 { return false }
        at: s32 = 0
        while at < cast(s32)length && command[at] != 0 { at += 1 }
        at += 1
        if at >= cast(s32)length { return false }
        end: s32 = at
        while end < cast(s32)length && command[end] != 0 { end += 1 }
        name: string = TextView(command[at:end])
        if !DocumentPath(name) { return false }
        if name.count >= out.count { return false }
        SetText(out, name)
        return true
    }

    // Whether the program was started under the given name. `geld` is a link to
    // workbook, and it opens the geld profile because of the name it was run as.
    StartedAs :: (name: string) -> bool {
        command: [4096]u8
        descriptor: s32 = OpenFile(CPath("/proc/self/cmdline"), 0)
        if descriptor < 0 { return false }
        length: s64 = ReadFileBytes(descriptor, *command[0], 4095)
        CloseFile(descriptor)
        if length <= 0 { return false }
        // The command line is NUL-separated words; the first one is how the
        // program was started.
        end: s32 = 0
        while end < cast(s32)length && command[end] != 0 { end += 1 }
        return FileName(TextView(command[0:end])) == name
    }

    FileExists :: (path: string) -> bool {
        return PathAccess(CPath(path), 0) == 0
    }

    // A NUL-terminated copy of a path or name for libc.
    CPath :: (text: string) -> *u8 {
        return cast(*u8)Engine.CText(text)
    }
}
