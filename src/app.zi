// Workbook desktop editor: a toolbar, sheet tabs, a formula bar, and the
// cell grid of the spreadsheet engine.
using UI :: #import "Widgets";
Engine :: #import "engine";
Json :: #import "json_scan";
SystemStyle :: #import "kss/SystemStyle";
SystemThemeLinux :: #import "SystemThemeLinux";
#import "byte_text_linux"
#import "font_metrics"
#import "text_buffer"
#import "std/vec"

SaveIcon :: #import "mingcute_regular_save_2";
RowAddIcon :: #import "mingcute_extra_table_row_add";
RowRemoveIcon :: #import "mingcute_extra_table_row_remove";
ColumnAddIcon :: #import "mingcute_extra_table_column_add";
ColumnRemoveIcon :: #import "mingcute_extra_table_column_remove";

using ButtonEmphasis;
using ButtonTone;
using ControlSize;
using TabBarPlacement;
using TextWrap;

#scope_file

libc :: #system_library "libc";
EnvironmentValue :: (name: *u8) -> *u8 #foreign libc "getenv";
PathAccess :: (path: *u8, mode: s32) -> s32 #foreign libc "access";
MakeDirectory :: (path: *u8, mode: u32) -> s32 #foreign libc "mkdir";
OpenFile :: (path: *u8, flags: s32, mode: ..any) -> s32 #foreign libc "open";
ReadFileBytes :: (descriptor: s32, output: *u8, count: u64) -> s64 #foreign libc "read";
CloseFile :: (descriptor: s32) -> s32 #foreign libc "close";
MakeTemporaryFile :: (path: *u8) -> s32 #foreign libc "mkstemp";
SyncFile :: (descriptor: s32) -> s32 #foreign libc "fsync";
RenameFile :: (source: *u8, destination: *u8) -> s32 #foreign libc "rename";
RemoveFile :: (path: *u8) -> s32 #foreign libc "unlink";
FormatBytes :: (output: *u8, capacity: u64, format: *u8, args: ..any) -> s32 #foreign libc "snprintf";
FreeBytes :: (block: *void) #foreign libc "free";
TimeSpec :: struct { seconds: s64; nanoseconds: s64; }
ClockTime :: (clock: s32, value: *TimeSpec) -> s32 #foreign libc "clock_gettime";

MaxRows :: 200;
MaxColumns :: 40;
CellTextMax :: 256;
ColumnWidth :: 110.0;
RowHeight :: 28.0;
HeaderHeight :: 30.0;
RowHeaderWidth :: 52.0;
TableTop :: 98.0;
Margin :: 24.0;
// Distances from the window's bottom edge to the sheet tabs and the grid.
TabsBottom :: 78.0;
GridBottom :: 88.0;

// Kryon names the other keys; letters are their uppercase ASCII codes.
KeyA :: 65;
KeyC :: 67;
KeyS :: 83;
KeyV :: 86;
KeyX :: 88;

// The cell menu: open, and where the secondary button was released.
grid_menu_open: bool = false;
grid_menu_x: float32 = 0.0;
grid_menu_y: float32 = 0.0;
grid_menu_row: bool = false;
clipboard_text: [8192]u8;

workbook: *Engine.Workbook;
sheet_index: s32 = 0;
selected_row: s32 = 0;
selected_column: s32 = 0;
// The selection's other corner: dragging or shift-clicking spans a range from
// the selected cell to it.
range_row: s32 = 0;
range_column: s32 = 0;
// A header selection covers every cell along that axis, including offscreen cells.
selection_axis: s32 = 0; // 0 cell, 1 row, 2 column
// The edited cell's sheet. While a formula is written the tabs may show another
// sheet to pick references from; the edit stays on this one.
edit_sheet: s32 = 0;
scroll_row: s32 = 0;
scroll_column: s32 = 0;
dirty: bool = false;
// A failed save is tried again at this monotonic time, in milliseconds. It is
// a time, not a frame count: an idle window draws fewer frames.
save_retry_at: s64 = 0;

// The formula bar edits a NUL-terminated copy of the selected cell's source.
edit: [256]u8;
// Live edits are saved too; Escape restores the value from before editing.
edit_original: [256]u8;
edit_cursor: s32 = 0;
edit_anchor: s32 = 0;
edit_scroll: s32 = 0;
edit_focused: bool = false;
edit_composition: CompositionState;
// A sheet tab pressed while a formula is written would take the field's focus;
// the field takes it back so the formula can point at the other sheet.
edit_refocus: bool = false;

// What a held pointer does on the grid.
DragNone :: 0;
DragRange :: 1;  // selects a range of cells
DragPick :: 2;   // points a formula reference at cells, as in Gnumeric
DragFill :: 3;   // the fill handle copies the selection down or across
drag_mode: s32 = DragNone;
drag_frames: s32 = 0;
shift_held: bool = false;
// The reference the last pick wrote into the formula, as edit bytes
// [pick_start, pick_end). Another pick replaces it while the cursor still
// sits right after it; any other edit or cursor move ends that.
pick_start: s32 = -1;
pick_end: s32 = -1;
pick_sheet: s32 = 0;
pick_anchor_row: s32 = 0;
pick_anchor_column: s32 = 0;
pick_row: s32 = 0;
pick_column: s32 = 0;
// The fill handle's target while it is dragged: the selection grows along
// one axis (1 rows, 2 columns) to fill_row or fill_column.
fill_axis: s32 = 0;
fill_row: s32 = 0;
fill_column: s32 = 0;
// The cells Copy put on the clipboard, so pasting them moves their formulas'
// relative references as a spreadsheet does. Cut text pastes unchanged.
copied_sheet: s32 = -1;
copied_row: s32 = 0;
copied_column: s32 = 0;
copied_text: [8192]u8;
copied_length: s32 = 0;

// The desktop theme the style was last built from.
theme_name: [128]u8;
theme_frames: s32 = 0;
theme_installed: bool = false;

data_path: [1024]u8;
data_directory: [1024]u8;
status: [256]u8;

#scope_export

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    FollowSystemTheme()
    if workbook == null {
        LoadWorkbook()
        SelectCell(0, 0)
    }
    key: s32 = KeyboardTake(session)
    control: bool = (KeyboardModifiers(session) & KeyModifierControl) != 0
    shift_held = (KeyboardModifiers(session) & KeyModifierShift) != 0
    typed: [128]u8
    typed_length: s32 = TakeTypedText(session, typed[:])
    if control && key == KeyS {
        SaveWorkbook(true)
        key = 0
    }

    pointer: PointerFrame = PointerSample(session)
    if pointer.pressed && FormulaEditing() &&
       PointInBounds(pointer.x, pointer.y, SheetTabsBounds(viewport)) { edit_refocus = true }

    DrawBackground(session, viewport)
    DrawToolbar(session, viewport)
    DrawSheetTabs(session, viewport)
    // The field consumes this frame's keys while it is being edited; the
    // grid takes them otherwise, never both.
    was_editing: bool = edit_focused
    DrawFormulaBar(session, viewport, key, control, typed[:], typed_length)
    if !was_editing {
        HandleGridKeys(key, control, typed[:], typed_length)
    }
    DrawGrid(session, viewport)
    DrawGridMenu(session, key == KeyEscape)
    if dirty && MonotonicMilliseconds() >= save_retry_at {
        SaveWorkbook(false)
    }
    DrawStatus(session, viewport)
    if edit_refocus && !pointer.down && !pointer.pressed { edit_refocus = false }
    return 0
}

#scope_file

// Styles the app in the desktop's GTK theme and follows it when it changes:
// the configured theme is looked at again every couple of seconds.
FollowSystemTheme :: () {
    if theme_installed {
        theme_frames += 1
        if theme_frames < 120 { return }
        theme_frames = 0
    }
    name: string = SystemThemeLinux.SystemThemeName()
    if theme_installed && name == TextUntilNul(theme_name[:]) { return }
    SystemStyle.StyleInstallSystem(SystemThemeLinux.SystemPaletteRead())
    SetText(theme_name[:], name)
    theme_installed = true
}

// -------------------------------------------------------------------- data

LoadWorkbook :: () {
    workbook = Engine.WorkbookNew()
    application: string = "workbook"
    override: *u8 = EnvironmentValue(CPath("WORKBOOK_DIR"))
    profile: *u8 = EnvironmentValue(CPath("WORKBOOK_PROFILE"))
    profile_name: string = ""
    if profile != null { profile_name = TextFromCString(profile) }
    if StartedAs("geld") { profile_name = "geld" }
    // Any named profile keeps its own data directory, the way geld does.
    if profile_name != "workbook" && ProfileName(profile_name) {
        application = profile_name
        override = null
        if profile_name == "geld" { override = EnvironmentValue(CPath("GELD_DIR")) }
    }
    if override != null && override[0] != 0 {
        SetText(data_directory[:], TextFromCString(override))
        SetText(data_path[:], TextFromCString(override))
        AppendText(data_path[:], "/workbook.gnumeric")
    } else if application == "workbook" &&
        (FileExists("workbook.gnumeric") || FileExists("workbook.json")) {
        SetText(data_path[:], "workbook.gnumeric")
    } else {
        base: *u8 = EnvironmentValue(CPath("XDG_DATA_HOME"))
        if base != null && base[0] != 0 {
            SetText(data_directory[:], TextFromCString(base))
        } else {
            home: *u8 = EnvironmentValue(CPath("HOME"))
            if home != null && home[0] != 0 {
                SetText(data_directory[:], TextFromCString(home))
            } else {
                SetText(data_directory[:], ".")
            }
            AppendText(data_directory[:], "/.local/share")
        }
        AppendText(data_directory[:], "/")
        AppendText(data_directory[:], application)
        SetText(data_path[:], TextUntilNul(data_directory[:]))
        AppendText(data_path[:], "/workbook.gnumeric")
    }
    path: string = TextUntilNul(data_path[:])
    loaded: bool = false
    imported: bool = false
    legacy: [4096]u8
    if PathAccess(*data_path[0], 0) != 0 && EndsWith(path, ".gnumeric") {
        // No workbook yet: import the older workbook.json beside it. It is
        // only read; the first save writes workbook.gnumeric.
        SetText(legacy[:], path[0:cast(s32)path.count - 8])
        AppendText(legacy[:], "json")
        if PathAccess(*legacy[0], 0) == 0 {
            Engine.WorkbookAddSheet(workbook, Engine.CText("Sheet1"))
            loaded = LoadLegacyJson(*legacy[0])
            imported = loaded
        }
    }
    if imported {
    } else if PathAccess(*data_path[0], 0) == 0 {
        loaded = Engine.WorkbookLoadFile(workbook, cast(*s8)*data_path[0]) != 0
    }
    // A file supplies its own sheets; a new workbook starts with one.
    if Engine.WorkbookSheetCount(workbook) == 0 {
        Engine.WorkbookAddSheet(workbook, Engine.CText("Sheet1"))
    }
    if imported {
        SetText(status[:], "Imported ")
        AppendText(status[:], "workbook.json")
        dirty = false
        return
    }
    if loaded {
        SetText(status[:], "Loaded ")
    } else {
        SetText(status[:], "New workbook ")
    }
    AppendText(status[:], FileName(path))
    dirty = false
}

MonotonicMilliseconds :: () -> s64 {
    now: TimeSpec
    ClockTime(1, *now)
    return now.seconds * 1000 + now.nanoseconds / 1000000
}

// Creates every missing parent, including a fresh XDG data directory.
EnsureDataDirectory :: () -> bool {
    path: string = TextUntilNul(data_directory[:])
    prefix: [1024]u8
    at: s32 = 1
    while at <= cast(s32)path.count {
        if at == cast(s32)path.count || path[at] == #char "/" {
            SetText(prefix[:], path[0:at])
            if MakeDirectory(*prefix[0], 448) != 0 && PathAccess(*prefix[0], 0) != 0 {
                return false
            }
        }
        at += 1
    }
    return true
}

SaveWorkbook :: (finish_edit: bool) {
    if finish_edit && edit_focused {
        CommitCell()
        EndEdit()
        SelectCell(selected_row, selected_column)
    }
    path: string = TextUntilNul(data_path[:])
    saved: bool = false
    // Replace the previous file only after its replacement has been written
    // and synced. A failed write leaves the last saved workbook intact.
    temporary: [1100]u8
    SetText(temporary[:], path)
    AppendText(temporary[:], ".tmp-XXXXXX")
    if EnsureDataDirectory() {
        descriptor: s32 = MakeTemporaryFile(*temporary[0])
        if descriptor >= 0 {
            saved = Engine.WorkbookWriteGnumeric(workbook, cast(*s8)*temporary[0]) != 0
            if saved { saved = SyncFile(descriptor) == 0 }
            if CloseFile(descriptor) != 0 { saved = false }
            if saved { saved = RenameFile(*temporary[0], *data_path[0]) == 0 }
            if !saved { RemoveFile(*temporary[0]) }
        }
    }
    if saved {
        SetText(status[:], "Saved ")
        dirty = false
        save_retry_at = 0
    } else {
        SetText(status[:], "Could not save ")
        dirty = true
        save_retry_at = MonotonicMilliseconds() + 2000
    }
    AppendText(status[:], FileName(path))
}

// The legacy JSON layout stores one object per row with eight named columns.
LegacyColumn :: (column: s32) -> string {
    if column == 0 { return "section" }
    if column == 1 { return "label" }
    if column == 2 { return "id" }
    if column == 3 { return "units" }
    if column == 4 { return "rate" }
    if column == 5 { return "pct" }
    if column == 6 { return "usd" }
    return "dusd"
}

// The expression field that carries a column's formula, when it has one. The
// text has no leading "=".
LegacyExpression :: (column: s32) -> string {
    if column == 3 { return "units_expr" }
    if column == 6 { return "usd_expr" }
    if column == 7 { return "dusd_expr" }
    return ""
}

// Reads one legacy value into cell text: a string, a number, or a formula
// (an expression field, or an object with an "expr" field).
LegacyCell :: (text: string, value: s32, is_expression: bool, cell: []u8) {
    scratch: [256]u8
    at: s32 = value
    formula: bool = is_expression
    scratch[0] = 0
    cell[0] = 0
    if at >= 0 && text[at] == #char "{" {
        at = Json.FieldAt(text, at, "expr")
        formula = true
    }
    if at < 0 { return }
    if text[at] == #char "\"" {
        span: Json.JsonSpan = Json.ReadString(text, at)
        if span.valid { DecodeJsonString(text, span, scratch[:]) }
    } else {
        number: Json.JsonNumber = Json.ReadNumber(text, at)
        if number.valid {
            FormatBytes(*scratch[0], 256, cast(*u8)Engine.CText("%.15g"), number.value)
        }
    }
    if scratch[0] == 0 { return }
    if formula && scratch[0] != #char "=" {
        SetText(cell, "=")
        AppendText(cell, TextUntilNul(scratch[:]))
    } else {
        SetText(cell, TextUntilNul(scratch[:]))
    }
}

// The id column holds a ticker: the file names a coin by its market id, so
// that becomes the coin's ticker, as EUR and PYG already are.
LegacyTicker :: (cell: []u8) {
    ticker: string = ""
    {
        id: string = TextUntilNul(cell)
        if id == "monero" {
            ticker = "XMR"
        } else if id == "bitcoin" {
            ticker = "BTC"
        } else if id == "ethereum" {
            ticker = "ETH"
        } else if id == "litecoin" {
            ticker = "LTC"
        }
    }
    if ticker != "" {
        SetText(cell, ticker)
    }
}

// Imports a legacy workbook.json: the rows, then the pending and final total
// rows. The file is only read.
LoadLegacyJson :: (path: *u8) -> bool {
    size: s32 = 0
    bytes: *u8 = Engine.ReadFileBytes(cast(*s8)path, *size)
    if bytes == null { return false }
    text: string = TextFromBytes(BytesFromPointer(bytes, cast(u64)size))
    top: s32 = Json.Space(text, 0)
    rows: s32 = Json.FieldAt(text, top, "rows")
    count: s32 = 0
    if rows >= 0 { count = Json.ArrayCount(text, rows) }
    row: s32 = 0
    while row < count {
        item: s32 = Json.ElementAt(text, rows, row)
        column: s32 = 0
        while item >= 0 && column < 8 {
            cell: [256]u8
            expression: string = LegacyExpression(column)
            found: s32 = -1
            if expression.count > 0 { found = Json.FieldAt(text, item, expression) }
            if found >= 0 {
                LegacyCell(text, found, true, cell[:])
            } else {
                LegacyCell(text, Json.FieldAt(text, item, LegacyColumn(column)), false, cell[:])
            }
            if column == 2 { LegacyTicker(cell[:]) }
            if cell[0] != 0 {
                Engine.WorkbookSetCell(workbook, 0, row, column, cast(*s8)*cell[0])
            }
            column += 1
        }
        row += 1
    }
    pass: s32 = 0
    while pass < 2 {
        totals: s32 = Json.FieldAt(text, top, ifx pass == 0 then "total_pending_cells" else "total_cells")
        if totals >= 0 {
            column: s32 = 0
            while column < 8 {
                cell: [256]u8
                LegacyCell(text, Json.ElementAt(text, totals, column), false, cell[:])
                if cell[0] != 0 {
                    Engine.WorkbookSetCell(workbook, 0, row, column, cast(*s8)*cell[0])
                }
                column += 1
            }
            row += 1
        }
        pass += 1
    }
    Engine.FreeFileBytes(bytes)
    Engine.WorkbookEvaluate(workbook)
    return true
}

// ------------------------------------------------------------------ editing

CellSource :: (sheet: s32, row: s32, column: s32) -> string {
    text: *s8 = Engine.WorkbookCellText(workbook, sheet, row, column)
    if text == null { return "" }
    return TextFromCString(cast(*u8)text)
}

SelectCell :: (row: s32, column: s32) {
    selection_axis = 0
    if row < 0 { row = 0 }
    if column < 0 { column = 0 }
    if row >= MaxRows { row = MaxRows - 1 }
    if column >= MaxColumns { column = MaxColumns - 1 }
    selected_row = row
    selected_column = column
    range_row = row
    range_column = column
    edit_sheet = sheet_index
    pick_start = -1
    SetText(edit[:], CellSource(sheet_index, row, column))
    SetText(edit_original[:], TextUntilNul(edit[:]))
    edit_cursor = cast(s32)TextUntilNul(edit[:]).count
    edit_anchor = edit_cursor
    edit_scroll = 0
}

CommitCell :: () {
    if CellSource(edit_sheet, selected_row, selected_column) == TextUntilNul(edit[:]) {
        return
    }
    Engine.WorkbookSetCell(workbook, edit_sheet, selected_row,
        selected_column, cast(*s8)*edit[0])
    Engine.WorkbookEvaluate(workbook)
    dirty = true
    save_retry_at = 0
    SetText(status[:], "Edited ")
    AppendCellName(status[:], selected_row, selected_column)
}

// Leaves the edit; a formula picked on another sheet returns to its own sheet.
EndEdit :: () {
    edit_focused = false
    pick_start = -1
    if sheet_index != edit_sheet {
        sheet_index = edit_sheet
        scroll_row = 0
        scroll_column = 0
    }
}

// The selection's bounds. Header commands cover the sheet's used extent,
// beyond the viewport limits.
SelectionFirstRow :: () -> s32 { return ifx selection_axis == 2 then 0 else Min(selected_row, range_row) }
SelectionLastRow :: () -> s32 { return ifx selection_axis == 2 then Engine.WorkbookSheetRows(workbook, sheet_index) - 1 else Max(selected_row, range_row) }
SelectionFirstColumn :: () -> s32 { return ifx selection_axis == 1 then 0 else Min(selected_column, range_column) }
SelectionLastColumn :: () -> s32 { return ifx selection_axis == 1 then Engine.WorkbookSheetColumns(workbook, sheet_index) - 1 else Max(selected_column, range_column) }

Min :: (a: s32, b: s32) -> s32 { return ifx a < b then a else b }
Max :: (a: s32, b: s32) -> s32 { return ifx a > b then a else b }

// The selection's source goes to the system clipboard as tab-separated cells.
CopyCell :: () {
    text: Vec(u8); defer { VecFree(text) }
    first_row := SelectionFirstRow()
    last_row := SelectionLastRow()
    first_column := SelectionFirstColumn()
    last_column := SelectionLastColumn()
    for row: first_row..last_row {
        if row > first_row { unused VecPush(text, cast(u8)10) }
        for column: first_column..last_column {
            if column > first_column { unused VecPush(text, cast(u8)9) }
            source := CellSource(sheet_index, row, column)
            for byte: source { unused VecPush(text, byte) }
        }
    }
    copied := TextFromBytes(VecSlice(text, 0, text.count))
    SystemClipboardSet(copied)
    copied_sheet = -1
    if copied.count > copied_text.count { return }
    for at: 0..cast(s32)copied.count - 1 { copied_text[at] = copied[at] }
    copied_length = cast(s32)copied.count
    copied_sheet = sheet_index
    copied_row = first_row
    copied_column = first_column
}

CutCell :: () {
    CopyCell()
    copied_sheet = -1
    ClearCell()
}

// Pastes the clipboard's text from the selection's first cell: tabs separate
// columns and lines separate rows, so cells copied from another spreadsheet
// keep their layout. Formulas this app copied move with the paste.
PasteCells :: () {
    text: string = SystemClipboardText(clipboard_text[:])
    if text.count == 0 { return }
    target_row: s32 = SelectionFirstRow()
    target_column: s32 = SelectionFirstColumn()
    relocate: bool = copied_sheet >= 0 && text == TextView(copied_text[0:copied_length])
    row: s32 = 0
    column: s32 = 0
    cell: [256]u8
    length: s32 = 0
    at: s32 = 0
    while at <= cast(s32)text.count {
        byte: u8 = 10
        if at < cast(s32)text.count { byte = text[at] }
        if byte == 9 || byte == 10 {
            cell[length] = 0
            if !(byte == 10 && length == 0 && at == cast(s32)text.count) {
                if relocate {
                    moved: *s8 = Engine.FormulaRelocate(workbook, cast(*s8)*cell[0],
                        target_row - copied_row, target_column - copied_column)
                    Engine.WorkbookSetCell(workbook, sheet_index, target_row + row,
                        target_column + column, moved)
                    FreeBytes(cast(*void)moved)
                } else {
                    Engine.WorkbookSetCell(workbook, sheet_index, target_row + row,
                        target_column + column, cast(*s8)*cell[0])
                }
            }
            length = 0
            if byte == 9 { column += 1 } else {
                row += 1
                column = 0
            }
        } else if byte != 13 && length < CellTextMax - 1 {
            cell[length] = byte
            length += 1
        }
        at += 1
    }
    Changed("Pasted")
}

ClearCell :: () {
    if selection_axis != 0 || range_row != selected_row || range_column != selected_column {
        first_row := SelectionFirstRow()
        last_row := SelectionLastRow()
        first_column := SelectionFirstColumn()
        last_column := SelectionLastColumn()
        for row: first_row..last_row { for column: first_column..last_column { Engine.WorkbookSetCell(workbook, sheet_index, row, column, cast(*s8)Engine.CText("")) } }
        Changed("Selection cleared"); return
    }
    edit[0] = 0
    CommitCell()
    SelectCell(selected_row, selected_column)
}

HandleGridKeys :: (key: s32, control: bool, typed: []u8, typed_length: s32) {
    if control && key == KeyC { CopyCell() }
    if control && key == KeyX { CutCell() }
    if control && key == KeyV { PasteCells() }
    if key == KeyUp { SelectCell(selected_row - 1, selected_column) }
    if key == KeyDown { SelectCell(selected_row + 1, selected_column) }
    if key == KeyLeft { SelectCell(selected_row, selected_column - 1) }
    if key == KeyRight || key == KeyTab {
        SelectCell(selected_row, selected_column + 1)
    }
    if key == KeyEnter { selection_axis = 0; edit_focused = true }
    if key == KeyDelete || key == KeyBackspace { ClearCell() }
    if typed_length > 0 {
        // Typing over a selected cell starts a new value, as in Gnumeric.
        selection_axis = 0
        range_row = selected_row
        range_column = selected_column
        edit[0] = 0
        edit_cursor = 0
        edit_anchor = 0
        edit_focused = true
        ApplyEdit(0, 0, TextView(typed[0:typed_length]))
    }
    EnsureVisible()
}

// Replaces edit bytes [start, end) with replacement, keeping the terminator.
ApplyEdit :: (start: s32, end: s32, replacement: string) {
    length: s32 = cast(s32)TextUntilNul(edit[:]).count
    if start < 0 || end < start || end > length { return }
    inserted: s32 = cast(s32)replacement.count
    if length - (end - start) + inserted >= CellTextMax { return }
    tail: [256]u8
    tail_length: s32 = length - end
    index: s32 = 0
    while index < tail_length {
        tail[index] = edit[end + index]
        index += 1
    }
    index = 0
    while index < inserted {
        edit[start + index] = replacement[index]
        index += 1
    }
    index = 0
    while index < tail_length {
        edit[start + inserted + index] = tail[index]
        index += 1
    }
    edit[start + inserted + tail_length] = 0
    edit_cursor = start + inserted
    edit_anchor = edit_cursor
    CommitCell()
}

// Collects this frame's typed codepoints as UTF-8.
TakeTypedText :: (session: Session, output: []u8) -> s32 {
    length: s32 = 0
    codepoint: s32 = TypedCodepointTake(session)
    while codepoint != 0 {
        if length + 4 < cast(s32)output.count {
            length = AppendUtf8(output, length, codepoint)
        }
        codepoint = TypedCodepointTake(session)
    }
    return length
}

AppendUtf8 :: (output: []u8, at: s32, codepoint: s32) -> s32 {
    if codepoint < 0x80 {
        output[at] = cast(u8)codepoint
        return at + 1
    }
    if codepoint < 0x800 {
        output[at] = cast(u8)(0xC0 | (codepoint >> 6))
        output[at + 1] = cast(u8)(0x80 | (codepoint & 0x3F))
        return at + 2
    }
    if codepoint < 0x10000 {
        output[at] = cast(u8)(0xE0 | (codepoint >> 12))
        output[at + 1] = cast(u8)(0x80 | ((codepoint >> 6) & 0x3F))
        output[at + 2] = cast(u8)(0x80 | (codepoint & 0x3F))
        return at + 3
    }
    output[at] = cast(u8)(0xF0 | (codepoint >> 18))
    output[at + 1] = cast(u8)(0x80 | ((codepoint >> 12) & 0x3F))
    output[at + 2] = cast(u8)(0x80 | ((codepoint >> 6) & 0x3F))
    output[at + 3] = cast(u8)(0x80 | (codepoint & 0x3F))
    return at + 4
}

// --------------------------------------------------------------------- view

// The window's own color: the theme's canvas behind every widget.
DrawBackground :: (session: Session, viewport: Rectangle) {
    background: BoxProps
    background.key = cast(u64)7
    background.bounds = viewport
    background.fill = StyleTokenColor("canvas")
    Box(session, background)
}

DrawToolbar :: (session: Session, viewport: Rectangle) {
    x: float32 = Margin
    if ToolbarIcon(session, 1001, SaveIcon.Shape, *x, dirty) { SaveWorkbook(true) }
    if ToolbarIcon(session, 1002, RowAddIcon.Shape, *x, false) {
        Engine.WorkbookInsertRow(workbook, sheet_index, selected_row)
        Changed("Row inserted")
    }
    if ToolbarIcon(session, 1003, RowRemoveIcon.Shape, *x, false) {
        Engine.WorkbookDeleteRow(workbook, sheet_index, selected_row)
        Changed("Row deleted")
    }
    if ToolbarIcon(session, 1004, ColumnAddIcon.Shape, *x, false) {
        Engine.WorkbookInsertColumn(workbook, sheet_index, selected_column)
        Changed("Column inserted")
    }
    if ToolbarIcon(session, 1005, ColumnRemoveIcon.Shape, *x, false) {
        Engine.WorkbookDeleteColumn(workbook, sheet_index, selected_column)
        Changed("Column deleted")
    }
}

DrawStatus :: (session: Session, viewport: Rectangle) {
    label: TextProps
    label.key = cast(u64)5
    label.text = TextUntilNul(status[:])
    label.font = Text14
    label.disabled = !dirty
    label.bounds = Rectangle.{Margin, viewport.height - 36.0,
        viewport.width - Margin * 2.0, 20.0}
    Text(session, label)
}


ToolbarIcon :: (session: Session, id: s32, shape: string, x: *float32,
    primary: bool) -> bool {
    button: ButtonProps
    button.id = id
    button.icon_shape = shape
    button.icon_only = true
    button.size = cast(ControlSize)ControlSizeSmall
    button.emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled
    if primary {
        button.tone = cast(ButtonTone)ButtonToneAccent
    }
    button.bounds = Rectangle.{x.*, 14.0, 36.0, 32.0}
    x.* = x.* + 36.0 + 8.0
    return Button(session, button) != 0
}

Changed :: (message: string) {
    Engine.WorkbookEvaluate(workbook)
    dirty = true
    save_retry_at = 0
    SetText(status[:], message)
    // A changed range stays selected, as after a paste, fill or clear.
    keep_row: s32 = range_row
    keep_column: s32 = range_column
    SelectCell(selected_row, selected_column)
    range_row = Min(keep_row, MaxRows - 1)
    range_column = Min(keep_column, MaxColumns - 1)
}

SheetTabsBounds :: (viewport: Rectangle) -> Rectangle {
    count: s32 = Min(Engine.WorkbookSheetCount(workbook), 16)
    return Rectangle.{Margin, viewport.height - TabsBottom, 104.0 * cast(float32)count, 32.0}
}

DrawSheetTabs :: (session: Session, viewport: Rectangle) {
    count: s32 = Engine.WorkbookSheetCount(workbook)
    if count < 1 { return }
    // Sixteen tabs fill the bar; a workbook can hold more sheets than that.
    if count > 16 { count = 16 }
    tabs: [16]Tab
    index: s32 = 0
    while index < count {
        tabs[index].key = cast(u64)(1100 + index)
        tabs[index].label = TextFromCString(cast(*u8)Engine.WorkbookSheetName(workbook, index))
        index += 1
    }
    bar: TabBarProps
    bar.key = cast(u64)1099
    bar.placement = cast(TabBarPlacement)TabBarTop
    bar.selected_index = sheet_index
    bar.bounds = SheetTabsBounds(viewport)
    bar.min_tab_width = 72
    bar.max_tab_width = 104
    result: TabBarResult = TabBar(session, bar, tabs[0:count])
    if result.selected_index != sheet_index && result.selected_index >= 0 {
        sheet_index = result.selected_index
        scroll_row = 0
        scroll_column = 0
        // A formula being written stays open, so it can point at this sheet.
        if !FormulaEditing() && !edit_refocus { SelectCell(0, 0) }
    }
}

DrawFormulaBar :: (session: Session, viewport: Rectangle, key: s32,
    control: bool, typed: []u8, typed_length: s32) {
    label: TextProps
    label.key = cast(u64)3
    label.text = "fx"
    label.font = Text16
    label.disabled = true
    label.bounds = Rectangle.{Margin, 60.0, 24.0, 20.0}
    Text(session, label)
    result: TextFieldResult = RunFormulaField(session, viewport, key, control,
        typed, typed_length)
    // Typing or moving the cursor ends a pick: the next one inserts anew.
    if result.edit.changed || result.cursor != edit_cursor || result.anchor != edit_anchor {
        pick_start = -1
    }
    edit_cursor = result.cursor
    edit_anchor = result.anchor
    edit_scroll = result.scroll_x
    edit_composition = result.composition
    edit_focused = result.focused
    if result.edit.changed {
        ApplyEdit(result.edit.start, result.edit.end, result.edit.replacement)
        edit_cursor = result.cursor
        edit_anchor = result.anchor
    }
    if result.committed {
        CommitCell()
        EndEdit()
        SelectCell(selected_row + 1, selected_column)
        EnsureVisible()
    }
    if result.escaped {
        SetText(edit[:], TextUntilNul(edit_original[:]))
        CommitCell()
        EndEdit()
        SelectCell(selected_row, selected_column)
    }
}

// --------------------------------------------------------- formula picking

FormulaEditing :: () -> bool { return edit_focused && edit[0] == #char "=" }

// Whether a grid click now points the formula at cells: right after the last
// pick, or where an operand belongs (after =, an operator, "(" or a separator),
// outside a string, and not glued to a name.
CanPick :: () -> bool {
    if !FormulaEditing() { return false }
    start: s32 = Min(edit_cursor, edit_anchor)
    end: s32 = Max(edit_cursor, edit_anchor)
    if pick_start >= 0 && start == pick_end && end == pick_end { return true }
    text: string = TextUntilNul(edit[:])
    if start < 1 || end > cast(s32)text.count { return false }
    quotes: s32 = 0
    for at: 0..start - 1 { if text[at] == #char "\"" { quotes += 1 } }
    if quotes % 2 != 0 { return false }
    before: s32 = start - 1
    while before > 0 && text[before] == #char " " { before -= 1 }
    operand: bool = false
    for mark: "=(,;+-*/^&<>:" { if text[before] == mark { operand = true } }
    if !operand { return false }
    if end < cast(s32)text.count {
        next: u8 = text[end]
        if (next >= #char "A" && next <= #char "Z") || (next >= #char "a" && next <= #char "z") ||
           (next >= #char "0" && next <= #char "9") || next == #char "$" || next == #char "_" ||
           next == #char "." || next == #char "'" { return false }
    }
    return true
}

// Starts pointing the formula at a cell: it replaces the last pick, or inserts
// at the cursor. Shift extends the last pick from its first cell instead.
StartPick :: (row: s32, column: s32) {
    replace: bool = pick_start >= 0 && edit_cursor == pick_end && edit_anchor == pick_end
    start: s32 = Min(edit_cursor, edit_anchor)
    end: s32 = Max(edit_cursor, edit_anchor)
    if replace {
        start = pick_start
        end = pick_end
    }
    if !(replace && shift_held && pick_sheet == sheet_index) {
        pick_anchor_row = row
        pick_anchor_column = column
    }
    pick_sheet = sheet_index
    pick_row = row
    pick_column = column
    WritePick(start, end)
}

// Writes the picked cell or range over edit bytes [start, end): "B3", or
// "B3:C7" from its top-left to bottom-right, with its sheet when that differs
// from the edited cell's.
WritePick :: (start: s32, end: s32) {
    reference: [320]u8
    reference[0] = 0
    if pick_sheet != edit_sheet {
        prefix: [260]s8
        Engine.FormulaSheetPrefix(Engine.WorkbookSheetName(workbook, pick_sheet), *prefix[0])
        AppendText(reference[:], TextFromCString(cast(*u8)*prefix[0]))
    }
    first_row: s32 = Min(pick_anchor_row, pick_row)
    first_column: s32 = Min(pick_anchor_column, pick_column)
    last_row: s32 = Max(pick_anchor_row, pick_row)
    last_column: s32 = Max(pick_anchor_column, pick_column)
    AppendCellName(reference[:], first_row, first_column)
    if last_row != first_row || last_column != first_column {
        AppendText(reference[:], ":")
        AppendCellName(reference[:], last_row, last_column)
    }
    text: string = TextUntilNul(reference[:])
    length: s32 = cast(s32)TextUntilNul(edit[:]).count
    if length - (end - start) + cast(s32)text.count >= CellTextMax { return }
    ApplyEdit(start, end, text)
    pick_start = start
    pick_end = start + cast(s32)text.count
}

// The field's props view the edit buffer and composition state, so they
// live only for the widget call; the caller then updates that storage.
RunFormulaField :: (session: Session, viewport: Rectangle, key: s32,
    control: bool, typed: []u8, typed_length: s32) -> TextFieldResult {
    field: TextFieldProps
    field.key = cast(u64)4
    field.bounds = Rectangle.{52.0, 52.0, viewport.width - 52.0 - Margin, 34.0}
    field.value = TextUntilNul(edit[:])
    field.label = "Cell value"
    field.placeholder = "Value or =formula"
    field.cursor = edit_cursor
    field.anchor = edit_anchor
    field.scroll_x = edit_scroll
    field.focused = edit_focused
    field.composition = edit_composition
    field.max_bytes = CellTextMax - 1
    // The app decides when the cell is being edited.
    field.input.focus = edit_refocus
    field.input.blur = !edit_focused && !edit_refocus
    if edit_focused {
        field.input.text = TextView(typed[0:typed_length])
        field.input.left = key == KeyLeft
        field.input.right = key == KeyRight
        field.input.home = key == KeyHome
        field.input.end = key == KeyEnd
        field.input.backspace = key == KeyBackspace
        field.input.delete_forward = key == KeyDelete
        field.input.select_all = control && key == KeyA
        field.input.copy = control && key == KeyC
        field.input.cut = control && key == KeyX
        field.input.paste = control && key == KeyV
        field.input.commit = key == KeyEnter
        field.input.escape = key == KeyEscape
    }
    return TextField(session, field)
}

GridRows :: () -> s32 {
    count: s32 = Engine.WorkbookSheetRows(workbook, sheet_index)
    if count < 8 { count = 8 }
    if count < selected_row + 1 { count = selected_row + 1 }
    if count < range_row + 1 { count = range_row + 1 }
    if drag_mode != DragNone && count < scroll_row + visible_rows { count = scroll_row + visible_rows }
    if count > MaxRows { count = MaxRows }
    return count
}

GridColumns :: () -> s32 {
    count: s32 = Engine.WorkbookSheetColumns(workbook, sheet_index)
    if count < 8 { count = 8 }
    if count < selected_column + 1 { count = selected_column + 1 }
    if count < range_column + 1 { count = range_column + 1 }
    if drag_mode != DragNone && count < scroll_column + visible_columns { count = scroll_column + visible_columns }
    if count > MaxColumns { count = MaxColumns }
    return count
}

visible_rows: s32 = 16;
visible_columns: s32 = 8;

// Frames since the last click, and the cell it landed on. The host paces
// frames at roughly 60 per second, so 24 frames is a little under half a second.
DoubleClickFrames :: 24;
frames_since_click: s32 = 1000;
last_click_row: s32 = -1;
last_click_column: s32 = -1;

EnsureVisible :: () {
    if selected_row < scroll_row { scroll_row = selected_row }
    if selected_row >= scroll_row + visible_rows {
        scroll_row = selected_row - visible_rows + 1
    }
    if selected_column < scroll_column { scroll_column = selected_column }
    if selected_column >= scroll_column + visible_columns {
        scroll_column = selected_column - visible_columns + 1
    }
}

DrawGrid :: (session: Session, viewport: Rectangle) {
    table: Rectangle = Rectangle.{Margin, TableTop,
        viewport.width - Margin * 2.0, viewport.height - TableTop - GridBottom}
    visible_rows = cast(s32)((table.height - HeaderHeight) / RowHeight)
    visible_columns = cast(s32)((table.width - RowHeaderWidth) / ColumnWidth)
    rows: s32 = GridRows()
    columns: s32 = GridColumns()

    wheel: float32 = PointerWheelTake(session, table)
    if wheel > 0.0 { scroll_row -= 1 }
    if wheel < 0.0 { scroll_row += 1 }
    if scroll_row > rows - visible_rows { scroll_row = rows - visible_rows }
    if scroll_row < 0 { scroll_row = 0 }

    // The selection belongs to the edited cell's sheet; another sheet shown
    // to pick references from has none.
    here: bool = sheet_index == edit_sheet
    first_row: s32 = SelectionFirstRow()
    last_row: s32 = SelectionLastRow()
    first_column: s32 = SelectionFirstColumn()
    last_column: s32 = SelectionLastColumn()
    spans: bool = selection_axis == 0 && (first_row != last_row || first_column != last_column)

    GridSquare(session, 10, Rectangle.{table.x, table.y, RowHeaderWidth, HeaderHeight},
        HeaderBackground(), "")
    column: s32 = scroll_column
    while column < scroll_column + visible_columns && column < columns {
        name: [8]u8
        AppendCellColumn(name[:], column)
        GridSquare(session, 20 + column, Rectangle.{ColumnX(table, column), table.y,
                ColumnWidth, HeaderHeight}, ifx here && selection_axis == 2 && column == selected_column then SelectedBackground() else HeaderBackground(), TextUntilNul(name[:]))
        column += 1
    }
    shown: s32 = 0
    while shown < visible_rows && scroll_row + shown < rows {
        row: s32 = scroll_row + shown
        y: float32 = RowY(table, row)
        number: [16]u8
        FormatBytes(*number[0], 16, cast(*u8)Engine.CText("%d"), row + 1)
        GridSquare(session, 100 + row, Rectangle.{table.x, y, RowHeaderWidth, RowHeight},
            ifx here && selection_axis == 1 && row == selected_row then SelectedBackground() else HeaderBackground(), TextUntilNul(number[:]))
        column = scroll_column
        while column < scroll_column + visible_columns && column < columns {
            display: [256]u8
            Engine.WorkbookCellDisplay(workbook, sheet_index, row, column,
                cast(*s8)*display[0], 256)
            Engine.RoundForDisplay(cast(*s8)*display[0], 256)
            fill: Color = CellBackground()
            // A range is shaded around its active cell, as in Gnumeric.
            active: bool = row == selected_row && column == selected_column
            // A header selection shades its whole row or column on screen.
            in_rows: bool = selection_axis == 2 || (row >= first_row && row <= last_row)
            in_columns: bool = selection_axis == 1 || (column >= first_column && column <= last_column)
            if here && in_rows && in_columns && !(spans && active) { fill = SelectedBackground() }
            GridSquare(session, 1000 + row * 64 + column,
                Rectangle.{ColumnX(table, column), y, ColumnWidth, RowHeight},
                fill, TextUntilNul(display[:]))
            column += 1
        }
        shown += 1
    }

    if here && selection_axis == 0 && !edit_focused {
        CellOutline(session, 400000, table, first_row, first_column, last_row, last_column, AccentColor(), 2)
        handle: Rectangle = FillHandleBounds(table)
        if handle.width > 0.0 {
            mark: BoxProps
            mark.key = cast(u64)400008
            mark.bounds = Rectangle.{handle.x + 2.0, handle.y + 2.0, 7.0, 7.0}
            mark.fill = AccentColor()
            mark.border = CellBackground()
            Box(session, mark)
        }
    }
    if drag_mode == DragFill && fill_axis != 0 {
        top: s32 = ifx fill_axis == 1 then Min(first_row, fill_row) else first_row
        bottom: s32 = ifx fill_axis == 1 then Max(last_row, fill_row) else last_row
        left: s32 = ifx fill_axis == 2 then Min(first_column, fill_column) else first_column
        right: s32 = ifx fill_axis == 2 then Max(last_column, fill_column) else last_column
        CellOutline(session, 400010, table, top, left, bottom, right, AccentColor(), 1)
    }
    DrawReferenceOutlines(session, table)
    DrawCellEditor(session, table)

    pointer: PointerFrame = PointerSample(session)
    body: Rectangle = Rectangle.{table.x + RowHeaderWidth, table.y + HeaderHeight,
        table.width - RowHeaderWidth, table.height - HeaderHeight}
    hit_row: s32 = scroll_row + cast(s32)((pointer.y - body.y) / RowHeight)
    hit_column: s32 = scroll_column + cast(s32)((pointer.x - body.x) / ColumnWidth)
    on_cell: bool = PointInBounds(pointer.x, pointer.y, body) && hit_row < rows &&
        hit_row < scroll_row + visible_rows && hit_column < columns && hit_column < scroll_column + visible_columns
    if pointer.pressed && !grid_menu_open {
        handle: Rectangle = FillHandleBounds(table)
        if handle.width > 0.0 && PointInBounds(pointer.x, pointer.y, handle) {
            drag_mode = DragFill
            fill_axis = 0
        } else if on_cell && CanPick() {
            // Writing a formula: the click points it at the cell, a drag at a range.
            StartPick(hit_row, hit_column)
            drag_mode = DragPick
        } else if on_cell && shift_held && !edit_focused && here {
            selection_axis = 0
            range_row = hit_row
            range_column = hit_column
            drag_mode = DragRange
        } else if on_cell {
            second: bool = frames_since_click < DoubleClickFrames &&
            hit_row == last_click_row && hit_column == last_click_column
            edit_focused = false
            SelectCell(hit_row, hit_column)
            edit_focused = second
            frames_since_click = 0
            last_click_row = hit_row
            last_click_column = hit_column
            drag_mode = DragRange
        } else if PointInBounds(pointer.x, pointer.y, table) && pointer.y < body.y && pointer.x >= body.x {
            if hit_column < columns && hit_column < scroll_column + visible_columns {
                edit_focused = false
                SelectCell(selected_row, hit_column); selection_axis = 2; frames_since_click = 1000
            }
        } else if PointInBounds(pointer.x, pointer.y, table) && pointer.x < body.x && pointer.y >= body.y {
            if hit_row < rows && hit_row < scroll_row + visible_rows {
                edit_focused = false
                SelectCell(hit_row, selected_column); selection_axis = 1; frames_since_click = 1000
            }
        }
    }
    if pointer.down && drag_mode != DragNone {
        // Dragging past the grid's edge scrolls it, a step every few frames.
        drag_frames += 1
        if drag_frames % 4 == 0 {
            if pointer.y >= body.y + body.height && scroll_row + visible_rows < MaxRows { scroll_row += 1 }
            if pointer.y < body.y && scroll_row > 0 { scroll_row -= 1 }
            if pointer.x >= body.x + body.width && scroll_column + visible_columns < MaxColumns { scroll_column += 1 }
            if pointer.x < body.x && scroll_column > 0 { scroll_column -= 1 }
        }
        row: s32 = scroll_row
        if pointer.y > body.y { row = scroll_row + cast(s32)((pointer.y - body.y) / RowHeight) }
        row = Min(row, Min(scroll_row + visible_rows - 1, MaxRows - 1))
        column = scroll_column
        if pointer.x > body.x { column = scroll_column + cast(s32)((pointer.x - body.x) / ColumnWidth) }
        column = Min(column, Min(scroll_column + visible_columns - 1, MaxColumns - 1))
        if drag_mode == DragRange && !edit_focused && here {
            selection_axis = 0
            range_row = row
            range_column = column
        }
        if drag_mode == DragPick && pick_start >= 0 && (row != pick_row || column != pick_column) {
            pick_row = row
            pick_column = column
            WritePick(pick_start, pick_end)
        }
        if drag_mode == DragFill { AimFill(row, column) }
    }
    if pointer.released && drag_mode != DragNone {
        if drag_mode == DragFill { ApplyFill() }
        drag_mode = DragNone
        drag_frames = 0
    } else if !pointer.down {
        drag_mode = DragNone
        drag_frames = 0
    }
    secondary: SecondaryPointerFrame = SecondaryPointerSample(session)
    if secondary.released && !grid_menu_open && PointInBounds(pointer.x, pointer.y, table) && pointer.x < body.x && pointer.y >= body.y {
        row := scroll_row + cast(s32)((pointer.y - body.y) / RowHeight)
        if row < rows && row < scroll_row + visible_rows {
            edit_focused = false
            SelectCell(row, selected_column); selection_axis = 1; frames_since_click = 1000
            grid_menu_row = true; grid_menu_open = true; grid_menu_x = pointer.x; grid_menu_y = pointer.y
        }
    }
    if secondary.released && !grid_menu_open && PointInBounds(pointer.x, pointer.y, body) {
        // The secondary button opens the menu; outside the selection it first
        // selects the cell under it.
        row: s32 = scroll_row + cast(s32)((pointer.y - body.y) / RowHeight)
        clicked: s32 = scroll_column + cast(s32)((pointer.x - body.x) / ColumnWidth)
        if row < rows && clicked < columns && clicked < scroll_column + visible_columns {
            inside: bool = here && selection_axis == 0 && row >= first_row && row <= last_row &&
                clicked >= first_column && clicked <= last_column
            edit_focused = false
            if !inside { SelectCell(row, clicked) }
            grid_menu_open = true
            grid_menu_row = false
            grid_menu_x = pointer.x
            grid_menu_y = pointer.y
        }
    }
    if frames_since_click < 1000 { frames_since_click += 1 }
}

// The fill handle: the small square on the selection's bottom-right corner.
FillHandleBounds :: (table: Rectangle) -> Rectangle {
    none: Rectangle = Rectangle.{0.0, 0.0, 0.0, 0.0}
    if selection_axis != 0 || edit_focused || sheet_index != edit_sheet { return none }
    row: s32 = SelectionLastRow()
    column: s32 = SelectionLastColumn()
    if row < scroll_row || row >= scroll_row + visible_rows ||
       column < scroll_column || column >= scroll_column + visible_columns { return none }
    x: float32 = ColumnX(table, column) + ColumnWidth
    y: float32 = RowY(table, row) + RowHeight
    return Rectangle.{x - 6.0, y - 6.0, 11.0, 11.0}
}

// Dragging the fill handle grows the selection along the axis the pointer
// moved furthest past it.
AimFill :: (row: s32, column: s32) {
    down: s32 = row - SelectionLastRow()
    up: s32 = SelectionFirstRow() - row
    right: s32 = column - SelectionLastColumn()
    left: s32 = SelectionFirstColumn() - column
    vertical: s32 = Max(down, up)
    horizontal: s32 = Max(right, left)
    fill_axis = 0
    if vertical <= 0 && horizontal <= 0 { return }
    if vertical >= horizontal {
        fill_axis = 1
        fill_row = row
    } else {
        fill_axis = 2
        fill_column = column
    }
}

// Fills the dragged-over cells with the selection repeated: each copy's
// formulas move their relative references with it, as in Gnumeric.
ApplyFill :: () {
    if fill_axis == 0 { return }
    first_row: s32 = SelectionFirstRow()
    last_row: s32 = SelectionLastRow()
    first_column: s32 = SelectionFirstColumn()
    last_column: s32 = SelectionLastColumn()
    top: s32 = ifx fill_axis == 1 then Min(first_row, fill_row) else first_row
    bottom: s32 = ifx fill_axis == 1 then Max(last_row, fill_row) else last_row
    left: s32 = ifx fill_axis == 2 then Min(first_column, fill_column) else first_column
    right: s32 = ifx fill_axis == 2 then Max(last_column, fill_column) else last_column
    height: s32 = last_row - first_row + 1
    width: s32 = last_column - first_column + 1
    for row: top..bottom {
        for column: left..right {
            if row >= first_row && row <= last_row && column >= first_column && column <= last_column { continue }
            Engine.WorkbookCopyCell(workbook, sheet_index,
                first_row + Wrap(row - first_row, height), first_column + Wrap(column - first_column, width), row, column)
        }
    }
    fill_axis = 0
    selected_row = top
    selected_column = left
    range_row = bottom
    range_column = right
    Changed("Filled")
}

// a modulo n, never negative.
Wrap :: (a: s32, n: s32) -> s32 {
    r: s32 = a % n
    return ifx r < 0 then r + n else r
}

// While a formula is written, each reference it names on the shown sheet is
// outlined in its own color, as Gnumeric does.
DrawReferenceOutlines :: (session: Session, table: Rectangle) {
    if !FormulaEditing() { return }
    ref: Engine.FormulaRef
    at: s32 = 0
    index: s32 = 0
    while index < 32 && Engine.FormulaFindRef(workbook, cast(*s8)*edit[0], at, *ref) != 0 {
        sheet: s32 = ifx ref.sheet == -1 then edit_sheet else ref.sheet
        if sheet == sheet_index {
            CellOutline(session, 400100 + index * 4, table, Min(ref.row1, ref.row2), Min(ref.col1, ref.col2),
                Max(ref.row1, ref.row2), Max(ref.col1, ref.col2), ReferenceColor(index), 2)
        }
        at = ref.end
        index += 1
    }
}

// The edited cell shows the text being written, formula and all, over its
// neighbors when it is wider than the cell, with the cursor in it.
DrawCellEditor :: (session: Session, table: Rectangle) {
    if !edit_focused || sheet_index != edit_sheet { return }
    if selected_row < scroll_row || selected_row >= scroll_row + visible_rows ||
       selected_column < scroll_column || selected_column >= scroll_column + visible_columns { return }
    text: string = TextUntilNul(edit[:])
    x: float32 = ColumnX(table, selected_column)
    y: float32 = RowY(table, selected_row)
    width: float32 = cast(float32)(GlyphWidth(text, Text14, "") + 16)
    if width < ColumnWidth { width = ColumnWidth }
    limit: float32 = ColumnX(table, scroll_column + visible_columns) - x
    if width > limit { width = limit }
    box: BoxProps
    box.key = cast(u64)400500
    box.bounds = Rectangle.{x, y, width, RowHeight}
    box.fill = CellBackground()
    box.border = AccentColor()
    Box(session, box)
    label: TextProps
    label.key = cast(u64)400501
    label.text = text
    label.font = Text14
    label.wrap = cast(TextWrap)TextWrapNone
    label.bounds = Rectangle.{x + 6.0, y + 6.0, width - 12.0, RowHeight - 8.0}
    Text(session, label)
    cursor: s32 = Min(edit_cursor, cast(s32)text.count)
    caret_x: float32 = x + 6.0 + cast(float32)GlyphWidth(text[0:cursor], Text14, "")
    if caret_x < x + width - 2.0 {
        caret: BoxProps
        caret.key = cast(u64)400502
        caret.bounds = Rectangle.{caret_x, y + 5.0, 1.0, RowHeight - 10.0}
        caret.fill = AccentColor()
        caret.border = AccentColor()
        Box(session, caret)
    }
}

// An outline around cells [first_row..last_row] x [first_column..last_column],
// clipped to the visible grid and `thickness` pixels wide.
CellOutline :: (session: Session, key: s32, table: Rectangle, first_row: s32, first_column: s32,
    last_row: s32, last_column: s32, color: Color, thickness: s32) {
    top: s32 = Max(first_row, scroll_row)
    bottom: s32 = Min(last_row, scroll_row + visible_rows - 1)
    left: s32 = Max(first_column, scroll_column)
    right: s32 = Min(last_column, scroll_column + visible_columns - 1)
    if top > bottom || left > right { return }
    x: float32 = ColumnX(table, left)
    y: float32 = RowY(table, top)
    width: float32 = cast(float32)(right - left + 1) * ColumnWidth
    height: float32 = cast(float32)(bottom - top + 1) * RowHeight
    for line: 0..thickness - 1 {
        inset: float32 = cast(float32)line
        outline: BoxProps
        outline.key = cast(u64)(key + line)
        outline.bounds = Rectangle.{x + inset, y + inset, width - inset * 2.0, height - inset * 2.0}
        outline.fill = Color.{0, 0, 0, 0}
        outline.border = color
        Box(session, outline)
    }
}

// Reference outlines take these colors in turn.
ReferenceColor :: (index: s32) -> Color {
    which: s32 = index % 6
    if which == 0 { return Color.{47, 111, 224, 255} }
    if which == 1 { return Color.{224, 60, 49, 255} }
    if which == 2 { return Color.{46, 160, 79, 255} }
    if which == 3 { return Color.{142, 68, 173, 255} }
    if which == 4 { return Color.{230, 126, 34, 255} }
    return Color.{22, 160, 133, 255}
}

// A row number has a short row menu; cells keep the existing editing commands.
// Every command acts on the row or cell selected by the right-click.
DrawGridMenu :: (session: Session, escape: bool) {
    if !grid_menu_open { return }
    items: [10]ContextMenuItem
    items[0].id = 1
    items[0].label = "Cut"
    items[1].id = 2
    items[1].label = "Copy"
    items[2].id = 3
    items[2].label = "Paste"
    items[2].disabled = !SystemClipboardHasText()
    items[3].id = 4
    items[3].label = "Clear"
    items[4].separator = true
    items[5].id = 6
    items[5].label = "Insert above"
    items[6].id = 10
    items[6].label = "Insert below"
    items[7].id = 7
    items[7].label = "Delete row"
    items[8].id = 8
    items[8].label = "Insert column"
    items[9].id = 9
    items[9].label = "Delete column"
    count: s32 = 10
    if grid_menu_row {
        items[0].id = 6; items[0].label = "Insert above"
        items[1].id = 10; items[1].label = "Insert below"
        items[2].id = 7; items[2].label = "Delete row"; items[2].disabled = false
        count = 3
    }
    props: ContextMenuProps
    props.key = cast(u64)1200
    props.open = true
    props.x = grid_menu_x
    props.y = grid_menu_y
    props.escape = escape
    result: ContextMenuResult = ContextMenu(session, props, items[0:count])
    if !result.open { grid_menu_open = false }
    if result.activated_id == 1 { CutCell() }
    if result.activated_id == 2 { CopyCell() }
    if result.activated_id == 3 { PasteCells() }
    if result.activated_id == 4 { ClearCell() }
    if result.activated_id == 6 {
        Engine.WorkbookInsertRow(workbook, sheet_index, selected_row)
        Changed("Row inserted")
    }
    if result.activated_id == 10 {
        Engine.WorkbookInsertRow(workbook, sheet_index, selected_row + 1)
        selected_row += 1
        Changed("Row inserted")
    }
    if result.activated_id == 7 {
        Engine.WorkbookDeleteRow(workbook, sheet_index, selected_row)
        Changed("Row deleted")
    }
    if result.activated_id == 8 {
        Engine.WorkbookInsertColumn(workbook, sheet_index, selected_column)
        Changed("Column inserted")
    }
    if result.activated_id == 9 {
        Engine.WorkbookDeleteColumn(workbook, sheet_index, selected_column)
        Changed("Column deleted")
    }
}

// The grid takes its colors from the installed style, so it follows the theme.
HeaderBackground :: () -> Color { return StyleTokenColor("surface") }
CellBackground :: () -> Color { return StyleTokenColor("card") }
SelectedBackground :: () -> Color { return StyleTokenColor("accent-soft") }
AccentColor :: () -> Color { return StyleTokenColor("accent") }
GridLineColor :: () -> Color { return StyleTokenColor("border-soft") }

ColumnX :: (table: Rectangle, column: s32) -> float32 {
    return table.x + RowHeaderWidth + cast(float32)(column - scroll_column) * ColumnWidth
}

RowY :: (table: Rectangle, row: s32) -> float32 {
    return table.y + HeaderHeight + cast(float32)(row - scroll_row) * RowHeight
}

// One grid square: a bordered box and its clipped text.
GridSquare :: (session: Session, key: s32, bounds: Rectangle, fill: Color, text: string) {
    box: BoxProps
    box.key = cast(u64)(100000 + key)
    box.bounds = bounds
    box.fill = fill
    box.border = GridLineColor()
    Box(session, box)
    if text.count == 0 { return }
    label: TextProps
    label.key = cast(u64)(200000 + key)
    label.text = text
    label.font = Text14
    label.wrap = cast(TextWrap)TextWrapNone
    label.bounds = Rectangle.{bounds.x + 6.0, bounds.y + 6.0,
        bounds.width - 12.0, bounds.height - 8.0}
    Text(session, label)
}


// ----------------------------------------------------------------- text

SetText :: (output: []u8, value: string) {
    output[0] = 0
    AppendText(output, value)
}

AppendText :: (output: []u8, value: string) {
    at: s32 = cast(s32)TextUntilNul(output).count
    index: s32 = 0
    while index < cast(s32)value.count && at + 1 < cast(s32)output.count {
        output[at] = value[index]
        at += 1
        index += 1
    }
    output[at] = 0
}

AppendCellColumn :: (output: []u8, column: s32) {
    letters: [3]u8
    if column < 26 {
        letters[0] = cast(u8)(65 + column)
        AppendText(output, TextView(letters[0:1]))
        return
    }
    letters[0] = cast(u8)(65 + column / 26 - 1)
    letters[1] = cast(u8)(65 + column % 26)
    AppendText(output, TextView(letters[0:2]))
}

AppendCellName :: (output: []u8, row: s32, column: s32) {
    AppendCellColumn(output, column)
    number: [16]u8
    FormatBytes(*number[0], 16, cast(*u8)Engine.CText("%d"), row + 1)
    AppendText(output, TextUntilNul(number[:]))
}

// Copies a JSON string's contents, decoding its escapes.
DecodeJsonString :: (text: string, span: Json.JsonSpan, output: []u8) {
    at: s32 = 0
    index: s32 = span.start
    while index < span.end && at + 4 < cast(s32)output.count {
        byte: u8 = text[index]
        if byte != #char "\\" || index + 1 >= span.end {
            output[at] = byte
            at += 1
            index += 1
            continue
        }
        escape: u8 = text[index + 1]
        index += 2
        if escape == #char "n" {
            output[at] = 10
            at += 1
        } else if escape == #char "t" {
            output[at] = 9
            at += 1
        } else if escape == #char "r" {
            output[at] = 13
            at += 1
        } else if escape == #char "b" {
            output[at] = 8
            at += 1
        } else if escape == #char "f" {
            output[at] = 12
            at += 1
        } else if escape == #char "u" && index + 4 <= span.end {
            at = AppendUtf8(output, at, HexValue(text, index))
            index += 4
        } else {
            output[at] = escape
            at += 1
        }
    }
    output[at] = 0
}

HexValue :: (text: string, at: s32) -> s32 {
    value: s32 = 0
    index: s32 = 0
    while index < 4 {
        byte: s32 = text[at + index]
        digit: s32 = 0
        if byte >= 48 && byte <= 57 { digit = byte - 48 }
        if byte >= 65 && byte <= 70 { digit = byte - 55 }
        if byte >= 97 && byte <= 102 { digit = byte - 87 }
        value = value * 16 + digit
        index += 1
    }
    return value
}

// A profile name is also a directory name: lowercase letters, digits, - and _.
ProfileName :: (name: string) -> bool {
    if name.count == 0 || name.count > 63 { return false }
    for i: 0..cast(s32)name.count - 1 {
        c: u8 = name[i]
        if !((c >= #char "a" && c <= #char "z") || (c >= #char "0" && c <= #char "9") || c == #char "-" || c == #char "_") { return false }
    }
    return true
}

// Whether the program was started under the given name. `geld` is a link to
// workbook, and it opens the geld profile because of the name it was run as.
StartedAs :: (name: string) -> bool {
    command: [4096]u8
    descriptor: s32 = OpenFile(CPath("/proc/self/cmdline"), 0)
    if descriptor < 0 { return false }
    length: s64 = ReadFileBytes(descriptor, *command[0], 4095)
    CloseFile(descriptor)
    if length <= 0 { return false }
    // The command line is NUL-separated words; the first one is how the
    // program was started.
    end: s32 = 0
    while end < cast(s32)length && command[end] != 0 { end += 1 }
    return FileName(TextView(command[0:end])) == name
}

// The part of a path after its last slash.
FileName :: (path: string) -> string {
    at: s32 = cast(s32)path.count
    while at > 0 && path[at - 1] != #char "/" {
        at -= 1
    }
    return path[at:cast(s32)path.count]
}

EndsWith :: (text: string, suffix: string) -> bool {
    if text.count < suffix.count { return false }
    start: s32 = cast(s32)(text.count - suffix.count)
    return text[start:cast(s32)text.count] == suffix
}

FileExists :: (path: string) -> bool {
    return PathAccess(CPath(path), 0) == 0
}

// A NUL-terminated copy of a path or name for libc.
CPath :: (text: string) -> *u8 {
    return cast(*u8)Engine.CText(text)
}
