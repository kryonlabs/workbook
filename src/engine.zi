#load "c_runtime.zi";
#load "quad.zi";
#load "formula_text.zi";
#load "xml.zi";
#load "gzip.zi";

WB_MAX_SHEETS :: 64;
WB_MAX_COLS :: 256;
WB_MAX_ROWS :: 65536;
WB_TEXT_MAX :: 512;
WB_ARGS_MAX :: 4096;
WB_DEPTH_MAX :: 64;

VAL_EMPTY :: 0;
VAL_FLOAT :: 1;
VAL_STRING :: 2;
VAL_BOOL :: 3;
VAL_ERROR :: 4;
VAL_RANGE :: 5;

ERR_DIV0 :: 0;
ERR_VALUE :: 1;
ERR_REF :: 2;
ERR_NAME :: 3;
ERR_NUM :: 4;
ERR_NA :: 5;
ERR_NULL :: 6;
ERR_CYCLE :: 7;
ERR_LIMIT :: 8;
ERR_LIMIT2 :: 9;

CELL_LITERAL :: 0;
CELL_FORMULA :: 1;

Cell :: struct {
    key: s32
    text: *s8
    kind: s32
    cached_kind: s32
    cached_number: float64
    cached_text: *s8
    cached_err: s32
    computed: s32
    evaluating: s32
    hint: s32
    serialized: *s8
}

Sheet :: struct {
    name: [128]s8
    cells: *Cell
    cell_count: s32
    cell_cap: s32
    max_col: s32
    max_row: s32
}

Workbook :: struct {
    sheets: *Sheet
    sheet_count: s32
    sheet_cap: s32
}

Val :: struct {
    kind: s32
    number: float64
    text: *s8
    err: s32
    from_range: s32
}

SlotRef :: struct {
    kind: s32
    row: s32
    col: s32
    row2: s32
    col2: s32
}

EvalState :: struct {
    wb: *Workbook
    sheet: *Sheet
    depth: s32
    args: *Val
    marks: *s32
    group_cols: *s32
    arg_count: s32
    args_overflow: s32
    hint: s32
    this_row: s32
    this_col: s32
    last_cols: s32
    call_group_cols: *s32
    refs: *SlotRef
    call_refs: *SlotRef
    pend_kind: s32
    pend_row: s32
    pend_col: s32
    pend_row2: s32
    pend_col2: s32
}

NumList :: struct {
    data: [4096]float64
    count: s32
    saw_error: s32
}

GS :: struct {
    havexpos: s32
    havexneg: s32
    have_root: s32
    xpos: float64
    ypos: float64
    xneg: float64
    yneg: float64
    root: float64
    xmin: float64
    xmax: float64
    precision: float64
}

DbCond :: struct {
    op: s32
    is_num: s32
    num: float64
    text: [48]s8
}

Cplx :: struct {
    re: float64
    im: float64
}

CSpline :: struct {
    n: s32
    x: [64]float64
    y: [64]float64
    a: [64]float64
    b: [64]float64
    c: [64]float64
}

RNG_NEXT: u64 = 1;
NT_PRIMES: [10000]s32;
NT_COUNT: s32;
QFACT_MANT_H: [10000]float64;
QFACT_MANT_L: [10000]float64;
QFACT_EXP: [10000]s32;
QFACT_BUILT: s32;
BD0_CH: [129]*s8;
BD0_V: [516]float64;
BD0_READY: s32;
GS_R_NPER: float64;
GS_R_PMT: float64;
GS_R_PV: float64;
GS_R_FV: float64;
GS_R_TYPE: s32;
GSV_A: [512]float64;
GSD_A: [512]float64;
GS_CASH_N: s32;
GS_Y_SETTLE: s32;
GS_Y_MAT: s32;
GS_Y_RATE: float64;
GS_Y_RED: float64;
GS_Y_PAR: float64;
GS_Y_FREQ: s32;
GS_Y_BASIS: s32;
ErrText :: (code: s32) -> *s8 {
    if code == ERR_DIV0 {
        return CText("#DIV/0!")
    }
    if code == ERR_VALUE {
        return CText("#VALUE!")
    }
    if code == ERR_REF {
        return CText("#REF!")
    }
    if code == ERR_NAME {
        return CText("#NAME?")
    }
    if code == ERR_NUM {
        return CText("#NUM!")
    }
    if code == ERR_NA {
        return CText("#N/A")
    }
    if code == ERR_NULL {
        return CText("#NULL!")
    }
    if code == ERR_LIMIT {
        return CText("#LIMIT!")
    }
    return CText("#CYCLE!")
}

ErrFromText :: (text: *s8) -> s32 {
    if TextCompareLiteral(text, "#DIV/0!") == 0 {
        return ERR_DIV0
    }
    if TextCompareLiteral(text, "#VALUE!") == 0 {
        return ERR_VALUE
    }
    if TextCompareLiteral(text, "#REF!") == 0 {
        return ERR_REF
    }
    if TextCompareLiteral(text, "#NAME?") == 0 {
        return ERR_NAME
    }
    if TextCompareLiteral(text, "#NUM!") == 0 {
        return ERR_NUM
    }
    if TextCompareLiteral(text, "#N/A") == 0 {
        return ERR_NA
    }
    if TextCompareLiteral(text, "#NULL!") == 0 {
        return ERR_NULL
    }
    if TextCompareLiteral(text, "#CYCLE!") == 0 {
        return ERR_CYCLE
    }
    if TextCompareLiteral(text, "#LIMIT!") == 0 {
        return ERR_LIMIT
    }
    return -1
}

wb_strndup :: (src: *s8, n: s32) -> *s8 {
    out: *s8 = cast(*s8)MemoryAllocate(cast(u64)(n + 1))
    if out == null {
        return null
    }
    if n > 0 {
        MemoryCopy(cast(*void)out, cast(*void)src, cast(u64)n)
    }
    out[n] = 0
    return out
}

wb_strdup :: (src: *s8) -> *s8 {
    if src == null {
        src = CText("")
    }
    return wb_strndup(src, cast(s32)TextLength(src))
}

wb_replace_text :: (slot: **s8, text: *s8) {
    MemoryFree(cast(*void)slot.*)
    slot.* = wb_strdup(text)
}

wb_free_val :: (cell: *Cell) {
    MemoryFree(cast(*void)cell.cached_text)
    cell.cached_text = null
}

FormatNumber :: (value: float64, out: *s8, cap: s32) {
    tmp: [64]s8
    sci: [64]s8
    precision: s32 = 15
    digits: s32 = 0
    exp10: s32 = 0
    i: s32 = 0
    mant_len: s32 = 0
    decimals: s32 = 0
    epos: s32 = -1
    sign: s32 = 0
    explen: s32 = 0
    mant: [32]s8
    if value != value {
        FormatText(out, cast(u64)cap, CText("#NUM!"))
        return
    }
    if value == 0 {
        FormatText(out, cast(u64)cap, CText("0"))
        return
    }
    if value == cast(float64)TruncateToS64(value) && value > -1e17 && value < 1e17 {
        FormatText(out, cast(u64)cap, CText("%lld"), TruncateToS64(value))
        return
    }
    while precision <= 17 {
        FormatText(*tmp[0], 64, CText("%.*g"), precision, value)
        if ParseDouble(*tmp[0], null) == value {
            break
        }
        precision += 1
    }
    FormatText(*sci[0], 64, CText("%.*e"), precision - 1, value)
    mant[0] = sci[0]
    mant_len = 1
    i = 1
    while sci[i] != 0 && sci[i] != 101 && sci[i] != 69 {
        if sci[i] != 46 {
            mant[mant_len] = sci[i]
            mant_len += 1
        }
        i += 1
    }
    while mant_len > 1 && mant[mant_len - 1] == 48 {
        mant_len -= 1
    }
    mant[mant_len] = 0
    if mant[0] == 45 {
        digits = mant_len - 1
    } else {
        digits = mant_len
    }
    if sci[i] == 101 || sci[i] == 69 {
        exp10 = cast(s32)ParseLong(*sci[i + 1], null, 10)
    }
    if exp10 >= -4 && exp10 <= 16 {
        decimals = digits - 1 - exp10
        if decimals < 0 {
            decimals = 0
        }
        FormatText(out, cast(u64)cap, CText("%.*f"), decimals, value)
        return
    }
    FormatText(out, cast(u64)cap, CText("%.*e"), digits - 1, value)
    epos = -1
    i = 0
    while out[i] != 0 {
        if out[i] == 101 {
            epos = i
        }
        i += 1
    }
    if epos >= 0 {
        out[epos] = 69
        sign = 0
        if out[epos + 1] == 43 || out[epos + 1] == 45 {
            sign = 1
        }
        explen = 0
        while out[epos + 1 + sign + explen] != 0 {
            explen += 1
        }
        if explen < 2 {
            shift: s32 = explen + 1
            while shift >= 1 {
                out[epos + 1 + sign + shift] = out[epos + 1 + sign + shift - 1]
                shift -= 1
            }
            out[epos + 1 + sign] = 48
        }
    }
}

TextLooksNumeric :: (text: *s8) -> s32 {
    end: *s8 = null
    if text == null || text[0] == 0 {
        return 0
    }
    ParseDouble(text, *end)
    if end == text {
        return 0
    }
    while end != null && end.* != 0 && IsSpaceByte(cast(s32)(cast(u8)end.*)) != 0 {
        end = *end[1]
    }
    return cast(s32)(end.* == 0)
}

WorkbookNew :: () -> *Workbook {
    wb: *Workbook = cast(*Workbook)MemoryAllocateZeroed(1, cast(u64)size_of(Workbook))
    if wb == null {
        return null
    }
    wb.sheet_cap = 4
    wb.sheets = cast(*Sheet)MemoryAllocateZeroed(cast(u64)wb.sheet_cap, cast(u64)size_of(Sheet))
    if wb.sheets == null {
        MemoryFree(cast(*void)wb)
        return null
    }
    return wb
}

SheetFree :: (sheet: *Sheet) {
    i: s32 = 0
    while i < sheet.cell_count {
        MemoryFree(cast(*void)sheet.cells[i].text)
        MemoryFree(cast(*void)sheet.cells[i].cached_text)
        MemoryFree(cast(*void)sheet.cells[i].serialized)
        i += 1
    }
    MemoryFree(cast(*void)sheet.cells)
}

WorkbookFree :: (wb: *Workbook) {
    i: s32 = 0
    if wb == null {
        return
    }
    while i < wb.sheet_count {
        SheetFree(*wb.sheets[i])
        i += 1
    }
    MemoryFree(cast(*void)wb.sheets)
    MemoryFree(cast(*void)wb)
}

WorkbookAddSheet :: (wb: *Workbook, name: *s8) -> *Sheet {
    if wb.sheet_count >= WB_MAX_SHEETS {
        return null
    }
    if wb.sheet_count >= wb.sheet_cap {
        new_cap: s32 = wb.sheet_cap * 2
        grown: *Sheet = cast(*Sheet)MemoryResize(cast(*void)wb.sheets, cast(u64)size_of(Sheet) * cast(u64)new_cap)
        if grown == null {
            return null
        }
        wb.sheets = grown
        wb.sheet_cap = new_cap
    }
    sheet: *Sheet = *wb.sheets[wb.sheet_count]
    MemorySet(cast(*void)sheet, 0, cast(u64)size_of(Sheet))
    FormatText(*sheet.name[0], 128, CText("%s"), name)
    wb.sheet_count += 1
    return sheet
}

WorkbookFindSheet :: (wb: *Workbook, name: *s8) -> *Sheet {
    i: s32 = 0
    while i < wb.sheet_count {
        if TextCompare(*wb.sheets[i].name[0], name) == 0 {
            return *wb.sheets[i]
        }
        i += 1
    }
    return null
}

CellKey :: (row: s32, col: s32) -> s32 {
    return row * WB_MAX_COLS + col
}

CellKeyRow :: (key: s32) -> s32 {
    return key / WB_MAX_COLS
}

CellKeyCol :: (key: s32) -> s32 {
    return key % WB_MAX_COLS
}

CellSearch :: (sheet: *Sheet, key: s32, at: *s32) -> s32 {
    lo: s32 = 0
    hi: s32 = sheet.cell_count
    while lo < hi {
        mid: s32 = (lo + hi) / 2
        if sheet.cells[mid].key < key {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    at.* = lo
    return cast(s32)(lo < sheet.cell_count && sheet.cells[lo].key == key)
}

CellAt :: (sheet: *Sheet, row: s32, col: s32) -> *Cell {
    index: s32 = 0
    if row < 0 || row >= WB_MAX_ROWS || col < 0 || col >= WB_MAX_COLS {
        return null
    }
    if CellSearch(sheet, CellKey(row, col), *index) != 0 {
        return *sheet.cells[index]
    }
    return null
}

CellObtain :: (sheet: *Sheet, row: s32, col: s32) -> *Cell {
    index: s32 = 0
    key: s32 = CellKey(row, col)
    if CellSearch(sheet, key, *index) != 0 {
        return *sheet.cells[index]
    }
    if sheet.cell_count >= sheet.cell_cap {
        new_cap: s32 = ifx sheet.cell_cap != 0 then (sheet.cell_cap * 2) else 64
        grown: *Cell = cast(*Cell)MemoryResize(cast(*void)sheet.cells, cast(u64)size_of(Cell) * cast(u64)new_cap)
        if grown == null {
            return null
        }
        sheet.cells = grown
        sheet.cell_cap = new_cap
    }
    if index < sheet.cell_count {
        MemoryMove(cast(*void)(*sheet.cells[index + 1]), cast(*void)(*sheet.cells[index]), cast(u64)size_of(Cell) * cast(u64)(sheet.cell_count - index))
    }
    sheet.cell_count += 1
    cell: *Cell = *sheet.cells[index]
    MemorySet(cast(*void)cell, 0, cast(u64)size_of(Cell))
    cell.key = key
    return cell
}

SheetDrop :: (sheet: *Sheet, row: s32, col: s32) {
    index: s32 = 0
    if CellSearch(sheet, CellKey(row, col), *index) != 0 {
        MemoryFree(cast(*void)sheet.cells[index].text)
        MemoryFree(cast(*void)sheet.cells[index].cached_text)
        MemoryFree(cast(*void)sheet.cells[index].serialized)
        MemoryMove(cast(*void)(*sheet.cells[index]), cast(*void)(*sheet.cells[index + 1]), cast(u64)size_of(Cell) * cast(u64)(sheet.cell_count - index - 1))
        sheet.cell_count -= 1
    }
    SheetExtent(sheet)
}

SheetExtent :: (sheet: *Sheet) {
    i: s32 = 0
    sheet.max_col = -1
    sheet.max_row = -1
    while i < sheet.cell_count {
        if sheet.cells[i].text != null && sheet.cells[i].text[0] != 0 {
            col: s32 = CellKeyCol(sheet.cells[i].key)
            row: s32 = CellKeyRow(sheet.cells[i].key)
            if col > sheet.max_col {
                sheet.max_col = col
            }
            if row > sheet.max_row {
                sheet.max_row = row
            }
        }
        i += 1
    }
}

ClassifyCell :: (cell: *Cell) {
    text: *s8 = cell.text
    if text != null && text[0] == 61 {
        cell.kind = CELL_FORMULA
        cell.computed = 0
        cell.cached_kind = VAL_EMPTY
        return
    }
    cell.kind = CELL_LITERAL
    if text[0] == 35 {
        code: s32 = ErrFromText(text)
        if code >= 0 {
            cell.cached_kind = VAL_ERROR
            cell.cached_err = code
            return
        }
    }
    if TextLooksNumeric(text) != 0 {
        cell.cached_kind = VAL_FLOAT
        cell.cached_number = ParseDouble(text, null)
        return
    }
    if TextCompareFoldLiteral(text, "TRUE") == 0 {
        cell.cached_kind = VAL_BOOL
        cell.cached_number = 1
        return
    }
    if TextCompareFoldLiteral(text, "FALSE") == 0 {
        cell.cached_kind = VAL_BOOL
        cell.cached_number = 0
        return
    }
    cell.cached_kind = VAL_STRING
    wb_replace_text(*cell.cached_text, text)
}

SetCellText :: (wb: *Workbook, sheet_index: s32, row: s32, col: s32, text: *s8) -> s32 {
    sheet: *Sheet = null
    cell: *Cell = null
    if wb == null || sheet_index < 0 || sheet_index >= wb.sheet_count {
        return 0
    }
    sheet = *wb.sheets[sheet_index]
    if row < 0 || row >= WB_MAX_ROWS || col < 0 || col >= WB_MAX_COLS {
        return 0
    }
    if text == null || text[0] == 0 {
        SheetDrop(sheet, row, col)
        return 1
    }
    cell = CellObtain(sheet, row, col)
    if cell == null {
        return 0
    }
    wb_replace_text(*cell.text, text)
    MemoryFree(cast(*void)cell.serialized)
    cell.serialized = null
    ClassifyCell(cell)
    if col > sheet.max_col {
        sheet.max_col = col
    }
    if row > sheet.max_row {
        sheet.max_row = row
    }
    return 1
}

ValNumber :: (value: float64) -> Val {
    v: Val = Val.{VAL_FLOAT, value, null, 0, 0}
    return v
}

ValBool :: (flag: s32) -> Val {
    v: Val = Val.{VAL_BOOL, ifx flag != 0 then 1.0 else 0.0, null, 0, 0}
    return v
}

ValString :: (text: *s8) -> Val {
    v: Val = Val.{VAL_STRING, 0.0, text, 0, 0}
    return v
}

ValError :: (code: s32) -> Val {
    v: Val = Val.{VAL_ERROR, 0.0, null, code, 0}
    return v
}

ValEmpty :: () -> Val {
    v: Val = Val.{VAL_EMPTY, 0.0, null, 0, 0}
    return v
}

ValCopy :: (src: *Val) -> Val {
    v: Val = src[0]
    if v.kind == VAL_STRING && v.text != null {
        v.text = wb_strdup(v.text)
    }
    return v
}

ValFree :: (v: *Val) {
    if v.kind == VAL_STRING {
        MemoryFree(cast(*void)v.text)
    }
    v.text = null
}

HintWrap :: (st: *EvalState, hint: s32, v: Val) -> Val {
    if v.kind == VAL_FLOAT {
        st.hint = hint
    }
    return v
}

CoerceNumber :: (v: *Val) -> float64 {
    if v.kind == VAL_FLOAT || v.kind == VAL_BOOL {
        return v.number
    }
    if v.kind == VAL_EMPTY {
        return 0
    }
    if v.kind == VAL_STRING && TextLooksNumeric(v.text) != 0 {
        return ParseDouble(v.text, null)
    }
    return 1e308
}

CoerceBool :: (v: *Val) -> s32 {
    if v.kind == VAL_BOOL {
        return cast(s32)(v.number != 0)
    }
    if v.kind == VAL_FLOAT {
        return cast(s32)(v.number != 0)
    }
    if v.kind == VAL_EMPTY {
        return 0
    }
    if v.kind == VAL_STRING && TextLooksNumeric(v.text) != 0 {
        return cast(s32)(ParseDouble(v.text, null) != 0)
    }
    return -1
}

CoerceText :: (v: *Val, out: *s8, cap: s32) {
    if v.kind == VAL_STRING {
        FormatText(out, cast(u64)cap, CText("%s"), ifx v.text != null then v.text else CText(""))
        return
    }
    if v.kind == VAL_BOOL {
        FormatText(out, cast(u64)cap, CText("%s"), ifx v.number != 0 then CText("TRUE") else CText("FALSE"))
        return
    }
    if v.kind == VAL_FLOAT {
        FormatNumber(v.number, out, cap)
        return
    }
    if v.kind == VAL_ERROR {
        FormatText(out, cast(u64)cap, CText("%s"), ErrText(v.err))
        return
    }
    out[0] = 0
}

CompareVals :: (a: *Val, b: *Val) -> s32 {
    an: float64 = 0
    bn: float64 = 0
    a_text: s32 = 0
    b_text: s32 = 0
    if a.kind == VAL_ERROR || b.kind == VAL_ERROR {
        return -2
    }
    if a.kind == VAL_RANGE || b.kind == VAL_RANGE {
        return -2
    }
    an = CoerceNumber(a)
    bn = CoerceNumber(b)
    a_text = cast(s32)(a.kind == VAL_STRING && an >= 1e307)
    b_text = cast(s32)(b.kind == VAL_STRING && bn >= 1e307)
    if a.kind == VAL_EMPTY && b.kind == VAL_EMPTY {
        return 0
    }
    if a.kind == VAL_EMPTY {
        if b_text != 0 {
            return ifx b.text[0] == 0 then 0 else (-1)
        }
        return ifx bn == 0 then 0 else (-1)
    }
    if b.kind == VAL_EMPTY {
        if a_text != 0 {
            return ifx a.text[0] == 0 then 0 else 1
        }
        return ifx an == 0 then 0 else 1
    }
    if a.kind == VAL_STRING && b.kind == VAL_STRING {
        cmp: s32 = TextCompareFold(a.text, b.text)
        return ifx cmp < 0 then (-1) else (ifx cmp > 0 then 1 else 0)
    }
    if a_text != 0 {
        return 1
    }
    if b_text != 0 {
        return -1
    }
    if an < bn {
        return -1
    }
    if an > bn {
        return 1
    }
    return 0
}

SkipFormulaSpace :: (text: *s8, pos: *s32) {
    while text[pos[0]] == 32 || text[pos[0]] == 9 || text[pos[0]] == 10 || text[pos[0]] == 13 {
        pos[0] += 1
    }
}

IdentChar :: (ch: s32) -> s32 {
    return cast(s32)((ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90) || (ch >= 48 && ch <= 57) || ch == 95 || ch == 46)
}

ParseColLetters :: (text: *s8, pos: *s32) -> s32 {
    col: s32 = 0
    start: s32 = pos[0]
    while text[pos[0]] != 0 {
        ch: s32 = cast(s32)text[pos[0]]
        if ch >= 65 && ch <= 90 {
            col = col * 26 + (ch - 65 + 1)
        } else if ch >= 97 && ch <= 122 {
            col = col * 26 + (ch - 97 + 1)
        } else {
            break
        }
        pos[0] += 1
        if col > WB_MAX_COLS {
            return -1
        }
    }
    if pos[0] == start {
        return -1
    }
    return col - 1
}

ParseRowDigits :: (text: *s8, pos: *s32) -> s32 {
    row: s32 = 0
    start: s32 = pos[0]
    while text[pos[0]] != 0 {
        ch: s32 = cast(s32)text[pos[0]]
        if ch < 48 || ch > 57 {
            break
        }
        row = row * 10 + (ch - 48)
        pos[0] += 1
        if row > WB_MAX_ROWS {
            return -1
        }
    }
    if pos[0] == start || row < 1 {
        return -1
    }
    return row - 1
}

EvalPush :: (st: *EvalState, v: Val) {
    if st.arg_count >= WB_ARGS_MAX {
        st.args_overflow = 1
        ValFree(*v)
        return
    }
    st.args[st.arg_count] = v
    st.marks[st.arg_count] = 0
    st.group_cols[st.arg_count] = 0
    st.refs[st.arg_count].kind = 0
    st.refs[st.arg_count].row = 0
    st.refs[st.arg_count].col = 0
    st.refs[st.arg_count].row2 = 0
    st.refs[st.arg_count].col2 = 0
    st.arg_count += 1
}

ArgGroupCount :: (args: *Val, marks: *s32, count: s32) -> s32 {
    groups: s32 = 0
    i: s32 = 0
    while i < count {
        if marks[i] != 0 {
            groups += 1
        }
        i += 1
    }
    return groups
}

GroupBounds :: (marks: *s32, count: s32, group: s32, start: *s32, len: *s32) -> s32 {
    found: s32 = -1
    i: s32 = 0
    begin: s32 = -1
    while i <= count {
        boundary: s32 = cast(s32)(i == count || marks[i] != 0)
        if boundary != 0 && begin >= 0 {
            found += 1
            if found == group {
                start[0] = begin
                len[0] = i - begin
                return 1
            }
            begin = -1
        }
        if i < count && marks[i] != 0 {
            begin = i
        }
        i += 1
    }
    return 0
}

ParseSheetPrefix :: (st: *EvalState, text: *s8, pos: *s32, sheet_out: **Sheet) -> s32 {
    here: s32 = pos[0]
    end: s32 = here
    name: [160]s8
    len: s32 = 0
    target: *Sheet = null
    quoted: s32 = 0
    inner: [160]s8
    while IdentChar(cast(s32)text[end]) != 0 || text[end] == 32 {
        end += 1
    }
    if text[end] != 33 || end == here {
        return 0
    }
    len = end - here
    while len > 0 && text[here + len - 1] == 32 {
        len -= 1
    }
    if len >= 160 {
        return 0
    }
    MemoryCopy(cast(*void)(*name[0]), cast(*void)(*text[here]), cast(u64)len)
    name[len] = 0
    quoted = 0
    if len >= 2 && name[0] == 39 && name[len - 1] == 39 {
        MemoryCopy(cast(*void)(*inner[0]), cast(*void)(*name[1]), cast(u64)(len - 2))
        inner[len - 2] = 0
        quoted = 1
    }
    target = WorkbookFindSheet(st.wb, ifx quoted != 0 then (*inner[0]) else (*name[0]))
    if target == null {
        return -1
    }
    pos[0] = end + 1
    sheet_out[0] = target
    return 1
}

TryParseReference :: (st: *EvalState, text: *s8, pos: *s32, out_row: *s32, out_col: *s32, out_row2: *s32, out_col2: *s32, out_sheet: **Sheet, out_is_range: *s32) -> s32 {
    sheet: *Sheet = st.sheet
    local_pos: s32 = pos[0]
    col: s32 = 0
    row: s32 = 0
    look: s32 = 0
    prefix: s32 = ParseSheetPrefix(st, text, *local_pos, *sheet)
    if prefix < 0 {
        return 0
    }
    if text[local_pos] == 36 {
        local_pos += 1
    }
    col = ParseColLetters(text, *local_pos)
    if col < 0 {
        return 0
    }
    if text[local_pos] == 36 {
        local_pos += 1
    }
    row = ParseRowDigits(text, *local_pos)
    if row < 0 {
        return 0
    }
    look = local_pos
    SkipFormulaSpace(text, *look)
    if text[look] == 58 {
        col2: s32 = 0
        row2: s32 = 0
        look += 1
        SkipFormulaSpace(text, *look)
        if text[look] == 36 {
            look += 1
        }
        col2 = ParseColLetters(text, *look)
        if col2 < 0 {
            return 0
        }
        if text[look] == 36 {
            look += 1
        }
        row2 = ParseRowDigits(text, *look)
        if row2 < 0 {
            return 0
        }
        pos[0] = look
        out_sheet[0] = sheet
        out_row[0] = row
        out_col[0] = col
        out_row2[0] = row2
        out_col2[0] = col2
        out_is_range[0] = 1
        return 1
    }
    pos[0] = local_pos
    out_sheet[0] = sheet
    out_row[0] = row
    out_col[0] = col
    out_row2[0] = row
    out_col2[0] = col
    out_is_range[0] = 0
    return 1
}

ParseQuotedString :: (text: *s8, pos: *s32) -> Val {
    buf: [1024]s8
    if FormulaParseStringLiteral(text, pos, *buf[0], 1024) != 0 {
        return ValString(wb_strdup(*buf[0]))
    }
    return ValError(ERR_VALUE)
}

TryParseError :: (text: *s8, pos: *s32) -> s32 {
    return FormulaScanErrorName(text, pos)
}

CellToValue :: (cell: *Cell) -> Val {
    v: Val
    if cell == null {
        return ValEmpty()
    }
    v.kind = cell.cached_kind
    v.number = cell.cached_number
    v.text = ifx cell.cached_kind == VAL_STRING && cell.cached_text != null then wb_strdup(cell.cached_text) else null
    v.err = cell.cached_err
    v.from_range = 0
    return v
}

EvaluateCell :: (st: *EvalState, sheet: *Sheet, row: s32, col: s32) -> Val {
    cell: *Cell = CellAt(sheet, row, col)
    if cell == null {
        return ValEmpty()
    }
    if cell.kind != CELL_FORMULA {
        return CellToValue(cell)
    }
    if cell.evaluating != 0 {
        return ValError(ERR_CYCLE)
    }
    if cell.computed != 0 {
        v: Val = Val.{cell.cached_kind, cell.cached_number, null, cell.cached_err, 0}
        if v.kind == VAL_STRING && cell.cached_text != null {
            v.text = wb_strdup(cell.cached_text)
        }
        return v
    }
    if st.depth >= WB_DEPTH_MAX {
        return ValError(ERR_CYCLE)
    }
    cell.evaluating = 1
    pos: s32 = 0
    inner: EvalState = EvalState.{st.wb, sheet, st.depth + 1, st.args, st.marks, st.group_cols, st.arg_count, st.args_overflow, 0, st.this_row, st.this_col, st.last_cols, st.call_group_cols, st.refs, st.call_refs, 0, 0, 0, 0, 0}
    result: Val = EvalExpression(*inner, *cell.text[1], *pos)
    SkipFormulaSpace(*cell.text[1], *pos)
    if cell.text[1 + pos] != 0 {
        result = ValError(ERR_VALUE)
    }
    wb_free_val(cell)
    if result.kind == VAL_STRING {
        cell.cached_kind = VAL_STRING
        cell.cached_text = ifx result.text != null then result.text else wb_strdup(CText(""))
        cell.cached_number = 0
        cell.cached_err = 0
    } else {
        cell.cached_kind = result.kind
        cell.cached_number = result.number
        cell.cached_text = null
        cell.cached_err = result.err
    }
    cell.computed = 1
    cell.evaluating = 0
    {
        v2: Val = Val.{cell.cached_kind, cell.cached_number, null, cell.cached_err, 0}
        if v2.kind == VAL_STRING && cell.cached_text != null {
            v2.text = wb_strdup(cell.cached_text)
        }
        return v2
    }
}

RangeToValues :: (st: *EvalState, sheet: *Sheet, row: s32, col: s32, row2: s32, col2: s32) -> Val {
    v: Val = Val.{VAL_RANGE, 0.0, null, 0, 1}
    if row2 < row {
        swap: s32 = row
        row = row2
        row2 = swap
    }
    if col2 < col {
        swap: s32 = col
        col = col2
        col2 = swap
    }
    st.last_cols = col2 - col + 1
    st.pend_kind = 2
    st.pend_row = row
    st.pend_col = col
    st.pend_row2 = row2
    st.pend_col2 = col2
    if row2 < (-1 + 0) {
        return v
    }
    r: s32 = row
    while r <= row2 {
        c: s32 = col
        while c <= col2 {
            cell: *Cell = CellAt(sheet, r, c)
            if cell != null {
                one: Val = EvaluateCell(st, sheet, r, c)
                one.from_range = 1
                EvalPush(st, one)
            } else {
                empty: Val = Val.{VAL_EMPTY, 0.0, null, 0, 1}
                EvalPush(st, empty)
            }
            c += 1
        }
        r += 1
    }
    return v
}

EvalFunction :: (st: *EvalState, text: *s8, pos: *s32, name: *s8, name_len: s32) -> Val {
    base: s32 = st.arg_count
    lower: [64]s8
    if name_len >= 64 {
        pos[0] += 1
        return ValError(ERR_NAME)
    }
    i: s32 = 0
    while i < name_len {
        lower[i] = cast(s8)LowerByte(cast(s32)(cast(u8)name[i]))
        i += 1
    }
    lower[name_len] = 0
    pos[0] += 1
    SkipFormulaSpace(text, pos)
    if text[pos[0]] != 41 {
        while true {
            arg_pos: s32 = pos[0]
            arg_slot: s32 = st.arg_count
            st.pend_kind = 0
            one: Val = EvalExpression(st, text, *arg_pos)
            if one.kind == VAL_ERROR && arg_pos == pos[0] && (text[arg_pos] == 44 || text[arg_pos] == 41) {
                one = ValEmpty()
            }
            if one.kind == VAL_RANGE {
                ValFree(*one)
                if arg_slot < WB_ARGS_MAX {
                    st.group_cols[arg_slot] = st.last_cols
                }
            } else {
                st.arg_count = arg_slot
                EvalPush(st, one)
            }
            if st.pend_kind != 0 && arg_slot < WB_ARGS_MAX {
                st.refs[arg_slot].kind = st.pend_kind
                st.refs[arg_slot].row = st.pend_row
                st.refs[arg_slot].col = st.pend_col
                st.refs[arg_slot].row2 = st.pend_row2
                st.refs[arg_slot].col2 = st.pend_col2
            }
            if st.arg_count > arg_slot && arg_slot < WB_ARGS_MAX {
                st.marks[arg_slot] = 1
            }
            SkipFormulaSpace(text, *arg_pos)
            if text[arg_pos] != 44 {
                pos[0] = arg_pos
                break
            }
            arg_pos += 1
            pos[0] = arg_pos
        }
    }
    if text[pos[0]] != 41 {
        return ValError(ERR_VALUE)
    }
    pos[0] += 1
    st.call_group_cols = *st.group_cols[base]
    st.call_refs = *st.refs[base]
    st.pend_kind = 0
    result: Val = CallFunction(st, *lower[0], *st.args[base], st.arg_count - base, *st.marks[base])
    i2: s32 = base
    while i2 < st.arg_count {
        ValFree(*st.args[i2])
        i2 += 1
    }
    st.arg_count = base
    return result
}

EvalFactor :: (st: *EvalState, text: *s8, pos: *s32) -> Val {
    SkipFormulaSpace(text, pos)
    ch: s32 = cast(s32)text[pos[0]]
    if ch == 0 {
        return ValError(ERR_VALUE)
    }
    if ch == 40 {
        pos[0] += 1
        v: Val = EvalExpression(st, text, pos)
        SkipFormulaSpace(text, pos)
        if text[pos[0]] != 41 {
            ValFree(*v)
            return ValError(ERR_VALUE)
        }
        pos[0] += 1
        return v
    }
    if ch == 34 {
        return ParseQuotedString(text, pos)
    }
    if ch == 45 || ch == 43 {
        return EvalUnary(st, text, pos)
    }
    err: s32 = TryParseError(text, pos)
    if err >= 0 {
        return ValError(err)
    }
    if ch >= 48 && ch <= 57 {
        end: *s8 = null
        value: float64 = ParseDouble(*text[pos[0]], *end)
        pos[0] += cast(s32)(cast(s64)(cast(u64)end - cast(u64)(*text[pos[0]])))
        return ValNumber(value)
    }
    if (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 36 || ch == 39 {
        row: s32 = 0
        col: s32 = 0
        row2: s32 = 0
        col2: s32 = 0
        sheet: *Sheet = null
        is_range: s32 = 0
        save: s32 = pos[0]
        if TryParseReference(st, text, pos, *row, *col, *row2, *col2, *sheet, *is_range) != 0 {
            if is_range != 0 {
                return RangeToValues(st, sheet, row, col, row2, col2)
            }
            st.pend_kind = 1
            st.pend_row = row
            st.pend_col = col
            st.pend_row2 = row
            st.pend_col2 = col
            return EvaluateCell(st, sheet, row, col)
        }
        pos[0] = save
        endpos: s32 = pos[0]
        while IdentChar(cast(s32)text[endpos]) != 0 {
            endpos += 1
        }
        if endpos == pos[0] {
            return ValError(ERR_VALUE)
        }
        name_len: s32 = endpos - pos[0]
        while text[endpos] == 32 {
            endpos += 1
        }
        if text[endpos] == 40 {
            call: Val = EvalFunction(st, text, *endpos, *text[pos[0]], name_len)
            pos[0] = endpos
            return call
        }
        if name_len == 4 && TextCompareFoldNLiteral(*text[pos[0]], "TRUE", 4) == 0 {
            pos[0] += 4
            return ValBool(1)
        }
        if name_len == 5 && TextCompareFoldNLiteral(*text[pos[0]], "FALSE", 5) == 0 {
            pos[0] += 5
            return ValBool(0)
        }
        pos[0] = endpos
        return ValError(ERR_NAME)
    }
    return ValError(ERR_VALUE)
}

EvalPostfix :: (st: *EvalState, text: *s8, pos: *s32) -> Val {
    v: Val = EvalFactor(st, text, pos)
    while v.kind != VAL_ERROR {
        SkipFormulaSpace(text, pos)
        if text[pos[0]] != 37 {
            break
        }
        pos[0] += 1
        n: float64 = CoerceNumber(*v)
        if n >= 1e307 {
            ValFree(*v)
            return ValError(ERR_VALUE)
        }
        ValFree(*v)
        st.pend_kind = 0
        v = ValNumber(n / 100.0)
    }
    return v
}

EvalUnary :: (st: *EvalState, text: *s8, pos: *s32) -> Val {
    SkipFormulaSpace(text, pos)
    if text[pos[0]] == 45 {
        pos[0] += 1
        operand: Val = EvalUnary(st, text, pos)
        if operand.kind == VAL_ERROR {
            return operand
        }
        n: float64 = CoerceNumber(*operand)
        if n >= 1e307 {
            ValFree(*operand)
            return ValError(ERR_VALUE)
        }
        ValFree(*operand)
        st.pend_kind = 0
        return ValNumber(-n)
    }
    if text[pos[0]] == 43 {
        pos[0] += 1
        return EvalUnary(st, text, pos)
    }
    return EvalPostfix(st, text, pos)
}

EvalPower :: (st: *EvalState, text: *s8, pos: *s32) -> Val {
    left: Val = EvalUnary(st, text, pos)
    while left.kind != VAL_ERROR {
        SkipFormulaSpace(text, pos)
        if text[pos[0]] != 94 {
            break
        }
        pos[0] += 1
        right: Val = EvalUnary(st, text, pos)
        if right.kind == VAL_ERROR {
            ValFree(*left)
            return right
        }
        a: float64 = CoerceNumber(*left)
        b: float64 = CoerceNumber(*right)
        ValFree(*left)
        ValFree(*right)
        if a >= 1e307 || b >= 1e307 {
            return ValError(ERR_VALUE)
        }
        r: float64 = Pow(a, b)
        if r != r {
            return ValError(ERR_NUM)
        }
        st.pend_kind = 0
        left = ValNumber(r)
    }
    return left
}

EvalMul :: (st: *EvalState, text: *s8, pos: *s32) -> Val {
    left: Val = EvalPower(st, text, pos)
    while left.kind != VAL_ERROR {
        SkipFormulaSpace(text, pos)
        op: s32 = cast(s32)text[pos[0]]
        if op != 42 && op != 47 {
            break
        }
        pos[0] += 1
        right: Val = EvalPower(st, text, pos)
        if right.kind == VAL_ERROR {
            ValFree(*left)
            return right
        }
        a: float64 = CoerceNumber(*left)
        b: float64 = CoerceNumber(*right)
        ValFree(*left)
        ValFree(*right)
        if a >= 1e307 || b >= 1e307 {
            return ValError(ERR_VALUE)
        }
        st.pend_kind = 0
        if op == 42 {
            left = ValNumber(a * b)
        } else {
            if b == 0 {
                return ValError(ERR_DIV0)
            }
            left = ValNumber(a / b)
        }
    }
    return left
}

EvalAdd :: (st: *EvalState, text: *s8, pos: *s32) -> Val {
    left: Val = EvalMul(st, text, pos)
    while left.kind != VAL_ERROR {
        SkipFormulaSpace(text, pos)
        op: s32 = cast(s32)text[pos[0]]
        if op != 43 && op != 45 {
            break
        }
        pos[0] += 1
        right: Val = EvalMul(st, text, pos)
        if right.kind == VAL_ERROR {
            ValFree(*left)
            return right
        }
        a: float64 = CoerceNumber(*left)
        b: float64 = CoerceNumber(*right)
        ValFree(*left)
        ValFree(*right)
        if a >= 1e307 || b >= 1e307 {
            return ValError(ERR_VALUE)
        }
        st.pend_kind = 0
        if op == 43 {
            left = ValNumber(a + b)
        } else {
            left = ValNumber(a - b)
        }
    }
    return left
}

EvalConcat :: (st: *EvalState, text: *s8, pos: *s32) -> Val {
    left: Val = EvalAdd(st, text, pos)
    while left.kind != VAL_ERROR {
        SkipFormulaSpace(text, pos)
        if text[pos[0]] != 38 {
            break
        }
        pos[0] += 1
        right: Val = EvalAdd(st, text, pos)
        if right.kind == VAL_ERROR {
            ValFree(*left)
            return right
        }
        a: [1024]s8
        b: [1024]s8
        joined: [2048]s8
        CoerceText(*left, *a[0], 1024)
        CoerceText(*right, *b[0], 1024)
        FormatText(*joined[0], 2048, CText("%s%s"), *a[0], *b[0])
        ValFree(*left)
        ValFree(*right)
        st.pend_kind = 0
        left = ValString(wb_strdup(*joined[0]))
    }
    return left
}

EvalCompare :: (st: *EvalState, text: *s8, pos: *s32) -> Val {
    left: Val = EvalConcat(st, text, pos)
    while left.kind != VAL_ERROR {
        SkipFormulaSpace(text, pos)
        op: s32 = 0
        if text[pos[0]] == 61 {
            op = 1
        } else if text[pos[0]] == 60 && text[pos[0] + 1] == 62 {
            op = 2
        } else if text[pos[0]] == 60 && text[pos[0] + 1] == 61 {
            op = 3
        } else if text[pos[0]] == 62 && text[pos[0] + 1] == 61 {
            op = 4
        } else if text[pos[0]] == 60 {
            op = 5
        } else if text[pos[0]] == 62 {
            op = 6
        }
        if op == 0 {
            break
        }
        if op == 1 || op == 5 || op == 6 {
            pos[0] += 1
        } else {
            pos[0] += 2
        }
        right: Val = EvalConcat(st, text, pos)
        if right.kind == VAL_ERROR {
            ValFree(*left)
            return right
        }
        if left.kind == VAL_ERROR {
            ValFree(*right)
            return left
        }
        cmp: s32 = CompareVals(*left, *right)
        ValFree(*left)
        ValFree(*right)
        if cmp == -2 {
            return ValError(ERR_VALUE)
        }
        truth: s32 = 0
        if op == 1 {
            truth = cast(s32)(cmp == 0)
        } else if op == 2 {
            truth = cast(s32)(cmp != 0)
        } else if op == 3 {
            truth = cast(s32)(cmp <= 0)
        } else if op == 4 {
            truth = cast(s32)(cmp >= 0)
        } else if op == 5 {
            truth = cast(s32)(cmp < 0)
        } else {
            truth = cast(s32)(cmp > 0)
        }
        st.pend_kind = 0
        left = ValBool(truth)
    }
    return left
}

EvalExpression :: (st: *EvalState, text: *s8, pos: *s32) -> Val {
    return EvalCompare(st, text, pos)
}

WbCellValueText :: (v: *Val, out: *s8, cap: s32) {
    if v.kind == VAL_ERROR {
        FormatText(out, cast(u64)cap, CText("%s"), ErrText(v.err))
        return
    }
    if v.kind == VAL_BOOL {
        FormatText(out, cast(u64)cap, CText("%s"), ifx v.number != 0 then CText("TRUE") else CText("FALSE"))
        return
    }
    if v.kind == VAL_FLOAT {
        FormatNumber(v.number, out, cap)
        return
    }
    if v.kind == VAL_STRING {
        FormatText(out, cast(u64)cap, CText("%s"), ifx v.text != null then v.text else CText(""))
        return
    }
    out[0] = 0
}

SerialToDateText :: (serial: s32, out: *s8, cap: s32) {
    days: s32 = serial + SerialEpoch()
    y: s32 = 0
    m: s32 = 0
    d: s32 = 0
    if serial < 61 {
        days = serial + 1 + SerialEpoch()
    }
    CivilFromDays(days, *y, *m, *d)
    FormatText(out, cast(u64)cap, CText("%04d/%02d/%02d"), y, m, d)
}

SerialToTimeText :: (frac: float64, out: *s8, cap: s32) {
    seconds: s32 = TruncateToS32(frac * 86400.0 + 0.5)
    while seconds < 0 {
        seconds += 86400
    }
    seconds = seconds % 86400
    FormatText(out, cast(u64)cap, CText("%02d:%02d:%02d"), seconds / 3600, (seconds / 60) % 60, seconds % 60)
}

CellDisplayText :: (cell: *Cell, out: *s8, cap: s32) {
    v: Val = Val.{cell.cached_kind, cell.cached_number, cell.cached_text, cell.cached_err, 0}
    if cell.cached_kind == VAL_FLOAT && cell.hint == 1 {
        SerialToDateText(TruncateToS32(cell.cached_number), out, cap)
        return
    }
    if cell.cached_kind == VAL_FLOAT && cell.hint == 2 {
        SerialToTimeText(cell.cached_number, out, cap)
        return
    }
    if cell.cached_kind == VAL_FLOAT && cell.hint == 3 {
        dbuf: [32]s8
        SerialToDateText(TruncateToS32(cell.cached_number), *dbuf[0], 32)
        if (cell.cached_number - cast(float64)TruncateToS32(cell.cached_number)) == 0 {
            FormatText(out, cast(u64)cap, CText("%s"), *dbuf[0])
            return
        }
        FormatText(out, cast(u64)cap, CText("%s "), *dbuf[0])
        tfrac: float64 = cell.cached_number - cast(float64)TruncateToS32(cell.cached_number)
        total_ms: float64 = tfrac * 86400000.0
        ms: s32 = TruncateToS32(total_ms + 0.5)
        while ms < 0 {
            ms += 86400000
        }
        ms = ms % 86400000
        if (ms % 1000) == 0 {
            SerialToTimeText(tfrac, *out[TextLength(out)], cast(s32)(cast(u64)cap - TextLength(out)))
        } else {
            seconds2: s32 = ms / 1000
            FormatText(*out[TextLength(out)], cast(u64)cap - TextLength(out), CText("%02d:%02d:%02d.%03d"), seconds2 / 3600, (seconds2 / 60) % 60, seconds2 % 60, ms % 1000)
        }
        return
    }
    WbCellValueText(*v, out, cap)
}

EvaluateOne :: (wb: *Workbook, sheet: *Sheet, cell: *Cell, args: *Val, marks: *s32, group_cols: *s32, refs: *SlotRef) {
    st: EvalState = EvalState.{wb, sheet, 0, args, marks, group_cols, 0, 0, 0, CellKeyRow(cell.key), CellKeyCol(cell.key), 0, null, refs, refs, 0, 0, 0, 0, 0}
    pos: s32 = 0
    if cell.computed != 0 {
        return
    }
    result: Val = EvalExpression(*st, *cell.text[1], *pos)
    SkipFormulaSpace(*cell.text[1], *pos)
    if cell.text[1 + pos] != 0 {
        result = ValError(ERR_VALUE)
    }
    wb_free_val(cell)
    if result.kind == VAL_STRING {
        cell.cached_kind = VAL_STRING
        cell.cached_text = ifx result.text != null then result.text else wb_strdup(CText(""))
        cell.cached_number = 0
        cell.cached_err = 0
    } else {
        cell.cached_kind = result.kind
        cell.cached_number = result.number
        cell.cached_text = null
        cell.cached_err = result.err
        cell.hint = st.hint
    }
    cell.computed = 1
}

EvaluateSheet :: (wb: *Workbook, sheet: *Sheet) {
    pass: s32 = 0
    changed: s32 = 1
    args: *Val = cast(*Val)MemoryAllocate(cast(u64)size_of(Val) * WB_ARGS_MAX)
    marks: *s32 = cast(*s32)MemoryAllocate(4 * WB_ARGS_MAX)
    group_cols: *s32 = cast(*s32)MemoryAllocate(4 * WB_ARGS_MAX)
    refs: *SlotRef = cast(*SlotRef)MemoryAllocate(cast(u64)size_of(SlotRef) * WB_ARGS_MAX)
    if args == null || marks == null || group_cols == null || refs == null {
        MemoryFree(cast(*void)args)
        MemoryFree(cast(*void)marks)
        MemoryFree(cast(*void)group_cols)
        MemoryFree(cast(*void)refs)
        return
    }
    while changed != 0 && pass < 100 {
        i: s32 = 0
        changed = 0
        while i < sheet.cell_count {
            cell: *Cell = *sheet.cells[i]
            if cell.kind == CELL_FORMULA && cell.text != null && cell.text[0] == 61 && cell.text[1] != 0 {
                before: [512]s8
                after: [512]s8
                v_before: Val = Val.{cell.cached_kind, cell.cached_number, cell.cached_text, cell.cached_err, 0}
                WbCellValueText(*v_before, *before[0], 512)
                cell.computed = 0
                EvaluateOne(wb, sheet, cell, args, marks, group_cols, refs)
                v_after: Val = Val.{cell.cached_kind, cell.cached_number, cell.cached_text, cell.cached_err, 0}
                WbCellValueText(*v_after, *after[0], 512)
                if TextCompare(*before[0], *after[0]) != 0 {
                    changed = 1
                }
            }
            i += 1
        }
        pass += 1
    }
    MemoryFree(cast(*void)args)
    MemoryFree(cast(*void)marks)
    MemoryFree(cast(*void)group_cols)
    MemoryFree(cast(*void)refs)
}

SheetInsertRow :: (sheet: *Sheet, at_row: s32) -> s32 {
    i: s32 = sheet.cell_count - 1
    moved: s32 = 0
    while i >= 0 {
        row: s32 = CellKeyRow(sheet.cells[i].key)
        col: s32 = CellKeyCol(sheet.cells[i].key)
        if row >= at_row {
            if (row + 1) >= WB_MAX_ROWS {
                return moved
            }
            sheet.cells[i].key = CellKey(row + 1, col)
            moved += 1
        }
        i -= 1
    }
    SheetExtent(sheet)
    return moved
}

SheetDeleteRow :: (sheet: *Sheet, at_row: s32) -> s32 {
    write: s32 = 0
    read: s32 = 0
    removed: s32 = 0
    while read < sheet.cell_count {
        row: s32 = CellKeyRow(sheet.cells[read].key)
        col: s32 = CellKeyCol(sheet.cells[read].key)
        if row == at_row {
            MemoryFree(cast(*void)sheet.cells[read].text)
            MemoryFree(cast(*void)sheet.cells[read].cached_text)
            MemoryFree(cast(*void)sheet.cells[read].serialized)
            removed += 1
        } else {
            if row > at_row {
                sheet.cells[read].key = CellKey(row - 1, col)
            }
            if write != read {
                sheet.cells[write] = sheet.cells[read]
            }
            write += 1
        }
        read += 1
    }
    sheet.cell_count = write
    SheetExtent(sheet)
    return removed
}

SheetInsertColumn :: (sheet: *Sheet, at_col: s32) -> s32 {
    i: s32 = sheet.cell_count - 1
    moved: s32 = 0
    while i >= 0 {
        row: s32 = CellKeyRow(sheet.cells[i].key)
        col: s32 = CellKeyCol(sheet.cells[i].key)
        if col >= at_col {
            if (col + 1) >= WB_MAX_COLS {
                return moved
            }
            sheet.cells[i].key = CellKey(row, col + 1)
            moved += 1
        }
        i -= 1
    }
    SheetExtent(sheet)
    return moved
}

SheetDeleteColumn :: (sheet: *Sheet, at_col: s32) -> s32 {
    write: s32 = 0
    read: s32 = 0
    removed: s32 = 0
    while read < sheet.cell_count {
        row: s32 = CellKeyRow(sheet.cells[read].key)
        col: s32 = CellKeyCol(sheet.cells[read].key)
        if col == at_col {
            MemoryFree(cast(*void)sheet.cells[read].text)
            MemoryFree(cast(*void)sheet.cells[read].cached_text)
            MemoryFree(cast(*void)sheet.cells[read].serialized)
            removed += 1
        } else {
            if col > at_col {
                sheet.cells[read].key = CellKey(row, col - 1)
            }
            if write != read {
                sheet.cells[write] = sheet.cells[read]
            }
            write += 1
        }
        read += 1
    }
    sheet.cell_count = write
    SheetExtent(sheet)
    return removed
}

WorkbookInsertRow :: (wb: *Workbook, sheet_index: s32, row: s32) -> s32 {
    if sheet_index < 0 || sheet_index >= wb.sheet_count {
        return 0
    }
    return SheetInsertRow(*wb.sheets[sheet_index], row)
}

WorkbookDeleteRow :: (wb: *Workbook, sheet_index: s32, row: s32) -> s32 {
    if sheet_index < 0 || sheet_index >= wb.sheet_count {
        return 0
    }
    return SheetDeleteRow(*wb.sheets[sheet_index], row)
}

WorkbookInsertColumn :: (wb: *Workbook, sheet_index: s32, col: s32) -> s32 {
    if sheet_index < 0 || sheet_index >= wb.sheet_count {
        return 0
    }
    return SheetInsertColumn(*wb.sheets[sheet_index], col)
}

WorkbookDeleteColumn :: (wb: *Workbook, sheet_index: s32, col: s32) -> s32 {
    if sheet_index < 0 || sheet_index >= wb.sheet_count {
        return 0
    }
    return SheetDeleteColumn(*wb.sheets[sheet_index], col)
}

WorkbookEvaluate :: (wb: *Workbook) {
    i: s32 = 0
    while i < wb.sheet_count {
        EvaluateSheet(wb, *wb.sheets[i])
        i += 1
    }
}

CollectNumbers :: (args: *Val, count: s32, out: *NumList) {
    i: s32 = 0
    while i < count {
        v: *Val = *args[i]
        if v.kind == VAL_ERROR {
            out.saw_error = 1
        } else if v.kind == VAL_FLOAT {
            if out.count < 4096 {
                out.data[out.count] = v.number
                out.count += 1
            }
        } else if v.kind == VAL_STRING && !(v.from_range != 0) && TextLooksNumeric(v.text) != 0 {
            if out.count < 4096 {
                out.data[out.count] = ParseDouble(v.text, null)
                out.count += 1
            }
        }
        i += 1
    }
}

FirstError :: (args: *Val, count: s32) -> Val {
    i: s32 = 0
    while i < count {
        if args[i].kind == VAL_ERROR {
            return ValError(args[i].err)
        }
        i += 1
    }
    return ValError(ERR_VALUE)
}

ArgNumberAt :: (args: *Val, count: s32, index: s32) -> float64 {
    if index >= count {
        return 1e308
    }
    if args[index].kind == VAL_ERROR {
        return 1e308
    }
    return CoerceNumber(*args[index])
}

FnRowColumn :: (st: *EvalState, args: *Val, count: s32, marks: *s32, want_row: s32) -> Val {
    if count == 0 {
        if want_row != 0 {
            return ValNumber(cast(float64)(st.this_row + 1))
        }
        return ValNumber(cast(float64)(st.this_col + 1))
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if want_row != 0 {
        return ValNumber(cast(float64)(st.this_row + 1))
    }
    return ValNumber(cast(float64)(st.this_col + 1))
}

FnRowsColumns :: (st: *EvalState, args: *Val, count: s32, marks: *s32, want_rows: s32) -> Val {
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if want_rows != 0 {
        return ValNumber(cast(float64)count)
    }
    ncols: s32 = st.call_group_cols[0]
    if ncols < 1 {
        ncols = 1
    }
    return ValNumber(cast(float64)ncols)
}

FnSumProduct :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    start: s32 = 0
    len: s32 = 0
    total: float64 = 0
    i: s32 = 0
    if groups < 1 {
        return ValError(ERR_VALUE)
    }
    GroupBounds(marks, count, 0, *start, *len)
    i = 0
    while i < len {
        product: float64 = 1
        g: s32 = 0
        while g < groups {
            gstart: s32 = 0
            glen: s32 = 0
            v: *Val = null
            GroupBounds(marks, count, g, *gstart, *glen)
            v = *args[gstart + (ifx i < glen then i else 0)]
            if v.kind == VAL_ERROR {
                return ValError(v.err)
            }
            if v.kind == VAL_FLOAT {
                product *= v.number
            } else {
                product *= 0
            }
            g += 1
        }
        total += product
        i += 1
    }
    return ValNumber(total)
}

ValTextEquals :: (a: *Val, b: *Val) -> s32 {
    ta: [512]s8
    tb: [512]s8
    if a.kind == VAL_ERROR || b.kind == VAL_ERROR {
        return 0
    }
    CoerceText(a, *ta[0], 512)
    CoerceText(b, *tb[0], 512)
    return cast(s32)(TextCompareFold(*ta[0], *tb[0]) == 0)
}

FnLookup :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    needle: *Val = null
    table_start: s32 = 0
    table_len: s32 = 0
    result_start: s32 = 0
    result_len: s32 = 0
    ncols: s32 = 0
    nrows: s32 = 0
    vertical: s32 = 1
    if groups < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    needle = *args[0]
    GroupBounds(marks, count, 1, *table_start, *table_len)
    ncols = st.call_group_cols[table_start]
    if ncols < 1 {
        ncols = 1
    }
    nrows = table_len / ncols
    if ncols > nrows {
        vertical = 0
    }
    if groups >= 3 {
        GroupBounds(marks, count, 2, *result_start, *result_len)
    } else {
        result_start = table_start
        result_len = table_len
    }
    {
        rcols: s32 = st.call_group_cols[result_start]
        if rcols < 1 {
            rcols = 1
        }
        rrows: s32 = result_len / rcols
        best: s32 = -1
        i: s32 = 0
        n_scan: s32 = ifx vertical != 0 then nrows else ncols
        while i < n_scan {
            vidx: s32 = ifx vertical != 0 then (table_start + i * ncols) else (table_start + i)
            first: *Val = *args[vidx]
            hit2: s32 = 0
            if needle.kind == VAL_STRING && first.kind == VAL_STRING {
                hit2 = cast(s32)(TextCompareFold(needle.text, first.text) == 0)
            } else if needle.kind == VAL_FLOAT && first.kind == VAL_FLOAT {
                hit2 = cast(s32)(needle.number <= first.number && first.number <= needle.number)
                hit2 = cast(s32)(needle.number == first.number)
            } else if needle.kind == VAL_BOOL && first.kind == VAL_BOOL {
                hit2 = cast(s32)(needle.number == first.number)
            }
            if hit2 != 0 {
                best = i
                break
            }
            below: s32 = 0
            if needle.kind == VAL_STRING && first.kind == VAL_STRING {
                below = cast(s32)(TextCompareFold(needle.text, first.text) >= 0)
            } else if needle.kind == VAL_FLOAT && first.kind == VAL_FLOAT {
                below = cast(s32)(needle.number >= first.number)
            }
            if below != 0 {
                best = i
            }
            i += 1
        }
        if best < 0 {
            return ValError(ERR_NA)
        }
        if vertical != 0 {
            tx: s32 = rcols - 1
            ty: s32 = best
            if ty < rrows {
                return ValCopy(*args[result_start + ty * rcols + tx])
            }
            return ValError(ERR_NA)
        }
        tx2: s32 = best
        ty2: s32 = rrows - 1
        if tx2 < rcols {
            return ValCopy(*args[result_start + ty2 * rcols + tx2])
        }
        return ValError(ERR_NA)
    }
    return ValError(ERR_NA)
}

FnVlookupHlookup :: (st: *EvalState, args: *Val, count: s32, marks: *s32, vertical: s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    needle: *Val = null
    table_start: s32 = 0
    table_len: s32 = 0
    index: float64 = 0
    lookup_col: s32 = 0
    i: s32 = 0
    if groups < 3 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    needle = *args[0]
    GroupBounds(marks, count, 1, *table_start, *table_len)
    index = CoerceNumber(*args[table_start + table_len])
    if index < 1 {
        return ValError(ERR_VALUE)
    }
    lookup_col = TruncateToS32(index) - 1
    if table_len == 0 {
        return ValError(ERR_REF)
    }
    ncols: s32 = st.call_group_cols[table_start]
    if ncols < 1 {
        ncols = 1
    }
    if vertical != 0 {
        stride: s32 = ncols
        table_rows: s32 = table_len / stride
        i = 0
        while i < table_rows {
            first: *Val = *args[table_start + i * stride]
            if first.kind == VAL_ERROR {
                return ValError(first.err)
            }
            hit: s32 = 0
            if needle.kind == VAL_STRING && first.kind == VAL_STRING {
                hit = cast(s32)(TextCompareFold(needle.text, first.text) == 0)
            } else if needle.kind == VAL_FLOAT && first.kind == VAL_FLOAT {
                hit = cast(s32)(needle.number == first.number)
            } else if needle.kind == VAL_BOOL && first.kind == VAL_BOOL {
                hit = cast(s32)(needle.number == first.number)
            }
            if hit != 0 {
                target: s32 = table_start + i * stride + lookup_col
                if target < (table_start + table_len) {
                    return ValCopy(*args[target])
                }
                return ValError(ERR_REF)
            }
            i += 1
        }
        approximate: s32 = 1
        if groups >= 4 {
            flagarg: s32 = 0
            flen: s32 = 0
            GroupBounds(marks, count, 3, *flagarg, *flen)
            if flen == 1 {
                approximate = cast(s32)(CoerceBool(*args[flagarg]) != 0)
            }
        }
        if approximate != 0 {
            best: s32 = -1
            i = 0
            while i < table_rows {
                first: *Val = *args[table_start + i * stride]
                below: s32 = 0
                if first.kind == VAL_STRING && needle.kind == VAL_STRING {
                    below = cast(s32)(TextCompareFold(first.text, needle.text) <= 0)
                } else if first.kind == VAL_FLOAT && needle.kind == VAL_FLOAT {
                    below = cast(s32)(first.number <= needle.number)
                }
                if below != 0 {
                    best = i
                }
                i += 1
            }
            if best >= 0 {
                target: s32 = table_start + best * stride + lookup_col
                if target < (table_start + table_len) {
                    return ValCopy(*args[target])
                }
            }
        }
        return ValError(ERR_NA)
    }
    return ValError(ERR_NA)
}

FnMatch :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    needle: *Val = null
    start: s32 = 0
    len: s32 = 0
    i: s32 = 0
    if groups < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    needle = *args[0]
    GroupBounds(marks, count, 1, *start, *len)
    i = 0
    while i < len {
        v: *Val = *args[start + i]
        if v.kind == VAL_ERROR {
            return ValError(v.err)
        }
        hit: s32 = 0
        if needle.kind == VAL_STRING && v.kind == VAL_STRING {
            hit = cast(s32)(TextCompareFold(needle.text, v.text) == 0)
        } else if needle.kind == VAL_FLOAT && v.kind == VAL_FLOAT {
            hit = cast(s32)(needle.number == v.number)
        } else if needle.kind == VAL_BOOL && v.kind == VAL_BOOL {
            hit = cast(s32)(needle.number == v.number)
        }
        if hit != 0 {
            return ValNumber(cast(float64)(i + 1))
        }
        i += 1
    }
    return ValError(ERR_NA)
}

FnIndex :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    start: s32 = 0
    len: s32 = 0
    row: float64 = 0
    col: float64 = 0
    if groups < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    GroupBounds(marks, count, 0, *start, *len)
    row = CoerceNumber(*args[count - 2])
    if count >= 3 {
        col = CoerceNumber(*args[count - 1])
    } else {
        col = 1
    }
    if row < 1 || col < 1 {
        return ValError(ERR_VALUE)
    }
    if groups >= 3 {
        ncols: s32 = st.call_group_cols[start]
        if ncols < 1 {
            ncols = 1
        }
        idx: s32 = TruncateToS32((row - 1) * cast(float64)ncols + (col - 1))
        if idx >= len {
            return ValError(ERR_REF)
        }
        return ValCopy(*args[start + idx])
    }
    if TruncateToS32(row) > len {
        return ValError(ERR_REF)
    }
    return ValCopy(*args[start + TruncateToS32(row) - 1])
}

FnGeomean :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    list: NumList
    total: float64 = 0
    i: s32 = 0
    CollectNumbers(args, count, *list)
    if list.saw_error != 0 {
        return FirstError(args, count)
    }
    if list.count == 0 {
        return ValError(ERR_NUM)
    }
    i = 0
    while i < list.count {
        if list.data[i] <= 0 {
            return ValError(ERR_NUM)
        }
        total += Log(list.data[i])
        i += 1
    }
    return ValNumber(Exp(total / cast(float64)list.count))
}

FnHarmean :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    list: NumList
    total: float64 = 0
    i: s32 = 0
    CollectNumbers(args, count, *list)
    if list.saw_error != 0 {
        return FirstError(args, count)
    }
    if list.count == 0 {
        return ValError(ERR_NUM)
    }
    i = 0
    while i < list.count {
        if list.data[i] == 0 {
            return ValError(ERR_NUM)
        }
        total += 1.0 / list.data[i]
        i += 1
    }
    return ValNumber(cast(float64)list.count / total)
}

FnAvedev :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    list: NumList
    total: float64 = 0
    mean: float64 = 0
    dev: float64 = 0
    i: s32 = 0
    CollectNumbers(args, count, *list)
    if list.saw_error != 0 {
        return FirstError(args, count)
    }
    if list.count == 0 {
        return ValError(ERR_NUM)
    }
    i = 0
    while i < list.count {
        total += list.data[i]
        i += 1
    }
    mean = total / cast(float64)list.count
    i = 0
    while i < list.count {
        dev += Fabs(list.data[i] - mean)
        i += 1
    }
    return ValNumber(dev / cast(float64)list.count)
}

FnMode :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    list: NumList
    best: float64 = 0
    best_count: s32 = 0
    i: s32 = 0
    CollectNumbers(args, count, *list)
    if list.saw_error != 0 {
        return FirstError(args, count)
    }
    i = 0
    while i < list.count {
        same: s32 = 0
        j: s32 = 0
        while j < list.count {
            if list.data[j] == list.data[i] {
                same += 1
            }
            j += 1
        }
        if same > best_count {
            best_count = same
            best = list.data[i]
        }
        i += 1
    }
    if best_count < 2 {
        return ValError(ERR_NA)
    }
    return ValNumber(best)
}

FnTruncEvenOdd :: (st: *EvalState, args: *Val, count: s32, marks: *s32, code: s32) -> Val {
    v: float64 = 0
    digits: float64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    v = CoerceNumber(*args[0])
    if v >= 1e307 {
        return ValError(ERR_VALUE)
    }
    if code == 0 {
        if count >= 2 {
            if args[1].kind == VAL_ERROR {
                return ValError(args[1].err)
            }
            digits = CoerceNumber(*args[1])
        }
        scale: float64 = Pow(10.0, digits)
        return ValNumber(Trunc(v * scale) / scale)
    }
    {
        away: float64 = ifx v < 0 then (-v) else v
        n: float64 = Ceil(away)
        target: s32 = ifx code == 1 then 0 else 1
        if (TruncateToS32(n) % 2) == target {
            return ValNumber(ifx v < 0 then (-n) else n)
        }
        n += 1
        return ValNumber(ifx v < 0 then (-n) else n)
    }
}

FnQuotient :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    a: float64 = 0
    b: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    a = CoerceNumber(*args[0])
    b = CoerceNumber(*args[1])
    if b == 0 {
        return ValError(ERR_DIV0)
    }
    return ValNumber(Trunc(a / b))
}

FnProper :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    text: [1024]s8
    out: [1024]s8
    i: s32 = 0
    word_start: s32 = 1
    if TextArg(args, count, 0, *text[0], 1024) < 0 {
        return ValError(ERR_VALUE)
    }
    while text[i] != 0 {
        is_alpha: s32 = cast(s32)(IsAlphaByte(cast(s32)(cast(u8)text[i])) != 0)
        if is_alpha != 0 && word_start != 0 {
            out[i] = cast(s8)UpperByte(cast(s32)(cast(u8)text[i]))
        } else if is_alpha != 0 {
            out[i] = cast(s8)LowerByte(cast(s32)(cast(u8)text[i]))
        } else {
            out[i] = text[i]
        }
        word_start = cast(s32)(!(IsAlphaByte(cast(s32)(cast(u8)text[i])) != 0) && text[i] != 39)
        i += 1
    }
    out[i] = 0
    return ValString(wb_strdup(*out[0]))
}

FnReplace :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    text: [512]s8
    new: [512]s8
    out: [1024]s8
    start: float64 = 0
    n: float64 = 0
    len: s32 = 0
    if count < 4 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 0, *text[0], 512) < 0 {
        return ValError(ERR_VALUE)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    if args[2].kind == VAL_ERROR {
        return ValError(args[2].err)
    }
    if TextArg(args, count, 3, *new[0], 512) < 0 {
        return ValError(ERR_VALUE)
    }
    start = CoerceNumber(*args[1])
    n = CoerceNumber(*args[2])
    len = cast(s32)TextLength(*text[0])
    if start < 1 || n < 0 {
        return ValError(ERR_VALUE)
    }
    MemoryCopy(cast(*void)(*out[0]), cast(*void)(*text[0]), cast(u64)(ifx (TruncateToS32(start) - 1) < len then (TruncateToS32(start) - 1) else len))
    out[ifx (TruncateToS32(start) - 1) < len then (TruncateToS32(start) - 1) else len] = 0
    TextAppend(*out[0], *new[0])
    if (TruncateToS32(start) - 1 + TruncateToS32(n)) < len {
        TextAppend(*out[0], *text[TruncateToS32(start) - 1 + TruncateToS32(n)])
    }
    return ValString(wb_strdup(*out[0]))
}

FnFixed :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    decimals: float64 = 2
    commas: float64 = 1
    v: float64 = 0
    out: [512]s8
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    v = CoerceNumber(*args[0])
    if count >= 2 {
        if args[1].kind == VAL_ERROR {
            return ValError(args[1].err)
        }
        decimals = CoerceNumber(*args[1])
    }
    if count >= 3 {
        if args[2].kind == VAL_ERROR {
            return ValError(args[2].err)
        }
        commas = CoerceNumber(*args[2])
    }
    if decimals < 0 {
        decimals = 0
    }
    if decimals > 30 {
        decimals = 30
    }
    FormatWithPattern(v, ifx commas != 0 then CText("#,##0.000000") else CText("0.000000"), *out[0], 512)
    return ValString(wb_strdup(*out[0]))
}

ConvertRadix :: (value: s64, from_base: s32, to_base: s32, out: *s8, cap: s32) -> s32 {
    digits: *s8 = CText("0123456789ABCDEF")
    buf: [80]s8
    n: s32 = 0
    negative: s32 = cast(s32)(value < 0)
    uv: u64 = 0
    if negative != 0 {
        uv = cast(u64)(-value)
    } else {
        uv = cast(u64)value
    }
    if value == 0 {
        FormatText(out, cast(u64)cap, CText("0"))
        return 1
    }
    while uv != 0 && n < 70 {
        buf[n] = digits[uv % cast(u64)to_base]
        uv /= cast(u64)to_base
        n += 1
    }
    if negative != 0 && n < 70 {
        buf[n] = 45
        n += 1
    }
    i: s32 = n - 1
    w: s32 = 0
    while i >= 0 && (w + 1) < cap {
        out[w] = buf[i]
        w += 1
        i -= 1
    }
    out[w] = 0
    return 1
}

CharToDigit :: (ch: s32) -> s32 {
    if ch >= 48 && ch <= 57 {
        return ch - 48
    }
    if ch >= 97 && ch <= 102 {
        return ch - 97 + 10
    }
    if ch >= 65 && ch <= 70 {
        return ch - 65 + 10
    }
    return -1
}

ParseRadix :: (text: *s8, base: s32) -> float64 {
    value: s64 = 0
    i: s32 = 0
    if text[0] == 0 {
        return 1e308
    }
    while text[i] != 0 {
        d: s32 = CharToDigit(cast(s32)(cast(u8)text[i]))
        if d < 0 || d >= base {
            return 1e308
        }
        value = value * cast(s64)base + cast(s64)d
        i += 1
    }
    return cast(float64)value
}

FnRadixConvert :: (st: *EvalState, args: *Val, count: s32, marks: *s32, to_base: s32) -> Val {
    text: [512]s8
    out: [80]s8
    v: float64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 0, *text[0], 512) < 0 {
        return ValError(ERR_VALUE)
    }
    v = ParseRadix(*text[0], 10)
    if v >= 1e307 {
        return ValError(ERR_NUM)
    }
    ConvertRadix(TruncateToS64(v), 10, to_base, *out[0], 80)
    return ValString(wb_strdup(*out[0]))
}

FnRadixParse :: (st: *EvalState, args: *Val, count: s32, marks: *s32, from_base: s32) -> Val {
    text: [512]s8
    v: float64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 0, *text[0], 512) < 0 {
        return ValError(ERR_VALUE)
    }
    v = ParseRadix(*text[0], from_base)
    if v >= 1e307 {
        return ValError(ERR_NUM)
    }
    return ValNumber(v)
}

IsLeapYear :: (y: s32) -> s32 {
    return cast(s32)(((y % 4) == 0 && (y % 100) != 0) || (y % 400) == 0)
}

DaysInYear :: (y: s32) -> s32 {
    if IsLeapYear(y) != 0 {
        return 366
    }
    return 365
}

SerialToYmd :: (serial: s32, y: *s32, m: *s32, d: *s32) {
    CivilFromDays(serial + SerialEpoch(), y, m, d)
}

YmdToSerial :: (y: s32, m: s32, d: s32) -> s32 {
    return DaysFromCivil(y, m, d) - SerialEpoch()
}

MonthAdd :: (y: s32, m: s32, months: s32, out_y: *s32, out_m: *s32) {
    total: s32 = y * 12 + (m - 1) + months
    out_y[0] = total / 12
    out_m[0] = total % 12 + 1
}

DaysInMonthGo :: (y: s32, m: s32) -> s32 {
    if m == 4 || m == 6 || m == 9 || m == 11 {
        return 30
    }
    if m == 2 {
        if IsLeapYear(y) != 0 {
            return 29
        }
        return 28
    }
    return 31
}

IsLastOfMonth :: (y: s32, m: s32, d: s32) -> s32 {
    if d == DaysInMonthGo(y, m) {
        return 1
    }
    return 0
}

Days30_360 :: (s1: s32, s2: s32) -> s32 {
    y1: s32 = 0
    m1: s32 = 0
    d1: s32 = 0
    y2: s32 = 0
    m2: s32 = 0
    d2: s32 = 0
    SerialToYmd(s1, *y1, *m1, *d1)
    SerialToYmd(s2, *y2, *m2, *d2)
    if d1 == d2 && m1 == m2 && y1 == y2 {
        return 0
    }
    if d1 == 31 {
        d1 = 30
    }
    if d2 == 31 && d1 == 30 {
        d2 = 30
    }
    if m1 == 2 && IsLastOfMonth(y1, m1, d1) != 0 {
        if m2 == 2 && IsLastOfMonth(y2, m2, d2) != 0 {
            d2 = 30
        }
        d1 = 30
    }
    return (y2 - y1) * 360 + (m2 - m1) * 30 + (d2 - d1)
}

Days30E :: (s1: s32, s2: s32) -> s32 {
    y1: s32 = 0
    m1: s32 = 0
    d1: s32 = 0
    y2: s32 = 0
    m2: s32 = 0
    d2: s32 = 0
    SerialToYmd(s1, *y1, *m1, *d1)
    SerialToYmd(s2, *y2, *m2, *d2)
    if d1 == 31 {
        d1 = 30
    }
    if d2 == 31 {
        d2 = 30
    }
    return (y2 - y1) * 360 + (m2 - m1) * 30 + (d2 - d1)
}

BasisDaysBetween :: (s1: s32, s2: s32, basis: s32) -> s32 {
    sign: s32 = 1
    f: s32 = s1
    t: s32 = s2
    if f > t {
        sign = -1
        f = s2
        t = s1
    }
    if basis == 1 || basis == 2 || basis == 3 {
        return sign * (t - f)
    }
    if basis == 4 {
        return sign * Days30E(f, t)
    }
    return sign * Days30_360(f, t)
}

AddMonthsSerial :: (serial: s32, n: s32) -> s32 {
    y: s32 = 0
    m: s32 = 0
    d: s32 = 0
    ny: s32 = 0
    nm: s32 = 0
    SerialToYmd(serial, *y, *m, *d)
    MonthAdd(y, m, n, *ny, *nm)
    nd: s32 = d
    if nd > DaysInMonthGo(ny, nm) {
        nd = DaysInMonthGo(ny, nm)
    }
    return YmdToSerial(ny, nm, nd)
}

AddYearsSerial :: (serial: s32, n: s32) -> s32 {
    y: s32 = 0
    m: s32 = 0
    d: s32 = 0
    SerialToYmd(serial, *y, *m, *d)
    nd: s32 = d
    if m == 2 && nd == 29 && IsLeapYear(y + n) == 0 {
        nd = 28
    }
    return YmdToSerial(y + n, m, nd)
}

YearFracBasis :: (s1: s32, s2: s32, basis: s32) -> float64 {
    from_s: s32 = s1
    to_s: s32 = s2
    days: s32 = BasisDaysBetween(from_s, to_s, basis)
    if days < 0 {
        from_s = s2
        to_s = s1
        days = -days
    }
    if basis == 1 {
        y1: s32 = 0
        m1: s32 = 0
        d1: s32 = 0
        y2: s32 = 0
        m2: s32 = 0
        d2: s32 = 0
        SerialToYmd(from_s, *y1, *m1, *d1)
        SerialToYmd(to_s, *y2, *m2, *d2)
        plus1: s32 = AddYearsSerial(from_s, 1)
        feb29s: s32 = 0
        years: s32 = 1
        if to_s > plus1 {
            years = y2 + 1 - y1
            j1: s32 = YmdToSerial(y1, 1, 1)
            j2: s32 = YmdToSerial(y2 + 1, 1, 1)
            feb29s = j2 - j1 - 365 * years
        } else {
            if (IsLeapYear(y1) != 0 && m1 < 3) || (IsLeapYear(y2) != 0 && (m2 * 256 + d2) >= (2 * 256 + 29)) {
                feb29s = 1
            } else {
                feb29s = 0
            }
        }
        peryear: float64 = 365 + cast(float64)feb29s / cast(float64)years
        return cast(float64)days / peryear
    }
    if basis == 3 {
        return cast(float64)days / 365.0
    }
    return cast(float64)days / 360.0
}

ArgAt :: (args: *Val, count: s32, index: s32, fallback: float64) -> float64 {
    if index >= count {
        return fallback
    }
    if args[index].kind == VAL_ERROR {
        return 1e308
    }
    n: float64 = CoerceNumber(*args[index])
    return n
}

ArgAtInt :: (args: *Val, count: s32, index: s32, fallback: s32) -> s32 {
    v: float64 = ArgAt(args, count, index, cast(float64)fallback)
    if v >= 1e307 {
        return fallback
    }
    return TruncateToS32(v)
}

ArgDate :: (args: *Val, count: s32, index: s32, fallback: s32) -> s32 {
    v: float64 = ArgAt(args, count, index, cast(float64)fallback)
    if v >= 1e307 {
        return fallback
    }
    return TruncateToS32(v)
}

ArgBasis :: (args: *Val, count: s32, index: s32) -> s32 {
    b: s32 = ArgAtInt(args, count, index, 0)
    if b < 0 || b > 4 {
        return -1
    }
    return b
}

FinPower :: (base: float64, e: float64) -> float64 {
    return Pow(base, e)
}

