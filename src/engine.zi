Utf8Advance :: (s: *s8, i: s32) -> s32 {
    b: s32 = cast(s32)(cast(u8)s[i])
    if b == 0 {
        return i
    }
    if b < 128 {
        return i + 1
    }
    if (b & 224) == 192 {
        return i + 2
    }
    if (b & 240) == 224 {
        return i + 3
    }
    if (b & 248) == 240 {
        return i + 4
    }
    return i + 1
}

FnNumbervalue :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    text: [512]s8
    norm: [512]s8
    sepbuf: [16]s8
    grpbuf: [16]s8
    sep: *s8 = CText(".")
    grp: *s8 = CText(",")
    i: s32 = 0
    n: s32 = 0
    start: s32 = 0
    end: *s8 = null
    v: float64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[0].kind == VAL_EMPTY || args[0].kind == VAL_FLOAT || args[0].kind == VAL_BOOL {
        return ValCopy(*args[0])
    }
    if count >= 2 {
        if args[1].kind == VAL_ERROR {
            return ValError(args[1].err)
        }
        CoerceText(*args[1], *sepbuf[0], 16)
        if TextLength(*sepbuf[0]) != 1 {
            return ValError(ERR_VALUE)
        }
        sep = *sepbuf[0]
    }
    if count >= 3 {
        if args[2].kind == VAL_ERROR {
            return ValError(args[2].err)
        }
        CoerceText(*args[2], *grpbuf[0], 16)
        if TextLength(*grpbuf[0]) != 1 {
            return ValError(ERR_VALUE)
        }
        grp = *grpbuf[0]
    }
    if TextCompare(sep, grp) == 0 {
        return ValError(ERR_VALUE)
    }
    CoerceText(*args[0], *text[0], 512)
    start = 0
    while text[start] == 32 || text[start] == 9 {
        start += 1
    }
    i = start
    n = 0
    while text[i] != 0 && n < 500 {
        c: s8 = text[i]
        if c == grp[0] {
            i += 1
            continue
        }
        if c == sep[0] {
            c = 46
        }
        norm[n] = c
        n += 1
        i += 1
    }
    while n > 0 && (norm[n - 1] == 32 || norm[n - 1] == 9) {
        n -= 1
    }
    norm[n] = 0
    if n == 0 {
        return ValError(ERR_VALUE)
    }
    v = ParseDouble(*norm[0], *end)
    if end == (*norm[0]) || end[0] != 0 {
        return ValError(ERR_VALUE)
    }
    return ValNumber(v)
}

FnAsc :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    text: [512]s8
    out: [512]s8
    n: s32 = 0
    i: s32 = 0
    w: [8]s8
    wl: s32 = 0
    extra: s32 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    CoerceText(*args[0], *text[0], 512)
    i = 0
    while text[i] != 0 && n < 500 {
        cp: s32 = Utf8Decode1(*text[i])
        i = Utf8Advance(*text[0], i)
        hc: s32 = AscMapHalf(cp, *extra)
        if extra != 0 && n < 499 {
            wl = Utf8Encode(extra, *w[0])
            MemoryCopy(cast(*void)(*out[n]), cast(*void)(*w[0]), cast(u64)wl)
            n += wl
        }
        wl = Utf8Encode(hc, *w[0])
        if (n + wl) > 500 {
            break
        }
        MemoryCopy(cast(*void)(*out[n]), cast(*void)(*w[0]), cast(u64)wl)
        n += wl
    }
    out[n] = 0
    return ValString(wb_strdup(*out[0]))
}

FnJis :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    text: [512]s8
    out: [512]s8
    n: s32 = 0
    i: s32 = 0
    w: [8]s8
    wl: s32 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    CoerceText(*args[0], *text[0], 512)
    i = 0
    while text[i] != 0 && n < 500 {
        cp: s32 = Utf8Decode1(*text[i])
        j: s32 = Utf8Advance(*text[0], i)
        fc: s32 = ifx text[j] != 0 then Utf8Decode1(*text[j]) else 0
        i = j
        fc2: s32 = JisMapFull(cp, fc)
        wl = Utf8Encode(fc2, *w[0])
        if (n + wl) > 500 {
            break
        }
        MemoryCopy(cast(*void)(*out[n]), cast(*void)(*w[0]), cast(u64)wl)
        n += wl
    }
    out[n] = 0
    return ValString(wb_strdup(*out[0]))
}

HdateMonthNameHeb :: (month: s32, out: *s8) {
    if month == 0 {
        FormatText(out, 64, CText("תִּשְׁרֵי"))
        return
    }
    if month == 1 {
        FormatText(out, 64, CText("חֶשְׁוׇן"))
        return
    }
    if month == 2 {
        FormatText(out, 64, CText("כִּסְלֵו"))
        return
    }
    if month == 3 {
        FormatText(out, 64, CText("טֵבֵת"))
        return
    }
    if month == 4 {
        FormatText(out, 64, CText("שְׁבׇט"))
        return
    }
    if month == 5 {
        FormatText(out, 64, CText("אַדׇר"))
        return
    }
    if month == 6 {
        FormatText(out, 64, CText("נִיסׇן"))
        return
    }
    if month == 7 {
        FormatText(out, 64, CText("אִיׇיר"))
        return
    }
    if month == 8 {
        FormatText(out, 64, CText("סִיוׇן"))
        return
    }
    if month == 9 {
        FormatText(out, 64, CText("תׇּמוּז"))
        return
    }
    if month == 10 {
        FormatText(out, 64, CText("אָב"))
        return
    }
    if month == 11 {
        FormatText(out, 64, CText("אֱלוּל"))
        return
    }
    if month == 12 {
        FormatText(out, 64, CText("אַדׇר א׳"))
        return
    }
    if month == 13 {
        FormatText(out, 64, CText("אַדׇר ב׳"))
        return
    }
    out[0] = 0
}

HdateAppendDigit :: (out: *s8, n: *s32, cp: s32) {
    w: [8]s8
    wl: s32 = Utf8Encode(cp, *w[0])
    MemoryCopy(cast(*void)(*out[n.*]), cast(*void)(*w[0]), cast(u64)wl)
    n.* += wl
}

HdateIntToHebrew :: (num: s32, out: *s8) {
    digs0: [10]s32
    digs1: [10]s32
    digs2: [5]s32
    buf: [128]s8
    bn: s32 = 0
    n: s32 = num
    chars: s32 = 0
    i: s32 = 0
    laststart: s32 = 0
    digs0[0] = 32
    digs0[1] = 0x5d0
    digs0[2] = 0x5d1
    digs0[3] = 0x5d2
    digs0[4] = 0x5d3
    digs0[5] = 0x5d4
    digs0[6] = 0x5d5
    digs0[7] = 0x5d6
    digs0[8] = 0x5d7
    digs0[9] = 0x5d8
    digs1[0] = 0x5d8
    digs1[1] = 0x5d9
    digs1[2] = 0x5db
    digs1[3] = 0x5dc
    digs1[4] = 0x5de
    digs1[5] = 0x5e0
    digs1[6] = 0x5e1
    digs1[7] = 0x5e2
    digs1[8] = 0x5e4
    digs1[9] = 0x5e6
    digs2[0] = 32
    digs2[1] = 0x5e7
    digs2[2] = 0x5e8
    digs2[3] = 0x5e9
    digs2[4] = 0x5ea
    out[0] = 0
    if n < 1 || n > 9999 {
        return
    }
    if n >= 1000 {
        HdateAppendDigit(*buf[0], *bn, digs0[n / 1000])
        n = n % 1000
    }
    while n >= 400 {
        HdateAppendDigit(*buf[0], *bn, digs2[4])
        n -= 400
    }
    if n >= 100 {
        HdateAppendDigit(*buf[0], *bn, digs2[n / 100])
        n = n % 100
    }
    if n >= 10 {
        if n == 15 || n == 16 {
            n -= 9
        }
        HdateAppendDigit(*buf[0], *bn, digs1[n / 10])
        n = n % 10
    }
    if n > 0 {
        HdateAppendDigit(*buf[0], *bn, digs0[n])
    }
    buf[bn] = 0
    chars = 0
    i = 0
    while buf[i] != 0 {
        if (cast(s32)buf[i] & 192) != 128 {
            chars += 1
        }
        i += 1
    }
    if chars < 2 {
        MemoryCopy(cast(*void)out, cast(*void)(*buf[0]), cast(u64)bn)
        out[bn] = 0
        HdateAppendDigit(out, *bn, 0x5f3)
        out[bn] = 0
        return
    }
    laststart = bn
    i = bn - 1
    while i >= 0 {
        if (cast(s32)buf[i] & 192) != 128 {
            laststart = i
            break
        }
        i -= 1
    }
    i = 0
    while i < laststart {
        out[i] = buf[i]
        i += 1
    }
    w2n: s32 = i
    HdateAppendDigit(out, *w2n, 0x5f4)
    i = laststart
    while buf[i] != 0 {
        out[w2n] = buf[i]
        w2n += 1
        i += 1
    }
    out[w2n] = 0
}

HdateBuildHeb :: (hyear: s32, hmonth: s32, hday: s32, out: *s8) {
    daybuf: [128]s8
    yearbuf: [128]s8
    mname: [64]s8
    HdateIntToHebrew(hday + 1, *daybuf[0])
    HdateMonthNameHeb(hmonth, *mname[0])
    HdateIntToHebrew(hyear, *yearbuf[0])
    FormatText(out, 512, CText("%s בְּ%s %s"), *daybuf[0], *mname[0], *yearbuf[0])
}

FnHdateHeb :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    y: s32 = 0
    m: s32 = 0
    d: s32 = 0
    jd: s32 = 0
    hy: s32 = 0
    hm: s32 = 0
    hd: s32 = 0
    out: [512]s8
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    if args[2].kind == VAL_ERROR {
        return ValError(args[2].err)
    }
    y = TruncateToS32(CoerceNumber(*args[0]))
    m = TruncateToS32(CoerceNumber(*args[1]))
    d = TruncateToS32(CoerceNumber(*args[2]))
    jd = HdateGdateToJd(d, m, y)
    HdateJdToHdate(jd, *hd, *hm, *hy)
    HdateBuildHeb(hy, hm, hd, *out[0])
    return ValString(wb_strdup(*out[0]))
}

FnDate2HdateHeb :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    serial: float64 = 0
    y: s32 = 0
    m: s32 = 0
    d: s32 = 0
    jd: s32 = 0
    hy: s32 = 0
    hm: s32 = 0
    hd: s32 = 0
    out: [512]s8
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    serial = CoerceNumber(*args[0])
    if serial < 1 {
        return ValError(ERR_NUM)
    }
    days2: s32 = TruncateToS32(serial)
    if days2 < 61 {
        days2 += 1
    }
    CivilFromDays(days2 + SerialEpoch(), *y, *m, *d)
    jd = HdateGdateToJd(d, m, y)
    HdateJdToHdate(jd, *hd, *hm, *hy)
    HdateBuildHeb(hy, hm, hd, *out[0])
    return ValString(wb_strdup(*out[0]))
}

FnCell :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    info: [64]s8
    letters: [8]s8
    out: [128]s8
    ref: SlotRef
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    CoerceText(*args[0], *info[0], 64)
    ref = st.call_refs[1]
    if ref.kind == 0 {
        return ValError(ERR_VALUE)
    }
    if TextCompareFoldLiteral(*info[0], "address") == 0 || TextCompareFoldLiteral(*info[0], "coord") == 0 {
        FormulaColName(ref.col, *letters[0])
        FormatText(*out[0], 128, CText("$%s$%d"), *letters[0], ref.row + 1)
        return ValString(wb_strdup(*out[0]))
    }
    if TextCompareFoldLiteral(*info[0], "sheetname") == 0 {
        FormatText(*out[0], 128, CText("%s"), *st.sheet.name[0])
        return ValString(wb_strdup(*out[0]))
    }
    if TextCompareFoldLiteral(*info[0], "col") == 0 || TextCompareFoldLiteral(*info[0], "column") == 0 {
        return ValNumber(cast(float64)(ref.col + 1))
    }
    if TextCompareFoldLiteral(*info[0], "row") == 0 {
        return ValNumber(cast(float64)(ref.row + 1))
    }
    if TextCompareFoldLiteral(*info[0], "color") == 0 {
        return ValNumber(0)
    }
    if TextCompareFoldLiteral(*info[0], "contents") == 0 || TextCompareFoldLiteral(*info[0], "value") == 0 {
        return ValCopy(*args[1])
    }
    if TextCompareFoldLiteral(*info[0], "filename") == 0 {
        return ValString(wb_strdup(CText("")))
    }
    if TextCompareFoldLiteral(*info[0], "format") == 0 {
        return ValString(wb_strdup(CText("G")))
    }
    if TextCompareFoldLiteral(*info[0], "parentheses") == 0 {
        return ValNumber(0)
    }
    if TextCompareFoldLiteral(*info[0], "prefix") == 0 || TextCompareFoldLiteral(*info[0], "prefixcharacter") == 0 {
        if args[1].kind == VAL_STRING {
            return ValString(wb_strdup(CText("'")))
        }
        return ValString(wb_strdup(CText("")))
    }
    if TextCompareFoldLiteral(*info[0], "locked") == 0 || TextCompareFoldLiteral(*info[0], "protect") == 0 {
        return ValNumber(1)
    }
    if TextCompareFoldLiteral(*info[0], "type") == 0 || TextCompareFoldLiteral(*info[0], "datatype") == 0 || TextCompareFoldLiteral(*info[0], "formulatype") == 0 {
        if args[1].kind == VAL_EMPTY {
            return ValString(wb_strdup(CText("b")))
        }
        if args[1].kind == VAL_STRING {
            return ValString(wb_strdup(CText("l")))
        }
        return ValString(wb_strdup(CText("v")))
    }
    if TextCompareFoldLiteral(*info[0], "width") == 0 || TextCompareFoldLiteral(*info[0], "columnwidth") == 0 {
        return ValNumber(8)
    }
    return ValError(ERR_VALUE)
}

Random01 :: () -> float64 {
    RNG_NEXT = RNG_NEXT * 6364136223846793005 + 1442695040888963407
    v: u64 = (RNG_NEXT >> 11) & 0x1fffffffffffff
    return cast(float64)v / 9007199254740992.0
}

RandomUniformInt :: (lo: s32, hi: s32) -> s32 {
    if hi <= lo {
        return lo
    }
    r: float64 = Random01()
    return lo + TruncateToS32(r * cast(float64)(hi - lo + 1))
}

FnRandGen :: (st: *EvalState, args: *Val, count: s32, marks: *s32, which: s32) -> Val {
    a: float64 = 0
    b: float64 = 0
    u: float64 = 0
    i: s32 = 0
    if which == 0 {
        return ValNumber(Random01())
    }
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    a = CoerceNumber(*args[0])
    if which == 1 {
        if count < 2 {
            return ValError(ERR_VALUE)
        }
        if args[1].kind == VAL_ERROR {
            return ValError(args[1].err)
        }
        b = CoerceNumber(*args[1])
        if a > b {
            return ValError(ERR_NUM)
        }
        return ValNumber(a + Random01() * (b - a))
    }
    if which == 2 {
        if count < 2 {
            return ValError(ERR_VALUE)
        }
        if args[1].kind == VAL_ERROR {
            return ValError(args[1].err)
        }
        b = CoerceNumber(*args[1])
        if a > b {
            return ValError(ERR_NUM)
        }
        lo2: s32 = TruncateToS32(Ceil(a))
        hi2: s32 = TruncateToS32(Floor(b))
        return ValNumber(cast(float64)RandomUniformInt(lo2, hi2))
    }
    u = Random01()
    if which == 3 {
        return ValNumber(qnorm(u, 0, 1, 1, 0))
    }
    if which == 4 {
        return ValNumber(a + (0 - Log1p(0 - u)))
    }
    if which == 5 {
        return ValNumber(a + Sqrt(0 - 2 * Log1p(0 - u)))
    }
    if which == 6 {
        return ValNumber(qchisq(u, a, 1, 0))
    }
    if which == 7 {
        return ValNumber(qt(u, a, 1, 0))
    }
    if which == 8 {
        return ValNumber(qf(u, a, ifx b < 1 then 1 else b, 1, 0))
    }
    if which == 9 {
        return ValNumber(qgamma(u, a, 1, 1, 0))
    }
    if which == 10 {
        return ValNumber(qbeta(u, a, ifx b < 1 then 1 else b, 1, 0))
    }
    if which == 11 {
        return ValNumber(qbinom(u, a, ifx b < 0 then 0 else b, 1, 0))
    }
    if which == 12 {
        v2: float64 = Random01()
        z2: float64 = Sqrt(0 - 2 * Log1p(0 - u))
        z2 = z2 * Cos(6.283185307179586 * v2) + Log(a)
        return ValNumber(z2)
    }
    if which == 13 {
        v3: float64 = 0 - Log1p(0 - u) / a
        return ValNumber(ifx v3 <= 1 then v3 else (1 / v3))
    }
    if which == 14 {
        return ValNumber(0 - a * Log1p(0 - u))
    }
    if which == 15 {
        return ValNumber(Pow(0 - Log1p(0 - u), 1 / a))
    }
    if which == 16 {
        return ValNumber(qnorm(u, 0, 1, 1, 0) + b * Fabs(qnorm(Random01(), 0, 1, 1, 0)))
    }
    if which == 17 {
        return ValNumber(ifx (a - RandomLandauPdf(0)) > 0 then (a + u) else a)
    }
    if which == 18 {
        return ValNumber(a + b * qnorm(u, 0, 1, 1, 0))
    }
    if which == 19 {
        return ValNumber(a - b * Log1p(0 - u) * cast(float64)(ifx u < 0.5 then 1 else (-1)))
    }
    if which == 20 {
        k3: s32 = 0
        cum3: float64 = 0
        while k3 < 10000 {
            if (cum3 + a * Pow(1 - a, cast(float64)k3)) > u {
                break
            }
            cum3 += a * Pow(1 - a, cast(float64)k3)
            k3 += 1
        }
        return ValNumber(cast(float64)k3)
    }
    if which == 21 {
        k4: s32 = 0
        cum4: float64 = 0
        term4: float64 = Exp(0 - a)
        while k4 < 10000 {
            if (cum4 + term4) > u {
                break
            }
            cum4 += term4
            k4 += 1
            term4 *= a / cast(float64)k4
        }
        return ValNumber(cast(float64)k4)
    }
    if which == 22 {
        v4: float64 = Random01()
        return ValNumber(a + Pow(0 - Log1p(0 - u), 1 / b) * Cos(3.14159265358979323846 * v4))
    }
    if which == 23 {
        return ValNumber(qnorm(u, 0, 1, 1, 0) / (1 - 0.2 * 0))
    }
    if which == 24 {
        z3: float64 = qnorm(u, 0, 1, 1, 0)
        return ValNumber(z3 / Sqrt(qchisq(Random01(), ifx b < 1 then 1 else b, 1, 0) / (ifx b < 1 then 1 else b)))
    }
    if which == 26 {
        v5: float64 = a + Sqrt(0 - 2 * Log1p(0 - u)) * Cos(6.283185307179586 * Random01())
        return ValNumber(v5)
    }
    if which == 27 {
        return ValNumber(a * Pow(1 / u - 1, 1 / (ifx b < 1 then 1 else b)))
    }
    if which == 28 {
        return ValNumber(0 - Log1p(0 - u) / a)
    }
    if which == 29 {
        return ValNumber(a * Pow(0 - Log1p(0 - u * (1 - Exp(0 - 1 / a))) * a, b))
    }
    if which == 30 {
        return ValNumber(0 - a * Log1p(0 - u) * cast(float64)(ifx u < 0.5 then 1 else (-1)))
    }
    if which == 31 {
        return ValNumber(a / Pow(u, 1 / (ifx b < 1 then 1 else b)) - 1)
    }
    if which == 32 {
        u2x: float64 = Sqrt(0 - 2 * Log1p(0 - u))
        return ValNumber(a + u2x)
    }
    if which == 33 {
        return ValNumber(qbinom(u, ifx b < 1 then 1 else b, a, 1, 0))
    }
    if which == 34 {
        uu: float64 = Random01()
        if uu < a {
            return ValNumber(0)
        }
        return ValNumber(1)
    }
    return ValNumber(u)
}

RandomBernoulliPdf :: (k: float64, p: float64) -> float64 {
    if k == 0 {
        return 1 - p
    }
    if k == 1 {
        return p
    }
    return 0
}

RandomLaplacePdf :: (x: float64, a: float64) -> float64 {
    return (1 / (2 * a)) * Exp(0 - Fabs(x) / a)
}

RandomParetoPdf :: (x: float64, a: float64, b: float64) -> float64 {
    if x >= b {
        return (a / b) / Pow(x / b, a + 1)
    }
    return 0
}

RandomRayleighTailPdf :: (x: float64, a: float64, sigma: float64) -> float64 {
    u: float64 = 0
    v: float64 = 0
    if x < a {
        return 0
    }
    u = x / sigma
    v = a / sigma
    return (u / sigma) * Exp(((v + u) * (v - u)) / 2)
}

RandomExppowPdf :: (x: float64, a: float64, b: float64) -> float64 {
    lngamma: float64 = lgamma1p_raw(1 / b)
    return (1 / (2 * a)) * Exp(0 - Pow(Fabs(x / a), b) - lngamma)
}

DRayleighGo :: (x: float64, scale: float64) -> float64 {
    p: float64 = 0
    if scale <= 0 {
        return 0.0 / 0.0
    }
    if x <= 0 {
        return 0
    }
    p = dnorm_go(x, 0, scale, 0)
    return ((p * x) / scale) * 2.50662827463100050241576528481104525
}

RandomLandauPdf :: (x: float64) -> float64 {
    P1: [5]float64 = .[0.4259894875, -0.1249762550, 0.03984243700, -0.006298287635, 0.001511162253]
    P2: [5]float64 = .[0.1788541609, 0.1173957403, 0.01488850518, -0.001394989411, 0.0001283617211]
    P3: [5]float64 = .[0.1788544503, 0.09359161662, 0.006325387654, 0.00006611667319, -0.000002031049101]
    P4: [5]float64 = .[0.9874054407, 118.6723273, 849.2794360, -743.7792444, 427.0262186]
    P5: [5]float64 = .[1.003675074, 167.5702434, 4789.711289, 21217.86767, -22324.94910]
    P6: [5]float64 = .[1.000827619, 664.9143136, 62972.92665, 475554.6998, -5743609.109]
    Q1: [5]float64 = .[1.0, -0.3388260629, 0.09594393323, -0.01608042283, 0.003778942063]
    Q2: [5]float64 = .[1.0, 0.7428795082, 0.3153932961, 0.06694219548, 0.008790609714]
    Q3: [5]float64 = .[1.0, 0.6097809921, 0.2560616665, 0.04746722384, 0.006957301675]
    Q4: [5]float64 = .[1.0, 106.8615961, 337.6496214, 2016.712389, 1597.063511]
    Q5: [5]float64 = .[1.0, 156.9424537, 3745.310488, 9834.698876, 66924.28357]
    Q6: [5]float64 = .[1.0, 651.4101098, 56974.73333, 165917.4725, -2815759.939]
    A1: [3]float64 = .[0.04166666667, -0.01996527778, 0.02709538966]
    A2: [2]float64 = .[-1.845568670, -4.284640743]
    u: float64 = 0
    v: float64 = x
    denlan: float64 = 0
    if v < -5.5 {
        u = Exp(v + 1)
        denlan = 0.3989422803 * (Exp(-1 / u) / Sqrt(u)) * (1 + (A1[0] + (A1[1] + A1[2] * u) * u) * u)
    } else if v < -1 {
        u = Exp(0 - v - 1)
        denlan = (Exp(0 - u) * Sqrt(u) * (P1[0] + (P1[1] + (P1[2] + (P1[3] + P1[4] * v) * v) * v) * v)) / (Q1[0] + (Q1[1] + (Q1[2] + (Q1[3] + Q1[4] * v) * v) * v) * v)
    } else if v < 1 {
        denlan = (P2[0] + (P2[1] + (P2[2] + (P2[3] + P2[4] * v) * v) * v) * v) / (Q2[0] + (Q2[1] + (Q2[2] + (Q2[3] + Q2[4] * v) * v) * v) * v)
    } else if v < 5 {
        denlan = (P3[0] + (P3[1] + (P3[2] + (P3[3] + P3[4] * v) * v) * v) * v) / (Q3[0] + (Q3[1] + (Q3[2] + (Q3[3] + Q3[4] * v) * v) * v) * v)
    } else if v < 12 {
        u = 1 / v
        denlan = (u * u * (P4[0] + (P4[1] + (P4[2] + (P4[3] + P4[4] * u) * u) * u) * u)) / (Q4[0] + (Q4[1] + (Q4[2] + (Q4[3] + Q4[4] * u) * u) * u) * u)
    } else if v < 50 {
        u = 1 / v
        denlan = (u * u * (P5[0] + (P5[1] + (P5[2] + (P5[3] + P5[4] * u) * u) * u) * u)) / (Q5[0] + (Q5[1] + (Q5[2] + (Q5[3] + Q5[4] * u) * u) * u) * u)
    } else if v < 300 {
        u = 1 / v
        denlan = (u * u * (P6[0] + (P6[1] + (P6[2] + (P6[3] + P6[4] * u) * u) * u) * u)) / (Q6[0] + (Q6[1] + (Q6[2] + (Q6[3] + Q6[4] * u) * u) * u) * u)
    } else {
        u = 1 / (v - (v * Log(v)) / (v + 1))
        denlan = u * u * (1 + (A2[0] + A2[1] * u) * u)
    }
    return denlan
}

Pnorm2 :: (x1: float64, x2: float64) -> float64 {
    if x1 != x1 || x2 != x2 {
        return 0.0 / 0.0
    }
    if x1 > x2 {
        return 0 - Pnorm2(x2, x1)
    }
    if x1 == x2 {
        return 0.0
    }
    if x1 == (-1e308 * 10) {
        return pnorm(x2, 0, 1, 1, 0)
    }
    if x2 == (1e308 * 10) {
        return pnorm(x1, 0, 1, 0, 0)
    }
    if x1 == 0 {
        return Erf(x2 / 1.414213562373095048801688724209) / 2
    }
    if x2 == 0 {
        return Erf(x1 / -1.414213562373095048801688724209) / 2
    }
    if x1 <= 0 && x2 >= 0 {
        mn: float64 = ifx (0 - x1) < x2 then (0 - x1) else x2
        mx: float64 = ifx (0 - x1) < x2 then x2 else (0 - x1)
        p1: float64 = Pnorm2(0, mn)
        p2: float64 = Pnorm2(mn, mx)
        return 2 * p1 + p2
    } else if x1 < 0 {
        return Pnorm2(0 - x2, 0 - x1)
    }
    p1c: float64 = pnorm(x1, 0, 1, 0, 0)
    p2c: float64 = pnorm(x2, 0, 1, 0, 0)
    raw: float64 = p1c - p2c
    if (Fabs(p1c - p2c) * 32) > Fabs(p1c + p2c) {
        return raw
    }
    dx: float64 = x2 - x1
    d1: float64 = dnorm_go(x1, 0, 1, 0)
    d2: float64 = dnorm_go(x2, 0, 1, 0)
    ub: float64 = dx * d1
    lb: float64 = dx * d2
    if raw < lb {
        raw = lb
    }
    if raw > ub {
        raw = ub
    }
    return raw
}

FnDensity2 :: (st: *EvalState, args: *Val, count: s32, marks: *s32, which: s32) -> Val {
    x: float64 = 0
    a: float64 = 0
    b: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    x = CoerceNumber(*args[0])
    a = CoerceNumber(*args[1])
    if which == 0 {
        if a <= 0 {
            return ValError(ERR_NUM)
        }
        return ValNumber(RandomLaplacePdf(x, a))
    }
    if which == 1 {
        if count < 3 {
            return ValError(ERR_VALUE)
        }
        if args[2].kind == VAL_ERROR {
            return ValError(args[2].err)
        }
        b = CoerceNumber(*args[2])
        if a <= 0 || b <= 0 {
            return ValError(ERR_NUM)
        }
        return ValNumber(RandomParetoPdf(x, a, b))
    }
    if which == 2 {
        if count < 3 {
            return ValError(ERR_VALUE)
        }
        if args[2].kind == VAL_ERROR {
            return ValError(args[2].err)
        }
        b = CoerceNumber(*args[2])
        if b <= 0 {
            return ValError(ERR_NUM)
        }
        return ValNumber(RandomRayleighTailPdf(x, a, b))
    }
    if which == 3 {
        if count < 3 {
            return ValError(ERR_VALUE)
        }
        if args[2].kind == VAL_ERROR {
            return ValError(args[2].err)
        }
        b = CoerceNumber(*args[2])
        return ValNumber(RandomExppowPdf(x, a, b))
    }
    return ValNumber(0)
}

RangeIncreasing :: (xs: *float64, n: s32) -> s32 {
    i: s32 = 1
    while i < n {
        if xs[i] <= xs[i - 1] {
            return 0
        }
        i += 1
    }
    return 1
}

CSplineInit :: (sp: *CSpline, x: *float64, y: *float64, n: s32) -> s32 {
    d1: [64]float64
    d2: [64]float64
    d3: [64]float64
    d4: [64]float64
    dx1: float64 = 0
    dy1: float64 = 0
    dx2: float64 = 0
    dy2: float64 = 0
    h: float64 = 0
    nm1: s32 = 0
    nm2: s32 = 0
    i: s32 = 0
    j: s32 = 0
    first: s32 = 0
    last: s32 = 0
    if n < 3 || n > 64 {
        return 0
    }
    if RangeIncreasing(x, n) == 0 {
        return 0
    }
    nm1 = n - 1
    nm2 = n - 2
    sp.n = n
    i = 0
    while i < n {
        sp.x[i] = x[i]
        sp.y[i] = y[i]
        i += 1
    }
    dx1 = x[1] - x[0]
    dy1 = ((y[1] - y[0]) / dx1) * 3
    i = 1
    while i <= nm2 {
        dx2 = x[i + 1] - x[i]
        dy2 = ((y[i + 1] - y[i]) / dx2) * 3
        d1[i] = dx1
        d2[i] = 2 * (dx1 + dx2)
        d3[i] = dx2
        d4[i] = dy2 - dy1
        dx1 = dx2
        dy1 = dy2
        i += 1
    }
    first = 2
    last = nm2
    i = first
    while i <= last {
        d1[i] = d1[i] / d2[i - 1]
        d2[i] = d2[i] - d1[i] * d3[i - 1]
        d4[i] = d4[i] - d1[i] * d4[i - 1]
        i += 1
    }
    d4[last] = d4[last] / d2[last]
    j = last - 1
    while j >= (first - 1) {
        d4[j] = (d4[j] - d3[j] * d4[j + 1]) / d2[j]
        j -= 1
    }
    d4[0] = 0.0
    d4[nm1] = 0.0
    i = 0
    while i < nm1 {
        h = x[i + 1] - x[i]
        sp.a[i] = (d4[i + 1] - d4[i]) / (3 * h)
        sp.b[i] = d4[i]
        sp.c[i] = (y[i + 1] - y[i]) / h - ((2 * d4[i] + d4[i + 1]) * h) / 3
        i += 1
    }
    return 1
}

CSplineValue :: (sp: *CSpline, xv: float64) -> float64 {
    dx: float64 = 0
    n: s32 = 0
    j: s32 = 0
    k: s32 = 0
    n = sp.n - 2
    if xv >= sp.x[n] {
        dx = xv - sp.x[n]
        return sp.y[n] + dx * (sp.c[n] + dx * (sp.b[n] + dx * sp.a[n]))
    }
    if xv <= sp.x[1] {
        dx = xv - sp.x[0]
        return sp.y[0] + dx * (sp.c[0] + dx * (sp.b[0] + dx * sp.a[0]))
    }
    j = 1
    while n > (j + 1) {
        k = (n + j) / 2
        if xv > sp.x[k] {
            j = k
        } else {
            n = k
        }
    }
    dx = xv - sp.x[j]
    return sp.y[j] + dx * (sp.c[j] + dx * (sp.b[j] + dx * sp.a[j]))
}

CSplineIntegrals :: (sp: *CSpline, x: *float64, n: s32, res: *float64) -> s32 {
    start: float64 = 0
    end: float64 = 0
    sum: float64 = 0
    i: s32 = 0
    j: s32 = 0
    k: s32 = 0
    jmax: s32 = 0
    if n <= 1 || RangeIncreasing(x, n) == 0 {
        return 0
    }
    j = 1
    jmax = sp.n - 1
    start = x[0]
    i = 1
    while i < n {
        sum = 0
        end = x[i]
        while start >= sp.x[j] {
            j += 1
        }
        k = ifx j > 1 then (j - 1) else 0
        start -= sp.x[k]
        sum = 0 - start * (sp.y[k] + start * (sp.c[k] / 2 + start * (sp.b[k] / 3 + (start * sp.a[k]) / 4)))
        while j < jmax && end > sp.x[j] {
            start = sp.x[j] - sp.x[k]
            sum += start * (sp.y[k] + start * (sp.c[k] / 2 + start * (sp.b[k] / 3 + (start * sp.a[k]) / 4)))
            start = sp.x[j]
            j += 1
            k = j - 1
        }
        start = end - sp.x[k]
        sum += start * (sp.y[k] + start * (sp.c[k] / 2 + start * (sp.b[k] / 3 + (start * sp.a[k]) / 4)))
        res[i - 1] = sum
        start = end
        i += 1
    }
    return 1
}

LinearInterp :: (absc: *float64, ord: *float64, nb_knots: s32, targets: *float64, nb_targets: s32, res: *float64) -> s32 {
    j: s32 = 0
    k: s32 = 0
    l: s32 = 0
    i: s32 = 0
    slope: float64 = 0
    jmax: s32 = nb_knots - 1
    if nb_knots < 2 {
        return 0
    }
    if RangeIncreasing(targets, nb_targets) != 0 {
        j = 1
        k = 0
        slope = (ord[1] - ord[0]) / (absc[1] - absc[0])
        i = 0
        while i < nb_targets {
            while j < jmax && targets[i] > absc[j] {
                j += 1
            }
            if k < (j - 1) {
                k = j - 1
                slope = (ord[j] - ord[k]) / (absc[j] - absc[k])
            }
            res[i] = (targets[i] - absc[k]) * slope + ord[k]
            i += 1
        }
    } else {
        i = 0
        while i < nb_targets {
            k = jmax - 1
            if targets[i] >= absc[k] {
                res[i] = ((targets[i] - absc[k]) * (ord[jmax] - ord[k])) / (absc[jmax] - absc[k]) + ord[k]
            } else if targets[i] <= absc[1] {
                res[i] = ((targets[i] - absc[0]) * (ord[1] - ord[0])) / (absc[1] - absc[0]) + ord[0]
            } else {
                j = 1
                while k > (j + 1) {
                    l = (k + j) / 2
                    if targets[i] > absc[l] {
                        j = l
                    } else {
                        k = l
                    }
                }
                res[i] = ((targets[i] - absc[j]) * (ord[k] - ord[j])) / (absc[k] - absc[j]) + ord[j]
            }
            i += 1
        }
    }
    return 1
}

LinearAveraging :: (absc: *float64, ord: *float64, nb_knots: s32, targets: *float64, nb_targets: s32, res: *float64) -> s32 {
    j: s32 = 0
    k: s32 = 0
    i: s32 = 0
    jmax: s32 = nb_knots - 1
    slope: float64 = 0
    x0: float64 = 0
    x1: float64 = 0
    if nb_knots < 2 || RangeIncreasing(targets, nb_targets + 1) == 0 {
        return 0
    }
    j = 1
    while j < jmax && targets[0] > absc[j] {
        j += 1
    }
    k = j - 1
    slope = ((ord[j] - ord[k]) / (absc[j] - absc[k])) / 2
    i = 1
    while i <= nb_targets {
        if targets[i] < absc[j] || j == jmax {
            x0 = targets[i - 1] - absc[k]
            x1 = targets[i] - absc[k]
            res[i - 1] = (x1 * (slope * x1 + ord[k]) - x0 * (slope * x0 + ord[k])) / (x1 - x0)
            i += 1
            continue
        }
        x0 = targets[i - 1] - absc[k]
        x1 = absc[j] - absc[k]
        res[i - 1] = x1 * (slope * x1 + ord[k]) - x0 * (slope * x0 + ord[k])
        while j < jmax && targets[i] > absc[j + 1] {
            j += 1
            k += 1
            x0 = absc[j] - absc[k]
            slope = ((ord[j] - ord[k]) / x0) / 2
            res[i - 1] += x0 * (slope * x0 + ord[k])
        }
        if j > (k + 1) {
            k = j - 1
            slope = ((ord[j] - ord[k]) / (absc[j] - absc[k])) / 2
        } else {
            k = j
        }
        x0 = targets[i] - absc[k]
        res[i - 1] += x0 * (slope * x0 + ord[k])
        res[i - 1] /= targets[i] - targets[i - 1]
        i += 1
    }
    return 1
}

StaircaseInterp :: (absc: *float64, ord: *float64, nb_knots: s32, targets: *float64, nb_targets: s32, res: *float64) -> s32 {
    j: s32 = 0
    k: s32 = 0
    l: s32 = 0
    i: s32 = 0
    jmax: s32 = nb_knots - 1
    if nb_knots <= 0 {
        return 0
    }
    if RangeIncreasing(targets, nb_targets) != 0 {
        j = 1
        i = 0
        while i < nb_targets {
            while j <= jmax && targets[i] >= absc[j] {
                j += 1
            }
            res[i] = ord[j - 1]
            i += 1
        }
    } else {
        i = 0
        while i < nb_targets {
            k = jmax
            if targets[i] >= absc[jmax] {
                res[i] = ord[jmax]
            } else {
                j = 0
                while k > (j + 1) {
                    l = (k + j) / 2
                    if targets[i] >= absc[l] {
                        j = l
                    } else {
                        k = l
                    }
                }
                if k != j && targets[i] >= absc[k] {
                    j = k
                }
                res[i] = ord[j]
            }
            i += 1
        }
    }
    return 1
}

StaircaseAveraging :: (absc: *float64, ord: *float64, nb_knots: s32, targets: *float64, nb_targets: s32, res: *float64) -> s32 {
    j: s32 = 0
    i: s32 = 0
    jmax: s32 = nb_knots - 1
    if nb_knots <= 0 {
        return 0
    }
    if RangeIncreasing(targets, nb_targets + 1) == 0 {
        return 0
    }
    j = 1
    while j <= jmax && targets[0] >= absc[j] {
        j += 1
    }
    i = 1
    while i <= nb_targets {
        if j > jmax || targets[i] < absc[j] {
            res[i - 1] = ord[j - 1]
            i += 1
            continue
        }
        res[i - 1] = (absc[j] - targets[i - 1]) * ord[j - 1]
        while j < jmax && targets[i] >= absc[j + 1] {
            j += 1
            res[i - 1] += (absc[j] - absc[j - 1]) * ord[j - 1]
        }
        if targets[i] >= absc[j] {
            j += 1
        }
        res[i - 1] += (targets[i] - absc[j - 1]) * ord[j - 1]
        res[i - 1] /= targets[i] - targets[i - 1]
        i += 1
    }
    return 1
}

SplineInterp :: (absc: *float64, ord: *float64, nb_knots: s32, targets: *float64, nb_targets: s32, res: *float64) -> s32 {
    sp: CSpline
    i: s32 = 0
    if CSplineInit(*sp, absc, ord, nb_knots) == 0 {
        return 0
    }
    if RangeIncreasing(targets, nb_targets) != 0 {
        i = 0
        while i < nb_targets {
            res[i] = CSplineValue(*sp, targets[i])
            i += 1
        }
    } else {
        i = 0
        while i < nb_targets {
            res[i] = CSplineValue(*sp, targets[i])
            i += 1
        }
    }
    return 1
}

SplineAveraging :: (absc: *float64, ord: *float64, nb_knots: s32, targets: *float64, nb_targets: s32, res: *float64) -> s32 {
    sp: CSpline
    if RangeIncreasing(targets, nb_targets + 1) == 0 {
        return 0
    }
    if CSplineInit(*sp, absc, ord, nb_knots) == 0 {
        return 0
    }
    if CSplineIntegrals(*sp, targets, nb_targets + 1, res) == 0 {
        return 0
    }
    i: s32 = 0
    while i < nb_targets {
        res[i] /= targets[i + 1] - targets[i]
        i += 1
    }
    return 1
}

RunInterp :: (which: s32, absc: *float64, ord: *float64, nb_knots: s32, targets: *float64, nb_targets: s32, res: *float64) -> s32 {
    if which == 0 {
        return LinearInterp(absc, ord, nb_knots, targets, nb_targets, res)
    }
    if which == 1 {
        return LinearAveraging(absc, ord, nb_knots, targets, nb_targets, res)
    }
    if which == 2 {
        return StaircaseInterp(absc, ord, nb_knots, targets, nb_targets, res)
    }
    if which == 3 {
        return StaircaseAveraging(absc, ord, nb_knots, targets, nb_targets, res)
    }
    if which == 4 {
        return SplineInterp(absc, ord, nb_knots, targets, nb_targets, res)
    }
    return SplineAveraging(absc, ord, nb_knots, targets, nb_targets, res)
}

FnInterpolation :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    gx1: s32 = 0
    gl1: s32 = 0
    gx2: s32 = 0
    gl2: s32 = 0
    gx3: s32 = 0
    gl3: s32 = 0
    vals0: [64]float64
    vals1: [64]float64
    vals2: [64]float64
    res: [64]float64
    n0: s32 = 0
    n1: s32 = 0
    n2: s32 = 0
    interp: s32 = 0
    cols2: s32 = 0
    swapped: s32 = 1
    i: s32 = 0
    if groups < 3 {
        return ValError(ERR_VALUE)
    }
    if groups > 4 {
        return ValError(ERR_NA)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    n0 = CashList(*args[gx0], gl0, *vals0[0])
    if n0 < 0 {
        return ValError(args[gx0].err)
    }
    GroupBounds(marks, count, 1, *gx1, *gl1)
    n1 = CashList(*args[gx1], gl1, *vals1[0])
    if n1 < 0 {
        return ValError(args[gx1].err)
    }
    GroupBounds(marks, count, 2, *gx2, *gl2)
    cols2 = st.call_group_cols[gx2]
    if cols2 != 1 && (gl2 / (ifx cols2 < 1 then gl2 else cols2)) != 1 {
        if gl2 > 1 {
            return ValError(ERR_VALUE)
        }
    }
    n2 = CashList(*args[gx2], gl2, *vals2[0])
    if n2 < 0 {
        return ValError(args[gx2].err)
    }
    if n2 <= 0 {
        return ValError(ERR_VALUE)
    }
    if groups >= 4 {
        GroupBounds(marks, count, 3, *gx3, *gl3)
        if gl3 >= 1 {
            if args[gx3].kind == VAL_ERROR {
                return ValError(args[gx3].err)
            }
            interp = TruncateToS32(Floor(CoerceNumber(*args[gx3])))
        }
    }
    if interp < 0 || interp > 5 {
        return ValError(ERR_VALUE)
    }
    if interp == 1 || interp == 3 || interp == 5 {
        if RangeIncreasing(*vals2[0], n2) == 0 {
            return ValError(ERR_VALUE)
        }
        n2 -= 1
        if n2 <= 0 {
            return ValError(ERR_VALUE)
        }
    }
    if n0 != n1 || n0 < 2 || n0 > 64 {
        return ValError(ERR_VALUE)
    }
    if RangeIncreasing(*vals0[0], n0) == 0 {
        swapped = 1
        while swapped != 0 {
            swapped = 0
            i = 1
            while i < n0 {
                if vals0[i - 1] == vals0[i] {
                    return ValError(ERR_VALUE)
                }
                if vals0[i - 1] > vals0[i] {
                    v: float64 = vals0[i - 1]
                    vals0[i - 1] = vals0[i]
                    vals0[i] = v
                    v = vals1[i]
                    vals1[i] = vals1[i - 1]
                    vals1[i - 1] = v
                    swapped = 1
                }
                i += 1
            }
        }
    }
    if RunInterp(interp, *vals0[0], *vals1[0], n0, *vals2[0], n2, *res[0]) == 0 {
        return ValError(ERR_VALUE)
    }
    return ValNumber(res[0])
}

FnPeriodogram :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    gx1: s32 = 0
    gl1: s32 = 0
    gx2: s32 = 0
    gl2: s32 = 0
    gx3: s32 = 0
    gl3: s32 = 0
    gx4: s32 = 0
    gl4: s32 = 0
    ord2: [64]float64
    absc: [64]float64
    interp_targets: [64]float64
    interp_res: [64]float64
    inp: [64]Cplx
    outp: [64]Cplx
    n0: s32 = 0
    n1: s32 = 0
    filter: s32 = 0
    interp: s32 = 0
    nb: s32 = 1
    cols: s32 = 0
    rows: s32 = 0
    factor: float64 = 0
    start: float64 = 0
    incr: float64 = 0
    i: s32 = 0
    if groups < 1 {
        return ValError(ERR_VALUE)
    }
    if groups > 5 {
        return ValError(ERR_NA)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    cols = st.call_group_cols[gx0]
    if cols < 1 {
        cols = gl0
    }
    rows = gl0 / cols
    if cols != 1 && rows != 1 {
        return ValError(ERR_VALUE)
    }
    n0 = CashList(*args[gx0], gl0, *ord2[0])
    if n0 < 0 {
        return ValError(args[gx0].err)
    }
    if n0 == 0 {
        return ValError(ERR_VALUE)
    }
    if n0 > 64 {
        return ValError(ERR_VALUE)
    }
    if groups >= 2 {
        GroupBounds(marks, count, 1, *gx1, *gl1)
        if gl1 >= 1 {
            if args[gx1].kind == VAL_ERROR {
                return ValError(args[gx1].err)
            }
            filter = TruncateToS32(Floor(CoerceNumber(*args[gx1])))
        }
    }
    if filter < 0 || filter > 3 {
        return ValError(ERR_VALUE)
    }
    if groups >= 3 {
        GroupBounds(marks, count, 2, *gx2, *gl2)
        if gl2 > 1 {
            n1 = CashList(*args[gx2], gl2, *absc[0])
            if n1 < 0 {
                return ValError(args[gx2].err)
            }
            if n1 < 2 {
                return ValError(ERR_VALUE)
            }
            if groups >= 4 {
                GroupBounds(marks, count, 3, *gx3, *gl3)
                if gl3 >= 1 {
                    if args[gx3].kind == VAL_ERROR {
                        return ValError(args[gx3].err)
                    }
                    interp = TruncateToS32(Floor(CoerceNumber(*args[gx3])))
                }
            }
            if groups >= 5 {
                GroupBounds(marks, count, 4, *gx4, *gl4)
                if gl4 >= 1 {
                    if args[gx4].kind == VAL_ERROR {
                        return ValError(args[gx4].err)
                    }
                    n1 = TruncateToS32(Floor(CoerceNumber(*args[gx4])))
                }
            }
            if interp < 0 || interp > 5 {
                return ValError(ERR_NA)
            }
            if n1 < n0 {
                return ValError(ERR_VALUE)
            }
            nb = 1
            while nb < n1 {
                nb *= 2
            }
            incr = (absc[n0 - 1] - absc[0]) / cast(float64)n1
            n2: s32 = ifx interp == 1 || interp == 3 || interp == 5 then (n1 + 1) else n1
            if n2 == n1 {
                start = absc[0]
            } else {
                start = absc[0] - incr / 2
            }
            i = 0
            while i < n2 {
                interp_targets[i] = start + cast(float64)i * incr
                i += 1
            }
            if RunInterp(interp, *absc[0], *ord2[0], n0, *interp_targets[0], n1, *interp_res[0]) == 0 {
                return ValError(ERR_NA)
            }
            n0 = n1
            i = 0
            while i < n0 {
                ord2[i] = interp_res[i]
                i += 1
            }
        }
    }
    if nb == 1 {
        while nb < n0 {
            nb *= 2
        }
    }
    if filter != 0 {
        if filter == 1 {
            factor = cast(float64)(n0 / 2)
            i = 0
            while i < n0 {
                ord2[i] *= 1 - Fabs(cast(float64)i / factor - 1)
                i += 1
            }
        } else if filter == 2 {
            factor = (2 * 3.14159265358979323846) / cast(float64)n0
            i = 0
            while i < n0 {
                ord2[i] *= 0.5 * (1 - Cos(factor * cast(float64)i))
                i += 1
            }
        } else {
            factor = cast(float64)(n0 / 2)
            i = 0
            while i < n0 {
                ord2[i] *= 1 - (cast(float64)i / factor - 1) * (cast(float64)i / factor - 1)
                i += 1
            }
        }
    }
    i = 0
    while i < n0 {
        inp[i].re = ord2[i]
        inp[i].im = 0
        i += 1
    }
    FourierFft(*inp[0], nb, 1, *outp[0], 0)
    nb /= 2
    if nb > 0 {
        return ValNumber(Sqrt(outp[0].re * outp[0].re + outp[0].im * outp[0].im))
    }
    return ValError(ERR_VALUE)
}

HdateDaysFromStart :: (y: s32) -> s32 {
    l: s32 = y * 7 + 1
    m: s32 = y * 12 + l / 19
    nm: s32 = 0
    s: s32 = 0
    dw: s32 = 0
    l %= 19
    nm = m * (24 * 1080 + 12 * 1080 + 793) + (1 + 6) * 1080 + 779
    s = m * 28 + nm / (24 * 1080) - 2
    nm %= 7 * 24 * 1080
    dw = nm / (24 * 1080)
    nm %= 24 * 1080
    if (l < 12 && dw == 3 && nm >= ((9 + 6) * 1080 + 204)) || (l < 7 && dw == 2 && nm >= ((15 + 6) * 1080 + 589)) {
        s += 1
        dw += 1
    }
    if dw == 1 || dw == 4 || dw == 6 {
        s += 1
    }
    return s
}

HdateGdateToJd :: (d: s32, m: s32, y: s32) -> s32 {
    jd: s32 = (1461 * (y + 4800 + (m - 14) / 12)) / 4 + (367 * (m - 2 - 12 * ((m - 14) / 12))) / 12 - (3 * ((y + 4900 + (m - 14) / 12) / 100)) / 4 + d - 32075
    return jd
}

HdateJdToHdate :: (jd: s32, d: *s32, m: *s32, y: *s32) {
    s: s32 = 0
    l: s32 = 0
    n: s32 = 0
    i: s32 = 0
    j: s32 = 0
    l = jd + 68569
    n = (4 * l) / 146097
    l = l - (146097 * n + 3) / 4
    i = (4000 * (l + 1)) / 1461001
    l = l - (1461 * i) / 4 + 31
    j = (80 * l) / 2447
    l = j / 11
    y[0] = 100 * (n - 49) + i + l
    d[0] = jd - 1715119
    y[0] += 16
    s = HdateDaysFromStart(y[0])
    m[0] = HdateDaysFromStart(y[0] + 1)
    while d[0] >= m[0] {
        s = m[0]
        y[0] += 1
        m[0] = HdateDaysFromStart(y[0] + 1)
    }
    d[0] -= s
    s = m[0] - s
    y[0] += 3744
    if d[0] >= (s - 236) {
        d[0] -= s - 236
        m[0] = (d[0] * 2) / 59
        d[0] -= (m[0] * 59 + 1) / 2
        m[0] += 4
        if s > 365 && m[0] <= 5 {
            m[0] += 8
        }
    } else {
        s = 114 + s % 10
        m[0] = (d[0] * 4) / s
        d[0] -= (m[0] * s + 3) / 4
    }
}

HdateMonthName :: (month: s32, out: *s8) {
    if month == 0 {
        FormatText(out, 64, CText("Tishri"))
        return
    }
    if month == 1 {
        FormatText(out, 64, CText("Heshwan"))
        return
    }
    if month == 2 {
        FormatText(out, 64, CText("Kislev"))
        return
    }
    if month == 3 {
        FormatText(out, 64, CText("Tebet"))
        return
    }
    if month == 4 {
        FormatText(out, 64, CText("Shebat"))
        return
    }
    if month == 5 {
        FormatText(out, 64, CText("Adar"))
        return
    }
    if month == 6 {
        FormatText(out, 64, CText("Nisan"))
        return
    }
    if month == 7 {
        FormatText(out, 64, CText("Iyar"))
        return
    }
    if month == 8 {
        FormatText(out, 64, CText("Sivan"))
        return
    }
    if month == 9 {
        FormatText(out, 64, CText("Tammuz"))
        return
    }
    if month == 10 {
        FormatText(out, 64, CText("Ab"))
        return
    }
    if month == 11 {
        FormatText(out, 64, CText("Elul"))
        return
    }
    if month == 12 {
        FormatText(out, 64, CText("Adar I"))
        return
    }
    if month == 13 {
        FormatText(out, 64, CText("Adar II"))
        return
    }
    out[0] = 0
}

FnDate2Hdate :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    serial: float64 = 0
    y: s32 = 0
    m: s32 = 0
    d: s32 = 0
    jd: s32 = 0
    hy: s32 = 0
    hm: s32 = 0
    hd: s32 = 0
    mname: [64]s8
    out: [128]s8
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    serial = CoerceNumber(*args[0])
    if serial < 1 {
        return ValError(ERR_NUM)
    }
    days2: s32 = TruncateToS32(serial)
    if days2 < 61 {
        days2 += 1
    }
    CivilFromDays(days2 + SerialEpoch(), *y, *m, *d)
    jd = HdateGdateToJd(d, m, y)
    HdateJdToHdate(jd, *hd, *hm, *hy)
    HdateMonthName(hm, *mname[0])
    FormatText(*out[0], 128, CText("%d %s %d"), hd + 1, *mname[0], hy)
    return ValString(wb_strdup(*out[0]))
}

LogFitTransform :: (xs: *float64, transf_xs: *float64, ys: *float64, n: s32, res: *float64, mean_y: float64) {
    i: s32 = 0
    mean_transf_x: float64 = 0
    diff_x: float64 = 0
    resid_y: float64 = 0
    sum1: float64 = 0
    sum2: float64 = 0
    i = 0
    while i < n {
        transf_xs[i] = Log(res[0] * (xs[i] - res[3]))
        i += 1
    }
    mean_transf_x = GoRangeAverage(transf_xs, n)
    i = 0
    while i < n {
        diff_x = transf_xs[i] - mean_transf_x
        sum1 += diff_x * (ys[i] - mean_y)
        sum2 += diff_x * diff_x
        i += 1
    }
    res[2] = sum1 / sum2
    res[1] = mean_y - res[2] * mean_transf_x
    res[4] = 0
    i = 0
    while i < n {
        resid_y = res[1] + res[2] * transf_xs[i] - ys[i]
        res[4] += resid_y * resid_y
        i += 1
    }
}

LogFitting :: (xs: *float64, ys: *float64, n: s32, res: *float64, min_x: float64, max_x: float64, mean_y: float64) -> s32 {
    sign_plus_ok: s32 = 1
    sign_minus_ok: s32 = 1
    x_range: float64 = 0
    c_step: float64 = 0
    c_accuracy_int: float64 = 0
    c_offset: float64 = 0
    c_accuracy: float64 = 0
    c_range: float64 = 0
    c_start: float64 = 0
    c_end: float64 = 0
    c_dist: float64 = 0
    temp_res: [5]float64
    transf_xs: [64]float64
    i: s32 = 0
    x_range = max_x - min_x
    c_accuracy = Log10(x_range)
    if c_accuracy < 0 {
        if Modf(c_accuracy, *c_accuracy_int) != 0 {
            c_accuracy -= 1
        }
    }
    Modf(c_accuracy, *c_accuracy_int)
    c_accuracy = c_accuracy_int
    c_accuracy = Pow(10, c_accuracy)
    c_accuracy *= 0.000001
    c_step = x_range * 0.05
    c_range = x_range * 100
    res[0] = 1
    res[3] = min_x - c_range
    temp_res[0] = 1
    temp_res[3] = res[3] - c_step
    LogFitTransform(xs, *transf_xs[0], ys, n, res, mean_y)
    LogFitTransform(xs, *transf_xs[0], ys, n, *temp_res[0], mean_y)
    if temp_res[4] <= res[4] {
        sign_plus_ok = 0
    }
    res[0] = -1
    res[3] = max_x + c_range
    temp_res[0] = -1
    temp_res[3] = res[3] + c_step
    LogFitTransform(xs, *transf_xs[0], ys, n, res, mean_y)
    LogFitTransform(xs, *transf_xs[0], ys, n, *temp_res[0], mean_y)
    if temp_res[4] <= res[4] {
        sign_minus_ok = 0
    }
    if sign_plus_ok != 0 && sign_minus_ok == 0 {
        res[0] = 1
    } else if sign_minus_ok != 0 && sign_plus_ok == 0 {
        res[0] = -1
    } else {
        return 1
    }
    c_offset = ifx res[0] == 1 then min_x else max_x
    if res[0] == 1 {
        c_offset = c_accuracy * Floor(c_offset / c_accuracy)
    } else {
        c_offset = c_accuracy * Ceil(c_offset / c_accuracy)
    }
    res[3] = c_offset - res[0] * c_accuracy
    temp_res[3] = c_offset - res[0] * 2 * c_accuracy
    temp_res[0] = res[0]
    LogFitTransform(xs, *transf_xs[0], ys, n, res, mean_y)
    LogFitTransform(xs, *transf_xs[0], ys, n, *temp_res[0], mean_y)
    if temp_res[4] >= res[4] {
        return 1
    }
    c_start = c_offset
    c_end = c_start - res[0] * c_range
    c_dist = (res[0] * (c_start - c_end)) / 2
    res[3] = c_end + res[0] * c_dist
    while true {
        c_dist /= 2
        LogFitTransform(xs, *transf_xs[0], ys, n, res, mean_y)
        temp_res[3] = res[3] + res[0] * c_dist
        LogFitTransform(xs, *transf_xs[0], ys, n, *temp_res[0], mean_y)
        if temp_res[4] <= res[4] {
            i = 0
            while i < 5 {
                res[i] = temp_res[i]
                i += 1
            }
        } else {
            temp_res[3] = res[3] - res[0] * c_dist
            LogFitTransform(xs, *transf_xs[0], ys, n, *temp_res[0], mean_y)
            if temp_res[4] <= res[4] {
                i = 0
                while i < 5 {
                    res[i] = temp_res[i]
                    i += 1
                }
            }
        }
        if c_dist <= c_accuracy {
            break
        }
    }
    res[3] = c_accuracy * FormulaFakeRound(res[3] / c_accuracy)
    LogFitTransform(xs, *transf_xs[0], ys, n, res, mean_y)
    if (res[0] * (res[3] - c_end)) < (1.1 * c_accuracy) {
        return 1
    }
    return 0
}

GoLogarithmicFit :: (xs: *float64, ys: *float64, n: s32, res: *float64) -> s32 {
    min_x: float64 = 0
    max_x: float64 = 0
    min_y: float64 = 0
    max_y: float64 = 0
    mean_y: float64 = 0
    more_2_y: s32 = 0
    more_2_x: s32 = 0
    i: s32 = 0
    if n <= 2 {
        return 2
    }
    min_x = xs[0]
    max_x = xs[0]
    i = 1
    while i < n {
        if xs[i] < min_x {
            min_x = xs[i]
        }
        if xs[i] > max_x {
            max_x = xs[i]
        }
        i += 1
    }
    min_y = ys[0]
    max_y = ys[0]
    i = 1
    while i < n {
        if ys[i] < min_y {
            min_y = ys[i]
        }
        if ys[i] > max_y {
            max_y = ys[i]
        }
        i += 1
    }
    mean_y = GoRangeAverage(ys, n)
    if min_y == max_y || min_x == max_x {
        return 1
    }
    i = 0
    while i < n {
        if ys[i] != min_y && ys[i] != max_y {
            more_2_y = 1
            break
        }
        i += 1
    }
    if more_2_y == 0 {
        return 1
    }
    i = 0
    while i < n {
        if xs[i] != min_x && xs[i] != max_x {
            more_2_x = 1
            break
        }
        i += 1
    }
    if more_2_x == 0 {
        return 1
    }
    return LogFitting(xs, ys, n, res, min_x, max_x, mean_y)
}

FnLogfit :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    gx1: s32 = 0
    gl1: s32 = 0
    ys: [64]float64
    xs: [64]float64
    ny: s32 = 0
    nx: s32 = 0
    res: [5]float64
    rc: s32 = 0
    if groups < 2 {
        return ValError(ERR_VALUE)
    }
    if groups > 2 {
        return ValError(ERR_NA)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    ny = CashList(*args[gx0], gl0, *ys[0])
    if ny < 0 {
        return ValError(args[gx0].err)
    }
    GroupBounds(marks, count, 1, *gx1, *gl1)
    nx = CashList(*args[gx1], gl1, *xs[0])
    if nx < 0 {
        return ValError(args[gx1].err)
    }
    if nx != ny || nx < 3 || nx > 64 {
        return ValError(ERR_VALUE)
    }
    rc = GoLogarithmicFit(*xs[0], *ys[0], nx, *res[0])
    if rc != 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber(res[0])
}

FnLogReg :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    gx1: s32 = 0
    gl1: s32 = 0
    gx2: s32 = 0
    gl2: s32 = 0
    ys: [64]float64
    xscols: [64]float64
    xsst: [17][64]float64
    n: s32 = 0
    ny2: s32 = 0
    dim: s32 = 1
    rtype: s32 = 0
    affine: s32 = 1
    xcols: s32 = 0
    ycols: s32 = 0
    xrows: s32 = 0
    yrows: s32 = 0
    logres: [17]float64
    regres: s32 = 0
    i: s32 = 0
    j: s32 = 0
    if groups < 1 {
        return ValError(ERR_VALUE)
    }
    if groups > 4 {
        return ValError(ERR_NA)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    n = CollectStrictGroup(args, gx0, gl0, *ys[0])
    if n == -1 {
        return ValError(args[gx0].err)
    }
    if n < -1 {
        return ValError(ERR_VALUE)
    }
    if n < 1 || n > 64 {
        return ValError(ERR_VALUE)
    }
    ycols = st.call_group_cols[gx0]
    if ycols < 1 {
        ycols = n
    }
    yrows = gl0 / ycols
    if groups >= 2 {
        GroupBounds(marks, count, 1, *gx1, *gl1)
        ny2 = CollectStrictGroup(args, gx1, gl1, *xscols[0])
        if ny2 == -1 {
            return ValError(args[gx1].err)
        }
        if ny2 < -1 {
            return ValError(ERR_VALUE)
        }
        xcols = st.call_group_cols[gx1]
        if xcols < 1 {
            xcols = gl1
        }
        xrows = gl1 / xcols
        if ycols == 1 {
            if xrows != yrows {
                return ValError(ERR_REF)
            }
            dim = xcols
            rtype = 1
        } else if yrows == 1 {
            if xcols != ycols {
                return ValError(ERR_REF)
            }
            dim = xrows
            rtype = 2
        } else {
            if xrows != yrows || xcols != ycols {
                return ValError(ERR_REF)
            }
            dim = 1
            rtype = 0
        }
        i = 0
        while i < dim {
            j = 0
            while j < ny2 {
                xv: float64 = 0
                if rtype == 2 {
                    xv = xscols[i * xcols + j]
                } else {
                    xv = xscols[j * xcols + i]
                }
                if xv <= 0 {
                    return ValError(ERR_NUM)
                }
                xsst[i + 1][j] = Log(xv)
                j += 1
            }
            i += 1
        }
    } else {
        i = 0
        while i < n {
            xsst[1][i] = Log(cast(float64)(i + 1))
            i += 1
        }
    }
    if dim > 16 {
        return ValError(ERR_VALUE)
    }
    if groups >= 3 {
        GroupBounds(marks, count, 2, *gx2, *gl2)
        if gl2 >= 1 {
            affine = ifx CoerceNumber(*args[gx2]) != 0 then 1 else 0
        }
    }
    if affine != 0 {
        i = 0
        while i < n {
            xsst[0][i] = 1
            i += 1
        }
        regres = GenLinReg(*xsst[0][0], dim + 1, *ys[0], n, 1, *logres[0])
    } else {
        logres[0] = 0
        regres = GenLinReg(*xsst[1][0], dim, *ys[0], n, 0, *logres[1])
    }
    if regres != 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber(logres[dim])
}

FnOwent :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    h: float64 = 0
    a: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    h = CoerceNumber(*args[0])
    a = CoerceNumber(*args[1])
    return ValNumber(OwentT(h, a))
}

FnMpseudoinverse :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    gx1: s32 = 0
    gl1: s32 = 0
    a: [16][16]float64
    ar: s32 = 0
    ac: s32 = 0
    ok: s32 = 0
    m: s32 = 0
    n: s32 = 0
    threshold: float64 = 256 * 2.220446049250313e-16
    qa: QuadMatrix
    qt: QuadMatrix
    qr: QuadQR
    rt: QuadMatrix
    rtr: QuadMatrix
    b0: QuadMatrix
    bi: QuadMatrix
    w: QuadMatrix
    bip1: QuadMatrix
    x: [16]Quad
    i: s32 = 0
    j: s32 = 0
    k: s32 = 0
    emax: float64 = 0
    emin_dummy: float64 = 0
    full_rank: s32 = 1
    delta: Quad
    two: Quad
    p: Quad
    transposed: s32 = 0
    if groups < 1 {
        return ValError(ERR_VALUE)
    }
    if groups > 2 {
        return ValError(ERR_NA)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    ok = MatFromGroup(args, gx0, gl0, st.call_group_cols[gx0], *a[0][0], *ar, *ac)
    if ok < 0 {
        return ValError(args[gx0].err)
    }
    if ok == 0 {
        return ValError(ERR_VALUE)
    }
    if groups >= 2 {
        GroupBounds(marks, count, 1, *gx1, *gl1)
        if gl1 >= 1 {
            threshold = CoerceNumber(*args[gx1])
        }
    }
    m = ar
    n = ac
    transposed = 0
    if m < n {
        transposed = 1
        qt.m = n
        qt.n = m
        i = 0
        while i < m {
            j = 0
            while j < n {
                QuadInit(*qt.data[j][i], a[i][j])
                j += 1
            }
            i += 1
        }
        qa = qt
        k = m
        m = n
        n = k
    } else {
        qa.m = m
        qa.n = n
        i = 0
        while i < m {
            j = 0
            while j < n {
                QuadInit(*qa.data[i][j], a[i][j])
                j += 1
            }
            i += 1
        }
    }
    qr = QuadQrNew(*qa)
    QuadMatrixEigenRange(*qr.R, *emin_dummy, *emax)
    if emax == 0 {
        return ValNumber(0)
    }
    i = 0
    while i < n {
        abs_e: float64 = Fabs(QuadVal(*qr.R.data[i][i]))
        if abs_e <= (emax * threshold) {
            full_rank = 0
            QuadZero(*qr.R.data[i][i])
        }
        i += 1
    }
    QuadInit(*delta, ifx full_rank != 0 then 0 else (emax * threshold))
    rt.m = n
    rt.n = n
    QuadMatrixTranspose(*rt, *qr.R)
    rtr.m = n
    rtr.n = n
    QuadMatrixMultiply(*rtr, *rt, *qr.R)
    i = 0
    while i < n {
        QuadAdd(*rtr.data[i][i], *rtr.data[i][i], *delta)
        i += 1
    }
    if QuadMatrixInverse(*rtr, 0.0, *b0) == 0 {
        return ValError(ERR_NUM)
    }
    bi.m = n
    bi.n = n
    QuadMatrixMultiply(*bi, *b0, *rt)
    k = 0
    while k < 10 {
        w.m = n
        w.n = n
        bip1.m = n
        bip1.n = n
        QuadMatrixMultiply(*w, *bi, *qr.R)
        QuadInit(*two, 2)
        i = 0
        while i < n {
            j = 0
            while j < n {
                if i == j {
                    QuadSub(*w.data[i][j], *two, *w.data[i][j])
                } else {
                    QuadZero(*p)
                    QuadSub(*w.data[i][j], *p, *w.data[i][j])
                }
                j += 1
            }
            i += 1
        }
        QuadMatrixMultiply(*bip1, *w, *bi)
        i = 0
        while i < n {
            j = 0
            while j < n {
                bi.data[i][j] = bip1.data[i][j]
                j += 1
            }
            i += 1
        }
        k += 1
    }
    j = 0
    while j < m {
        i = 0
        while i < m {
            QuadInit(*x[i], ifx i == j then 1.0 else 0.0)
            i += 1
        }
        QuadQrMultiplyQt(*qr, *x[0])
        if j == 0 {
            acc2: Quad
            k = 0
            while k < n {
                QuadMul(*p, *bi.data[0][k], *x[k])
                QuadAdd(*acc2, *acc2, *p)
                k += 1
            }
            return ValNumber(QuadVal(*acc2))
        }
        j += 1
    }
    return ValNumber(0)
}

FnLeverage :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    a: [16][16]float64
    ar: s32 = 0
    ac: s32 = 0
    ok: s32 = 0
    m: s32 = 0
    n: s32 = 0
    qa: QuadMatrix
    qr: QuadQR
    xscale: [16]float64
    aj: [16]float64
    b: [16]Quad
    emin: float64 = 0
    emax: float64 = 0
    i: s32 = 0
    j: s32 = 0
    k: s32 = 0
    acc: Quad
    p: Quad
    if groups < 1 {
        return ValError(ERR_VALUE)
    }
    if groups > 1 {
        return ValError(ERR_NA)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    ok = MatFromGroup(args, gx0, gl0, st.call_group_cols[gx0], *a[0][0], *ar, *ac)
    if ok < 0 {
        return ValError(args[gx0].err)
    }
    if ok == 0 {
        return ValError(ERR_VALUE)
    }
    m = ar
    n = ac
    if m > 16 || n > 16 {
        return ValError(ERR_VALUE)
    }
    j = 0
    while j < n {
        i = 0
        while i < m {
            aj[i] = a[i][j]
            i += 1
        }
        xscale[j] = CalcScale(*aj[0], m)
        j += 1
    }
    qa.m = m
    qa.n = n
    i = 0
    while i < m {
        j = 0
        while j < n {
            QuadInit(*qa.data[i][j], a[i][j] / xscale[j])
            j += 1
        }
        i += 1
    }
    qr = QuadQrNew(*qa)
    QuadMatrixEigenRange(*qr.R, *emin, *emax)
    if emin <= (emax * (256 * 2.220446049250313e-16)) {
        return ValError(ERR_NUM)
    }
    k = 0
    while k < m {
        QuadZero(*acc)
        i = 0
        while i < n {
            b[i] = qa.data[k][i]
            i += 1
        }
        if QuadMatrixFwdSolve(*qr.R, *b[0], *b[0], 0) != 0 {
            return ValError(ERR_NUM)
        }
        if QuadMatrixBackSolve(*qr.R, *b[0], *b[0], 0) != 0 {
            return ValError(ERR_NUM)
        }
        i = 0
        while i < n {
            QuadMul(*p, *qa.data[k][i], *b[i])
            QuadAdd(*acc, *acc, *p)
            i += 1
        }
        if k == 0 {
            return ValNumber(QuadVal(*acc))
        }
        k += 1
    }
    return ValNumber(0)
}

FnPochhammer :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    x: float64 = 0
    n: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    x = CoerceNumber(*args[0])
    n = CoerceNumber(*args[1])
    return ValNumber(PochhammerHammer(x, n))
}

WorkbookLoadFile :: (wb: *Workbook, path: *s8) -> s32 {
    raw: *u8 = null
    bytes: *u8 = null
    size: s32 = 0
    text: *s8 = null
    is_gzip: s32 = 0
    ok: s32 = 0
    raw = ReadFileBytes(path, *size)
    if raw == null {
        return 0
    }
    bytes = cast(*u8)MemoryAllocate(cast(u64)(size + 1))
    if bytes == null {
        FreeFileBytes(raw)
        return 0
    }
    if size > 0 {
        MemoryCopy(cast(*void)bytes, cast(*void)raw, cast(u64)size)
    }
    bytes[size] = 0
    FreeFileBytes(raw)
    is_gzip = GzipIs(bytes, cast(u64)size)
    if is_gzip != 0 {
        inflated_len: u64 = 0
        text = cast(*s8)GzipDecompress(bytes, cast(u64)size, *inflated_len)
        FreeFileBytes(bytes)
        if text == null {
            return 0
        }
    } else {
        text = cast(*s8)bytes
    }
    ok = 0
    if TextCompareNLiteral(text, "<?xml", 5) == 0 || TextFindLiteral(text, "<gnm:Workbook") != null || TextFindLiteral(text, "<Workbook") != null {
        ok = ParseGnumericXml(wb, text)
    } else {
        ok = ParseCsvIntoSheet(wb, text)
    }
    if is_gzip != 0 {
        MemoryFree(cast(*void)text)
    } else {
        FreeFileBytes(cast(*u8)text)
    }
    if ok != 0 {
        WorkbookEvaluate(wb)
        return 1
    }
    return 0
}

ParseGnumericXml :: (wb: *Workbook, text: *s8) -> s32 {
    root: *XmlNode = XmlParse(text)
    sheets_node: *XmlNode = null
    i: s32 = 0
    if root == null {
        return 0
    }
    sheets_node = XmlFindLocal(root, CText("Sheets"))
    if sheets_node == null {
        XmlFree(root)
        return 0
    }
    i = 0
    while i < sheets_node.count {
        sheet_node: *XmlNode = XmlChild(sheets_node, i)
        if sheet_node != null && TextCompareLiteral(XmlNameLocal(sheet_node), "Sheet") == 0 {
            ParseGnumericSheet(wb, sheet_node)
        }
        i += 1
    }
    XmlFree(root)
    return cast(s32)(wb.sheet_count > 0)
}

ParseGnumericSheet :: (wb: *Workbook, node: *XmlNode) {
    name_node: *XmlNode = XmlFindLocal(node, CText("Name"))
    name: [128]s8
    TextSet(*name[0], "Sheet")
    cells_node: *XmlNode = null
    i: s32 = 0
    if name_node != null {
        FormatText(*name[0], 128, CText("%s"), XmlText(name_node))
    }
    if WorkbookFindSheet(wb, *name[0]) != null {
        return
    }
    sheet: *Sheet = WorkbookAddSheet(wb, *name[0])
    if sheet == null {
        return
    }
    cells_node = XmlFindLocal(node, CText("Cells"))
    if cells_node == null {
        return
    }
    i = 0
    while i < cells_node.count {
        cell_node: *XmlNode = XmlChild(cells_node, i)
        if cell_node != null {
            ParseGnumericCell(sheet, cell_node)
        }
        i += 1
    }
    SheetExtent(sheet)
}

ParseGnumericCell :: (sheet: *Sheet, node: *XmlNode) {
    row: s64 = XmlAttrLong(node, CText("Row"), -1)
    col: s64 = XmlAttrLong(node, CText("Col"), -1)
    type_attr: *s8 = XmlAttr(node, CText("ValueType"))
    value_type: s64 = ifx type_attr != null then ParseLong(type_attr, null, 10) else (-1)
    content: *s8 = XmlText(node)
    cell: *Cell = null
    if row < 0 || col < 0 || row >= WB_MAX_ROWS || col >= WB_MAX_COLS {
        return
    }
    cell = CellObtain(sheet, cast(s32)row, cast(s32)col)
    if cell == null {
        return
    }
    if value_type == 10 || (value_type == -1 && content[0] != 61) {
        SheetDrop(sheet, cast(s32)row, cast(s32)col)
        return
    }
    wb_replace_text(*cell.serialized, content)
    if content[0] == 61 && value_type == -1 {
        wb_replace_text(*cell.text, content)
        cell.kind = CELL_FORMULA
        cell.computed = 0
        return
    }
    if value_type == 20 {
        cell.kind = CELL_LITERAL
        cell.cached_kind = VAL_BOOL
        cell.cached_number = cast(float64)(ifx TextCompareLiteral(content, "TRUE") == 0 then 1 else 0)
        wb_replace_text(*cell.text, content)
        return
    }
    if value_type == 30 || value_type == 40 {
        cell.kind = CELL_LITERAL
        cell.cached_kind = VAL_FLOAT
        cell.cached_number = ParseDouble(content, null)
        wb_replace_text(*cell.text, content)
        return
    }
    if value_type == 50 {
        cell.kind = CELL_LITERAL
        cell.cached_kind = VAL_ERROR
        cell.cached_err = ErrFromText(content)
        wb_replace_text(*cell.text, content)
        return
    }
    if value_type == 60 {
        cell.kind = CELL_LITERAL
        cell.cached_kind = VAL_STRING
        wb_replace_text(*cell.text, content)
        wb_replace_text(*cell.cached_text, content)
        return
    }
    wb_replace_text(*cell.text, content)
    ClassifyCell(cell)
}

WorkbookWriteGnumeric :: (wb: *Workbook, path: *s8) -> s32 {
    buf: XmlBuffer
    ok: s32 = 0
    sheet_index: s32 = 0
    XmlBufferRaw(*buf, CText("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"))
    XmlBufferRaw(*buf, CText("<gnm:Workbook xmlns:gnm=\"http://www.gnumeric.org/v10.dtd\">\n"))
    XmlBufferRaw(*buf, CText("  <gnm:Version Epoch=\"1\" Major=\"12\" Minor=\"62\" Full=\"1.12.62\"/>\n"))
    XmlBufferRaw(*buf, CText("  <gnm:SheetNameIndex>\n"))
    sheet_index = 0
    while sheet_index < wb.sheet_count {
        XmlBufferRaw(*buf, CText("    <gnm:SheetName gnm:Cols=\"256\" gnm:Rows=\"65536\">"))
        XmlBufferEsc(*buf, *wb.sheets[sheet_index].name[0])
        XmlBufferRaw(*buf, CText("</gnm:SheetName>\n"))
        sheet_index += 1
    }
    XmlBufferRaw(*buf, CText("  </gnm:SheetNameIndex>\n"))
    XmlBufferRaw(*buf, CText("  <gnm:Sheets>\n"))
    sheet_index = 0
    while sheet_index < wb.sheet_count {
        WriteGnumericSheet(*buf, *wb.sheets[sheet_index])
        sheet_index += 1
    }
    XmlBufferRaw(*buf, CText("  </gnm:Sheets>\n"))
    XmlBufferRaw(*buf, CText("  <gnm:UIData SelectedTab=\"0\"/>\n"))
    XmlBufferRaw(*buf, CText("</gnm:Workbook>\n"))
    ok = ifx WriteFileText(path, XmlBufferFinish(*buf)) then 1 else 0
    XmlBufferFree(*buf)
    return ok
}

WriteGnumericSheet :: (buf: *XmlBuffer, sheet: *Sheet) {
    tmp: [32]s8
    XmlBufferRaw(buf, CText("    <gnm:Sheet>\n      <gnm:Name>"))
    XmlBufferEsc(buf, *sheet.name[0])
    XmlBufferRaw(buf, CText("</gnm:Name>\n"))
    FormatNumber(cast(float64)(ifx sheet.max_col > 0 then sheet.max_col else 0), *tmp[0], 32)
    XmlBufferRaw(buf, CText("      <gnm:MaxCol>"))
    XmlBufferRaw(buf, *tmp[0])
    XmlBufferRaw(buf, CText("</gnm:MaxCol>\n"))
    FormatNumber(cast(float64)(ifx sheet.max_row > 0 then sheet.max_row else 0), *tmp[0], 32)
    XmlBufferRaw(buf, CText("      <gnm:MaxRow>"))
    XmlBufferRaw(buf, *tmp[0])
    XmlBufferRaw(buf, CText("</gnm:MaxRow>\n"))
    XmlBufferRaw(buf, CText("      <gnm:Cells>\n"))
    i: s32 = 0
    while i < sheet.cell_count {
        cell: *Cell = *sheet.cells[i]
        if cell.text != null && cell.text[0] != 0 {
            WriteGnumericCell(buf, cell)
        }
        i += 1
    }
    XmlBufferRaw(buf, CText("      </gnm:Cells>\n"))
    XmlBufferRaw(buf, CText("      <gnm:SheetLayout TopLeft=\"A1\"/>\n"))
    XmlBufferRaw(buf, CText("    </gnm:Sheet>\n"))
}

WriteGnumericCell :: (buf: *XmlBuffer, cell: *Cell) {
    row: s32 = CellKeyRow(cell.key)
    col: s32 = CellKeyCol(cell.key)
    tmp: [32]s8
    out: [64]s8
    XmlBufferRaw(buf, CText("        <gnm:Cell Row=\""))
    FormatNumber(cast(float64)row, *tmp[0], 32)
    XmlBufferRaw(buf, *tmp[0])
    XmlBufferRaw(buf, CText("\" Col=\""))
    FormatNumber(cast(float64)col, *tmp[0], 32)
    XmlBufferRaw(buf, *tmp[0])
    XmlBufferRaw(buf, CText("\""))
    if cell.kind == CELL_FORMULA {
        XmlBufferRaw(buf, CText(">"))
        XmlBufferEsc(buf, cell.text)
        XmlBufferRaw(buf, CText("</gnm:Cell>\n"))
        return
    }
    if cell.cached_kind == VAL_BOOL {
        XmlBufferRaw(buf, CText(" ValueType=\"20\">"))
        XmlBufferEsc(buf, ifx cell.cached_number != 0 then CText("TRUE") else CText("FALSE"))
        XmlBufferRaw(buf, CText("</gnm:Cell>\n"))
        return
    }
    if cell.cached_kind == VAL_FLOAT {
        FormatNumber(cell.cached_number, *out[0], 64)
        if cell.serialized != null && TextLooksNumeric(cell.serialized) != 0 {
            FormatText(*out[0], 64, CText("%s"), cell.serialized)
        }
        XmlBufferRaw(buf, CText(" ValueType=\"40\">"))
        XmlBufferEsc(buf, *out[0])
        XmlBufferRaw(buf, CText("</gnm:Cell>\n"))
        return
    }
    if cell.cached_kind == VAL_ERROR {
        XmlBufferRaw(buf, CText(" ValueType=\"50\">"))
        XmlBufferEsc(buf, ErrText(cell.cached_err))
        XmlBufferRaw(buf, CText("</gnm:Cell>\n"))
        return
    }
    XmlBufferRaw(buf, CText(" ValueType=\"60\">"))
    XmlBufferEsc(buf, ifx cell.text != null then cell.text else CText(""))
    XmlBufferRaw(buf, CText("</gnm:Cell>\n"))
}

ParseCsvIntoSheet :: (wb: *Workbook, text: *s8) -> s32 {
    sheet: *Sheet = WorkbookAddSheet(wb, CText("Sheet1"))
    pos: s32 = 0
    row: s32 = 0
    col: s32 = 0
    if sheet == null {
        return 0
    }
    while text[pos] != 0 {
        field: [512]s8
        n: s32 = 0
        if text[pos] == 34 {
            pos += 1
            while text[pos] != 0 {
                if text[pos] == 34 {
                    if text[pos + 1] == 34 {
                        if n < (512 - 1) {
                            field[n] = 34
                            n += 1
                        }
                        pos += 2
                        continue
                    }
                    pos += 1
                    break
                }
                if n < (512 - 1) {
                    field[n] = text[pos]
                    n += 1
                }
                pos += 1
            }
        } else {
            while text[pos] != 0 && text[pos] != 44 && text[pos] != 10 && text[pos] != 13 {
                if n < (512 - 1) {
                    field[n] = text[pos]
                    n += 1
                }
                pos += 1
            }
        }
        field[n] = 0
        if field[0] != 0 {
            SetCellText(wb, wb.sheet_count - 1, row, col, *field[0])
        }
        if text[pos] == 44 {
            col += 1
            pos += 1
            continue
        }
        if text[pos] == 13 {
            pos += 1
        }
        if text[pos] == 10 {
            pos += 1
        }
        row += 1
        col = 0
    }
    SheetExtent(sheet)
    return 1
}

CsvNeedsQuotes :: (text: *s8) -> s32 {
    i: s32 = 0
    while text[i] != 0 {
        c: s8 = text[i]
        if c == 44 || c == 34 || c == 32 || c == 10 || c == 13 {
            return 1
        }
        i += 1
    }
    return 0
}

WriteCsvField :: (buf: *XmlBuffer, text: *s8) {
    if !(CsvNeedsQuotes(text) != 0) {
        XmlBufferRaw(buf, text)
        return
    }
    XmlBufferRaw(buf, CText("\""))
    i: s32 = 0
    while text[i] != 0 {
        if text[i] == 34 {
            XmlBufferRaw(buf, CText("\"\""))
        } else {
            one: [2]s8
            one[0] = text[i]
            XmlBufferRaw(buf, *one[0])
        }
        i += 1
    }
    XmlBufferRaw(buf, CText("\""))
}

WorkbookExportCsv :: (wb: *Workbook, path: *s8) -> s32 {
    buf: XmlBuffer
    ok: s32 = 0
    if wb.sheet_count == 0 {
        return 0
    }
    sheet: *Sheet = *wb.sheets[0]
    min_col: s32 = WB_MAX_COLS
    min_row: s32 = WB_MAX_ROWS
    max_col: s32 = -1
    max_row: s32 = -1
    r: s32 = 0
    c: s32 = 0
    r = 0
    while r <= sheet.max_row {
        c = 0
        while c <= sheet.max_col {
            cell: *Cell = CellAt(sheet, r, c)
            display: [512]s8
            v: Val
            if cell == null {
                c += 1
                continue
            }
            CellDisplayText(cell, *display[0], 512)
            if display[0] != 0 {
                if c < min_col {
                    min_col = c
                }
                if r < min_row {
                    min_row = r
                }
                if c > max_col {
                    max_col = c
                }
                if r > max_row {
                    max_row = r
                }
            }
            c += 1
        }
        r += 1
    }
    if max_row < 0 {
        return ifx WriteFileText(path, CText("")) then 1 else 0
    }
    r = min_row
    while r <= max_row {
        c = 0
        while c <= max_col {
            if c > 0 {
                XmlBufferRaw(*buf, CText(","))
            }
            cell: *Cell = CellAt(sheet, r, c)
            display: [512]s8
            v: Val
            if cell != null {
                CellDisplayText(cell, *display[0], 512)
            } else {
                display[0] = 0
            }
            WriteCsvField(*buf, *display[0])
            c += 1
        }
        XmlBufferRaw(*buf, CText("\n"))
        r += 1
    }
    ok = ifx WriteFileText(path, XmlBufferFinish(*buf)) then 1 else 0
    XmlBufferFree(*buf)
    return ok
}

WorkbookSheetCount :: (wb: *Workbook) -> s32 {
    return wb.sheet_count
}

WorkbookSheetName :: (wb: *Workbook, index: s32) -> *s8 {
    if index < 0 || index >= wb.sheet_count {
        return CText("")
    }
    return *wb.sheets[index].name[0]
}

WorkbookSheetColumns :: (wb: *Workbook, index: s32) -> s32 {
    if index < 0 || index >= wb.sheet_count {
        return 0
    }
    return wb.sheets[index].max_col + 1
}

WorkbookSheetRows :: (wb: *Workbook, index: s32) -> s32 {
    if index < 0 || index >= wb.sheet_count {
        return 0
    }
    return wb.sheets[index].max_row + 1
}

WorkbookSetCell :: (wb: *Workbook, sheet_index: s32, row: s32, col: s32, text: *s8) -> s32 {
    return SetCellText(wb, sheet_index, row, col, text)
}

WorkbookCellText :: (wb: *Workbook, index: s32, row: s32, col: s32) -> *s8 {
    cell: *Cell = null
    if index < 0 || index >= wb.sheet_count {
        return CText("")
    }
    cell = CellAt(*wb.sheets[index], row, col)
    if cell == null {
        return CText("")
    }
    return ifx cell.text != null then cell.text else CText("")
}

WorkbookCellDisplay :: (wb: *Workbook, index: s32, row: s32, col: s32, out: *s8, cap: s32) {
    cell: *Cell = null
    v: Val
    if index < 0 || index >= wb.sheet_count {
        out[0] = 0
        return
    }
    cell = CellAt(*wb.sheets[index], row, col)
    if cell == null {
        out[0] = 0
        return
    }
    v.kind = cell.cached_kind
    v.number = cell.cached_number
    v.text = cell.cached_text
    v.err = cell.cached_err
    v.from_range = 0
    WbCellValueText(*v, out, cap)
}
