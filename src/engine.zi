    }
    if TextCompareLiteral(name, "pfactor") == 0 {
        return FnPfactor(st, args, count, marks)
    }
    if TextCompareLiteral(name, "pochhammer") == 0 {
        return FnPochhammer(st, args, count, marks)
    }
    if TextCompareLiteral(name, "mpseudoinverse") == 0 {
        return FnMpseudoinverse(st, args, count, marks)
    }
    if TextCompareLiteral(name, "leverage") == 0 {
        return FnLeverage(st, args, count, marks)
    }
    if TextCompareLiteral(name, "owent") == 0 {
        return FnOwent(st, args, count, marks)
    }
    if TextCompareLiteral(name, "beta") == 0 {
        return FnBeta(st, args, count, marks)
    }
    if TextCompareLiteral(name, "lkstest") == 0 {
        return FnNormalityTest(st, args, count, marks, 0)
    }
    if TextCompareLiteral(name, "sftest") == 0 {
        return FnNormalityTest(st, args, count, marks, 1)
    }
    if TextCompareLiteral(name, "cvmtest") == 0 {
        return FnNormalityTest(st, args, count, marks, 2)
    }
    if TextCompareLiteral(name, "adtest") == 0 {
        return FnNormalityTest(st, args, count, marks, 3)
    }
    if TextCompareLiteral(name, "chitest") == 0 {
        return FnChitest(st, args, count, marks)
    }
    if TextCompareLiteral(name, "cronbach") == 0 {
        return FnCronbach(st, args, count, marks)
    }
    if TextCompareLiteral(name, "logistic") == 0 {
        return FnLogistic(st, args, count, marks)
    }
    if TextCompareLiteral(name, "flt.radix") == 0 {
        return FnFltConst(st, args, count, marks, 0)
    }
    if TextCompareLiteral(name, "flt.min") == 0 {
        return FnFltConst(st, args, count, marks, 1)
    }
    if TextCompareLiteral(name, "flt.max") == 0 {
        return FnFltConst(st, args, count, marks, 2)
    }
    if TextCompareLiteral(name, "flt.nextafter") == 0 {
        return FnFltNextAfter(st, args, count, marks)
    }
    if TextCompareLiteral(name, "odf.sumproduct") == 0 {
        return FnSumProduct(st, args, count, marks)
    }
    if TextCompareLiteral(name, "fourier") == 0 {
        return FnFourier(st, args, count, marks)
    }
    if TextCompareLiteral(name, "hpfilter") == 0 {
        return FnHpfilter(st, args, count, marks)
    }
    if TextCompareLiteral(name, "reducepi") == 0 {
        return FnReducepi(st, args, count, marks)
    }
    if TextCompareLiteral(name, "pearson") == 0 {
        return FnCorrel(st, args, count, marks)
    }
    if TextCompareLiteral(name, "findb") == 0 {
        return FnFind(st, args, count, marks)
    }
    if TextCompareLiteral(name, "searchb") == 0 {
        return FnSearch(st, args, count, marks)
    }
    if TextCompareLiteral(name, "replaceb") == 0 {
        return FnReplace(st, args, count, marks)
    }
    if TextCompareLiteral(name, "averageif") == 0 {
        return FnSumIf(st, args, count, marks, 1)
    }
    if TextCompareLiteral(name, "countif") == 0 {
        return FnCountIf(st, args, count, marks)
    }
    return ValError(ERR_NAME)
}

FnSumIf :: (st: *EvalState, args: *Val, count: s32, marks: *s32, average: s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    start0: s32 = 0
    len0: s32 = 0
    start1: s32 = 0
    len1: s32 = 0
    start2: s32 = 0
    len2: s32 = 0
    criterion: *Val = null
    total: float64 = 0
    matched: s32 = 0
    i: s32 = 0
    if groups < 2 {
        return ValError(ERR_VALUE)
    }
    GroupBounds(marks, count, 0, *start0, *len0)
    GroupBounds(marks, count, 1, *start1, *len1)
    if groups >= 3 {
        GroupBounds(marks, count, 2, *start2, *len2)
    }
    if len1 != 1 {
        return ValError(ERR_VALUE)
    }
    criterion = *args[start1]
    i = 0
    while i < len0 {
        hit: s32 = CriterionMatch(criterion, *args[start0 + i])
        if hit < 0 {
            return ValError(ERR_VALUE)
        }
        if hit != 0 {
            value: *Val = null
            if groups >= 3 && i < len2 {
                value = *args[start2 + i]
            } else {
                value = *args[start0 + i]
            }
            if value.kind == VAL_FLOAT {
                total += value.number
                matched += 1
            }
        }
        i += 1
    }
    if average != 0 {
        if matched == 0 {
            return ValError(ERR_DIV0)
        }
        return ValNumber(total / cast(float64)matched)
    }
    return ValNumber(total)
}

FnCountIf :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    start0: s32 = 0
    len0: s32 = 0
    start1: s32 = 0
    len1: s32 = 0
    criterion: *Val = null
    matched: s32 = 0
    i: s32 = 0
    if groups < 2 {
        return ValError(ERR_VALUE)
    }
    GroupBounds(marks, count, 0, *start0, *len0)
    GroupBounds(marks, count, 1, *start1, *len1)
    if len1 != 1 {
        return ValError(ERR_VALUE)
    }
    criterion = *args[start1]
    i = 0
    while i < len0 {
        hit: s32 = CriterionMatch(criterion, *args[start0 + i])
        if hit < 0 {
            return ValError(ERR_VALUE)
        }
        if hit != 0 {
            matched += 1
        }
        i += 1
    }
    return ValNumber(cast(float64)matched)
}

FnIfs :: (st: *EvalState, args: *Val, count: s32, marks: *s32, which: s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    pairs: s32 = 0
    p: s32 = 0
    base_start: s32 = 0
    base_len: s32 = 0
    base_cols: s32 = 0
    crange_start: [16]s32
    crange_len: [16]s32
    crit_start: [16]s32
    i: s32 = 0
    matched: s32 = 0
    total: float64 = 0
    vmax: float64 = 0
    vmin: float64 = 0
    first_hit: s32 = 1
    if which == 0 {
        if groups < 2 || (groups % 2) != 0 {
            return ValError(ERR_VALUE)
        }
        pairs = groups / 2
    } else {
        if groups < 1 || (groups % 2) != 1 {
            return ValError(ERR_VALUE)
        }
        if st.call_refs[0].kind == 0 {
            return ValError(ERR_VALUE)
        }
        pairs = (groups - 1) / 2
    }
    if pairs > 16 {
        return ValError(ERR_VALUE)
    }
    GroupBounds(marks, count, 0, *base_start, *base_len)
    if which != 0 {
        base_cols = st.call_group_cols[base_start]
        if base_cols < 1 {
            base_cols = base_len
        }
    }
    p = 0
    while p < pairs {
        rstart: s32 = 0
        rlen: s32 = 0
        cstart: s32 = 0
        clen: s32 = 0
        gidx: s32 = (ifx which == 0 then 0 else 1) + 2 * p
        GroupBounds(marks, count, gidx, *rstart, *rlen)
        GroupBounds(marks, count, gidx + 1, *cstart, *clen)
        if clen != 1 {
            return ValError(ERR_VALUE)
        }
        if args[cstart].kind == VAL_ERROR {
            return ValError(args[cstart].err)
        }
        if rlen != base_len {
            return ValError(ERR_VALUE)
        }
        if which != 0 {
            rcols: s32 = st.call_group_cols[rstart]
            if rcols < 1 {
                rcols = rlen
            }
            if rcols != base_cols {
                return ValError(ERR_VALUE)
            }
        }
        crange_start[p] = rstart
        crange_len[p] = rlen
        crit_start[p] = cstart
        p += 1
    }
    i = 0
    while i < base_len {
        hit: s32 = 1
        p = 0
        while p < pairs {
            one: s32 = CriterionMatch(*args[crit_start[p]], *args[crange_start[p] + i])
            if one < 0 {
                return ValError(ERR_VALUE)
            }
            if one == 0 {
                hit = 0
            }
            p += 1
        }
        if hit != 0 {
            v: *Val = null
            if which == 0 {
                v = *args[base_start + i]
                if v.kind == VAL_ERROR {
                    return ValError(v.err)
                }
                matched += 1
            } else {
                v = *args[base_start + i]
                if v.kind == VAL_ERROR {
                    return ValError(v.err)
                }
                if v.kind == VAL_FLOAT {
                    total += v.number
                    if first_hit != 0 {
                        vmax = v.number
                        vmin = v.number
                        first_hit = 0
                    } else {
                        if v.number > vmax {
                            vmax = v.number
                        }
                        if v.number < vmin {
                            vmin = v.number
                        }
                    }
                    matched += 1
                }
            }
        }
        i += 1
    }
    if which == 0 {
        return ValNumber(cast(float64)matched)
    }
    if which == 1 {
        return ValNumber(total)
    }
    if matched == 0 {
        return ValError(ERR_DIV0)
    }
    if which == 2 {
        return ValNumber(total / cast(float64)matched)
    }
    return ValNumber(ifx which == 3 then vmax else vmin)
}

FnSumA :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    total: float64 = 0
    i: s32 = 0
    while i < count {
        v: *Val = *args[i]
        if v.kind == VAL_ERROR {
            return ValError(v.err)
        }
        if v.kind == VAL_FLOAT || v.kind == VAL_BOOL {
            total += v.number
        }
        i += 1
    }
    return ValNumber(total)
}

FnProb :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    xs: [4096]float64
    ps: [4096]float64
    gx0: s32 = 0
    gl0: s32 = 0
    gx1: s32 = 0
    gl1: s32 = 0
    gx2: s32 = 0
    gl2: s32 = 0
    xn: s32 = 0
    pn: s32 = 0
    low: float64 = 0
    high: float64 = 0
    total: float64 = 0
    sum: float64 = 0
    i: s32 = 0
    if groups < 3 {
        return ValError(ERR_VALUE)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    GroupBounds(marks, count, 1, *gx1, *gl1)
    GroupBounds(marks, count, 2, *gx2, *gl2)
    xn = CashList(*args[gx0], gl0, *xs[0])
    pn = CashList(*args[gx1], gl1, *ps[0])
    if xn < 0 || pn < 0 {
        return ValError(ERR_VALUE)
    }
    if xn != pn {
        return ValError(ERR_NA)
    }
    if gl2 < 1 {
        return ValError(ERR_VALUE)
    }
    low = CoerceNumber(*args[gx2])
    if groups >= 4 {
        gx3: s32 = 0
        gl3: s32 = 0
        GroupBounds(marks, count, 3, *gx3, *gl3)
        if gl3 < 1 {
            return ValError(ERR_VALUE)
        }
        high = CoerceNumber(*args[gx3])
    } else {
        high = low
    }
    i = 0
    while i < xn {
        prob: float64 = ps[i]
        if prob <= 0 || prob > 1 {
            return ValError(ERR_NUM)
        }
        total += prob
        if xs[i] >= low && xs[i] <= high {
            sum += prob
        }
        i += 1
    }
    if Fabs(total - 1) > (cast(float64)(xn * 2) * 2.220446049250313e-16) {
        return ValError(ERR_NUM)
    }
    return ValNumber(sum)
}

FnSubtotal :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    fun: s32 = 0
    if count < 1 {
        return ValError(ERR_NUM)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    fun = TruncateToS32(CoerceNumber(*args[0]))
    if fun == 1 {
        return FnAverage(st, *args[1], count - 1, *marks[1])
    }
    if fun == 2 {
        return FnCount(st, *args[1], count - 1, *marks[1])
    }
    if fun == 3 {
        return FnCounta(st, *args[1], count - 1, *marks[1])
    }
    if fun == 4 {
        return FnMinMax(st, *args[1], count - 1, *marks[1], 1)
    }
    if fun == 5 {
        return FnMinMax(st, *args[1], count - 1, *marks[1], 0)
    }
    if fun == 6 {
        return FnProduct(st, *args[1], count - 1, *marks[1])
    }
    if fun == 7 {
        return FnVar(st, *args[1], count - 1, *marks[1], 1, 1)
    }
    if fun == 8 {
        return FnVar(st, *args[1], count - 1, *marks[1], 0, 1)
    }
    if fun == 9 {
        return FnSum(st, *args[1], count - 1, *marks[1])
    }
    if fun == 10 {
        return FnVar(st, *args[1], count - 1, *marks[1], 1, 0)
    }
    if fun == 11 {
        return FnVar(st, *args[1], count - 1, *marks[1], 0, 0)
    }
    return ValError(ERR_NUM)
}

SsMedianCalc :: (sorted_data: *float64, len: s32, mid_val: float64, interval: float64) -> float64 {
    l_lower: float64 = mid_val - interval / 2
    l_upper: float64 = mid_val + interval / 2
    f_below: s32 = 0
    f_within: s32 = 0
    i: s32 = 0
    while i < len {
        if sorted_data[i] < l_lower {
            f_below += 1
        } else if sorted_data[i] <= l_upper {
            f_within += 1
        } else {
            break
        }
        i += 1
    }
    return l_lower + ((cast(float64)len / 2.0 - cast(float64)f_below) * interval) / cast(float64)f_within
}

FnSsMedian :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    data: [4096]float64
    gx0: s32 = 0
    gl0: s32 = 0
    gx1: s32 = 0
    gl1: s32 = 0
    n: s32 = 0
    interval: float64 = 1
    if groups < 1 {
        return ValError(ERR_VALUE)
    }
    if groups > 2 {
        return ValError(ERR_NA)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    n = CashList(*args[gx0], gl0, *data[0])
    if n < 0 {
        return ValError(ERR_VALUE)
    }
    if groups >= 2 {
        GroupBounds(marks, count, 1, *gx1, *gl1)
        if gl1 >= 1 {
            interval = CoerceNumber(*args[gx1])
        }
    }
    if interval <= 0 || n == 0 {
        return ValError(ERR_NUM)
    }
    SortDoubles(*data[0], n)
    if n == 1 {
        return ValNumber(data[0])
    }
    if n == 2 {
        return ValNumber((data[0] + data[1]) / 2)
    }
    if (n % 2) == 0 {
        m1: float64 = data[n / 2]
        m0: float64 = data[n / 2 - 1]
        if m0 == m1 {
            return ValNumber(SsMedianCalc(*data[0], n, m1, interval))
        }
        return ValNumber((m0 + m1) / 2)
    }
    return ValNumber(SsMedianCalc(*data[0], n, data[n / 2], interval))
}

GoMatrixDeterminant :: (a: *float64, n: s32) -> float64 {
    qA: QuadMatrix
    qres: Quad
    i: s32 = 0
    j: s32 = 0
    if n < 1 {
        return 0
    }
    qA.m = n
    qA.n = n
    i = 0
    while i < n {
        j = 0
        while j < n {
            QuadInit(*qA.data[i][j], a[i * 16 + j])
            j += 1
        }
        i += 1
    }
    QuadMatrixDeterminant(*qA, *qres)
    return QuadVal(*qres)
}

GoMatrixInvert :: (a: *float64, n: s32) -> s32 {
    qA: QuadMatrix
    qZ: QuadMatrix
    i: s32 = 0
    j: s32 = 0
    qA.m = n
    qA.n = n
    i = 0
    while i < n {
        j = 0
        while j < n {
            QuadInit(*qA.data[i][j], a[i * 16 + j])
            j += 1
        }
        i += 1
    }
    if QuadMatrixInverse(*qA, 256 * 2.220446049250313e-16, *qZ) == 0 {
        return 0
    }
    i = 0
    while i < n {
        j = 0
        while j < n {
            a[i * 16 + j] = QuadVal(*qZ.data[i][j])
            j += 1
        }
        i += 1
    }
    return 1
}

GoLinearSolveMultiple :: (a: *float64, n: s32, b: *float64, bn: s32) -> s32 {
    qA: QuadMatrix
    qr: QuadQR
    i: s32 = 0
    j: s32 = 0
    regres: s32 = 0
    QTb: [16]Quad
    x: [16]Quad
    if n < 1 || bn < 1 {
        return 2
    }
    if n == 1 {
        d0: float64 = a[0]
        if d0 == 0 {
            return 1
        }
        i = 0
        while i < bn {
            b[i] /= d0
            i += 1
        }
        return 0
    }
    qA.m = n
    qA.n = n
    i = 0
    while i < n {
        j = 0
        while j < n {
            QuadInit(*qA.data[i][j], a[i * 16 + j])
            j += 1
        }
        i += 1
    }
    qr = QuadQrNew(*qA)
    regres = 0
    j = 0
    while j < bn {
        i = 0
        while i < n {
            QuadInit(*QTb[i], b[i * 16 + j])
            i += 1
        }
        QuadQrMultiplyQt(*qr, *QTb[0])
        if QuadMatrixBackSolve(*qr.R, *x[0], *QTb[0], 0) != 0 {
            regres = 1
        }
        i = 0
        while i < n {
            b[i * 16 + j] = QuadVal(*x[i])
            i += 1
        }
        j += 1
    }
    return regres
}

MatFromGroup :: (args: *Val, start: s32, len: s32, cols: s32, a: *float64, rows: *s32, out_cols: *s32) -> s32 {
    i: s32 = 0
    r: s32 = 0
    c: s32 = 0
    if cols < 1 {
        return 0
    }
    if (len % cols) != 0 {
        return 0
    }
    r = len / cols
    if r < 1 || r > 16 || cols > 16 {
        return 0
    }
    i = 0
    while i < len {
        v: *Val = *args[start + i]
        if v.kind == VAL_ERROR {
            return -1
        }
        a[(i / cols) * 16 + i % cols] = CoerceNumber(v)
        i += 1
    }
    rows[0] = r
    out_cols[0] = cols
    return 1
}

FnMmult :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    gx1: s32 = 0
    gl1: s32 = 0
    a: [16][16]float64
    b: [16][16]float64
    ar: s32 = 0
    ac: s32 = 0
    br: s32 = 0
    bc: s32 = 0
    ok1: s32 = 0
    ok2: s32 = 0
    acc: QuadAcc
    p: Quad
    sum: float64 = 0
    i: s32 = 0
    if groups < 2 {
        return ValError(ERR_VALUE)
    }
    if groups > 2 {
        return ValError(ERR_NA)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    GroupBounds(marks, count, 1, *gx1, *gl1)
    ok1 = MatFromGroup(args, gx0, gl0, st.call_group_cols[gx0], *a[0][0], *ar, *ac)
    ok2 = MatFromGroup(args, gx1, gl1, st.call_group_cols[gx1], *b[0][0], *br, *bc)
    if ok1 < 0 {
        return ValError(args[gx0].err)
    }
    if ok2 < 0 {
        return ValError(args[gx1].err)
    }
    if ok1 == 0 || ok2 == 0 {
        return ValError(ERR_VALUE)
    }
    if ac != br {
        return ValError(ERR_VALUE)
    }
    i = 0
    while i < ac {
        QuadMul12(*p, a[0][i], b[i][0])
        QuadAccAddQuad(*acc, *p)
        i += 1
    }
    sum = QuadAccValue(*acc)
    return ValNumber(sum)
}

FnMdeterm :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    a: [16][16]float64
    ar: s32 = 0
    ac: s32 = 0
    ok: s32 = 0
    if groups < 1 {
        return ValError(ERR_VALUE)
    }
    if groups > 1 {
        return ValError(ERR_NA)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    ok = MatFromGroup(args, gx0, gl0, st.call_group_cols[gx0], *a[0][0], *ar, *ac)
    if ok < 0 {
        return ValError(args[gx0].err)
    }
    if ok == 0 {
        return ValError(ERR_VALUE)
    }
    if ar != ac {
        return ValError(ERR_VALUE)
    }
    return ValNumber(GoMatrixDeterminant(*a[0][0], ar))
}

FnMinverse :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    a: [16][16]float64
    ar: s32 = 0
    ac: s32 = 0
    ok: s32 = 0
    if groups < 1 {
        return ValError(ERR_VALUE)
    }
    if groups > 1 {
        return ValError(ERR_NA)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    ok = MatFromGroup(args, gx0, gl0, st.call_group_cols[gx0], *a[0][0], *ar, *ac)
    if ok < 0 {
        return ValError(args[gx0].err)
    }
    if ok == 0 {
        return ValError(ERR_VALUE)
    }
    if ar != ac {
        return ValError(ERR_VALUE)
    }
    if GoMatrixInvert(*a[0][0], ar) == 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber(a[0][0])
}

FnLinsolve :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    gx1: s32 = 0
    gl1: s32 = 0
    a: [16][16]float64
    b: [16][16]float64
    ar: s32 = 0
    ac: s32 = 0
    br: s32 = 0
    bc: s32 = 0
    ok1: s32 = 0
    ok2: s32 = 0
    regres: s32 = 0
    if groups < 2 {
        return ValError(ERR_VALUE)
    }
    if groups > 2 {
        return ValError(ERR_NA)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    GroupBounds(marks, count, 1, *gx1, *gl1)
    ok1 = MatFromGroup(args, gx0, gl0, st.call_group_cols[gx0], *a[0][0], *ar, *ac)
    ok2 = MatFromGroup(args, gx1, gl1, st.call_group_cols[gx1], *b[0][0], *br, *bc)
    if ok1 < 0 {
        return ValError(args[gx0].err)
    }
    if ok2 < 0 {
        return ValError(args[gx1].err)
    }
    if ok1 == 0 || ok2 == 0 {
        return ValError(ERR_VALUE)
    }
    if ar != ac || br != ar {
        return ValError(ERR_VALUE)
    }
    regres = GoLinearSolveMultiple(*a[0][0], ar, *b[0][0], bc)
    if regres != 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber(b[0][0])
}

FnTranspose :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    if groups < 1 {
        return ValError(ERR_VALUE)
    }
    if groups > 1 {
        return ValError(ERR_NA)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    if gl0 < 1 {
        return ValError(ERR_VALUE)
    }
    if args[gx0].kind == VAL_ERROR {
        return ValError(args[gx0].err)
    }
    return ValNumber(CoerceNumber(*args[gx0]))
}

FnMunit :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    n: float64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if count > 1 {
        return ValError(ERR_NA)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    n = CoerceNumber(*args[0])
    if n < 1 {
        return ValError(ERR_NUM)
    }
    if n > 5000 {
        return ValError(ERR_NUM)
    }
    return ValNumber(1)
}

FnSortFn :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    gx1: s32 = 0
    gl1: s32 = 0
    data: [4096]float64
    n: s32 = 0
    order: s32 = 0
    if groups < 1 {
        return ValError(ERR_VALUE)
    }
    if groups > 2 {
        return ValError(ERR_NA)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    n = CashList(*args[gx0], gl0, *data[0])
    if n < 0 {
        return ValError(args[gx0].err)
    }
    if groups >= 2 {
        GroupBounds(marks, count, 1, *gx1, *gl1)
        if gl1 >= 1 {
            if args[gx1].kind == VAL_ERROR {
                return ValError(args[gx1].err)
            }
            order = TruncateToS32(CoerceNumber(*args[gx1]))
        }
    }
    if order != 0 && order != 1 {
        return ValError(ERR_VALUE)
    }
    if n == 0 {
        return ValError(ERR_VALUE)
    }
    SortDoubles(*data[0], n)
    if order == 0 {
        return ValNumber(data[n - 1])
    }
    return ValNumber(data[0])
}

RowColEqual :: (args: *Val, start: s32, cols: s32, i: s32, j: s32) -> s32 {
    c: s32 = 0
    while c < cols {
        cmp: s32 = CompareVals(*args[start + i * cols + c], *args[start + j * cols + c])
        if cmp != 0 {
            return 0
        }
        c += 1
    }
    return 1
}

FnUnique :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    gx1: s32 = 0
    gl1: s32 = 0
    gx2: s32 = 0
    gl2: s32 = 0
    cols: s32 = 0
    rows: s32 = 0
    by_col: s32 = 0
    exactly_once: s32 = 0
    ncount: s32 = 0
    keep: [256]s32
    i: s32 = 0
    j: s32 = 0
    first: s32 = -1
    if groups < 1 {
        return ValError(ERR_VALUE)
    }
    if groups > 3 {
        return ValError(ERR_NA)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    if gl0 < 1 {
        return ValError(ERR_VALUE)
    }
    if args[gx0].kind == VAL_ERROR {
        return ValError(args[gx0].err)
    }
    cols = st.call_group_cols[gx0]
    if cols < 1 {
        cols = gl0
    }
    if (gl0 % cols) != 0 {
        return ValError(ERR_VALUE)
    }
    rows = gl0 / cols
    if groups >= 2 {
        GroupBounds(marks, count, 1, *gx1, *gl1)
        if gl1 >= 1 {
            by_col = ifx CoerceNumber(*args[gx1]) != 0 then 1 else 0
        }
    }
    if groups >= 3 {
        GroupBounds(marks, count, 2, *gx2, *gl2)
        if gl2 >= 1 {
            exactly_once = ifx CoerceNumber(*args[gx2]) != 0 then 1 else 0
        }
    }
    ncount = ifx by_col != 0 then cols else rows
    if ncount > 256 {
        ncount = 256
    }
    i = 0
    while i < ncount {
        keep[i] = 1
        i += 1
    }
    i = 0
    while i < ncount {
        j = 0
        while j < i {
            same: s32 = 0
            if by_col != 0 {
                c2: s32 = 0
                same = 1
                while c2 < rows {
                    cmp: s32 = CompareVals(*args[gx0 + c2 * cols + i], *args[gx0 + c2 * cols + j])
                    if cmp != 0 {
                        same = 0
                    }
                    c2 += 1
                }
            } else {
                same = RowColEqual(args, gx0, cols, i, j)
            }
            if same != 0 {
                keep[i] = 0
                if exactly_once != 0 {
                    keep[j] = 0
                }
            }
            j += 1
        }
        i += 1
    }
    i = 0
    while i < ncount {
        if keep[i] != 0 {
            first = i
            break
        }
        i += 1
    }
    if first < 0 {
        return ValError(ERR_VALUE)
    }
    if by_col != 0 {
        return ValNumber(CoerceNumber(*args[gx0 + first]))
    }
    return ValNumber(CoerceNumber(*args[gx0 + first * cols]))
}

EigenMaxIndex :: (matrix: *float64, row: s32, row_n: s32, size: s32) -> s32 {
    i: s32 = 0
    res: s32 = row_n + 1
    maxv: float64 = 0
    if res >= size {
        return size - 1
    }
    maxv = Fabs(matrix[row * 16 + res])
    i = res + 1
    while i < size {
        if Fabs(matrix[row * 16 + i]) > maxv {
            res = i
            maxv = Fabs(matrix[row * 16 + i])
        }
        i += 1
    }
    return res
}

FnEigen :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    a: [16][16]float64
    ar: s32 = 0
    ac: s32 = 0
    ok: s32 = 0
    n: s32 = 0
    c: s32 = 0
    r: s32 = 0
    k: s32 = 0
    i: s32 = 0
    m: s32 = 0
    l: s32 = 0
    state: s32 = 0
    counter: s32 = 0
    ind: [16]s32
    changed: [16]s32
    eigv: [16][16]float64
    eigenvalues: [16]float64
    evsort_val: [16]float64
    evsort_idx: [16]s32
    pivot: float64 = 0
    y: float64 = 0
    t: float64 = 0
    s: float64 = 0
    cc: float64 = 0
    if groups < 1 {
        return ValError(ERR_VALUE)
    }
    if groups > 1 {
        return ValError(ERR_NA)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    ok = MatFromGroup(args, gx0, gl0, st.call_group_cols[gx0], *a[0][0], *ar, *ac)
    if ok < 0 {
        return ValError(args[gx0].err)
    }
    if ok == 0 {
        return ValError(ERR_VALUE)
    }
    if ar != ac {
        return ValError(ERR_VALUE)
    }
    n = ar
    c = 0
    while c < n {
        r = c + 1
        while r < n {
            av: float64 = (a[r][c] + a[c][r]) / 2
            a[r][c] = av
            a[c][r] = av
            r += 1
        }
        c += 1
    }
    state = n
    i = 0
    while i < n {
        j2: s32 = 0
        while j2 < n {
            eigv[j2][i] = 0
            j2 += 1
        }
        eigv[i][i] = 1
        eigenvalues[i] = a[i][i]
        ind[i] = EigenMaxIndex(*a[0][0], i, i, n)
        changed[i] = 1
        i += 1
    }
    while n > 1 && state != 0 {
        counter += 1
        if counter > 400000 {
            return ValError(ERR_NUM)
        }
        m = 0
        k = 1
        while k < (n - 1) {
            if Fabs(a[k][ind[k]]) > Fabs(a[m][ind[m]]) {
                m = k
            }
            k += 1
        }
        l = ind[m]
        pivot = a[m][l]
        if pivot == 0 {
            break
        }
        y = (eigenvalues[l] - eigenvalues[m]) / 2
        t = Fabs(y) + Hypot(pivot, y)
        s = Hypot(pivot, t)
        cc = t / s
        s = pivot / s
        t = (pivot * pivot) / t
        if y < 0 {
            s = -s
            t = -t
        }
        a[m][l] = 0
        i = 0
        while i < n {
            yk: float64 = eigenvalues[i]
            if i == m {
                eigenvalues[i] -= t
            }
            if i == l {
                eigenvalues[i] += t
            }
            unchanged: s32 = ifx yk == eigenvalues[i] then 1 else 0
            if i == m || i == l {
                if changed[i] != 0 && unchanged != 0 {
                    changed[i] = 0
                    state -= 1
                } else if changed[i] == 0 && unchanged == 0 {
                    changed[i] = 1
                    state += 1
                }
            }
            i += 1
        }
        i = 0
        while i < m {
            x2: float64 = cc * a[i][m] - s * a[i][l]
            y2: float64 = s * a[i][m] + cc * a[i][l]
            a[i][m] = x2
            a[i][l] = y2
            i += 1
        }
        i = m + 1
        while i < l {
            x2: float64 = cc * a[m][i] - s * a[i][l]
            y2: float64 = s * a[m][i] + cc * a[i][l]
            a[m][i] = x2
            a[i][l] = y2
            i += 1
        }
        i = l + 1
        while i < n {
            x2: float64 = cc * a[m][i] - s * a[l][i]
            y2: float64 = s * a[m][i] + cc * a[l][i]
            a[m][i] = x2
            a[l][i] = y2
            i += 1
        }
        i = 0
        while i < n {
            x3: float64 = cc * eigv[i][m] - s * eigv[i][l]
            y3: float64 = s * eigv[i][m] + cc * eigv[i][l]
            eigv[i][m] = x3
            eigv[i][l] = y3
            i += 1
        }
        ind[m] = EigenMaxIndex(*a[0][0], m, m, n)
        ind[l] = EigenMaxIndex(*a[0][0], l, l, n)
    }
    i = 0
    while i < n {
        evsort_val[i] = eigenvalues[i]
        evsort_idx[i] = i
        i += 1
    }
    i = 1
    while i < n {
        v2: float64 = evsort_val[i]
        i2: s32 = evsort_idx[i]
        j3: s32 = i - 1
        while j3 >= 0 {
            va: float64 = Fabs(evsort_val[j3])
            vb: float64 = Fabs(v2)
            keep: s32 = 0
            if vb > va {
                keep = 1
            } else if vb < va {
                keep = 0
            } else if v2 > evsort_val[j3] {
                keep = 1
            }
            if keep == 0 {
                break
            }
            evsort_val[j3 + 1] = evsort_val[j3]
            evsort_idx[j3 + 1] = evsort_idx[j3]
            j3 -= 1
        }
        evsort_val[j3 + 1] = v2
        evsort_idx[j3 + 1] = i2
        i += 1
    }
    return ValNumber(eigenvalues[evsort_idx[0]])
}

FnCholesky :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    a: [16][16]float64
    b: [16][16]float64
    ar: s32 = 0
    ac: s32 = 0
    ok: s32 = 0
    n: s32 = 0
    r: s32 = 0
    c: s32 = 0
    k: s32 = 0
    sum: float64 = 0
    if groups < 1 {
        return ValError(ERR_VALUE)
    }
    if groups > 1 {
        return ValError(ERR_NA)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    ok = MatFromGroup(args, gx0, gl0, st.call_group_cols[gx0], *a[0][0], *ar, *ac)
    if ok < 0 {
        return ValError(args[gx0].err)
    }
    if ok == 0 {
        return ValError(ERR_VALUE)
    }
    if ar != ac {
        return ValError(ERR_VALUE)
    }
    n = ar
    c = 0
    while c < n {
        r = c + 1
        while r < n {
            av: float64 = (a[r][c] + a[c][r]) / 2
            a[r][c] = av
            a[c][r] = av
            r += 1
        }
        c += 1
    }
    r = 0
    while r < n {
        c = 0
        while c < r {
            sum = 0
            k = 0
            while k < c {
                sum += b[r][k] * b[c][k]
                k += 1
            }
            b[c][r] = 0
            b[r][c] = (a[r][c] - sum) / b[c][c]
            c += 1
        }
        sum = 0
        k = 0
        while k < r {
            sum += b[r][k] * b[r][k]
            k += 1
        }
        b[r][r] = Sqrt(a[r][r] - sum)
        r += 1
    }
    return ValNumber(b[0][0])
}

CalcScale :: (xs: *float64, m: s32) -> float64 {
    mabs: float64 = 0
    e: s32 = 0
    i: s32 = 1
    if m < 1 {
        return 1
    }
    mabs = Fabs(xs[0])
    i = 1
    while i < m {
        xabs: float64 = Fabs(xs[i])
        if xabs > mabs {
            mabs = xabs
        }
        i += 1
    }
    if mabs == 0 {
        return 1
    }
    Frexp(mabs, *e)
    return Ldexp(1.0, e - 1)
}

GoRangeSumsq :: (xs: *float64, n: s32) -> float64 {
    acc: QuadAcc
    q: Quad
    while n > 0 {
        n -= 1
        QuadMul12(*q, xs[n], xs[n])
        QuadAccAddQuad(*acc, *q)
    }
    return QuadAccValue(*acc)
}

CalcResidual :: (xsst: *float64, ys: *float64, m: s32, n: s32, y: *float64) -> float64 {
    n2: Quad
    d: Quad
    e: Quad
    i: s32 = 0
    j: s32 = 0
    i = 0
    while i < m {
        QuadInit(*d, ys[i])
        j = 0
        while j < n {
            QuadMul12(*e, xsst[j * 64 + i], y[j])
            QuadSub(*d, *d, *e)
            j += 1
        }
        QuadMul(*d, *d, *d)
        QuadAdd(*n2, *n2, *d)
        i += 1
    }
    return QuadVal(*n2)
}

GenLinReg :: (xsst: *float64, dim: s32, ys: *float64, n: s32, affine: s32, result: *float64) -> s32 {
    qss: QuadMatrix
    qr: QuadQR
    xscale: [16]float64
    qty: [64]Quad
    qresult: [16]Quad
    emax: float64 = 0
    emin_dummy: float64 = 0
    df_resid: s32 = 0
    ss_total: float64 = 0
    ss_resid: float64 = 0
    sqr_r: float64 = 0
    i: s32 = 0
    j: s32 = 0
    if dim < 1 || n < 1 {
        return 3
    }
    if dim > n {
        return 3
    }
    if dim > 16 || n > 64 {
        return 3
    }
    qss.m = n
    qss.n = dim
    j = 0
    while j < dim {
        xscale[j] = CalcScale(*xsst[j * 64], n)
        i = 0
        while i < n {
            QuadInit(*qss.data[i][j], xsst[j * 64 + i] / xscale[j])
            i += 1
        }
        j += 1
    }
    qr = QuadQrNew(*qss)
    QuadMatrixEigenRange(*qr.R, *emin_dummy, *emax)
    df_resid = n - dim
    i = 0
    while i < dim {
        ei: float64 = QuadVal(*qr.R.data[i][i])
        if Fabs(ei) >= (emax * (256 * 2.220446049250313e-16)) {
        } else {
            QuadZero(*qr.R.data[i][i])
            df_resid += 1
        }
        i += 1
    }
    i = 0
    while i < n {
        QuadInit(*qty[i], ys[i])
        i += 1
    }
    QuadQrMultiplyQt(*qr, *qty[0])
    QuadMatrixBackSolve(*qr.R, *qresult[0], *qty[0], 1)
    i = 0
    while i < dim {
        result[i] = QuadVal(*qresult[i]) / xscale[i]
        i += 1
    }
    ss_resid = CalcResidual(xsst, ys, n, dim, result)
    if affine != 0 {
        ss_total = StatDevsq(ys, n)
    } else {
        ss_total = GoRangeSumsq(ys, n)
    }
    sqr_r = ifx ss_total == 0 then 1 else (1 - ss_resid / ss_total)
    if sqr_r < 0 {
        return 1
    }
    return 0
}

CollectStrictGroup :: (args: *Val, start: s32, len: s32, out: *float64) -> s32 {
    n: s32 = 0
    i: s32 = 0
    while i < len {
        v: *Val = *args[start + i]
        if v.kind == VAL_ERROR {
            return -1
        }
        if v.kind != VAL_FLOAT {
            return -2
        }
        if n < 4096 {
            out[n] = v.number
            n += 1
        }
        i += 1
    }
    return n
}

FnLinEstLogEst :: (st: *EvalState, args: *Val, count: s32, marks: *s32, want_exp: s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    gx1: s32 = 0
    gl1: s32 = 0
    gx2: s32 = 0
    gl2: s32 = 0
    gx3: s32 = 0
    gl3: s32 = 0
    ys: [64]float64
    xscols: [64]float64
    xsst: [17][64]float64
    n: s32 = 0
    ny2: s32 = 0
    dim: s32 = 1
    rtype: s32 = 0
    affine: s32 = 1
    xcols: s32 = 0
    ycols: s32 = 0
    xrows: s32 = 0
    yrows: s32 = 0
    linres: [17]float64
    regres: s32 = 0
    i: s32 = 0
    j: s32 = 0
    if groups < 1 {
        return ValError(ERR_VALUE)
    }
    if groups > 4 {
        return ValError(ERR_NA)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    n = CollectStrictGroup(args, gx0, gl0, *ys[0])
    if n == -1 {
        return ValError(args[gx0].err)
    }
    if n < -1 {
        return ValError(ERR_VALUE)
    }
    if n < 1 {
        return ValError(ERR_VALUE)
    }
    if n > 64 {
        return ValError(ERR_VALUE)
    }
    ycols = st.call_group_cols[gx0]
    if ycols < 1 {
        ycols = n
    }
    yrows = gl0 / ycols
    if groups >= 2 {
        GroupBounds(marks, count, 1, *gx1, *gl1)
        if gl1 >= 1 && args[gx1].kind == VAL_EMPTY {
            return ValError(ERR_REF)
        }
        ny2 = CollectStrictGroup(args, gx1, gl1, *xscols[0])
        if ny2 == -1 {
            return ValError(args[gx1].err)
        }
        if ny2 < -1 {
            return ValError(ERR_VALUE)
        }
        xcols = st.call_group_cols[gx1]
        if xcols < 1 {
            xcols = gl1
        }
        xrows = gl1 / xcols
        if ycols == 1 {
            if xrows != yrows {
                return ValError(ERR_REF)
            }
            dim = xcols
            rtype = 1
            i = 0
            while i < dim {
                j = 0
                while j < ny2 {
                    xsst[i + 1][j] = xscols[j * xcols + i]
                    j += 1
                }
                i += 1
            }
        } else if yrows == 1 {
            if xcols != ycols {
                return ValError(ERR_REF)
            }
            dim = xrows
            rtype = 2
            i = 0
            while i < dim {
                j = 0
                while j < ny2 {
                    xsst[i + 1][j] = xscols[i * xcols + j]
                    j += 1
                }
                i += 1
            }
        } else {
            if xrows != yrows || xcols != ycols {
                return ValError(ERR_REF)
            }
            dim = 1
            rtype = 0
            i = 0
            while i < n {
                xsst[1][i] = xscols[i]
                i += 1
            }
        }
    } else {
        i = 0
        while i < n {
            xsst[1][i] = cast(float64)(i + 1)
            i += 1
        }
    }
    if dim > 16 {
        return ValError(ERR_VALUE)
    }
    if groups >= 3 {
        GroupBounds(marks, count, 2, *gx2, *gl2)
        if gl2 >= 1 {
            affine = ifx CoerceNumber(*args[gx2]) != 0 then 1 else 0
        }
    }
    if want_exp != 0 {
        i = 0
        while i < n {
            if ys[i] <= 0 {
                return ValError(ERR_NUM)
            }
            ys[i] = Log(ys[i])
            i += 1
        }
    }
    if affine != 0 {
        i = 0
        while i < n {
            xsst[0][i] = 1
            i += 1
        }
        regres = GenLinReg(*xsst[0][0], dim + 1, *ys[0], n, 1, *linres[0])
    } else {
        linres[0] = 0
        regres = GenLinReg(*xsst[1][0], dim, *ys[0], n, 0, *linres[1])
    }
    if regres != 0 {
        return ValError(ERR_NUM)
    }
    if want_exp != 0 {
        i = 0
        while i < (dim + 1) {
            linres[i] = Exp(linres[i])
            i += 1
        }
    }
    return ValNumber(linres[dim])
}

FnTrend :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    gx1: s32 = 0
    gl1: s32 = 0
    gx3: s32 = 0
    gl3: s32 = 0
    ys: [64]float64
    xscols: [64]float64
    nxs: [64]float64
    xsst: [17][64]float64
    linres: [17]float64
    n: s32 = 0
    nx2: s32 = 0
    dim: s32 = 1
    rtype: s32 = 0
    affine: s32 = 1
    xcols: s32 = 0
    ycols: s32 = 0
    xrows: s32 = 0
    yrows: s32 = 0
    regres: s32 = 0
    i: s32 = 0
    j: s32 = 0
    res: float64 = 0
    if groups < 1 {
        return ValError(ERR_VALUE)
    }
    if groups > 4 {
        return ValError(ERR_NA)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    n = CollectStrictGroup(args, gx0, gl0, *ys[0])
    if n == -1 {
        return ValError(args[gx0].err)
    }
    if n < -1 {
        return ValError(ERR_VALUE)
    }
    if n < 1 || n > 64 {
        return ValError(ERR_VALUE)
    }
    ycols = st.call_group_cols[gx0]
    if ycols < 1 {
        ycols = n
    }
    yrows = gl0 / ycols
    if groups >= 2 {
        GroupBounds(marks, count, 1, *gx1, *gl1)
        if gl1 >= 1 && args[gx1].kind == VAL_EMPTY {
            return ValError(ERR_REF)
        }
        nx2 = CollectStrictGroup(args, gx1, gl1, *xscols[0])
        if nx2 == -1 {
            return ValError(args[gx1].err)
        }
        if nx2 < -1 {
            return ValError(ERR_VALUE)
        }
        xcols = st.call_group_cols[gx1]
        if xcols < 1 {
            xcols = gl1
        }
        xrows = gl1 / xcols
        if ycols == 1 {
            if xrows != yrows {
                return ValError(ERR_REF)
            }
            dim = xcols
            rtype = 1
        } else if yrows == 1 {
            if xcols != ycols {
                return ValError(ERR_REF)
            }
            dim = xrows
            rtype = 2
        } else {
            if xrows != yrows || xcols != ycols {
                return ValError(ERR_REF)
            }
            dim = 1
            rtype = 0
        }
        i = 0
        while i < dim {
            j = 0
            while j < nx2 {
                if rtype == 2 {
                    xsst[i + 1][j] = xscols[i * xcols + j]
                } else {
                    xsst[i + 1][j] = xscols[j * xcols + i]
                }
                j += 1
            }
            i += 1
        }
    } else {
        i = 0
        while i < n {
            xsst[1][i] = cast(float64)(i + 1)
            i += 1
        }
    }
    if dim == 1 {
        rtype = 0
    }
    if dim > 16 {
        return ValError(ERR_VALUE)
    }
    if groups >= 4 {
        GroupBounds(marks, count, 3, *gx3, *gl3)
        if gl3 >= 1 {
            affine = ifx CoerceNumber(*args[gx3]) != 0 then 1 else 0
        }
    }
    if affine != 0 {
        i = 0
        while i < n {
            xsst[0][i] = 1
            i += 1
        }
        regres = GenLinReg(*xsst[0][0], dim + 1, *ys[0], n, 1, *linres[0])
    } else {
        linres[0] = 0
        regres = GenLinReg(*xsst[1][0], dim, *ys[0], n, 0, *linres[1])
    }
    if regres != 0 {
        return ValError(ERR_NUM)
    }
    if groups >= 3 {
        gxn: s32 = 0
        gln: s32 = 0
        GroupBounds(marks, count, 2, *gxn, *gln)
        nx2 = CollectStrictGroup(args, gxn, gln, *nxs[0])
        if nx2 == -1 {
            return ValError(args[gxn].err)
        }
        if nx2 < -1 {
            return ValError(ERR_VALUE)
        }
        if rtype == 1 {
            if dim != st.call_group_cols[gxn] {
                return ValError(ERR_NUM)
            }
        }
        res = linres[0]
        if rtype == 1 {
            j = 0
            while j < dim {
                res += nxs[j] * linres[j + 1]
                j += 1
            }
        } else {
            res += nxs[0] * linres[1]
        }
        return ValNumber(res)
    }
    if groups >= 2 {
        res = linres[0]
        if rtype == 1 {
            j = 0
            while j < dim {
                res += xscols[j] * linres[j + 1]
                j += 1
            }
        } else if rtype == 2 {
            res += xscols[0] * linres[1]
        } else {
            res += xscols[0] * linres[1]
        }
        return ValNumber(res)
    }
    return ValNumber(linres[0] + 1 * linres[1])
}

FnGrowth :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    gx1: s32 = 0
    gl1: s32 = 0
    gx2: s32 = 0
    gl2: s32 = 0
    gx3: s32 = 0
    gl3: s32 = 0
    ys: [64]float64
    xs: [64]float64
    nxs: [64]float64
    xsst: [17][64]float64
    expres: [17]float64
    n: s32 = 0
    nx2: s32 = 0
    affine: s32 = 1
    regres: s32 = 0
    i: s32 = 0
    if groups < 1 {
        return ValError(ERR_VALUE)
    }
    if groups > 4 {
        return ValError(ERR_NA)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    n = CollectStrictGroup(args, gx0, gl0, *ys[0])
    if n == -1 {
        return ValError(args[gx0].err)
    }
    if n < -1 {
        return ValError(ERR_VALUE)
    }
    if n < 1 || n > 64 {
        return ValError(ERR_VALUE)
    }
    if groups >= 2 {
        GroupBounds(marks, count, 1, *gx1, *gl1)
        if gl1 >= 1 && args[gx1].kind == VAL_EMPTY {
            return ValError(ERR_REF)
        }
        nx2 = CollectStrictGroup(args, gx1, gl1, *xs[0])
        if nx2 == -1 {
            return ValError(args[gx1].err)
        }
        if nx2 < -1 {
            return ValError(ERR_VALUE)
        }
        if nx2 != n {
            return ValError(ERR_NUM)
        }
    } else {
        i = 0
        while i < n {
            xs[i] = cast(float64)(i + 1)
            i += 1
        }
    }
    if groups >= 3 {
        GroupBounds(marks, count, 2, *gx2, *gl2)
        nx2 = CollectStrictGroup(args, gx2, gl2, *nxs[0])
        if nx2 == -1 {
            return ValError(args[gx2].err)
        }
        if nx2 < -1 {
            return ValError(ERR_VALUE)
        }
    } else {
        i = 0
        while i < n {
            nxs[i] = xs[i]
            i += 1
        }
        nx2 = n
    }
    if nx2 < 1 {
        return ValError(ERR_NUM)
    }
    if groups >= 4 {
        GroupBounds(marks, count, 3, *gx3, *gl3)
        if gl3 >= 1 {
            affine = ifx CoerceNumber(*args[gx3]) != 0 then 1 else 0
        }
    }
    i = 0
    while i < n {
        if ys[i] <= 0 {
            return ValError(ERR_NUM)
        }
        ys[i] = Log(ys[i])
        xsst[1][i] = xs[i]
        i += 1
    }
    if affine != 0 {
        i = 0
        while i < n {
            xsst[0][i] = 1
            i += 1
        }
        regres = GenLinReg(*xsst[0][0], 2, *ys[0], n, 1, *expres[0])
    } else {
        expres[0] = 0
        regres = GenLinReg(*xsst[1][0], 1, *ys[0], n, 0, *expres[1])
    }
    if regres != 0 {
        return ValError(ERR_NUM)
    }
    i = 0
    while i < 2 {
        expres[i] = Exp(expres[i])
        i += 1
    }
    return ValNumber(Pow(expres[1], nxs[0]) * expres[0])
}

NtAddMod :: (a: u64, b: u64, m: u64) -> u64 {
    if a < (m - b) {
        return a + b
    }
    return a - (m - b)
}

NtMulMod :: (a: u64, b: u64, m: u64) -> u64 {
    res: u64 = 0
    a = a % m
    while b > 0 {
        if (b & 1) != 0 {
            res = NtAddMod(res, a, m)
        }
        a = NtAddMod(a, a, m)
        b = b >> 1
    }
    return res
}

NtPowMod :: (a: u64, b: u64, m: u64) -> u64 {
    res: u64 = 1
    a = a % m
    while b > 0 {
        if (b & 1) != 0 {
            res = NtMulMod(res, a, m)
        }
        a = NtMulMod(a, a, m)
        b = b >> 1
    }
    return res
}

NtMillerRabin :: (n: u64, a: u64) -> s32 {
    d: u64 = n - 1
    s: s32 = 0
    x: u64 = 0
    while (d % 2) == 0 {
        d /= 2
        s += 1
    }
    x = NtPowMod(a, d, n)
    if x == 1 || x == (n - 1) {
        return 1
    }
    while s > 1 {
        x = NtMulMod(x, x, n)
        if x == (n - 1) {
            return 1
        }
        s -= 1
    }
    return 0
}

NtIsPrime :: (n: u64) -> s32 {
    bases: [9]s32 = .[2, 3, 5, 7, 11, 13, 17, 19, 23]
    i: s32 = 0
    if n < 2 {
        return 0
    }
    if n == 2 || n == 3 {
        return 1
    }
    if (n % 2) == 0 || (n % 3) == 0 {
        return 0
    }
    i = 0
    while i < 9 {
        bn: u64 = cast(u64)bases[i]
        if n == bn {
            return 1
        }
        if NtMillerRabin(n, bn) == 0 {
            return 0
        }
        i += 1
    }
    return 1
}

NtBuildPrimes :: (want: s32) {
    c: s32 = 3
    i: s32 = 0
    if NT_COUNT == 0 {
        NT_PRIMES[0] = 2
        NT_COUNT = 1
    }
    if NT_COUNT > 1 {
        c = NT_PRIMES[NT_COUNT - 1] + 2
    }
    while NT_COUNT < want {
        isp: s32 = 1
        i = 0
        while i < NT_COUNT {
            p: s32 = NT_PRIMES[i]
            if (p * p) > c {
                break
            }
            if (c % p) == 0 {
                isp = 0
                break
            }
            i += 1
        }
        if isp != 0 {
            NT_PRIMES[NT_COUNT] = c
            NT_COUNT += 1
        }
        c += 2
    }
}

NtIthPrime :: (i: s32, res: *u64) -> s32 {
    if i < 1 || i > 10000 {
        return 1
    }
    if NT_COUNT < i {
        NtBuildPrimes(i)
    }
    res[0] = cast(u64)NT_PRIMES[i - 1]
    return 0
}

NtPrimeFactor :: (n: u64) -> u64 {
    i: s32 = 1
    p: u64 = 2
    if n <= 1 {
        return 0
    }
    while (p * p) <= n {
        if NtIthPrime(i, *p) != 0 {
            return 0
        }
        if (n % p) == 0 {
            return p
        }
        i += 1
    }
    return n
}

FnIsPrime :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    i: float64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    i = Floor(CoerceNumber(*args[0]))
    if i < 0 {
        return ValBool(0)
    }
    if i > 9007199254740992.0 {
        return ValError(ERR_LIMIT)
    }
    return ValBool(NtIsPrime(TruncateToU64(i)))
}

FnIthPrime :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    i: float64 = 0
    p: u64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    i = Floor(CoerceNumber(*args[0]))
    if i < 1 || i > 2147483647.0 {
        return ValError(ERR_NUM)
    }
    if NtIthPrime(TruncateToS32(i), *p) != 0 {
        return ValError(ERR_LIMIT)
    }
    return ValNumber(cast(float64)p)
}

FnPfactor :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    n: float64 = 0
    p: u64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    n = Floor(CoerceNumber(*args[0]))
    if n < 2 {
        return ValError(ERR_VALUE)
    }
    if n > 9007199254740992.0 {
        return ValError(ERR_LIMIT)
    }
    p = NtPrimeFactor(TruncateToU64(n))
    if p == 0 {
        return ValError(ERR_LIMIT)
    }
    return ValNumber(cast(float64)p)
}

PochhammerNaive :: (x: float64, n: s32) -> float64 {
    qp: Quad = Quad.{1, 0}
    qx: Quad
    one: Quad = Quad.{1, 0}
    r: float64 = 0
    QuadInit(*qx, x)
    while n > 0 {
        QuadMul(*qp, *qp, *qx)
        QuadAdd(*qx, *qx, *one)
        n -= 1
    }
    r = QuadVal(*qp)
    return r
}

PochhammerHammer :: (x: float64, n: float64) -> float64 {
    rn: float64 = 0
    rx: float64 = 0
    m1: Quad
    m2: Quad
    e1: s32 = 0
    e2: s32 = 0
    qr: Quad
    r: float64 = 0
    de: s32 = 0
    if n != n || x != x {
        return 0.0 / 0.0
    }
    if n == 0 {
        return 1
    }
    rx = Floor(x)
    rn = Floor(n)
    if n == rn && x != rx && n >= 0 && n < 40 {
        return PochhammerNaive(x, TruncateToS32(n))
    }
    if qfactf(x + n - 1, *m1, *e1) == 0 && qfactf(x - 1, *m2, *e2) == 0 {
        de = e1 - e2
        QuadDiv(*qr, *m1, *m2)
        r = QuadVal(*qr)
        return Ldexp(r, de)
    }
    if x == rx && x <= 0 {
        if n != rn {
            return 0
        }
        if x == 0 {
            if n > 0 {
                return 0
            }
            return (ifx Fmod(0 - n, 2) == 0 then 1.0 else (-1.0)) / gnm_fact_port(cast(float64)TruncateToS32(0 - n))
        }
        if n > (0 - x) {
            return 0.0 / 0.0
        }
    }
    if Fabs(x) < 1 {
        return 1e308 * 10
    }
    if n < 0 {
        return 1 / PochhammerHammer(x + n, 0 - n)
    }
    if n == rn && n >= 0 && n < 100 {
        return PochhammerNaive(x, TruncateToS32(n))
    }
    return 0.0 / 0.0
}

FnPermut :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    n: float64 = 0
    k: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    n = FormulaFakeFloor(CoerceNumber(*args[0]))
    k = FormulaFakeFloor(CoerceNumber(*args[1]))
    if 0 <= k && k <= n {
        return ValNumber(PochhammerHammer(n - k + 1, k))
    }
    return ValError(ERR_NUM)
}

FnPermutationA :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    x: float64 = 0
    y: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    x = FormulaFakeFloor(CoerceNumber(*args[0]))
    y = FormulaFakeFloor(CoerceNumber(*args[1]))
    if x < 0 || y < 0 {
        return ValError(ERR_NUM)
    }
    if y == 0 {
        return ValNumber(1)
    }
    return ValNumber(Pow(x, y))
}

FnSeriesSum :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx3: s32 = 0
    gl3: s32 = 0
    data: [4096]float64
    n: s32 = 0
    x: float64 = 0
    nn: float64 = 0
    m: float64 = 0
    x_m: float64 = 0
    sum: float64 = 0
    i: s32 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    if args[2].kind == VAL_ERROR {
        return ValError(args[2].err)
    }
    x = CoerceNumber(*args[0])
    nn = CoerceNumber(*args[1])
    m = CoerceNumber(*args[2])
    if groups < 1 {
        return ValError(ERR_VALUE)
    }
    GroupBounds(marks, count, groups - 1, *gx3, *gl3)
    i = 0
    while i < gl3 {
        v: *Val = *args[gx3 + i]
        if v.kind == VAL_ERROR {
            return ValError(v.err)
        }
        if v.kind == VAL_EMPTY {
            i += 1
            continue
        }
        if v.kind != VAL_FLOAT {
            return ValError(ERR_VALUE)
        }
        if n < 4096 {
            data[n] = v.number
            n += 1
        }
        i += 1
    }
    if x == 0 {
        if nn <= 0 || (nn + cast(float64)(n - 1) * m) <= 0 {
            return ValError(ERR_NUM)
        }
        return ValNumber(0)
    }
    x_m = Pow(x, m)
    x = Pow(x, nn)
    i = 0
    while i < n {
        sum += data[i] * x
        x *= x_m
        i += 1
    }
    if IsFinite(sum) == 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber(sum)
}

FnLn1p :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    t: float64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    t = CoerceNumber(*args[0])
    if t <= -1 {
        return ValError(ERR_NUM)
    }
    return ValNumber(Log1p(t))
}

FnSechCsch :: (st: *EvalState, args: *Val, count: s32, marks: *s32, which: s32) -> Val {
    x: float64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    x = CoerceNumber(*args[0])
    if which == 0 {
        return ValNumber(1 / Cosh(x))
    }
    return ValNumber(1 / Sinh(x))
}

GammaErrorFactor :: (res: *Quad, x: *Quad) {
    num: [9]float64 = .[1, 1, -139, -571, 163879, 5246819, -534703531, -4483131259, 432261921612371]
    den: [9]float64 = .[12, 288, 51840, 2488320, 209018880, 75246796800, 902961561600, 86684309913600, 514904800886784000]
    zn: Quad
    xpn: Quad
    t: Quad
    c: Quad
    xval: float64 = 0
    n: s32 = 0
    i: s32 = 0
    xval = QuadVal(x)
    if xval < 20 {
        n = TruncateToS32(Floor(21 - xval))
    } else {
        n = 0
    }
    QuadInit(*xpn, cast(float64)n)
    QuadAdd(*xpn, *xpn, x)
    QuadInit(*zn, 1)
    res[0] = zn
    i = 0
    while i < 9 {
        QuadMul(*zn, *zn, *xpn)
        QuadInit(*c, den[i])
        QuadMul(*t, *zn, *c)
        QuadInit(*c, num[i])
        QuadDiv(*t, *c, *t)
        QuadAdd(res, res, *t)
        i += 1
    }
    if n > 0 {
        en: Quad
        xxn: Quad
        xph: Quad
        xpi: Quad
        i = 1
        while i < n {
            QuadInit(*xpi, cast(float64)i)
            QuadAdd(*xpi, *xpi, x)
            QuadDiv(res, res, *xpi)
            QuadMul(res, res, *xpn)
            i += 1
        }
        QuadInit(*en, cast(float64)n)
        QuadExp(*en, null, *en)
        QuadDiv(res, res, *en)
        QuadInit(*xph, 0.5)
        QuadAdd(*xph, *xph, x)
        QuadDiv(*xxn, x, *xpn)
        QuadPow(*xxn, null, *xxn, *xph)
        QuadDiv(res, res, *xxn)
    }
}

PochhammerSmallN :: (x: float64, n: float64, res: *Quad) {
    qx: Quad
    qn: Quad
    qr: Quad
    qs: Quad
    f1: Quad
    f2: Quad
    f3: Quad
    f4: Quad
    f5: Quad
    r: float64 = 0
    QuadInit(*qx, x)
    QuadInit(*qn, n)
    QuadDiv(*qr, *qn, *qx)
    r = QuadVal(*qr)
    QuadAdd(*qs, *qx, *qn)
    QuadMul12(*f1, Log1pmx(r), x)
    QuadExp(*f1, null, *f1)
    QuadInit(*f2, 1)
    QuadAdd(*f2, *f2, *qr)
    QuadSqrt(*f2, *f2)
    QuadPow(*f3, null, *qs, *qn)
    GammaErrorFactor(*f4, *qs)
    GammaErrorFactor(*f5, *qx)
    QuadDiv(res, *f1, *f2)
    QuadMul(res, res, *f3)
    QuadMul(res, res, *f4)
    QuadDiv(res, res, *f5)
}

QGammaF :: (x: float64, mant: *Quad, expb: *s32) -> s32 {
    qx: Quad
    if x < -1.5 || x > 0.5 {
        return qfactf(x - 1, mant, expb)
    }
    if x != x || x == Floor(x) {
        expb[0] = 0
        mant.h = 0.0 / 0.0
        mant.l = 0.0 / 0.0
        return 2
    }
    qfactf(x, mant, expb)
    QuadInit(*qx, x)
    QuadDiv(mant, mant, *qx)
    rescale_mantexp(mant, expb)
    return 0
}

QBetaF :: (a: float64, b: float64, mant: *Quad, expb: *s32) -> s32 {
    ma: Quad
    mb: Quad
    mab: Quad
    ea: s32 = 0
    eb: s32 = 0
    eab: s32 = 0
    s: float64 = 0
    ab: float64 = a + b
    if ab != ab || (a <= 0 && a == Floor(a)) || (b <= 0 && b == Floor(b)) {
        return 2
    }
    if ab <= 0 && ab == Floor(ab) {
        QuadInit(mant, 0)
        expb[0] = 0
        return 0
    }
    if b > a {
        s = a
        a = b
        b = s
    }
    if a > 1 && Fabs(b) < 1 {
        if QGammaF(b, *mb, *eb) != 0 {
            return 1
        }
        PochhammerSmallN(a, b, *ma)
        QuadDiv(mant, *mb, *ma)
        expb[0] = eb
        return 0
    }
    if QGammaF(a, *ma, *ea) == 0 && QGammaF(b, *mb, *eb) == 0 && QGammaF(ab, *mab, *eab) == 0 {
        QuadMul(*ma, *ma, *mb)
        QuadDiv(mant, *ma, *mab)
        expb[0] = ea + eb - eab
        rescale_mantexp(mant, expb)
        return 0
    }
    return 1
}

FnBeta :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    a: float64 = 0
    b: float64 = 0
    r: Quad
    e: s32 = 0
    rc: s32 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    a = CoerceNumber(*args[0])
    b = CoerceNumber(*args[1])
    rc = QBetaF(a, b, *r, *e)
    if rc == 0 {
        return ValNumber(Ldexp(QuadVal(*r), e))
    }
    if rc == 1 {
        return ValNumber(1e308 * 10)
    }
    return ValError(ERR_NUM)
}

GoAtanPi :: (x: float64) -> float64 {
    if x < 0 {
        return 0 - Atan2(0 - x, 1.0) / 3.14159265358979323846
    }
    return Atan2(x, 1.0) / 3.14159265358979323846
}

OwentT1 :: (h: float64, a: float64, order: s32) -> float64 {
    hs: float64 = -0.5 * (h * h)
    dhs: float64 = Exp(hs)
    as: float64 = a * a
    aj: float64 = a / (3.14159265358979323846 * 2)
    dj: float64 = Expm1(hs)
    gj: float64 = hs * dhs
    res: float64 = GoAtanPi(a) / 2
    j: s32 = 1
    while j <= order {
        res += (dj * aj) / cast(float64)(j + j - 1)
        aj *= as
        dj = gj - dj
        gj *= hs / cast(float64)(j + 1)
        j += 1
    }
    return res
}

OwentT2 :: (h: float64, a: float64, order: s32) -> float64 {
    ah: float64 = a * h
    as: float64 = 0 - a * a
    y: float64 = 1 / (h * h)
    val: float64 = 0
    vi: float64 = a * dnorm_go(ah, 0, 1, 0)
    z: float64 = Erf(ah / 1.414213562373095048801688724209) / (2 * h)
    i: s32 = 1
    while i <= (2 * order + 1) {
        val += z
        z = y * (vi - cast(float64)i * z)
        vi *= as
        i += 2
    }
    return val * dnorm_go(h, 0, 1, 0)
}

OwentT3 :: (h: float64, a: float64, order: s32) -> float64 {
    c2: [21]float64 = .[0.99999999999999987510, -0.99999999999988796462, 0.99999999998290743652, -0.99999999896282500134, 0.99999996660459362918, -0.99999933986272476760, 0.99999125611136965852, -0.99991777624463387686, 0.99942835555870132569, -0.99697311720723000295, 0.98751448037275303682, -0.95915857980572882813, 0.89246305511006708555, -0.76893425990463999675, 0.58893528468484693250, -0.38380345160440256652, 0.20317601701045299653, -0.82813631607004984866E-01, 0.24167984735759576523E-01, -0.44676566663971825242E-02, 0.39141169402373836468E-03]
    ah: float64 = a * h
    as: float64 = a * a
    y: float64 = 1 / (h * h)
    vi: float64 = a * dnorm_go(ah, 0, 1, 0)
    zi: float64 = Erf(ah / 1.414213562373095048801688724209) / (2 * h)
    val: float64 = 0
    i: s32 = 0
    while i <= order {
        val += zi * c2[i]
        zi = y * (cast(float64)(i + i + 1) * zi - vi)
        vi *= as
        i += 1
    }
    return val * dnorm_go(h, 0, 1, 0)
}

OwentT4 :: (h: float64, a: float64, order: s32) -> float64 {
    hs: float64 = h * h
    as: float64 = 0 - a * a
    ai: float64 = (a * Exp(-0.5 * hs * (1 - as))) / (2 * 3.14159265358979323846)
    yi: float64 = 1
    val: float64 = 0
    i: s32 = 1
    while i <= (2 * order + 1) {
        val += ai * yi
        yi = (1 - hs * yi) / cast(float64)(i + 2)
        ai *= as
        i += 2
    }
    return val
}

OwentT5 :: (h: float64, a: float64, order: s32) -> float64 {
    pts: [13]float64 = .[0.35082039676451715489E-02, 0.31279042338030753740E-01, 0.85266826283219451090E-01, 0.16245071730812277011, 0.25851196049125434828, 0.36807553840697533536, 0.48501092905604697475, 0.60277514152618576821, 0.71477884217753226516, 0.81475510988760098605, 0.89711029755948965867, 0.95723808085944261843, 0.99178832974629703586]
    wts: [13]float64 = .[0.18831438115323502887E-01, 0.18567086243977649478E-01, 0.18042093461223385584E-01, 0.17263829606398753364E-01, 0.16243219975989856730E-01, 0.14994592034116704829E-01, 0.13535474469662088392E-01, 0.11886351605820165233E-01, 0.10070377242777431897E-01, 0.81130545742299586629E-02, 0.60419009528470238773E-02, 0.38862217010742057883E-02, 0.16793031084546090448E-02]
    as: float64 = a * a
    hs: float64 = -0.5 * h * h
    val: float64 = 0
    i: s32 = 0
    while i < order {
        r: float64 = 1 + as * pts[i]
        val += (wts[i] * Exp(hs * r)) / r
        i += 1
    }
    return val * a
}

OwentT6 :: (h: float64, a: float64, order: s32) -> float64 {
    normh: float64 = pnorm(h, 0, 1, 0, 0)
    normhc: float64 = 1 - normh
    y: float64 = 1 - a
    r: float64 = Atan2(y, 1 + a)
    val: float64 = 0.5 * normh * normhc
    if r != 0 {
        val -= (r * Exp((-0.5 * y * h * h) / r)) / (2 * 3.14159265358979323846)
    }
    return val
}

OwentHelper :: (h: float64, a: float64) -> float64 {
    hrange: [15]float64 = .[0.02, 0.06, 0.09, 0.125, 0.26, 0.4, 0.6, 1.6, 1.7, 2.33, 2.4, 3.36, 3.4, 4.8, 1e308]
    arange: [8]float64 = .[0.025, 0.09, 0.15, 0.36, 0.5, 0.9, 0.99999, 1e308]
    method: [120]s32 = .[1, 1, 2, 13, 13, 13, 13, 13, 13, 13, 13, 16, 16, 16, 9, 1, 2, 2, 3, 3, 5, 5, 14, 14, 15, 15, 16, 16, 16, 9, 2, 2, 3, 3, 3, 5, 5, 15, 15, 15, 15, 16, 16, 16, 10, 2, 2, 3, 5, 5, 5, 5, 7, 7, 16, 16, 16, 16, 16, 10, 2, 3, 3, 5, 5, 6, 6, 8, 8, 17, 17, 17, 12, 12, 11, 2, 3, 5, 5, 5, 6, 6, 8, 8, 17, 17, 17, 12, 12, 12, 2, 3, 4, 4, 6, 6, 8, 8, 17, 17, 17, 17, 17, 12, 12, 2, 3, 4, 4, 6, 6, 18, 18, 18, 18, 17, 17, 17, 12, 12]
    ai: s32 = 0
    hi: s32 = 0
    ai = 0
    while ai < 8 {
        if a <= arange[ai] {
            break
        }
        ai += 1
    }
    hi = 0
    while hi < 15 {
        if h <= hrange[hi] {
            break
        }
        hi += 1
    }
    m2: s32 = method[ai * 15 + hi]
    if m2 == 1 {
        return OwentT1(h, a, 2)
    }
    if m2 == 2 {
        return OwentT1(h, a, 3)
    }
    if m2 == 3 {
        return OwentT1(h, a, 4)
    }
    if m2 == 4 {
        return OwentT1(h, a, 5)
    }
    if m2 == 5 {
        return OwentT1(h, a, 7)
    }
    if m2 == 6 {
        return OwentT1(h, a, 10)
    }
    if m2 == 7 {
        return OwentT1(h, a, 12)
    }
    if m2 == 8 {
        return OwentT1(h, a, 18)
    }
    if m2 == 9 {
        return OwentT2(h, a, 10)
    }
    if m2 == 10 {
        return OwentT2(h, a, 20)
    }
    if m2 == 11 {
        return OwentT2(h, a, 30)
    }
    if m2 == 12 {
        return OwentT3(h, a, 20)
    }
    if m2 == 13 {
        return OwentT4(h, a, 4)
    }
    if m2 == 14 {
        return OwentT4(h, a, 7)
    }
    if m2 == 15 {
        return OwentT4(h, a, 8)
    }
    if m2 == 16 {
        return OwentT4(h, a, 20)
    }
    if m2 == 17 {
        return OwentT5(h, a, 13)
    }
    return OwentT6(h, a, 0)
}

OwentT :: (h: float64, a: float64) -> float64 {
    res: float64 = 0
    neg: s32 = 0
    h = Fabs(h)
    neg = ifx a < 0 then 1 else 0
    a = Fabs(a)
    if a == 0 {
        res = 0
    } else if h == 0 {
        res = GoAtanPi(a) / 2
    } else if a == 1 {
        res = 0.5 * pnorm(h, 0, 1, 1, 0) * pnorm(h, 0, 1, 0, 0)
    } else if a <= 1 {
        res = OwentHelper(h, a)
    } else {
        ah: float64 = h * a
        if h <= 0.67 {
            nh: float64 = 0.5 * Erf(h / 1.414213562373095048801688724209)
            nah: float64 = 0.5 * Erf(ah / 1.414213562373095048801688724209)
            res = 0.25 - nh * nah - OwentHelper(ah, 1 / a)
        } else {
            nh: float64 = pnorm(h, 0, 1, 0, 0)
            nah: float64 = pnorm(ah, 0, 1, 0, 0)
            res = 0.5 * (nh + nah) - nh * nah - OwentHelper(ah, 1 / a)
        }
    }
    if neg != 0 {
        res = 0 - res
    }
    return res
}

CxTemmeD :: (a: Cplx, z: Cplx) -> Cplx {
    t: Cplx
    t = CxDiv(CxPow(z, a), CxExp(z))
    f: Cplx = CxMul(CxGamma(a), a)
    return CxDiv(t, f)
}

CxIgammaLowerCoefs :: (ai: *Cplx, bi: *Cplx, i: s32, a: *Cplx, z: *Cplx) {
    f: Cplx
    if i == 1 {
        ai[0].re = 1
        ai[0].im = 0
    } else if (i & 1) != 0 {
        ai[0] = CxScale(z[0], cast(float64)(i >> 1))
    } else {
        f.re = 0 - (a.re + cast(float64)((i >> 1) - 1))
        f.im = 0 - a.im
        ai[0] = CxMul(f, z[0])
    }
    bi[0].re = a.re + cast(float64)(i - 1)
    bi[0].im = a.im
}

CxIgammaLowerCf :: (dst: *Cplx, a: *Cplx, z: *Cplx) -> s32 {
    a0: Cplx = Cplx.{1, 0}
    a1v: Cplx
    b0: Cplx
    b1v: Cplx = Cplx.{1, 0}
    ai: Cplx
    bi: Cplx
    t1: Cplx
    t2: Cplx
    c1: Cplx
    c2: Cplx
    big: float64 = 18446744073709551616.0
    i: s32 = 1
    e: s32 = 0
    s: float64 = 0
    m: float64 = 0
    while i < 100 {
        CxIgammaLowerCoefs(*ai, *bi, i, a, z)
        t1 = CxMul(bi, a1v)
        t2 = CxMul(ai, a0)
        a2v: Cplx = CxAdd(t1, t2)
        a0 = a1v
        a1v = a2v
        t1 = CxMul(bi, b1v)
        t2 = CxMul(ai, b0)
        b2v: Cplx = CxAdd(t1, t2)
        b0 = b1v
        b1v = b2v
        m = Fabs(b1v.re) + Fabs(b1v.im)
        if m >= big || m <= (1 / big) {
            if m == 0 {
                return 0
            }
            Frexp(m, *e)
            s = Ldexp(1.0, -e + 1)
            a0 = CxScale(a0, s)
            a1v = CxScale(a1v, s)
            b0 = CxScale(b0, s)
            b1v = CxScale(b1v, s)
        }
        t1 = CxMul(a1v, b0)
        t2 = CxMul(a0, b1v)
        c1 = CxSub(t1, t2)
        c2 = CxMul(b0, b1v)
        if CxMod(c1) <= (CxMod(c2) * (2.2204460492503131e-16 / 2)) {
            break
        }
        i += 1
    }
    if i == 100 {
        return 0
    }
    res2: Cplx = CxDiv(a1v, b1v)
    zn: Cplx = CxNeg(z[0])
    dst[0] = CxMul(CxMul(res2, CxExp(zn)), CxPow(z[0], a[0]))
    return 1
}

CxIgammaUpperAsymp :: (dst: *Cplx, a: *Cplx, z: *Cplx) -> s32 {
    am: float64 = CxMod(a[0])
    zm: float64 = CxMod(z[0])
    s: Cplx
    t: Cplx
    zero2: Cplx
    i: s32 = 0
    if am >= zm {
        return 0
    }
    if (2 * zm) < (53 * 0.693147180559945309417232121458) {
        return 0
    }
    s = zero2
    a1c: Cplx = Cplx.{1, 0}
    t = CxTemmeD(CxSub(a[0], a1c), z[0])
    i = 0
    while i < 100 {
        s = CxAdd(s, t)
        if CxMod(t) <= (CxMod(s) * 2.2204460492503131e-16) {
            dst[0] = s
            return 1
        }
        t = CxDiv(t, z[0])
        ip1: Cplx = Cplx.{cast(float64)(i + 1), 0}
        t = CxMul(t, CxSub(a[0], ip1))
        i += 1
    }
    return 0
}

CxIgammaFixupUpperReal :: (res: *Cplx, a: Cplx, z: Cplx) {
    lres: Cplx
    one: Cplx = Cplx.{1, 0}
    if z.im == 0 && z.re < 0 && a.im == 0 && a.re != Floor(a.re) {
        lres = CxSub(one, res[0])
        m2: float64 = CxMod(lres)
        res[0].re = m2 * GoCospi(a.re)
        res[0].im = m2 * GoSinpi(a.re)
        res[0] = CxSub(one, res[0])
    }
}

CxIgammaFixup :: (a: Cplx, z: Cplx, lower: s32, regularized: s32, res_in: Cplx, have_lower: s32, have_regularized: s32, have_ga_in: s32) -> Cplx {
    res: Cplx = res_in
    ga: Cplx
    have_ga: s32 = have_ga_in
    one: Cplx = Cplx.{1, 0}
    if regularized != have_regularized {
        ga = CxGamma(a)
        have_ga = 1
        if have_regularized != 0 {
            res = CxMul(res, ga)
        } else {
            res = CxDiv(res, ga)
        }
        have_regularized = 1
    }
    if lower != have_lower {
        if have_regularized != 0 {
            res = CxSub(one, res)
        } else {
            if have_ga == 0 {
                ga = CxGamma(a)
            }
            res = CxSub(ga, res)
        }
    }
    return res
}

CxIgamma :: (a: Cplx, z: Cplx, lower: s32, regularized: s32) -> Cplx {
    res: Cplx
    ga: Cplx
    have_lower: s32 = 0
    have_regularized: s32 = 0
    have_ga: s32 = 0
    one: Cplx = Cplx.{1, 0}
    zero: Cplx
    if regularized != 0 && a.im == 0 && a.re <= 0 && a.re == Floor(a.re) {
        res = zero
        have_lower = 0
        have_regularized = 1
        return CxIgammaFixup(a, z, lower, regularized, res, have_lower, have_regularized, 0)
    }
    if a.im == 0 && a.re >= 0 && z.im == 0 && z.re >= 0 {
        res.re = pgamma(z.re, a.re, 1, ifx lower != 0 then 1 else 0, 0)
        res.im = 0
        have_lower = lower
        have_regularized = 1
        return CxIgammaFixup(a, z, lower, regularized, res, have_lower, have_regularized, 0)
    }
    if CxIgammaUpperAsymp(*res, *a, *z) != 0 {
        have_lower = 0
        have_regularized = 1
        CxIgammaFixupUpperReal(*res, a, z)
        return CxIgammaFixup(a, z, lower, regularized, res, have_lower, have_regularized, 0)
    }
    if CxIgammaLowerCf(*res, *a, *z) != 0 {
        have_lower = 1
        have_regularized = 0
        return CxIgammaFixup(a, z, lower, regularized, res, have_lower, have_regularized, 0)
    }
    res.re = 0.0 / 0.0
    res.im = 0.0 / 0.0
    return res
}

FnImigamma :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    a: Cplx
    z: Cplx
    unit: s32 = 105
    unit2: s32 = 105
    lower: s32 = 1
    reg: s32 = 1
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if CxArg(args, count, 0, *a, *unit) < 0 {
        return ValError(ERR_VALUE)
    }
    if CxArg(args, count, 1, *z, *unit2) < 0 {
        return ValError(ERR_VALUE)
    }
    if count >= 3 {
        if args[2].kind == VAL_ERROR {
            return ValError(args[2].err)
        }
        lower = ifx CoerceNumber(*args[2]) != 0 then 1 else 0
    }
    if count >= 4 {
        if args[3].kind == VAL_ERROR {
            return ValError(args[3].err)
        }
        reg = ifx CoerceNumber(*args[3]) != 0 then 1 else 0
    }
    return CxVal(CxIgamma(a, z, lower, reg), unit)
}

ReducePiSimple :: (x: float64, pk: *s32, kbits: s32) -> float64 {
    two_over_pi: float64 = 0.63661977236758134307553505349
    pi_over_two: [5]float64 = .[1.5707963109016418, 1.5893254712295857e-08, 6.123233932053594e-17, 6.368317055225283e-25, 1.082856653238257e-32]
    k: float64 = 0
    xx_value: float64 = 0
    i: s32 = 0
    k = Round(x * Ldexp(two_over_pi, kbits - 2))
    xx_value = 0
    pk[0] = TruncateToS32(k)
    if k == 0 {
        return x
    }
    x -= k * Ldexp(pi_over_two[0], 2 - kbits)
    i = 1
    while i < 5 {
        dx: float64 = k * Ldexp(pi_over_two[i], 2 - kbits)
        s: float64 = x - dx
        xx_value += x - s - dx
        x = s
        i += 1
    }
    return x + xx_value
}

ReducePiAddAt :: (dst: *u32, p_in: u64) {
    p: u64 = p_in
    h: u32 = cast(u32)(p >> 63)
    p += cast(u64)dst.*
    dst[0] = cast(u32)(p & 0xffffffff)
    dst = *dst[-1]
    p = p >> 32
    if p != 0 {
        p += cast(u64)dst.*
        dst[0] = cast(u32)(p & 0xffffffff)
        dst = *dst[-1]
        if (p >> 32) != 0 {
            while true {
                dst.* += 1
                if dst.* != 0 {
                    break
                }
                dst = *dst[-1]
            }
        }
    } else if h != 0 {
        dst = *dst[-1]
        while true {
            dst.* += 1
            if dst.* != 0 {
                break
            }
            dst = *dst[-1]
        }
    }
}

ReducePiFull :: (x: float64, pk: *s32, kbits: s32) -> float64 {
    one_over_two_pi: [36]u32 = .[0x28be60db, 0x9391054a, 0x7f09d5f4, 0x7d4d3770, 0x36d8a566, 0x4f10e410, 0x7f9458ea, 0xf7aef158, 0x6dc91b8e, 0x909374b8, 0x01924bba, 0x82746487, 0x3f877ac7, 0x2c4a69cf, 0xba208d7d, 0x4baed121, 0x3a671c09, 0xad17df90, 0x4e64758e, 0x60d4ce7d, 0x272117e2, 0xef7e4a0e, 0xc7fe25ff, 0xf7816603, 0xfbcbc462, 0xd6829b47, 0xdb4d9fb3, 0xc9f2c26d, 0xd3d18fd9, 0xa797fa8b, 0x5d49eeb1, 0xfaf97c5e, 0xcf41ce7d, 0xe294a4ba, 0x9afed7ec, 0x47e35742]
    pi_over_four: [4]u32 = .[0xc90fdaa2, 0x2168c234, 0xc4c6628b, 0x80dc1cd1]
    m: float64 = 0
    e: s32 = 0
    di: u32 = 0
    i: s32 = 0
    j: s32 = 0
    neg: s32 = 0
    w2: u32 = 0
    w1: u32 = 0
    w0: u32 = 0
    wm1: u32 = 0
    wm2: u32 = 0
    r: [6]u32
    r4: [4]u32
    rh: float64 = 0
    rl: float64 = 0
    l48: float64 = 0
    h48: float64 = 0
    m = Frexp(x, *e)
    if e >= 53 {
        di = (cast(u32)e - 53) / 32
        e -= cast(s32)(di * 32)
    } else {
        di = 0
    }
    m = Ldexp(m, e - 64)
    w2 = TruncateToU32(Floor(m))
    m = Ldexp(m - cast(float64)w2, 32)
    w1 = TruncateToU32(Floor(m))
    m = Ldexp(m - cast(float64)w1, 32)
    w0 = TruncateToU32(Floor(m))
    m = Ldexp(m - cast(float64)w0, 32)
    wm1 = TruncateToU32(Floor(m))
    m = Ldexp(m - cast(float64)wm1, 32)
    wm2 = TruncateToU32(Floor(m))
    r[0] = 0
    i = 0
    while i < 5 {
        r[i + 1] = 0
        if wm2 != 0 && i > 1 {
            ReducePiAddAt(*r[i + 1], cast(u64)wm2 * cast(u64)one_over_two_pi[i - 2])
        }
        if wm1 != 0 && i > 0 {
            ReducePiAddAt(*r[i + 1], cast(u64)wm1 * cast(u64)one_over_two_pi[i - 1])
        }
        if w0 != 0 {
            ReducePiAddAt(*r[i + 1], cast(u64)w0 * cast(u64)one_over_two_pi[cast(u32)i + di])
        }
        if w1 != 0 {
            ReducePiAddAt(*r[i + 1], cast(u64)w1 * cast(u64)one_over_two_pi[cast(u32)(i + 1) + di])
        }
        if w2 != 0 {
            ReducePiAddAt(*r[i + 1], cast(u64)w2 * cast(u64)one_over_two_pi[cast(u32)(i + 2) + di])
        }
        if i == 3 && ((r[1] + 1) & cast(u32)(0x7fffffff >> kbits)) > 1 {
            break
        }
        i += 1
    }
    pk[0] = ifx kbits != 0 then (cast(s32)(r[1] >> (cast(u32)(32 - kbits)))) else 0
    neg = cast(s32)((r[1] >> (cast(u32)(31 - kbits))) & 1)
    if neg != 0 {
        pk[0] += 1
        j = 1
        while j <= i {
            r[j] = cast(u32)(cast(s64)r[j] ^ 0xffffffff)
            j += 1
        }
        ReducePiAddAt(*r[i], 1)
    }
    r[1] = cast(u32)(cast(s64)r[1] & (0xffffffff >> (cast(s64)kbits)))
    j = 1
    if r[j] == 0 {
        j += 1
    }
    r4[0] = 0
    r4[1] = 0
    r4[2] = 0
    r4[3] = 0
    ReducePiAddAt(*r4[1], cast(u64)r[j] * cast(u64)pi_over_four[0])
    ReducePiAddAt(*r4[2], cast(u64)r[j] * cast(u64)pi_over_four[1])
    ReducePiAddAt(*r4[2], cast(u64)r[j + 1] * cast(u64)pi_over_four[0])
    ReducePiAddAt(*r4[3], cast(u64)r[j] * cast(u64)pi_over_four[2])
    ReducePiAddAt(*r4[3], cast(u64)r[j + 1] * cast(u64)pi_over_four[1])
    ReducePiAddAt(*r4[3], cast(u64)r[j + 2] * cast(u64)pi_over_four[0])
    h48 = Ldexp(cast(float64)(((cast(u64)r4[0]) << 16) | cast(u64)(r4[1] >> 16)), -32 * j + (kbits + 1) - 16)
    l48 = Ldexp(cast(float64)(((cast(u64)(r4[1] & 0xffff)) << 32) | cast(u64)r4[2]), -32 * j + (kbits + 1) - 64)
    rh = h48 + l48
    rl = h48 - rh + l48
    if neg != 0 {
        rh = 0 - rh
        rl = 0 - rl
    }
    return Ldexp(rh + rl, 2 - kbits)
}

GnmReducePi :: (x: float64, e: s32, k: *s32) -> float64 {
    xr: float64 = 0
    ax: float64 = 0
    if IsFinite(x) == 0 {
        k[0] = 0
        return x * (0.0 / 0.0)
    }
    ax = Fabs(x)
    if ax < Ldexp(1.0, 27 - e) {
        xr = ReducePiSimple(ax, k, e + 1)
    } else {
        xr = ReducePiFull(ax, k, e + 1)
    }
    if x < 0 {
        xr = 0 - xr
        k[0] = 0 - k[0]
    }
    k[0] = k[0] & ((1 << (e + 1)) - 1)
    return xr
}

FnUnix2date :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    futime: float64 = 0
    t: float64 = 0
    lt: *CalendarTime = null
    tzoff: float64 = 0
    serial: float64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    futime = CoerceNumber(*args[0])
    t = Trunc(futime)
    if Fabs(futime - t) >= 1 {
        return ValError(ERR_VALUE)
    }
    tt: s64 = TruncateToS64(t)
    lt = LocalTime(*tt)
    if lt == null {
        return ValError(ERR_VALUE)
    }
    tzoff = cast(float64)lt.tm_gmtoff
    serial = (t + tzoff) / 86400.0 + 25569
    serial += (futime - t) / 86400.0
    st.hint = 3
    return ValNumber(serial)
}

FnTimevalue :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    raw: float64 = 0
    text: [128]s8
    n: s32 = 0
    nums: [8]s32
    frac: float64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[0].kind != VAL_STRING {
        raw = CoerceNumber(*args[0])
        return ValNumber(raw - cast(float64)TruncateToS32(raw))
    }
    CoerceText(*args[0], *text[0], 128)
    {
        i: s32 = 0
        ni: s32 = 0
        cur: s32 = 0
        while text[i] != 0 && ni < 8 {
            ch: s32 = cast(s32)text[i]
            if ch >= 48 && ch <= 57 {
                cur = cur * 10 + (ch - 48)
            } else if ch == 58 {
                nums[ni] = cur
                ni += 1
                cur = 0
            }
            i += 1
        }
        nums[ni] = cur
        n = ni + 1
    }
    if n >= 2 {
        secs: s32 = nums[0] * 3600 + nums[1] * 60 + (ifx n >= 3 then nums[2] else 0)
        frac = cast(float64)secs / 86400.0
        return ValNumber(frac)
    }
    return ValError(ERR_VALUE)
}

FnOdfTime :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    v: Val = FnTime(st, args, count, marks)
    if v.kind == VAL_FLOAT {
        st.hint = 3
    }
    return v
}

FnReducepi :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    x: float64 = 0
    e: s32 = 0
    q: s32 = 0
    j: s32 = 0
    xr: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    x = CoerceNumber(*args[0])
    e = TruncateToS32(CoerceNumber(*args[1]))
    if count >= 3 {
        if args[2].kind == VAL_ERROR {
            return ValError(args[2].err)
        }
        q = ifx CoerceNumber(*args[2]) != 0 then 1 else 0
    }
    if e < -1 || e > 7 {
        return ValError(ERR_VALUE)
    }
    xr = GnmReducePi(x, e, *j)
    if q != 0 {
        return ValNumber(cast(float64)j)
    }
    return ValNumber(xr)
}

FourierFft :: (inp: *Cplx, n: s32, skip: s32, out: *Cplx, inverse: s32) {
    f1: [1024]Cplx
    f2: [1024]Cplx
    nhalf: s32 = n / 2
    argstep: float64 = 0
    i: s32 = 0
    if n == 1 {
        out[0] = inp[0]
        return
    }
    FourierFft(inp, nhalf, skip * 2, *f1[0], inverse)
    FourierFft(*inp[skip], nhalf, skip * 2, *f2[0], inverse)
    argstep = (ifx inverse != 0 then 3.14159265358979323846 else (0 - 3.14159265358979323846)) / cast(float64)nhalf
    i = 0
    while i < nhalf {
        dir2: Cplx = Cplx.{Cos(argstep * cast(float64)i), Sin(argstep * cast(float64)i)}
        tmp: Cplx = CxMul(f2[i], dir2)
        sumc: Cplx = CxAdd(f1[i], tmp)
        difc: Cplx = CxSub(f1[i], tmp)
        out[i].re = sumc.re * 0.5
        out[i].im = sumc.im * 0.5
        out[i + nhalf].re = difc.re * 0.5
        out[i + nhalf].im = difc.im * 0.5
        i += 1
    }
}

FnFourier :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    data: [4096]float64
    inp: [1024]Cplx
    outp: [1024]Cplx
    n0: s32 = 0
    nb: s32 = 1
    cols: s32 = 0
    rows: s32 = 0
    inverse: s32 = 0
    sep: s32 = 0
    i: s32 = 0
    buf: [128]s8
    if groups < 1 {
        return ValError(ERR_VALUE)
    }
    if groups > 3 {
        return ValError(ERR_NA)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    cols = st.call_group_cols[gx0]
    if cols < 1 {
        cols = gl0
    }
    rows = gl0 / cols
    if cols != 1 && rows != 1 {
        return ValError(ERR_VALUE)
    }
    n0 = CashList(*args[gx0], gl0, *data[0])
    if n0 < 0 {
        return ValError(args[gx0].err)
    }
    if n0 == 0 {
        return ValError(ERR_VALUE)
    }
    if n0 > 1024 {
        return ValError(ERR_VALUE)
    }
    if groups >= 2 {
        gx1: s32 = 0
        gl1: s32 = 0
        GroupBounds(marks, count, 1, *gx1, *gl1)
        if gl1 >= 1 {
            if args[gx1].kind == VAL_ERROR {
                return ValError(args[gx1].err)
            }
            inverse = ifx Floor(CoerceNumber(*args[gx1])) != 0 then 1 else 0
        }
        if groups >= 3 {
            gx2: s32 = 0
            gl2: s32 = 0
            GroupBounds(marks, count, 2, *gx2, *gl2)
            if gl2 >= 1 {
                if args[gx2].kind == VAL_ERROR {
                    return ValError(args[gx2].err)
                }
                sep = ifx Floor(CoerceNumber(*args[gx2])) != 0 then 1 else 0
            }
        }
    }
    while nb < n0 {
        nb *= 2
    }
    i = 0
    while i < n0 {
        inp[i].re = data[i]
        inp[i].im = 0
        i += 1
    }
    FourierFft(*inp[0], nb, 1, *outp[0], inverse)
    if sep != 0 {
        return ValNumber(outp[0].re)
    }
    CxToString(outp[0], 105, *buf[0], 128)
    return ValString(wb_strdup(*buf[0]))
}

FnHpfilter :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    data: [512]float64
    av: [512]float64
    bv: [512]float64
    cv: [512]float64
    n: s32 = 0
    lambda: float64 = 1600
    lambda6: float64 = 0
    lambda4: float64 = 0
    h: [5]float64
    g: [5]float64
    j2: [2]float64
    h_b: float64 = 0
    h_c: float64 = 0
    denom: float64 = 0
    cols: s32 = 0
    rows: s32 = 0
    i: s32 = 0
    if groups < 1 {
        return ValError(ERR_VALUE)
    }
    if groups > 2 {
        return ValError(ERR_NA)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    cols = st.call_group_cols[gx0]
    if cols < 1 {
        cols = gl0
    }
    rows = gl0 / cols
    if cols != 1 && rows != 1 {
        return ValError(ERR_VALUE)
    }
    n = CashList(*args[gx0], gl0, *data[0])
    if n < 0 {
        return ValError(args[gx0].err)
    }
    if n < 6 {
        return ValError(ERR_VALUE)
    }
    if n > 512 {
        return ValError(ERR_VALUE)
    }
    if groups >= 2 {
        gx1: s32 = 0
        gl1: s32 = 0
        GroupBounds(marks, count, 1, *gx1, *gl1)
        if gl1 >= 1 {
            if args[gx1].kind == VAL_ERROR {
                return ValError(args[gx1].err)
            }
            lambda = CoerceNumber(*args[gx1])
        }
    }
    lambda6 = 6 * lambda + 1
    lambda4 = -4 * lambda
    av[0] = lambda + 1
    bv[0] = -2 * lambda
    cv[0] = lambda
    i = 1
    while i < (n - 2) {
        av[i] = lambda6
        bv[i] = lambda4
        cv[i] = lambda
        i += 1
    }
    av[1] = lambda6 - lambda
    av[n - 2] = av[1]
    av[n - 1] = av[0]
    bv[n - 2] = bv[0]
    bv[n - 1] = 0
    cv[n - 2] = 0
    cv[n - 1] = 0
    i = 0
    while i < n {
        denom = av[i] - h[3] * h[0] - g[4] * g[1]
        if denom == 0 {
            return ValError(ERR_DIV0)
        }
        h_b = bv[i]
        g[0] = h[0]
        h[0] = (h_b - h[3] * h[1]) / denom
        bv[i] = h[0]
        h_c = cv[i]
        g[1] = h[1]
        h[1] = h_c / denom
        cv[i] = h[1]
        av[i] = (data[i] - g[2] * g[4] - h[2] * h[3]) / denom
        g[2] = h[2]
        h[2] = av[i]
        h[3] = h_b - h[4] * g[0]
        g[4] = h[4]
        h[4] = h_c
        i += 1
    }
    j2[0] = av[n - 1]
    data[n - 1] = j2[0]
    i = n - 1
    while i > 0 {
        data[i - 1] = av[i - 1] - bv[i - 1] * j2[0] - cv[i - 1] * j2[1]
        j2[1] = j2[0]
        j2[0] = data[i - 1]
        i -= 1
    }
    return ValNumber(data[0])
}

GoRangeAverage :: (xs: *float64, n: s32) -> float64 {
    acc: QuadAcc
    sum: float64 = 0
    i: s32 = 0
    constant: s32 = 1
    if n <= 0 {
        return 0
    }
    i = 1
    while i < n {
        if xs[i] != xs[0] {
            constant = 0
        }
        i += 1
    }
    if constant != 0 {
        return xs[0]
    }
    i = 0
    while i < n {
        QuadAccAdd(*acc, xs[i])
        i += 1
    }
    sum = QuadAccValue(*acc)
    return sum / cast(float64)n
}

GoRangeStddevEst :: (xs: *float64, n: s32, res: *float64) -> s32 {
    if n > 1 {
        q: float64 = StatDevsq(xs, n)
        res[0] = Sqrt(q / cast(float64)(n - 1))
        return 0
    }
    return 1
}

GoRangeCovarPop :: (xs: *float64, ys: *float64, n: s32, res: *float64) -> s32 {
    ux: float64 = 0
    uy: float64 = 0
    s: float64 = 0
    i: s32 = 0
    if n <= 0 {
        return 1
    }
    ux = StatAverage(xs, n)
    uy = StatAverage(ys, n)
    i = 0
    while i < n {
        s += (xs[i] - ux) * (ys[i] - uy)
        i += 1
    }
    res[0] = s / cast(float64)n
    return 0
}

GoRangeCorrelPop :: (xs: *float64, ys: *float64, n: s32, res: *float64) -> s32 {
    sx: float64 = 0
    sy: float64 = 0
    vxy: float64 = 0
    c: float64 = 0
    if n <= 0 {
        return 1
    }
    sx = Sqrt(StatDevsq(xs, n) / cast(float64)n)
    sy = Sqrt(StatDevsq(ys, n) / cast(float64)n)
    if sx == 0 || sy == 0 {
        return 1
    }
    if GoRangeCovarPop(xs, ys, n, *vxy) != 0 {
        return 1
    }
    c = vxy / (sx * sy)
    if c > 1 {
        c = 1
    }
    if c < -1 {
        c = -1
    }
    res[0] = c
    return 0
}

FnNormalityTest :: (st: *EvalState, args: *Val, count: s32, marks: *s32, which: s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    xs: [4096]float64
    ys: [4096]float64
    zs: [4096]float64
    n: s32 = 0
    mu: float64 = 0
    sigma: float64 = 1
    stat: float64 = 0
    p: float64 = 0
    i: s32 = 0
    min_n: s32 = 8
    if groups < 1 {
        return ValError(ERR_VALUE)
    }
    if groups > 1 {
        return ValError(ERR_NA)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    n = CashList(*args[gx0], gl0, *xs[0])
    if n < 0 {
        return ValError(args[gx0].err)
    }
    if which == 0 {
        min_n = 5
    } else {
        min_n = 8
    }
    if which == 1 {
        if n < 5 || n > 5000 {
            return ValError(ERR_VALUE)
        }
    } else if n < min_n {
        return ValError(ERR_VALUE)
    }
    if n < 1 {
        return ValError(ERR_VALUE)
    }
    if which != 1 {
        mu = GoRangeAverage(*xs[0], n)
        if GoRangeStddevEst(*xs[0], n, *sigma) != 0 {
            return ValError(ERR_VALUE)
        }
    }
    if which == 0 {
        dplus: float64 = 0
        dminus: float64 = 0
        nd: float64 = 0
        val: float64 = 0
        i = 0
        while i < n {
            ys[i] = xs[i]
            i += 1
        }
        SortDoubles(*ys[0], n)
        val = pnorm(ys[0], mu, sigma, 1, 0)
        dplus = 1 / cast(float64)n - val
        dminus = val
        i = 1
        while i < n {
            one_dplus: float64 = 0
            one_dminus: float64 = 0
            val = pnorm(ys[i], mu, sigma, 1, 0)
            one_dplus = cast(float64)(i + 1) / cast(float64)n - val
            one_dminus = val - cast(float64)i / cast(float64)n
            if one_dplus > dplus {
                dplus = one_dplus
            }
            if one_dminus > dminus {
                dminus = one_dminus
            }
            i += 1
        }
        stat = ifx dplus < dminus then dminus else dplus
        if n > 100 {
            stat = stat * Pow(cast(float64)n / 100.0, 0.49)
            nd = 100
        } else {
            nd = cast(float64)n
        }
        p = Exp(-7.01256 * stat * stat * (nd + 2.78019) + 2.99587 * stat * Sqrt(nd + 2.78019) - 0.122119 + 0.974598 / Sqrt(nd) + 1.67997 / nd)
        if p > 0.1 {
            stat = (Sqrt(nd) - 0.01 + 0.85 / Sqrt(nd)) * stat
            if stat <= 0.302 {
                p = 1
            } else if stat <= 0.5 {
                p = 2.76773 - 19.828315 * stat + 80.709644 * stat * stat - 138.55152 * stat * stat * stat + 81.218052 * stat * stat * stat * stat
            } else if stat <= 0.9 {
                p = -4.901232 + 40.662806 * stat - 97.490286 * stat * stat + 94.029866 * stat * stat * stat - 32.355711 * stat * stat * stat * stat
            } else if stat <= 1.31 {
                p = 6.198765 - 19.558097 * stat + 23.186922 * stat * stat - 12.234627 * stat * stat * stat + 2.423045 * stat * stat * stat * stat
            } else {
                p = 0
            }
        }
        return ValNumber(p)
    }
    if which == 1 {
        u: float64 = 0
        v: float64 = 0
        mu2: float64 = 0
        sig: float64 = 0
        i = 0
        while i < n {
            ys[i] = xs[i]
            i += 1
        }
        SortDoubles(*ys[0], n)
        i = 0
        while i < n {
            zs[i] = qnorm((cast(float64)(i + 1) - 3.0 / 8) / (cast(float64)n + 0.25), 0, 1, 1, 0)
            i += 1
        }
        if GoRangeCorrelPop(*ys[0], *zs[0], n, *stat) != 0 {
            return ValError(ERR_VALUE)
        }
        stat = stat * stat
        u = Log(cast(float64)n)
        v = Log(u)
        mu2 = -1.2725 + 1.0521 * (v - u)
        sig = 1.0308 - 0.26758 * (v + 2 / u)
        p = pnorm(Log1p(0 - stat), mu2, sig, 0, 0)
        return ValNumber(p)
    }
    if which == 2 {
        total: float64 = 0
        i = 0
        while i < n {
            ys[i] = xs[i]
            i += 1
        }
        SortDoubles(*ys[0], n)
        i = 0
        while i < n {
            val: float64 = pnorm(ys[i], mu, sigma, 1, 0)
            delta: float64 = val - cast(float64)(2 * i + 1) / cast(float64)(2 * n)
            total += delta * delta
            i += 1
        }
        total += 1 / (12 * cast(float64)n)
        total *= 1 + 0.5 / cast(float64)n
        if total < 0.0275 {
            p = 1 - Exp(-13.953 + 775.5 * total - 12542.61 * total * total)
        } else if total < 0.051 {
            p = 1 - Exp(-5.903 + 179.546 * total - 1515.29 * total * total)
        } else if total < 0.092 {
            p = Exp(0.886 - 31.62 * total - 10.897 * total * total)
        } else if total < 1 {
            p = Exp(1.111 - 34.242 * total + 12.832 * total * total)
        } else {
            p = 0
        }
        return ValNumber(p)
    }
    {
        total: float64 = 0
        i = 0
        while i < n {
            ys[i] = xs[i]
            i += 1
        }
        SortDoubles(*ys[0], n)
        i = 0
        while i < n {
            val: float64 = pnorm(ys[i], mu, sigma, 1, 1) + pnorm(ys[n - i - 1], mu, sigma, 0, 1)
            total += cast(float64)(2 * i + 1) * val
            i += 1
        }
        total = cast(float64)(0 - n) - total / cast(float64)n
        total *= 1 + 0.75 / cast(float64)n + 2.25 / (cast(float64)n * cast(float64)n)
        if total < 0.20 {
            p = 0 - Expm1(-13.436 + 101.14 * total - 223.73 * total * total)
        } else if total < 0.34 {
            p = 0 - Expm1(-8.318 + 42.796 * total - 59.938 * total * total)
        } else if total < 0.6 {
            p = Exp(0.9177 - 4.279 * total - 1.38 * total * total)
        } else {
            p = Exp(1.2937 - 5.709 * total + 0.0186 * total * total)
        }
        return ValNumber(p)
    }
}

FnChitest :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    gx1: s32 = 0
    gl1: s32 = 0
    w0: s32 = 0
    h0: s32 = 0
    w1: s32 = 0
    h1: s32 = 0
    xs: [4096]float64
    es: [4096]float64
    n0: s32 = 0
    n1: s32 = 0
    sum: float64 = 0
    has_neg: s32 = 0
    chisq: float64 = 0
    df: s32 = 0
    i: s32 = 0
    minlen: s32 = 0
    if groups < 2 {
        return ValError(ERR_VALUE)
    }
    if groups > 2 {
        return ValError(ERR_NA)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    GroupBounds(marks, count, 1, *gx1, *gl1)
    w0 = st.call_group_cols[gx0]
    if w0 < 1 {
        w0 = gl0
    }
    h0 = gl0 / w0
    w1 = st.call_group_cols[gx1]
    if w1 < 1 {
        w1 = gl1
    }
    h1 = gl1 / w1
    if (w0 * h0) != (w1 * h1) {
        return ValError(ERR_NA)
    }
    n0 = CashList(*args[gx0], gl0, *xs[0])
    n1 = CashList(*args[gx1], gl1, *es[0])
    if n0 < 0 {
        return ValError(args[gx0].err)
    }
    if n1 < 0 {
        return ValError(args[gx1].err)
    }
    minlen = ifx n0 < n1 then n0 else n1
    i = 0
    while i < minlen {
        e: float64 = es[i]
        a: float64 = xs[i]
        if e == 0 {
            return ValError(ERR_DIV0)
        }
        if e < 0 {
            has_neg = 1
        } else {
            sum += ((a - e) / e) * (a - e)
        }
        i += 1
    }
    if has_neg != 0 {
        return ValError(ERR_NUM)
    }
    chisq = sum
    df = (w0 - 1) * (h0 - 1)
    if df == 0 {
        df = w0 * h0 - 1
    }
    return ValNumber(pchisq(chisq, cast(float64)df, 0, 0))
}

FnCronbach :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx: s32 = 0
    gl: s32 = 0
    vals: [16][4096]float64
    ns: [16]s32
    sum_variance: float64 = 0
    sum_covariance: float64 = 0
    i: s32 = 0
    j: s32 = 0
    if groups < 2 {
        return ValError(ERR_VALUE)
    }
    if groups > 16 {
        return ValError(ERR_VALUE)
    }
    i = 0
    while i < groups {
        GroupBounds(marks, count, i, *gx, *gl)
        ns[i] = CashList(*args[gx], gl, *vals[i][0])
        if ns[i] <= 0 {
            return ValError(ERR_VALUE)
        }
        sum_variance += StatDevsq(*vals[i][0], ns[i]) / cast(float64)ns[i]
        i += 1
    }
    i = 0
    while i < groups {
        j = i + 1
        while j < groups {
            cp: float64 = 0
            if GoRangeCovarPop(*vals[i][0], *vals[j][0], ifx ns[i] < ns[j] then ns[i] else ns[j], *cp) != 0 {
                return ValError(ERR_VALUE)
            }
            sum_covariance += cp
            j += 1
        }
        i += 1
    }
    return ValNumber((cast(float64)groups * (1 - sum_variance / (sum_variance + 2 * sum_covariance))) / cast(float64)(groups - 1))
}

FnLogistic :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    x: float64 = 0
    a: float64 = 0
    u: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    x = CoerceNumber(*args[0])
    a = CoerceNumber(*args[1])
    if a <= 0 {
        return ValError(ERR_NUM)
    }
    u = Exp(0 - Fabs(x) / a)
    return ValNumber(u / (Fabs(a) * (1 + u) * (1 + u)))
}

FnFltConst :: (st: *EvalState, args: *Val, count: s32, marks: *s32, which: s32) -> Val {
    if which == 0 {
        return ValNumber(2)
    }
    if which == 1 {
        return ValNumber(2.2250738585072014e-308)
    }
    return ValNumber(1.7976931348623157e308)
}

FnFltNextAfter :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    x: float64 = 0
    y: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    x = CoerceNumber(*args[0])
    if args[1].kind == VAL_STRING {
        label: [64]s8
        CoerceText(*args[1], *label[0], 64)
        if TextCompareLiteral(*label[0], "+") == 0 {
            y = 1e308 * 10
        } else if TextCompareLiteral(*label[0], "-") == 0 {
            y = -1e308 * 10
        } else {
            return ValError(ERR_VALUE)
        }
    } else {
        y = CoerceNumber(*args[1])
    }
    return ValNumber(Nextafter(x, y))
}

DcauchyGo :: (x: float64, location: float64, scale: float64, give_log: s32) -> float64 {
    y: float64 = 0
    if x != x || location != location || scale != scale {
        return x + location + scale
    }
    if scale <= 0 {
        return 0.0 / 0.0
    }
    y = (x - location) / scale
    if give_log != 0 {
        return 0 - Log(3.14159265358979323846 * scale * (1 + y * y))
    }
    return 1 / (3.14159265358979323846 * scale * (1 + y * y))
}

PcauchyGo :: (x_in: float64, location: float64, scale: float64, lower_tail: s32, log_p: s32) -> float64 {
    x: float64 = x_in
    y: float64 = 0
    if x != x || location != location || scale != scale {
        return x + location + scale
    }
    if scale <= 0 {
        return 0.0 / 0.0
    }
    x = (x - location) / scale
    if x != x {
        return 0.0 / 0.0
    }
    if IsFinite(x) == 0 {
        if x < 0 {
            return ifx lower_tail != 0 then 0.0 else 1.0
        }
        return ifx lower_tail != 0 then 1.0 else 0.0
    }
    if lower_tail == 0 {
        x = 0 - x
    }
    if Fabs(x) > 1 {
        y = GoAtanPi(1 / x)
        if x > 0 {
            return ifx log_p != 0 then Log1p(0 - y) else (1 - y)
        }
        return ifx log_p != 0 then Log(0 - y) else (0 - y)
    }
    v2: float64 = 0.5 + GoAtanPi(x)
    return ifx log_p != 0 then Log(v2) else v2
}

FibTable :: () -> s32 {
    fibs: [47]s32
    fibs[1] = 1
    fibs[2] = 1
    i: s32 = 3
    while i < 47 {
        fibs[i] = fibs[i - 1] + fibs[i - 2]
        i += 1
    }
    return 0
}

FnFib :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    n: float64 = 0
    s5: float64 = 0
    r1: float64 = 0
    r2: float64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    n = Floor(CoerceNumber(*args[0]))
    if n <= 0 {
        return ValError(ERR_NUM)
    }
    if n < 47 {
        fibs: [47]s32
        fibs[1] = 1
        fibs[2] = 1
        i2: s32 = 3
        while i2 < 47 {
            fibs[i2] = fibs[i2 - 1] + fibs[i2 - 2]
            i2 += 1
        }
        return ValNumber(cast(float64)fibs[TruncateToS32(n)])
    }
    s5 = Sqrt(5.0)
    r1 = (1 + s5) / 2
    r2 = (1 - s5) / 2
    return ValNumber((Pow(r1, n) - Pow(r2, n)) / s5)
}

FnRri :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    per: float64 = 0
    pv: float64 = 0
    fv: float64 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    per = CoerceNumber(*args[0])
    pv = CoerceNumber(*args[1])
    fv = CoerceNumber(*args[2])
    if per < 0 {
        return ValError(ERR_NUM)
    }
    if pv == 0 || per == 0 {
        return ValError(ERR_DIV0)
    }
    return ValNumber(Pow(fv / pv, 1 / per) - 1)
}

FnFtest :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    gx1: s32 = 0
    gl1: s32 = 0
    xs: [4096]float64
    ys: [4096]float64
    nx: s32 = 0
    ny: s32 = 0
    varx: float64 = 0
    vary: float64 = 0
    p: float64 = 0
    if groups < 2 {
        return ValError(ERR_VALUE)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    GroupBounds(marks, count, 1, *gx1, *gl1)
    nx = CashList(*args[gx0], gl0, *xs[0])
    ny = CashList(*args[gx1], gl1, *ys[0])
    if nx <= 1 || ny <= 1 {
        return ValError(ERR_DIV0)
    }
    varx = StatDevsq(*xs[0], nx) / cast(float64)(nx - 1)
    vary = StatDevsq(*ys[0], ny) / cast(float64)(ny - 1)
    if vary == 0 {
        return ValError(ERR_DIV0)
    }
    p = pf(varx / vary, cast(float64)(nx - 1), cast(float64)(ny - 1), 0, 0)
    if p > 0.5 {
        p = pf(varx / vary, cast(float64)(nx - 1), cast(float64)(ny - 1), 1, 0)
    }
    return ValNumber(2 * p)
}

FnDays :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    d1: float64 = 0
    d2: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    d1 = Floor(CoerceNumber(*args[0]))
    d2 = Floor(CoerceNumber(*args[1]))
    return ValNumber(cast(float64)(TruncateToS32(d1) - TruncateToS32(d2)))
}

FnType :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_BOOL {
        return ValNumber(4)
    }
    if args[0].kind == VAL_EMPTY || args[0].kind == VAL_FLOAT {
        return ValNumber(1)
    }
    if args[0].kind == VAL_ERROR {
        return ValNumber(16)
    }
    if args[0].kind == VAL_STRING {
        return ValNumber(2)
    }
    return ValNumber(1)
}

FnErrorFn :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    label: [256]s8
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    CoerceText(*args[0], *label[0], 256)
    return ValString(wb_strdup(*label[0]))
}

WeekdayOfSerial :: (serial: s32) -> s32 {
    return ((serial - 25569 + 3) % 7 + 7) % 7 + 1
}

DayOfYear :: (serial: s32) -> s32 {
    y: s32 = 0
    jan1: s32 = 0
    y2: s32 = 0
    CivilFromDays(serial + SerialEpoch(), *y, *y2, *jan1)
    return serial - (DaysFromCivil(y, 1, 1) - SerialEpoch()) + 1
}

IsoWeekOfYear :: (serial: s32) -> s32 {
    doy2: s32 = DayOfYear(serial)
    wd2: s32 = WeekdayOfSerial(serial)
    week2: s32 = (doy2 - wd2 + 10) / 7
    if week2 < 1 {
        y4: s32 = 0
        m4: s32 = 0
        d4: s32 = 0
        CivilFromDays(serial + SerialEpoch(), *y4, *m4, *d4)
        return IsoWeekOfYear(DaysFromCivil(y4 - 1, 12, 28) - SerialEpoch())
    }
    if week2 == 53 {
        y3: s32 = 0
        m3: s32 = 0
        d3: s32 = 0
        CivilFromDays(serial + SerialEpoch(), *y3, *m3, *d3)
        jan1s: s32 = DaysFromCivil(y3, 1, 1) - SerialEpoch()
        dec31s: s32 = DaysFromCivil(y3, 12, 31) - SerialEpoch()
        if WeekdayOfSerial(jan1s) == 4 || WeekdayOfSerial(dec31s) == 4 {
            return 53
        }
        return 1
    }
    return week2
}

GnmWeeknum :: (serial: s32, start_day: s32) -> s32 {
    y: s32 = 0
    m: s32 = 0
    d: s32 = 0
    jan1_serial: s32 = 0
    jan1_wd: s32 = 0
    start_wd: s32 = 0
    offset: s32 = 0
    diff: s32 = 0
    CivilFromDays(serial + SerialEpoch(), *y, *m, *d)
    jan1_serial = DaysFromCivil(y, 1, 1) - SerialEpoch()
    jan1_wd = WeekdayOfSerial(jan1_serial)
    if jan1_wd == 7 {
        jan1_wd = 0
    }
    start_wd = start_day % 7
    offset = jan1_wd - start_wd
    if offset < 0 {
        offset += 7
    }
    diff = DayOfYear(serial) - 1 + offset
    return diff / 7 + 1
}

FnWeeknum :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    serial: float64 = 0
    method: float64 = 1
    start_day: s32 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    serial = CoerceNumber(*args[0])
    if serial < 1 {
        return ValError(ERR_NUM)
    }
    if count >= 2 {
        if args[1].kind == VAL_ERROR {
            return ValError(args[1].err)
        }
        method = Floor(CoerceNumber(*args[1]))
    }
    if method == 21 || method == 150 {
        return ValNumber(cast(float64)IsoWeekOfYear(TruncateToS32(serial)))
    }
    if method == 1 || method == 17 {
        start_day = 7
    } else if method == 2 || method == 11 {
        start_day = 1
    } else if method >= 12 && method <= 16 {
        start_day = TruncateToS32(method) - 10
    } else {
        return ValError(ERR_VALUE)
    }
    return ValNumber(cast(float64)GnmWeeknum(TruncateToS32(serial), start_day))
}

FnRankPlain :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    x: float64 = 0
    xs: [4096]float64
    n: s32 = 0
    increasing: s32 = 0
    r: s32 = 1
    i: s32 = 0
    found: s32 = 0
    g: s32 = 0
    rgx: s32 = 0
    rgl: s32 = 0
    if groups < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    x = CoerceNumber(*args[0])
    g = 0
    while g < groups {
        GroupBounds(marks, count, g, *rgx, *rgl)
        if rgl > 1 {
            break
        }
        g += 1
    }
    if g == groups {
        return ValError(ERR_VALUE)
    }
    gx0 = rgx
    gl0 = rgl
    n = CashList(*args[gx0], gl0, *xs[0])
    if n < 0 {
        return ValError(args[gx0].err)
    }
    if groups >= 3 {
        GroupBounds(marks, count, groups - 1, *gx0, *gl0)
        if gl0 >= 1 {
            if args[gx0].kind == VAL_ERROR {
                return ValError(args[gx0].err)
            }
            increasing = ifx CoerceNumber(*args[gx0]) != 0 then 1 else 0
        }
    }
    i = 0
    while i < n {
        y: float64 = xs[i]
        if y == x {
            found = 1
        }
        hit2: s32 = 0
        if increasing != 0 {
            if y < x {
                hit2 = 1
            }
        } else {
            if y > x {
                hit2 = 1
            }
        }
        if hit2 != 0 {
            r += 1
        }
        i += 1
    }
    if found == 0 {
        return ValError(ERR_NA)
    }
    return ValNumber(cast(float64)r)
}

FnRsq :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    c: float64 = 0
    xs: [4096]float64
    ys: [4096]float64
    xn: s32 = 0
    yn: s32 = 0
    if StatAggArgs(args, count, marks, *xs[0], *ys[0], *xn, *yn, 1) == 0 {
        return ValError(ERR_VALUE)
    }
    if GoRangeCorrelPop(*xs[0], *ys[0], xn, *c) != 0 {
        return ValError(ERR_VALUE)
    }
    return ValNumber(c * c)
}

FnPercentof :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    gx0: s32 = 0
    gl0: s32 = 0
    gx1: s32 = 0
    gl1: s32 = 0
    sub: [4096]float64
    all: [4096]float64
    nsub: s32 = 0
    nall: s32 = 0
    ssub: float64 = 0
    sall: float64 = 0
    if groups < 2 {
        return ValError(ERR_VALUE)
    }
    GroupBounds(marks, count, 0, *gx0, *gl0)
    GroupBounds(marks, count, 1, *gx1, *gl1)
    nsub = CashList(*args[gx0], gl0, *sub[0])
    nall = CashList(*args[gx1], gl1, *all[0])
    if nsub < 0 {
        return ValError(args[gx0].err)
    }
    if nall < 0 {
        return ValError(args[gx1].err)
    }
    i: s32 = 0
    while i < nsub {
        ssub += sub[i]
        i += 1
    }
    i = 0
    while i < nall {
        sall += all[i]
        i += 1
    }
    if sall == 0 {
        return ValError(ERR_DIV0)
    }
    return ValNumber(ssub / sall)
}

DchisqGo :: (x: float64, df: float64, give_log: s32) -> float64 {
    return dgamma_go(x, df / 2, 2, give_log)
}

DfGo :: (x: float64, m: float64, n: float64, give_log: s32) -> float64 {
    p2: float64 = 0
    q2: float64 = 0
    f2: float64 = 0
    dens: float64 = 0
    if x != x || m != m || n != n {
        return x + m + n
    }
    if m <= 0 || n <= 0 {
        return 0.0 / 0.0
    }
    if x < 0 {
        return ifx give_log != 0 then (-1e308 * 10) else 0
    }
    if x == 0 {
        if m > 2 {
            return ifx give_log != 0 then (-1e308 * 10) else 0
        }
        if m == 2 {
            return ifx give_log != 0 then 0.0 else 1.0
        }
        return 1e308 * 10
    }
    if IsFinite(m) == 0 && IsFinite(n) == 0 {
        if x == 1 {
            return 1e308 * 10
        }
        return ifx give_log != 0 then (-1e308 * 10) else 0
    }
    if IsFinite(n) == 0 {
        return dgamma_go(x, m / 2, 2 / m, give_log)
    }
    if m > 1e14 {
        dens = dgamma_go(1 / x, n / 2, 2 / n, give_log)
        if give_log != 0 {
            return dens - 2 * Log(x)
        }
        return dens / (x * x)
    }
    f2 = 1 / (n + x * m)
    q2 = n * f2
    p2 = x * m * f2
    if m >= 2 {
        f2 = (m * q2) / 2
        dens = dbinom_raw((m - 2) / 2, (m + n - 2) / 2, p2, q2, give_log)
    } else {
        f2 = (m * m * q2) / (2 * p2 * (m + n))
        dens = dbinom_raw(m / 2, (m + n) / 2, p2, q2, give_log)
    }
    if give_log != 0 {
        return Log(f2) + dens
    }
    return f2 * dens
}

QexpGo :: (p: float64, scale: float64, lower_tail: s32, log_p: s32) -> float64 {
    if p != p || scale != scale {
        return p + scale
    }
    if scale < 0 {
        return 0.0 / 0.0
    }
    if log_p != 0 {
        if p > 0 {
            return 0.0 / 0.0
        }
    } else {
        if p < 0 || p > 1 {
            return 0.0 / 0.0
        }
    }
    if p == 0 {
        return 0.0
    }
    if log_p != 0 {
        return 0 - scale * (ifx lower_tail != 0 then Log1p(0 - Exp(p)) else p)
    }
    return 0 - scale * (ifx lower_tail != 0 then Log1p(0 - p) else Log(p))
}

DlnormGo :: (x: float64, logmean: float64, logsd: float64, give_log: s32) -> float64 {
    qx: Quad
    qlx: Quad
    qs: Quad
    qy: Quad
    qt: Quad
    qsqrt2pi: Quad = Quad.{2.5066282746310002, -1.6233650353192337e-16}
    if x != x || logmean != logmean || logsd != logsd {
        return x + logmean + logsd
    }
    if logsd <= 0 {
        return 0.0 / 0.0
    }
    if x <= 0 {
        return ifx give_log != 0 then (-1e308 * 10) else 0
    }
    QuadInit(*qx, x)
    QuadLog(*qlx, *qx)
    QuadInit(*qt, logmean)
    QuadSub(*qy, *qlx, *qt)
    QuadInit(*qs, logsd)
    QuadDiv(*qy, *qy, *qs)
    QuadMul(*qy, *qy, *qy)
    qy.h *= -0.5
    qy.l *= -0.5
    QuadMul(*qt, *qs, *qx)
    QuadMul(*qt, *qt, *qsqrt2pi)
    if give_log != 0 {
        QuadLog(*qt, *qt)
        QuadSub(*qy, *qy, *qt)
    } else {
        QuadExp(*qy, null, *qy)
        QuadDiv(*qy, *qy, *qt)
    }
    return QuadVal(*qy)
}

PlnormGo :: (x: float64, logmean: float64, logsd: float64, lower_tail: s32, log_p: s32) -> float64 {
    if x != x || logmean != logmean || logsd != logsd {
        return x + logmean + logsd
    }
    if logsd <= 0 {
        return 0.0 / 0.0
    }
    if x > 0 {
        return pnorm(Log(x), logmean, logsd, lower_tail, log_p)
    }
    return ifx lower_tail != 0 then (ifx log_p != 0 then (-1e308 * 10) else 0.0) else (ifx log_p != 0 then 0.0 else 1.0)
}

QlnormGo :: (p: float64, logmean: float64, logsd: float64, lower_tail: s32, log_p: s32) -> float64 {
    if p != p || logmean != logmean || logsd != logsd {
        return p + logmean + logsd
    }
    if log_p != 0 {
        if p > 0 {
            return 0.0 / 0.0
        }
    } else {
        if p < 0 || p > 1 {
            return 0.0 / 0.0
        }
    }
    return Exp(qnorm(p, logmean, logsd, lower_tail, log_p))
}

QweibullGo :: (p: float64, shape: float64, scale: float64, lower_tail: s32, log_p: s32) -> float64 {
    if p != p || shape != shape || scale != scale {
        return p + shape + scale
    }
    if shape <= 0 || scale <= 0 {
        return 0.0 / 0.0
    }
    if log_p != 0 {
        if p > 0 {
            return 0.0 / 0.0
        }
        if p == 0 {
            return ifx lower_tail != 0 then 0.0 else (1e308 * 10)
        }
    } else {
        if p < 0 || p > 1 {
            return 0.0 / 0.0
        }
        if p == 0 {
            return ifx lower_tail != 0 then 0.0 else (1e308 * 10)
        }
        if p == 1 {
            return ifx lower_tail != 0 then (1e308 * 10) else 0.0
        }
    }
    cval: float64 = 0
    if log_p != 0 {
        cval = ifx lower_tail != 0 then Log1p(0 - Exp(p)) else p
    } else {
        cval = ifx lower_tail != 0 then (0 - Log1p(0 - p)) else Log(p)
    }
    return scale * Pow(cval, 1 / shape)
}

PrayleighGo :: (x: float64, scale: float64, lower_tail: s32, log_p: s32) -> float64 {
    return pweibull_go(x, 2, 1.4142135623730951 * scale, lower_tail, log_p)
}

QrayleighGo :: (p: float64, scale: float64, lower_tail: s32, log_p: s32) -> float64 {
    return QweibullGo(p, 2, 1.4142135623730951 * scale, lower_tail, log_p)
}

DgeomGo :: (x: float64, p: float64, give_log: s32) -> float64 {
    prob2: float64 = 0
    if x != x || p != p {
        return x + p
    }
    if p <= 0 || p > 1 {
        return 0.0 / 0.0
    }
    if x < 0 || IsFinite(x) == 0 || p == 0 {
        return ifx give_log != 0 then (-1e308 * 10) else 0
    }
    x = Round(x)
    prob2 = dbinom_raw(0, x, p, 1 - p, give_log)
    if give_log != 0 {
        return prob2 + Log(p)
    }
    return prob2 * p
}

PgeomGo :: (x: float64, p: float64, lower_tail: s32, log_p: s32) -> float64 {
    if x != x || p != p {
        return x + p
    }
    if p <= 0 || p > 1 {
        return 0.0 / 0.0
    }
    if x < 0 {
        return ifx lower_tail != 0 then (ifx log_p != 0 then (-1e308 * 10) else 0.0) else (ifx log_p != 0 then 0.0 else 1.0)
    }
    if IsFinite(x) == 0 {
        return ifx lower_tail != 0 then (ifx log_p != 0 then 0.0 else 1.0) else (ifx log_p != 0 then (-1e308 * 10) else 0.0)
    }
    x = FormulaFakeFloor(x)
    if p == 1 {
        if lower_tail != 0 {
            return ifx log_p != 0 then 0.0 else 1.0
        }
        return ifx log_p != 0 then (-1e308 * 10) else 0.0
    }
    x = Log1p(0 - p) * (x + 1)
    if log_p != 0 {
        return ifx lower_tail != 0 then Log1p(0 - Exp(x)) else x
    }
    if lower_tail != 0 {
        return 0 - Expm1(x)
    }
    return Exp(x)
}

QgeomGo :: (p: float64, prob2: float64, lower_tail: s32, log_p: s32) -> float64 {
    if p != p || prob2 != prob2 {
        return p + prob2
    }
    if prob2 <= 0 || prob2 > 1 {
        return 0.0 / 0.0
    }
    if log_p != 0 {
        if p > 0 {
            return 0.0 / 0.0
        }
        if p == 0 {
            return 0.0
        }
        if p == 0.0 {
            return 0.0
        }
    } else {
        if p < 0 || p > 1 {
            return 0.0 / 0.0
        }
        if p == 0 {
            return 0.0
        }
        if p == 1 {
            return 1e308 * 10
        }
    }
    if prob2 == 1 {
        return 0
    }
    cval: float64 = 0
    if log_p != 0 {
        cval = ifx lower_tail != 0 then Log1p(0 - Exp(p)) else p
    } else {
        cval = ifx lower_tail != 0 then Log1p(0 - p) else Log(p)
    }
    v2: float64 = cval / Log1p(0 - prob2) - 1 - 1e-12
    if v2 < 0 {
        v2 = 0
    }
    return Ceil(v2)
}

DgumbelGo :: (x: float64, mu: float64, beta: float64, give_log: s32) -> float64 {
    z: float64 = (x - mu) / beta
    lval: float64 = 0 - (z + Exp(0 - z)) - Log(beta)
    if give_log != 0 {
        return lval
    }
    return Exp(lval)
}

PgumbelGo :: (x: float64, mu: float64, beta: float64, lower_tail: s32, log_p: s32) -> float64 {
    z: float64 = (x - mu) / beta
    val: float64 = Exp(0 - Exp(0 - z))
    if lower_tail != 0 {
        return ifx log_p != 0 then Log(val) else val
    }
    if log_p != 0 {
        return Log1p(0 - val)
    }
    return 1 - val
}

QgumbelGo :: (p: float64, mu: float64, beta: float64, lower_tail: s32, log_p: s32) -> float64 {
    if lower_tail != 0 {
        return mu - beta * Log(0 - Log(p))
    }
    return mu - beta * Log(0 - Log1p(0 - p))
}

DsnormGo :: (x: float64, shape: float64, location: float64, scale: float64, give_log: s32) -> float64 {
    z: float64 = (x - location) / scale
    val: float64 = (2 / scale) * dnorm_go(z, 0, 1, 0) * pnorm(shape * z, 0, 1, 1, 0)
    if give_log != 0 {
        return Log(val)
    }
    return val
}

PsnormGo :: (x: float64, shape: float64, location: float64, scale: float64, lower_tail: s32, log_p: s32) -> float64 {
    z: float64 = (x - location) / scale
    val: float64 = pnorm(z, 0, 1, 1, 0) - 2 * OwentT(z, shape)
    if lower_tail != 0 {
        return ifx log_p != 0 then Log(val) else val
    }
    val2: float64 = 1 - val
    return ifx log_p != 0 then Log(val2) else val2
}

QsnormGo :: (p: float64, shape: float64, location: float64, scale: float64, lower_tail: s32, log_p: s32) -> float64 {
    z: float64 = GenInvSnorm(p, shape, lower_tail)
    return location + scale * z
}

GenInvSnorm :: (p: float64, shape: float64, lower_tail: s32) -> float64 {
    lo: float64 = -50
    hi: float64 = 50
    mid: float64 = 0
    i: s32 = 0
    i = 0
    while i < 200 {
        mid = (lo + hi) / 2
        if PsnormGo(ifx (mid * shape) >= 0 then mid else mid, shape, 0, 1, lower_tail, 0) < p {
            lo = mid
        } else {
            hi = mid
        }
        i += 1
    }
    return (lo + hi) / 2
}

DstGo :: (x: float64, df: float64, shape: float64, give_log: s32) -> float64 {
    z: float64 = x
    inner: float64 = shape * z * Sqrt((df + 1) / (df + z * z))
    val: float64 = 2 * dt_go(z, df, 0) * pt(inner, df + 1, 1, 0)
    if give_log != 0 {
        return Log(val)
    }
    return val
}

PstGo :: (x: float64, df: float64, shape: float64, lower_tail: s32, log_p: s32) -> float64 {
    step: float64 = 0.01
    total: float64 = 0
    xx_value: float64 = -50
    if x <= -50 {
        return ifx lower_tail != 0 then (ifx log_p != 0 then (-1e308 * 10) else 0.0) else (ifx log_p != 0 then 0.0 else 1.0)
    }
    total = 0
    xx_value = -50
    while xx_value < x {
        midp: float64 = xx_value + step / 2
        total += DstGo(midp, df, shape, 0) * step
        xx_value += step
    }
    if lower_tail != 0 {
        return ifx log_p != 0 then Log(total) else total
    }
    return ifx log_p != 0 then Log1p(0 - total) else (1 - total)
}

QstGo :: (p: float64, df: float64, shape: float64, lower_tail: s32, log_p: s32) -> float64 {
    lo: float64 = -50
    hi: float64 = 50
    mid: float64 = 0
    i: s32 = 0
    i = 0
    while i < 200 {
        mid = (lo + hi) / 2
        if PstGo(mid, df, shape, lower_tail, 0) < p {
            lo = mid
        } else {
            hi = mid
        }
        i += 1
    }
    return (lo + hi) / 2
}

QcauchyGo :: (p_in: float64, location: float64, scale: float64, lower_tail_in: s32, log_p_in: s32) -> float64 {
    p: float64 = p_in
    lower_tail: s32 = lower_tail_in
    log_p: s32 = log_p_in
    x: float64 = 0
    if p != p || location != location || scale != scale {
        return p + location + scale
    }
    if log_p != 0 {
        if p > 0 {
            return 0.0 / 0.0
        }
    } else {
        if p < 0 || p > 1 {
            return 0.0 / 0.0
        }
    }
    if scale < 0 || IsFinite(scale) == 0 {
        return 0.0 / 0.0
    }
    if log_p != 0 {
        if p > -1 {
            lower_tail = cast(s32)(lower_tail == 0)
            p = 0 - Expm1(p)
        } else {
            p = Exp(p)
        }
        log_p = 0
    } else {
        if p > 0.5 {
            p = 1 - p
            lower_tail = cast(s32)(lower_tail == 0)
        }
    }
    x = location + (ifx lower_tail != 0 then (0 - scale) else scale) * (GoCospi(p) / GoSinpi(p))
    return x
}

QNbinomGo :: (p: float64, size: float64, prob2: float64, lower_tail: s32, log_p: s32) -> float64 {
    shape: [3]float64
    mu: float64 = 0
    sigma: float64 = 0
    if p != p || size != size || prob2 != prob2 {
        return p + size + prob2
    }
    if size <= 0 || prob2 <= 0 || prob2 > 1 {
        return 0.0 / 0.0
    }
    if log_p != 0 {
        if p > 0 {
            return 0.0 / 0.0
        }
    } else {
        if p < 0 || p > 1 {
            return 0.0 / 0.0
        }
    }
    shape[0] = size
    shape[1] = prob2
    mu = (size * (1 - prob2)) / prob2
    sigma = Sqrt(size * (1 - prob2)) / prob2
    return DiscPFuncInverter(p, *shape[0], lower_tail, log_p, 0, 1e308 * 10, mu + sigma * qnorm(p, 0, 1, lower_tail, log_p), 1)
}

QPoisGo :: (p: float64, lambda: float64, lower_tail: s32, log_p: s32) -> float64 {
    shape: [3]float64
    mu: float64 = 0
    sigma: float64 = 0
    if p != p || lambda != lambda {
        return p + lambda
    }
    if lambda < 0 {
        return 0.0 / 0.0
    }
    if log_p != 0 {
        if p > 0 {
            return 0.0 / 0.0
        }
    } else {
        if p < 0 || p > 1 {
            return 0.0 / 0.0
        }
    }
    shape[0] = lambda
    mu = lambda
    sigma = Sqrt(lambda)
    return DiscPFuncInverter(p, *shape[0], lower_tail, log_p, 0, 1e308 * 10, mu + sigma * qnorm(p, 0, 1, lower_tail, log_p), 2)
}

DiscPFuncInverter :: (p: float64, shape: *float64, lower_tail: s32, log_p: s32, xlow_in: float64, xhigh_in: float64, x0_in: float64, which: s32) -> float64 {
    have_xlow: s32 = ifx IsFinite(xlow_in) != 0 then 1 else 0
    have_xhigh: s32 = ifx IsFinite(xhigh_in) != 0 then 1 else 0
    check_left: s32 = 1
    xlow: float64 = xlow_in
    xhigh: float64 = xhigh_in
    x0: float64 = x0_in
    step: float64 = 0
    i: s32 = 0
    ex0: float64 = 0
    dt0: float64 = ifx lower_tail != 0 then 0.0 else 1.0
    dt1: float64 = ifx lower_tail != 0 then 1.0 else 0.0
    if log_p != 0 {
        if p > 0 {
            return 0.0 / 0.0
        }
    } else {
        if p < 0 || p > 1 {
            return 0.0 / 0.0
        }
    }
    if p == dt0 {
        return xlow
    }
    if p == dt1 {
        return xhigh
    }
    if IsFinite(x0) != 0 && x0 >= xlow && x0 <= xhigh {
        x0 = x0
    } else if have_xlow != 0 && have_xhigh != 0 {
        x0 = (xlow + xhigh) / 2
    } else if have_xhigh != 0 {
        x0 = xhigh
    } else if have_xlow != 0 {
        x0 = xlow
    } else {
        x0 = 0
    }
    x0 = Round(x0)
    step = 1 + Floor(Fabs(x0) * 2.220446049250313e-16)
    i = 1
    while true {
        if which == 0 {
            ex0 = phyper(x0, shape[0], shape[1], shape[2], lower_tail, log_p) - p
        } else if which == 1 {
            ex0 = pnbinom(x0, shape[0], shape[1], lower_tail, log_p) - p
        } else {
            ex0 = ppois(x0, shape[0], lower_tail, log_p) - p
        }
        if lower_tail == 0 {
            ex0 = 0 - ex0
        }
        if ex0 == 0 {
            return x0
        } else if ex0 < 0 {
            xlow = x0
            have_xlow = 1
            check_left = 0
        } else {
            xhigh = x0
            have_xhigh = 1
            step = 0 - Fabs(step)
        }
        if i > 1 && have_xlow != 0 && have_xhigh != 0 {
            xmid: float64 = Floor((xlow + xhigh) / 2)
            if (xmid - xlow) < 0.5 || (xmid - xlow) < (Fabs(xlow) * 2.220446049250313e-16) {
                if check_left != 0 {
                    e2: float64 = 0
                    if which == 0 {
                        e2 = phyper(xlow, shape[0], shape[1], shape[2], lower_tail, log_p) - p
                    } else if which == 1 {
                        e2 = pnbinom(xlow, shape[0], shape[1], lower_tail, log_p) - p
                    } else {
                        e2 = ppois(xlow, shape[0], lower_tail, log_p) - p
                    }
                    if lower_tail == 0 {
                        e2 = 0 - e2
                    }
                    if e2 >= 0 {
                        return xlow
                    }
                }
                return xhigh
            }
            x0 = xmid
        } else {
            x1: float64 = x0 + step
            if x1 == x0 {
                return 0.0 / 0.0
            } else if x1 >= xlow && x1 <= xhigh {
                x0 = x1
                step *= cast(float64)(2 * i)
            } else {
                newstep: float64 = 1 + Floor(Fabs(x0) * 2.220446049250313e-16)
                if step > 0 {
                    step = newstep
                } else {
                    step = 0 - newstep
                }
                x1 = x0 + step
                if x1 >= xlow && x1 <= xhigh {
                    i += 1
                    continue
                }
                if step > 0 {
                    return xhigh
                }
                return xlow
            }
        }
        i += 1
    }
    return 0
}

QhyperGo :: (p: float64, nr: float64, nb: float64, n: float64, lower_tail: s32, log_p: s32) -> float64 {
    nn2: float64 = nr + nb
    mu: float64 = 0
    sigma: float64 = 0
    sigma_gamma: float64 = 0
    z: float64 = 0
    y: float64 = 0
    shape: [3]float64
    lo: float64 = 0
    hi: float64 = 0
    if p != p || nn2 != nn2 || n != n {
        return p + nn2 + n
    }
    if IsFinite(p) == 0 || IsFinite(nn2) == 0 || nr < 0 || nb < 0 || n < 0 || n > nn2 {
        return 0.0 / 0.0
    }
    shape[0] = nr
    shape[1] = nb
    shape[2] = n
    if nn2 > 2 {
        mu = (n * nr) / nn2
        sigma = Sqrt((nr * nb * n * (nn2 - n)) / (nn2 * nn2 * (nn2 - 1)))
        sigma_gamma = ((nn2 - 2 * nr) * (nn2 - 2 * n)) / ((nn2 - 2) * nn2)
        z = qnorm(p, 0, 1, lower_tail, log_p)
        y = mu + sigma * z + (sigma_gamma * (z * z - 1)) / 6
    } else {
        y = 0
    }
    lo = n - nb
    if lo < 0 {
        lo = 0
    }
    hi = n
    if nr < hi {
        hi = nr
    }
    return DiscPFuncInverter(p, *shape[0], lower_tail, log_p, lo, hi, y, 0)
}

CalculateLoggos :: (traffic: float64, circuits: float64) -> float64 {
    if traffic < 0 || circuits < 1 {
        return 0.0 / 0.0
    }
    return dgamma_go(traffic, circuits + 1, 1, 1) - pgamma(traffic, circuits + 1, 1, 0, 1)
}

CalculateGos :: (traffic: float64, circuits_in: float64, comp: s32) -> float64 {
    circuits: float64 = circuits_in
    gos: float64 = 0
    cir_iter: float64 = 0
    sum2: float64 = 0
    term2: float64 = 0
    n2: float64 = 0
    circuits = Floor(circuits)
    if circuits < 1 || traffic < 0 {
        return -1
    }
    if traffic == 0 {
        gos = cast(float64)(ifx comp != 0 then 1 else 0)
    } else if circuits < 100 {
        cir_iter = 1
        gos = 1
        while cir_iter <= circuits {
            gos = (traffic * gos) / (cir_iter + traffic * gos)
            cir_iter += 1
        }
        if comp != 0 {
            gos = 1 - gos
        }
    } else if (circuits / traffic) < 0.9 {
        sum2 = 0
        term2 = 1
        n2 = circuits
        while n2 > 0 {
            term2 *= n2 / traffic
            if term2 < (2.2204460492503131e-16 * sum2) {
                break
            }
            sum2 += term2
            n2 -= 1
        }
        gos = ifx comp != 0 then (sum2 / (1 + sum2)) else (1 / (1 + sum2))
    } else {
        loggos: float64 = CalculateLoggos(traffic, circuits)
        gos = ifx comp != 0 then (0 - Expm1(loggos)) else Exp(loggos)
    }
    return gos
}

FnProbblock :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    gos: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    gos = CalculateGos(CoerceNumber(*args[0]), CoerceNumber(*args[1]), 0)
    if gos >= 0 {
        return ValNumber(gos)
    }
    return ValError(ERR_VALUE)
}

FnDimcirc :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    traffic: float64 = 0
    des_gos: float64 = 0
    low: float64 = 0
    high: float64 = 0
    mid: float64 = 0
    gos: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    traffic = CoerceNumber(*args[0])
    des_gos = CoerceNumber(*args[1])
    if cast(s32)(des_gos > 0 && des_gos <= 1) == 0 || traffic < 0 {
        return ValError(ERR_VALUE)
    }
    low = 1
    high = 1
    while CalculateGos(traffic, high, 0) > des_gos {
        low = high
        if high >= (1.7976931348623157e308 / 2) {
            return ValError(ERR_NUM)
        }
        high += high
    }
    while (high - low) > 1 {
        mid = Floor((high + low) / 2 + 0.1)
        gos = CalculateGos(traffic, mid, 0)
        if gos > des_gos {
            low = mid
        } else {
            high = mid
        }
    }
    return ValNumber(high)
}

OffCapF :: (traffic: float64, circuits: float64, des_gos: float64, y: *float64) -> s32 {
    gos: float64 = CalculateGos(traffic, circuits, 0)
    if cast(s32)(gos >= 0) == 0 {
        return 1
    }
    y[0] = gos - des_gos
    return 0
}

OffTrafF :: (off_traffic: float64, circuits: float64, traffic: float64, y: *float64) -> s32 {
    comp_gos: float64 = CalculateGos(off_traffic, circuits, 1)
    if cast(s32)(comp_gos >= 0) == 0 {
        return 1
    }
    y[0] = off_traffic * comp_gos - traffic
    return 0
}

FnOffcap :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    circuits: float64 = 0
    des_gos: float64 = 0
    xmax: float64 = 0
    xlo: float64 = 0
    xhi: float64 = 0
    ylo: float64 = 0
    yhi: float64 = 0
    y: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    circuits = CoerceNumber(*args[0])
    des_gos = CoerceNumber(*args[1])
    if cast(s32)(des_gos > 0 && des_gos < 1) == 0 || circuits < 1 {
        return ValError(ERR_VALUE)
    }
    xmax = circuits / (1 - des_gos)
    xlo = 0
    xhi = xmax
    if OffCapF(xlo, circuits, des_gos, *ylo) != 0 {
        return ValError(ERR_VALUE)
    }
    if OffCapF(xhi, circuits, des_gos, *yhi) != 0 {
        return ValError(ERR_VALUE)
    }
    {
        i: s32 = 0
        while i < 100 {
            mid2: float64 = (xlo + xhi) / 2
            if OffCapF(mid2, circuits, des_gos, *y) != 0 {
                return ValError(ERR_VALUE)
            }
            if y == 0 {
                return ValNumber(mid2)
            }
            if cast(s32)(ylo < 0) == cast(s32)(y < 0) {
                xlo = mid2
                ylo = y
            } else {
                xhi = mid2
                yhi = y
            }
            if (xhi - xlo) < (2.2204460492503131e-16 * (Fabs(xlo) + Fabs(xhi))) {
                return ValNumber((xlo + xhi) / 2)
            }
            i += 1
        }
    }
    return ValNumber((xlo + xhi) / 2)
}

FnOfftraf :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    traffic: float64 = 0
    circuits: float64 = 0
    xlo: float64 = 0
    xhi: float64 = 0
    upper: float64 = 0
    ylo: float64 = 0
    yhi: float64 = 0
    y: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    traffic = CoerceNumber(*args[0])
    circuits = CoerceNumber(*args[1])
    if cast(s32)(circuits >= 1) == 0 || traffic < 0 || traffic >= circuits {
        return ValError(ERR_VALUE)
    }
    xlo = traffic
    xhi = circuits
    if OffTrafF(xlo, circuits, traffic, *ylo) != 0 {
        return ValError(ERR_VALUE)
    }
    upper = circuits
    if circuits < (traffic * 2) {
        upper = traffic * 2
    }
    while upper < (1e308 * 10) {
        if OffTrafF(upper, circuits, traffic, *yhi) != 0 {
            return ValError(ERR_VALUE)
        }
        if cast(s32)(ylo < 0) != cast(s32)(yhi < 0) {
            break
        }
        xlo = upper
        ylo = yhi
        upper *= 2
    }
    {
        i: s32 = 0
        while i < 200 {
            mid2: float64 = (xlo + xhi) / 2
            if OffTrafF(mid2, circuits, traffic, *y) != 0 {
                return ValError(ERR_VALUE)
            }
            if y == 0 {
                return ValNumber(mid2)
            }
            if cast(s32)(ylo < 0) == cast(s32)(y < 0) {
                xlo = mid2
                ylo = y
            } else {
                xhi = mid2
                yhi = y
            }
            if (xhi - xlo) < (2.2204460492503131e-16 * (Fabs(xlo) + Fabs(xhi))) {
                return ValNumber((xlo + xhi) / 2)
            }
            i += 1
        }
    }
    return ValNumber((xlo + xhi) / 2)
}

NT_BITMAX :: () -> float64 {
    return 9007199254740992.0
}

NtFactorizeNext :: (n: *u64, p_out: *u64, v_out: *s32) -> s32 {
    p: u64 = 2
    i: s32 = 1
    v: s32 = 0
    n2: u64 = n[0]
    if n2 <= 1 {
        return 1
    }
    while true {
        if NtIthPrime(i, *p) != 0 {
            return 1
        }
        v = 0
        while (n2 % p) == 0 {
            v += 1
            n2 /= p
        }
        if v != 0 {
            break
        }
        i += 1
    }
    n[0] = n2
    p_out[0] = p
    v_out[0] = v
    return 0
}

NtFactorEach :: (n_in: float64, mode: s32, out: *u64) -> s32 {
    mu_val: s32 = 1
    n2: u64 = TruncateToU64(n_in)
    p: u64 = 0
    v: s32 = 0
    ip: s32 = 1
    if n2 <= 1 {
        out[0] = cast(u64)(ifx mode == 4 then 1 else (ifx mode == 5 then 1 else (ifx mode == 6 then 1 else 1)))
        return 0
    }
    if NtIsPrime(n2) != 0 {
        p = n2
        v = 1
        n2 = 1
    } else {
        while n2 > 1 {
            if NtIthPrime(ip, *p) != 0 {
                return 1
            }
            v = 0
            while (n2 % p) == 0 {
                v += 1
                n2 /= p
            }
            if v != 0 {
                if (p * p) > n2 {
                    break
                }
            }
            ip += 1
        }
    }
    {
        pp: u64 = 0
        vv: s32 = 0
        n3: u64 = TruncateToU64(n_in)
        ip2: s32 = 1
        while n3 > 1 {
            if NtIthPrime(ip2, *pp) != 0 {
                return 1
            }
            vv = 0
            while (n3 % pp) == 0 {
                vv += 1
                n3 /= pp
            }
            if vv != 0 {
                if mode == 0 {
                    out[0] *= cast(u64)(vv + 1)
                } else if mode == 1 {
                    pv: u64 = 1
                    k2: s32 = 0
                    while k2 < vv {
                        pv *= pp
                        k2 += 1
                    }
                    if vv == 1 {
                        out[0] *= pp + 1
                    } else {
                        sv: u64 = (pv - 1) / (pp - 1)
                        out[0] *= sv * pp + 1
                    }
                } else if mode == 2 {
                    pv2: u64 = 1
                    k3: s32 = 0
                    while k3 < (vv - 1) {
                        pv2 *= pp
                        k3 += 1
                    }
                    out[0] *= pv2 * (pp - 1)
                } else if mode == 3 {
                    out[0] *= pp
                } else if mode == 4 {
                    if vv >= 2 {
                        out[0] = 1
                        mu_val = 0
                    } else {
                        mu_val = 0 - mu_val
                    }
                } else if mode == 5 {
                    out[0] += 1
                }
            }
            ip2 += 1
        }
        if mode == 4 {
            out[0] = cast(u64)mu_val
        }
        return 0
    }
    return 0
}

ComputeNtPi :: (n: u64) -> float64 {
    lower: u64 = 2
    upper: u64 = 4
    mid: u64 = 0
    p: u64 = 7
    if n <= 1 {
        return 0
    }
    if n < 4 {
        return cast(float64)(n - 1)
    }
    while p < n {
        lower = upper
        if (upper * 2) < 100000000 {
            upper = upper + 1
            if (upper * 2) > 100000000 {
                upper = 100000000
            }
        } else {
            upper = 100000000
        }
        if (upper + 1) > 100000 {
            upper = 100000
        }
        if NtIthPrime(cast(s32)upper, *p) != 0 {
            return -1
        }
    }
    while (upper - lower) > 1 {
        mid = (lower + upper) / 2
        NtIthPrime(cast(s32)mid, *p)
        if p < n {
            lower = mid
        } else if p > n {
            upper = mid
        } else {
            return cast(float64)mid
        }
    }
    NtIthPrime(cast(s32)upper, *p)
    if p == n {
        return cast(float64)(lower + 1)
    }
    return cast(float64)lower
}

FnNtFunc :: (st: *EvalState, args: *Val, count: s32, marks: *s32, mode: s32) -> Val {
    n: float64 = 0
    res: u64 = 1
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    n = Floor(CoerceNumber(*args[0]))
    if n < 1 || n > NT_BITMAX() {
        return ValError(ERR_NUM)
    }
    if mode == 6 {
        if n < 0 {
            return ValNumber(0)
        }
        if n > NT_BITMAX() {
            return ValError(ERR_LIMIT)
        }
        return ValNumber(ComputeNtPi(TruncateToU64(n)))
    }
    res = 1
    if mode == 4 {
        res = 1
    }
    if mode == 5 {
        res = 0
    }
    if NtFactorEach(n, mode, *res) != 0 {
        return ValError(ERR_LIMIT)
    }
    if mode == 4 {
        sres: s32 = 0
        sres = cast(s32)res
        if res > 0x7fffffffffffffff {
            sres = -1
        }
        return ValNumber(cast(float64)sres)
    }
    return ValNumber(cast(float64)res)
}

FnHdate :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    y: s32 = 0
    m: s32 = 0
    d: s32 = 0
    jd: s32 = 0
    hy: s32 = 0
    hm: s32 = 0
    hd: s32 = 0
    mname: [64]s8
    out: [128]s8
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    y = TruncateToS32(CoerceNumber(*args[0]))
    m = TruncateToS32(CoerceNumber(*args[1]))
    d = TruncateToS32(CoerceNumber(*args[2]))
    jd = HdateGdateToJd(d, m, y)
    HdateJdToHdate(jd, *hd, *hm, *hy)
    HdateMonthName(hm, *mname[0])
    FormatText(*out[0], 128, CText("%d %s %d"), hd + 1, *mname[0], hy)
    return ValString(wb_strdup(*out[0]))
}

FnHdateJulian :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    y: s32 = 0
    m: s32 = 0
    d: s32 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    y = TruncateToS32(CoerceNumber(*args[0]))
    m = TruncateToS32(CoerceNumber(*args[1]))
    d = TruncateToS32(CoerceNumber(*args[2]))
    return ValNumber(cast(float64)HdateGdateToJd(d, m, y))
}

GnmAgm :: (a: float64, b: float64) -> float64 {
    ab: float64 = a * b
    scale: float64 = 1
    i: s32 = 0
    ea: s32 = 0
    eb: s32 = 0
    if a < 0 || b < 0 || ab != ab {
        return 0.0 / 0.0
    }
    if a == b {
        return a
    }
    if ab == 0 {
        return 0
    }
    if ab == (1e308 * 10) {
        if a == 0 || b == 0 {
            return 0
        }
        Frexp(a, *ea)
        Frexp(b, *eb)
        scale = Ldexp(1.0, 0 - (ea + eb) / 2)
        a *= scale
        b *= scale
    }
    i = 1
    while i < 20 {
        am: float64 = (a + b) / 2
        gm: float64 = Sqrt(a * b)
        a = am
        b = gm
        if Fabs(a - b) < (a * 2.2204460492503131e-16) {
            break
        }
        i += 1
    }
    return a * (ifx scale == 1 then 1 else (1 / scale))
}

GnmGd :: (x: float64) -> float64 {
    return 2 * Atan(Tanh(x / 2))
}

RegexValid :: (pattern: *s8, case_insensitive: s32, re: *RegexPattern) -> s32 {
    cflags: s32 = 1
    cflags = 1
    if case_insensitive != 0 {
        cflags = 1 | 2
    }
    if RegexCompile(re, pattern, cflags) != 0 {
        return 0
    }
    return 1
}

FnRegexTest :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    text: [512]s8
    pattern: [512]s8
    ci: s32 = 0
    re: RegexPattern
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    CoerceText(*args[0], *text[0], 512)
    CoerceText(*args[1], *pattern[0], 512)
    if count >= 3 {
        if args[2].kind == VAL_ERROR {
            return ValError(args[2].err)
        }
        ci = ifx CoerceNumber(*args[2]) != 0 then 1 else 0
    }
    if RegexValid(*pattern[0], ci, *re) == 0 {
        return ValError(ERR_VALUE)
    }
    {
        pm: [10]RegexMatch
        hit: s32 = cast(s32)(RegexExecute(*re, *text[0], 10, *pm[0], 0) == 0)
        RegexFree(*re)
        return ValBool(hit)
    }
    return ValBool(0)
}

FnRegexExtract :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    text: [512]s8
    pattern: [512]s8
    mode: s32 = 0
    ci: s32 = 0
    re: RegexPattern
    pm: [10]RegexMatch
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    CoerceText(*args[0], *text[0], 512)
    CoerceText(*args[1], *pattern[0], 512)
    if count >= 3 {
        if args[2].kind == VAL_ERROR {
            return ValError(args[2].err)
        }
        mode = TruncateToS32(CoerceNumber(*args[2]))
    }
    if count >= 4 {
        if args[3].kind == VAL_ERROR {
            return ValError(args[3].err)
        }
        ci = ifx CoerceNumber(*args[3]) != 0 then 1 else 0
    }
    if RegexValid(*pattern[0], ci, *re) == 0 {
        return ValError(ERR_VALUE)
    }
    {
        out: [512]s8
        if mode == 0 {
            if RegexExecute(*re, *text[0], 10, *pm[0], 0) == 0 {
                len: s32 = pm[0].rm_eo - pm[0].rm_so
                if len < 0 {
                    len = 0
                }
                if len > 500 {
                    len = 500
                }
                MemoryCopy(cast(*void)(*out[0]), cast(*void)(*text[pm[0].rm_so]), cast(u64)len)
                out[len] = 0
                RegexFree(*re)
                return ValString(wb_strdup(*out[0]))
            }
            RegexFree(*re)
            return ValError(ERR_NA)
        }
        if mode == 2 {
            if RegexExecute(*re, *text[0], 10, *pm[0], 0) == 0 {
                len2: s32 = pm[1].rm_eo - pm[1].rm_so
                if len2 < 0 {
                    len2 = 0
                }
                if len2 > 500 {
                    len2 = 500
                }
                MemoryCopy(cast(*void)(*out[0]), cast(*void)(*text[pm[1].rm_so]), cast(u64)len2)
                out[len2] = 0
                RegexFree(*re)
                return ValString(wb_strdup(*out[0]))
            }
            RegexFree(*re)
            return ValError(ERR_NA)
        }
        RegexFree(*re)
        return ValError(ERR_NA)
    }
    return ValError(ERR_NA)
}

RegexApplyReplacement :: (text: *s8, so: s32, eo: s32, repl: *s8, re: *RegexPattern, pm: *RegexMatch, out: *s8) -> s32 {
    n: s32 = 0
    i: s32 = 0
    while repl[i] != 0 && n < 480 {
        c: s32 = cast(s32)repl[i]
        if (c == 92 || c == 36) && repl[i + 1] >= 48 && repl[i + 1] <= 57 {
            g: s32 = cast(s32)repl[i + 1] - 48
            gs: s32 = pm[g].rm_so
            ge: s32 = pm[g].rm_eo
            if gs >= 0 && ge > gs {
                k: s32 = gs
                while k < ge && n < 500 {
                    out[n] = text[k]
                    n += 1
                    k += 1
                }
            }
            i += 2
        } else {
            out[n] = repl[i]
            n += 1
            i += 1
        }
    }
    out[n] = 0
    return n
}

FnRegexReplace :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    text: [512]s8
    pattern: [512]s8
    repl: [512]s8
    occ: s32 = 0
    ci: s32 = 0
    re: RegexPattern
    pm: [10]RegexMatch
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    if args[2].kind == VAL_ERROR {
        return ValError(args[2].err)
    }
    CoerceText(*args[0], *text[0], 512)
    CoerceText(*args[1], *pattern[0], 512)
    CoerceText(*args[2], *repl[0], 512)
    if count >= 4 {
        if args[3].kind == VAL_ERROR {
            return ValError(args[3].err)
        }
        occ = TruncateToS32(CoerceNumber(*args[3]))
    }
    if count >= 5 {
        if args[4].kind == VAL_ERROR {
            return ValError(args[4].err)
        }
        ci = ifx CoerceNumber(*args[4]) != 0 then 1 else 0
    }
    if RegexValid(*pattern[0], ci, *re) == 0 {
        return ValError(ERR_VALUE)
    }
    {
        out: [2048]s8
        n: s32 = 0
        tlen: s32 = cast(s32)TextLength(*text[0])
        pos: s32 = 0
        inst: s32 = 0
        if occ == 0 {
            while pos <= tlen {
                probe: [512]s8
                plen: s32 = tlen - pos
                if plen < 0 {
                    plen = 0
                }
                if plen > 500 {
                    plen = 500
                }
                MemoryCopy(cast(*void)(*probe[0]), cast(*void)(*text[pos]), cast(u64)plen)
                probe[plen] = 0
                if RegexExecute(*re, *probe[0], 10, *pm[0], 0) != 0 {
                    break
                }
                so: s32 = pos + pm[0].rm_so
                eo: s32 = pos + pm[0].rm_eo
                if eo == so {
                    if so < tlen && n < 2000 {
                        out[n] = text[so]
                        n += 1
                    }
                    pos = so + 1
                } else {
                    k: s32 = pos
                    while k < so && n < 2000 {
                        out[n] = text[k]
                        n += 1
                        k += 1
                    }
                    rep: [512]s8
                    RegexApplyReplacement(*text[0], pm[0].rm_so + pos, pm[0].rm_eo + pos, *repl[0], *re, *pm[0], *rep[0])
                    rl: s32 = cast(s32)TextLength(*rep[0])
                    ri: s32 = 0
                    while ri < rl && n < 2000 {
                        out[n] = rep[ri]
                        n += 1
                        ri += 1
                    }
                    pos = eo
                }
            }
            k2: s32 = pos
            while k2 < tlen && n < 2000 {
                out[n] = text[k2]
                n += 1
                k2 += 1
            }
            out[n] = 0
            RegexFree(*re)
            return ValString(wb_strdup(*out[0]))
        }
        {
            mstart: [64]s32
            mend: [64]s32
            nmatch: s32 = 0
            scan: s32 = 0
            while scan <= tlen && nmatch < 64 {
                probe2: [512]s8
                plen2: s32 = tlen - scan
                if plen2 < 0 {
                    plen2 = 0
                }
                if plen2 > 500 {
                    plen2 = 500
                }
                MemoryCopy(cast(*void)(*probe2[0]), cast(*void)(*text[scan]), cast(u64)plen2)
                probe2[plen2] = 0
                if RegexExecute(*re, *probe2[0], 10, *pm[0], 0) != 0 {
                    break
                }
                so2: s32 = scan + pm[0].rm_so
                eo2: s32 = scan + pm[0].rm_eo
                if eo2 == so2 {
                    scan = so2 + 1
                } else {
                    mstart[nmatch] = so2
                    mend[nmatch] = eo2
                    nmatch += 1
                    scan = eo2
                }
            }
            target: s32 = -1
            if occ > 0 && occ <= nmatch {
                target = occ - 1
            }
            if occ < 0 && (0 - occ) <= nmatch {
                target = nmatch + occ
            }
            if target < 0 {
                RegexFree(*re)
                return ValString(wb_strdup(*text[0]))
            }
            n = 0
            k3: s32 = 0
            while k3 < mstart[target] && n < 2000 {
                out[n] = text[k3]
                n += 1
                k3 += 1
            }
            {
                pm2: [10]RegexMatch
                probe3: [512]s8
                plen3: s32 = mend[target] - mstart[target]
                if plen3 > 500 {
                    plen3 = 500
                }
                MemoryCopy(cast(*void)(*probe3[0]), cast(*void)(*text[mstart[target]]), cast(u64)plen3)
                probe3[plen3] = 0
                RegexExecute(*re, *probe3[0], 10, *pm2[0], 0)
                rep2: [512]s8
                RegexApplyReplacement(*text[0], mstart[target], mend[target], *repl[0], *re, *pm2[0], *rep2[0])
                rl2: s32 = cast(s32)TextLength(*rep2[0])
                ri2: s32 = 0
                while ri2 < rl2 && n < 2000 {
                    out[n] = rep2[ri2]
                    n += 1
                    ri2 += 1
                }
            }
            k4: s32 = mend[target]
            while k4 < tlen && n < 2000 {
                out[n] = text[k4]
                n += 1
                k4 += 1
            }
            out[n] = 0
            RegexFree(*re)
            return ValString(wb_strdup(*out[0]))
        }
    }
    return ValError(ERR_VALUE)
}

FoldAsciiInto :: (s: *s8, out: *s8) {
    i: s32 = 0
    while s[i] != 0 && i < 500 {
        c: s32 = cast(s32)(cast(u8)s[i])
        if c >= 65 && c <= 90 {
            c += 32
        }
        out[i] = cast(s8)c
        i += 1
    }
    out[i] = 0
}

TextAddDelimMatches :: (hay: *s8, needle: *s8, orig_len: s32, is_row: s32, moff: *s32, mlen: *s32, mrow: *s32, mn: *s32) -> s32 {
    nlen: s32 = cast(s32)TextLength(needle)
    p: s32 = 0
    if nlen == 0 {
        return 1
    }
    while hay[p] != 0 {
        q: *s8 = TextFind(*hay[p], needle)
        if q == null {
            return 1
        }
        off: s32 = cast(s32)(cast(s64)(cast(u64)q - cast(u64)hay))
        if mn.* >= 256 {
            return 0
        }
        moff[mn.*] = off
        mlen[mn.*] = orig_len
        mrow[mn.*] = is_row
        mn.* += 1
        p = off + nlen
    }
    return 1
}

TextSortDelimMatches :: (moff: *s32, mlen: *s32, mrow: *s32, mn: *s32) {
    i: s32 = 1
    while i < mn.* {
        o: s32 = moff[i]
        l: s32 = mlen[i]
        r: s32 = mrow[i]
        j: s32 = i - 1
        while j >= 0 && moff[j] > o {
            moff[j + 1] = moff[j]
            mlen[j + 1] = mlen[j]
            mrow[j + 1] = mrow[j]
            j -= 1
        }
        moff[j + 1] = o
        mlen[j + 1] = l
        mrow[j + 1] = r
        i += 1
    }
    w: s32 = 0
    i = 0
    last_pos: s32 = 0
    while i < mn.* {
        if moff[i] >= last_pos {
            moff[w] = moff[i]
            mlen[w] = mlen[i]
            mrow[w] = mrow[i]
            last_pos = moff[i] + mlen[i]
            w += 1
        }
        i += 1
    }
    mn.* = w
}

TextCollectDelims :: (st: *EvalState, args: *Val, count: s32, marks: *s32, group: s32, hay_folded: *s8, match_mode: s32, moff: *s32, mlen: *s32, mrow: *s32, mn: *s32) -> s32 {
    dstart: s32 = 0
    dlen: s32 = 0
    dbuf: [512]s8
    dfold: [512]s8
    i: s32 = 0
    GroupBounds(marks, count, group, *dstart, *dlen)
    i = 0
    while i < dlen {
        CoerceText(*args[dstart + i], *dbuf[0], 512)
        if match_mode == 1 {
            FoldAsciiInto(*dbuf[0], *dfold[0])
            if TextAddDelimMatches(hay_folded, *dfold[0], cast(s32)TextLength(*dbuf[0]), 0, moff, mlen, mrow, mn) == 0 {
                return 0
            }
        } else {
            if TextAddDelimMatches(hay_folded, *dbuf[0], cast(s32)TextLength(*dbuf[0]), 0, moff, mlen, mrow, mn) == 0 {
                return 0
            }
        }
        i += 1
    }
    return 1
}

FnTextBefore :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    text: [512]s8
    tfold: [512]s8
    moff: [256]s32
    mlen: [256]s32
    mrow: [256]s32
    mn: s32 = 0
    inst: s32 = 1
    match_mode: s32 = 0
    match_end: s32 = 0
    n: s32 = 0
    target: s32 = -1
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    CoerceText(*args[0], *text[0], 512)
    if count >= 3 {
        if args[2].kind == VAL_ERROR {
            return ValError(args[2].err)
        }
        if args[2].kind == VAL_STRING {
            return ValError(ERR_VALUE)
        }
        inst = TruncateToS32(CoerceNumber(*args[2]))
    }
    if count >= 4 {
        if args[3].kind == VAL_ERROR {
            return ValError(args[3].err)
        }
        if args[3].kind == VAL_STRING {
            return ValError(ERR_VALUE)
        }
        match_mode = ifx CoerceNumber(*args[3]) != 0 then 1 else 0
    }
    if count >= 5 {
        if args[4].kind == VAL_ERROR {
            return ValError(args[4].err)
        }
        if args[4].kind == VAL_STRING {
            return ValError(ERR_VALUE)
        }
        match_end = ifx CoerceNumber(*args[4]) != 0 then 1 else 0
    }
    if count >= 6 && args[5].kind == VAL_STRING {
        return ValError(ERR_VALUE)
    }
    if inst == 0 {
        return ValError(ERR_VALUE)
    }
    if match_mode == 1 {
        FoldAsciiInto(*text[0], *tfold[0])
        if TextCollectDelims(st, args, count, marks, 1, *tfold[0], match_mode, *moff[0], *mlen[0], *mrow[0], *mn) == 0 {
            return ValError(ERR_VALUE)
        }
    } else {
        if TextCollectDelims(st, args, count, marks, 1, *text[0], match_mode, *moff[0], *mlen[0], *mrow[0], *mn) == 0 {
            return ValError(ERR_VALUE)
        }
    }
    TextSortDelimMatches(*moff[0], *mlen[0], *mrow[0], *mn)
    n = mn
    if inst > 0 {
        if inst <= n {
            target = inst - 1
        } else if match_end == 1 {
            return ValString(wb_strdup(*text[0]))
        }
    } else {
        ai: s32 = 0 - inst
        if ai <= n {
            target = n - ai
        } else if match_end == 1 {
            return ValString(wb_strdup(CText("")))
        }
    }
    if target != -1 {
        out: [512]s8
        cp: s32 = moff[target]
        if cp > 500 {
            cp = 500
        }
        MemoryCopy(cast(*void)(*out[0]), cast(*void)(*text[0]), cast(u64)cp)
        out[cp] = 0
        return ValString(wb_strdup(*out[0]))
    }
    if count >= 6 {
        return ValCopy(*args[5])
    }
    return ValError(ERR_NA)
}

FnTextAfter :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    text: [512]s8
    tfold: [512]s8
    moff: [256]s32
    mlen: [256]s32
    mrow: [256]s32
    mn: s32 = 0
    inst: s32 = 1
    match_mode: s32 = 0
    match_end: s32 = 0
    n: s32 = 0
    target: s32 = -1
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    CoerceText(*args[0], *text[0], 512)
    if count >= 3 {
        if args[2].kind == VAL_ERROR {
            return ValError(args[2].err)
        }
        if args[2].kind == VAL_STRING {
            return ValError(ERR_VALUE)
        }
        inst = TruncateToS32(CoerceNumber(*args[2]))
    }
    if count >= 4 {
        if args[3].kind == VAL_ERROR {
            return ValError(args[3].err)
        }
        if args[3].kind == VAL_STRING {
            return ValError(ERR_VALUE)
        }
        match_mode = ifx CoerceNumber(*args[3]) != 0 then 1 else 0
    }
    if count >= 5 {
        if args[4].kind == VAL_ERROR {
            return ValError(args[4].err)
        }
        if args[4].kind == VAL_STRING {
            return ValError(ERR_VALUE)
        }
        match_end = ifx CoerceNumber(*args[4]) != 0 then 1 else 0
    }
    if count >= 6 && args[5].kind == VAL_STRING {
        return ValError(ERR_VALUE)
    }
    if inst == 0 {
        return ValError(ERR_VALUE)
    }
    if match_mode == 1 {
        FoldAsciiInto(*text[0], *tfold[0])
        if TextCollectDelims(st, args, count, marks, 1, *tfold[0], match_mode, *moff[0], *mlen[0], *mrow[0], *mn) == 0 {
            return ValError(ERR_VALUE)
        }
    } else {
        if TextCollectDelims(st, args, count, marks, 1, *text[0], match_mode, *moff[0], *mlen[0], *mrow[0], *mn) == 0 {
            return ValError(ERR_VALUE)
        }
    }
    TextSortDelimMatches(*moff[0], *mlen[0], *mrow[0], *mn)
    n = mn
    if inst > 0 {
        if inst <= n {
            target = inst - 1
        } else if match_end == 1 {
            return ValString(wb_strdup(CText("")))
        }
    } else {
        ai: s32 = 0 - inst
        if ai <= n {
            target = n - ai
        } else if match_end == 1 {
            return ValString(wb_strdup(*text[0]))
        }
    }
    if target != -1 {
        from: s32 = moff[target] + mlen[target]
        if from > 500 {
            from = 500
        }
        return ValString(wb_strdup(*text[from]))
    }
    if count >= 6 {
        return ValCopy(*args[5])
    }
    return ValError(ERR_NA)
}

FnTextSplit :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    text: [512]s8
    tfold: [512]s8
    moff: [256]s32
    mlen: [256]s32
    mrow: [256]s32
    mn: s32 = 0
    ignore_empty: s32 = 0
    match_mode: s32 = 0
    last_pos: s32 = 0
    first: [512]s8
    have_first: s32 = 0
    hay: *s8 = null
    i: s32 = 0
    tlen: s32 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    CoerceText(*args[0], *text[0], 512)
    tlen = cast(s32)TextLength(*text[0])
    if count >= 4 {
        if args[3].kind == VAL_ERROR {
            return ValError(args[3].err)
        }
        ignore_empty = ifx CoerceNumber(*args[3]) != 0 then 1 else 0
    }
    if count >= 5 {
        if args[4].kind == VAL_ERROR {
            return ValError(args[4].err)
        }
        match_mode = ifx CoerceNumber(*args[4]) != 0 then 1 else 0
    }
    if match_mode == 1 {
        FoldAsciiInto(*text[0], *tfold[0])
        hay = *tfold[0]
    } else {
        hay = *text[0]
    }
    if count >= 2 {
        dstart: s32 = 0
        dlen: s32 = 0
        dbuf: [512]s8
        dfold: [512]s8
        GroupBounds(marks, count, 1, *dstart, *dlen)
        i = 0
        while i < dlen {
            CoerceText(*args[dstart + i], *dbuf[0], 512)
            if match_mode == 1 {
                FoldAsciiInto(*dbuf[0], *dfold[0])
                TextAddDelimMatches(hay, *dfold[0], cast(s32)TextLength(*dbuf[0]), 0, *moff[0], *mlen[0], *mrow[0], *mn)
            } else {
                TextAddDelimMatches(hay, *dbuf[0], cast(s32)TextLength(*dbuf[0]), 0, *moff[0], *mlen[0], *mrow[0], *mn)
            }
            i += 1
        }
    }
    if count >= 3 {
        dstart2: s32 = 0
        dlen2: s32 = 0
        dbuf2: [512]s8
        dfold2: [512]s8
        GroupBounds(marks, count, 2, *dstart2, *dlen2)
        i = 0
        while i < dlen2 {
            CoerceText(*args[dstart2 + i], *dbuf2[0], 512)
            if match_mode == 1 {
                FoldAsciiInto(*dbuf2[0], *dfold2[0])
                TextAddDelimMatches(hay, *dfold2[0], cast(s32)TextLength(*dbuf2[0]), 1, *moff[0], *mlen[0], *mrow[0], *mn)
            } else {
                TextAddDelimMatches(hay, *dbuf2[0], cast(s32)TextLength(*dbuf2[0]), 1, *moff[0], *mlen[0], *mrow[0], *mn)
            }
            i += 1
        }
    }
    TextSortDelimMatches(*moff[0], *mlen[0], *mrow[0], *mn)
    i = 0
    while i < mn {
        if ignore_empty == 0 || moff[i] > last_pos {
            if have_first == 0 {
                plen: s32 = moff[i] - last_pos
                if plen < 0 {
                    plen = 0
                }
                if plen > 500 {
                    plen = 500
                }
                MemoryCopy(cast(*void)(*first[0]), cast(*void)(*text[last_pos]), cast(u64)plen)
                first[plen] = 0
                have_first = 1
            }
        }
        last_pos = moff[i] + mlen[i]
        i += 1
    }
    if ignore_empty == 0 || last_pos < tlen {
        if have_first == 0 {
            cp: s32 = last_pos
            if cp > 500 {
                cp = 500
            }
            MemoryCopy(cast(*void)(*first[0]), cast(*void)(*text[cp]), cast(u64)(ifx (tlen - cp) > 500 then 500 else (tlen - cp)))
            first[ifx (tlen - cp) > 500 then 500 else (tlen - cp)] = 0
            have_first = 1
        }
    }
    if have_first == 0 {
        return ValEmpty()
    }
    return ValString(wb_strdup(*first[0]))
}

WildXlMatch :: (pat: *s8, txt: *s8) -> s32 {
    pc: [128]s32
    pl: [128]s32
    pn: s32 = 0
    i: s32 = 0
    while pat[i] != 0 && pn < 126 {
        c: s32 = cast(s32)(cast(u8)pat[i])
        lit: s32 = 0
        if c == 126 && (pat[i + 1] == 42 || pat[i + 1] == 63 || pat[i + 1] == 126) {
            i += 1
            c = cast(s32)(cast(u8)pat[i])
            lit = 1
        }
        pc[pn] = c
        pl[pn] = lit
        pn += 1
        i += 1
    }
    p: s32 = 0
    t: s32 = 0
    star: s32 = -1
    mark: s32 = -1
    while txt[t] != 0 {
        tc: s32 = cast(s32)(cast(u8)txt[t])
        if p < pn && pl[p] == 0 && pc[p] == 42 {
            star = p
            p += 1
            mark = t
        } else if p < pn && pl[p] == 0 && pc[p] == 63 {
            p += 1
            t += 1
        } else if p < pn && (pl[p] != 0 || pc[p] != 42) && pc[p] == tc {
            p += 1
            t += 1
        } else if star >= 0 {
            p = star + 1
            mark += 1
            t = mark
        } else {
            return 0
        }
    }
    while p < pn && pl[p] == 0 && pc[p] == 42 {
        p += 1
    }
    if p >= pn {
        return 1
    }
    return 0
}

XVectorCollect :: (st: *EvalState, args: *Val, count: s32, marks: *s32, group: s32, find: *Val, cidx: *s32, cnum: *float64, cstr: *s8, cstrn: *s32, n_out: *s32) -> s32 {
    start: s32 = 0
    len: s32 = 0
    i: s32 = 0
    w: s32 = 0
    GroupBounds(marks, count, group, *start, *len)
    i = 0
    while i < len && w < 128 {
        v: *Val = *args[start + i]
        ok: s32 = 0
        if find.kind == VAL_STRING && v.kind == VAL_STRING {
            ok = 1
        }
        if find.kind == VAL_FLOAT && v.kind == VAL_FLOAT {
            ok = 1
        }
        if find.kind == VAL_BOOL && v.kind == VAL_BOOL {
            ok = 1
        }
        if ok != 0 {
            cidx[w] = i
            if find.kind == VAL_STRING {
                sbuf: [128]s8
                fbuf: [128]s8
                FormatText(*sbuf[0], 128, CText("%s"), v.text)
                FoldAsciiInto(*sbuf[0], *fbuf[0])
                FormatText(*cstr[w * 128], 128, CText("%s"), *fbuf[0])
                cstrn[w] = cast(s32)TextLength(*fbuf[0])
            } else {
                cnum[w] = ifx v.kind == VAL_FLOAT then v.number else v.number
            }
            w += 1
        }
        i += 1
    }
    n_out.* = w
    return 1
}

XCompare :: (find: *Val, fnum: float64, fstr: *s8, cnum: float64, cstr: *s8) -> s32 {
    if find.kind == VAL_STRING {
        return TextCompare(fstr, cstr)
    }
    if fnum < cnum {
        return -1
    }
    if fnum > cnum {
        return 1
    }
    return 0
}

XFindIndex :: (st: *EvalState, args: *Val, count: s32, marks: *s32, group: s32, find: *Val, match_mode: s32, search_mode: s32) -> s32 {
    cidx: [128]s32
    cnum: [128]float64
    cstr: [128][128]s8
    cstrn: [128]s32
    n: s32 = 0
    fnum: float64 = 0
    fbuf: [128]s8
    ffold: [128]s8
    low: s32 = 0
    high: s32 = 0
    lastlow: s32 = -1
    i: s32 = 0
    XVectorCollect(st, args, count, marks, group, find, *cidx[0], *cnum[0], *cstr[0][0], *cstrn[0], *n)
    if n == 0 {
        return -1
    }
    if find.kind == VAL_STRING {
        FormatText(*fbuf[0], 128, CText("%s"), find.text)
        FoldAsciiInto(*fbuf[0], *ffold[0])
    } else {
        fnum = CoerceNumber(find)
    }
    if search_mode == 2 || search_mode == -2 {
        tp: s32 = ifx search_mode == 2 then 1 else (-1)
        lastlow = -1
        low = 0
        high = n - 1
        while low <= high {
            mid: s32 = (low + high) / 2
            c: s32 = XCompare(find, fnum, *ffold[0], cnum[mid], *cstr[mid][0])
            if c == 0 {
                return cidx[mid]
            }
            if tp < 0 {
                c = 0 - c
            }
            if c > 0 {
                lastlow = mid
                low = mid + 1
            } else {
                high = mid - 1
            }
        }
        if match_mode == 0 {
            return -1
        }
        if match_mode == -1 {
            if lastlow >= 0 {
                return cidx[lastlow]
            }
            return -1
        }
        if match_mode == 1 {
            if (lastlow + 1) < n {
                return cidx[lastlow + 1]
            }
            return -1
        }
        return -1
    }
    sstart: s32 = ifx search_mode == -1 then (n - 1) else 0
    send: s32 = ifx search_mode == -1 then (-1) else n
    step: s32 = ifx search_mode == -1 then (-1) else 1
    if match_mode == 2 && find.kind == VAL_STRING {
        pat: [128]s8
        FormatText(*pat[0], 128, CText("%s"), find.text)
        i = sstart
        while i != send {
            if WildXlMatch(*pat[0], *cstr[i][0]) != 0 {
                return cidx[i]
            }
            i += step
        }
        return -1
    }
    i = sstart
    while i != send {
        if XCompare(find, fnum, *ffold[0], cnum[i], *cstr[i][0]) == 0 {
            return cidx[i]
        }
        i += step
    }
    if match_mode == 0 || match_mode == 2 {
        return -1
    }
    best: s32 = -1
    i = sstart
    while i != send {
        c: s32 = XCompare(find, fnum, *ffold[0], cnum[i], *cstr[i][0])
        if match_mode == -1 && c > 0 {
            if best == -1 {
                best = i
            } else if find.kind == VAL_STRING {
                if TextCompare(*cstr[i][0], *cstr[best][0]) > 0 {
                    best = i
                }
            } else {
                if cnum[i] > cnum[best] {
                    best = i
                }
            }
        } else if match_mode == 1 && c < 0 {
            if best == -1 {
                best = i
            } else if find.kind == VAL_STRING {
                if TextCompare(*cstr[i][0], *cstr[best][0]) < 0 {
                    best = i
                }
            } else {
                if cnum[i] < cnum[best] {
                    best = i
                }
            }
        }
        i += step
    }
    if best != -1 {
        return cidx[best]
    }
    return -1
}

FnXmatch :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    match_mode: s32 = 0
    search_mode: s32 = 1
    idx: s32 = 0
    ga: s32 = 0
    gl: s32 = 0
    if groups < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if groups >= 3 {
        GroupBounds(marks, count, 2, *ga, *gl)
        if args[ga].kind == VAL_ERROR {
            return ValError(args[ga].err)
        }
        match_mode = TruncateToS32(CoerceNumber(*args[ga]))
    }
    if groups >= 4 {
        GroupBounds(marks, count, 3, *ga, *gl)
        if args[ga].kind == VAL_ERROR {
            return ValError(args[ga].err)
        }
        search_mode = TruncateToS32(CoerceNumber(*args[ga]))
    }
    idx = XFindIndex(st, args, count, marks, 1, *args[0], match_mode, search_mode)
    if idx >= 0 {
        return ValNumber(cast(float64)(idx + 1))
    }
    return ValError(ERR_NA)
}

FnXlookup :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = ArgGroupCount(args, marks, count)
    match_mode: s32 = 0
    search_mode: s32 = 1
    idx: s32 = 0
    rstart: s32 = 0
    rlen: s32 = 0
    ga: s32 = 0
    gl: s32 = 0
    if groups < 3 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if groups >= 5 {
        GroupBounds(marks, count, 4, *ga, *gl)
        if args[ga].kind == VAL_ERROR {
            return ValError(args[ga].err)
        }
        match_mode = TruncateToS32(CoerceNumber(*args[ga]))
    }
    if groups >= 6 {
        GroupBounds(marks, count, 5, *ga, *gl)
        if args[ga].kind == VAL_ERROR {
            return ValError(args[ga].err)
        }
        search_mode = TruncateToS32(CoerceNumber(*args[ga]))
    }
    idx = XFindIndex(st, args, count, marks, 1, *args[0], match_mode, search_mode)
    if idx >= 0 {
        GroupBounds(marks, count, 2, *rstart, *rlen)
        if idx >= rlen {
            return ValError(ERR_REF)
        }
        return ValCopy(*args[rstart + idx])
    }
    if groups >= 4 {
        GroupBounds(marks, count, 3, *ga, *gl)
        return ValCopy(*args[ga])
    }
    return ValError(ERR_NA)
}

IntlWeekendDecode :: (args: *Val, count: s32, weekend_index: s32, weekends: *s32, nwork: *s32) -> s32 {
    i: s32 = 0
    i = 0
    while i < 7 {
        weekends[i] = 0
        i += 1
    }
    nwork.* = 0
    if weekend_index >= count {
        weekends[0] = 1
        weekends[6] = 1
        nwork.* = 5
        return 1
    }
    v: *Val = *args[weekend_index]
    if v.kind == VAL_ERROR {
        return 0
    }
    if v.kind == VAL_FLOAT || v.kind == VAL_BOOL {
        id: s32 = TruncateToS32(CoerceNumber(v))
        if id == 1 {
            weekends[6] = 1
            weekends[0] = 1
        } else if id == 2 {
            weekends[0] = 1
            weekends[1] = 1
        } else if id == 3 {
            weekends[1] = 1
            weekends[2] = 1
        } else if id == 4 {
            weekends[2] = 1
            weekends[3] = 1
        } else if id == 5 {
            weekends[3] = 1
            weekends[4] = 1
        } else if id == 6 {
            weekends[4] = 1
            weekends[5] = 1
        } else if id == 7 {
            weekends[5] = 1
            weekends[6] = 1
        } else if id == 11 {
            weekends[0] = 1
        } else if id == 12 {
            weekends[1] = 1
        } else if id == 13 {
            weekends[2] = 1
        } else if id == 14 {
            weekends[3] = 1
        } else if id == 15 {
            weekends[4] = 1
        } else if id == 16 {
            weekends[5] = 1
        } else if id == 17 {
            weekends[6] = 1
        } else {
            return 0
        }
    } else if v.kind == VAL_STRING {
        sbuf: [32]s8
        CoerceText(v, *sbuf[0], 32)
        if TextLength(*sbuf[0]) != 7 {
            return 0
        }
        i = 0
        while i < 7 {
            if sbuf[i] == 49 {
                weekends[(i + 1) % 7] = 1
            } else if sbuf[i] == 48 {
                weekends[(i + 1) % 7] = 0
            } else {
                return 0
            }
            i += 1
        }
    } else {
        return 0
    }
    nwork.* = 0
    i = 0
    while i < 7 {
        if weekends[i] == 0 {
            nwork.* += 1
        }
        i += 1
    }
    return 1
}

IntlWeekendHit :: (serial: s32, weekends: *s32) -> s32 {
    wd: s32 = WeekdayMon0(serial)
    return weekends[(wd + 1) % 7]
}

FnWorkdayIntl :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    serial: s32 = 0
    days: float64 = 0
    idays: s32 = 0
    weekends: [7]s32
    nwork: s32 = 0
    hol: [256]s32
    nhol: s32 = 0
    step: s32 = 0
    moved: s32 = 0
    y: s32 = 0
    m: s32 = 0
    d: s32 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    serial = TruncateToS32(CoerceNumber(*args[0]))
    days = CoerceNumber(*args[1])
    idays = TruncateToS32(days)
    if IntlWeekendDecode(args, count, 2, *weekends[0], *nwork) == 0 {
        return ValError(ERR_VALUE)
    }
    nhol = CollectHolidays(args, count, 3, *hol[0], 256)
    if nwork == 0 && idays != 0 {
        return ValError(ERR_VALUE)
    }
    if idays == 0 {
        return ValNumber(cast(float64)serial)
    }
    step = ifx idays > 0 then 1 else (-1)
    while moved < (ifx idays > 0 then idays else (0 - idays)) {
        serial += step
        if IntlWeekendHit(serial, *weekends[0]) == 0 {
            ishol: s32 = 0
            k: s32 = 0
            while k < nhol {
                if hol[k] == serial {
                    ishol = 1
                }
                k += 1
            }
            if ishol == 0 {
                moved += 1
            }
        }
    }
    CivilFromDays(serial + SerialEpoch(), *y, *m, *d)
    if y < 1900 || y > 9999 {
        return ValError(ERR_NUM)
    }
    return ValNumber(cast(float64)serial)
}

FnNetworkdaysIntl :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    start_s: s32 = 0
    end_s: s32 = 0
    total: s32 = 0
    weekends: [7]s32
    nwork: s32 = 0
    hol: [256]s32
    nhol: s32 = 0
    s: s32 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    start_s = TruncateToS32(CoerceNumber(*args[0]))
    end_s = TruncateToS32(CoerceNumber(*args[1]))
    if start_s > end_s {
        t: s32 = start_s
        start_s = end_s
        end_s = t
    }
    if IntlWeekendDecode(args, count, 2, *weekends[0], *nwork) == 0 {
        return ValError(ERR_VALUE)
    }
    if nwork == 0 {
        return ValNumber(0)
    }
    nhol = CollectHolidays(args, count, 3, *hol[0], 256)
    s = start_s
    while s <= end_s {
        if IntlWeekendHit(s, *weekends[0]) == 0 {
            ishol: s32 = 0
            k: s32 = 0
            while k < nhol {
                if hol[k] == s {
                    ishol = 1
                }
                k += 1
            }
            if ishol == 0 {
                total += 1
            }
        }
        s += 1
    }
    return ValNumber(cast(float64)total)
}

PartSigma :: (k: s32) -> float64 {
    total: float64 = cast(float64)(k + 1)
    d: s32 = 2
    if k <= 1 {
        return 1
    }
    while (d * d) <= k {
        if (k % d) == 0 {
            other: s32 = k / d
            total += cast(float64)d
            if other != d {
                total += cast(float64)other
            }
        }
        d += 1
    }
    return total
}

FnPartitions :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    n: s32 = 0
    m: s32 = 0
    k: s32 = 0
    cache: [100001]float64
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    n = TruncateToS32(Floor(CoerceNumber(*args[0])))
    if n < 0 {
        return ValError(ERR_NUM)
    }
    if n > 100000 {
        return ValError(ERR_VALUE)
    }
    cache[0] = 1
    m = 1
    while m <= n {
        sum2: float64 = 0
        k = 1
        while k <= m {
            sum2 += PartSigma(k) * cache[m - k]
            k += 1
        }
        cache[m] = sum2 / cast(float64)m
        m += 1
    }
    return ValNumber(cache[n])
}

PtukyWprob :: (w: float64, rr: float64, cc: float64) -> float64 {
    xleg: [6]float64
    xleg[0] = 0.981560634246719250690549090149
    xleg[1] = 0.904117256370474856678465866119
    xleg[2] = 0.769902674194304687036893833213
    xleg[3] = 0.587317954286617447296702418941
    xleg[4] = 0.367831498998180193752691536644
    xleg[5] = 0.125233408511468915472441369464
    aleg: [6]float64
    aleg[0] = 0.047175336386511827194615961485
    aleg[1] = 0.106939325995318430960254718194
    aleg[2] = 0.160078328543346226334652529543
    aleg[3] = 0.203167426723065921749064455810
    aleg[4] = 0.233492536538354808760849898925
    aleg[5] = 0.249147045813402785000562436043
    nleg: s32 = 12
    qsqz: float64 = w * 0.5
    pr_w: float64 = 0
    blb: float64 = 0
    binc: float64 = 0
    i: s32 = 0
    if qsqz > 1 {
        pr_w = Pow1p(0 - 2 * pnorm(qsqz, 0, 1, 0, 0), cc)
    } else {
        pr_w = Pow(Erf(qsqz / 1.414213562373095048801688724209), cc)
    }
    if pr_w >= 1 {
        return 1.0
    }
    blb = qsqz
    binc = 3 / Log1p(cc)
    i = 1
    while true {
        C: float64 = blb + binc * 0.5
        elsum: float64 = 0
        jj: s32 = 0
        while jj < nleg {
            xx_value: float64 = 0
            aa: float64 = 0
            if (nleg / 2) <= jj {
                xx_value = xleg[nleg - 1 - jj]
                aa = aleg[nleg - 1 - jj]
            } else {
                xx_value = 0 - xleg[jj]
                aa = aleg[jj]
            }
            v: float64 = C + binc * 0.5 * xx_value
            rinsum: float64 = Pnorm2(v - w, v)
            elsum += Pow(rinsum, cc - 1) * aa * Exp(0 - v * v * 0.5)
            jj += 1
        }
        elsum *= binc * cc * 0.398942280401432677939946059934
        pr_w += elsum
        if pr_w >= 1 {
            pr_w = 1
            break
        }
        if elsum <= (pr_w * (2.2204460492503131e-16 / 2)) {
            break
        }
        blb += binc
        i += 1
    }
    return Pow(pr_w, rr)
}

PtukyOtsum :: (u0: float64, u1: float64, f2: float64, f2lf: float64, q: float64, rr: float64, cc: float64) -> float64 {
    xlegq: [8]float64
    xlegq[0] = 0.989400934991649932596154173450
    xlegq[1] = 0.944575023073232576077988415535
    xlegq[2] = 0.865631202387831743880467897712
    xlegq[3] = 0.755404408355003033895101194847
    xlegq[4] = 0.617876244402643748446671764049
    xlegq[5] = 0.458016777657227386342419442984
    xlegq[6] = 0.281603550779258913230460501460
    xlegq[7] = 0.0950125098376374401853193354250
    alegq: [8]float64
    alegq[0] = 0.0271524594117540948517805724560
    alegq[1] = 0.0622535239386478928628438369944
    alegq[2] = 0.0951585116824927848099251076022
    alegq[3] = 0.124628971255533872052476282192
    alegq[4] = 0.149595988816576732081501730547
    alegq[5] = 0.169156519395002538189312079030
    alegq[6] = 0.182603415044923588866763667969
    alegq[7] = 0.189450610455068496285396723208
    nlegq: s32 = 16
    C: float64 = 0.5 * (u0 + u1)
    L: float64 = u1 - u0
    otsum: float64 = 0
    jj: s32 = 0
    while jj < nlegq {
        xx_value: float64 = 0
        aa: float64 = 0
        if (nlegq / 2) <= jj {
            xx_value = xlegq[nlegq - 1 - jj]
            aa = alegq[nlegq - 1 - jj]
        } else {
            xx_value = 0 - xlegq[jj]
            aa = alegq[jj]
        }
        u: float64 = xx_value * (0.5 * L) + C
        t1: float64 = f2lf + (f2 - 1) * Log(u) - u * f2
        wprb: float64 = PtukyWprob(q * Sqrt(u), rr, cc)
        otsum += aa * (wprb * (0.5 * L) * Exp(t1))
        jj += 1
    }
    return otsum
}

RPtukey :: (q: float64, rr: float64, cc: float64, df: float64, lower_tail: s32, log_p: s32) -> float64 {
    dhaf: float64 = 100.0
    dquar: float64 = 800.0
    deigh: float64 = 5000.0
    dlarg: float64 = 25000.0
    ulen: float64 = 0
    ans: float64 = 0
    f2: float64 = 0
    f2lf: float64 = 0
    u0: float64 = 0
    u1: float64 = 0
    i: s32 = 0
    if q != q || rr != rr || cc != cc || df != df {
        return 0.0 / 0.0
    }
    if q <= 0 {
        if log_p != 0 {
            return ifx lower_tail != 0 then (-1e308 * 10) else 0.0
        }
        return ifx lower_tail != 0 then 0.0 else 1.0
    }
    if df < 2 || rr < 1 || cc < 2 {
        return 0.0 / 0.0
    }
    if IsFinite(q) == 0 {
        if log_p != 0 {
            return ifx lower_tail != 0 then 0.0 else (1e308 * 10)
        }
        return ifx lower_tail != 0 then 1.0 else 0.0
    }
    if df > dlarg {
        wv: float64 = PtukyWprob(q, rr, cc)
        if log_p != 0 {
            return Log(ifx lower_tail != 0 then wv else (1 - wv))
        }
        return ifx lower_tail != 0 then wv else (1 - wv)
    }
    f2 = df * 0.5
    f2lf = f2 * Log(f2) - Lgamma(f2)
    if df <= dhaf {
        ulen = 1.0
    } else if df <= dquar {
        ulen = 0.5
    } else if df <= deigh {
        ulen = 0.25
    } else {
        ulen = 0.125
    }
    ans = 0.0
    u1 = ulen / 2
    i = 1
    while true {
        u0 = u1 / cast(float64)(i + 1)
        otsum: float64 = PtukyOtsum(u0, u1, f2, f2lf, q, rr, cc)
        ans += otsum
        if otsum <= (ans * (2.2204460492503131e-16 / 2)) {
            break
        }
        if i == 20 {
            break
        }
        u1 = u0
        i += 1
    }
    u0 = ulen / 2
    i = 1
    while true {
        u1 = u0 + ulen
        otsum2: float64 = PtukyOtsum(u0, u1, f2, f2lf, q, rr, cc)
        ans += otsum2
        if otsum2 < (ans * 2.2204460492503131e-16) {
            if ans > 0 || u0 > 2 {
                break
            }
        }
        if i == 150 {
            break
        }
        if otsum2 < (ans / 1000) {
            ulen *= 2
        }
        u0 = u1
        i += 1
    }
    if ans > 1 {
        ans = 1
    }
    if log_p != 0 {
        return Log(ifx lower_tail != 0 then ans else (1 - ans))
    }
    return ifx lower_tail != 0 then ans else (1 - ans)
}

PtukeyGo :: (x: float64, nmeans: float64, df: float64, nranges: float64, lower_tail: s32, log_p: s32) -> float64 {
    return RPtukey(x, nranges, nmeans, df, lower_tail, log_p)
}

QtukeyGo :: (p: float64, nmeans: float64, df: float64, nranges: float64, lower_tail: s32, log_p: s32) -> float64 {
    x0: float64 = 0
    shape: [3]float64
    if log_p == 0 && p > 0.9 {
        p = 1 - p
        lower_tail = ifx lower_tail != 0 then 0 else 1
    }
    x0 = 1.414213562373095048801688724209 * qt((1 + p) / 2, df, lower_tail, log_p)
    shape[0] = nmeans
    shape[1] = df
    shape[2] = nranges
    return PFuncInverter(2, p, *shape[0], lower_tail, log_p, 0, 1e308 * 10, x0)
}

