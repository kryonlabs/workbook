dpois_raw :: (x: float64, lambda: float64, give_log: s32) -> float64 {
    d: float64 = 0
    d_l: float64 = 0
    res: float64 = 0
    if IsNan(x) != 0 || cast(s32)(lambda >= 0) == 0 {
        return 0.0 / 0.0
    }
    if lambda == 0 {
        return ifx x == 0 then 1.0 else 0.0
    }
    if lambda == (1e308 * 10) {
        return 0.0
    }
    if x < 0 {
        return 0.0
    }
    if x <= (lambda * 2.2250738585072014e-308) {
        return ifx give_log != 0 then (-lambda) else Exp(-lambda)
    }
    d = x - lambda
    d_l = d / lambda
