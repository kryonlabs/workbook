        return ValError(ERR_VALUE)
    }
    if CxArg(args, count, 1, *b, *unit) < 0 {
        return ValError(ERR_VALUE)
    }
    return CxVal(CxSub(a, b), unit)
}

CxIterate :: (args: *Val, count: s32, product: s32, unit: *s32) -> Val {
    res: Cplx
    c: Cplx
    i: s32 = 0
    unit2: s32 = 106
    if product != 0 {
        res.re = 1
    } else {
        res.re = 0
    }
    while i < count {
        if args[i].kind == VAL_ERROR {
            return ValError(args[i].err)
        }
        if args[i].kind != VAL_EMPTY {
            if CxArg(args, count, i, *c, *unit2) < 0 {
                return ValError(ERR_VALUE)
            }
            if args[i].kind != VAL_FLOAT && args[i].kind != VAL_BOOL {
                unit[0] = unit2
            }
            if product != 0 {
                res = CxMul(res, c)
            } else {
                res = CxAdd(res, c)
            }
        }
        i += 1
    }
    return CxVal(res, unit[0])
}

FnImsum :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    unit: s32 = 106
    return CxIterate(args, count, 0, *unit)
}

FnImproduct :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    unit: s32 = 106
    return CxIterate(args, count, 1, *unit)
}

FnImfact :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    a: Cplx
    unit: s32 = 105
    if CxArg(args, count, 0, *a, *unit) < 0 {
