FnAccrint :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    issue: s32 = 0
    first: s32 = 0
    settle: s32 = 0
    rate: float64 = 0
    par: float64 = 0
    freq: s32 = 0
    basis: s32 = 0
    if count < 4 {
        return ValError(ERR_VALUE)
    }
    issue = ArgDate(args, count, 0, -1)
    first = ArgDate(args, count, 1, -1)
    settle = ArgDate(args, count, 2, -1)
    rate = ArgAt(args, count, 3, 0)
    par = ArgAt(args, count, 4, 1000)
    freq = ArgAtInt(args, count, 5, 1)
    basis = ArgBasis(args, count, 6)
    if issue < 0 || settle < 0 || basis < 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber(par * rate * YearFracBasis(issue, settle, basis))
}

FnAccrintm :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    issue: s32 = 0
    settle: s32 = 0
    rate: float64 = 0
    par: float64 = 0
    basis: s32 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    issue = ArgDate(args, count, 0, -1)
    settle = ArgDate(args, count, 1, -1)
    rate = ArgAt(args, count, 2, 0)
    par = ArgAt(args, count, 3, 1000)
    basis = ArgBasis(args, count, 4)
    if issue < 0 || settle < 0 || basis < 0 {
        return ValError(ERR_NUM)
    }
    a: float64 = cast(float64)DaysMonthlyBasis(issue, settle, basis)
    d: float64 = cast(float64)AnnualBasis(issue, basis)
    if a < 0 || d <= 0 || par <= 0 || rate <= 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber((par * rate * a) / d)
}

FnIntrate :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    settle: s32 = 0
    mature: s32 = 0
    invest: float64 = 0
    red: float64 = 0
    basis: s32 = 0
    if count < 4 {
        return ValError(ERR_VALUE)
    }
    settle = ArgDate(args, count, 0, -1)
    mature = ArgDate(args, count, 1, -1)
    invest = ArgAt(args, count, 2, 0)
    red = ArgAt(args, count, 3, 0)
    basis = ArgBasis(args, count, 4)
    if settle < 0 || mature < 0 || basis < 0 || invest == 0 {
        return ValError(ERR_NUM)
    }
    a: float64 = cast(float64)DaysMonthlyBasis(settle, mature, basis)
    d: float64 = cast(float64)AnnualBasis(settle, basis)
    if a <= 0 || d <= 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber(((red - invest) / invest) * (d / a))
}

FnReceived :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    settle: s32 = 0
    mature: s32 = 0
    invest: float64 = 0
    disc: float64 = 0
    basis: s32 = 0
    if count < 4 {
        return ValError(ERR_VALUE)
    }
    settle = ArgDate(args, count, 0, -1)
    mature = ArgDate(args, count, 1, -1)
    invest = ArgAt(args, count, 2, 0)
    disc = ArgAt(args, count, 3, 0)
    basis = ArgBasis(args, count, 4)
    if settle < 0 || mature < 0 || basis < 0 {
        return ValError(ERR_NUM)
    }
    a: float64 = cast(float64)DaysMonthlyBasis(settle, mature, basis)
    d: float64 = cast(float64)AnnualBasis(settle, basis)
    if a <= 0 || d <= 0 {
        return ValError(ERR_NUM)
    }
    n: float64 = 1 - (disc * a) / d
    if n == 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber(invest / n)
}

FnDisc :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    settle: s32 = 0
    mature: s32 = 0
    par: float64 = 0
    red: float64 = 0
    basis: s32 = 0
    if count < 4 {
        return ValError(ERR_VALUE)
    }
    settle = ArgDate(args, count, 0, -1)
    mature = ArgDate(args, count, 1, -1)
    par = ArgAt(args, count, 2, 0)
    red = ArgAt(args, count, 3, 0)
    basis = ArgBasis(args, count, 4)
    if settle < 0 || mature < 0 || basis < 0 {
        return ValError(ERR_NUM)
    }
    b: float64 = cast(float64)AnnualBasis(settle, basis)
    dsm: float64 = cast(float64)DaysMonthlyBasis(settle, mature, basis)
    if dsm <= 0 || b <= 0 || red == 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber(((red - par) / red) * (b / dsm))
}

FnPricedisc :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    settle: s32 = 0
    mature: s32 = 0
    disc: float64 = 0
    red: float64 = 0
    basis: s32 = 0
    if count < 4 {
        return ValError(ERR_VALUE)
    }
    settle = ArgDate(args, count, 0, -1)
    mature = ArgDate(args, count, 1, -1)
    disc = ArgAt(args, count, 2, 0)
    red = ArgAt(args, count, 3, 0)
    basis = ArgBasis(args, count, 4)
    if settle < 0 || mature < 0 || basis < 0 {
        return ValError(ERR_NUM)
    }
    a: float64 = cast(float64)DaysMonthlyBasis(settle, mature, basis)
    d: float64 = cast(float64)AnnualBasis(settle, basis)
    if a <= 0 || d <= 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber(red - (disc * red * a) / d)
}

FnTbilleq :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    settle: s32 = 0
    mature: s32 = 0
    disc: float64 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    settle = ArgDate(args, count, 0, -1)
    mature = ArgDate(args, count, 1, -1)
    disc = ArgAt(args, count, 2, 0)
    if settle < 0 || mature < 0 {
        return ValError(ERR_NUM)
    }
    dsm: float64 = cast(float64)(mature - settle)
    if settle > mature || disc < 0 || dsm > 365 {
        return ValError(ERR_NUM)
    }
    divisor: float64 = 360 - disc * dsm
    if divisor == 0 {
        return ValError(ERR_DIV0)
    }
    return ValNumber((365 * disc) / divisor)
}

FnTbillprice :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    settle: s32 = 0
    mature: s32 = 0
    disc: float64 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    settle = ArgDate(args, count, 0, -1)
    mature = ArgDate(args, count, 1, -1)
    disc = ArgAt(args, count, 2, 0)
    if settle < 0 || mature < 0 || disc <= 0 || disc >= 1 {
        return ValError(ERR_NUM)
    }
    dsm: float64 = cast(float64)(mature - settle)
    if dsm <= 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber(100 * (1 - (disc * dsm) / 360))
}

FnTbillyield :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    settle: s32 = 0
    mature: s32 = 0
    price: float64 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    settle = ArgDate(args, count, 0, -1)
    mature = ArgDate(args, count, 1, -1)
    price = ArgAt(args, count, 2, 0)
    if settle < 0 || mature < 0 || price <= 0 {
        return ValError(ERR_NUM)
    }
    dsm: float64 = cast(float64)(mature - settle)
    if dsm <= 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber((((100 - price) / price) * 360) / dsm)
}

FnEffect :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    r: float64 = 0
    m: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    r = ArgAt(args, count, 0, 0)
    m = Floor(ArgAt(args, count, 1, 0))
    if r <= 0 || m < 1 {
        return ValError(ERR_NUM)
    }
    return ValNumber(Pow1pm1(r / m, m))
}

FnNominal :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    e: float64 = 0
    m: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    e = ArgAt(args, count, 0, 0)
    m = Floor(ArgAt(args, count, 1, 0))
    if e <= 0 || m < 1 {
        return ValError(ERR_NUM)
    }
    return ValNumber(m * Pow1pm1(e, 1 / m))
}

FnDollarde :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    v: float64 = 0
    frac: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    v = ArgAt(args, count, 0, 0)
    frac = ArgAt(args, count, 1, 0)
    if frac < 0 {
        return ValError(ERR_NUM)
    }
    whole: float64 = cast(float64)TruncateToS64(v)
    rest: float64 = Fabs(v - whole)
    digits: s32 = 1
    fdigits: float64 = frac
    while fdigits >= 10 {
        fdigits /= 10
        digits += 1
    }
    return ValNumber(whole + (rest * FinPower(10.0, cast(float64)digits)) / frac)
}

FnDollarfr :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    v: float64 = 0
    frac: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    v = ArgAt(args, count, 0, 0)
    frac = ArgAt(args, count, 1, 0)
    if frac < 0 {
        return ValError(ERR_NUM)
    }
    whole: float64 = cast(float64)TruncateToS64(v)
    rest: float64 = Fabs(v - whole)
    digits: s32 = 1
    fdigits: float64 = frac
    while fdigits >= 10 {
        fdigits /= 10
        digits += 1
    }
    numerator: float64 = rest * frac
    return ValNumber(whole + numerator / FinPower(10.0, cast(float64)digits))
}

FnFvschedule :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    principal: float64 = 0
    total: float64 = 0
    i: s32 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    principal = ArgAt(args, count, 0, 0)
    total = principal
    i = 1
    while i < count {
        if args[i].kind == VAL_ERROR {
            return ValError(args[i].err)
        }
        if args[i].from_range == 0 {
            return ValError(ERR_NA)
        }
        if args[i].kind == VAL_FLOAT {
            total *= 1 + args[i].number
        }
        i += 1
    }
    return ValNumber(total)
}

PriceGo :: (settle: s32, mature: s32, rate: float64, yld: float64, red: float64, freq: s32, basis: s32) -> float64 {
    a: float64 = CoupDaysBs(settle, mature, freq, basis)
    d: float64 = CoupDaysNc(settle, mature, freq, basis)
    e: float64 = CoupDaysGo(settle, mature, freq, basis)
    n: s32 = CouponCount(settle, mature, freq)
    den: float64 = (100 * rate) / cast(float64)freq
    basem1: float64 = yld / cast(float64)freq
    exponent: float64 = d / e
    if n == 1 {
        return (red + den) / (1 + exponent * basem1) - (a / e) * den
    }
    nd: float64 = cast(float64)n
    sum: float64 = (den * Pow1p(basem1, 1 - nd - exponent) * Pow1pm1(basem1, nd)) / basem1
    first_term: float64 = red / Pow1p(basem1, nd - 1 + d / e)
    last_term: float64 = (a / e) * den
    return first_term + sum - last_term
}

FnPrice :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    settle: s32 = 0
    mature: s32 = 0
    rate: float64 = 0
    yld: float64 = 0
    red: float64 = 0
    freq: s32 = 0
    basis: s32 = 0
    if count < 5 {
        return ValError(ERR_VALUE)
    }
    settle = ArgDate(args, count, 0, -1)
    mature = ArgDate(args, count, 1, -1)
    rate = ArgAt(args, count, 2, 0)
    yld = ArgAt(args, count, 3, 0)
    red = ArgAt(args, count, 4, 100)
    freq = ArgAtInt(args, count, 5, 1)
    basis = ArgBasis(args, count, 6)
    if settle < 0 || mature < 0 || basis < 0 || freq < 1 {
        return ValError(ERR_NUM)
    }
    if settle > mature {
        return ValError(ERR_NUM)
    }
    if rate < 0 || yld < 0 || red <= 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber(PriceGo(settle, mature, rate, yld, red, freq, basis))
}

GsEvalF :: (kind: s32, x: float64, y: *float64) -> s32 {
    sum: float64 = 0
    f: float64 = 1
    ff: float64 = 1
    i: s32 = 0
    n: s32 = 0
    dd: float64 = 0
    if kind == 0 {
        if x > -1 && x != 0 {
            y[0] = GS_R_PV * CalcPvif(x, GS_R_NPER) + GS_R_PMT * (1 + x * cast(float64)GS_R_TYPE) * CalcFvifa(x, GS_R_NPER) + GS_R_FV
            return 1
        }
        return 0
    }
    if kind == 1 {
        ff = 1 / (x + 1)
        n = GS_CASH_N
        while i < n {
            sum += GSV_A[i] * f
            f *= ff
            i += 1
        }
        y[0] = sum
        if sum != sum || (sum - sum) != 0 {
            return 0
        }
        return 1
    }
    if kind == 2 {
        n = GS_CASH_N
        while i < n {
            dd = GSD_A[i] - GSD_A[0]
            if dd < 0 {
                return 0
            }
            sum += GSV_A[i] / Pow1p(x, dd / 365)
            i += 1
        }
        y[0] = sum
        return 1
    }
    y[0] = PriceGo(GS_Y_SETTLE, GS_Y_MAT, GS_Y_RATE, x, GS_Y_RED, GS_Y_FREQ, GS_Y_BASIS) - GS_Y_PAR
    return 1
}

GsEvalDf :: (kind: s32, x: float64, y: *float64) -> s32 {
    sum: float64 = 0
    f: float64 = 1
    ff: float64 = 1
    i: s32 = 1
    n: s32 = 0
    if kind == 0 {
        if x > -1 && x != 0 {
            y[0] = (-GS_R_PMT * CalcFvifa(x, GS_R_NPER)) / x + CalcPvif(x, GS_R_NPER - 1) * GS_R_NPER * (GS_R_PV + GS_R_PMT * (cast(float64)GS_R_TYPE + 1 / x))
            return 1
        }
        return 0
    }
    if kind == 1 {
        ff = 1 / (x + 1)
        n = GS_CASH_N
        while i < n {
            sum += GSV_A[i] * cast(float64)(-i) * f
            f *= ff
            i += 1
        }
        y[0] = sum
        if sum != sum || (sum - sum) != 0 {
            return 0
        }
        return 1
    }
    return 0
}

GsUpdateData :: (x: float64, y: float64, data: *GS) -> s32 {
    if y != y || (y - y) != 0 {
        return 0
    }
    if y > 0 {
        if data.havexpos != 0 {
            if data.havexneg != 0 {
                if Fabs(x - data.xneg) < Fabs(data.xpos - data.xneg) {
                    data.xpos = x
                    data.ypos = y
                }
            } else if y < data.ypos {
                data.xpos = x
                data.ypos = y
            }
        } else {
            data.xpos = x
            data.ypos = y
            data.havexpos = 1
        }
        return 0
    } else if y < 0 {
        if data.havexneg != 0 {
            if data.havexpos != 0 {
                if Fabs(x - data.xpos) < Fabs(data.xpos - data.xneg) {
                    data.xneg = x
                    data.yneg = y
                }
            } else if -y < -data.yneg {
                data.xneg = x
                data.yneg = y
            }
        } else {
            data.xneg = x
            data.yneg = y
            data.havexneg = 1
        }
        return 0
    }
    data.have_root = 1
    data.root = x
    return 1
}

GsFakeDf :: (kind: s32, x: float64, dfx: *float64, xstep: float64, data: *GS) -> s32 {
    xl: float64 = x - xstep
    xr: float64 = x + xstep
    yl: float64 = 0
    yr: float64 = 0
    status: s32 = 0
    if xl < data.xmin {
        xl = x
    }
    if xr > data.xmax {
        xr = x
    }
    if xl == xr {
        return 0
    }
    status = GsEvalF(kind, xl, *yl)
    if status != 1 {
        return status
    }
    status = GsEvalF(kind, xr, *yr)
    if status != 1 {
        return status
    }
    dfx[0] = (yr - yl) / (xr - xl)
    if dfx[0] != dfx[0] || (dfx[0] - dfx[0]) != 0 {
        return 0
    }
    return 1
}

GsInit :: (data: *GS) {
    data.havexpos = 0
    data.havexneg = 0
    data.have_root = 0
    data.xpos = 0.0 / 0.0
    data.xneg = 0.0 / 0.0
    data.root = 0.0 / 0.0
    data.ypos = 0.0 / 0.0
    data.yneg = 0.0 / 0.0
    data.xmin = -1e10
    data.xmax = 1e10
    data.precision = 1e-10
}

GsPoint :: (kind: s32, data: *GS, x0: float64) -> s32 {
    y0: float64 = 0
    status: s32 = 0
    if data.have_root != 0 {
        return 1
    }
    if x0 < data.xmin || x0 > data.xmax {
        return 0
    }
    status = GsEvalF(kind, x0, *y0)
    if status != 1 {
        return status
    }
    if GsUpdateData(x0, y0, data) != 0 {
        return 1
    }
    return 0
}

GsBisection :: (kind: s32, data: *GS) -> s32 {
    iterations: s32 = 0
    newton_submethod: s32 = 0
    stepsize: float64 = 0
    xmid: float64 = 0
    ymid: float64 = 0
    det: float64 = 0
    x0: float64 = 0
    y0: float64 = 0
    xstep: float64 = 0
    df0: float64 = 0
    method: s32 = 0
    fail: s32 = 0
    status: s32 = 0
    if data.have_root != 0 {
        return 1
    }
    if data.havexpos == 0 || data.havexneg == 0 {
        return 0
    }
    stepsize = Fabs(data.xpos - data.xneg) / (Fabs(data.xpos) + Fabs(data.xneg))
    while iterations < 160 {
        fail = 0
        if (iterations % 4) == 0 {
            method = 3
        } else if (iterations % 4) == 2 {
            method = 1
        } else {
            method = 2
        }
        if method == 1 {
            if stepsize > 0.1 {
                method = 2
            }
        }
        if method == 3 {
            xmid = (data.xpos + data.xneg) / 2
            status = GsEvalF(kind, xmid, *ymid)
            if status != 1 {
                fail = 1
            } else {
                if ymid == 0 {
                    GsUpdateData(xmid, ymid, data)
                    return 1
                }
                det = Sqrt(ymid * ymid - data.ypos * data.yneg)
                if det == 0 {
                    fail = 1
                } else {
                    xmid += ((xmid - data.xpos) * ymid) / det
                }
            }
        } else if method == 1 {
            x0 = 0
            y0 = 0
            fail = 0
            if (newton_submethod % 4) == 0 {
                x0 = data.xpos
                y0 = data.ypos
            } else if (newton_submethod % 4) == 2 {
                x0 = data.xneg
                y0 = data.yneg
            } else {
                x0 = (data.xpos + data.xneg) / 2
                status = GsEvalF(kind, x0, *y0)
                if status != 1 {
                    fail = 1
                }
            }
            newton_submethod += 1
            if fail == 0 {
                xstep = Fabs(data.xpos - data.xneg) / 1000000
                status = GsFakeDf(kind, x0, *df0, xstep, data)
                if status != 1 {
                    fail = 1
                }
            }
            if fail == 0 {
                if df0 == 0 {
                    fail = 1
                }
            }
            if fail == 0 {
                xmid = x0 - (1.01 * y0) / df0
            }
        } else {
            xmid = (data.xpos + data.xneg) / 2
        }
        if fail == 0 {
            if (xmid < data.xpos && xmid < data.xneg) || (xmid > data.xpos && xmid > data.xneg) {
                xmid = (data.xpos + data.xneg) / 2
                method = 2
            }
            status = GsEvalF(kind, xmid, *ymid)
            if status != 1 {
                fail = 1
            }
        }
        if fail == 0 {
            if GsUpdateData(xmid, ymid, data) != 0 {
                return 1
            }
            stepsize = Fabs(data.xpos - data.xneg) / (Fabs(data.xpos) + Fabs(data.xneg))
            if stepsize < 2.2204460492503131e-16 {
                if data.yneg < ymid {
                    ymid = data.yneg
                    xmid = data.xneg
                }
                if data.ypos < ymid {
                    ymid = data.ypos
                    xmid = data.xpos
                }
                data.have_root = 1
                data.root = xmid
                return 1
            }
        }
        iterations += 1
    }
    return 0
}

GsNewtonPolish :: (kind: s32, data: *GS, use_df: s32, x0: float64, y0: float64) -> s32 {
    iterations: s32 = 0
    last_df0: float64 = 1
    try_newton: s32 = 1
    try_square: s32 = 0
    x1: float64 = 0
    y1: float64 = 0
    r: float64 = 0
    df0: float64 = 0
    status: s32 = 0
    if x0 != 0 && Fabs(x0) < 1e10 {
        try_square = 1
    }
    while iterations < 20 {
        if try_square != 0 {
            x1 = x0 * Fabs(x0)
            status = GsEvalF(kind, x1, *y1)
            if status == 1 {
                if GsUpdateData(x1, y1, data) != 0 {
                    return 1
                }
                r = Fabs(y1 / y0)
                if r < 1 {
                    x0 = x1
                    if r <= 0.5 {
                        try_square = 0
                    }
                } else {
                    try_square = 0
                }
            } else {
                try_square = 0
            }
        }
        if try_newton != 0 {
            if use_df != 0 {
                status = GsEvalDf(kind, x0, *df0)
            } else {
                status = GsFakeDf(kind, x0, *df0, Fabs(x0) / 1000000, data)
            }
            if status != 1 || df0 == 0 {
                df0 = last_df0
            } else {
                last_df0 = df0
            }
            x1 = x0 - y0 / df0
            if x1 >= data.xmin && x1 <= data.xmax {
                status = GsEvalF(kind, x1, *y1)
                if status == 1 {
                    if GsUpdateData(x1, y1, data) != 0 {
                        return 1
                    }
                    r = Fabs(y1 / y0)
                    if r < 1 {
                        x0 = x1
                        if r > 0.5 {
                            try_newton = 0
                        }
                    } else {
                        try_newton = 0
                    }
                } else {
                    try_newton = 0
                }
            } else {
                try_newton = 0
            }
        }
        if try_square == 0 && try_newton == 0 {
            break
        }
        iterations += 1
    }
    if GsBisection(kind, data) == 1 {
        return 1
    }
    data.root = x0
    data.have_root = 1
    return 1
}

GsNewton :: (kind: s32, data: *GS, use_df: s32, x0_in: float64) -> s32 {
    iterations: s32 = 0
    x0: float64 = x0_in
    precision: float64 = data.precision / 2
    last_df0: float64 = 1
    step_factor: float64 = 1e-6
    x1: float64 = 0
    y0: float64 = 0
    y1: float64 = 0
    df0: float64 = 0
    stepsize: float64 = 0
    xstep: float64 = 0
    status: s32 = 0
    flat: s32 = 0
    if data.have_root != 0 {
        return 1
    }
    while iterations < 100 {
        if x0 < data.xmin || x0 > data.xmax {
            return 0
        }
        status = GsEvalF(kind, x0, *y0)
        if status != 1 {
            return 0
        }
        if GsUpdateData(x0, y0, data) != 0 {
            return 1
        }
        if use_df != 0 {
            status = GsEvalDf(kind, x0, *df0)
        } else {
            if Fabs(x0) < 1e-10 {
                if data.havexneg != 0 && data.havexpos != 0 {
                    xstep = Fabs(data.xpos - data.xneg) / 1000000
                } else {
                    xstep = (data.xmax - data.xmin) / 1000000
                }
            } else {
                xstep = step_factor * Fabs(x0)
            }
            status = GsFakeDf(kind, x0, *df0, xstep, data)
        }
        if status != 1 {
            return 0
        }
        flat = 0
        if df0 == 0 {
            flat = 1
        }
        if flat != 0 {
            last_df0 /= 2
            if Fabs(last_df0) <= 2.2250738585072014e-308 {
                return 0
            }
            df0 = last_df0
        } else {
            last_df0 = df0
        }
        if data.havexpos != 0 && data.havexneg != 0 {
            x1 = x0 - y0 / df0
        } else {
            x1 = x0 - (1.000001 * y0) / df0
        }
        stepsize = Fabs(x1 - x0) / (Fabs(x0) + Fabs(x1))
        if stepsize < precision {
            GsNewtonPolish(kind, data, use_df, x0, y0)
            return 1
        }
        if flat != 0 && iterations > 0 {
            if x1 < data.xmin || x1 > data.xmax {
                return 0
            }
            status = GsEvalF(kind, x1, *y1)
            if status != 1 {
                return 0
            }
            if Fabs(y1) >= (0.9 * Fabs(y0)) {
                return 0
            }
        }
        if stepsize < step_factor {
            step_factor = stepsize
        }
        x0 = x1
        iterations += 1
    }
    return 0
}

RateGo :: (nper: s32, pmt: float64, pv: float64, fv: float64, ptype: s32, rate0: float64, ok: *s32) -> float64 {
    data: GS
    status: s32 = 0
    factor: s32 = 0
    px: float64 = 0
    GS_R_NPER = cast(float64)nper
    GS_R_PMT = pmt
    GS_R_PV = pv
    GS_R_FV = fv
    GS_R_TYPE = ptype
    GsInit(*data)
    px = Pow(1.7976931348623157e308 / 1e10, 1.0 / cast(float64)nper)
    if (-px + 1) > data.xmin {
        data.xmin = -px + 1
    }
    if (px - 1) < data.xmax {
        data.xmax = px - 1
    }
    status = GsNewton(0, *data, 1, rate0)
    if status != 1 {
        factor = 2
        while (data.havexneg == 0 || data.havexpos == 0) && factor < 100 {
            GsPoint(0, *data, rate0 * cast(float64)factor)
            GsPoint(0, *data, rate0 / cast(float64)factor)
            factor *= 2
        }
        status = GsBisection(0, *data)
    }
    if status != 1 {
        ok[0] = 0
        return 0
    }
    ok[0] = 1
    return data.root
}

IrrGo :: (rate0: float64, ok: *s32) -> float64 {
    data: GS
    status: s32 = 0
    i: s32 = 0
    s: float64 = 0
    xmax_v: float64 = 0
    GsInit(*data)
    data.xmin = -1
    xmax_v = Pow(1.7976931348623157e308 / 1e10, 1.0 / cast(float64)GS_CASH_N)
    if (xmax_v - 1) < data.xmax {
        data.xmax = xmax_v - 1
    }
    status = GsNewton(1, *data, 1, rate0)
    if status != 1 {
        i = 0
        s = 2
        while (data.havexneg == 0 || data.havexpos == 0) && i < 10 {
            GsPoint(1, *data, rate0 * s)
            GsPoint(1, *data, rate0 / s)
            i += 1
            s *= 2
        }
        if data.havexneg == 0 || data.havexpos == 0 {
            status = GsNewton(1, *data, 1, -0.99)
        }
        if data.havexneg == 0 || data.havexpos == 0 {
            GsPoint(1, *data, 1 - 2.2204460492503131e-16)
        }
        status = GsBisection(1, *data)
    }
    if status != 1 {
        ok[0] = 0
        return 0
    }
    ok[0] = 1
    return data.root
}

XirrGo :: (rate0: float64, ok: *s32) -> float64 {
    data: GS
    status: s32 = 0
    i: s32 = 0
    GsInit(*data)
    data.xmin = -1
    if 1000 < data.xmax {
        data.xmax = 1000
    }
    status = GsNewton(2, *data, 0, rate0)
    if status != 1 {
        GsPoint(2, *data, -1)
        i = 1
        while i <= 1024 {
            GsPoint(2, *data, -1 + 10.0 / cast(float64)(i + 9))
            GsPoint(2, *data, cast(float64)i)
            status = GsBisection(2, *data)
            if status == 1 {
                break
            }
            i += i
        }
    }
    if status != 1 {
        ok[0] = 0
        return 0
    }
    ok[0] = 1
    return data.root
}

YieldGo :: (settle: s32, mature: s32, rate: float64, par: float64, red: float64, freq: s32, basis: s32, ok: *s32) -> float64 {
    data: GS
    status: s32 = 0
    yield0: float64 = 0
    n: s32 = 0
    GS_Y_SETTLE = settle
    GS_Y_MAT = mature
    GS_Y_RATE = rate
    GS_Y_PAR = par
    GS_Y_RED = red
    GS_Y_FREQ = freq
    GS_Y_BASIS = basis
    n = CouponCount(settle, mature, freq)
    if n <= 1 {
        a: float64 = CoupDaysBs(settle, mature, freq, basis)
        d: float64 = CoupDaysNc(settle, mature, freq, basis)
        e: float64 = CoupDaysGo(settle, mature, freq, basis)
        coeff: float64 = (cast(float64)freq * e) / d
        num: float64 = red / 100 + rate / cast(float64)freq - (par / 100 + ((a / e) * rate) / cast(float64)freq)
        den: float64 = par / 100 + ((a / e) * rate) / cast(float64)freq
        ok[0] = 1
        return (num / den) * coeff
    }
    GsInit(*data)
    if 0 > data.xmin {
        data.xmin = 0
    }
    if 1000 < data.xmax {
        data.xmax = 1000
    }
    yield0 = 0.1
    status = GsNewton(3, *data, 0, yield0)
    if status != 1 {
        yield0 = 1e-10
        while yield0 < data.xmax {
            GsPoint(3, *data, yield0)
            yield0 *= 2
        }
        status = GsBisection(3, *data)
    }
    if status != 1 {
        ok[0] = 0
        return 0
    }
    ok[0] = 1
    return data.root
}

FnRate :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    n: s32 = 0
    pmt: float64 = 0
    pv: float64 = 0
    fv: float64 = 0
    ptype: s32 = 0
    guess: float64 = 0
    ok: s32 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    n = ArgAtInt(args, count, 0, 0)
    pmt = ArgAt(args, count, 1, 0)
    pv = ArgAt(args, count, 2, 0)
    fv = ArgAt(args, count, 3, 0)
    ptype = ArgAtInt(args, count, 4, 0)
    guess = ArgAt(args, count, 5, 0.1)
    if n <= 0 {
        return ValError(ERR_NUM)
    }
    r: float64 = RateGo(n, pmt, pv, fv, ptype, guess, *ok)
    if ok == 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber(r)
}

FnIrr :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    values: [512]float64
    gs: s32 = 0
    gl: s32 = 0
    n: s32 = 0
    guess: float64 = 0.1
    ok: s32 = 0
    i: s32 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    GroupBounds(marks, count, 0, *gs, *gl)
    n = CashList(*args[gs], gl, *values[0])
    if n < 1 {
        return ValError(ERR_VALUE)
    }
    if count >= 2 && args[count - 1].from_range == 0 {
        guess = CoerceNumber(*args[count - 1])
    }
    GS_CASH_N = n
    while i < n {
        GSV_A[i] = values[i]
        i += 1
    }
    r: float64 = IrrGo(guess, *ok)
    if ok == 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber(r)
}

FnMirr :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    values: [512]float64
    gs: s32 = 0
    gl: s32 = 0
    n: s32 = 0
    fr: float64 = 0
    rr: float64 = 0
    npv_neg: float64 = 0
    npv_pos: float64 = 0
    i: s32 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    GroupBounds(marks, count, 0, *gs, *gl)
    n = CashList(*args[gs], gl, *values[0])
    if n < 2 {
        return ValError(ERR_VALUE)
    }
    fr = ArgAt(args, count, count - 2, 0)
    rr = ArgAt(args, count, count - 1, 0)
    while i < n {
        if values[i] >= 0 {
            npv_pos += values[i] / Pow1p(rr, cast(float64)i)
        } else {
            npv_neg += values[i] / Pow1p(fr, cast(float64)i)
        }
        i += 1
    }
    if npv_neg == 0 || npv_pos == 0 || rr <= -1 {
        return ValError(ERR_DIV0)
    }
    res: float64 = Pow((-npv_pos * Pow1p(rr, cast(float64)n)) / (npv_neg * (1 + rr)), 1.0 / cast(float64)(n - 1)) - 1
    return ValNumber(res)
}

FnYield :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    settle: s32 = 0
    mature: s32 = 0
    rate: float64 = 0
    price: float64 = 0
    red: float64 = 0
    freq: s32 = 0
    basis: s32 = 0
    if count < 5 {
        return ValError(ERR_VALUE)
    }
    settle = ArgDate(args, count, 0, -1)
    mature = ArgDate(args, count, 1, -1)
    rate = ArgAt(args, count, 2, 0)
    price = ArgAt(args, count, 3, 0)
    red = ArgAt(args, count, 4, 100)
    freq = ArgAtInt(args, count, 5, 1)
    basis = ArgBasis(args, count, 6)
    if settle < 0 || mature < 0 || basis < 0 || freq < 1 {
        return ValError(ERR_NUM)
    }
    if settle > mature {
        return ValError(ERR_NUM)
    }
    if rate < 0 || price < 0 || red <= 0 {
        return ValError(ERR_NUM)
    }
    ok: s32 = 0
    y: float64 = YieldGo(settle, mature, rate, price, red, freq, basis, *ok)
    if ok == 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber(y)
}

DurationGo :: (settle: s32, mature: s32, rate: float64, yld: float64, freq: s32, basis: s32) -> float64 {
    numcoups: float64 = cast(float64)CouponCount(settle, mature, freq)
    fDur: float64 = 0
    p: float64 = 0
    t: float64 = 0
    fcoup: float64 = (rate * 100) / cast(float64)freq
    fyld: float64 = yld / cast(float64)freq
    fyld += 1
    t = 1
    while t < numcoups {
        fDur += (t * fcoup) / Pow(fyld, t)
        t += 1
    }
    fDur += (numcoups * (fcoup + 100)) / Pow(fyld, numcoups)
    t = 1
    while t < numcoups {
        p += fcoup / Pow(fyld, t)
        t += 1
    }
    p += (fcoup + 100) / Pow(fyld, numcoups)
    fDur /= p
    fDur /= cast(float64)freq
    return fDur
}

FnDuration :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    settle: s32 = 0
    mature: s32 = 0
    rate: float64 = 0
    yld: float64 = 0
    freq: s32 = 0
    basis: s32 = 0
    if count < 4 {
        return ValError(ERR_VALUE)
    }
    settle = ArgDate(args, count, 0, -1)
    mature = ArgDate(args, count, 1, -1)
    rate = ArgAt(args, count, 2, 0)
    yld = ArgAt(args, count, 3, 0)
    freq = ArgAtInt(args, count, 4, 1)
    basis = ArgBasis(args, count, 5)
    if settle < 0 || mature < 0 || basis < 0 || freq < 1 {
        return ValError(ERR_NUM)
    }
    if settle >= mature {
        return ValError(ERR_NUM)
    }
    return ValNumber(DurationGo(settle, mature, rate, yld, freq, basis))
}

FnMduration :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    settle: s32 = 0
    mature: s32 = 0
    rate: float64 = 0
    yld: float64 = 0
    freq: s32 = 0
    basis: s32 = 0
    if count < 4 {
        return ValError(ERR_VALUE)
    }
    settle = ArgDate(args, count, 0, -1)
    mature = ArgDate(args, count, 1, -1)
    rate = ArgAt(args, count, 2, 0)
    yld = ArgAt(args, count, 3, 0)
    freq = ArgAtInt(args, count, 4, 1)
    basis = ArgBasis(args, count, 5)
    if settle < 0 || mature < 0 || basis < 0 || freq < 1 {
        return ValError(ERR_NUM)
    }
    if settle >= mature {
        return ValError(ERR_NUM)
    }
    d: float64 = DurationGo(settle, mature, rate, yld, freq, basis)
    d /= 1 + yld / cast(float64)freq
    return ValNumber(d)
}

Price_Mat_Impl :: (settle: s32, mature: s32, issue: s32, rate: float64, yld: float64, basis: s32) -> float64 {
    dsm: float64 = cast(float64)DaysMonthlyBasis(settle, mature, basis)
    dim: float64 = cast(float64)DaysMonthlyBasis(issue, mature, basis)
    a: float64 = cast(float64)DaysMonthlyBasis(issue, settle, basis)
    b: float64 = cast(float64)AnnualBasis(settle, basis)
    n: float64 = 1 + (dsm / b) * yld
    return (100 + (dim / b) * rate * 100) / n - (a / b) * rate * 100
}

FnPricemat :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    settle: s32 = 0
    mature: s32 = 0
    issue: s32 = 0
    rate: float64 = 0
    yld: float64 = 0
    basis: s32 = 0
    if count < 5 {
        return ValError(ERR_VALUE)
    }
    settle = ArgDate(args, count, 0, -1)
    mature = ArgDate(args, count, 1, -1)
    issue = ArgDate(args, count, 2, -1)
    rate = ArgAt(args, count, 3, 0)
    yld = ArgAt(args, count, 4, 0)
    basis = ArgBasis(args, count, 5)
    if settle < 0 || mature < 0 || issue < 0 || basis < 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber(Price_Mat_Impl(settle, mature, issue, rate, yld, basis))
}

YieldMatAt :: (settle: s32, mature: s32, issue: s32, rate: float64, price: float64, basis: s32) -> float64 {
    issmat: float64 = YearFracBasis(issue, mature, basis)
    issset: float64 = YearFracBasis(issue, settle, basis)
    setmat: float64 = YearFracBasis(settle, mature, basis)
    y: float64 = 1 + issmat * rate
    y /= price / 100 + issset * rate
    y -= 1
    y /= setmat
    return y
}

FnYieldmat :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    settle: s32 = 0
    mature: s32 = 0
    issue: s32 = 0
    rate: float64 = 0
    price: float64 = 0
    basis: s32 = 0
    if count < 5 {
        return ValError(ERR_VALUE)
    }
    settle = ArgDate(args, count, 0, -1)
    mature = ArgDate(args, count, 1, -1)
    issue = ArgDate(args, count, 2, -1)
    rate = ArgAt(args, count, 3, 0)
    price = ArgAt(args, count, 4, 0)
    basis = ArgBasis(args, count, 5)
    if settle < 0 || mature < 0 || issue < 0 || basis < 0 || price <= 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber(YieldMatAt(settle, mature, issue, rate, price, basis))
}

FnYielddisc :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    settle: s32 = 0
    mature: s32 = 0
    price: float64 = 0
    red: float64 = 0
    basis: s32 = 0
    if count < 4 {
        return ValError(ERR_VALUE)
    }
    settle = ArgDate(args, count, 0, -1)
    mature = ArgDate(args, count, 1, -1)
    price = ArgAt(args, count, 2, 0)
    red = ArgAt(args, count, 3, 0)
    basis = ArgBasis(args, count, 4)
    if settle < 0 || mature < 0 || basis < 0 || price <= 0 {
        return ValError(ERR_NUM)
    }
    yf: float64 = YearFracBasis(settle, mature, basis)
    if yf == 0 || price == 0 {
        return ValError(ERR_DIV0)
    }
    return ValNumber((red / price - 1) / yf)
}

OddPriceStub :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return ValError(ERR_VALUE)
}

FnAmorlinc :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    c: float64 = 0
    settle: s32 = 0
    first: s32 = 0
    salvage: float64 = 0
    per: s32 = 0
    rate: float64 = 0
    basis: s32 = 0
    if count < 6 {
        return ValError(ERR_VALUE)
    }
    c = ArgAt(args, count, 0, 0)
    settle = ArgDate(args, count, 1, -1)
    first = ArgDate(args, count, 2, -1)
    salvage = ArgAt(args, count, 3, 0)
    per = ArgAtInt(args, count, 4, 0)
    rate = ArgAt(args, count, 5, 0)
    basis = ArgBasis(args, count, 6)
    if settle < 0 || first < 0 || basis < 0 || rate < 0 {
        return ValError(ERR_NUM)
    }
    one_rate: float64 = c * rate
    cost_delta: float64 = c - salvage
    f0rate: float64 = YearFracBasis(settle, first, basis) * rate * c
    full_periods: s32 = TruncateToS32((cost_delta - f0rate) / one_rate)
    result: float64 = 0
    if per == 0 {
        result = f0rate
    } else if per <= full_periods {
        result = one_rate
    } else if per == (full_periods + 1) {
        result = cost_delta - one_rate * cast(float64)full_periods - f0rate
    } else {
        result = 0
    }
    return ValNumber(result)
}

FnAmordegrc :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    c: float64 = 0
    settle: s32 = 0
    first: s32 = 0
    salvage: float64 = 0
    per: s32 = 0
    rate: float64 = 0
    basis: s32 = 0
    if count < 6 {
        return ValError(ERR_VALUE)
    }
    c = ArgAt(args, count, 0, 0)
    settle = ArgDate(args, count, 1, -1)
    first = ArgDate(args, count, 2, -1)
    salvage = ArgAt(args, count, 3, 0)
    per = ArgAtInt(args, count, 4, 0)
    rate = ArgAt(args, count, 5, 0)
    basis = ArgBasis(args, count, 6)
    if settle < 0 || first < 0 || basis < 0 || rate < 0 {
        return ValError(ERR_NUM)
    }
    use_per: float64 = 1 / rate
    coeff: float64 = 0
    if use_per < 3 {
        coeff = 1
    } else if use_per < 5 {
        coeff = 1.5
    } else if use_per <= 6 {
        coeff = 2
    } else {
        coeff = 2.5
    }
    frate: float64 = rate * coeff
    cost: float64 = c
    nrate: float64 = Rint(YearFracBasis(settle, first, basis) * frate * cost)
    cost -= nrate
    rest: float64 = cost - salvage
    n: s32 = 0
    while n < per {
        nrate = Rint(frate * cost)
        rest -= nrate
        if rest < 0 {
            if (per - n) <= 1 {
                return ValNumber(Rint(cost / 2))
            }
            return ValNumber(0)
        }
        cost -= nrate
        n += 1
    }
    return ValNumber(nrate)
}

EuroRate :: (code: *s8) -> float64 {
    if TextCompareLiteral(code, "ATS") == 0 {
        return 13.7603
    }
    if TextCompareLiteral(code, "BEF") == 0 {
        return 40.3399
    }
    if TextCompareLiteral(code, "DEM") == 0 {
        return 1.95583
    }
    if TextCompareLiteral(code, "ESP") == 0 {
        return 166.386
    }
    if TextCompareLiteral(code, "FIM") == 0 {
        return 5.94573
    }
    if TextCompareLiteral(code, "FRF") == 0 {
        return 6.55957
    }
    if TextCompareLiteral(code, "IEP") == 0 {
        return 0.787564
    }
    if TextCompareLiteral(code, "ITL") == 0 {
        return 1936.27
    }
    if TextCompareLiteral(code, "LUF") == 0 {
        return 40.3399
    }
    if TextCompareLiteral(code, "NLG") == 0 {
        return 2.20371
    }
    if TextCompareLiteral(code, "PTE") == 0 {
        return 200.482
    }
    if TextCompareLiteral(code, "EUR") == 0 {
        return 1.0
    }
    return -1
}

FnEuroconvert :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    value: float64 = 0
    from: [16]s8
    to: [16]s8
    full: s32 = 0
    triang: s32 = 0
    from_rate: float64 = 0
    to_rate: float64 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    value = ArgAt(args, count, 0, 0)
    if TextArg(args, count, 1, *from[0], 16) < 0 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 2, *to[0], 16) < 0 {
        return ValError(ERR_VALUE)
    }
    full = ArgAtInt(args, count, 3, 0)
    triang = ArgAtInt(args, count, 4, 1)
    from_rate = EuroRate(*from[0])
    to_rate = EuroRate(*to[0])
    if from_rate < 0 || to_rate < 0 {
        return ValError(ERR_VALUE)
    }
    in_eur: float64 = value / from_rate
    out: float64 = in_eur * to_rate
    return ValNumber(out)
}

FnEuro :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return ValError(ERR_NA)
}

FnXnpv :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = 0
    rate: float64 = 0
    v_start: s32 = 0
    v_len: s32 = 0
    d_start: s32 = 0
    d_len: s32 = 0
    total: float64 = 0
    i: s32 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    groups = ArgGroupCount(args, marks, count)
    rate = ArgAt(args, count, 0, 0)
    if groups < 2 {
        return ValError(ERR_VALUE)
    }
    GroupBounds(marks, count, 1, *v_start, *v_len)
    GroupBounds(marks, count, 2, *d_start, *d_len)
    if v_len != d_len {
        return ValError(ERR_NUM)
    }
    d0: float64 = CoerceNumber(*args[d_start])
    i = 0
    while i < v_len {
        if args[v_start + i].kind != VAL_FLOAT {
            return ValError(ERR_VALUE)
        }
        di: float64 = CoerceNumber(*args[d_start + i])
        total += args[v_start + i].number / Pow1p(rate, (di - d0) / 365)
        i += 1
    }
    return ValNumber(total)
}

FnXirr :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    groups: s32 = 0
    v_start: s32 = 0
    v_len: s32 = 0
    d_start: s32 = 0
    d_len: s32 = 0
    guess: float64 = 0.1
    ok: s32 = 0
    i: s32 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    groups = ArgGroupCount(args, marks, count)
    if groups < 2 {
        return ValError(ERR_VALUE)
    }
    GroupBounds(marks, count, 0, *v_start, *v_len)
    GroupBounds(marks, count, 1, *d_start, *d_len)
    if v_len != d_len {
        return ValError(ERR_NUM)
    }
    if v_len > 512 {
        return ValError(ERR_NUM)
    }
    if args[count - 1].from_range == 0 {
        guess = CoerceNumber(*args[count - 1])
    }
    GS_CASH_N = v_len
    while i < v_len {
        GSV_A[i] = args[v_start + i].number
        GSD_A[i] = CoerceNumber(*args[d_start + i])
        i += 1
    }
    r: float64 = XirrGo(guess, *ok)
    if ok == 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber(r)
}

FnDollarText :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    v: float64 = 0
    decimals: float64 = 2
    out: [128]s8
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    v = ArgAt(args, count, 0, 0)
    decimals = ArgAt(args, count, 1, 2)
    scaleleft: float64 = 1
    if decimals < 0 {
        scaleleft = FinPower(10.0, -decimals)
        v = cast(float64)TruncateToS64(v / scaleleft + (ifx v < 0 then (-0.5) else 0.5)) * scaleleft
        decimals = 0
    }
    if decimals > 10 {
        decimals = 10
    }
    tmp: [64]s8
    body: [96]s8
    FormatText(*tmp[0], 64, CText("%.*f"), TruncateToS32(decimals), Fabs(v))
    FormatWithPattern2(*tmp[0], *body[0], 96)
    if v < 0 {
        FormatText(*out[0], 128, CText("(%s)"), *body[0])
    } else {
        FormatText(*out[0], 128, CText("%s"), *body[0])
    }
    return ValString(wb_strdup(*out[0]))
}

FormatWithPattern2 :: (digits: *s8, out: *s8, cap: s32) {
    dot: *s8 = TextFindByte(digits, 46)
    int_len: s32 = ifx dot != null then (cast(s32)(cast(s64)(cast(u64)dot - cast(u64)digits))) else (cast(s32)TextLength(digits))
    n: s32 = 0
    i: s32 = 0
    out[0] = 36
    n = 1
    while i < int_len {
        if ((int_len - i) % 3) == 0 && i > 0 && (n + 1) < cap {
            out[n] = 44
            n += 1
        }
        if (n + 1) < cap {
            out[n] = digits[i]
            n += 1
        }
        i += 1
    }
    if dot != null {
        i = 0
        while dot[i] != 0 && (n + 1) < cap {
            out[n] = dot[i]
            n += 1
            i += 1
        }
    }
    out[n] = 0
}

FnSum :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    list: NumList
    CollectNumbers(args, count, *list)
    if list.saw_error != 0 {
        return FirstError(args, count)
    }
    total: float64 = 0
    i: s32 = 0
    while i < list.count {
        total += list.data[i]
        i += 1
    }
    return ValNumber(total)
}

FnAverage :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    list: NumList
    CollectNumbers(args, count, *list)
    if list.saw_error != 0 {
        return FirstError(args, count)
    }
    if list.count == 0 {
        return ValError(ERR_DIV0)
    }
    total: float64 = 0
    i: s32 = 0
    while i < list.count {
        total += list.data[i]
        i += 1
    }
    return ValNumber(total / cast(float64)list.count)
}

FnCount :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    list: NumList
    CollectNumbers(args, count, *list)
    return ValNumber(cast(float64)list.count)
}

FnCounta :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    n: s32 = 0
    i: s32 = 0
    while i < count {
        if args[i].kind != VAL_EMPTY {
            n += 1
        }
        i += 1
    }
    return ValNumber(cast(float64)n)
}

FnCountblank :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    n: s32 = 0
    i: s32 = 0
    while i < count {
        if args[i].kind == VAL_EMPTY {
            n += 1
        } else if args[i].kind == VAL_STRING && args[i].text != null && args[i].text[0] == 0 {
            n += 1
        }
        i += 1
    }
    return ValNumber(cast(float64)n)
}

FnMinMax :: (st: *EvalState, args: *Val, count: s32, marks: *s32, want_max: s32) -> Val {
    list: NumList
    CollectNumbers(args, count, *list)
    if list.saw_error != 0 {
        return FirstError(args, count)
    }
    if list.count == 0 {
        return ValNumber(0)
    }
    best: float64 = list.data[0]
    i: s32 = 1
    while i < list.count {
        if want_max != 0 {
            if list.data[i] > best {
                best = list.data[i]
            }
        } else {
            if list.data[i] < best {
                best = list.data[i]
            }
        }
        i += 1
    }
    return ValNumber(best)
}

FnProduct :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    list: NumList
    CollectNumbers(args, count, *list)
    if list.saw_error != 0 {
        return FirstError(args, count)
    }
    total: float64 = 1
    i: s32 = 0
    while i < list.count {
        total *= list.data[i]
        i += 1
    }
    return ValNumber(total)
}

FnSumSq :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    list: NumList
    CollectNumbers(args, count, *list)
    if list.saw_error != 0 {
        return FirstError(args, count)
    }
    total: float64 = 0
    i: s32 = 0
    while i < list.count {
        total += list.data[i] * list.data[i]
        i += 1
    }
    return ValNumber(total)
}

SortDoubles :: (data: *float64, n: s32) {
    i: s32 = 1
    while i < n {
        x: float64 = data[i]
        j: s32 = i - 1
        while j >= 0 && data[j] > x {
            data[j + 1] = data[j]
            j -= 1
        }
        data[j + 1] = x
        i += 1
    }
}

FnMedian :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    list: NumList
    CollectNumbers(args, count, *list)
    if list.saw_error != 0 {
        return FirstError(args, count)
    }
    if list.count == 0 {
        return ValError(ERR_NUM)
    }
    SortDoubles(*list.data[0], list.count)
    mid: s32 = list.count / 2
    if (list.count % 2) != 0 {
        return ValNumber(list.data[mid])
    }
    return ValNumber((list.data[mid - 1] + list.data[mid]) / 2.0)
}

FnVarOld :: (st: *EvalState, args: *Val, count: s32, marks: *s32, sample: s32) -> Val {
    list: NumList
    CollectNumbers(args, count, *list)
    if list.saw_error != 0 {
        return FirstError(args, count)
    }
    if (sample != 0 && list.count < 2) || (!(sample != 0) && list.count < 1) {
        return ValError(ERR_DIV0)
    }
    total: float64 = 0
    i: s32 = 0
    while i < list.count {
        total += list.data[i]
        i += 1
    }
    mean: float64 = total / cast(float64)list.count
    sq: float64 = 0
    i = 0
    while i < list.count {
        d: float64 = list.data[i] - mean
        sq += d * d
        i += 1
    }
    div: float64 = cast(float64)(ifx sample != 0 then (list.count - 1) else list.count)
    return ValNumber(sq / div)
}

FnStdev :: (st: *EvalState, args: *Val, count: s32, marks: *s32, sample: s32) -> Val {
    v: Val = FnVarOld(st, args, count, marks, sample)
    if v.kind == VAL_ERROR {
        return v
    }
    return ValNumber(Sqrt(v.number))
}

FnLargeSmall :: (st: *EvalState, args: *Val, count: s32, marks: *s32, large: s32) -> Val {
    list: NumList
    k: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[count - 1].kind == VAL_ERROR {
        return ValError(args[count - 1].err)
    }
    CollectNumbers(args, count - 1, *list)
    k = ArgNumberAt(args, count, count - 1)
    if k < 1 || k != cast(float64)TruncateToS64(k) || TruncateToS32(k) > list.count {
        return ValError(ERR_NUM)
    }
    SortDoubles(*list.data[0], list.count)
    idx: s32 = ifx large != 0 then (list.count - TruncateToS32(k)) else (TruncateToS32(k) - 1)
    return ValNumber(list.data[idx])
}

FnIf :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    cond: s32 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    cond = CoerceBool(*args[0])
    if cond < 0 {
        return ValError(ERR_VALUE)
    }
    if cond != 0 {
        return ValCopy(*args[1])
    }
    if count >= 3 {
        return ValCopy(*args[2])
    }
    return ValBool(0)
}

FnIfError :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValCopy(*args[1])
    }
    return ValCopy(*args[0])
}

FnIfNa :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR && args[0].err == ERR_NA {
        return ValCopy(*args[1])
    }
    return ValCopy(*args[0])
}

FnNot :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    flag: s32 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    flag = CoerceBool(*args[0])
    if flag < 0 {
        return ValError(ERR_VALUE)
    }
    return ValBool(cast(s32)(flag == 0))
}

FnAndOr :: (st: *EvalState, args: *Val, count: s32, marks: *s32, is_and: s32) -> Val {
    seen: s32 = 0
    result: s32 = is_and
    i: s32 = 0
    while i < count {
        v: *Val = *args[i]
        if v.kind == VAL_ERROR {
            return ValError(v.err)
        }
        if v.kind == VAL_FLOAT || v.kind == VAL_BOOL {
            seen = 1
            flag: s32 = cast(s32)(v.number != 0)
            if is_and != 0 {
                result = cast(s32)(result != 0 && flag != 0)
            } else {
                result = cast(s32)(result != 0 || flag != 0)
            }
        }
        i += 1
    }
    if seen == 0 {
        return ValError(ERR_VALUE)
    }
    return ValBool(result)
}

FnXor :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    parity: s32 = 0
    i: s32 = 0
    while i < count {
        if args[i].kind == VAL_ERROR {
            return ValError(args[i].err)
        }
        if args[i].kind == VAL_FLOAT || args[i].kind == VAL_BOOL {
            if args[i].number != 0 {
                parity += 1
            }
        }
        i += 1
    }
    return ValBool(cast(s32)((parity % 2) != 0))
}

FnIsError :: (st: *EvalState, args: *Val, count: s32, marks: *s32, include_na: s32) -> Val {
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        if !(include_na != 0) && args[0].err == ERR_NA {
            return ValBool(0)
        }
        return ValBool(1)
    }
    return ValBool(0)
}

FnIsType :: (st: *EvalState, args: *Val, count: s32, marks: *s32, kind: s32) -> Val {
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    return ValBool(cast(s32)(args[0].kind == kind))
}

FnN :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_FLOAT || args[0].kind == VAL_BOOL {
        return ValNumber(args[0].number)
    }
    return ValNumber(0)
}

TextArg :: (args: *Val, count: s32, index: s32, out: *s8, cap: s32) -> s32 {
    if index >= count {
        return 0
    }
    if args[index].kind == VAL_ERROR {
        return -1
    }
    CoerceText(*args[index], out, cap)
    return 1
}

FnLen :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    text: [1024]s8
    if TextArg(args, count, 0, *text[0], 1024) < 0 {
        return ValError(ERR_VALUE)
    }
    return ValNumber(cast(float64)TextLength(*text[0]))
}

FnUpper :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    text: [1024]s8
    i: s32 = 0
    if TextArg(args, count, 0, *text[0], 1024) < 0 {
        return ValError(ERR_VALUE)
    }
    i = 0
    while text[i] != 0 {
        text[i] = cast(s8)UpperByte(cast(s32)(cast(u8)text[i]))
        i += 1
    }
    return ValString(wb_strdup(*text[0]))
}

FnLower :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    text: [1024]s8
    i: s32 = 0
    if TextArg(args, count, 0, *text[0], 1024) < 0 {
        return ValError(ERR_VALUE)
    }
    i = 0
    while text[i] != 0 {
        text[i] = cast(s8)LowerByte(cast(s32)(cast(u8)text[i]))
        i += 1
    }
    return ValString(wb_strdup(*text[0]))
}

FnTrim :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    src: [1024]s8
    out: [1024]s8
    n: s32 = 0
    pending_space: s32 = 0
    i: s32 = 0
    if TextArg(args, count, 0, *src[0], 1024) < 0 {
        return ValError(ERR_VALUE)
    }
    i = 0
    while src[i] != 0 {
        if src[i] == 32 {
            if n > 0 {
                pending_space = 1
            }
        } else {
            if pending_space != 0 && n > 0 {
                if n < (1024 - 1) {
                    out[n] = 32
                    n += 1
                }
                pending_space = 0
            }
            if n < (1024 - 1) {
                out[n] = src[i]
                n += 1
            }
        }
        i += 1
    }
    out[n] = 0
    return ValString(wb_strdup(*out[0]))
}

FnLeftRight :: (st: *EvalState, args: *Val, count: s32, marks: *s32, left: s32) -> Val {
    text: [1024]s8
    n: float64 = 1
    len: s32 = 0
    take: s32 = 0
    if TextArg(args, count, 0, *text[0], 1024) < 0 {
        return ValError(ERR_VALUE)
    }
    if count >= 2 {
        if args[1].kind == VAL_ERROR {
            return ValError(args[1].err)
        }
        n = CoerceNumber(*args[1])
    }
    if n < 0 {
        return ValError(ERR_VALUE)
    }
    len = cast(s32)TextLength(*text[0])
    take = TruncateToS32(n)
    if take > len {
        take = len
    }
    if left != 0 {
        return ValString(wb_strndup(*text[0], take))
    }
    return ValString(wb_strndup(*text[len - take], take))
}

FnMid :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    text: [1024]s8
    start: float64 = 0
    n: float64 = 0
    len: s32 = 0
    take: s32 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 0, *text[0], 1024) < 0 {
        return ValError(ERR_VALUE)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    if args[2].kind == VAL_ERROR {
        return ValError(args[2].err)
    }
    start = CoerceNumber(*args[1])
    n = CoerceNumber(*args[2])
    if start < 1 || n < 0 {
        return ValError(ERR_VALUE)
    }
    len = cast(s32)TextLength(*text[0])
    if (start - 1) >= cast(float64)len {
        return ValString(wb_strdup(CText("")))
    }
    take = TruncateToS32(n)
    if (start - 1 + cast(float64)take) > cast(float64)len {
        take = len - TruncateToS32(start) + 1
    }
    return ValString(wb_strndup(*text[TruncateToS32(start) - 1], take))
}

FnRepeatText :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    text: [512]s8
    out: [1024]s8
    n: float64 = 0
    i: s32 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 0, *text[0], 512) < 0 {
        return ValError(ERR_VALUE)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    n = CoerceNumber(*args[1])
    if n < 0 {
        return ValError(ERR_VALUE)
    }
    if (TruncateToS32(n) * cast(s32)TextLength(*text[0])) >= 1024 {
        return ValError(ERR_VALUE)
    }
    i = 0
    while i < TruncateToS32(n) {
        TextAppend(*out[0], *text[0])
        i += 1
    }
    return ValString(wb_strdup(*out[0]))
}

FnConcatenate :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    out: [2048]s8
    piece: [1024]s8
    i: s32 = 0
    while i < count {
        if args[i].kind == VAL_ERROR {
            return ValError(args[i].err)
        }
        CoerceText(*args[i], *piece[0], 1024)
        if (TextLength(*out[0]) + TextLength(*piece[0])) >= 2048 {
            return ValError(ERR_VALUE)
        }
        TextAppend(*out[0], *piece[0])
        i += 1
    }
    return ValString(wb_strdup(*out[0]))
}

FnFind :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    needle: [512]s8
    hay: [1024]s8
    start: float64 = 1
    hit: *s8 = null
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 0, *needle[0], 512) < 0 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 1, *hay[0], 1024) < 0 {
        return ValError(ERR_VALUE)
    }
    if count >= 3 {
        if args[2].kind == VAL_ERROR {
            return ValError(args[2].err)
        }
        start = CoerceNumber(*args[2])
    }
    if start < 1 || (start - 1) > cast(float64)TextLength(*hay[0]) {
        return ValError(ERR_VALUE)
    }
    hit = TextFind(*hay[TruncateToS32(start) - 1], *needle[0])
    if hit == null {
        return ValError(ERR_VALUE)
    }
    return ValNumber(cast(float64)(cast(s64)(cast(u64)hit - cast(u64)(*hay[0])) + 1))
}

FnSearch :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    needle: [512]s8
    hay: [1024]s8
    start: float64 = 1
    i: s32 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 0, *needle[0], 512) < 0 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 1, *hay[0], 1024) < 0 {
        return ValError(ERR_VALUE)
    }
    if count >= 3 {
        if args[2].kind == VAL_ERROR {
            return ValError(args[2].err)
        }
        start = CoerceNumber(*args[2])
    }
    if start < 1 || (start - 1) > cast(float64)TextLength(*hay[0]) {
        return ValError(ERR_VALUE)
    }
    i = TruncateToS32(start) - 1
    while hay[i] != 0 {
        j: s32 = 0
        while needle[j] != 0 {
            if hay[i + j] == 0 {
                break
            }
            if LowerByte(cast(s32)(cast(u8)hay[i + j])) != LowerByte(cast(s32)(cast(u8)needle[j])) {
                break
            }
            j += 1
        }
        if needle[j] == 0 {
            return ValNumber(cast(float64)(i + 1))
        }
        i += 1
    }
    return ValError(ERR_VALUE)
}

FnSubstitute :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    text: [1024]s8
    old: [512]s8
    new: [512]s8
    out: [2048]s8
    n: s32 = 0
    i: s32 = 0
    which: s32 = -1
    replaced: s32 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 0, *text[0], 1024) < 0 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 1, *old[0], 512) < 0 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 2, *new[0], 512) < 0 {
        return ValError(ERR_VALUE)
    }
    if count >= 4 {
        if args[3].kind == VAL_ERROR {
            return ValError(args[3].err)
        }
        which = TruncateToS32(CoerceNumber(*args[3]))
        if which < 1 {
            return ValError(ERR_VALUE)
        }
    }
    if old[0] == 0 {
        return ValString(wb_strdup(*text[0]))
    }
    while text[i] != 0 {
        if TextCompareN(*text[i], *old[0], TextLength(*old[0])) == 0 {
            replaced += 1
            if which < 0 || replaced == which {
                j: s32 = 0
                while new[j] != 0 && n < (2048 - 1) {
                    out[n] = new[j]
                    n += 1
                    j += 1
                }
                i += cast(s32)TextLength(*old[0])
                continue
            }
        }
        if n < (2048 - 1) {
            out[n] = text[i]
            n += 1
        }
        i += 1
    }
    out[n] = 0
    return ValString(wb_strdup(*out[0]))
}

FnExact :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    a: [1024]s8
    b: [1024]s8
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 0, *a[0], 1024) < 0 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 1, *b[0], 1024) < 0 {
        return ValError(ERR_VALUE)
    }
    return ValBool(cast(s32)(TextCompare(*a[0], *b[0]) == 0))
}

FnChar :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    code: s32 = 0
    out: [8]s8
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    code = TruncateToS32(CoerceNumber(*args[0]))
    if code < 1 || code > 255 {
        return ValError(ERR_VALUE)
    }
    out[0] = cast(s8)code
    return ValString(wb_strdup(*out[0]))
}

FnCode :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    text: [1024]s8
    if TextArg(args, count, 0, *text[0], 1024) < 0 {
        return ValError(ERR_VALUE)
    }
    if text[0] == 0 {
        return ValError(ERR_VALUE)
    }
    return ValNumber(cast(float64)(cast(u8)text[0]))
}

FnValue :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    text: [1024]s8
    if TextArg(args, count, 0, *text[0], 1024) < 0 {
        return ValError(ERR_VALUE)
    }
    if !(TextLooksNumeric(*text[0]) != 0) {
        return ValError(ERR_VALUE)
    }
    return ValNumber(ParseDouble(*text[0], null))
}

FnT :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_STRING {
        return ValCopy(*args[0])
    }
    return ValString(wb_strdup(CText("")))
}

FormatThousands :: (digits: *s8, out: *s8, cap: s32) {
    dot: *s8 = TextFindByte(digits, 46)
    int_len: s32 = ifx dot != null then (cast(s32)(cast(s64)(cast(u64)dot - cast(u64)digits))) else (cast(s32)TextLength(digits))
    negative: s32 = cast(s32)(digits[0] == 45)
    start: s32 = ifx negative != 0 then 1 else 0
    n: s32 = 0
    i: s32 = start
    if negative != 0 && cap > 1 {
        out[0] = 45
        n = 1
    }
    while i < int_len {
        if ((int_len - i) % 3) == 0 && i > start && (n + 1) < cap {
            out[n] = 44
            n += 1
        }
        if (n + 1) < cap {
            out[n] = digits[i]
            n += 1
        }
        i += 1
    }
    if dot != null {
        i = 0
        while dot[i] != 0 && (n + 1) < cap {
            out[n] = dot[i]
            n += 1
            i += 1
        }
    }
    out[n] = 0
}

FormatWithPattern :: (value: float64, fmt: *s8, out: *s8, cap: s32) {
    percent: s32 = 0
    decimals: s32 = -1
    comma: s32 = 0
    i: s32 = 0
    while fmt[i] != 0 {
        if fmt[i] == 37 {
            percent = 1
        }
        if fmt[i] == 44 {
            comma = 1
        }
        if fmt[i] == 46 {
            decimals = 0
            j: s32 = i + 1
            while fmt[j] >= 48 && fmt[j] <= 57 {
                decimals += 1
                j += 1
            }
        }
        i += 1
    }
    v: float64 = ifx percent != 0 then (value * 100.0) else value
    if decimals < 0 {
        decimals = 0
    }
    tmp: [64]s8
    FormatText(*tmp[0], 64, CText("%.*f"), decimals, v)
    if comma != 0 {
        FormatThousands(*tmp[0], out, cap)
    } else {
        FormatText(out, cast(u64)cap, CText("%s"), *tmp[0])
    }
    if percent != 0 {
        len: s32 = cast(s32)TextLength(out)
        if (len + 1) < cap {
            out[len] = 37
            out[len + 1] = 0
        }
    }
}

FnText :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    fmt: [512]s8
    out: [1024]s8
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if TextArg(args, count, 1, *fmt[0], 512) < 0 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_STRING {
        return ValCopy(*args[0])
    }
    FormatWithPattern(CoerceNumber(*args[0]), *fmt[0], *out[0], 1024)
    return ValString(wb_strdup(*out[0]))
}

DaysFromCivil :: (y: s32, m: s32, d: s32) -> s32 {
    yy: s32 = ifx m <= 2 then (y - 1) else y
    era: s32 = 0
    yoe: s32 = 0
    mp: s32 = (m + 9) % 12
    doy: s32 = (153 * mp + 2) / 5 + d - 1
    doe: s32 = 0
    if yy >= 0 {
        era = yy / 400
    } else {
        era = (yy - 399) / 400
    }
    yoe = yy - era * 400
    doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

CivilFromDays :: (z_in: s32, y: *s32, m: *s32, d: *s32) {
    z: s32 = z_in + 719468
    era: s32 = 0
    doe: s32 = 0
    yoe: s32 = 0
    cy: s32 = 0
    doy: s32 = 0
    cm: s32 = 0
    if z >= 0 {
        era = z / 146097
    } else {
        era = (z - 146096) / 146097
    }
    doe = z - era * 146097
    yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    cy = yoe + era * 400
    doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    cm = (5 * doy + 2) / 153
    d[0] = doy - (153 * cm + 2) / 5 + 1
    m[0] = cm + 3
    if m[0] > 12 {
        m[0] -= 12
    }
    y[0] = cy + (ifx m[0] <= 2 then 1 else 0)
}

SerialEpoch :: () -> s32 {
    return DaysFromCivil(1899, 12, 30)
}

FnDate :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    y: s32 = 0
    m: s32 = 0
    d: s32 = 0
    i: s32 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    while i < 3 {
        if args[i].kind == VAL_ERROR {
            return ValError(args[i].err)
        }
        i += 1
    }
    y = TruncateToS32(CoerceNumber(*args[0]))
    m = TruncateToS32(CoerceNumber(*args[1]))
    d = TruncateToS32(CoerceNumber(*args[2]))
    if y >= 0 && y < 100 {
        y += 1900
    }
    if m < 1 || m > 12 || d < 1 || d > 31 {
        return ValError(ERR_NUM)
    }
    serial: s32 = DaysFromCivil(y, m, d) - SerialEpoch()
    if serial < 61 {
        serial -= 1
    }
    return ValNumber(cast(float64)serial)
}

DatePart :: (args: *Val, count: s32, part: s32) -> Val {
    serial: s32 = 0
    days: s32 = 0
    y: s32 = 0
    m: s32 = 0
    d: s32 = 0
    dow: s32 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    serial = TruncateToS32(CoerceNumber(*args[0]))
    days = serial + SerialEpoch()
    CivilFromDays(days, *y, *m, *d)
    if part == 0 {
        return ValNumber(cast(float64)y)
    }
    if part == 1 {
        return ValNumber(cast(float64)m)
    }
    if part == 2 {
        return ValNumber(cast(float64)d)
    }
    dow = (days % 7 + 4) % 7 + 1
    if dow < 1 {
        dow += 7
    }
    return ValNumber(cast(float64)dow)
}

FnTime :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    total: float64 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    if args[2].kind == VAL_ERROR {
        return ValError(args[2].err)
    }
    total = (CoerceNumber(*args[0]) * 3600.0 + CoerceNumber(*args[1]) * 60.0 + CoerceNumber(*args[2])) / 86400.0
    while total >= 1 {
        total -= 1
    }
    while total < 0 {
        total += 1
    }
    return ValNumber(total)
}

TimePart :: (args: *Val, count: s32, part: s32) -> Val {
    frac: float64 = 0
    seconds: float64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    frac = CoerceNumber(*args[0])
    while frac >= 1 {
        frac -= 1
    }
    while frac < 0 {
        frac += 1
    }
    seconds = frac * 86400.0
    if part == 0 {
        return ValNumber(cast(float64)TruncateToS32(seconds / 3600.0))
    }
    if part == 1 {
        return ValNumber(cast(float64)(TruncateToS32(seconds / 60.0) % 60))
    }
    return ValNumber(cast(float64)(TruncateToS32(seconds) % 60))
}

ParseIsoDate :: (text: *s8, y: *s32, m: *s32, d: *s32) -> s32 {
    pos: s32 = 0
    parts: [3]s32
    n: s32 = 0
    while text[pos] != 0 && n < 3 {
        if text[pos] == 45 || text[pos] == 47 {
            pos += 1
            continue
        }
        if !(IsDigitByte(cast(s32)(cast(u8)text[pos])) != 0) {
            return 0
        }
        value: s32 = 0
        while IsDigitByte(cast(s32)(cast(u8)text[pos])) != 0 {
            value = value * 10 + (cast(s32)text[pos] - 48)
            pos += 1
        }
        parts[n] = value
        n += 1
    }
    if n != 3 {
        return 0
    }
    if parts[0] > 31 {
        y[0] = parts[0]
        m[0] = parts[1]
        d[0] = parts[2]
    } else {
        y[0] = parts[2]
        m[0] = parts[0]
        d[0] = parts[1]
    }
    return 1
}

FnDateValue :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    text: [512]s8
    y: s32 = 0
    m: s32 = 0
    d: s32 = 0
    if TextArg(args, count, 0, *text[0], 512) < 0 {
        return ValError(ERR_VALUE)
    }
    if ParseIsoDate(*text[0], *y, *m, *d) != 0 {
        return ValNumber(cast(float64)(DaysFromCivil(y, m, d) - SerialEpoch()))
    }
    return ValError(ERR_VALUE)
}

FnToday :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    now: s64 = CurrentTime(null)
    return ValNumber(cast(float64)(now / 86400) + 25569.0)
}

FnNow :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    now: s64 = CurrentTime(null)
    return ValNumber(cast(float64)now / 86400.0 + 25569.0)
}

FnEdate :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    total: s32 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    serial: s32 = TruncateToS32(CoerceNumber(*args[0]))
    months: s32 = TruncateToS32(CoerceNumber(*args[1]))
    days: s32 = serial + SerialEpoch()
    y: s32 = 0
    m: s32 = 0
    d: s32 = 0
    CivilFromDays(days, *y, *m, *d)
    total = y * 12 + (m - 1) + months
    y = total / 12
    m = total % 12 + 1
    if d > (DaysFromCivil(y, m + 1, 1) - DaysFromCivil(y, m, 1)) {
        d = DaysFromCivil(y, m + 1, 1) - DaysFromCivil(y, m, 1)
    }
    return ValNumber(cast(float64)(DaysFromCivil(y, m, d) - SerialEpoch()))
}

FnEomonth :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    total: s32 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    serial: s32 = TruncateToS32(CoerceNumber(*args[0]))
    months: s32 = 0
    if count >= 2 {
        if args[1].kind == VAL_ERROR {
            return ValError(args[1].err)
        }
        months = TruncateToS32(CoerceNumber(*args[1]))
    }
    days: s32 = serial + SerialEpoch()
    y: s32 = 0
    m: s32 = 0
    d: s32 = 0
    CivilFromDays(days, *y, *m, *d)
    total = y * 12 + (m - 1) + months
    y = total / 12
    m = total % 12 + 1
    return ValNumber(cast(float64)(DaysFromCivil(y, m + 1, 1) - 1 - SerialEpoch()))
}

FnDatedif :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    unit: [16]s8
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 2, *unit[0], 16) < 0 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    a: s32 = TruncateToS32(CoerceNumber(*args[0]))
    b: s32 = TruncateToS32(CoerceNumber(*args[1]))
    if b < a {
        return ValError(ERR_NUM)
    }
    da: s32 = a + SerialEpoch()
    db: s32 = b + SerialEpoch()
    ya: s32 = 0
    ma: s32 = 0
    dla: s32 = 0
    yb: s32 = 0
    mb: s32 = 0
    dlb: s32 = 0
    CivilFromDays(da, *ya, *ma, *dla)
    CivilFromDays(db, *yb, *mb, *dlb)
    if TextCompareFoldLiteral(*unit[0], "d") == 0 {
        return ValNumber(cast(float64)(b - a))
    }
    if TextCompareFoldLiteral(*unit[0], "y") == 0 {
        years: s32 = yb - ya
        if mb < ma || (mb == ma && dlb < dla) {
            years -= 1
        }
        return ValNumber(cast(float64)years)
    }
    if TextCompareFoldLiteral(*unit[0], "m") == 0 {
        months: s32 = (yb - ya) * 12 + (mb - ma)
        if dlb < dla {
            months -= 1
        }
        return ValNumber(cast(float64)months)
    }
    if TextCompareFoldLiteral(*unit[0], "ym") == 0 {
        months: s32 = mb - ma
        if dlb < dla {
            months -= 1
        }
        if months < 0 {
            months += 12
        }
        return ValNumber(cast(float64)months)
    }
    if TextCompareFoldLiteral(*unit[0], "md") == 0 {
        if dlb >= dla {
            return ValNumber(cast(float64)(dlb - dla))
        }
        pm: s32 = mb - 1
        py: s32 = yb
        dim: s32 = 0
        if pm == 0 {
            pm = 12
            py -= 1
        }
        dim = DaysFromCivil(py, pm + 1, 1) - DaysFromCivil(py, pm, 1)
        return ValNumber(cast(float64)(dlb + dim - dla))
    }
    return ValError(ERR_VALUE)
}

FnDays360 :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    a: s32 = TruncateToS32(CoerceNumber(*args[0]))
    b: s32 = TruncateToS32(CoerceNumber(*args[1]))
    european: s32 = 0
    ya: s32 = 0
    ma: s32 = 0
    da: s32 = 0
    yb: s32 = 0
    mb: s32 = 0
    db: s32 = 0
    if count >= 3 {
        if args[2].kind == VAL_ERROR {
            return ValError(args[2].err)
        }
        if args[2].kind == VAL_STRING {
            method: [16]s8
            CoerceText(*args[2], *method[0], 16)
            european = cast(s32)(TextCompareFoldLiteral(*method[0], "TRUE") == 0)
        } else {
            european = cast(s32)(CoerceNumber(*args[2]) != 0)
        }
    }
    CivilFromDays(a + SerialEpoch(), *ya, *ma, *da)
    CivilFromDays(b + SerialEpoch(), *yb, *mb, *db)
    if european != 0 {
        if da == 31 {
            da = 30
        }
        if db == 31 {
            db = 30
        }
    } else {
        last_feb_a: s32 = cast(s32)(ma == 2 && da == (DaysFromCivil(ya, 3, 1) - DaysFromCivil(ya, 2, 1)))
        if last_feb_a != 0 {
            da = 30
        } else if da >= 30 {
            da = 30
        }
        if db >= 30 && da == 30 {
            db = 30
        }
    }
    return ValNumber(cast(float64)((yb - ya) * 360 + (mb - ma) * 30 + (db - da)))
}

FnRound :: (st: *EvalState, args: *Val, count: s32, marks: *s32, mode: s32) -> Val {
    digits: float64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if count >= 2 {
        if args[1].kind == VAL_ERROR {
            return ValError(args[1].err)
        }
        digits = CoerceNumber(*args[1])
    }
    v: float64 = CoerceNumber(*args[0])
    if v >= 1e307 {
        return ValError(ERR_VALUE)
    }
    scale: float64 = Pow(10.0, digits)
    scaled: float64 = v * scale
    r: float64 = 0
    if mode == 0 {
        if scaled >= 0 {
            r = Floor(scaled + 0.5)
        } else {
            r = Ceil(scaled - 0.5)
        }
    } else if mode == 1 {
        if scaled >= 0 {
            r = Floor(scaled)
        } else {
            r = Ceil(scaled)
        }
    } else {
        if scaled >= 0 {
            r = Ceil(scaled)
        } else {
            r = Floor(scaled)
        }
    }
    return ValNumber(r / scale)
}

FnInt :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    v: float64 = CoerceNumber(*args[0])
    if v >= 1e307 {
        return ValError(ERR_VALUE)
    }
    return ValNumber(Floor(v))
}

FnMod :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    a: float64 = CoerceNumber(*args[0])
    b: float64 = CoerceNumber(*args[1])
    if b == 0 {
        return ValError(ERR_DIV0)
    }
    return ValNumber(a - b * Floor(a / b))
}

FnAbs :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    v: float64 = CoerceNumber(*args[0])
    if v >= 1e307 {
        return ValError(ERR_VALUE)
    }
    return ValNumber(Fabs(v))
}

FnSign :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    v: float64 = CoerceNumber(*args[0])
    if v >= 1e307 {
        return ValError(ERR_VALUE)
    }
    if v > 0 {
        return ValNumber(1)
    }
    if v < 0 {
        return ValNumber(-1)
    }
    return ValNumber(0)
}

DomainOk :: (code: s32, v: float64) -> s32 {
    if code == 0 && v < 0 {
        return 0
    }
    if (code == 2 || code == 3 || code == 13) && v <= 0 {
        return 0
    }
    if (code == 7 || code == 8) && (v < -1 || v > 1) {
        return 0
    }
    return 1
}

ApplyMathOne :: (code: s32, v: float64) -> float64 {
    if code == 0 {
        return Sqrt(v)
    }
    if code == 1 {
        return Exp(v)
    }
    if code == 2 {
        return Log(v)
    }
    if code == 3 {
        return Log10(v)
    }
    if code == 4 {
        return Sin(v)
    }
    if code == 5 {
        return Cos(v)
    }
    if code == 6 {
        return Tan(v)
    }
    if code == 7 {
        return Asin(v)
    }
    if code == 8 {
        return Acos(v)
    }
    if code == 9 {
        return Atan(v)
    }
    if code == 10 {
        return Floor(v)
    }
    if code == 11 {
        return Ceil(v)
    }
    if code == 12 {
        return Expm1(v)
    }
    if code == 13 {
        return Log1p(v)
    }
    if code == 14 {
        return Sinh(v)
    }
    if code == 15 {
        return Cosh(v)
    }
    if code == 16 {
        return Tanh(v)
    }
    return 0
}

FnMathOne :: (st: *EvalState, args: *Val, count: s32, marks: *s32, code: s32) -> Val {
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    v: float64 = CoerceNumber(*args[0])
    if v >= 1e307 {
        return ValError(ERR_VALUE)
    }
    if !(DomainOk(code, v) != 0) {
        return ValError(ERR_NUM)
    }
    r: float64 = ApplyMathOne(code, v)
    if r != r {
        return ValError(ERR_NUM)
    }
    return ValNumber(r)
}

FnPower :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    a: float64 = CoerceNumber(*args[0])
    b: float64 = CoerceNumber(*args[1])
    if a >= 1e307 || b >= 1e307 {
        return ValError(ERR_VALUE)
    }
    r: float64 = Pow(a, b)
    if r != r {
        return ValError(ERR_NUM)
    }
    return ValNumber(r)
}

FnAtan2 :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    y: float64 = CoerceNumber(*args[0])
    x: float64 = CoerceNumber(*args[1])
    if x == 0 && y == 0 {
        return ValError(ERR_DIV0)
    }
    return ValNumber(Atan2(y, x))
}

FnFact :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    n: float64 = CoerceNumber(*args[0])
    if n < 0 || n != cast(float64)TruncateToS64(n) || n > 170 {
        return ValError(ERR_NUM)
    }
    r: float64 = 1
    i: s32 = 2
    while i <= TruncateToS32(n) {
        r *= cast(float64)i
        i += 1
    }
    return ValNumber(r)
}

FnFactDouble :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    n: s32 = TruncateToS32(CoerceNumber(*args[0]))
    if n < -1 || n > 300 {
        return ValError(ERR_NUM)
    }
    if n <= 1 {
        return ValNumber(1)
    }
    r: float64 = 1
    i: s32 = n
    while i >= 2 {
        r *= cast(float64)i
        i -= 2
    }
    return ValNumber(r)
}

GcdImpl :: (a: s32, b: s32) -> s32 {
    while b != 0 {
        t: s32 = a % b
        a = b
        b = t
    }
    return ifx a < 0 then (-a) else a
}

FnGcd :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    list: NumList
    CollectNumbers(args, count, *list)
    if list.count == 0 {
        return ValError(ERR_VALUE)
    }
    g: s32 = TruncateToS32(list.data[0])
    i: s32 = 1
    while i < list.count {
        g = GcdImpl(g, TruncateToS32(list.data[i]))
        i += 1
    }
    return ValNumber(cast(float64)g)
}

FnLcm :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    list: NumList
    CollectNumbers(args, count, *list)
    if list.count == 0 {
        return ValError(ERR_VALUE)
    }
    l: s32 = TruncateToS32(list.data[0])
    i: s32 = 1
    while i < list.count {
        g: s32 = GcdImpl(l, TruncateToS32(list.data[i]))
        if g == 0 {
            return ValError(ERR_NUM)
        }
        l = (l / g) * TruncateToS32(list.data[i])
        i += 1
    }
    return ValNumber(cast(float64)(ifx l < 0 then (-l) else l))
}

FnCombin :: (st: *EvalState, args: *Val, count: s32, marks: *s32, with_repeats: s32) -> Val {
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    n: s32 = TruncateToS32(CoerceNumber(*args[0]))
    k: s32 = TruncateToS32(CoerceNumber(*args[1]))
    r: float64 = 1
    i: s32 = 0
    if n < 0 || k < 0 {
        return ValError(ERR_NUM)
    }
    if with_repeats != 0 {
        if k > n {
            return ValError(ERR_NUM)
        }
        i = 0
        while i < k {
            r = (r * cast(float64)(n + k - 1 - i)) / cast(float64)(i + 1)
            i += 1
        }
        return ValNumber(r)
    }
    if k > n {
        return ValError(ERR_NUM)
    }
    i = 0
    while i < k {
        r = (r * cast(float64)(n - i)) / cast(float64)(i + 1)
        i += 1
    }
    return ValNumber(r)
}

FnDegreesRadians :: (st: *EvalState, args: *Val, count: s32, marks: *s32, to_deg: s32) -> Val {
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    v: float64 = CoerceNumber(*args[0])
    if v >= 1e307 {
        return ValError(ERR_VALUE)
    }
    if to_deg != 0 {
        return ValNumber((v * 180.0) / 3.14159265358979323846)
    }
    return ValNumber((v * 3.14159265358979323846) / 180.0)
}

FnChoose :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    n: s32 = TruncateToS32(CoerceNumber(*args[0]))
    if n < 1 || n >= count {
        return ValError(ERR_VALUE)
    }
    return ValCopy(*args[n])
}

ParseR1C1Index :: (text: *s8, pos: *s32, out: *s32) -> s32 {
    neg: s32 = 0
    val: s32 = 0
    p: s32 = pos[0]
    if text[p] == 91 {
        p += 1
        if text[p] == 45 {
            neg = 1
            p += 1
        }
        if text[p] < 48 || text[p] > 57 {
            return -1
        }
        while text[p] >= 48 && text[p] <= 57 {
            val = val * 10 + (cast(s32)text[p] - 48)
            p += 1
        }
        if text[p] != 93 {
            return -1
        }
        pos[0] = p + 1
        out[0] = ifx neg != 0 then (-val) else val
        return 1
    }
    if text[p] < 48 || text[p] > 57 {
        return -1
    }
    while text[p] >= 48 && text[p] <= 57 {
        val = val * 10 + (cast(s32)text[p] - 48)
        p += 1
    }
    pos[0] = p
    out[0] = val - 1
    return 0
}

FnAddress :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    row: s32 = 0
    col: s32 = 0
    absnum: s32 = 1
    a1: s32 = 1
    col_relative: s32 = 0
    row_relative: s32 = 0
    out: [512]s8
    letters: [8]s8
    prefix: [256]s8
    rbuf: [16]s8
    cbuf: [16]s8
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if args[1].kind == VAL_ERROR {
        return ValError(args[1].err)
    }
    row = TruncateToS32(CoerceNumber(*args[0]))
    col = TruncateToS32(CoerceNumber(*args[1]))
    if count >= 3 {
        if args[2].kind == VAL_ERROR {
            return ValError(args[2].err)
        }
        absnum = TruncateToS32(CoerceNumber(*args[2]))
    }
    if count >= 4 {
        if args[3].kind == VAL_ERROR {
            return ValError(args[3].err)
        }
        a1 = ifx CoerceNumber(*args[3]) != 0 then 1 else 0
    }
    if absnum == 1 || absnum == 5 {
        col_relative = 0
        row_relative = 0
    } else if absnum == 2 || absnum == 6 {
        col_relative = 1
        row_relative = 0
    } else if absnum == 3 || absnum == 7 {
        col_relative = 0
        row_relative = 1
    } else if absnum == 4 || absnum == 8 {
        col_relative = 1
        row_relative = 1
    } else {
        return ValError(ERR_VALUE)
    }
    if col < 1 || col > WB_MAX_COLS {
        return ValError(ERR_VALUE)
    }
    if row < 1 || row > WB_MAX_ROWS {
        return ValError(ERR_VALUE)
    }
    if count >= 5 {
        label: [256]s8
        CoerceText(*args[4], *label[0], 256)
        FormulaSheetPrefix(*label[0], *prefix[0])
    }
    if a1 != 0 {
        FormulaColName(col - 1, *letters[0])
        if col_relative == 0 && row_relative == 0 {
            FormatText(*out[0], 512, CText("%s$%s$%d"), *prefix[0], *letters[0], row)
        } else if col_relative != 0 && row_relative == 0 {
            FormatText(*out[0], 512, CText("%s%s$%d"), *prefix[0], *letters[0], row)
        } else if col_relative == 0 && row_relative != 0 {
            FormatText(*out[0], 512, CText("%s$%s%d"), *prefix[0], *letters[0], row)
        } else {
            FormatText(*out[0], 512, CText("%s%s%d"), *prefix[0], *letters[0], row)
        }
    } else {
        if row_relative != 0 {
            FormatText(*rbuf[0], 16, CText("R[%d]"), row)
        } else {
            FormatText(*rbuf[0], 16, CText("R%d"), row)
        }
        if col_relative != 0 {
            FormatText(*cbuf[0], 16, CText("C[%d]"), col)
        } else {
            FormatText(*cbuf[0], 16, CText("C%d"), col)
        }
        FormatText(*out[0], 512, CText("%s%s%s"), *prefix[0], *rbuf[0], *cbuf[0])
    }
    return ValString(wb_strdup(*out[0]))
}

FnAreas :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    gx: s32 = 0
    gl: s32 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if GroupBounds(marks, count, 0, *gx, *gl) != 0 && gx == 0 && gl == count && st.call_refs[0].kind != 0 {
        return ValNumber(1)
    }
    return ValError(ERR_VALUE)
}

FnIndirect :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    text: [512]s8
    a1: s32 = 1
    pos: s32 = 0
    row: s32 = 0
    col: s32 = 0
    row2: s32 = 0
    col2: s32 = 0
    sheet: *Sheet = null
    is_range: s32 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    CoerceText(*args[0], *text[0], 512)
    if count >= 2 {
        if args[1].kind == VAL_ERROR {
            return ValError(args[1].err)
        }
        a1 = ifx CoerceNumber(*args[1]) != 0 then 1 else 0
    }
    if a1 != 0 {
        if TryParseReference(st, *text[0], *pos, *row, *col, *row2, *col2, *sheet, *is_range) == 0 {
            return ValError(ERR_REF)
        }
    } else {
        seg: s32 = 0
        rel: s32 = 0
        sheet = st.sheet
        if text[pos] != 82 && text[pos] != 114 {
            return ValError(ERR_REF)
        }
        pos += 1
        rel = ParseR1C1Index(*text[0], *pos, *seg)
        if rel < 0 {
            return ValError(ERR_REF)
        }
        row = ifx rel != 0 then (st.this_row + seg) else seg
        if text[pos] != 67 && text[pos] != 99 {
            return ValError(ERR_REF)
        }
        pos += 1
        rel = ParseR1C1Index(*text[0], *pos, *seg)
        if rel < 0 {
            return ValError(ERR_REF)
        }
        col = ifx rel != 0 then (st.this_col + seg) else seg
    }
    SkipFormulaSpace(*text[0], *pos)
    if text[pos] != 0 {
        return ValError(ERR_REF)
    }
    if is_range != 0 {
        t_row: s32 = 0
        t_col: s32 = 0
        if row2 < row {
            swap: s32 = row
            row = row2
            row2 = swap
        }
        if col2 < col {
            swap2: s32 = col
            col = col2
            col2 = swap2
        }
        if col == col2 {
            if st.this_row < row || st.this_row > row2 {
                return ValError(ERR_VALUE)
            }
            t_row = st.this_row
            t_col = col
        } else if row == row2 {
            if st.this_col < col || st.this_col > col2 {
                return ValError(ERR_VALUE)
            }
            t_row = row
            t_col = st.this_col
        } else {
            return ValError(ERR_VALUE)
        }
        row = t_row
        col = t_col
    }
    if row < 0 || row >= WB_MAX_ROWS || col < 0 || col >= WB_MAX_COLS {
        return ValError(ERR_REF)
    }
    st.pend_kind = 1
    st.pend_row = row
    st.pend_col = col
    st.pend_row2 = row
    st.pend_col2 = col
    res: Val = EvaluateCell(st, sheet, row, col)
    if res.kind == VAL_EMPTY {
        return ValNumber(0)
    }
    return res
}

FnOffset :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    a_row: s32 = 0
    a_col: s32 = 0
    b_row: s32 = 0
    b_col: s32 = 0
    gx: s32 = 0
    gl: s32 = 0
    i0: s32 = 0
    row_offset: s32 = 0
    col_offset: s32 = 0
    tmp: s32 = 0
    if st.call_refs[0].kind == 0 {
        return ValError(ERR_VALUE)
    }
    a_row = st.call_refs[0].row
    a_col = st.call_refs[0].col
    b_row = st.call_refs[0].row2
    b_col = st.call_refs[0].col2
    if GroupBounds(marks, count, 0, *gx, *gl) == 0 {
        gx = 0
        gl = count
    }
    i0 = gx + gl
    if count < (i0 + 2) {
        return ValError(ERR_VALUE)
    }
    if args[i0].kind == VAL_ERROR {
        return ValError(args[i0].err)
    }
    if args[i0 + 1].kind == VAL_ERROR {
        return ValError(args[i0 + 1].err)
    }
    row_offset = TruncateToS32(CoerceNumber(*args[i0]))
    col_offset = TruncateToS32(CoerceNumber(*args[i0 + 1]))
    a_row += row_offset
    a_col += col_offset
    if a_row < 0 || a_col < 0 || a_row >= WB_MAX_ROWS || a_col >= WB_MAX_COLS {
        return ValError(ERR_REF)
    }
    if count >= (i0 + 3) {
        if args[i0 + 2].kind == VAL_ERROR {
            return ValError(args[i0 + 2].err)
        }
        tmp = TruncateToS32(CoerceNumber(*args[i0 + 2]))
        if tmp < 1 {
            return ValError(ERR_VALUE)
        }
        b_row = a_row + tmp - 1
    } else {
        b_row += row_offset
    }
    if b_col < 0 || b_row >= WB_MAX_ROWS {
        return ValError(ERR_REF)
    }
    if count >= (i0 + 4) {
        if args[i0 + 3].kind == VAL_ERROR {
            return ValError(args[i0 + 3].err)
        }
        tmp = TruncateToS32(CoerceNumber(*args[i0 + 3]))
        if tmp < 1 {
            return ValError(ERR_VALUE)
        }
        b_col = a_col + tmp - 1
    } else {
        b_col += col_offset
    }
    if b_col < 0 || b_col >= WB_MAX_COLS {
        return ValError(ERR_REF)
    }
    if b_row != a_row || b_col != a_col {
        t_row: s32 = a_row
        t_col: s32 = a_col
        if a_col == b_col {
            if st.this_row < a_row || st.this_row > b_row {
                return ValError(ERR_VALUE)
            }
            t_row = st.this_row
        } else if a_row == b_row {
            if st.this_col < a_col || st.this_col > b_col {
                return ValError(ERR_VALUE)
            }
            t_col = st.this_col
        } else {
            return ValError(ERR_VALUE)
        }
        a_row = t_row
        a_col = t_col
        b_row = t_row
        b_col = t_col
    }
    st.pend_kind = 1
    st.pend_row = a_row
    st.pend_col = a_col
    st.pend_row2 = a_row
    st.pend_col2 = a_col
    res: Val = EvaluateCell(st, st.sheet, a_row, a_col)
    if res.kind == VAL_EMPTY {
        return ValNumber(0)
    }
    return res
}

FnHyperlink :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    if count >= 2 {
        if args[1].kind == VAL_ERROR {
            return ValError(args[1].err)
        }
        return ValCopy(*args[1])
    }
    return ValCopy(*args[0])
}

FnIsref :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if st.call_refs[0].kind != 0 {
        return ValBool(1)
    }
    return ValBool(0)
}

FnColumnnumber :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    text: [512]s8
    pos: s32 = 0
    col: s32 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_ERROR {
        return ValError(args[0].err)
    }
    CoerceText(*args[0], *text[0], 512)
    if text[0] == 0 {
        return ValError(ERR_VALUE)
    }
    col = ParseColLetters(*text[0], *pos)
    if col < 0 || text[pos] != 0 {
        return ValError(ERR_VALUE)
    }
    if (col + 1) > WB_MAX_COLS {
        return ValError(ERR_VALUE)
    }
    return ValNumber(cast(float64)(col + 1))
}

CriterionMatch :: (criterion: *Val, v: *Val) -> s32 {
    op: s32 = 0
    cmp: Val
    c: s32 = 0
    if criterion.kind == VAL_ERROR {
        return -1
    }
    if v.kind == VAL_RANGE {
        return 0
    }
    if criterion.kind == VAL_STRING {
        spec: *s8 = criterion.text
        if spec[0] == 62 && spec[1] == 61 {
            op = 4
            spec = *spec[2]
        } else if spec[0] == 60 && spec[1] == 61 {
            op = 5
            spec = *spec[2]
        } else if spec[0] == 60 && spec[1] == 62 {
            op = 2
            spec = *spec[2]
        } else if spec[0] == 62 {
            op = 6
            spec = *spec[1]
        } else if spec[0] == 60 {
            op = 3
            spec = *spec[1]
        } else if spec[0] == 61 {
            op = 1
            spec = *spec[1]
        }
        if TextLooksNumeric(spec) != 0 {
            cmp = ValNumber(ParseDouble(spec, null))
        } else {
            cmp = ValString(spec)
        }
    } else {
        cmp = criterion[0]
    }
    if cmp.kind == VAL_STRING && v.kind == VAL_STRING {
        raw: s32 = TextCompareFold(v.text, cmp.text)
        c = ifx raw < 0 then (-1) else (ifx raw > 0 then 1 else 0)
    } else if cmp.kind == VAL_STRING {
        if v.kind == VAL_EMPTY && cmp.text[0] == 0 {
            c = 0
        } else {
            c = 1
        }
    } else {
        c = CompareVals(v, *cmp)
        if c == -2 {
            return 0
        }
    }
    if op == 0 || op == 1 {
        return cast(s32)(c == 0)
    }
    if op == 2 {
        return cast(s32)(c != 0)
    }
    if op == 3 {
        return cast(s32)(c < 0)
    }
    if op == 4 {
        return cast(s32)(c >= 0)
    }
    if op == 5 {
        return cast(s32)(c <= 0)
    }
    return cast(s32)(c > 0)
}

ReduceHalfPos :: (x_in: float64, pk: *s32) -> float64 {
    x: float64 = x_in
    k: s32 = 0
    x = Fmod(x, 2)
    if x >= 1 {
        x -= 1
        k += 2
    }
    if x >= 0.5 {
        x -= 0.5
        k += 1
    }
    if x > 0.25 {
        x -= 0.5
        k += 1
    }
    pk[0] = k & 3
    return x
}

GoSinpi :: (x_in: float64) -> float64 {
    x: float64 = x_in
    x0: float64 = x_in
    k: s32 = 0
    y: float64 = 0
    if x < 0 {
        k2: s32 = 0
        x = 0 - ReduceHalfPos(0 - x, *k2)
        k = 4 - k2
        if x == -0.25 {
            x += 0.5
            k += 3
        }
    } else {
        x = ReduceHalfPos(x, *k)
    }
    if x == 0 && (k & 1) == 0 {
        return Copysign(0, x0)
    }
    if x == 0 {
        y = cast(float64)(ifx (k & 1) != 0 then 1 else 0)
    } else if x == 0.25 {
        y = 0.707106781186547524400844362104849039284835937688474036588339
    } else {
        if (k & 1) != 0 {
            y = Cos(3.141592653589793 * x)
        } else {
            y = Sin(3.141592653589793 * x)
        }
    }
    if (k & 2) != 0 {
        return 0 - y
    }
    return y
}

GoCospi :: (x_in: float64) -> float64 {
    x: float64 = x_in
    k: s32 = 0
    y: float64 = 0
    if x < 0 {
        k2: s32 = 0
        x = 0 - ReduceHalfPos(0 - x, *k2)
        k = 4 - k2
        if x == -0.25 {
            x += 0.5
            k += 3
        }
    } else {
        x = ReduceHalfPos(x, *k)
    }
    if x == 0 && (k & 1) == 1 {
        return 0.0
    }
    k += 1
    if x == 0 {
        y = cast(float64)(ifx (k & 1) != 0 then 1 else 0)
    } else if x == 0.25 {
        y = 0.707106781186547524400844362104849039284835937688474036588339
    } else {
        if (k & 1) != 0 {
            y = Cos(3.141592653589793 * x)
        } else {
            y = Sin(3.141592653589793 * x)
        }
    }
    if (k & 2) != 0 {
        return 0 - y
    }
    return y
}

BesselICore :: (x: float64, nu: float64, nb: s32, bi: *float64) -> s32 {
    nend: s32 = 0
    intx: s32 = 0
    nbmx: s32 = 0
    k: s32 = 0
    l: s32 = 0
    n: s32 = 0
    nstart: s32 = 0
    pold: float64 = 0
    test: float64 = 0
    p: float64 = 0
    em: float64 = 0
    en: float64 = 0
    empal: float64 = 0
    emp2al: float64 = 0
    halfx: float64 = 0
    aa: float64 = 0
    bb: float64 = 0
    cc: float64 = 0
    psave: float64 = 0
    plast: float64 = 0
    tover: float64 = 0
    psavel: float64 = 0
    sum: float64 = 0
    twonu: float64 = nu + nu
    const_: float64 = 1.585
    goto120: s32 = 0
    goto220: s32 = 0
    goto230: s32 = 0
    overflow_hit: s32 = 0
    if nb > 0 && x >= 0 && nu >= 0 && nu < 1 {
        if x > 709 {
            k = 1
            while k <= nb {
                bi[k] = 1e308 * 10
                k += 1
            }
            return 1
        }
        intx = TruncateToS32(x)
        if x >= 1e-4 {
            nbmx = nb - intx
            n = intx + 1
            en = cast(float64)(n + n) + twonu
            plast = 1
            p = en / x
            test = 1e16 + 1e16
            if (intx * 2) > (16 * 5) {
                test = Sqrt(test * p)
            } else {
                test /= Pow(const_, cast(float64)intx)
            }
            if nbmx >= 3 {
                tover = 1e308 / 1e16
                nstart = intx + 2
                nend = nb - 1
                k = nstart
                while k <= nend {
                    n = k
                    en += 2
                    pold = plast
                    plast = p
                    p = (en * plast) / x + pold
                    if p > tover {
                        overflow_hit = 1
                        tover = 1e308
                        p /= tover
                        plast /= tover
                        psave = p
                        psavel = plast
                        nstart = n + 1
                        while true {
                            n += 1
                            en += 2
                            pold = plast
                            plast = p
                            p = (en * plast) / x + pold
                            if p > 1 {
                                break
                            }
                        }
                        bb = en / x
                        test = (pold * plast) / 1e16
                        test *= 0.5 - 0.5 / (bb * bb)
                        p = plast * tover
                        n -= 1
                        en -= 2
                        nend = ifx nb < n then nb else n
                        l = nstart
                        while l <= nend {
                            pold = psavel
                            psavel = psave
                            psave = (en * psavel) / x + pold
                            if (psave * psavel) > test {
                                break
                            }
                            l += 1
                        }
                        goto120 = 1
                    }
                    if overflow_hit != 0 {
                        break
                    }
                    k += 1
                }
                if goto120 == 0 {
                    n = nend
                    en = cast(float64)(n + n) + twonu
                    test = ifx test > (Sqrt(plast * 1e16) * Sqrt(p + p)) then test else (Sqrt(plast * 1e16) * Sqrt(p + p))
                }
            }
            if goto120 == 0 {
                while true {
                    n += 1
                    en += 2
                    pold = plast
                    plast = p
                    p = (en * plast) / x + pold
                    if p >= test {
                        break
                    }
                }
            }
            n += 1
            en += 2
            bb = 0
            aa = 1 / p
            em = cast(float64)n - 1
            empal = em + nu
            emp2al = em - 1 + twonu
            sum = (aa * empal * emp2al) / em
            nend = n - nb
            if nend < 0 {
                bi[n] = aa
                nend = -nend
                l = 1
                while l <= nend {
                    bi[n + l] = 0
                    l += 1
                }
            } else {
                if nend > 0 {
                    l = 1
                    while l <= nend {
                        n -= 1
                        en -= 2
                        cc = bb
                        bb = aa
                        if nend > 100 && aa > 1e200 {
                            cc = Ldexp(cc, -900)
                            bb = Ldexp(bb, -900)
                            sum = Ldexp(sum, -900)
                        }
                        aa = (en * bb) / x + cc
                        em -= 1
                        emp2al -= 1
                        if n == 1 {
                            break
                        }
                        if n == 2 {
                            emp2al = 1
                        }
                        empal -= 1
                        sum = ((sum + aa * empal) * emp2al) / em
                        l += 1
                    }
                }
                bi[n] = aa
                if nb <= 1 {
                    sum = sum + sum + aa
                    goto230 = 1
                }
                if goto230 == 0 {
                    n -= 1
                    en -= 2
                    bi[n] = (en * aa) / x + bb
                    if n == 1 {
                        goto220 = 1
                    } else {
                        em -= 1
                        if n == 2 {
                            emp2al = 1
                        } else {
                            emp2al -= 1
                        }
                        empal -= 1
                        sum = ((sum + bi[n] * empal) * emp2al) / em
                    }
                }
            }
            if goto220 == 0 && goto230 == 0 {
                nend = n - 2
                if nend > 0 {
                    l = 1
                    while l <= nend {
                        n -= 1
                        en -= 2
                        bi[n] = (en * bi[n + 1]) / x + bi[n + 2]
                        em -= 1
                        if n == 2 {
                            emp2al = 1
                        } else {
                            emp2al -= 1
                        }
                        empal -= 1
                        sum = ((sum + bi[n] * empal) * emp2al) / em
                        l += 1
                    }
                }
                bi[1] = (2 * empal * bi[2]) / x + bi[3]
                sum = sum + sum + bi[1]
            }
            if goto220 != 0 {
                sum = sum + sum + bi[1]
            }
            if nu != 0 {
                sum *= Tgamma(1 + nu) * Pow(x * 0.5, -nu)
            }
            sum *= Exp(-x)
            aa = 8.9e-308
            if sum > 1 {
                aa *= sum
            }
            n = 1
            while n <= nb {
                if bi[n] < aa {
                    bi[n] = 0
                } else {
                    bi[n] /= sum
                }
                n += 1
            }
            return 0
        } else {
            aa = 1
            empal = 1 + nu
            halfx = 0.5 * x
            if nu != 0 {
                aa = Pow(halfx, nu) / Tgamma(empal)
            }
            bb = halfx * halfx
            bi[1] = aa + (aa * bb) / empal
            if nb > 1 {
                if x == 0 {
                    n = 2
                    while n <= nb {
                        bi[n] = 0
                        n += 1
                    }
                } else {
                    cc = halfx
                    tover = (8.9e-308 + 8.9e-308) / x
                    if bb != 0 {
                        tover = 8.9e-308 / bb
                    }
                    n = 2
                    while n <= nb {
                        aa /= empal
                        empal += 1
                        aa *= cc
                        if aa <= (tover * empal) {
                            bi[n] = 0
                            aa = 0
                        } else {
                            bi[n] = aa + (aa * bb) / empal
                        }
                        n += 1
                    }
                }
            }
            return 0
        }
    }
    return 1
}

BesselI :: (x: float64, alpha_in: float64) -> float64 {
    alpha: float64 = alpha_in
    na: float64 = 0
    nb: s32 = 0
    bi: [64]float64
    ncalc: s32 = 0
    if x != x || alpha != alpha {
        return x + alpha
    }
    if x < 0 {
        return 0.0 / 0.0
    }
    na = Floor(alpha)
    if alpha < 0 {
        if alpha == na {
            return BesselI(x, -alpha)
        }
        return BesselI(x, -alpha) + ((BesselK(x, -alpha) * 2) / 3.141592653589793) * GoSinpi(-alpha)
    }
    nb = 1 + TruncateToS32(na)
    if nb > 60 {
        nb = 60
    }
    alpha -= cast(float64)(nb - 1)
    ncalc = BesselICore(x, alpha, nb, *bi[0])
    return bi[nb]
}

BesselKCore :: (x: float64, nu_in: float64, nb: s32, bk: *float64) -> s32 {
    nu: float64 = nu_in
    ex: float64 = x
    iend: s32 = 0
    i: s32 = 0
    j: s32 = 0
    k: s32 = 0
    m: s32 = 0
    ii: s32 = 0
    mplus1: s32 = 0
    x2by4: float64 = 0
    twox: float64 = 0
    c: float64 = 0
    blpha: float64 = 0
    ratio: float64 = 0
    wminf: float64 = 0
    d1: float64 = 0
    d2: float64 = 0
    d3: float64 = 0
    f0: float64 = 0
    f1: float64 = 0
    f2: float64 = 0
    p0: float64 = 0
    q0: float64 = 0
    t1: float64 = 0
    t2: float64 = 0
    twonu: float64 = 0
    dm: float64 = 0
    bk1: float64 = 0
    bk2: float64 = 0
    ncalc_v: s32 = 1
    a_const: float64 = 0.11593151565841244881
    p1: [8]float64 = .[0.805629875690432845, 20.4045500205365151, 157.705605106676174, 536.671116469207504, 900.382759291288778, 730.923886650660393, 229.299301509425145, 0.822467033424113231]
    q1: [7]float64 = .[29.4601986247850434, 277.577868510221208, 1206.70325591027438, 2762.91444159791519, 3443.74050506564618, 2210.63190113378647, 572.267338359892221]
    r1: [5]float64 = .[-0.48672575865218401848, 13.079485869097804016, -101.96490580880537526, 347.65409106507813131, 3.495898124521934782e-4]
    s1: [4]float64 = .[-25.579105509976461286, 212.57260432226544008, -610.69018684944109624, 422.69668805777760407]
    t1arr: [6]float64 = .[1.6125990452916363814e-10, 2.5051878502858255354e-8, 2.7557319615147964774e-6, 1.9841269840928373686e-4, 0.0083333333333334751799, 0.16666666666666666446]
    estm: [6]float64 = .[52.0583, 5.7607, 2.7782, 14.4303, 185.3004, 9.3715]
    estf: [7]float64 = .[41.8341, 7.1075, 6.4306, 42.511, 1.35633, 84.5096, 20]
    sqrt2dpi: float64 = 0.797884560802865355879892119869
    twonu = nu + nu
    if nb > 0 && nu >= 0 && nu < 1 {
        if ex <= 0 || ex > 705.342 {
            i = 0
            while i < nb {
                if ex <= 0 {
                    bk[i] = 1e308 * 10
                } else {
                    bk[i] = 0
                }
                i += 1
            }
            return 0
        }
        k = 0
        if nu < 1.49e-154 {
            nu = 0
        } else if nu > 0.5 {
            k = 1
            nu -= 1
        }
        twonu = nu + nu
        iend = nb + k - 1
        c = nu * nu
        d3 = -c
        if ex <= 1 {
            d1 = 0
            d2 = p1[0]
            t1 = 1
            t2 = q1[0]
            i = 2
            while i <= 7 {
                d1 = c * d1 + p1[i - 1]
                d2 = c * d2 + p1[i]
                t1 = c * t1 + q1[i - 1]
                t2 = c * t2 + q1[i]
                i += 2
            }
            d1 = nu * d1
            t1 = nu * t1
            f1 = Log(ex)
            f0 = a_const + nu * (p1[7] - (nu * (d1 + d2)) / (t1 + t2)) - f1
            q0 = Exp(-nu * (a_const - nu * (p1[7] + (nu * (d1 - d2)) / (t1 - t2)) - f1))
            f1 = nu * f0
            p0 = Exp(f1)
            d1 = r1[4]
            t1 = 1
            i = 0
            while i < 4 {
                d1 = c * d1 + r1[i]
                t1 = c * t1 + s1[i]
                i += 1
            }
            if Fabs(f1) <= 0.5 {
                f1 *= f1
                d2 = 0
                i = 0
                while i < 6 {
                    d2 = f1 * d2 + t1arr[i]
                    i += 1
                }
                d2 = f0 + f0 * f1 * d2
            } else {
                d2 = Sinh(f1) / nu
            }
            f0 = d2 - (nu * d1) / (t1 * p0)
            if ex <= 1e-10 {
                bk[0] = f0 + ex * f0
                bk[0] -= ex * bk[0]
                ratio = p0 / f0
                c = ex * 1.7976931348623157e308
                if k != 0 {
                    if bk[0] >= (c / ratio) {
                        return 1
                    }
                    bk[0] = (ratio * bk[0]) / ex
                    twonu += 2
                    ratio = twonu
                }
                if nb == 1 {
                    return 0
                }
                i = 1
                while i < nb {
                    if ratio >= c {
                        return 1
                    }
                    bk[i] = ratio / ex
                    twonu += 2
                    ratio = twonu
                    i += 1
                }
                i = 1
                while i < nb {
                    bk[i] *= bk[i - 1]
                    i += 1
                }
                return 0
            } else {
                c = 1
                x2by4 = (ex * ex) / 4
                p0 = 0.5 * p0
                q0 = 0.5 * q0
                d1 = -1
                d2 = 0
                bk1 = 0
                bk2 = 0
                f1 = f0
                f2 = p0
                while true {
                    d1 += 2
                    d2 += 1
                    d3 = d1 + d3
                    c = (x2by4 * c) / d2
                    f0 = (d2 * f0 + p0 + q0) / d3
                    p0 /= d2 - nu
                    q0 /= d2 + nu
                    t1 = c * f0
                    t2 = c * (p0 - d2 * f0)
                    bk1 += t1
                    bk2 += t2
                    if Fabs(t1 / (f1 + bk1)) <= 2.2204460492503131e-16 && Fabs(t2 / (f2 + bk2)) <= 2.2204460492503131e-16 {
                        break
                    }
                }
                bk1 = f1 + bk1
                bk2 = (2 * (f2 + bk2)) / ex
                wminf = estf[0] * ex + estf[1]
            }
        } else if (2.2204460492503131e-16 * ex) > 1 {
            i = 0
            while i < nb {
                bk[i] = 1 / (sqrt2dpi * Sqrt(ex))
                i += 1
            }
            return 0
        } else {
            twox = ex + ex
            blpha = 0
            ratio = 0
            if ex <= 4 {
                d2 = Trunc(estm[0] / ex + estm[1])
                m = TruncateToS32(d2)
                d1 = d2 + d2
                d2 -= 0.5
                d2 *= d2
                i = 2
                while i <= m {
                    d1 -= 2
                    d2 -= d1
                    ratio = (d3 + d2) / (twox + d1 - ratio)
                    i += 1
                }
                d2 = Trunc(estm[2] * ex + estm[3])
                m = TruncateToS32(d2)
                c = Fabs(nu)
                d3 = c + c
                d1 = d3 - 1
                f1 = 2.2250738585072014e-308
                f0 = ((2 * (c + d2)) / ex + (0.5 * ex) / (c + d2 + 1)) * 2.2250738585072014e-308
                i = 3
                while i <= m {
                    d2 -= 1
                    f2 = (d3 + d2 + d2) * f0
                    blpha = (1 + d1 / d2) * (f2 + blpha)
                    f2 = f2 / ex + f1
                    f1 = f0
                    f0 = f2
                    i += 1
                }
                f1 = ((d3 + 2) * f0) / ex + f1
                d1 = 0
                t1 = 1
                i = 1
                while i <= 7 {
                    d1 = c * d1 + p1[i - 1]
                    t1 = c * t1 + q1[i - 1]
                    i += 1
                }
                p0 = Exp(c * (a_const + c * (p1[7] - (c * d1) / t1) - Log(ex))) / ex
                f2 = ((c + 0.5 - ratio) * f1) / ex
                bk1 = p0 + ((d3 * f0 - f2 + f0 + blpha) / (f2 + f1 + f0)) * p0
                bk1 *= Exp(-ex)
                wminf = estf[2] * ex + estf[3]
            } else {
                dm = Trunc(estm[4] / ex + estm[5])
                m = TruncateToS32(dm)
                d2 = dm - 0.5
                d2 *= d2
                d1 = dm + dm
                i = 2
                while i <= m {
                    dm -= 1
                    d1 -= 2
                    d2 -= d1
                    ratio = (d3 + d2) / (twox + d1 - ratio)
                    blpha = (ratio + ratio * blpha) / dm
                    i += 1
                }
                bk1 = 1 / ((sqrt2dpi + sqrt2dpi * blpha) * Sqrt(ex))
                bk1 *= Exp(-ex)
                wminf = estf[4] * (ex - Fabs(ex - estf[6])) + estf[5]
            }
            bk2 = bk1 + (bk1 * (nu + 0.5 - ratio)) / ex
        }
        bk[0] = bk1
        if iend == 0 {
            return 0
        }
        j = 1 - k
        if j >= 0 {
            bk[j] = bk2
        }
        if iend == 1 {
            return 0
        }
        m = TruncateToS32(wminf - nu)
        if m > iend {
            m = iend
        }
        i = 2
        ii = 0
        while i <= m {
            t1 = bk1
            bk1 = bk2
            twonu += 2
            if ex < 1 {
                if bk1 >= ((1.7976931348623157e308 / twonu) * ex) {
                    break
                }
            } else {
                if (bk1 / ex) >= (1.7976931348623157e308 / twonu) {
                    break
                }
            }
            bk2 = (twonu / ex) * bk1 + t1
            ii = i
            j += 1
            if j >= 0 {
                bk[j] = bk2
            }
            i += 1
        }
        m = ii
        if m == iend {
            return 0
        }
        ratio = bk2 / bk1
        mplus1 = m + 1
        i = mplus1
        while i <= iend {
            twonu += 2
            ratio = twonu / ex + 1 / ratio
            j += 1
            if j >= 1 {
                bk[j] = ratio
            } else {
                if bk2 >= (1.7976931348623157e308 / ratio) {
                    return 1
                }
                bk2 *= ratio
            }
            i += 1
        }
        ncalc_v = mplus1 - k
        if ncalc_v < 1 {
            ncalc_v = 1
        }
        if ncalc_v == 1 {
            bk[0] = bk2
        }
        if nb == 1 {
            return 0
        }
        i = ncalc_v
        while i < nb {
            bk[i] *= bk[i - 1]
            i += 1
        }
        return 0
    }
    return 1
}

BesselK :: (x: float64, alpha_in: float64) -> float64 {
    alpha: float64 = alpha_in
    nb: s32 = 0
    bk: [64]float64
    ncalc: s32 = 0
    if x != x || alpha != alpha {
        return x + alpha
    }
    if x < 0 {
        return 0.0 / 0.0
    }
    if alpha < 0 {
        alpha = -alpha
    }
    nb = 1 + TruncateToS32(Floor(alpha))
    if nb > 60 {
        nb = 60
    }
    alpha -= cast(float64)(nb - 1)
    ncalc = BesselKCore(x, alpha, nb, *bk[0])
    return bk[nb - 1]
}

FnBesseli :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    return ValNumber(BesselI(CoerceNumber(*args[0]), CoerceNumber(*args[1])))
}

FnBesselk :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    return ValNumber(BesselK(CoerceNumber(*args[0]), CoerceNumber(*args[1])))
}

FnBesselj :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    x: float64 = 0
    order: float64 = 0
    n: s32 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    x = CoerceNumber(*args[0])
    order = CoerceNumber(*args[1])
    if order < 0 || order != Floor(order) || order > 1000 {
        return ValError(ERR_NUM)
    }
    n = TruncateToS32(order)
    if x < 0 {
        if (n % 2) != 0 {
            return ValNumber(0 - Jn(n, -x))
        }
        return ValNumber(Jn(n, -x))
    }
    return ValNumber(Jn(n, x))
}

FnBessely :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    x: float64 = 0
    order: float64 = 0
    n: s32 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    x = CoerceNumber(*args[0])
    order = CoerceNumber(*args[1])
    if order < 0 || order != Floor(order) || order > 1000 {
        return ValError(ERR_NUM)
    }
    if x < 0 {
        return ValError(ERR_NUM)
    }
    n = TruncateToS32(order)
    return ValNumber(Yn(n, x))
}

