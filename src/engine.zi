    return CxVal(CxArccoth(a), unit)
}

FnCxReal1 :: (name_op: s32, args: *Val, count: s32) -> Val {
    a: Cplx
    unit: s32 = 105
    if CxArg(args, count, 0, *a, *unit) < 0 {
        return ValError(ERR_VALUE)
    }
    if name_op == 0 {
        return ValNumber(CxMod(a))
    }
    if name_op == 1 {
        return ValNumber(a.im)
    }
    if name_op == 2 {
        return ValNumber(a.re)
    }
    return ValNumber(CxAngle(a))
}

GoCosPi :: (x_in: float64) -> float64 {
    x: float64 = x_in
    k: s32 = 0
    y: float64 = 0
    if x < 0 {
        k2: s32 = 0
        x = 0 - ReduceHalfPos(0 - x, *k2)
        k = 4 - k2
        if x == -0.25 {
            x += 0.5
            k += 3
        }
    } else {
        x = ReduceHalfPos(x, *k)
    }
    if x == 0 && (k & 1) == 1 {
        return 0.0
    }
    k += 1
    if x == 0 {
        y = cast(float64)(ifx (k & 1) != 0 then 1 else 0)
    } else if x == 0.25 {
        y = 0.707106781186547524400844362104849039284835937688474036588339
    } else {
        if (k & 1) != 0 {
            y = Cos(3.141592653589793 * x)
        } else {
            y = Sin(3.141592653589793 * x)
        }
    }
    if (k & 2) != 0 {
        return 0 - y
    }
    return y
}

GoAtan2Pi :: (y: float64, x: float64) -> float64 {
    return Atan2(y, x) / 3.141592653589793
}

FnComplexFn :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    c: Cplx
    suffix: [8]s8
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    c.re = CoerceNumber(*args[0])
    c.im = CoerceNumber(*args[1])
    if TextArg(args, count, 2, *suffix[0], 8) < 0 {
        return ValError(ERR_VALUE)
    }
    if count >= 3 {
        if TextCompareLiteral(*suffix[0], "i") != 0 && TextCompareLiteral(*suffix[0], "j") != 0 {
            return ValError(ERR_VALUE)
        }
        return CxVal(c, cast(s32)suffix[0])
    }
    return CxVal(c, 105)
}

FnImdiv :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    a: Cplx
    b: Cplx
    unit: s32 = 105
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if CxArg(args, count, 0, *a, *unit) < 0 {
        return ValError(ERR_VALUE)
    }
    if CxArg(args, count, 1, *b, *unit) < 0 {
        return ValError(ERR_VALUE)
    }
    if b.re == 0 && b.im == 0 {
        return ValError(ERR_DIV0)
    }
    return CxVal(CxDiv(a, b), unit)
}

FnImpower :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    a: Cplx
    b: Cplx
    unit: s32 = 105
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if CxArg(args, count, 0, *a, *unit) < 0 {
        return ValError(ERR_VALUE)
    }
    if CxArg(args, count, 1, *b, *unit) < 0 {
        return ValError(ERR_VALUE)
    }
    if a.re == 0 && a.im == 0 && b.re == 0 && b.im == 0 {
        return ValError(ERR_NUM)
    }
    return CxVal(CxPow(a, b), unit)
}

FnImsub :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    a: Cplx
    b: Cplx
    unit: s32 = 105
    if count < 2 {
        return ValError(ERR_VALUE)
    }
