    while Fabs(term) > Fabs(sum * sumAcc) {
        term *= ((d - b) * x) / d
        sum += term / (a + d)
        d += 1
    }
    return a * (b - 1) * sum
}

tdistexp :: (p: float64, q: float64, logqk2: float64, k: float64, log_p: s32, approxtdistDens: *float64) -> float64 {
    sumAcc: float64 = 5E-16
    cfVSmall: float64 = 1.0e-14
    lstpi: float64 = Log(2 * 3.141592653589793238462643383279502884197169399375105820974944592307816406286208998628034825342117) / 2
    if (Floor(k / 2) * 2) == k {
        ldens: float64 = logqk2 + logfbit(k - 1) - 2 * logfbit(k * 0.5 - 1) - lstpi
        approxtdistDens.* = Exp(ldens)
    } else {
        ldens: float64 = logqk2 + k * Log1pmx(1 / k) + 2 * logfbit((k - 1) * 0.5) - logfbit(k - 1) - lstpi
        approxtdistDens.* = Exp(ldens)
    }
    if (k * p) < (4 * q) {
        sum: float64 = 0
        aki: float64 = k + 1
        ai: float64 = 3
        term: float64 = (aki * p) / ai
        while term > (sumAcc * sum) {
            sum += term
            ai += 2
            aki += 2
            term *= (aki * p) / ai
        }
        sum += term
        return ifx log_p != 0 then logspace_sub_go(-0.693147180559945309417232121458, approxtdistDens.* + Log1p(sum) + Log(k * p) / 2) else (0.5 - approxtdistDens.* * (sum + 1) * Sqrt(k * p))
    } else {
        q1: float64 = 2 * (1 + q)
        q8: float64 = 8 * q
        a1: float64 = 0
        b1: float64 = 1
        c1: float64 = -6 * q
        a2: float64 = 1
        b2: float64 = (k - 1) * p + 3
        cadd: float64 = -14 * q
        c2: float64 = b2 + q1
        while Fabs(a2 * b1 - a1 * b2) > Fabs(cfVSmall * b1 * b2) {
            a1 = c2 * a2 + c1 * a1
            b1 = c2 * b2 + c1 * b1
            c1 += cadd
            cadd -= q8
            c2 += q1
            a2 = c2 * a1 + c1 * a2
            b2 = c2 * b1 + c1 * b2
            c1 += cadd
            cadd -= q8
            c2 += q1
            if Fabs(b2) > 115792089237316195423570985008687907853269984665640564039457584007913129639936.0 {
                a1 *= 1 / 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
                b1 *= 1 / 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
                a2 *= 1 / 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
                b2 *= 1 / 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
            } else if Fabs(b2) < (1 / 115792089237316195423570985008687907853269984665640564039457584007913129639936.0) {
                a1 *= 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
                b1 *= 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
                a2 *= 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
                b2 *= 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
            }
        }
        return ifx log_p != 0 then (approxtdistDens.* + Log1p((-q * a2) / b2) - Log(k * p) / 2) else ((approxtdistDens.* * (1 - (q * a2) / b2)) / Sqrt(k * p))
    }
}

logspace_signed_add :: (logx: float64, logabsy: float64, ypos: s32) -> float64 {
    return ifx ypos != 0 then logspace_add_go(logx, logabsy) else logspace_sub_go(logx, logabsy)
}

binomialTerm :: (i: float64, j: float64, p: float64, q: float64, diffFromMean: float64, log_p: s32) -> float64 {
    minLog1Value: float64 = -0.79149064
    c1: float64 = 0
    c2: float64 = 0
    c3: float64 = 0
    c4: float64 = 0
    c5: float64 = 0
    c6: float64 = 0
    ps: float64 = 0
    logbinomialTerm: float64 = 0
    dfm: float64 = 0
    t: float64 = 0
    if i == 0 && j <= 0 {
        return 1.0
    }
    if i <= -1 || j < 0 {
        return 0.0
    }
    c1 = i + 1 + j
    if p < q {
        c2 = i
        c3 = j
        ps = p
        dfm = diffFromMean
    } else {
        c3 = i
        c2 = j
        ps = q
        dfm = -diffFromMean
    }
    c5 = (dfm - (1 - ps)) / (c2 + 1)
    c6 = -(dfm + ps) / (c3 + 1)
    if c5 < minLog1Value {
        if c2 == 0 {
            logbinomialTerm = c3 * Log1p(-ps)
            return ifx log_p != 0 then logbinomialTerm else Exp(logbinomialTerm)
        } else if ps == 0 && c2 > 0 {
            return 0.0
        } else {
            t = Log((ps * c1) / (c2 + 1)) - c5
        }
    } else {
        t = Log1pmx(c5)
    }
    c4 = logfbit(i + j) - logfbit(i) - logfbit(j)
    logbinomialTerm = c4 + c2 * t - c5 + (c3 * Log1pmx(c6) - c6)
    return ifx log_p != 0 then (logbinomialTerm + 0.5 * Log(c1 / ((c2 + 1) * (c3 + 1) * 2 * 3.141592653589793238462643383279502884197169399375105820974944592307816406286208998628034825342117))) else (Exp(logbinomialTerm) * Sqrt(c1 / ((c2 + 1) * (c3 + 1) * 2 * 3.141592653589793238462643383279502884197169399375105820974944592307816406286208998628034825342117)))
}

logfbitdif :: (x: float64) -> float64 {
    y: float64 = 1 / (2 * x + 3)
    y2: float64 = y * y
    return y2 * GoLogcf(y2, 3, 2, 1e-14)
}

logfbit :: (x: float64) -> float64 {
    if x >= 1e10 {
        return 1 / (12 * (x + 1))
    } else if x >= 6 {
        x1: float64 = x + 1
        x2: float64 = 1 / (x1 * x1)
        x3: float64 = 0
        x3 = x2 * (1.0 / 30 - x2 * (1.0 / 105 - x2 * (1.0 / 140 - x2 * (1.0 / 99 - x2 * (691.0 / 30030 - x2 * (1.0 / 13 - x2 * (0.35068606896459316479 - x2 * 1.6769998201671114808)))))))
        return ((1.0 / 12) * (1 - x3)) / x1
    } else if x == 5 {
        return 0.13876128823070747998745727023762908562e-1
    } else if x == 4 {
        return 0.16644691189821192163194865373593391145e-1
    } else if x == 3 {
        return 0.20790672103765093111522771767848656333e-1
    } else if x == 2 {
        return 0.27677925684998339148789292746244666596e-1
    } else if x == 1 {
        return 0.41340695955409294093822081407117508025e-1
    } else if x == 0 {
        return 0.81061466795327258219670263594382360138e-1
    } else if x > -1 {
        x1: float64 = x
        x2: float64 = 0
        while x1 < 6 {
            x2 += logfbitdif(x1)
            x1 += 1
        }
        return x2 + logfbit(x1)
    } else {
        return 1e308 * 10
    }
}

logfbit1dif :: (x: float64) -> float64 {
    return (logfbitdif(x) - 1 / (4 * (x + 1) * (x + 2))) / (x + 1.5)
}

logfbit3dif :: (x: float64) -> float64 {
    return 0 - (2 * x + 3) * Pow((x + 1) * (x + 2), -3)
}

logfbit5dif :: (x: float64) -> float64 {
    return 0 - 6 * (2 * x + 3) * ((5 * x + 15) * x + 12) * Pow((x + 1) * (x + 2), -5)
}

logfbit7dif :: (x: float64) -> float64 {
    return 0 - 120 * (2 * x + 3) * ((((14 * x + 84) * x + 196) * x + 210) * x + 87) * Pow((x + 1) * (x + 2), -7)
}

logfbit1 :: (x: float64) -> float64 {
    if x >= 1e10 {
        return (-1.0 / 12) * Pow(x + 1, -2)
    } else if x >= 6 {
        x1: float64 = x + 1
        x2: float64 = 1 / (x1 * x1)
        x3: float64 = 0
        x3 = x2 * (3 * (1.0 / 30) - x2 * (5 * (1.0 / 105) - x2 * (7 * (1.0 / 140) - x2 * (9 * (1.0 / 99) - x2 * (11 * (691.0 / 30030) - x2 * (13 * (1.0 / 13) - x2 * (15 * 0.35068606896459316479 - x2 * 17 * 1.6769998201671114808)))))))
        return (-1.0 / 12) * (1 - x3) * x2
    } else if x > -1 {
        x1: float64 = x
        x2: float64 = 0
        while x1 < 6 {
            x2 += logfbit1dif(x1)
            x1 += 1
        }
        return x2 + logfbit1(x1)
    } else {
        return -1e308 * 10
    }
}

logfbit3 :: (x: float64) -> float64 {
    if x >= 1e10 {
        return -0.5 * Pow(x + 1, -4)
    } else if x >= 6 {
        x1: float64 = x + 1
        x2: float64 = 1 / (x1 * x1)
        x3: float64 = 0
        x3 = x2 * (60 * (1.0 / 30) - x2 * (210 * (1.0 / 105) - x2 * (504 * (1.0 / 140) - x2 * (990 * (1.0 / 99) - x2 * (1716 * (691.0 / 30030) - x2 * (2730 * (1.0 / 13) - x2 * (4080 * 0.35068606896459316479 - x2 * 5814 * 1.6769998201671114808)))))))
        return (-1.0 / 12) * (6 - x3) * x2 * x2
    } else if x > -1 {
        x1: float64 = x
        x2: float64 = 0
        while x1 < 6 {
            x2 += logfbit3dif(x1)
            x1 += 1
        }
        return x2 + logfbit3(x1)
    } else {
        return -1e308 * 10
    }
}

logfbit5 :: (x: float64) -> float64 {
    if x >= 1e10 {
        return -10 * Pow(x + 1, -6)
    } else if x >= 6 {
        x1: float64 = x + 1
        x2: float64 = 1 / (x1 * x1)
        x3: float64 = 0
        x3 = x2 * (2520 * (1.0 / 30) - x2 * (15120 * (1.0 / 105) - x2 * (55440 * (1.0 / 140) - x2 * (154440 * (1.0 / 99) - x2 * (360360 * (691.0 / 30030) - x2 * (742560 * (1.0 / 13) - x2 * (1395360 * 0.35068606896459316479 - x2 * 2441880 * 1.6769998201671114808)))))))
        return (-1.0 / 12) * (120 - x3) * x2 * x2 * x2
    } else if x > -1 {
        x1: float64 = x
        x2: float64 = 0
        while x1 < 6 {
            x2 += logfbit5dif(x1)
            x1 += 1
        }
        return x2 + logfbit5(x1)
    } else {
        return -1e308 * 10
    }
}

logfbit7 :: (x: float64) -> float64 {
    if x >= 1e10 {
        return -420 * Pow(x + 1, -8)
    } else if x >= 6 {
        x1: float64 = x + 1
        x2: float64 = 1 / (x1 * x1)
        x3: float64 = 0
        x3 = x2 * (181440 * (1.0 / 30) - x2 * (1663200 * (1.0 / 105) - x2 * (8648640 * (1.0 / 140) - x2 * (32432400 * (1.0 / 99) - x2 * (98017920 * (691.0 / 30030) - x2 * (253955520 * (1.0 / 13) - x2 * (586051200 * 0.35068606896459316479 - x2 * 1235591280 * 1.6769998201671114808)))))))
        return (-1.0 / 12) * (5040 - x3) * x2 * x2 * x2 * x2
    } else if x > -1 {
        x1: float64 = x
        x2: float64 = 0
        while x1 < 6 {
            x2 += logfbit7dif(x1)
            x1 += 1
        }
        return x2 + logfbit7(x1)
    } else {
        return -1e308 * 10
    }
}

dt :: (x: float64, n: float64, give_log: s32) -> float64 {
    if x != x || n != n {
        return x + n
    }
    if n <= 0 {
        return 0.0 / 0.0
    }
    if IsFinite(x) == 0 {
        return 0.0
    }
    if IsFinite(n) == 0 {
        return dnorm_go(x, 0, 1, give_log)
    }
    u: float64 = 0
    t: float64 = 0 - bd0(n / 2, (n + 1) / 2) + stirlerr((n + 1) / 2) - stirlerr(n / 2)
    x2n: float64 = (x * x) / n
    ax: float64 = 0
    l_x2n: float64 = 0
    lrg_x2n: s32 = cast(s32)(x2n > (1 / 2.2204460492503131e-16))
    if lrg_x2n != 0 {
        ax = Fabs(x)
        l_x2n = Log(ax) - Log(n) / 2.0
        u = n * l_x2n
    } else if x2n > 0.2 {
        l_x2n = Log1p(x2n) / 2.0
        u = n * l_x2n
    } else {
        l_x2n = Log1p(x2n) / 2.0
        u = -bd0(n / 2.0, (n + x * x) / 2.0) + (x * x) / 2.0
    }
    if give_log != 0 {
        return t - u - (0.918938533204672741780329736406 + l_x2n)
    }
    I_sqrt_: float64 = ifx lrg_x2n != 0 then (Sqrt(n) / ax) else Exp(-l_x2n)
    return Exp(t - u) * 0.398942280401432677939946059934 * I_sqrt_
}

pt :: (x: float64, n: float64, lower_tail: s32, log_p: s32) -> float64 {
    val: float64 = 0
    nx: float64 = 0
    if x != x || n != n {
        return x + n
    }
    if n <= 0 {
        return 0.0 / 0.0
    }
    if IsFinite(x) == 0 {
        return ifx x < 0 then (ifx lower_tail != 0 then 0.0 else 1.0) else (ifx lower_tail != 0 then 1.0 else 0.0)
    }
    if IsFinite(n) == 0 {
        return pnorm(x, 0.0, 1.0, lower_tail, log_p)
    }
    if n > 4e5 {
        val = 1.0 / (4.0 * n)
        return pnorm((x * (1.0 - val)) / Sqrt(1.0 + x * x * 2.0 * val), 0.0, 1.0, lower_tail, log_p)
    }
    nx = 1 + (x / n) * x
    if nx > 1e100 {
        lval: float64 = 0
        lval = -0.5 * n * (2 * Log(Fabs(x)) - Log(n)) - lbeta_go(0.5 * n, 0.5) - Log(0.5 * n)
        val = ifx log_p != 0 then lval else Exp(lval)
    } else {
        val = ifx n > (x * x) then pbeta((x * x) / (n + x * x), 0.5, n / 2.0, 0, log_p) else pbeta(1.0 / nx, n / 2.0, 0.5, 1, log_p)
    }
    if x <= 0 {
        lower_tail = cast(s32)(lower_tail == 0)
    }
    if log_p != 0 {
        if lower_tail != 0 {
            return Log1p(-0.5 * Exp(val))
        } else {
            return val - 0.693147180559945309417232121458
        }
    } else {
        val /= 2
        return ifx lower_tail != 0 then (1 - val) else val
    }
}

dt_go :: (x: float64, n: float64, give_log: s32) -> float64 {
    u: float64 = 0
    t: float64 = 0
    x2n: float64 = 0
    ax: float64 = 0
    l_x2n: float64 = 0
    lrg_x2n: s32 = 0
    if x != x || n != n {
        return x + n
    }
    if n <= 0 {
        return 0.0 / 0.0
    }
    if IsFinite(x) == 0 {
        return 0.0
    }
    if IsFinite(n) == 0 {
        return dnorm_go(x, 0, 1, give_log)
    }
    t = 0 - bd0(n / 2, (n + 1) / 2) + stirlerr((n + 1) / 2) - stirlerr(n / 2)
    x2n = (x * x) / n
    ax = 0
    l_x2n = 0
    lrg_x2n = ifx x2n > (1 / 2.2204460492503131e-16) then 1 else 0
    if lrg_x2n != 0 {
        ax = Fabs(x)
        l_x2n = Log(ax) - Log(n) / 2
        u = n * l_x2n
    } else if x2n > 0.2 {
        l_x2n = Log1p(x2n) / 2
        u = n * l_x2n
    } else {
        l_x2n = Log1p(x2n) / 2
        u = 0 - bd0(n / 2, (n + x * x) / 2) + (x * x) / 2
    }
    if give_log != 0 {
        return t - u - (0.918938533204672741780329736406 + l_x2n)
    }
    i_sqrt: float64 = ifx lrg_x2n != 0 then (Sqrt(n) / ax) else Exp(0 - l_x2n)
    return Exp(t - u) * 0.398942280401432677939946059934 * i_sqrt
}

qt :: (p: float64, ndf: float64, lower_tail: s32, log_p: s32) -> float64 {
    eps: float64 = 1.0e-12
    P: float64 = 0
    q: float64 = 0
    if p != p || ndf != ndf {
        return p + ndf
    }
    if log_p != 0 {
        if p > 0 {
            return 0.0 / 0.0
        }
        if p == 0 {
            return ifx lower_tail != 0 then (1e308 * 10) else (-1e308 * 10)
        }
        if p == (-1e308 * 10) {
            return ifx lower_tail != 0 then (-1e308 * 10) else (1e308 * 10)
        }
    } else {
        if p < 0 || p > 1 {
            return 0.0 / 0.0
        }
        if p == 0 {
            return ifx lower_tail != 0 then (-1e308 * 10) else (1e308 * 10)
        }
        if p == 1 {
            return ifx lower_tail != 0 then (1e308 * 10) else (-1e308 * 10)
        }
    }
    if ndf <= 0 {
        return 0.0 / 0.0
    }
    if ndf < 1 {
        accu: float64 = 1e-13
        Eps: float64 = 1e-11
        ux: float64 = 0
        lx: float64 = 0
        nx2: float64 = 0
        pp: float64 = 0
        iter: s32 = 0
        if p > (1 - 2.2204460492503131e-16) {
            return 1e308 * 10
        }
        pp = Fmin(1 - 2.2204460492503131e-16, p * (1 + Eps))
        ux = 1
        while ux < 1.7976931348623157e308 && pt(ux, ndf, 1, 0) < pp {
            ux *= 2
        }
        pp = p * (1 - Eps)
        lx = -1.0
        while lx > -1.7976931348623157e308 && pt(lx, ndf, 1, 0) > pp {
            lx *= 2
        }
        while iter < 1000 {
            nx2 = 0.5 * (lx + ux)
            if cast(s32)((ux - lx) > (accu * Fabs(nx2))) == 0 {
                break
            }
            if pt(nx2, ndf, 1, 0) > p {
                ux = nx2
            } else {
                lx = nx2
            }
            iter += 1
        }
        return 0.5 * (lx + ux)
    }
    if ndf > 1e20 {
        return qnorm(p, 0, 1, lower_tail, log_p)
    }
    P = ifx log_p != 0 then Exp(p) else p
    neg: s32 = ifx (lower_tail == 0 || P < 0.5) && (lower_tail != 0 || P > 0.5) then 1 else 0
    is_neg_lower: s32 = ifx lower_tail == neg then 1 else 0
    if neg != 0 {
        if log_p != 0 {
            if lower_tail != 0 {
                P = 2 * P
            } else {
                P = 2 * (0 - Expm1(p))
            }
        } else {
            P = 2 * (ifx lower_tail != 0 then P else (0.5 - p + 0.5))
        }
    } else {
        if log_p != 0 {
            if lower_tail != 0 {
                P = 2 * (0 - Expm1(p))
            } else {
                P = 2 * P
            }
        } else {
            P = 2 * (ifx lower_tail != 0 then (0.5 - p + 0.5) else p)
        }
    }
    if Fabs(ndf - 2) < eps {
        if P > 2.2250738585072014e-308 {
            if (3 * P) < 2.2204460492503131e-16 {
                q = 1 / Sqrt(P)
            } else if P > 0.9 {
                q = (1 - P) * Sqrt(2 / (P * (2 - P)))
            } else {
                q = Sqrt(2 / (P * (2 - P)) - 2)
            }
        } else {
            if log_p != 0 {
                if is_neg_lower != 0 {
                    q = Exp(0 - p / 2) / 1.4142135623730950488016887242096980785696718753769480731766797379907324784621070388503875343276415727350138846229
                } else {
                    q = 1 / Sqrt(0 - Expm1(p))
                }
            } else {
                q = 1e308 * 10
            }
        }
    } else if ndf < (1 + eps) {
        if P == 1 {
            q = 0
        } else if P > 0 {
            q = 1 / GoTanpi(P / 2)
        } else {
            if log_p != 0 {
                if is_neg_lower != 0 {
                    q = 0.3183098861837906715377675267450287240689192914809128974953346881177953537 * Exp(0 - p)
                } else {
                    q = -1 / (0.3183098861837906715377675267450287240689192914809128974953346881177953537 * Expm1(p))
                }
            } else {
                q = 1e308 * 10
            }
        }
    } else {
        x: float64 = 0
        y: float64 = 0
        log_P2: float64 = 0
        a: float64 = 1 / (ndf - 0.5)
        b: float64 = 48 / (a * a)
        c: float64 = (((20700 * a) / b - 98) * a - 16) * a + 96.36
        d: float64 = ((94.5 / (b + c) - 3) / b + 1) * Sqrt(a * 1.5707963267948966192313216916397514420985846996875529104874722961539082031431044993140174126711) * ndf
        P_ok1: s32 = ifx P > 2.2250738585072014e-308 || log_p == 0 then 1 else 0
        P_ok: s32 = P_ok1
        if P_ok1 != 0 {
            y = Pow(d * P, 2.0 / ndf)
            P_ok = ifx y >= 2.2204460492503131e-16 then 1 else 0
        }
        if P_ok == 0 {
            if is_neg_lower != 0 {
                log_P2 = ifx log_p != 0 then p else Log1p(0 - p)
            } else {
                log_P2 = ifx log_p != 0 then swap_log_tail(p) else Log1p(0 - p)
            }
            x = (Log(d) + 0.693147180559945309417232121458 + log_P2) / ndf
            y = Exp(2 * x)
        }
        if (ndf < 2.1 && P > 0.5) || y > (0.05 + a) {
            if P_ok != 0 {
                x = qnorm(0.5 * P, 0, 1, 1, 0)
            } else {
                x = qnorm(log_P2, 0, 1, lower_tail, log_p)
            }
            y = x * x
            if ndf < 5 {
                c += 0.3 * (ndf - 4.5) * (x + 0.6)
            }
            c = (((0.05 * d * x - 5) * x - 7) * x - 2) * x + b + c
            y = (((((0.4 * y + 6.3) * y + 36) * y + 94.5) / c - y - 3) / b + 1) * x
            y = Expm1(a * y * y)
            q = Sqrt(ndf * y)
        } else if P_ok == 0 && x < (0 - 0.693147180559945309417232121458 * 53) {
            q = Sqrt(ndf) * Exp(0 - x)
        } else {
            y = (((1 / (((ndf + 6) / (ndf * y) - 0.089 * d - 0.822) * (ndf + 2) * 3) + 0.5 / (ndf + 4)) * y - 1) * (ndf + 1)) / (ndf + 2) + 1 / y
            q = Sqrt(ndf * y)
        }
        if P_ok1 != 0 {
            it_value: s32 = 0
            while it_value < 10 {
                y = dt_go(q, ndf, 0)
                if cast(s32)(y > 0) == 0 {
                    break
                }
                x = (pt(q, ndf, 0, 0) - P / 2) / y
                if IsFinite(x) == 0 {
                    break
                }
                if cast(s32)(Fabs(x) > (1e-14 * Fabs(q))) == 0 {
                    break
                }
                q += x * (1 + (x * q * (ndf + 1)) / (2 * (q * q + ndf)))
                it_value += 1
            }
        }
    }
    if neg != 0 {
        q = 0 - q
    }
    return q
}

pbeta_smalla :: (x: float64, a: float64, b: float64, lower_tail: s32, log_p: s32) -> float64 {
    r: float64 = 0
    if x > 0.5 {
        olda: float64 = a
        a = b
        b = olda
        x = 1 - x
        lower_tail = cast(s32)(lower_tail == 0)
    }
    r = (a + b + 0.5) * Log1pmx(a / (1 + b)) + (a * (a - 0.5)) / (1 + b) + lfbaccdif(a, b)
    r += a * Log((1 + b) * x) - Lgamma1p(a)
    if lower_tail != 0 {
        if log_p != 0 {
            return r + Log1p(-compbfunc(x, a, b)) + Log(b / (a + b))
        } else {
            return Exp(r) * (1 - compbfunc(x, a, b)) * (b / (a + b))
        }
    } else {
        if log_p != 0 {
            return swap_log_tail(r + Log1p(-compbfunc(x, a, b)) + Log(b / (a + b)))
        } else {
            r = -Expm1(r)
            r += compbfunc(x, a, b) * (1 - r)
            r += (a / (a + b)) * (1 - r)
            return r
        }
    }
}

binomial :: (ii: float64, jj: float64, pp: float64, qq: float64, diffFromMean: float64, lower_tail: s32, log_p: s32) -> float64 {
    mij: float64 = Fmin(ii, jj)
    if mij > 500 && Fabs(diffFromMean) < (0.01 * mij) {
        return binApprox(jj - 1, ii, diffFromMean, lower_tail, log_p)
    }
    return binomialcf(ii, jj, pp, qq, diffFromMean, lower_tail, log_p)
}

binomialcf :: (ii: float64, jj: float64, pp: float64, qq: float64, diffFromMean: float64, lower_tail: s32, log_p: s32) -> float64 {
    sumAlways: float64 = 0
    sumFactor: float64 = 6
    cfSmall: float64 = 1.0e-15
    prob: float64 = 0
    p: float64 = 0
    q: float64 = 0
    a1: float64 = 0
    a2: float64 = 0
    b1: float64 = 0
    b2: float64 = 0
    c1: float64 = 0
    c2: float64 = 0
    c3: float64 = 0
    c4: float64 = 0
    n1: float64 = 0
    q1: float64 = 0
    dfm: float64 = 0
    i: float64 = 0
    j: float64 = 0
    ni: float64 = 0
    nj: float64 = 0
    numb: float64 = 0
    ip1: float64 = 0
    swapped: s32 = 0
    ip1 = ii + 1
    if ii > -1 && (jj <= 0 || pp == 0) {
        return ifx lower_tail != 0 then 1.0 else 0.0
    } else if ii > -1 && ii < 0 {
        f: float64 = 0
        ii = -ii
        ip1 = ii
        f = ii / ((ii + jj) * pp)
        prob = binomialTerm(ii, jj, pp, qq, (ii + jj) * pp - ii, log_p)
        prob = ifx log_p != 0 then (prob + Log(f)) else (prob * f)
        ii -= 1
        diffFromMean = (ii + jj) * pp - ii
    } else {
        prob = binomialTerm(ii, jj, pp, qq, diffFromMean, log_p)
    }
    n1 = ii + 3 + jj
    if ii < 0 {
        swapped = 0
    } else if pp > qq {
        swapped = cast(s32)((n1 * qq) >= (jj + 1))
    } else {
        swapped = cast(s32)((n1 * pp) <= (ii + 2))
    }
    if prob == 0.0 {
        if swapped == cast(s32)(lower_tail == 0) {
            return 0.0
        } else {
            return 1.0
        }
    }
    if swapped != 0 {
        j = ip1
        ip1 = jj
        i = jj - 1
        p = qq
        q = pp
        dfm = 1 - diffFromMean
    } else {
        i = ii
        j = jj
        p = pp
        q = qq
        dfm = diffFromMean
    }
    if i > sumAlways {
        numb = Floor(sumFactor * Sqrt(p + 0.5) * Exp(Log(n1 * p * q) / 3))
        numb = Floor(numb - dfm)
        if numb > i {
            numb = Floor(i)
        }
    } else {
        numb = Floor(i)
    }
    if numb < 0 {
        numb = 0
    }
    a1 = 0
    b1 = 1
    q1 = q + 1
    a2 = (i - numb) * q
    b2 = dfm + numb + 1
    c1 = 0
    c2 = a2
    c4 = b2
    while Fabs(a2 * b1 - a1 * b2) > Fabs(cfSmall * b1 * b2) {
        c1 += 1
        c2 -= q
        c3 = c1 * c2
        c4 += q1
        a1 = c4 * a2 + c3 * a1
        b1 = c4 * b2 + c3 * b1
        c1 += 1
        c2 -= q
        c3 = c1 * c2
        c4 += q1
        a2 = c4 * a1 + c3 * a2
        b2 = c4 * b1 + c3 * b2
        if Fabs(b2) > 115792089237316195423570985008687907853269984665640564039457584007913129639936.0 {
            a1 *= 1 / 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
            b1 *= 1 / 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
            a2 *= 1 / 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
            b2 *= 1 / 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
        } else if Fabs(b2) < (1 / 115792089237316195423570985008687907853269984665640564039457584007913129639936.0) {
            a1 *= 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
            b1 *= 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
            a2 *= 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
            b2 *= 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
        }
    }
    a1 = a2 / b2
    ni = (i - numb + 1) * q
    nj = (j + numb) * p
    while numb > 0 {
        a1 = (1 + a1) * (ni / nj)
        ni = ni + q
        nj = nj - p
        numb -= 1
    }
    prob = ifx log_p != 0 then (prob + Log1p(a1)) else (prob * (1 + a1))
    if swapped != 0 {
        if log_p != 0 {
            prob += Log((ip1 * q) / nj)
        } else {
            prob *= (ip1 * q) / nj
        }
    }
    if swapped == cast(s32)(lower_tail == 0) {
        return prob
    } else {
        return ifx log_p != 0 then swap_log_tail(prob) else (1 - prob)
    }
}

binApprox :: (a: float64, b: float64, diffFromMean: float64, lower_tail: s32, log_p: s32) -> float64 {
    pq1: float64 = 0
    res: float64 = 0
    t: float64 = 0
    ib05: float64 = 0
    ib15: float64 = 0
    ib25: float64 = 0
    ib35: float64 = 0
    ib3: float64 = 0
    elfb: float64 = 0
    coef15: float64 = 0
    coef25: float64 = 0
    coef35: float64 = 0
    approxtdistDens: float64 = 0
    n: float64 = a + b
    n1: float64 = n + 1
    lvv: float64 = b - n * diffFromMean
    lval: float64 = (a * Log1pmx(lvv / (a * n1)) + b * Log1pmx(0 - lvv / (b * n1))) / n
    tp: float64 = -Expm1(lval)
    mfac: float64 = n1 * tp
    ib2: float64 = 1 + mfac
    t1: float64 = (n + 2) * tp
    mfac = 2 * mfac
    ib3 = ib2 + mfac * t1
    ib05 = tdistexp(tp, 1 - tp, n1 * lval, 2 * n1, log_p, *approxtdistDens)
    ib15 = Sqrt(mfac)
    mfac = t1 * (2.0 / 3)
    ib25 = 1 + mfac
    ib35 = ib25 + mfac * (n + 3) * tp * (2.0 / 5)
    pq1 = (n * n) / (a * b)
    res = ((ib2 * (1 + 2 * pq1)) / 135 - (2 * ib3 * ((2 * pq1 - 43) * pq1 - 22)) / (2835 * (n + 3))) / (n + 2)
    res = ((1.0 / 3 - res) * 2 * Sqrt(pq1 / n1) * (a - b)) / n
    if lvv > 0 {
        res = -res
        lower_tail = cast(s32)(lower_tail == 0)
    }
    n1 = (n + 1.5) * (n + 2.5)
    coef15 = (-17 + 2 * pq1) / (24 * (n + 1.5))
    coef25 = (-503 + 4 * pq1 * (19 + pq1)) / (1152 * n1)
    coef35 = (-315733 + pq1 * (53310 + pq1 * (8196 - 1112 * pq1))) / (414720 * n1 * (n + 3.5))
    elfb = coef35 + coef25 + coef15
    res += ib15 * (coef35 * ib35 + coef25 * ib25 + coef15)
    t = ifx log_p != 0 then logspace_signed_add(ib05, Log(Fabs(res)) + approxtdistDens - Log1p(elfb), ifx res >= 0 then 1 else 0) else (ib05 + (res * approxtdistDens) / (1 + elfb))
    return ifx lower_tail != 0 then t else (ifx log_p != 0 then swap_log_tail(t) else (1 - t))
}

pbeta :: (x: float64, a: float64, b: float64, lower_tail: s32, log_p: s32) -> float64 {
    am1: float64 = 0
    if x != x || a != a || b != b {
        return x + a + b
    }
    if x <= 0 {
        return ifx lower_tail != 0 then 0.0 else 1.0
    }
    if x >= 1 {
        return ifx lower_tail != 0 then 1.0 else 0.0
    }
    if a < 1 && (b < 1 || ((1 + b) * x) <= 1) {
        return pbeta_smalla(x, a, b, lower_tail, log_p)
    }
    if b < 1 && ((1 + a) * (1 - x)) <= 1 {
        return pbeta_smalla(1 - x, b, a, cast(s32)(lower_tail == 0), log_p)
    }
    if a < 1 {
        return binomial(-a, b, x, 1 - x, 0, cast(s32)(lower_tail == 0), log_p)
    }
    if b < 1 {
        return binomial(-b, a, 1 - x, x, 0, lower_tail, log_p)
    }
    am1 = a - 1
    return binomial(am1, b, x, 1 - x, (am1 + b) * x - am1, cast(s32)(lower_tail == 0), log_p)
}

abramowitz_stegun :: (p: float64, a: float64, b: float64, lower_tail: s32, log_p: s32) -> float64 {
    yp: float64 = qnorm(p, 0, 1, ifx lower_tail == 0 then 1 else 0, log_p)
    ta: float64 = 1 / (2 * a - 1)
    tb: float64 = 1 / (2 * b - 1)
    h: float64 = 2 / (ta + tb)
    l: float64 = (yp * yp - 3) / 6
    w: float64 = (yp * Sqrt(h + l)) / h - (tb - ta) * (l + (5 - 4 / h) / 6)
    return a / (a + b * Exp(2 * w))
}

qbeta :: (p: float64, pin: float64, qin: float64, lower_tail: s32, log_p: s32) -> float64 {
    x0: float64 = 0
    q: float64 = 0
    shape: [2]float64
    S: float64 = pin + qin
    if S != S || p != p {
        return S + p
    }
    if pin < 0 || qin < 0 {
    }
    if log_p == 0 && p > 0.9 {
        p = 1 - p
        lower_tail = cast(s32)(lower_tail == 0)
    }
    if pin >= 1 && qin >= 1 {
        x0 = abramowitz_stegun(p, pin, qin, lower_tail, log_p)
    } else {
        phalf: float64 = pbeta(0.5, pin, qin, lower_tail, log_p)
        lb: float64 = lbeta_go(pin, qin)
        if cast(s32)(lower_tail == 0) == cast(s32)(p > phalf) {
            x0 = Exp((Log(pin) + (ifx lower_tail != 0 then Log(p) else Log1p(0 - p)) + 0 * p + lb) / pin)
        } else {
            x0 = -Expm1((Log(qin) + (ifx lower_tail != 0 then Log1p(0 - p) else Log(p)) + 0 * p + lb) / qin)
        }
    }
    shape[0] = pin
    shape[1] = qin
    q = PFuncInverter(1, p, *shape[0], lower_tail, log_p, 0, 1, x0)
    return q
}

pd_lower_cf :: (y: float64, d: float64) -> float64 {
    f: float64 = 0
    of: float64 = 0
    f0: float64 = 0
    i: float64 = 0
    c2: float64 = 0
    c3: float64 = 0
    c4: float64 = 0
    a1: float64 = 0
    b1: float64 = 0
    a2: float64 = 0
    b2: float64 = 0
    scalefactor: float64 = 1.157920892373162e+77
    f = 0
    of = -1
    if (0 - (0.693147180559945309417232121458 * 1024) / 2.2204460492503131e-16) < y && y <= 0 {
        lf: float64 = Lgamma(y + d) - Lgamma(d) - y * Log(d)
        if lf >= -0.693147180559945309417232121458 {
            f = 1 - Exp(0 - d - y + lf * 0.5)
        } else {
            f = Exp(0 - d - y + lf * 0.5)
            f = 0 - f
        }
        return f
    }
    f0 = y / d
    if f0 > 1 {
        f0 = 1
    }
    c2 = y
    c4 = d
    a1 = 0
    b1 = 1
    a2 = y
    b2 = d
    while b2 > scalefactor {
        a1 /= scalefactor
        b1 /= scalefactor
        a2 /= scalefactor
        b2 /= scalefactor
        if b2 <= scalefactor {
            break
        }
    }
    i = 0
    of = -1
    while i < 200000 {
        i += 1
        c2 -= 1
        c3 = i * c2
        c4 += 2
        a1 = c4 * a2 + c3 * a1
        b1 = c4 * b2 + c3 * b1
        i += 1
        c2 -= 1
        c3 = i * c2
        c4 += 2
        a2 = c4 * a1 + c3 * a2
        b2 = c4 * b1 + c3 * b2
        if b2 > scalefactor {
            a1 /= scalefactor
            b1 /= scalefactor
            a2 /= scalefactor
            b2 /= scalefactor
        }
        if b2 != 0 {
            f = a2 / b2
            if Fabs(f - of) <= (2.2204460492503131e-16 * Fmax(f0, Fabs(f))) {
                return f
            }
            of = f
        }
    }
    return f
}

pd_upper_series :: (x: float64, y_in: float64, log_p: s32) -> float64 {
    y: float64 = y_in
    term: float64 = x / y
    sum: float64 = term
    while true {
        y += 1
        term *= x / y
        sum += term
        if cast(s32)(term > (sum * 2.2204460492503131e-16)) == 0 {
            break
        }
    }
    if log_p != 0 {
        return Log(sum)
    }
    return sum
}

pd_upper_gamma :: (y: float64, z: float64) -> float64 {
    z2: float64 = z * z
    term: float64 = 0
    sum: float64 = 0
    i: s32 = 0
    term = 1
    sum = 1
    i = 1
    while i < 100 {
        term *= z2 / (y + cast(float64)i)
        sum += term
        if term < (sum * 2.2204460492503131e-16) {
            break
        }
        i += 1
    }
    return 1 / y + ((z / y) / y) * (1 + y * sum)
}

dpois_wrap :: (x_plus_1: float64, lambda: float64, give_log: s32) -> float64 {
    if IsFinite(lambda) == 0 {
        return 0.0
    }
    if x_plus_1 > 1 {
        return dpois_raw(x_plus_1 - 1, lambda, give_log)
    }
    if lambda > (Fabs(x_plus_1 - 1) * 3.196577e18) {
        return Exp(0 - lambda - Lgamma(x_plus_1))
    }
    d: float64 = dpois_raw(x_plus_1, lambda, give_log)
    if give_log != 0 {
        return d + Log(x_plus_1 / lambda)
    }
    return d * (x_plus_1 / lambda)
}

PFuncInverter :: (which: s32, p: float64, shape: *float64, lower_tail: s32, log_p: s32, xlow_in: float64, xhigh_in: float64, x0_in: float64) -> float64 {
    have_xlow: s32 = ifx IsFinite(xlow_in) != 0 then 1 else 0
    have_xhigh: s32 = ifx IsFinite(xhigh_in) != 0 then 1 else 0
    xlow: float64 = xlow_in
    xhigh: float64 = xhigh_in
    exlow: float64 = 0
    exhigh: float64 = 0
    x: float64 = 0
    e: float64 = 0
    px: float64 = 0
    i: s32 = 0
    newton: s32 = 0
    dt_0: float64 = ifx lower_tail != 0 then 0.0 else 1.0
    dt_1: float64 = ifx lower_tail != 0 then 1.0 else 0.0
    if log_p != 0 {
        if p > 0 {
            return 0.0 / 0.0
        }
    } else {
        if p < 0 || p > 1 {
            return 0.0 / 0.0
        }
    }
    if p == dt_0 {
        return xlow
    }
    if p == dt_1 {
        return xhigh
    }
    exlow = dt_0 - p
    exhigh = dt_1 - p
    if lower_tail == 0 {
        exlow = 0 - exlow
        exhigh = 0 - exhigh
    }
    i = 0
    while i < 100 {
        if i == 0 {
            if x0_in > xlow && x0_in < xhigh {
                x = x0_in
            } else if have_xlow != 0 && x0_in <= xlow {
                x = ifx have_xhigh != 0 then (xlow + (xhigh - xlow) / 100) else (xlow + 1)
            } else if have_xhigh != 0 && x0_in >= xhigh {
                x = ifx have_xhigh != 0 then (xhigh - (xhigh - xlow) / 100) else (xhigh - 1)
            } else {
                x = 0
            }
        } else if i == 1 {
            if have_xlow != 0 && have_xhigh != 0 {
                x = (xlow + xhigh) / 2
            } else if have_xlow != 0 {
                x = xlow * 1.1
            } else {
                x = xhigh / 1.1
            }
        } else if have_xlow != 0 && have_xhigh != 0 {
            m8: s32 = i % 8
            if m8 == 0 {
                x = xhigh - (xhigh - xlow) * (exhigh / (exhigh - exlow))
            } else if m8 == 4 {
                if xlow >= 0 && xhigh >= 0 {
                    xl2: float64 = xlow
                    if xl2 < 2.2250738585072014e-308 {
                        xl2 = 2.2250738585072014e-308
                    }
                    x = Sqrt(xl2) * Sqrt(xhigh)
                } else if xlow <= 0 && xhigh <= 0 {
                    xh2: float64 = 0 - xhigh
                    if xh2 < 2.2250738585072014e-308 {
                        xh2 = 2.2250738585072014e-308
                    }
                    x = 0 - Sqrt(0 - xlow) * Sqrt(xh2)
                } else {
                    x = 0
                }
            } else if m8 == 2 {
                x = (xhigh + 1000 * xlow) / 1001
            } else if m8 == 6 {
                x = (1000 * xhigh + xlow) / 1001
            } else {
                x = (xhigh + xlow) / 2
            }
        } else if have_xlow != 0 {
            x = ifx xlow < 1 then 1 else (cast(float64)(2 * i) * xlow)
        } else {
            x = ifx xhigh > -1 then (-1) else (cast(float64)(2 * i) * xhigh)
        }
        newton = 1
        while newton != 0 {
            newton = 0
            if (have_xlow != 0 && x <= xlow) || (have_xhigh != 0 && x >= xhigh) {
                break
            }
            if which == 1 {
                px = pbeta(x, shape[0], shape[1], lower_tail, log_p)
            } else if which == 2 {
                px = PtukeyGo(x, shape[0], shape[1], shape[2], lower_tail, log_p)
            } else {
                px = pgamma(x, shape[0], 1, lower_tail, log_p)
            }
            e = px - p
            if lower_tail == 0 {
                e = 0 - e
            }
            if e == 0 {
                i = 100
            } else if e > 0 {
                xhigh = x
                exhigh = e
                have_xhigh = 1
            } else if e < 0 {
                xlow = x
                exlow = e
                have_xlow = 1
            }
            if i >= 100 {
                break
            }
            if have_xlow != 0 && have_xhigh != 0 {
                prec: float64 = (xhigh - xlow) / (Fabs(xlow) + Fabs(xhigh))
                if prec < (2.2204460492503131e-16 * 4) {
                    x = (xhigh + xlow) / 2
                    if which == 1 {
                        e = pbeta(x, shape[0], shape[1], lower_tail, log_p) - p
                    } else if which == 2 {
                        e = PtukeyGo(x, shape[0], shape[1], shape[2], lower_tail, log_p) - p
                    } else {
                        e = pgamma(x, shape[0], 1, lower_tail, log_p) - p
                    }
                    if lower_tail == 0 {
                        e = 0 - e
                    }
                    i = 100
                    break
                }
                if (i % 3) < 2 && (i == 0 || prec < 0.05) {
                    d2: float64 = 0
                    if which == 2 {
                        d2 = 0
                    } else if which == 1 {
                        d2 = dbeta(x, shape[0], shape[1], 0)
                    } else {
                        d2 = dgamma_go(x, shape[0], 1, 0)
                    }
                    if d2 != 0 {
                        x = x - (e / d2) * 1.000001
                        if x > xlow && x < xhigh {
                            i += 1
                            newton = 1
                        }
                    }
                }
            }
        }
        if i >= 100 {
            break
        }
        i += 1
    }
    if have_xhigh != 0 && Fabs(e) > exhigh {
        e = exhigh
        x = xhigh
    }
    if have_xlow != 0 && Fabs(e) > (0 - exlow) {
        e = exlow
        x = xlow
    }
    return x
}

dbeta :: (x: float64, a: float64, b: float64, give_log: s32) -> float64 {
    if x < 0 || x > 1 || a <= 0 || b <= 0 {
        return 0.0
    }
    l: float64 = (a - 1) * Log(x) + (b - 1) * Log1p(0 - x) - lbeta_go(a, b)
    if give_log != 0 {
        return l
    }
    return Exp(l)
}

pbeta1_go :: (x: float64, shape: *float64, lower_tail: s32, log_p: s32) -> float64 {
    return pbeta(x, shape[0], shape[1], lower_tail, log_p)
}

pd_lower_series :: (lambda: float64, y_in: float64) -> float64 {
    term: float64 = 1
    sum: float64 = 0
    y: float64 = y_in
    while y >= 1 && term > (sum * 2.2204460492503131e-16) {
        term *= y / lambda
        sum += term
        y -= 1
    }
    if y != Floor(y) {
        f: float64 = pd_lower_cf(y, lambda + 1 - y)
        sum += term * f
    }
    return sum
}

ppois_asymp :: (x: float64, lambda: float64, lower_tail: s32, log_p: s32) -> float64 {
    coefs_a: [8]float64 = .[1e-99, 0.666666666666666666666666666666, 0 - 4 / 135, 8 / 2835, 16 / 8505, 0 - 8992 / 12629925, 0 - 334144 / 492567075, 698752 / 1477701225]
    coefs_b: [8]float64 = .[1e-99, 1 / 12, 1 / 288, 0 - 139 / 51840, 0 - 571 / 2488320, 163879 / 209018880, 5246819 / 75246796800, 0 - 534703531 / 902961561600]
    elfb: float64 = 0
    elfb_term: float64 = 0
    res12: float64 = 0
    res1_term: float64 = 0
    res1_ig: float64 = 0
    res2_term: float64 = 0
    res2_ig: float64 = 0
    dfm: float64 = 0
    pt_: float64 = 0
    s2pt: float64 = 0
    f: float64 = 0
    np: float64 = 0
    sum: float64 = 0
    ib: float64 = 0
    dfm = lambda - x
    pt_ = x / lambda
    s2pt = Sqrt(2 * (lambda - x - x * Log(pt_)))
    np = 1 / (4 * lambda)
    f = dfm - s2pt
    elfb = 0
    elfb_term = 0
    ib = 1
    while ib < 8 {
        elfb_term = f * elfb_term + coefs_b[TruncateToS32(ib)]
        elfb = f * elfb + elfb_term
        ib += 1
    }
    elfb *= np
    res12 = 0
    res1_term = 1
    res1_ig = 1
    res2_term = 0.666666666666666666666666666666
    res2_ig = 0.666666666666666666666666666666
    ib = 2
    while ib < 8 {
        res1_term *= s2pt / (2 * ib - 1)
        res1_ig += res1_term
        res2_term *= s2pt / (2 * ib)
        res2_ig += res2_term
        ib += 1
    }
    res12 = res1_ig * 0.398942280401432677939946059934 * Exp(0 - (s2pt * s2pt) / 2) + (res2_ig * (1 - 0.5)) / s2pt
    sum = elfb * res12
    if log_p != 0 {
        return Log(0.5) + Log(sum)
    }
    if lower_tail != 0 {
        return 0.5 * sum
    }
    return 1 - 0.5 * sum
}

lgamma1p_raw :: (a: float64) -> float64 {
    return Lgamma(1 + a)
}

pgamma_smallx :: (x: float64, alph: float64, lower_tail: s32, log_p: s32) -> float64 {
    sum: float64 = 0
    c: float64 = alph
    n: float64 = 0
    term: float64 = 0
    while true {
        n += 1
        c *= 0 - x / n
        term = c / (alph + n)
        sum += term
        if cast(s32)(Fabs(term) > (2.2204460492503131e-16 * Fabs(sum))) == 0 {
            break
        }
    }
    if lower_tail != 0 {
        f1: float64 = 1 + sum
        f2: float64 = 0
        if alph > 1 {
            f2 = dpois_raw(alph, x, 0)
            f2 = f2 * Exp(x)
        } else {
            f2 = Pow(x, alph) / Exp(lgamma1p_raw(alph))
        }
        return f1 * f2
    }
    lf2: float64 = alph * Log(x) - lgamma1p_raw(alph)
    f1m1: float64 = sum
    f2m1: float64 = Expm1(lf2)
    return 0 - (f1m1 + f2m1 + f1m1 * f2m1)
}

pgamma_raw :: (x: float64, alph: float64, lower_tail: s32, log_p: s32) -> float64 {
    res: float64 = 0
    if x <= 0 {
        return ifx lower_tail != 0 then 0.0 else 1.0
    }
    if x >= (1e308 * 10) {
        return ifx lower_tail != 0 then 1.0 else 0.0
    }
    if x < 1 {
        res = pgamma_smallx(x, alph, lower_tail, log_p)
    } else if x <= (alph - 1) && x < (0.8 * (alph + 50)) {
        sum: float64 = pd_upper_series(x, alph, log_p)
        d: float64 = dpois_wrap(alph, x, log_p)
        if lower_tail == 0 {
            res = ifx log_p != 0 then swap_log_tail(d + sum) else (1 - d * sum)
        } else {
            res = ifx log_p != 0 then (sum + d) else (sum * d)
        }
    } else if (alph - 1) < x && alph < (0.8 * (x + 50)) {
        sum: float64 = 0
        d: float64 = dpois_wrap(alph, x, log_p)
        if alph < 1 {
            if (x * 2.2204460492503131e-16) > (1 - alph) {
                sum = 1.0
            } else {
                f: float64 = (pd_lower_cf(alph, x - (alph - 1)) * x) / alph
                sum = ifx log_p != 0 then Log(f) else f
            }
        } else {
            sum = pd_lower_series(x, alph - 1)
            sum = ifx log_p != 0 then Log1p(sum) else (1 + sum)
        }
        if lower_tail == 0 {
            res = ifx log_p != 0 then (sum + d) else (sum * d)
        } else {
            res = ifx log_p != 0 then swap_log_tail(d + sum) else (1 - d * sum)
        }
    } else {
        res = ppois_asymp(alph - 1, x, cast(s32)(lower_tail == 0), log_p)
    }
    if log_p == 0 && res < (2.2250738585072014e-308 / 2.2204460492503131e-16) {
        return Exp(pgamma_raw(x, alph, lower_tail, 1))
    } else {
        return res
    }
}

pgamma :: (x: float64, alph: float64, scale: float64, lower_tail: s32, log_p: s32) -> float64 {
    if x != x || alph != alph || scale != scale {
        return x + alph + scale
    }
    if alph < 0 || scale <= 0 {
        return 0.0 / 0.0
    }
    x /= scale
    if x != x {
        return x
    }
    if alph == 0 {
        return ifx x <= 0 then (ifx lower_tail != 0 then 0.0 else 1.0) else (ifx lower_tail != 0 then 1.0 else 0.0)
    }
    return pgamma_raw(x, alph, lower_tail, log_p)
}

qgamma :: (p: float64, alpha: float64, scale: float64, lower_tail: s32, log_p: s32) -> float64 {
    res1: float64 = 0
    x0: float64 = 0
    v: float64 = 0
    if p != p || alpha != alpha || scale != scale {
        return p + alpha + scale
    }
    if alpha <= 0 {
    }
    if log_p == 0 && p > 0.9 {
        p = 1 - p
        lower_tail = cast(s32)(lower_tail == 0)
    }
    v = 2 * alpha
    if v < (-1.24 * (ifx lower_tail != 0 then Log(p) else Log1p(0 - p)) + 0 * p) {
        x0 = Pow(p * alpha * Exp(Lgamma(alpha) + alpha * 0.693147180559945309417232121458), 1 / alpha) / 2
    } else {
        x1: float64 = qnorm(p, 0, 1, lower_tail, log_p)
        p1: float64 = 0.222222 / v
        x0 = (v * Pow(x1 * Sqrt(p1) + 1 - p1, 3)) / 2
    }
    res1 = PFuncInverter(0, p, *alpha, lower_tail, log_p, 0, 1e308 * 10, x0)
    return res1 * scale
}

pchisq :: (x: float64, df: float64, lower_tail: s32, log_p: s32) -> float64 {
    return pgamma(x, df / 2.0, 2.0, lower_tail, log_p)
}

qchisq :: (p: float64, df: float64, lower_tail: s32, log_p: s32) -> float64 {
    return qgamma(p, 0.5 * df, 2.0, lower_tail, log_p)
}

pf :: (x: float64, n1: float64, n2: float64, lower_tail: s32, log_p: s32) -> float64 {
    if x != x || n1 != n1 || n2 != n2 {
        return x + n2 + n1
    }
    if n1 <= 0 || n2 <= 0 {
    }
    if x <= 0 {
        return ifx lower_tail != 0 then 0.0 else 1.0
    }
    if (n1 * x) > n2 {
        return pbeta(n2 / (n2 + n1 * x), n2 / 2, n1 / 2, cast(s32)(lower_tail == 0), log_p)
    } else {
        return pbeta((n1 * x) / (n2 + n1 * x), n1 / 2, n2 / 2, lower_tail, log_p)
    }
}

qf :: (p: float64, n1: float64, n2: float64, lower_tail: s32, log_p: s32) -> float64 {
    q: float64 = 0
    qc: float64 = 0
    if p != p || n1 != n1 || n2 != n2 {
        return p + n1 + n2
    }
    if n1 <= 0 || n2 <= 0 {
    }
    if p == (ifx lower_tail != 0 then 0.0 else 1.0) {
        return 0
    }
    q = qbeta(p, n2 / 2, n1 / 2, cast(s32)(lower_tail == 0), log_p)
    if q < 0.9 {
        qc = 1 - q
    } else {
        qc = qbeta(p, n1 / 2, n2 / 2, lower_tail, log_p)
    }
    return (qc / q) * (n2 / n1)
}

ppois :: (x: float64, lambda: float64, lower_tail: s32, log_p: s32) -> float64 {
    if x != x || lambda != lambda {
        return x + lambda
    }
    if lambda < 0 {
        return 0.0 / 0.0
    }
    if x < 0 {
        return ifx lower_tail != 0 then 0.0 else 1.0
    }
    if lambda == 0 {
        return ifx lower_tail != 0 then 1.0 else 0.0
    }
    if IsFinite(x) == 0 {
        return ifx lower_tail != 0 then 1.0 else 0.0
    }
    x = Floor(x)
    return pgamma(lambda, x + 1, 1.0, cast(s32)(lower_tail == 0), log_p)
}

dpois :: (x: float64, lambda: float64, give_log: s32) -> float64 {
    if x != x || lambda != lambda {
        return x + lambda
    }
    if lambda < 0 {
        return 0.0 / 0.0
    }
    if x < 0 || IsFinite(x) == 0 {
        return 0.0
    }
    x = Round(x)
    return dpois_raw(x, lambda, give_log)
}

pbinom :: (x: float64, n: float64, p: float64, lower_tail: s32, log_p: s32) -> float64 {
    if x != x || n != n || p != p {
        return x + n + p
    }
    if IsFinite(n) == 0 || IsFinite(p) == 0 {
        return 0.0 / 0.0
    }
    if n != Floor(n) {
        return ifx lower_tail != 0 then 0.0 else 1.0
    }
    n = Round(n)
    if n < 0 || p < 0 || p > 1 {
        return 0.0 / 0.0
    }
    if x < 0 {
        return ifx lower_tail != 0 then 0.0 else 1.0
    }
    x = Floor(x)
    if n <= x {
        return ifx lower_tail != 0 then 1.0 else 0.0
    }
    return pbeta(p, x + 1, n - x, cast(s32)(lower_tail == 0), log_p)
}

pbinom2 :: (x0: float64, x1: float64, n: float64, p: float64) -> float64 {
    Pl: float64 = 0
    if x0 > n || x1 < 0 || x0 > x1 {
        return 0
    }
    if x0 == x1 {
        return dbinom(x0, n, p, 0)
    }
    if x0 <= 0 {
        return pbinom(x1, n, p, 1, 0)
    }
    if x1 >= n {
        return pbinom(x0 - 1, n, p, 0, 0)
    }
    Pl = pbinom(x0 - 1, n, p, 1, 0)
    if Pl > 0.75 {
        PlC: float64 = pbinom(x0 - 1, n, p, 0, 0)
        PrC: float64 = pbinom(x1, n, p, 0, 0)
        return PlC - PrC
    } else {
        Pr: float64 = pbinom(x1, n, p, 1, 0)
        return Pr - Pl
    }
}

qbinom :: (p: float64, n: float64, pr: float64, lower_tail: s32, log_p: s32) -> float64 {
    q: float64 = 0
    mu: float64 = 0
    sigma: float64 = 0
    gamma: float64 = 0
    z: float64 = 0
    y: float64 = 0
    if p != p || n != n || pr != pr {
        return p + n + pr
    }
    if IsFinite(n) == 0 || IsFinite(pr) == 0 {
        return 0.0 / 0.0
    }
    if IsFinite(p) == 0 && log_p == 0 {
        return 0.0 / 0.0
    }
    if n != Floor(n + 0.5) {
        return 0.0 / 0.0
    }
    if pr < 0 || pr > 1 || n < 0 {
        return 0.0 / 0.0
    }
    if log_p != 0 {
        if p > 0 {
            return 0.0 / 0.0
        }
        if p == 0 {
            return ifx lower_tail != 0 then n else 0
        }
        if p == (-1e308 * 10) {
            return ifx lower_tail != 0 then 0 else n
        }
    } else {
        if p < 0 || p > 1 {
            return 0.0 / 0.0
        }
        if p == 0 {
            return ifx lower_tail != 0 then 0 else n
        }
        if p == 1 {
            return ifx lower_tail != 0 then n else 0
        }
    }
    if pr == 0 || n == 0 {
        return 0.0
    }
    q = 1 - pr
    if q == 0 {
        return n
    }
    mu = n * pr
    sigma = Sqrt(n * pr * q)
    gamma = (q - pr) / sigma
    if lower_tail == 0 || log_p != 0 {
        p = p
        if p == 0 {
            return 0.0
        }
        if p == 1 {
            return n
        }
    }
    if (p + 1.01 * 2.2204460492503131e-16) >= 1 {
        return n
    }
    z = qnorm(p, 0.0, 1.0, 1, 0)
    y = Floor(mu + sigma * (z + (gamma * (z * z - 1)) / 6) + 0.5)
    if y > n {
        y = n
    }
    z = pbinom(y, n, pr, 1, 0)
    p *= 1 - 64 * 2.2204460492503131e-16
    if n < 1e5 {
        return do_search(y, *z, p, n, pr, 1)
    }
    incr: float64 = Floor(n * 0.001)
    oldincr: float64
    while true {
        oldincr = incr
        y = do_search(y, *z, p, n, pr, incr)
        incr = Fmax(1, Floor(incr / 100))
        if cast(s32)(oldincr > 1 && incr > (n * 1e-15)) == 0 {
            break
        }
    }
    return y
}

pnbinom :: (x: float64, size: float64, prob: float64, lower_tail: s32, log_p: s32) -> float64 {
    if x != x || size != size || prob != prob {
        return x + size + prob
    }
    if IsFinite(size) == 0 || IsFinite(prob) == 0 {
        return 0.0 / 0.0
    }
    if size < 0 || prob <= 0 || prob > 1 {
        return 0.0 / 0.0
    }
    if size == 0 {
        return ifx x >= 0 then (ifx lower_tail != 0 then 1.0 else 0.0) else (ifx lower_tail != 0 then 0.0 else 1.0)
    }
    if x < 0 {
        return ifx lower_tail != 0 then 0.0 else 1.0
    }
    if IsFinite(x) == 0 {
        return ifx lower_tail != 0 then 1.0 else 0.0
    }
    x = Floor(x)
    return pbeta(prob, size, x + 1, lower_tail, log_p)
}

dnbinom :: (x: float64, size: float64, prob: float64, give_log: s32) -> float64 {
    ans: float64 = 0
    p: float64 = 0
    if x != x || size != size || prob != prob {
        return x + size + prob
    }
    if prob <= 0 || prob > 1 || size < 0 {
        return 0.0 / 0.0
    }
    if x < 0 || IsFinite(x) == 0 {
        return 0.0
    }
    if x == 0 && size == 0 {
        return 1.0
    }
    x = Round(x)
    if IsFinite(size) == 0 {
        size = 1.7976931348623157e308
    }
    ans = dbinom_raw(size, x + size, prob, 1 - prob, give_log)
    p = size / (size + x)
    return ifx give_log != 0 then (Log(p) + ans) else (p * ans)
}

pdhyper :: (x_in: float64, NR: float64, NB: float64, n: float64, log_p: s32) -> float64 {
    sum: float64 = 0
    term: float64 = 1
    x: float64 = x_in
    while x > 0 && term >= (2.2204460492503131e-16 * sum) {
        term *= ((x * (NB - n + x)) / (n + 1 - x)) / (NR + 1 - x)
        sum += term
        x -= 1
    }
    if log_p != 0 {
        return Log1p(sum)
    }
    return 1 + sum
}

phyper :: (x: float64, NR: float64, NB: float64, n: float64, lower_tail: s32, log_p: s32) -> float64 {
    d: float64 = 0
    pd: float64 = 0
    if x != x || NR != NR || NB != NB || n != n {
        return x + NR + NB + n
    }
    x = Floor(x)
    NR = Round(NR)
    NB = Round(NB)
    n = Round(n)
    if NR < 0 || NB < 0 || IsFinite(NR + NB) == 0 || n < 0 || n > (NR + NB) {
        return 0.0 / 0.0
    }
    if (x * (NR + NB)) > (n * NR) {
        oldNB: float64 = NB
        NB = NR
        NR = oldNB
        x = n - x - 1
        lower_tail = cast(s32)(lower_tail == 0)
    }
    if x < 0 {
        return ifx lower_tail != 0 then 0.0 else 1.0
    }
    if x >= NR || x >= n {
        return ifx lower_tail != 0 then 1.0 else 0.0
    }
    d = dhyper(x, NR, NB, n, log_p)
    pd = pdhyper(x, NR, NB, n, log_p)
    return ifx log_p != 0 then (ifx lower_tail != 0 then (d + pd) else swap_log_tail(d + pd)) else (ifx lower_tail != 0 then (d * pd) else (1 - d * pd))
}

dhyper :: (x: float64, r: float64, b: float64, n: float64, give_log: s32) -> float64 {
    p: float64 = 0
    q: float64 = 0
    p1: float64 = 0
    p2: float64 = 0
    p3: float64 = 0
    if x != x || r != r || b != b || n != n {
        return x + r + b + n
    }
    if r < 0 || r != Floor(r) || b < 0 || b != Floor(b) || n < 0 || n != Floor(n) || n > (r + b) {
        return 0.0 / 0.0
    }
    if x < 0 {
        return 0.0
    }
    x = Round(x)
    r = Round(r)
    b = Round(b)
    n = Round(n)
    if n < x || r < x || (n - x) > b {
        return 0.0
    }
    if n == 0 {
        return ifx x == 0 then 1.0 else 0.0
    }
    p = n / (r + b)
    q = (r + b - n) / (r + b)
    p1 = dbinom_raw(x, r, p, q, give_log)
    p2 = dbinom_raw(n - x, b, p, q, give_log)
    p3 = dbinom_raw(n, r + b, p, q, give_log)
    return ifx give_log != 0 then (p1 + p2 - p3) else ((p1 * p2) / p3)
}

StatAggArgs :: (args: *Val, count: s32, marks: *s32, xs: *float64, ys: *float64, xn: *s32, yn: *s32, need_y: s32) -> s32 {
    list: NumList
    list2: NumList
    gx: s32 = 0
    gl: s32 = 0
    hx: s32 = 0
    hl: s32 = 0
    CollectNumbers(args, count, *list)
    xn[0] = list.count
    if need_y != 0 {
        if GroupBounds(marks, count, 0, *gx, *gl) == 0 {
            return 0
        }
        if GroupBounds(marks, count, 1, *hx, *hl) == 0 {
            return 0
        }
        gx2: s32 = 0
        gl2: s32 = 0
        gx2 = gx
        gl2 = gl
        xn[0] = CashList(*args[gx2], gl2, xs)
        yn[0] = CashList(*args[hx], hl, ys)
        if xn[0] != yn[0] {
            return 0
        }
    } else {
        i: s32 = 0
        while i < xn[0] {
            xs[i] = list.data[i]
            i += 1
        }
    }
    return 1
}

StatAverage :: (xs: *float64, n: s32) -> float64 {
    acc: Quad
    one: Quad = Quad.{1, 0}
    q: Quad
    i: s32 = 0
    while i < n {
        QuadInit(*q, xs[i])
        QuadAdd(*acc, *acc, *q)
        i += 1
    }
    qn: Quad
    QuadInit(*qn, cast(float64)n)
    QuadDiv(*acc, *acc, *qn)
    return QuadVal(*acc)
}

StatDevsq :: (xs: *float64, n: s32) -> float64 {
    sumh: float64 = 0
    suml: float64 = 0
    qavg: Quad
    acc: Quad
    q: Quad
    i: s32 = 0
    StatAccSum(xs, n, *sumh, *suml)
    QuadInit(*qavg, sumh)
    QuadInit(*q, suml)
    QuadAdd(*qavg, *qavg, *q)
    qn: Quad
    QuadInit(*qn, cast(float64)n)
    QuadDiv(*qavg, *qavg, *qn)
    i = 0
    while i < n {
        QuadInit(*q, xs[i])
        QuadSub(*q, *q, *qavg)
        QuadMul(*q, *q, *q)
        QuadAdd(*acc, *acc, *q)
        i += 1
    }
    return QuadVal(*acc)
}

StatAccSum :: (xs: *float64, n: s32, sumh: *float64, suml: *float64) {
    partials: [128]float64
    np: s32 = 0
    i: s32 = 0
    ui: s32 = 0
    uj: s32 = 0
    x: float64 = 0
    y: float64 = 0
    hi: float64 = 0
    lo: float64 = 0
    i = 0
    while i < n {
        x = xs[i]
        ui = 0
        uj = 0
        while uj < np {
            y = partials[uj]
            if Fabs(x) < Fabs(y) {
                t: float64 = x
                x = y
                y = t
            }
            hi = x + y
            lo = y - (hi - x)
            if lo != 0 {
                partials[ui] = lo
                ui += 1
            }
            x = hi
            uj += 1
        }
        np = ui
        if np < 128 {
            partials[np] = x
            np += 1
        }
        i += 1
    }
    total: float64 = 0
    i = 0
    while i < np {
        total += partials[i]
        i += 1
    }
    sumh[0] = total
    suml[0] = 0
}

CollectRangeGroup :: (args: *Val, count: s32, marks: *s32, out: *float64) -> s32 {
    gx: s32 = 0
    gl: s32 = 0
    if GroupBounds(marks, count, 0, *gx, *gl) != 0 {
        return CashList(*args[gx], gl, out)
    }
    return CashList(args, count, out)
}

FnCorrel :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    xs: [4096]float64
    ys: [4096]float64
    xn: s32 = 0
    yn: s32 = 0
    i: s32 = 0
    if StatAggArgs(args, count, marks, *xs[0], *ys[0], *xn, *yn, 1) == 0 {
        return ValError(ERR_VALUE)
    }
    ux: float64 = StatAverage(*xs[0], xn)
    uy: float64 = StatAverage(*ys[0], xn)
    sxy: float64 = 0
    sxx: float64 = 0
    syy: float64 = 0
    while i < xn {
        sxy += (xs[i] - ux) * (ys[i] - uy)
        sxx += (xs[i] - ux) * (xs[i] - ux)
        syy += (ys[i] - uy) * (ys[i] - uy)
        i += 1
    }
    den: float64 = Sqrt(sxx) * Sqrt(syy)
    if den == 0 {
        return ValError(ERR_VALUE)
    }
    c: float64 = sxy / den
    if c > 1 {
        c = 1
    }
    if c < -1 {
        c = -1
    }
    return ValNumber(c)
}

FnCovar :: (st: *EvalState, args: *Val, count: s32, marks: *s32, sample: s32) -> Val {
    xs: [4096]float64
    ys: [4096]float64
    xn: s32 = 0
    yn: s32 = 0
    if StatAggArgs(args, count, marks, *xs[0], *ys[0], *xn, *yn, 1) == 0 {
        return ValError(ERR_VALUE)
    }
    ux: float64 = StatAverage(*xs[0], xn)
    uy: float64 = StatAverage(*ys[0], xn)
    s: float64 = 0
    i: s32 = 0
    while i < xn {
        s += (xs[i] - ux) * (ys[i] - uy)
        i += 1
    }
    if sample != 0 {
        return ValNumber(s / cast(float64)(xn - 1))
    }
    return ValNumber(s / cast(float64)xn)
}

FnLinReg :: (st: *EvalState, args: *Val, count: s32, marks: *s32, which: s32) -> Val {
    xs: [4096]float64
    ys: [4096]float64
    tmp: [4096]float64
    xn: s32 = 0
    yn: s32 = 0
    i: s32 = 0
    px_in: float64 = 0
    if which == 3 {
        px_in = CoerceNumber(*args[0])
        if StatAggArgs(*args[1], count - 1, *marks[1], *tmp[0], *xs[0], *yn, *xn, 1) == 0 {
            return ValError(ERR_VALUE)
        }
    } else {
        if StatAggArgs(args, count, marks, *tmp[0], *xs[0], *yn, *xn, 1) == 0 {
            return ValError(ERR_VALUE)
        }
    }
    i = 0
    while i < xn {
        ys[i] = tmp[i]
        i += 1
    }
    ux: float64 = StatAverage(*xs[0], xn)
    uy: float64 = StatAverage(*ys[0], xn)
    sxy: float64 = 0
    sxx: float64 = 0
    syy: float64 = 0
    i = 0
    while i < xn {
        sxy += (xs[i] - ux) * (ys[i] - uy)
        sxx += (xs[i] - ux) * (xs[i] - ux)
        syy += (ys[i] - uy) * (ys[i] - uy)
        i += 1
    }
    if sxx == 0 {
        return ValError(ERR_VALUE)
    }
    slope: float64 = sxy / sxx
    if which == 0 {
        return ValNumber(slope)
    }
    if which == 1 {
        return ValNumber(uy - slope * ux)
    }
    if which == 2 {
        n2: float64 = cast(float64)xn
        ssres: float64 = syy - slope * sxy
        if ssres < 0 {
            ssres = 0
        }
        return ValNumber(Sqrt(ssres / (n2 - 2)))
    }
    if which == 3 {
        return ValNumber(uy - slope * ux + slope * px_in)
    }
    return ValNumber(0)
}

FnKurtSkew :: (st: *EvalState, args: *Val, count: s32, marks: *s32, which: s32, pop: s32) -> Val {
    list: NumList
    CollectNumbers(args, count, *list)
    n: s32 = list.count
    if (n < 4 && which == 0) || (n < 3 && which == 1) {
        return ValError(ERR_VALUE)
    }
    m: float64 = StatAverage(*list.data[0], n)
    s2: float64 = 0
    i: s32 = 0
    while i < n {
        d: float64 = list.data[i] - m
        s2 += d * d
        i += 1
    }
    if pop != 0 {
        s2 /= cast(float64)n
    } else {
        s2 = s2 / cast(float64)(n - 1)
    }
    s: float64 = Sqrt(s2)
    if s == 0 {
        return ValError(ERR_VALUE)
    }
    m3: float64 = 0
    m4: float64 = 0
    i = 0
    while i < n {
        d: float64 = list.data[i] - m
        dxn: float64 = d / s
        m3 += dxn * dxn * dxn
        m4 += dxn * dxn * (dxn * dxn)
        i += 1
    }
    if which == 1 {
        if pop != 0 {
            return ValNumber(m3 / cast(float64)n)
        }
        return ValNumber(((m3 * cast(float64)n) / cast(float64)(n - 1)) / cast(float64)(n - 2))
    }
    if pop != 0 {
        return ValNumber(m4 / cast(float64)n - 3)
    }
    common_den: float64 = cast(float64)(n - 2) * cast(float64)(n - 3)
    nth: float64 = (cast(float64)n * cast(float64)(n + 1)) / (cast(float64)(n - 1) * common_den)
    three: float64 = (3.0 * cast(float64)(n - 1) * cast(float64)(n - 1)) / common_den
    return ValNumber(m4 * nth - three)
}

FnStandardize :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    x: float64 = 0
    m: float64 = 0
    sd: float64 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    x = CoerceNumber(*args[0])
    m = CoerceNumber(*args[1])
    sd = CoerceNumber(*args[2])
    if sd <= 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber((x - m) / sd)
}

FnFisher :: (st: *EvalState, args: *Val, count: s32, marks: *s32, inv: s32) -> Val {
    x: float64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    x = CoerceNumber(*args[0])
    if inv != 0 {
        return ValNumber(Tanh(x))
    }
    if x <= -1 || x >= 1 {
        return ValError(ERR_NUM)
    }
    return ValNumber(Atanh(x))
}

FnVar :: (st: *EvalState, args: *Val, count: s32, marks: *s32, sample: s32, stddev: s32) -> Val {
    list: NumList
    CollectNumbers(args, count, *list)
    n: s32 = list.count
    if (sample != 0 && n < 2) || n < 1 {
        return ValError(ERR_VALUE)
    }
    m: float64 = StatAverage(*list.data[0], n)
    s: float64 = 0
    i: s32 = 0
    while i < n {
        d: float64 = list.data[i] - m
        s += d * d
        i += 1
    }
    v: float64 = 0
    if sample != 0 {
        v = s / cast(float64)(n - 1)
    } else {
        v = s / cast(float64)n
    }
    if stddev != 0 {
        return ValNumber(Sqrt(v))
    }
    return ValNumber(v)
}

FnAveragA :: (st: *EvalState, args: *Val, count: s32, marks: *s32, op: s32) -> Val {
    list: NumList
    i: s32 = 0
    total: float64 = 0
    n: s32 = 0
    CollectNumbers(args, count, *list)
    if op == 0 {
        i = 0
        while i < count {
            if args[i].kind == VAL_FLOAT || args[i].kind == VAL_BOOL || args[i].kind == VAL_STRING {
                n += 1
            }
            i += 1
        }
        if n == 0 {
            return ValError(ERR_VALUE)
        }
        i = 0
        while i < list.count {
            total += list.data[i]
            i += 1
        }
        return ValNumber(total / cast(float64)n)
    }
    if op == 1 {
        if list.count == 0 {
            return ValNumber(0)
        }
        best: float64 = list.data[0]
        i = 1
        while i < list.count {
            if op == 1 {
                if list.data[i] > best {
                    best = list.data[i]
                }
            }
            i += 1
        }
        return ValNumber(best)
    }
    if list.count == 0 {
        return ValNumber(0)
    }
    best2: float64 = list.data[0]
    i = 1
    while i < list.count {
        if list.data[i] < best2 {
            best2 = list.data[i]
        }
        i += 1
    }
    return ValNumber(best2)
}

FnVarA :: (st: *EvalState, args: *Val, count: s32, marks: *s32, sample: s32, stddev: s32) -> Val {
    list: NumList
    CollectNumbers(args, count, *list)
    n: s32 = list.count
    if (sample != 0 && n < 2) || n < 1 {
        return ValError(ERR_VALUE)
    }
    m: float64 = StatAverage(*list.data[0], n)
    s: float64 = 0
    i: s32 = 0
    while i < n {
        d: float64 = list.data[i] - m
        s += d * d
        i += 1
    }
    if sample != 0 {
        if stddev != 0 {
            return ValNumber(Sqrt(s / cast(float64)(n - 1)))
        }
        return ValNumber(s / cast(float64)(n - 1))
    }
    if stddev != 0 {
        return ValNumber(Sqrt(s / cast(float64)n))
    }
    return ValNumber(s / cast(float64)n)
}

FnTrimmean :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    list: NumList
    vals0: [4096]float64
    n0: s32 = CollectRangeGroup(args, count, marks, *vals0[0])
    i0: s32 = 0
    while i0 < n0 {
        list.data[i0] = vals0[i0]
        i0 += 1
    }
    list.count = n0
    n: s32 = list.count
    p: float64 = 0
    p = CoerceNumber(*args[count - 1])
    if p < 0 || p >= 1 {
        return ValError(ERR_NUM)
    }
    SortDoubles(*list.data[0], n)
    tc: s32 = TruncateToS32(Floor((cast(float64)n * p) / 2))
    c: s32 = n - 2 * tc
    if c <= 0 {
        return ValError(ERR_VALUE)
    }
    shifted: [4096]float64
    k2: s32 = 0
    while k2 < c {
        shifted[k2] = list.data[tc + k2]
        k2 += 1
    }
    return ValNumber(StatAverage(*shifted[0], c))
}

FractileInterSorted :: (xs: *float64, n: s32, f: float64) -> float64 {
    fpos: float64 = 0
    pos: s32 = 0
    residual: float64 = 0
    if n <= 0 || f < 0 || f > 1 {
        return 0.0 / 0.0
    }
    fpos = cast(float64)(n - 1) * f
    pos = TruncateToS32(fpos)
    residual = fpos - cast(float64)pos
    if residual == 0 || (pos + 1) >= n {
        return xs[pos]
    }
    return (1 - residual) * xs[pos] + residual * xs[pos + 1]
}

FnPercentile :: (st: *EvalState, args: *Val, count: s32, marks: *s32, exc: s32) -> Val {
    list: NumList
    vals0: [4096]float64
    n0: s32 = CollectRangeGroup(args, count, marks, *vals0[0])
    i0: s32 = 0
    while i0 < n0 {
        list.data[i0] = vals0[i0]
        i0 += 1
    }
    list.count = n0
    n: s32 = list.count
    p: float64 = CoerceNumber(*args[count - 1])
    if n == 0 {
        return ValError(ERR_NUM)
    }
    SortDoubles(*list.data[0], n)
    if exc != 0 {
        if n <= 1 {
            return ValError(ERR_NUM)
        }
        fr: float64 = (p * cast(float64)(n + 1) - 1) / cast(float64)(n - 1)
        res: float64 = FractileInterSorted(*list.data[0], n, fr)
        if res != res {
            return ValError(ERR_NUM)
        }
        return ValNumber(res)
    }
    res2: float64 = FractileInterSorted(*list.data[0], n, p)
    if res2 != res2 {
        return ValError(ERR_NUM)
    }
    return ValNumber(res2)
}

FnQuartile :: (st: *EvalState, args: *Val, count: s32, marks: *s32, exc: s32) -> Val {
    list: NumList
    vals0: [4096]float64
    n0: s32 = CollectRangeGroup(args, count, marks, *vals0[0])
    i0: s32 = 0
    while i0 < n0 {
        list.data[i0] = vals0[i0]
        i0 += 1
    }
    list.count = n0
    n: s32 = list.count
    q: float64 = Floor(CoerceNumber(*args[count - 1]))
    if n == 0 {
        return ValError(ERR_NUM)
    }
    if q < 0 || q > 4 {
        return ValError(ERR_NUM)
    }
    SortDoubles(*list.data[0], n)
    if exc != 0 {
        if n <= 1 {
            return ValError(ERR_NUM)
        }
        fr: float64 = ((q / 4) * cast(float64)(n + 1) - 1) / cast(float64)(n - 1)
        if fr < 0 || fr > 1 {
            return ValError(ERR_NUM)
        }
        return ValNumber(FractileInterSorted(*list.data[0], n, fr))
    }
    return ValNumber(FractileInterSorted(*list.data[0], n, q / 4))
}

FnPercentrank :: (st: *EvalState, args: *Val, count: s32, marks: *s32, exc: s32) -> Val {
    list: NumList
    vals0: [4096]float64
    n0: s32 = CollectRangeGroup(args, count, marks, *vals0[0])
    i0: s32 = 0
    while i0 < n0 {
        list.data[i0] = vals0[i0]
        i0 += 1
    }
    list.count = n0
    n: s32 = list.count
    x: float64 = CoerceNumber(*args[count - 1])
    sig: float64 = ifx count >= 3 then CoerceNumber(*args[2]) else 3
    n_equal: s32 = 0
    n_smaller: s32 = 0
    n_larger: s32 = 0
    x_larger: float64 = 0
    x_smaller: float64 = 0
    i: s32 = 0
    r: float64 = 0
    if n == 0 {
        return ValError(ERR_NUM)
    }
    i = 0
    while i < n {
        y: float64 = list.data[i]
        if y < x {
            if n_smaller == 0 || x_smaller < y {
                x_smaller = y
            }
            n_smaller += 1
        } else if y > x {
            if n_larger == 0 || x_larger > y {
                x_larger = y
            }
            n_larger += 1
        } else {
            n_equal += 1
        }
        i += 1
    }
    if (n_smaller + n_equal) == 0 || (n_larger + n_equal) == 0 {
        return ValError(ERR_NA)
    }
    if n == 1 {
        r = 1
    } else {
        if exc != 0 {
            if n_equal > 0 {
                r = cast(float64)(n_smaller + 1) / cast(float64)(n + 1)
            } else {
                re1: float64 = cast(float64)n_smaller / cast(float64)(n + 1)
                re2: float64 = cast(float64)(n_smaller + 1) / cast(float64)(n + 1)
                r = (re1 * (x_larger - x) + re2 * (x - x_smaller)) / (x_larger - x_smaller)
            }
        } else if n_equal > 0 {
            r = cast(float64)n_smaller / cast(float64)(n - 1)
        } else {
            r1: float64 = cast(float64)(n_smaller - 1) / cast(float64)(n - 1)
            r2: float64 = cast(float64)n_smaller / cast(float64)(n - 1)
            r = (r1 * (x_larger - x) + r2 * (x - x_smaller)) / (x_larger - x_smaller)
        }
        if sig < 1 {
            return ValError(ERR_NUM)
        }
        s10: float64 = Pow(10, -sig)
        if s10 <= 0 {
            return ValError(ERR_DIV0)
        }
        r = Trunc(r / s10) * s10
    }
    return ValNumber(r)
}

FnRank :: (st: *EvalState, args: *Val, count: s32, marks: *s32, avg: s32) -> Val {
    list: NumList
    vals0: [4096]float64
    g1: s32 = 0
    l1: s32 = 0
    n0: s32 = 0
    if GroupBounds(marks, count, 1, *g1, *l1) != 0 {
        n0 = CashList(*args[g1], l1, *vals0[0])
    }
    if n0 < 1 {
        return ValError(ERR_VALUE)
    }
    i0: s32 = 0
    while i0 < n0 {
        list.data[i0] = vals0[i0]
        i0 += 1
    }
    list.count = n0
    n: s32 = list.count
    x: float64 = CoerceNumber(*args[0])
    increasing: s32 = ifx count > (n0 + 1) then (ifx CoerceNumber(*args[n0 + 1]) != 0 then 1 else 0) else 0
    r: s32 = 1
    t: s32 = 0
    i: s32 = 0
    i = 0
    while i < n {
        y: float64 = list.data[i]
        if ifx increasing != 0 then (y < x) else (y > x) {
            r += 1
        }
        if x == y {
            t += 1
        }
        i += 1
    }
    if avg != 0 {
        s: float64 = cast(float64)r
        k: s32 = 1
        while k < t {
            s += cast(float64)(r + k)
            k += 1
        }
        return ValNumber(s / cast(float64)t)
    }
    return ValNumber(cast(float64)r)
}

FnModeMult :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    list: NumList
    CollectNumbers(args, count, *list)
    n: s32 = list.count
    if n <= 1 {
        return ValError(ERR_NA)
    }
    SortDoubles(*list.data[0], n)
    best: float64 = 0
    bestrun: s32 = 0
    i: s32 = 0
    while i < n {
        j: s32 = i
        while (j + 1) < n && list.data[j + 1] == list.data[i] {
            j += 1
        }
        run: s32 = j - i + 1
        if run > bestrun {
            bestrun = run
            best = list.data[i]
        }
        i = j + 1
    }
    if bestrun <= 1 {
        return ValError(ERR_NA)
    }
    return ValNumber(best)
}

FnFrequency :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    data: [4096]float64
    bins: [4096]float64
    gx: s32 = 0
    gl: s32 = 0
    bx: s32 = 0
    bl: s32 = 0
    rest: s32 = 0
    nd: s32 = 0
    nb: s32 = 0
    if GroupBounds(marks, count, 0, *gx, *gl) == 0 {
        gx = 0
        gl = count
    }
    nd = CashList(*args[gx], gl, *data[0])
    if nd < 0 {
        return FirstError(args, count)
    }
    if GroupBounds(marks, count, 1, *bx, *bl) != 0 {
        nb = CashList(*args[bx], bl, *bins[0])
    } else {
        rest = gx + gl
        nb = CashList(*args[rest], count - rest, *bins[0])
    }
    if nb < 0 {
        return FirstError(args, count)
    }
    if nb == 0 {
        return ValNumber(cast(float64)nd)
    }
    SortDoubles(*bins[0], nb)
    firstcount: s32 = 0
    i: s32 = 0
    while i < nd {
        v: float64 = data[i]
        j: s32 = 0
        while j < nb {
            if v <= bins[j] {
                break
            }
            j += 1
        }
        if j == 0 {
            firstcount += 1
        }
        i += 1
    }
    return ValNumber(cast(float64)firstcount)
}

FnZtest :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    list: NumList
    vals0: [4096]float64
    n0: s32 = CollectRangeGroup(args, count, marks, *vals0[0])
    i0: s32 = 0
    while i0 < n0 {
        list.data[i0] = vals0[i0]
        i0 += 1
    }
    list.count = n0
    n: s32 = list.count
    x: float64 = CoerceNumber(*args[n])
    s: float64 = 0
    m: float64 = 0
    if n == 0 {
        return ValError(ERR_DIV0)
    }
    m = StatAverage(*list.data[0], n)
    if count > (n + 1) {
        s = CoerceNumber(*args[n + 1])
    } else {
        if n < 2 {
            return ValError(ERR_DIV0)
        }
        s = Sqrt(StatDevsq(*list.data[0], n) / cast(float64)(n - 1))
    }
    if s <= 0 {
        return ValError(ERR_DIV0)
    }
    return ValNumber(pnorm(x, m, s / Sqrt(cast(float64)n), 1, 0))
}

FnTtest :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    xs: [4096]float64
    ys: [4096]float64
    xn: s32 = 0
    yn: s32 = 0
    tails: float64 = 0
    typ: float64 = 0
    mx: float64 = 0
    vx: float64 = 0
    my: float64 = 0
    vy: float64 = 0
    dof: float64 = 0
    t: float64 = 0
    if count < 4 {
        return ValError(ERR_VALUE)
    }
    tails = CoerceNumber(*args[count - 2])
    typ = CoerceNumber(*args[count - 1])
    if tails != 1 && tails != 2 {
        return ValError(ERR_NUM)
    }
    if typ != 1 && typ != 2 && typ != 3 {
        return ValError(ERR_NUM)
    }
    g0: s32 = 0
    l0: s32 = 0
    g1: s32 = 0
    l1: s32 = 0
    if GroupBounds(marks, count, 0, *g0, *l0) == 0 {
        return ValError(ERR_VALUE)
    }
    if GroupBounds(marks, count, 1, *g1, *l1) == 0 {
        return ValError(ERR_VALUE)
    }
    xn = CashList(*args[g0], l0, *xs[0])
    yn = CashList(*args[g1], l1, *ys[0])
    if xn < 0 || yn < 0 {
        return ValError(ERR_VALUE)
    }
    if typ == 1 {
        if xn != yn {
            return ValError(ERR_NA)
        }
        zm: float64 = 0
        zs: float64 = 0
        zs2: float64 = 0
        i: s32 = 0
        while i < xn {
            d: float64 = xs[i] - ys[i]
            zm += d
            zs2 += d * d
            i += 1
        }
        zm /= cast(float64)xn
        zs2 = zs2 - cast(float64)xn * zm * zm
        zs = Sqrt(zs2 / cast(float64)(xn - 1))
        if zs == 0 {
            return ValError(ERR_DIV0)
        }
        t = Sqrt(cast(float64)xn) * (zm / zs)
        dof = cast(float64)(xn - 1)
        return ValNumber(tails * pt(Fabs(t), dof, 0, 0))
    }
    mx = StatAverage(*xs[0], xn)
    vx = StatDevsq(*xs[0], xn) / cast(float64)(xn - 1)
    my = StatAverage(*ys[0], yn)
    vy = StatDevsq(*ys[0], yn) / cast(float64)(yn - 1)
    if vx == 0 && vy == 0 {
        return ValError(ERR_DIV0)
    }
    if typ == 3 {
        S: float64 = vx / cast(float64)xn + vy / cast(float64)yn
        c: float64 = (vx / cast(float64)xn) / S
        cC: float64 = (vy / cast(float64)yn) / S
        dof = 1 / ((c * c) / cast(float64)(xn - 1) + (cC * cC) / cast(float64)(yn - 1))
        t = Fabs(mx - my) / Sqrt(S)
    } else {
        dof = cast(float64)(xn + yn - 2)
        t = Fabs(mx - my) * Sqrt((dof * cast(float64)xn * cast(float64)yn) / (cast(float64)(xn + yn) * (cast(float64)(xn - 1) * vx + cast(float64)(yn - 1) * vy)))
    }
    return ValNumber(tails * pt(t, dof, 0, 0))
}

FnConfidence :: (st: *EvalState, args: *Val, count: s32, marks: *s32, t_based: s32) -> Val {
    alpha: float64 = 0
    sd: float64 = 0
    n: float64 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    alpha = CoerceNumber(*args[0])
    sd = CoerceNumber(*args[1])
    n = FormulaFakeFloor(CoerceNumber(*args[2]))
    if t_based != 0 {
        if n == 1 {
            return ValError(ERR_DIV0)
        }
        if n <= 1 || sd <= 0 {
            return ValError(ERR_NUM)
        }
        return ValNumber(0 - qt(alpha / 2, n - 1, 1, 0) * (sd / Sqrt(n)))
    }
    if n == 0 {
        return ValError(ERR_DIV0)
    }
    if n <= 0 || sd <= 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber(0 - qnorm(alpha / 2, 0, 1, 1, 0) * (sd / Sqrt(n)))
}

FnDistr3 :: (which: s32, args: *Val, count: s32) -> Val {
    a: float64 = 0
    b: float64 = 0
    c: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    a = CoerceNumber(*args[0])
    b = CoerceNumber(*args[1])
    c = ifx count >= 3 then CoerceNumber(*args[2]) else 0
    if which == 0 {
        return ValNumber(pnorm(a, b, c, 1, 0))
    }
    if which == 1 {
        return ValNumber(qnorm(a, b, c, 1, 0))
    }
    if which == 2 {
        return ValNumber(pchisq(a, b, 1, 0))
    }
    if which == 3 {
        return ValNumber(qchisq(a, b, 1, 0))
    }
    if which == 4 {
        return ValNumber(pf(a, b, c, 1, 0))
    }
    if which == 5 {
        return ValNumber(qf(a, b, c, 1, 0))
    }
    if which == 6 {
        return ValNumber(pt(a, b, 1, 0))
    }
    if which == 7 {
        return ValNumber(qt(a, b, 1, 0))
    }
    if which == 8 {
        return ValNumber(pgamma(a, b, c, 1, 0))
    }
    if which == 9 {
        return ValNumber(qgamma(a, b, c, 1, 0))
    }
    return ValNumber(0)
}

pexp_go :: (x: float64, scale: float64, lower_tail: s32, log_p: s32) -> float64 {
    if x <= 0 {
        return ifx lower_tail != 0 then 0.0 else 1.0
    }
    if lower_tail != 0 {
        return 1 - Exp(0 - x / scale)
    }
    return Exp(0 - x / scale)
}

dexp_go :: (x: float64, scale: float64) -> float64 {
    if x <= 0 {
        return 0.0
    }
    return Exp(0 - x / scale) / scale
}

pweibull_go :: (x: float64, shape: float64, scale: float64, lower_tail: s32, log_p: s32) -> float64 {
    if x <= 0 {
        return ifx lower_tail != 0 then 0.0 else 1.0
    }
    v: float64 = Exp(0 - Pow(x / scale, shape))
    if lower_tail != 0 {
        return 1 - v
    }
    return v
}

pow1p_plain :: (x: float64, y: float64) -> float64 {
    if (x + 1 - 1) == x || x > 0.5 || x < -0.5 || x != x || y != y {
        return Pow(1 + x, y)
    }
    if y < 0 {
        return 1 / pow1p_plain(x, -y)
    }
    x1: float64 = Round(x * 65536) / 65536
    x2: float64 = x - x1
    h: float64 = 0
    l: float64 = 0
    Ebd0(y, y * (x + 1), *h, *l)
    PairAdd(0 - y * x1, *h, *l)
    PairAdd(0 - y * x2, *h, *l)
    return Exp(0 - l) * Exp(0 - h)
}

dweibull_go :: (x: float64, shape: float64, scale: float64) -> float64 {
    if x <= 0 {
        return 0.0
    }
    xscal: float64 = Pow(x / scale, shape - 1)
    return (shape * xscal * Exp(0 - (xscal * x) / scale)) / scale
}

DbParseNumber :: (text: *s8, out: *float64) -> s32 {
    p: *s8 = text
    end: *s8 = null
    v: float64 = 0
    while p[0] == 32 || (p[0] >= 9 && p[0] <= 13) {
        p = *p[1]
    }
    v = ParseDouble(p, *end)
    if end == p {
        return 0
    }
    while end[0] == 32 || (end[0] >= 9 && end[0] <= 13) {
        end = *end[1]
    }
    if end[0] != 0 {
        return 0
    }
    out[0] = v
    return 1
}

DbWildMatch :: (pat: *s8, s: *s8) -> s32 {
    si: s32 = 0
    star: s32 = -1
    ss: s32 = 0
    pi: s32 = 0
    lc: [64]s8
    ls: [256]s8
    i: s32 = 0
    while i < 63 && s[i] != 0 {
        lc[i] = cast(s8)LowerByte(cast(s32)(cast(u8)s[i]))
        i += 1
    }
    lc[i] = 0
    i = 0
    while i < 63 && pat[i] != 0 {
        ls[i] = cast(s8)LowerByte(cast(s32)(cast(u8)pat[i]))
        i += 1
    }
    ls[i] = 0
    while lc[si] != 0 {
        if (ls[pi] == 63 || ls[pi] == lc[si]) && ls[pi] != 0 {
            si += 1
            pi += 1
        } else if ls[pi] == 42 && ls[pi] != 0 {
            star = pi
            pi += 1
            ss = si
        } else if star >= 0 {
            pi = star + 1
            ss += 1
            si = ss
        } else {
            return 0
        }
    }
    while ls[pi] == 42 {
        pi += 1
    }
    if ls[pi] == 0 {
        return 1
    }
    return 0
}

DbParseCond :: (v: *Val, out: *DbCond) -> s32 {
    txt: *s8 = CText("")
    rest: *s8 = CText("")
    num: float64 = 0
    out.op = 0
    out.is_num = 0
    out.num = 0
    out.text[0] = 0
    if v.kind == VAL_FLOAT {
        out.op = 0
        out.is_num = 1
        out.num = v.number
        return 1
    }
    if v.kind == VAL_BOOL {
        out.op = 0
        out.is_num = 1
        out.num = v.number
        return 1
    }
    if v.kind != VAL_STRING {
        out.op = 9
        return 1
    }
    txt = v.text
    if txt[0] == 0 {
        out.op = 10
        return 1
    }
    if txt[0] == 60 && txt[1] == 61 {
        rest = *txt[2]
        out.op = 5
    } else if txt[0] == 62 && txt[1] == 61 {
        rest = *txt[2]
        out.op = 3
    } else if txt[0] == 60 && txt[1] == 62 {
        rest = *txt[2]
        if rest[0] == 0 {
            out.op = 7
            return 1
        }
        out.op = 1
    } else if txt[0] == 60 {
        rest = *txt[1]
        out.op = 4
    } else if txt[0] == 61 {
        rest = *txt[1]
        if rest[0] == 0 {
            out.op = 8
            return 1
        }
        out.op = 0
    } else if txt[0] == 62 {
        rest = *txt[1]
        out.op = 2
    } else {
        rest = txt
        out.op = 6
    }
    if DbParseNumber(rest, *num) != 0 {
        out.is_num = 1
        out.num = num
        if out.op == 6 {
            out.op = 0
        }
    } else {
        i: s32 = 0
        while i < 47 && rest[i] != 0 {
            out.text[i] = rest[i]
            i += 1
        }
        out.text[i] = 0
    }
    return 1
}

DbTestCond :: (x: *Val, cond: *DbCond) -> s32 {
    wrong: s32 = 0
    xf: float64 = 0
    c: s32 = 0
    if cond.op == 9 {
        return 0
    }
    if cond.op == 7 {
        if x.kind == VAL_EMPTY {
            return 0
        }
        return 1
    }
    if cond.op == 8 {
        if x.kind == VAL_EMPTY {
            return 1
        }
        return 0
    }
    if cond.op == 10 {
        if x.kind == VAL_EMPTY {
            return 1
        }
        if x.kind == VAL_STRING && x.text[0] == 0 {
            return 1
        }
        return 0
    }
    if cond.op == 6 {
        if x.kind != VAL_STRING {
            return 0
        }
        return DbWildMatch(*cond.text[0], x.text)
    }
    if cond.is_num != 0 {
        if x.kind == VAL_BOOL || x.kind == VAL_ERROR {
            wrong = 1
        } else if x.kind == VAL_FLOAT {
            xf = x.number
        } else if x.kind == VAL_STRING && cond.op == 0 {
            if DbParseNumber(x.text, *xf) == 0 {
                wrong = 1
            }
        } else {
            wrong = 1
        }
        if wrong != 0 {
            if cond.op == 1 {
                return 1
            }
            return 0
        }
        if cond.op == 0 {
            return ifx xf == cond.num then 1 else 0
        }
        if cond.op == 1 {
            return ifx xf != cond.num then 1 else 0
        }
        if cond.op == 2 {
            return ifx xf > cond.num then 1 else 0
        }
        if cond.op == 3 {
            return ifx xf >= cond.num then 1 else 0
        }
        if cond.op == 4 {
            return ifx xf < cond.num then 1 else 0
        }
        return ifx xf <= cond.num then 1 else 0
    }
    if x.kind != VAL_STRING {
        wrong = 1
    }
    if wrong != 0 {
        if cond.op == 1 {
            return 1
        }
        return 0
    }
    c = TextCompareFold(x.text, *cond.text[0])
    if cond.op == 0 {
        return ifx c == 0 then 1 else 0
    }
    if cond.op == 1 {
        return ifx c != 0 then 1 else 0
    }
    if cond.op == 2 {
        return ifx c > 0 then 1 else 0
    }
    if cond.op == 3 {
        return ifx c >= 0 then 1 else 0
    }
    if cond.op == 4 {
        return ifx c < 0 then 1 else 0
    }
    return ifx c <= 0 then 1 else 0
}

DbFindColumn :: (args: *Val, db_start: s32, db_cols: s32, db_rows: s32, field: *Val) -> s32 {
    n: s32 = 0
    hdr: *s8 = CText("")
    if field.kind == VAL_FLOAT || field.kind == VAL_BOOL {
        return TruncateToS32(field.number) - 1
    }
    if field.kind != VAL_STRING {
        return -2
    }
    n = 0
    while n < db_cols {
        cell: *Val = *args[db_start + n]
        if cell.kind == VAL_STRING {
            hdr = cell.text
        } else if cell.kind == VAL_FLOAT {
            hdr = CText("")
        } else {
            hdr = CText("")
        }
        if cell.kind == VAL_STRING && TextCompareFold(field.text, hdr) == 0 {
            return n
        }
        n += 1
    }
    return -2
}

DbSetup :: (st: *EvalState, args: *Val, count: s32, marks: *s32, allow_missing: s32, db_start: *s32, db_cols: *s32, db_rows: *s32, fieldno: *s32, crit_start: *s32, crit_cols: *s32, crit_rows: *s32, conds: *DbCond, cond_cols: *s32, cond_counts: *s32, crit_row_count: *s32) -> s32 {
    groups: s32 = 0
    field: *Val = null
    crit_header: [16]s32
    r: s32 = 0
    c: s32 = 0
    ci: s32 = 0
    db_start[0] = 0
    db_cols[0] = 0
    db_rows[0] = 0
    fieldno[0] = -1
    crit_start[0] = 0
    crit_cols[0] = 0
    crit_rows[0] = 0
    crit_row_count[0] = 0
    groups = ArgGroupCount(args, marks, count)
    if groups < 2 {
        return 0
    }
    GroupBounds(marks, count, 0, db_start, *db_rows[0])
    db_cols[0] = st.call_group_cols[db_start[0]]
    if db_cols[0] < 1 {
        return 0
    }
    db_rows[0] = db_rows[0] / db_cols[0]
    if db_rows[0] < 2 {
        return 0
    }
    field_missing: s32 = 0
    if allow_missing != 0 {
        if groups < 3 {
            field_missing = 1
        } else {
            field = *args[db_start[0] + db_cols[0] * db_rows[0]]
            if field.kind != VAL_STRING && field.kind != VAL_FLOAT && field.kind != VAL_BOOL {
                field_missing = 1
            }
        }
    }
    if field_missing != 0 {
        fieldno[0] = -1
        GroupBounds(marks, count, groups - 1, crit_start, *crit_rows[0])
    } else {
        field = *args[db_start[0] + db_cols[0] * db_rows[0]]
        fieldno[0] = DbFindColumn(args, db_start[0], db_cols[0], db_rows[0], field)
        if fieldno[0] == -2 {
            return 0
        }
        if fieldno[0] < 0 || fieldno[0] >= db_cols[0] {
            fieldno[0] = -3
        }
        GroupBounds(marks, count, groups - 1, crit_start, *crit_rows[0])
    }
    if crit_rows[0] < 1 {
        return 0
    }
    crit_cols[0] = st.call_group_cols[crit_start[0]]
    if crit_cols[0] < 1 {
        return 0
    }
    crit_rows[0] = crit_rows[0] / crit_cols[0]
    if crit_rows[0] < 2 {
        return 0
    }
    c = 0
    while c < crit_cols[0] && c < 16 {
        hcell: *Val = *args[crit_start[0] + c]
        crit_header[c] = -2
        if hcell.kind == VAL_STRING && hcell.text[0] != 0 {
            crit_header[c] = DbFindColumn(args, db_start[0], db_cols[0], db_rows[0], hcell)
            if crit_header[c] == -2 {
                return 0
            }
        } else if hcell.kind == VAL_FLOAT {
            crit_header[c] = DbFindColumn(args, db_start[0], db_cols[0], db_rows[0], hcell)
            if crit_header[c] == -2 {
                crit_header[c] = -2
            }
        }
        c += 1
    }
    r = 1
    while r < crit_rows[0] {
        cnt: s32 = 0
        c = 0
        while c < crit_cols[0] && c < 16 {
            cc: *Val = *args[crit_start[0] + r * crit_cols[0] + c]
            if cc.kind != VAL_EMPTY {
                if ci < 128 {
                    cond_cols[ci] = crit_header[c]
                    DbParseCond(cc, *conds[ci])
                    ci += 1
                    cnt += 1
                }
            }
            c += 1
        }
        cond_counts[r] = cnt
        r += 1
    }
    crit_row_count[0] = crit_rows[0]
    return 1
}

DbRowMatches :: (args: *Val, db_start: s32, db_cols: s32, row: s32, conds: *DbCond, cond_cols: *s32, cond_counts: *s32, crit_rows: s32) -> s32 {
    cr: s32 = 1
    k: s32 = 0
    ci: s32 = 0
    while cr < crit_rows {
        all: s32 = 1
        k = 0
        while k < cond_counts[cr] {
            cond: *DbCond = *conds[ci]
            xv: *Val = null
            empty_v: Val = Val.{VAL_EMPTY, 0.0, null, 0, 0}
            if cond_cols[ci] >= 0 {
                xv = *args[db_start + row * db_cols + cond_cols[ci]]
            } else {
                xv = *empty_v
            }
            if DbTestCond(xv, cond) == 0 {
                all = 0
                break
            }
            k += 1
            ci += 1
        }
        if all != 0 {
            return 1
        }
        ci = ci + (cond_counts[cr] - k)
        cr += 1
    }
    return 0
}

DbCollectFloats :: (st: *EvalState, args: *Val, count: s32, marks: *s32, allow_missing: s32, out: *float64, out_n: *s32, err: *s32) -> s32 {
    db_start: s32 = 0
    db_cols: s32 = 0
    db_rows: s32 = 0
    fieldno: s32 = -1
    crit_start: s32 = 0
    crit_cols: s32 = 0
    crit_rows: s32 = 0
    conds: [128]DbCond
    cond_cols: [128]s32
    cond_counts: [64]s32
    crit_row_count: s32 = 0
    row: s32 = 1
    n: s32 = 0
    if DbSetup(st, args, count, marks, allow_missing, *db_start, *db_cols, *db_rows, *fieldno, *crit_start, *crit_cols, *crit_rows, *conds[0], *cond_cols[0], *cond_counts[0], *crit_row_count) == 0 {
        err[0] = ERR_NUM
        return 0
    }
    while row < db_rows {
        cellv: *Val = null
        if fieldno == -3 {
            break
        }
        if fieldno >= 0 {
            cellv = *args[db_start + row * db_cols + fieldno]
            if cellv.kind == VAL_EMPTY {
                row += 1
                continue
            }
        }
        if DbRowMatches(args, db_start, db_cols, row, *conds[0], *cond_cols[0], *cond_counts[0], crit_rows) != 0 {
            if fieldno < 0 {
                cellv = *args[db_start + row * db_cols]
                if cellv.kind == VAL_EMPTY {
                    row += 1
                    continue
                }
            }
            if cellv.kind == VAL_ERROR {
                err[0] = cellv.err
                return 0
            }
            if cellv.kind == VAL_STRING || cellv.kind == VAL_BOOL || cellv.kind == VAL_EMPTY {
                row += 1
                continue
            }
            if n < 512 {
                out[n] = cellv.number
                n += 1
            }
        }
        row += 1
    }
    out_n[0] = n
    return 1
}

DbCollectValues :: (st: *EvalState, args: *Val, count: s32, marks: *s32, allow_missing: s32, ignore_strings: s32, out: *Val, out_n: *s32, err: *s32) -> s32 {
    db_start: s32 = 0
    db_cols: s32 = 0
    db_rows: s32 = 0
    fieldno: s32 = -1
    crit_start: s32 = 0
    crit_cols: s32 = 0
    crit_rows: s32 = 0
    conds: [128]DbCond
    cond_cols: [128]s32
    cond_counts: [64]s32
    crit_row_count: s32 = 0
    row: s32 = 1
    n: s32 = 0
    if DbSetup(st, args, count, marks, allow_missing, *db_start, *db_cols, *db_rows, *fieldno, *crit_start, *crit_cols, *crit_rows, *conds[0], *cond_cols[0], *cond_counts[0], *crit_row_count) == 0 {
        err[0] = ERR_NUM
        return 0
    }
    while row < db_rows {
        cellv: *Val = null
        if fieldno == -3 {
            break
        }
        if fieldno >= 0 {
            cellv = *args[db_start + row * db_cols + fieldno]
            if cellv.kind == VAL_EMPTY {
                row += 1
                continue
            }
        }
        if DbRowMatches(args, db_start, db_cols, row, *conds[0], *cond_cols[0], *cond_counts[0], crit_rows) != 0 {
            if fieldno < 0 {
                cellv = *args[db_start + row * db_cols]
                if n < 512 {
                    out[n] = cellv[0]
                    if cellv.kind == VAL_STRING && cellv.text != null {
                        out[n].text = wb_strdup(cellv.text)
                    }
                    n += 1
                }
                row += 1
                continue
            }
            if (ignore_strings != 0 && cellv.kind == VAL_STRING) || cellv.kind == VAL_BOOL || cellv.kind == VAL_EMPTY {
                row += 1
                continue
            }
            if n < 512 {
                out[n] = cellv[0]
                if cellv.kind == VAL_STRING && cellv.text != null {
                    out[n].text = wb_strdup(cellv.text)
                }
                n += 1
            }
        }
        row += 1
    }
    out_n[0] = n
    return 1
}

DbFloatAgg :: (st: *EvalState, args: *Val, count: s32, marks: *s32, agg: s32, zero_num_error: s32) -> Val {
    vals: [512]float64
    n: s32 = 0
    err: s32 = 0
    i: s32 = 0
    total: float64 = 0
    prod: float64 = 1
    mean: float64 = 0
    m2: float64 = 0
    if DbCollectFloats(st, args, count, marks, 0, *vals[0], *n, *err) == 0 {
        return ValError(err)
    }
    if n == 0 && zero_num_error != 0 {
        return ValError(ERR_NUM)
    }
    if agg == 0 {
        if n == 0 {
            return ValError(ERR_NUM)
        }
        i = 0
        while i < n {
            total += vals[i]
            i += 1
        }
        return ValNumber(total / cast(float64)n)
    }
    if agg == 1 {
        if n == 0 {
            return ValError(ERR_NUM)
        }
        best: float64 = vals[0]
        i = 1
        while i < n {
            if vals[i] > best {
                best = vals[i]
            }
            i += 1
        }
        return ValNumber(best)
    }
    if agg == 2 {
        if n == 0 {
            return ValError(ERR_NUM)
        }
        best2: float64 = vals[0]
        i = 1
        while i < n {
            if vals[i] < best2 {
                best2 = vals[i]
            }
            i += 1
        }
        return ValNumber(best2)
    }
    if agg == 3 {
        i = 0
        while i < n {
            total += vals[i]
            i += 1
        }
        return ValNumber(total)
    }
    if agg == 4 {
        i = 0
        while i < n {
            prod *= vals[i]
            i += 1
        }
        return ValNumber(prod)
    }
    i = 0
    while i < n {
        total += vals[i]
        i += 1
    }
    if n == 0 {
        return ValError(ERR_NUM)
    }
    mean = total / cast(float64)n
    i = 0
    while i < n {
        d: float64 = vals[i] - mean
        m2 += d * d
        i += 1
    }
    if agg == 5 {
        if n < 2 {
            return ValError(ERR_NUM)
        }
        return ValNumber(Sqrt(m2 / cast(float64)(n - 1)))
    }
    if agg == 6 {
        return ValNumber(Sqrt(m2 / cast(float64)n))
    }
    if agg == 7 {
        if n < 2 {
            return ValError(ERR_NUM)
        }
        return ValNumber(m2 / cast(float64)(n - 1))
    }
    return ValNumber(m2 / cast(float64)n)
}

FnDaverage :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return DbFloatAgg(st, args, count, marks, 0, 1)
}

FnDmax :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return DbFloatAgg(st, args, count, marks, 1, 1)
}

FnDmin :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return DbFloatAgg(st, args, count, marks, 2, 1)
}

FnDsum :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return DbFloatAgg(st, args, count, marks, 3, 0)
}

FnDproduct :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return DbFloatAgg(st, args, count, marks, 4, 0)
}

FnDstdev :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return DbFloatAgg(st, args, count, marks, 5, 0)
}

FnDstdevp :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return DbFloatAgg(st, args, count, marks, 6, 0)
}

FnDvar :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return DbFloatAgg(st, args, count, marks, 7, 0)
}

FnDvarp :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return DbFloatAgg(st, args, count, marks, 8, 0)
}

FnDcount :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    vals: [512]Val
    n: s32 = 0
    err: s32 = 0
    i: s32 = 0
    n2: s32 = 0
    if DbCollectValues(st, args, count, marks, 1, 1, *vals[0], *n, *err) == 0 {
        return ValError(err)
    }
    i = 0
    while i < n {
        if vals[i].kind == VAL_ERROR {
            i += 1
            continue
        }
        n2 += 1
        i += 1
    }
    return ValNumber(cast(float64)n2)
}

FnDcounta :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    vals: [512]Val
    n: s32 = 0
    err: s32 = 0
    if DbCollectValues(st, args, count, marks, 1, 0, *vals[0], *n, *err) == 0 {
        return ValError(err)
    }
    return ValNumber(cast(float64)n)
}

FnDget :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    vals: [512]Val
    n: s32 = 0
    err: s32 = 0
    res: Val = Val.{VAL_EMPTY, 0.0, null, 0, 0}
    if DbCollectValues(st, args, count, marks, 0, 0, *vals[0], *n, *err) == 0 {
        return ValError(err)
    }
    if n == 0 {
        return ValError(ERR_VALUE)
    }
    res = vals[0]
    cleanup_i: s32 = 1
    while cleanup_i < n {
        if vals[cleanup_i].kind == VAL_STRING && vals[cleanup_i].text != null {
            MemoryFree(cast(*void)vals[cleanup_i].text)
        }
        cleanup_i += 1
    }
    return res
}

FnGetpivotdata :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    db_start: s32 = 0
    db_cols: s32 = 0
    db_rows: s32 = 0
    groups: s32 = 0
    fieldno: s32 = -1
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].from_range == 0 {
        return ValError(ERR_VALUE)
    }
    groups = ArgGroupCount(args, marks, count)
    if groups < 1 {
        return ValError(ERR_REF)
    }
    GroupBounds(marks, count, 0, *db_start, *db_rows)
    db_cols = st.call_group_cols[db_start]
    if db_cols < 1 {
        return ValError(ERR_REF)
    }
    db_rows = db_rows / db_cols
    if db_rows < 1 {
        return ValError(ERR_REF)
    }
    fieldno = DbFindColumn(args, db_start, db_cols, db_rows, *args[db_start + db_cols * db_rows])
    if fieldno < 0 || fieldno >= db_cols {
        return ValError(ERR_REF)
    }
    cellv: *Val = *args[db_start + (db_rows - 1) * db_cols + fieldno]
    if cellv.kind != VAL_FLOAT {
        return ValError(ERR_REF)
    }
    return ValNumber(cellv.number)
}

FnSwitch :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    ref: *Val = null
    a: s32 = 1
    matched: s32 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    ref = *args[0]
    if ref.kind == VAL_ERROR {
        return ValError(ref.err)
    }
    a = 1
    while (a + 1) < count {
        v: *Val = *args[a]
        if v.kind == VAL_ERROR {
            return ValError(v.err)
        }
        eq: s32 = 0
        if ref.kind == VAL_FLOAT && v.kind == VAL_FLOAT && ref.number == v.number {
            eq = 1
        }
        if ref.kind == VAL_STRING && v.kind == VAL_STRING && TextCompare(ref.text, v.text) == 0 {
            eq = 1
        }
        if ref.kind == VAL_BOOL && v.kind == VAL_BOOL && ref.number == v.number {
            eq = 1
        }
        if eq != 0 {
            if args[a + 1].kind == VAL_ERROR {
                return ValError(args[a + 1].err)
            }
            if args[a + 1].kind == VAL_STRING {
                return ValString(wb_strdup(args[a + 1].text))
            }
            return args[a + 1]
        }
        a += 2
    }
    if a < count {
        if args[a].kind == VAL_ERROR {
            return ValError(args[a].err)
        }
        if args[a].kind == VAL_STRING {
            return ValString(wb_strdup(args[a].text))
        }
        return args[a]
    }
    return ValError(ERR_NA)
}

FnSheetFn :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return ValNumber(1)
}

FnSheetsFn :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return ValNumber(cast(float64)st.wb.sheet_count)
}

EasterForYear :: (year: s32, y: *s32, m: *s32, d: *s32) {
    century: s32 = year / 100
    n: s32 = year - 19 * (year / 19)
    k: s32 = (century - 17) / 25
    i: s32 = century - century / 4 - (century - k) / 3 + 19 * n + 15
    j: s32 = 0
    l: s32 = 0
    i = i % 30
    i = i - (i / 28) * (1 - (i / 28) * (29 / (i + 1)) * ((21 - n) / 11))
    j = year + year / 4 + i + 2 - century + century / 4
    j = j % 7
    l = i - j
    m[0] = 3 + (l + 40) / 44
    d[0] = l + 28 - 31 * (m[0] / 4)
    y[0] = year
}

AdjustYear :: (year: s32) -> s32 {
    if year < 0 {
        return -1
    }
    if year <= 29 {
        return 2000 + year
    }
    if year <= 99 {
        return 1900 + year
    }
    if year < 1582 {
        return -1
    }
    if year > 9956 {
        return -1
    }
    return year
}

FnEaster :: (diff: s32, args: *Val, count: s32) -> Val {
    year_in: float64 = 0
    year: s32 = 0
    y: s32 = 0
    m: s32 = 0
    d: s32 = 0
    serial: s32 = 0
    if count >= 1 {
        year_in = CoerceNumber(*args[0])
        year = AdjustYear(TruncateToS32(year_in))
        if year < 0 {
            return ValError(ERR_NUM)
        }
        EasterForYear(year, *y, *m, *d)
    } else {
        return ValError(ERR_VALUE)
    }
    serial = YmdToSerial(y, m, d) + diff
    return ValNumber(cast(float64)serial)
}

FnDate2julian :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    serial: s32 = 0
    y: s32 = 0
    m: s32 = 0
    d: s32 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    serial = TruncateToS32(CoerceNumber(*args[0]))
    if serial < 61 {
        return ValError(ERR_NUM)
    }
    SerialToYmd(serial, *y, *m, *d)
    return ValNumber(cast(float64)(DaysFromCivil(y, m, d) + 2440588))
}

FnNotAvail :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return ValError(ERR_NA)
}

WeekdayMon0 :: (serial: s32) -> s32 {
    wd: s32 = (serial - 2) % 7
    if wd < 0 {
        wd += 7
    }
    return wd
}

IsoYearStart :: (y: s32) -> s32 {
    jan4: s32 = YmdToSerial(y, 1, 4)
    return jan4 - WeekdayMon0(jan4)
}

IsoWeekNum :: (serial: s32) -> s32 {
    thu: s32 = serial + 3 - WeekdayMon0(serial)
    ty: s32 = 0
    m: s32 = 0
    d: s32 = 0
    SerialToYmd(thu, *ty, *m, *d)
    return (thu - IsoYearStart(ty)) / 7 + 1
}

FnIsoWeekYear :: (which: s32, args: *Val, count: s32) -> Val {
    serial: s32 = 0
    wk: s32 = 0
    y: s32 = 0
    m: s32 = 0
    d: s32 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    serial = TruncateToS32(CoerceNumber(*args[0]))
    if serial < 1 {
        return ValError(ERR_VALUE)
    }
    if which == 0 {
        return ValNumber(cast(float64)IsoWeekNum(serial))
    }
    SerialToYmd(serial, *y, *m, *d)
    wk = IsoWeekNum(serial)
    if wk >= 52 && m == 1 {
        y -= 1
    }
    if wk == 1 && m == 12 {
        y += 1
    }
    return ValNumber(cast(float64)y)
}

IsWeekend :: (serial: s32) -> s32 {
    wd: s32 = WeekdayMon0(serial)
    if wd >= 5 {
        return 1
    }
    return 0
}

CollectHolidays :: (args: *Val, count: s32, index: s32, hol: *s32, max_n: s32) -> s32 {
    n: s32 = 0
    i: s32 = 0
    if index >= count {
        return 0
    }
    i = index
    while i < count {
        if args[i].kind == VAL_FLOAT {
            s: s32 = TruncateToS32(args[i].number)
            dup: s32 = 0
            j: s32 = 0
            while j < n {
                if hol[j] == s {
                    dup = 1
                }
                j += 1
            }
            if dup == 0 && n < max_n {
                hol[n] = s
                n += 1
            }
        }
        i += 1
    }
    return n
}

FnWorkday :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    serial: s32 = 0
    days: float64 = 0
    idays: s32 = 0
    hol: [256]s32
    nhol: s32 = 0
    step: s32 = 0
    moved: s32 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    serial = TruncateToS32(CoerceNumber(*args[0]))
    days = CoerceNumber(*args[1])
    idays = TruncateToS32(days)
    nhol = CollectHolidays(args, count, 2, *hol[0], 256)
    if idays == 0 {
        return ValNumber(cast(float64)serial)
    }
    step = ifx idays > 0 then 1 else (-1)
    while moved < (ifx idays > 0 then idays else (-idays)) {
        serial += step
        if IsWeekend(serial) == 0 {
            ishol: s32 = 0
            k: s32 = 0
            while k < nhol {
                if hol[k] == serial {
                    ishol = 1
                }
                k += 1
            }
            if ishol == 0 {
                moved += 1
            }
        }
    }
    return ValNumber(cast(float64)serial)
}

FnNetworkdays :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    start_s: s32 = 0
    end_s: s32 = 0
    total: s32 = 0
    hol: [256]s32
    nhol: s32 = 0
    s: s32 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    start_s = TruncateToS32(CoerceNumber(*args[0]))
    end_s = TruncateToS32(CoerceNumber(*args[1]))
    if start_s > end_s {
        t: s32 = start_s
        start_s = end_s
        end_s = t
    }
    nhol = CollectHolidays(args, count, 2, *hol[0], 256)
    s = start_s
    while s <= end_s {
        if IsWeekend(s) == 0 {
            ishol: s32 = 0
            k: s32 = 0
            while k < nhol {
                if hol[k] == s {
                    ishol = 1
                }
                k += 1
            }
            if ishol == 0 {
                total += 1
            }
        }
        s += 1
    }
    return ValNumber(cast(float64)total)
}

FnIsNontext :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_STRING {
        return ValBool(0)
    }
    return ValBool(1)
}

FnErrorType :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    if count < 1 {
        return ValError(ERR_NA)
    }
    if args[0].kind != VAL_ERROR {
        return ValError(ERR_NA)
    }
    if args[0].err == ERR_NULL {
        return ValNumber(1)
    }
    if args[0].err == ERR_DIV0 {
        return ValNumber(2)
    }
    if args[0].err == ERR_VALUE {
        return ValNumber(3)
    }
    if args[0].err == ERR_REF {
        return ValNumber(4)
    }
    if args[0].err == ERR_NAME {
        return ValNumber(5)
    }
    if args[0].err == ERR_NUM {
        return ValNumber(6)
    }
    return ValNumber(7)
}

FnGetenv :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    name: [128]s8
    v: *s8 = null
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 0, *name[0], 128) < 0 {
        return ValError(ERR_VALUE)
    }
    v = EnvironmentValue(*name[0])
    if v == null {
        return ValError(ERR_VALUE)
    }
    return ValString(wb_strdup(v))
}

FnInfoFn :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    key: [32]s8
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 0, *key[0], 32) < 0 {
        return ValError(ERR_VALUE)
    }
    if TextCompareLiteral(*key[0], "release") == 0 {
        return ValString(wb_strdup(CText("1.12.62")))
    }
    if TextCompareLiteral(*key[0], "os-version") == 0 {
        return ValString(wb_strdup(CText("Linux")))
    }
    if TextCompareLiteral(*key[0], "version") == 0 {
        return ValNumber(1)
    }
    return ValError(ERR_VALUE)
}

FnIlog :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    x: float64 = 0
    b: float64 = 0
    r: float64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    x = CoerceNumber(*args[0])
    b = ifx count >= 2 then CoerceNumber(*args[1]) else 2
    if b <= 1 || x < 1 {
        return ValError(ERR_NUM)
    }
    r = Floor(Log(x) / Log(b))
    while Pow(b, r + 1) <= x {
        r += 1
    }
    while Pow(b, r) > x {
        r -= 1
    }
    return ValNumber(r)
}

FnLambertw :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    x: float64 = 0
    k: s32 = 0
    w: float64 = 0
    wmin: float64 = 0
    wmax: float64 = 0
    i: s32 = 0
    one_over_e: float64 = 1 / 2.718281828459045235360287
    sqooe: float64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    x = CoerceNumber(*args[0])
    k = ifx count >= 2 then TruncateToS32(CoerceNumber(*args[1])) else 0
    sqooe = Sqrt(1 / 2.718281828459045235360287)
    if x != x || x < -one_over_e {
        return ValError(ERR_NUM)
    }
    if x == -one_over_e {
        return ValNumber(-1)
    }
    if k == 0 {
        if x < 0 {
            w = 1.5 * (Sqrt(x + one_over_e) - sqooe)
        } else if x < 10 {
            w = Sqrt(x) / 1.7
        } else {
            w = Log(x) - Log(Log(x))
        }
        wmin = -1
        wmax = 1e308 * 10
    } else if k == -1 {
        if x >= 0 {
            return ValError(ERR_NUM)
        }
        if x < -0.1 {
            w = -1 - 3 * Sqrt(x + one_over_e)
        } else {
            w = Log(-x) - Log(0 - Log(-x))
        }
        wmin = -1e308 * 10
        wmax = -1
    } else {
        return ValError(ERR_NUM)
    }
    i = 0
    while i < 20 {
        ew: float64 = Exp(w)
        wew: float64 = w * ew
        d1: float64 = ew * (w + 1)
        d2: float64 = ew * (w + 2)
        wold: float64 = w
        dw: float64 = (-2 * ((wew - x) * d1)) / (2 * d1 * d1 - (wew - x) * d2)
        w += dw
        if w <= wmin || w >= wmax {
            l: float64 = ifx w < wmin then wmin else wmax
            dw = ((l - wold) * 15) / 16
            w = wold + dw
        }
        if Fabs(dw) <= (2 * 2.2204460492503131e-16 * Fabs(w)) {
            break
        }
        i += 1
    }
    return ValNumber(w)
}

FnClean :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    txt: [512]s8
    out: [512]s8
    n: s32 = 0
    i: s32 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 0, *txt[0], 512) < 0 {
        return ValError(ERR_VALUE)
    }
    i = 0
    while txt[i] != 0 {
        if cast(u8)txt[i] >= 32 {
            out[n] = txt[i]
            n += 1
        }
        i += 1
    }
    out[n] = 0
    return ValString(wb_strdup(*out[0]))
}

Utf8Encode :: (cp: s32, out: *s8) -> s32 {
    if cp < 0 {
        return 0
    }
    if cp < 128 {
        out[0] = cast(s8)cp
        out[1] = 0
        return 1
    }
    if cp < 2048 {
        out[0] = cast(s8)(192 | (cp >> 6))
        out[1] = cast(s8)(128 | (cp & 63))
        out[2] = 0
        return 2
    }
    if cp < 65536 {
        out[0] = cast(s8)(224 | (cp >> 12))
        out[1] = cast(s8)(128 | ((cp >> 6) & 63))
        out[2] = cast(s8)(128 | (cp & 63))
        out[3] = 0
        return 3
    }
    if cp < 1114112 {
        out[0] = cast(s8)(240 | (cp >> 18))
        out[1] = cast(s8)(128 | ((cp >> 12) & 63))
        out[2] = cast(s8)(128 | ((cp >> 6) & 63))
        out[3] = cast(s8)(128 | (cp & 63))
        out[4] = 0
        return 4
    }
    return 0
}

Utf8Decode1 :: (s: *s8) -> s32 {
    b0: s32 = cast(s32)(cast(u8)s[0])
    if b0 < 128 {
        return b0
    }
    if (b0 & 224) == 192 {
        return ((b0 & 31) << 6) | (cast(s32)(cast(u8)s[1]) & 63)
    }
    if (b0 & 240) == 224 {
        return (((b0 & 15) << 12) | ((cast(s32)(cast(u8)s[1]) & 63) << 6)) | (cast(s32)(cast(u8)s[2]) & 63)
    }
    if (b0 & 248) == 240 {
        return ((((b0 & 7) << 18) | ((cast(s32)(cast(u8)s[1]) & 63) << 12)) | ((cast(s32)(cast(u8)s[2]) & 63) << 6)) | (cast(s32)(cast(u8)s[3]) & 63)
    }
    return b0
}

FnUnichar :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    out: [8]s8
    n: s32 = 0
    cp: s32 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    cp = TruncateToS32(CoerceNumber(*args[0]))
    if cp < 0 || cp > 1114111 {
        return ValError(ERR_VALUE)
    }
    if cp >= 55296 && cp <= 57343 {
        return ValError(ERR_VALUE)
    }
    n = Utf8Encode(cp, *out[0])
    if n == 0 {
        return ValError(ERR_VALUE)
    }
    return ValString(wb_strdup(*out[0]))
}

FnUnicode :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    txt: [512]s8
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 0, *txt[0], 512) < 0 {
        return ValError(ERR_VALUE)
    }
    if txt[0] == 0 {
        return ValError(ERR_VALUE)
    }
    return ValNumber(cast(float64)Utf8Decode1(*txt[0]))
}

FnTextjoin :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    delim: [64]s8
    ignore_empty: s32 = 1
    out: [2048]s8
    n: s32 = 0
    first: s32 = 1
    i: s32 = 2
    piece: [512]s8
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 0, *delim[0], 64) < 0 {
        return ValError(ERR_VALUE)
    }
    if count >= 2 {
        ignore_empty = ifx CoerceNumber(*args[1]) != 0 then 1 else 0
    }
    while i < count {
        if args[i].kind == VAL_ERROR {
            return ValError(args[i].err)
        }
        if args[i].kind == VAL_FLOAT {
            FormatNumber(args[i].number, *piece[0], 512)
        } else if args[i].kind == VAL_STRING {
            FormatText(*piece[0], 512, CText("%s"), args[i].text)
        } else {
            piece[0] = 0
        }
        if piece[0] != 0 || ignore_empty == 0 {
            if first == 0 {
                n = cast(s32)TextLength(*out[0])
                FormatText(*out[n], 2048 - cast(u64)n, CText("%s"), *delim[0])
            }
            n = cast(s32)TextLength(*out[0])
            FormatText(*out[n], 2048 - cast(u64)n, CText("%s"), *piece[0])
            first = 0
        }
        i += 1
    }
    return ValString(wb_strdup(*out[0]))
}

FnArabic :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    txt: [256]s8
    result: s32 = 0
    last: s32 = 0
    i: s32 = 0
    this_val: s32 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 0, *txt[0], 256) < 0 {
        return ValError(ERR_VALUE)
    }
    i = cast(s32)TextLength(*txt[0]) - 1
    while i >= 0 {
        this_val = 0
        if txt[i] == 105 || txt[i] == 73 {
            this_val = 1
        }
        if txt[i] == 118 || txt[i] == 86 {
            this_val = 5
        }
        if txt[i] == 120 || txt[i] == 88 {
            this_val = 10
        }
        if txt[i] == 108 || txt[i] == 76 {
            this_val = 50
        }
        if txt[i] == 99 || txt[i] == 67 {
            this_val = 100
        }
        if txt[i] == 100 || txt[i] == 68 {
            this_val = 500
        }
        if txt[i] == 109 || txt[i] == 77 {
            this_val = 1000
        }
        if this_val > 0 {
            if this_val < last {
                result -= this_val
            } else {
                result += this_val
                last = this_val
            }
        }
        i -= 1
    }
    return ValNumber(cast(float64)result)
}

RomanSub2 :: (buf: *s8, find: *s8, a: s32, b: s32, shrink: s32) {
    p: *s8 = TextFind(buf, find)
    i: s32 = 0
    j: s32 = 0
    if p == null {
        return
    }
    i = cast(s32)(cast(s64)(cast(u64)p - cast(u64)buf))
    buf[i] = cast(s8)a
    buf[i + 1] = cast(s8)b
    j = i + 2
    while buf[j + shrink] != 0 {
        buf[j] = buf[j + shrink]
        j += 1
    }
    buf[j] = 0
}

RomanSub3 :: (buf: *s8, find: *s8, a: s32, b: s32, c: s32, shrink: s32) {
    p: *s8 = TextFind(buf, find)
    i: s32 = 0
    j: s32 = 0
    if p == null {
        return
    }
    i = cast(s32)(cast(s64)(cast(u64)p - cast(u64)buf))
    buf[i] = cast(s8)a
    buf[i + 1] = cast(s8)b
    buf[i + 2] = cast(s8)c
    j = i + 3
    while buf[j + shrink] != 0 {
        buf[j] = buf[j + shrink]
        j += 1
    }
    buf[j] = 0
}

RomanSub4 :: (buf: *s8, find: *s8, c0: s32, c1: s32, c2: s32, c3: s32) {
    p: *s8 = TextFind(buf, find)
    i: s32 = 0
    if p == null {
        return
    }
    i = cast(s32)(cast(s64)(cast(u64)p - cast(u64)buf))
    buf[i] = cast(s8)c0
    buf[i + 1] = cast(s8)c1
    buf[i + 2] = cast(s8)c2
    buf[i + 3] = cast(s8)c3
}

FnRoman :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    letter: [7]s8 = .[77, 68, 67, 76, 88, 86, 73]
    buf: [256]s8
    n: float64 = 0
    form: float64 = 0
    dec: s32 = 1000
    i: s32 = 0
    j: s32 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    n = Floor(CoerceNumber(*args[0]))
    form = ifx count >= 2 then Floor(CoerceNumber(*args[1])) else 0
    if n < 0 || n > 3999 {
        return ValError(ERR_VALUE)
    }
    if form < 0 || form > 4 {
        return ValError(ERR_VALUE)
    }
    if n == 0 {
        return ValString(wb_strdup(CText("")))
    }
    dec = 1000
    j = 0
    while dec > 1 {
        while n > 0 {
            if n >= cast(float64)dec {
                buf[i] = letter[j]
                i += 1
                n -= cast(float64)dec
            } else if n >= cast(float64)(dec - dec / 10) {
                buf[i] = letter[j + 2]
                i += 1
                buf[i] = letter[j]
                i += 1
                n -= cast(float64)(dec - dec / 10)
            } else if n >= cast(float64)(dec / 2) {
                buf[i] = letter[j + 1]
                i += 1
                n -= cast(float64)(dec / 2)
            } else if n >= cast(float64)(dec / 2 - dec / 10) {
                buf[i] = letter[j + 2]
                i += 1
                buf[i] = letter[j + 1]
                i += 1
                n -= cast(float64)(dec / 2 - dec / 10)
            } else if dec == 10 {
                buf[i] = letter[j + 2]
                i += 1
                n -= 1
            } else {
                break
            }
        }
        dec /= 10
        j += 2
    }
    buf[i] = 0
    if form > 0 {
        RomanSub2(*buf[0], CText("XLV"), 86, 76, 1)
        RomanSub2(*buf[0], CText("XCV"), 86, 67, 1)
        RomanSub2(*buf[0], CText("CDL"), 76, 68, 1)
        RomanSub2(*buf[0], CText("CML"), 76, 77, 1)
        RomanSub4(*buf[0], CText("CMVC"), 76, 77, 86, 76)
    }
    if form == 1 {
        RomanSub4(*buf[0], CText("CDXC"), 76, 68, 88, 76)
        RomanSub4(*buf[0], CText("CDVC"), 76, 68, 86, 76)
        RomanSub4(*buf[0], CText("CMXC"), 76, 77, 88, 76)
        RomanSub4(*buf[0], CText("XCIX"), 86, 67, 73, 86)
        RomanSub4(*buf[0], CText("XLIX"), 86, 76, 73, 86)
    }
    if form > 1 {
        RomanSub2(*buf[0], CText("XLIX"), 73, 76, 2)
        RomanSub2(*buf[0], CText("XCIX"), 73, 67, 2)
        RomanSub2(*buf[0], CText("CDXC"), 88, 68, 2)
        RomanSub2(*buf[0], CText("CDVC"), 88, 68, 1)
        RomanSub4(*buf[0], CText("CDIC"), 88, 68, 73, 88)
        RomanSub3(*buf[0], CText("LMVL"), 88, 77, 86, 1)
        RomanSub4(*buf[0], CText("CMIC"), 88, 77, 73, 88)
        RomanSub2(*buf[0], CText("CMXC"), 88, 77, 2)
    }
    if form > 2 {
        RomanSub2(*buf[0], CText("XDV"), 86, 68, 1)
        RomanSub4(*buf[0], CText("XDIX"), 86, 68, 73, 86)
        RomanSub2(*buf[0], CText("XMV"), 86, 77, 1)
        RomanSub4(*buf[0], CText("XMIX"), 86, 77, 73, 86)
    }
    if form == 4 {
        RomanSub2(*buf[0], CText("VDIV"), 73, 68, 2)
        RomanSub2(*buf[0], CText("VMIV"), 73, 77, 2)
    }
    return ValString(wb_strdup(*buf[0]))
}

FnEncodeurl :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    txt: [512]s8
    out: [2048]s8
    n: s32 = 0
    i: s32 = 0
    c: s32 = 0
    hexd: *s8 = CText("0123456789ABCDEF")
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 0, *txt[0], 512) < 0 {
        return ValError(ERR_VALUE)
    }
    if txt[0] == 0 {
        return ValError(ERR_VALUE)
    }
    i = 0
    while txt[i] != 0 {
        c = cast(s32)(cast(u8)txt[i])
        if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 || c == 46 || c == 95 || c == 126 || c == 33 || c == 36 || c == 38 || c == 39 || c == 40 || c == 41 || c == 42 || c == 43 || c == 44 || c == 59 || c == 61 || c == 58 || c == 64 || c == 47 {
            out[n] = cast(s8)c
            n += 1
        } else {
            out[n] = 37
            out[n + 1] = hexd[c >> 4]
            out[n + 2] = hexd[c & 15]
            n += 3
        }
        i += 1
    }
    out[n] = 0
    return ValString(wb_strdup(*out[0]))
}

FnLenb :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    txt: [512]s8
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 0, *txt[0], 512) < 0 {
        return ValError(ERR_VALUE)
    }
    return ValNumber(cast(float64)TextLength(*txt[0]))
}

FnLeftb :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    txt: [512]s8
    out: [512]s8
    cnt: float64 = 1
    icount: s32 = 0
    len: s32 = 0
    newlen: s32 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 0, *txt[0], 512) < 0 {
        return ValError(ERR_VALUE)
    }
    cnt = ifx count >= 2 then CoerceNumber(*args[1]) else 1
    if cnt < 0 {
        return ValError(ERR_VALUE)
    }
    icount = TruncateToS32(cnt)
    len = cast(s32)TextLength(*txt[0])
    if icount >= len {
        return ValString(wb_strdup(*txt[0]))
    }
    newlen = icount
    while newlen > 0 && (cast(s32)(cast(u8)txt[newlen]) & 192) == 128 {
        newlen -= 1
    }
    MemoryCopy(cast(*void)(*out[0]), cast(*void)(*txt[0]), cast(u64)newlen)
    out[newlen] = 0
    return ValString(wb_strdup(*out[0]))
}

FnRightb :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    txt: [512]s8
    cnt: float64 = 1
    icount: s32 = 0
    len: s32 = 0
    start: s32 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 0, *txt[0], 512) < 0 {
        return ValError(ERR_VALUE)
    }
    cnt = ifx count >= 2 then CoerceNumber(*args[1]) else 1
    if cnt < 0 {
        return ValError(ERR_VALUE)
    }
    icount = TruncateToS32(cnt)
    len = cast(s32)TextLength(*txt[0])
    if icount >= len {
        return ValString(wb_strdup(*txt[0]))
    }
    start = len - icount
    while start < len && (cast(s32)(cast(u8)txt[start]) & 192) == 128 {
        start += 1
    }
    return ValString(wb_strdup(*txt[start]))
}

FnMidb :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    txt: [512]s8
    out: [512]s8
    pos: float64 = 0
    cnt: float64 = 0
    ipos: s32 = 0
    icnt: s32 = 0
    len: s32 = 0
    start: s32 = 0
    endp: s32 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 0, *txt[0], 512) < 0 {
        return ValError(ERR_VALUE)
    }
    pos = CoerceNumber(*args[1])
    cnt = CoerceNumber(*args[2])
    if pos < 1 || cnt < 0 {
        return ValError(ERR_VALUE)
    }
    ipos = TruncateToS32(pos)
    icnt = TruncateToS32(cnt)
    len = cast(s32)TextLength(*txt[0])
    if ipos > len {
        return ValError(ERR_VALUE)
    }
    start = ipos - 1
    while start < len && (cast(s32)(cast(u8)txt[start]) & 192) == 128 {
        start += 1
    }
    endp = start + icnt
    if endp > len {
        endp = len
    }
    while endp > start && endp < len && (cast(s32)(cast(u8)txt[endp]) & 192) == 128 {
        endp -= 1
    }
    MemoryCopy(cast(*void)(*out[0]), cast(*void)(*txt[start]), cast(u64)(endp - start))
    out[endp - start] = 0
    return ValString(wb_strdup(*out[0]))
}

FnNumbervalueUnused :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    txt: [256]s8
    sep: [8]s8
    TextSet(*sep[0], ".")
    grp: [8]s8
    TextSet(*grp[0], ",")
    out: [256]s8
    n: s32 = 0
    i: s32 = 0
    v: float64 = 0
    end: *s8 = null
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    if args[0].kind == VAL_FLOAT {
        return ValNumber(args[0].number)
    }
    if TextArg(args, count, 0, *txt[0], 256) < 0 {
        return ValError(ERR_VALUE)
    }
    if count >= 2 {
        if TextArg(args, count, 1, *sep[0], 8) < 0 {
            return ValError(ERR_VALUE)
        }
    }
    if count >= 3 {
        if TextArg(args, count, 2, *grp[0], 8) < 0 {
            return ValError(ERR_VALUE)
        }
    }
    if TextCompare(*sep[0], *grp[0]) == 0 {
        return ValError(ERR_VALUE)
    }
    i = 0
    while txt[i] != 0 {
        c: s32 = cast(s32)(cast(u8)txt[i])
        if c == 32 {
            i += 1
            continue
        }
        if grp[0] != 0 && c == cast(s32)(cast(u8)grp[0]) && sep[0] != 0 {
            i += 1
            continue
        }
        if sep[0] != 0 && c == cast(s32)(cast(u8)sep[0]) {
            out[n] = 46
        } else {
            out[n] = cast(s8)c
        }
        n += 1
        i += 1
    }
    out[n] = 0
    v = ParseDouble(*out[0], *end)
    if end == (*out[0]) || end[0] != 0 {
        return ValError(ERR_VALUE)
    }
    return ValNumber(v)
}

GoTanpi :: (x_in: float64) -> float64 {
    x: float64 = x_in
    x = Fmod(x, 1.0)
    if x == 0 {
        return Copysign(0.0, x)
    }
    if Fabs(x) == 0.5 {
        return Copysign(0.0 / 0.0, x)
    }
    return GoSinpi(x) / GoCosPi(x)
}

GoCotpi :: (x_in: float64) -> float64 {
    x: float64 = x_in
    x = Fmod(x, 1.0)
    if x == 0 {
        return Copysign(0.0 / 0.0, x)
    }
    if Fabs(x) == 0.5 {
        return Copysign(0.0, x)
    }
    return GoCosPi(x) / GoSinpi(x)
}

FnMath1 :: (op: s32, args: *Val, count: s32) -> Val {
    v: float64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    v = CoerceNumber(*args[0])
    if op == 0 {
        return ValNumber(Atan(1 / v))
    }
    if op == 1 {
        if Fabs(v) > 2 {
            return ValNumber(0.5 * Log1p(2 / (v - 1)))
        }
        return ValNumber(0.5 * Log((v + 1) / (v - 1)))
    }
    if op == 2 {
        return ValNumber(Acosh(v))
    }
    if op == 3 {
        return ValNumber(Asinh(v))
    }
    if op == 4 {
        return ValNumber(Atanh(v))
    }
    if op == 5 {
        return ValNumber(Expm1(v))
    }
    if op == 6 {
        return ValNumber(Log2(v))
    }
    if op == 7 {
        return ValNumber(Sqrt(v * 3.141592653589793))
    }
    if op == 8 {
        return ValNumber(GoSinpi(v))
    }
    if op == 9 {
        return ValNumber(GoCosPi(v))
    }
    if op == 10 {
        return ValNumber(GoTanpi(v))
    }
    return ValNumber(GoCotpi(v))
}

FnHypot :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    a: float64 = 0
    b: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    a = CoerceNumber(*args[0])
    b = CoerceNumber(*args[1])
    return ValNumber(Hypot(a, b))
}

FnCeiling :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    x: float64 = 0
    s: float64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    x = CoerceNumber(*args[0])
    s = ifx count >= 2 then CoerceNumber(*args[1]) else (cast(float64)(ifx x > 0 then 1 else (-1)))
    if x == 0 || s == 0 {
        return ValNumber(0)
    }
    if x > 0 && s < 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber(Ceil(x / s) * s)
}

FnMround :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    number: float64 = 0
    multiple: float64 = 0
    sign: s32 = 1
    mod: float64 = 0
    div: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    number = CoerceNumber(*args[0])
    multiple = CoerceNumber(*args[1])
    if multiple == 0 {
        return ValNumber(0)
    }
    if (number > 0 && multiple < 0) || (number < 0 && multiple > 0) {
        return ValError(ERR_NUM)
    }
    if number < 0 {
        sign = -1
        number = -number
        multiple = -multiple
    }
    mod = Fmod(number, multiple)
    div = (ifx mod >= (multiple / 2) then multiple else 0) + (number - mod)
    return ValNumber(cast(float64)sign * div)
}

FnIsEvenOdd :: (even: s32, args: *Val, count: s32) -> Val {
    v: float64 = 0
    r: float64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    v = CoerceNumber(*args[0])
    r = Fmod(Fabs(v), 2)
    if even != 0 {
        return ValBool(ifx r < 1 then 1 else 0)
    }
    return ValBool(ifx r >= 1 then 1 else 0)
}

FnPairAgg :: (op: s32, args: *Val, count: s32, marks: *s32) -> Val {
    xs: [4096]float64
    ys: [4096]float64
    s: float64 = 0
    i: s32 = 0
    n: s32 = 0
    gx: s32 = 0
    gl: s32 = 0
    hy: s32 = 0
    hl: s32 = 0
    xn: s32 = 0
    yn: s32 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    if args[0].from_range != 0 || args[1].from_range != 0 {
        return ValError(ERR_VALUE)
    }
    if GroupBounds(marks, count, 0, *gx, *gl) == 0 {
        return ValError(ERR_VALUE)
    }
    if GroupBounds(marks, count, 1, *hy, *hl) == 0 {
        return ValError(ERR_VALUE)
    }
    xn = CashList(*args[gx], gl, *xs[0])
    yn = CashList(*args[hy], hl, *ys[0])
    if xn < 0 || yn < 0 {
        return ValError(ERR_VALUE)
    }
    if xn != yn || xn == 0 {
        return ValError(ERR_NA)
    }
    n = xn
    i = 0
    while i < n {
        if op == 0 {
            s += xs[i] * xs[i] - ys[i] * ys[i]
        } else if op == 1 {
            s += xs[i] * xs[i] + ys[i] * ys[i]
        } else {
            s += (xs[i] - ys[i]) * (xs[i] - ys[i])
        }
        i += 1
    }
    return ValNumber(s)
}

FnSumsq :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    list: NumList
    s: float64 = 0
    i: s32 = 0
    CollectNumbers(args, count, *list)
    while i < list.count {
        s += list.data[i] * list.data[i]
        i += 1
    }
    return ValNumber(s)
}

FnMultinomial :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    list: NumList
    result: float64 = 1
    sum: s32 = 0
    i: s32 = 0
    j: s32 = 0
    CollectNumbers(args, count, *list)
    while i < list.count {
        x: float64 = list.data[i]
        xi: s32 = 0
        if x < 0 || x > 2147483647 {
            return ValError(ERR_NUM)
        }
        xi = TruncateToS32(x)
        if sum != 0 && xi != 0 {
            f: s32 = sum + xi
            result *= cast(float64)f
            f -= 1
            j = 2
            while j <= xi {
                result = (result * cast(float64)f) / cast(float64)j
                f -= 1
                j += 1
            }
        }
        sum += xi
        i += 1
    }
    return ValNumber(result)
}

CxParse :: (src_in: *s8, dst: *Cplx, unit: *s32) -> s32 {
    src: *s8 = src_in
    end: *s8 = null
    x: float64 = 0
    y: float64 = 0
    sign: s32 = 0
    unit[0] = 105
    dst.re = 0
    dst.im = 0
    while src[0] == 32 || (src[0] >= 9 && src[0] <= 13) {
        src = *src[1]
    }
    if src[0] == 45 {
        sign = -1
        src = *src[1]
        while src[0] == 32 || (src[0] >= 9 && src[0] <= 13) {
            src = *src[1]
        }
    } else if src[0] == 43 {
        sign = 1
        src = *src[1]
        while src[0] == 32 || (src[0] >= 9 && src[0] <= 13) {
            src = *src[1]
        }
    } else {
        sign = 0
    }
    if src[0] == 105 || src[0] == 106 {
        x = 1
    } else {
        x = ParseDouble(src, *end)
        if end == src || (x - x) != 0 {
            return -1
        }
        src = end
        while src[0] == 32 || (src[0] >= 9 && src[0] <= 13) {
            src = *src[1]
        }
    }
    if sign < 0 {
        x = 0 - x
    }
    if src[0] == 0 {
        dst.re = x
        dst.im = 0
        unit[0] = 105
        return 0
    }
    if (src[0] == 105 || src[0] == 106) && src[1] == 0 {
        unit[0] = cast(s32)src[0]
        dst.re = 0
        dst.im = x
        return 0
    }
    if src[0] == 43 {
        sign = 1
        src = *src[1]
        while src[0] == 32 || (src[0] >= 9 && src[0] <= 13) {
            src = *src[1]
        }
    } else if src[0] == 45 {
        sign = -1
        src = *src[1]
        while src[0] == 32 || (src[0] >= 9 && src[0] <= 13) {
            src = *src[1]
        }
    } else {
        return -1
    }
    if src[0] == 105 || src[0] == 106 {
        y = 1
    } else {
        y = ParseDouble(src, *end)
        if end == src || (y - y) != 0 {
            return -1
        }
        src = end
        while src[0] == 32 || (src[0] >= 9 && src[0] <= 13) {
            src = *src[1]
        }
    }
    if sign < 0 {
        y = 0 - y
    }
    if (src[0] == 105 || src[0] == 106) && src[1] == 0 {
        unit[0] = cast(s32)src[0]
        dst.re = x
        dst.im = y
        return 0
    }
    return -1
}

CxArg :: (args: *Val, count: s32, index: s32, dst: *Cplx, unit: *s32) -> s32 {
    txt: [256]s8
    if index >= count {
        return -1
    }
    if args[index].kind == VAL_FLOAT || args[index].kind == VAL_BOOL {
        dst.re = args[index].number
        dst.im = 0
        return 0
    }
    if TextArg(args, count, index, *txt[0], 256) < 0 {
        return -1
    }
    return CxParse(*txt[0], dst, unit)
}

CxToString :: (c: Cplx, unit: s32, out: *s8, cap: s32) {
    have_real: s32 = 0
    tmp: [64]s8
    n: s32 = 0
    out[0] = 0
    if c.re != 0 || c.im == 0 {
        FormatNumber(c.re, *tmp[0], 64)
        FormatText(out, cast(u64)cap, CText("%s"), *tmp[0])
        have_real = 1
    }
    if c.im != 0 {
        if c.im == 1 {
            if have_real != 0 {
                n = cast(s32)TextLength(out)
                FormatText(*out[n], cast(u64)(cap - n), CText("+"))
            }
        } else if c.im == -1 {
            n = cast(s32)TextLength(out)
            FormatText(*out[n], cast(u64)(cap - n), CText("-"))
        } else {
            FormatNumber(c.im, *tmp[0], 64)
            n = cast(s32)TextLength(out)
            if have_real != 0 && tmp[0] != 45 && tmp[0] != 43 {
                if c.im >= 0 {
                    FormatText(*out[n], cast(u64)(cap - n), CText("+%s"), *tmp[0])
                } else {
                    FormatText(*out[n], cast(u64)(cap - n), CText("%s"), *tmp[0])
                }
            } else {
                FormatText(*out[n], cast(u64)(cap - n), CText("%s"), *tmp[0])
            }
        }
        n = cast(s32)TextLength(out)
        out[n] = cast(s8)unit
        out[n + 1] = 0
    }
}

CxVal :: (c: Cplx, unit: s32) -> Val {
    buf: [128]s8
    if (c.re - c.re) != 0 || (c.im - c.im) != 0 {
        return ValError(ERR_NUM)
    }
    CxToString(c, unit, *buf[0], 128)
    return ValString(wb_strdup(*buf[0]))
}

CxAdd :: (a: Cplx, b: Cplx) -> Cplx {
    r: Cplx = Cplx.{a.re + b.re, a.im + b.im}
    return r
}

CxSub :: (a: Cplx, b: Cplx) -> Cplx {
    r: Cplx = Cplx.{a.re - b.re, a.im - b.im}
    return r
}

CxNeg :: (a: Cplx) -> Cplx {
    r: Cplx = Cplx.{0 - a.re, 0 - a.im}
    return r
}

CxConj :: (a: Cplx) -> Cplx {
    r: Cplx = Cplx.{a.re, 0 - a.im}
    return r
}

CxScale :: (a: Cplx, s: float64) -> Cplx {
    r: Cplx = Cplx.{a.re * s, a.im * s}
    return r
}

CxMul :: (a: Cplx, b: Cplx) -> Cplx {
    r: Cplx = Cplx.{a.re * b.re - a.im * b.im, a.re * b.im + a.im * b.re}
    return r
}

CxMulImag :: (a: Cplx, y: float64) -> Cplx {
    r: Cplx = Cplx.{0 - y * a.im, y * a.re}
    return r
}

CxDiv :: (a: Cplx, b: Cplx) -> Cplx {
    a_re: float64 = a.re
    a_im: float64 = a.im
    b_re: float64 = b.re
    b_im: float64 = b.im
    asize: float64 = ifx Fabs(a_re) > Fabs(a_im) then Fabs(a_re) else Fabs(a_im)
    bsize: float64 = ifx Fabs(b_re) > Fabs(b_im) then Fabs(b_re) else Fabs(b_im)
    bmodsqr: float64 = 0
    q_re: float64 = 0
    q_im: float64 = 0
    e: s32 = 0
    r: Cplx = Cplx.{0.0 / 0.0, 0.0 / 0.0}
    if (asize - asize) != 0 || (bsize - bsize) != 0 || bsize == 0 {
        return r
    }
    if b_im == 0 {
        r.re = a_re / b_re
        r.im = a_im / b_re
        return r
    }
    if b_re == 0 {
        r.re = a_im / b_im
        r.im = 0 - a_re / b_im
        return r
    }
    if (asize + bsize) > 1e100 || asize < 1e-100 || bsize < 1e-100 {
        ea: s32 = Ilogb(asize)
        eb: s32 = Ilogb(bsize)
        a_re = Scalbn(a_re, -ea)
        a_im = Scalbn(a_im, -ea)
        b_re = Scalbn(b_re, -eb)
        b_im = Scalbn(b_im, -eb)
        e = ea - eb
    }
    bmodsqr = b_re * b_re + b_im * b_im
    q_re = (a_re * b_re + a_im * b_im) / bmodsqr
    q_im = (a_im * b_re - a_re * b_im) / bmodsqr
    if e != 0 {
        q_re = Scalbn(q_re, e)
        q_im = Scalbn(q_im, e)
    }
    r.re = q_re
    r.im = q_im
    return r
}

CxInv :: (a: Cplx) -> Cplx {
    one: Cplx = Cplx.{1, 0}
    return CxDiv(one, a)
}

CxMod :: (a: Cplx) -> float64 {
    return Hypot(a.re, a.im)
}

CxAngle :: (a: Cplx) -> float64 {
    return Atan2(a.im, a.re)
}

CxAnglePi :: (a: Cplx) -> float64 {
    return GoAtan2Pi(a.im, a.re)
}

CxFromPolar :: (mod: float64, angle: float64) -> Cplx {
    r: Cplx = Cplx.{mod * Cos(angle), mod * Sin(angle)}
    return r
}

CxFromPolarPi :: (mod: float64, angle: float64) -> Cplx {
    r: Cplx = Cplx.{mod * GoCosPi(angle), mod * GoSinpi(angle)}
    return r
}

CxSqrt :: (a: Cplx) -> Cplx {
    msrc: Cplx
    rr: Cplx
    m: float64 = 0
    sm: float64 = 0
    r: Cplx
    if a.re < 0 && (0 - a.re) > Fabs(a.im) {
        msrc.re = 0 - a.re
        msrc.im = 0 - a.im
        rr = CxSqrt(msrc)
        if a.im >= 0 {
            r.re = 0 - rr.im
            r.im = rr.re
        } else {
            r.re = rr.im
            r.im = 0 - rr.re
        }
        return r
    }
    m = CxMod(a)
    if (m - m) == 0 {
        sm = Sqrt(m)
    } else {
        sm = 2 * Sqrt(Hypot(a.re / 4, a.im / 4))
    }
    return CxFromPolarPi(sm, CxAnglePi(a) / 2)
}

CxExp :: (a: Cplx) -> Cplx {
    return CxFromPolar(Exp(a.re), a.im)
}

CxLn :: (a: Cplx) -> Cplx {
    x: float64 = Fabs(a.re)
    y: float64 = Fabs(a.im)
    lm: float64 = 0
    r: Cplx
    if x > y {
        lm = Log(x) + 0.5 * Log1p((y / x) * (y / x))
    } else {
        lm = Log(y) + 0.5 * Log1p((x / y) * (x / y))
    }
    r.re = lm
    r.im = CxAngle(a)
    return r
}

CxSin :: (a: Cplx) -> Cplx {
    r: Cplx = Cplx.{Sin(a.re) * Cosh(a.im), Cos(a.re) * Sinh(a.im)}
    return r
}

CxCos :: (a: Cplx) -> Cplx {
    r: Cplx = Cplx.{Cos(a.re) * Cosh(a.im), 0 - Sin(a.re) * Sinh(a.im)}
    return r
}

CxTan :: (a: Cplx) -> Cplx {
    R: float64 = a.re
    I: float64 = a.im
    sr: float64 = Sin(R)
    cr: float64 = Cos(R)
    r: Cplx
    if Fabs(I) < 1 {
        shi: float64 = Sinh(I)
        D: float64 = cr * cr + shi * shi
        r.re = (sr * cr) / D
        r.im = (0.5 * Sinh(2 * I)) / D
    } else {
        u: float64 = Exp(0 - Fabs(I))
        C: float64 = (2 * u) / (1 - u * u)
        S: float64 = C * C
        D: float64 = 1 + cr * cr * S
        T: float64 = 1 / Tanh(Fabs(I))
        r.re = (sr * cr * S) / D
        if I < 0 {
            r.im = 0 - T / D
        } else {
            r.im = T / D
        }
    }
    return r
}

CxPowInt :: (x: Cplx, n: s32) -> Cplx {
    res: Cplx = Cplx.{1, 0}
    xn: Cplx = x
    dy: s32 = n
    while dy > 0 {
        if (dy % 2) != 0 {
            res = CxMul(res, xn)
            dy -= 1
            if dy == 0 {
                break
            }
        }
        dy /= 2
        xn = CxMul(xn, xn)
    }
    return res
}

CxPowQuadPath :: (a: Cplx, b: Cplx) -> Cplx {
    qa: Quad
    qb: Quad
    qarg: Quad
    qr: Quad
    qrr: Quad
    qra: Quad
    qres: Quad
    qtmp1: Quad
    qtmp2: Quad
    e1: float64 = 0
    e2: float64 = 0
    er: float64 = 0
    r: Cplx
    QuadInit(*qa, a.re)
    QuadInit(*qb, a.im)
    QuadAtan2pi(*qarg, *qb, *qa)
    QuadHypot(*qr, *qa, *qb)
    QuadInit(*qa, b.re)
    QuadPow(*qa, *e1, *qr, *qa)
    QuadInit(*qb, 0 - b.im)
    QuadMul(*qtmp1, *qb, *qarg)
    QuadMul(*qtmp2, *qtmp1, *QUAD_PI_EXPORT)
    QuadExp(*qb, *e2, *qtmp2)
    QuadMul(*qrr, *qa, *qb)
    er = e1 + e2
    if er > 2147483647 || er < -2147483648 {
        er = cast(float64)(ifx er > 0 then 2147483647 else (-2147483648))
    }
    QuadScalbn(*qrr, *qrr, TruncateToS32(er))
    QuadLog(*qa, *qr)
    QuadDiv(*qa, *qa, *QUAD_2PI_EXPORT)
    QuadMulmod1(*qa, *qa, b.im)
    QuadMulmod1(*qb, *qarg, b.re / 2)
    QuadAdd(*qa, *qa, *qb)
    QuadAdd(*qra, *qa, *qa)
    qres = qra
    QuadSinpi(*qa, *qra)
    QuadMul(*qa, *qa, *qrr)
    QuadCospi(*qb, *qra)
    QuadMul(*qb, *qb, *qrr)
    r.re = QuadVal(*qb)
    r.im = QuadVal(*qa)
    return r
}

CxPow :: (a: Cplx, b: Cplx) -> Cplx {
    r: Cplx
    if b.im == 0 {
        if a.im == 0 && a.re >= 0 {
            r.re = Pow(a.re, b.re)
            r.im = 0
            return r
        }
        if b.re == 0 {
            r.re = 1
            r.im = 0
            return r
        }
        if b.re == 1 {
            return a
        }
        if b.re == 2 {
            return CxMul(a, a)
        }
        if b.re == Floor(b.re) && Fabs(b.re) < 1024 {
            n: s32 = TruncateToS32(b.re)
            if n > 0 {
                return CxPowInt(a, n)
            }
            if a.re == 0 && a.im == 0 {
                return r
            }
            return CxGslInverse(CxPowInt(a, 0 - n))
        }
    }
    return CxPowQuadPath(a, b)
}

CxSinh :: (a: Cplx) -> Cplx {
    r: Cplx = Cplx.{Sinh(a.re) * Cos(a.im), Cosh(a.re) * Sin(a.im)}
    return r
}

CxCosh :: (a: Cplx) -> Cplx {
    r: Cplx = Cplx.{Cosh(a.re) * Cos(a.im), Sinh(a.re) * Sin(a.im)}
    return r
}

CxTanh :: (a: Cplx) -> Cplx {
    R: float64 = a.re
    I: float64 = a.im
    r: Cplx
    if Fabs(R) < 1 {
        D: float64 = Pow(Cos(I), 2.0) + Pow(Sinh(R), 2.0)
        r.re = (Sinh(R) * Cosh(R)) / D
        r.im = (0.5 * Sin(2 * I)) / D
    } else {
        D2: float64 = Pow(Cos(I), 2.0) + Pow(Sinh(R), 2.0)
        F: float64 = 1 + Pow(Cos(I) / Sinh(R), 2.0)
        r.re = 1 / (Tanh(R) * F)
        r.im = (0.5 * Sin(2 * I)) / D2
    }
    return r
}

CxGslInverse :: (a: Cplx) -> Cplx {
    s: float64 = 1 / CxMod(a)
    r: Cplx = Cplx.{a.re * s * s, 0 - a.im * s * s}
    return r
}

CxSech :: (a: Cplx) -> Cplx {
    return CxGslInverse(CxCosh(a))
}

CxCsch :: (a: Cplx) -> Cplx {
    return CxGslInverse(CxSinh(a))
}

CxCoth :: (a: Cplx) -> Cplx {
    return CxGslInverse(CxTanh(a))
}

CxArcsinReal :: (a: float64) -> Cplx {
    r: Cplx
    if Fabs(a) <= 1 {
        r.re = Asin(a)
        r.im = 0
    } else {
        if a < 0 {
            r.re = 0 - 1.5707963267948966
            r.im = Acosh(0 - a)
        } else {
            r.re = 1.5707963267948966
            r.im = 0 - Acosh(a)
        }
    }
    return r
}

CxArcsin :: (a: Cplx) -> Cplx {
    R: float64 = a.re
    I: float64 = a.im
    r: Cplx
    if I == 0 {
        return CxArcsinReal(R)
    }
    x: float64 = Fabs(R)
    y: float64 = Fabs(I)
    rr: float64 = Hypot(x + 1, y)
    s: float64 = Hypot(x - 1, y)
    A: float64 = 0.5 * (rr + s)
    B: float64 = x / A
    y2: float64 = y * y
    real: float64 = 0
    imag: float64 = 0
    A_crossover: float64 = 1.5
    B_crossover: float64 = 0.6417
    if B <= B_crossover {
        real = Asin(B)
    } else {
        if x <= 1 {
            D: float64 = 0.5 * (A + x) * (y2 / (rr + x + 1) + (s + (1 - x)))
            real = Atan(x / Sqrt(D))
        } else {
            Apx: float64 = A + x
            D2: float64 = 0.5 * (Apx / (rr + x + 1) + Apx / (s + (x - 1)))
            real = Atan(x / (y * Sqrt(D2)))
        }
    }
    if A <= A_crossover {
        Am1: float64 = 0
        if x < 1 {
            Am1 = 0.5 * (y2 / (rr + (x + 1)) + y2 / (s + (1 - x)))
        } else {
            Am1 = 0.5 * (y2 / (rr + (x + 1)) + (s + (x - 1)))
        }
        imag = Log1p(Am1 + Sqrt(Am1 * (A + 1)))
    } else {
        imag = Log(A + Sqrt(A * A - 1))
    }
    r.re = ifx R >= 0 then real else (0 - real)
    r.im = ifx I >= 0 then imag else (0 - imag)
    return r
}

CxArccosReal :: (a: float64) -> Cplx {
    r: Cplx
    if Fabs(a) <= 1 {
        r.re = Acos(a)
        r.im = 0
    } else {
        if a < 0 {
            r.re = 3.141592653589793
            r.im = 0 - Acosh(0 - a)
        } else {
            r.re = 0
            r.im = Acosh(a)
        }
    }
    return r
}

CxArccos :: (a: Cplx) -> Cplx {
    R: float64 = a.re
    I: float64 = a.im
    r: Cplx
    if I == 0 {
        return CxArccosReal(R)
    }
    x: float64 = Fabs(R)
    y: float64 = Fabs(I)
    rr: float64 = Hypot(x + 1, y)
    s: float64 = Hypot(x - 1, y)
    A: float64 = 0.5 * (rr + s)
    B: float64 = x / A
    y2: float64 = y * y
    real: float64 = 0
    imag: float64 = 0
    A_crossover: float64 = 1.5
    B_crossover: float64 = 0.6417
    if B <= B_crossover {
        real = Acos(B)
    } else {
        if x <= 1 {
            D: float64 = 0.5 * (A + x) * (y2 / (rr + x + 1) + (s + (1 - x)))
            real = Atan(Sqrt(D) / x)
        } else {
            Apx: float64 = A + x
            D2: float64 = 0.5 * (Apx / (rr + x + 1) + Apx / (s + (x - 1)))
            real = Atan((y * Sqrt(D2)) / x)
        }
    }
    if A <= A_crossover {
        Am1: float64 = 0
        if x < 1 {
            Am1 = 0.5 * (y2 / (rr + (x + 1)) + y2 / (s + (1 - x)))
        } else {
            Am1 = 0.5 * (y2 / (rr + (x + 1)) + (s + (x - 1)))
        }
        imag = Log1p(Am1 + Sqrt(Am1 * (A + 1)))
    } else {
        imag = Log(A + Sqrt(A * A - 1))
    }
    if R >= 0 {
        r.re = real
    } else {
        r.re = 3.141592653589793 - real
    }
    if I >= 0 {
        r.im = 0 - imag
    } else {
        r.im = imag
    }
    return r
}

CxArctan :: (a: Cplx) -> Cplx {
    R: float64 = a.re
    I: float64 = a.im
    r: Cplx
    if I == 0 {
        r.re = Atan(R)
        r.im = 0
        return r
    }
    rr: float64 = Hypot(R, I)
    imag: float64 = 0
    u: float64 = (2 * I) / (1 + rr * rr)
    if Fabs(u) < 0.1 {
        imag = 0.25 * (Log1p(u) - Log1p(0 - u))
    } else {
        A: float64 = Hypot(R, I + 1)
        B: float64 = Hypot(R, I - 1)
        imag = 0.5 * Log(A / B)
    }
    if R == 0 {
        if I > 1 {
            r.re = 1.5707963267948966
            r.im = imag
        } else if I < -1 {
            r.re = 0 - 1.5707963267948966
            r.im = imag
        } else {
            r.re = 0
            r.im = imag
        }
    } else {
        r.re = 0.5 * Atan2(2 * R, (1 + rr) * (1 - rr))
        r.im = imag
    }
    return r
}

CxArcsec :: (a: Cplx) -> Cplx {
    return CxArccos(CxGslInverse(a))
}

CxArccsc :: (a: Cplx) -> Cplx {
    return CxArcsin(CxGslInverse(a))
}

CxArccot :: (a: Cplx) -> Cplx {
    if a.re == 0 && a.im == 0 {
        r0: Cplx = Cplx.{1.5707963267948966, 0}
        return r0
    }
    return CxArctan(CxGslInverse(a))
}

CxArcsinh :: (a: Cplx) -> Cplx {
    return CxMulImag(CxArcsin(CxMulImag(a, 1)), 0 - 1)
}

CxArccosh :: (a: Cplx) -> Cplx {
    zero: Cplx
    if a.im == 0 && a.re == 1 {
        return zero
    }
    t: Cplx = CxArccos(a)
    if t.im > 0 {
        return CxMulImag(t, 0 - 1)
    }
    return CxMulImag(t, 1)
}

CxArctanhReal :: (a: float64) -> Cplx {
    r: Cplx
    if a > -1 && a < 1 {
        r.re = Atanh(a)
        r.im = 0
    } else {
        r.re = acothGo(a)
        if a < 0 {
            r.im = 1.5707963267948966
        } else {
            r.im = 0 - 1.5707963267948966
        }
    }
    return r
}

acothGo :: (a: float64) -> float64 {
    return 0.5 * Log((a + 1) / (a - 1))
}

CxArctanh :: (a: Cplx) -> Cplx {
    if a.im == 0 {
        return CxArctanhReal(a.re)
    }
    return CxMulImag(CxArctan(CxMulImag(a, 1)), 0 - 1)
}

CxArcsech :: (a: Cplx) -> Cplx {
    return CxArccosh(CxGslInverse(a))
}

CxArccsch :: (a: Cplx) -> Cplx {
    return CxArcsinh(CxGslInverse(a))
}

CxArccoth :: (a: Cplx) -> Cplx {
    return CxArctanh(CxGslInverse(a))
}

CxFact :: (a: Cplx) -> Cplx {
    r: Cplx
    i: s32 = 0
    acc: float64 = 1
    if a.im == 0 {
        if a.re < 0 && a.re == Floor(a.re) {
            r.re = 0.0 / 0.0
            r.im = 0.0 / 0.0
            return r
        }
        if a.re == Floor(a.re) && a.re >= 0 && a.re < 170 {
            i = 1
            while i <= TruncateToS32(a.re) {
                acc *= cast(float64)i
                i += 1
            }
            r.re = acc
            r.im = 0
            return r
        }
        r.re = Tgamma(a.re + 1)
        r.im = 0
        return r
    }
    return CxMul(CxGamma(a), a)
}

CxGamma :: (a: Cplx) -> Cplx {
    r: Cplx
    if a.im == 0 {
        if a.re < 0 && a.re == Floor(a.re) {
            r.re = 0.0 / 0.0
            r.im = 0.0 / 0.0
            return r
        }
        r.re = Tgamma(a.re)
        r.im = 0
        return r
    }
    if a.re < 0 {
        b: Cplx = Cplx.{3.141592653589793 * Fmod(a.re, 2), 3.141592653589793 * a.im}
        pi_c: Cplx = Cplx.{3.141592653589793, 0}
        return CxDiv(pi_c, CxMul(CxFact(CxNeg(a)), CxSin(b)))
    }
    return CxPow2Lanczos(a)
}

CxPow2Lanczos :: (a: Cplx) -> Cplx {
    lanczos_g: float64 = 808618867.0 / 134217728
    lanczos_num: [13]float64 = .[56906521.913471563880907910335591226868592353221448, 103794043.11634454519062710536160702385539539810110, 86363131.288138591455469272889778684223419113014358, 43338889.324676138347737237405905333160850993321475, 14605578.087685068084141699827913592185707234229516, 3481712.1549806459088207101896477455646802362321652, 601859.61716810987866702265336993523025071425740828, 75999.293040145426498753034435989091370919973262979, 6955.9996025153761403563101155151989875259157712039, 449.94455690631681194468586076509884096232715968614, 19.519927882476174828478609662356521362076846583112, 0.50984166556566761881251786448046945099926051133936, 0.0060618423462489065257837539645559368832224636654970]
    lanczos_denom: [13]float64 = .[0, 39916800, 120543840, 150917976, 105258076, 45995730, 13339535, 2637558, 357423, 32670, 1925, 66, 1]
    p: Cplx = Cplx.{lanczos_num[12], 0}
    q: Cplx = Cplx.{lanczos_denom[12], 0}
    zmh: Cplx
    f: Cplx
    t1: Cplx
    t2: Cplx
    lg: Cplx = Cplx.{lanczos_g, 0}
    i: s32 = 11
    while i >= 0 {
        p = CxMul(p, a)
        p.re += lanczos_num[i]
        q = CxMul(q, a)
        q.re += lanczos_denom[i]
        i -= 1
    }
    zmh.re = a.re - 0.5
    zmh.im = a.im
    t1 = CxAdd(zmh, lg)
    f = CxPow(t1, CxScale(zmh, 0.5))
    t2 = CxDiv(p, q)
    return CxMul(CxMul(CxMul(f, CxExp(CxNeg(zmh))), f), t2)
}

FnCx1 :: (name_op: s32, args: *Val, count: s32) -> Val {
    a: Cplx
    unit: s32 = 105
    if CxArg(args, count, 0, *a, *unit) < 0 {
        return ValError(ERR_VALUE)
    }
    if name_op == 0 {
        return CxVal(CxConj(a), unit)
    }
    if name_op == 1 {
        return CxVal(CxInv(a), unit)
    }
    if name_op == 2 {
        return CxVal(CxNeg(a), unit)
    }
