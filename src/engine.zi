ConvGetConstant :: (cat: s32, binp: s32, use_prefixes: s32, name: *s8, c: *float64, prefix: *float64) -> s32 {
    plen: s32 = 0
    prefix[0] = 1
    if ConvUnit(cat, name, c) != 0 {
        return 1
    }
    if use_prefixes != 0 {
        if ConvPrefix(binp, name, prefix, *plen) != 0 {
            return ConvUnit(cat, *name[plen], c)
        }
    }
    return 0
}

ConvertOne :: (cat: s32, binp: s32, use_prefixes: s32, from_unit: *s8, to_unit: *s8, n: float64, handled: *s32, result: *float64) -> s32 {
    from_c: float64 = 0
    from_prefix: float64 = 1
    to_c: float64 = 0
    to_prefix: float64 = 1
    if ConvGetConstant(cat, binp, use_prefixes, from_unit, *from_c, *from_prefix) != 0 {
        handled[0] = 1
        if ConvGetConstant(cat, binp, use_prefixes, to_unit, *to_c, *to_prefix) == 0 {
            return 0
        }
        if from_c == 0 || to_prefix == 0 {
            return 0
        }
        result[0] = (((n * from_prefix) / from_c) * to_c) / to_prefix
        return 1
    }
    handled[0] = 0
    return 0
}

ConvTempUnit :: (unit: *s8) -> s32 {
    if TextCompareLiteral(unit, "K") == 0 {
        return 1
    }
    if TextCompareLiteral(unit, "C") == 0 {
        return 2
    }
    if TextCompareLiteral(unit, "F") == 0 {
        return 3
    }
    if TextCompareLiteral(unit, "Reau") == 0 {
        return 5
    }
    if TextCompareLiteral(unit, "Rank") == 0 {
        return 4
    }
    return 0
}

ConvertTemp :: (from_unit: *s8, to_unit: *s8, n_in: float64, handled: *s32, result: *float64) -> s32 {
    n: float64 = n_in
    nO: float64 = n_in
    ck: float64 = 273.15
    ft: s32 = ConvTempUnit(from_unit)
    tt: s32 = ConvTempUnit(to_unit)
    if ft == 0 || tt == 0 {
        handled[0] = 0
        return 0
    }
    handled[0] = 1
    if ft == 2 {
        n += ck
    }
    if ft == 3 {
        n = ((n - 32) * 5) / 9 + ck
    }
    if ft == 4 {
        n = (n * 5) / 9
    }
    if ft == 5 {
        n = (n * 5) / 4 + ck
    }
    if n < 0 {
        return 0
    }
    if ft == tt {
        result[0] = nO
        return 1
    }
    if tt == 2 {
        n -= ck
    }
    if tt == 3 {
        n = ((n - ck) * 9) / 5 + 32
    }
    if tt == 4 {
        n = (n * 9) / 5
    }
    if tt == 5 {
        n = ((n - ck) * 4) / 5
    }
    result[0] = n
    return 1
}

FnConvert :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    n: float64 = 0
    from_u: [32]s8
    to_u: [32]s8
    handled: s32 = 0
    result: float64 = 0
    ok: s32 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    n = CoerceNumber(*args[0])
    if TextArg(args, count, 1, *from_u[0], 32) < 0 {
        return ValError(ERR_VALUE)
    }
    if TextArg(args, count, 2, *to_u[0], 32) < 0 {
        return ValError(ERR_VALUE)
    }
    ok = ConvertTemp(*from_u[0], *to_u[0], n, *handled, *result)
    if handled != 0 {
        if ok == 0 {
            return ValError(ERR_NUM)
        }
        return ValNumber(result)
    }
    if ConvertOne(0, 0, 1, *from_u[0], *to_u[0], n, *handled, *result) != 0 {
        return ValNumber(result)
    }
    if handled != 0 {
        return ValError(ERR_NUM)
    }
    if ConvertOne(1, 0, 1, *from_u[0], *to_u[0], n, *handled, *result) != 0 {
        return ValNumber(result)
    }
    if handled != 0 {
        return ValError(ERR_NUM)
    }
    if ConvertOne(2, 0, 0, *from_u[0], *to_u[0], n, *handled, *result) != 0 {
        return ValNumber(result)
    }
    if handled != 0 {
        return ValError(ERR_NUM)
    }
    if ConvertOne(3, 0, 1, *from_u[0], *to_u[0], n, *handled, *result) != 0 {
        return ValNumber(result)
    }
    if handled != 0 {
        return ValError(ERR_NUM)
    }
    if ConvertOne(4, 0, 1, *from_u[0], *to_u[0], n, *handled, *result) != 0 {
        return ValNumber(result)
    }
    if handled != 0 {
        return ValError(ERR_NUM)
    }
    if ConvertOne(5, 0, 1, *from_u[0], *to_u[0], n, *handled, *result) != 0 {
        return ValNumber(result)
    }
    if handled != 0 {
        return ValError(ERR_NUM)
    }
    if ConvertOne(6, 0, 1, *from_u[0], *to_u[0], n, *handled, *result) != 0 {
        return ValNumber(result)
    }
    if handled != 0 {
        return ValError(ERR_NUM)
    }
    if ConvertOne(7, 0, 1, *from_u[0], *to_u[0], n, *handled, *result) != 0 {
        return ValNumber(result)
    }
    if handled != 0 {
        return ValError(ERR_NUM)
    }
    if ConvertOne(8, 0, 1, *from_u[0], *to_u[0], n, *handled, *result) != 0 {
        return ValNumber(result)
    }
    if handled != 0 {
        return ValError(ERR_NUM)
    }
    if ConvertOne(9, 0, 1, *from_u[0], *to_u[0], n, *handled, *result) != 0 {
        return ValNumber(result)
    }
    if handled != 0 {
        return ValError(ERR_NUM)
    }
    if ConvertOne(9, 1, 1, *from_u[0], *to_u[0], n, *handled, *result) != 0 {
        return ValNumber(result)
    }
    if handled != 0 {
        return ValError(ERR_NUM)
    }
    if ConvertOne(10, 0, 1, *from_u[0], *to_u[0], n, *handled, *result) != 0 {
        return ValNumber(result)
    }
    if handled != 0 {
        return ValError(ERR_NUM)
    }
    if ConvertOne(11, 0, 1, *from_u[0], *to_u[0], n, *handled, *result) != 0 {
        return ValNumber(result)
    }
    if handled != 0 {
        return ValError(ERR_NUM)
    }
    return ValError(ERR_NA)
}

V2BGeneral :: (v: *Val, out: *float64) -> s32 {
    txt: *s8 = CText("")
    if v.kind != VAL_STRING {
        return 0
    }
    txt = v.text
    if DbParseNumber(txt, out) == 0 {
        return 0
    }
    return 1
}

V2BIsAlnum :: (c: s32) -> s32 {
    if c >= 48 && c <= 57 {
        return 1
    }
    if c >= 65 && c <= 90 {
        return 1
    }
    if c >= 97 && c <= 122 {
        return 1
    }
    return 0
}

V2BDigitChar :: (d: s32) -> s32 {
    if d < 10 {
        return 48 + d
    }
    return 65 + d - 10
}

ValToBase :: (value: *Val, places_v: *Val, src_base: s32, dest_base: s32, min_value: float64, max_value: float64, flags: s32) -> Val {
    v_float: float64 = 0
    err: *s8 = null
    txt: *s8 = CText("")
    hsuffix: s32 = 0
    len: s32 = 0
    min_d: s32 = 1
    max_d: s32 = 10
    places: s32 = 1
    out: [24]s8
    v_u: u64 = 0
    digit: s32 = 0
    buf: [64]s8
    val: float64 = 0
    fplaces: float64 = 0
    float_path: s32 = 0
    did_parse: s32 = 0
    if value.kind == VAL_BOOL {
        return ValError(ERR_VALUE)
    }
    if places_v != null && places_v.kind == VAL_BOOL {
        return ValError(ERR_VALUE)
    }
    if (flags & 1) != 0 {
        if value.kind == VAL_STRING {
            if V2BGeneral(value, *v_float) == 0 {
                return ValError(ERR_VALUE)
            }
            float_path = 1
        } else if value.kind == VAL_FLOAT {
            v_float = value.number
            float_path = 1
        } else {
            return ValError(ERR_NUM)
        }
    } else if value.kind == VAL_STRING {
        txt = value.text
        hsuffix = 0
        if (flags & 8) != 0 && txt[0] == 0 {
            txt = CText("0")
        }
        if V2BIsAlnum(cast(s32)txt[0]) == 0 {
            return ValError(ERR_NUM)
        }
        len = cast(s32)TextLength(txt)
        if (flags & 4) != 0 && len > 10 {
            return ValError(ERR_NUM)
        }
        if (flags & 2) != 0 {
            if txt[0] == 48 && (txt[1] == 120 || txt[1] == 88) {
                txt = *txt[2]
            } else if txt[len - 1] == 104 || txt[len - 1] == 72 {
                hsuffix = 1
            }
        }
        v_float = cast(float64)ParseLongLong(txt, *err, src_base)
        if err == txt || err[hsuffix] != 0 {
            return ValError(ERR_NUM)
        }
        if v_float < min_value || v_float > max_value {
            return ValError(ERR_NUM)
        }
        did_parse = 1
    } else if value.kind == VAL_FLOAT {
        v_float = value.number
        float_path = 1
    } else {
        return ValError(ERR_NUM)
    }
    if float_path != 0 {
        val = Trunc(v_float)
        if val < min_value || val > max_value {
            return ValError(ERR_NUM)
        }
        FormatText(*buf[0], 64, CText("%.0f"), val)
        v_float = cast(float64)ParseLongLong(*buf[0], *err, src_base)
        if err[0] != 0 {
            return ValError(ERR_NUM)
        }
    }
    if src_base != 10 {
        b10: float64 = Pow(cast(float64)src_base, 10)
        if v_float >= (b10 / 2) {
            v_float = v_float - b10
        }
    }
    if (flags & 16) != 0 {
        return ValNumber(v_float)
    }
    if v_float < 0 {
        min_d = 1
        max_d = 10
        v_float += Pow(cast(float64)dest_base, 10)
    } else {
        if v_float == 0 {
            min_d = 1
            max_d = 1
        } else {
            min_d = TruncateToS32(Log(v_float + 0.5) / Log(cast(float64)dest_base)) + 1
            max_d = min_d
        }
    }
    if places_v != null {
        fplaces = CoerceNumber(places_v)
        if fplaces < cast(float64)min_d || fplaces > 10 {
            return ValError(ERR_NUM)
        }
        places = TruncateToS32(fplaces)
        if v_float >= 0 && places > max_d {
            max_d = places
        }
    }
    v_u = TruncateToU64(v_float + 0.5)
    digit = max_d - 1
    while digit >= 0 {
        out[digit] = cast(s8)V2BDigitChar(cast(s32)(v_u % cast(u64)dest_base))
        v_u /= cast(u64)dest_base
        digit -= 1
    }
    out[max_d] = 0
    return ValString(wb_strdup(*out[0]))
}

FnBase :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    base_v: float64 = 0
    max_v: float64 = 1 / 2.2204460492503131e-16
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    base_v = CoerceNumber(*args[1])
    if base_v < 2 || base_v >= 37 {
        return ValError(ERR_NUM)
    }
    return ValToBase(*args[0], ifx count >= 3 then (*args[2]) else null, 10, TruncateToS32(base_v), -max_v, max_v, 1 | 2)
}

FnDecimal :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    base_v: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    base_v = CoerceNumber(*args[1])
    if base_v < 2 || base_v >= 37 {
        return ValError(ERR_NUM)
    }
    return ValToBase(*args[0], null, TruncateToS32(base_v), 10, 0, 1099511627776.0 - 1, (4 | 8) | 16)
}

FnBin2Oct :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return ValToBase(*args[0], ifx count >= 2 then (*args[1]) else null, 2, 8, 0, 1111111111.0, 4 | 8)
}

FnBin2Hex :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return ValToBase(*args[0], ifx count >= 2 then (*args[1]) else null, 2, 16, 0, 1111111111.0, 4 | 8)
}

FnOct2Bin :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return ValToBase(*args[0], ifx count >= 2 then (*args[1]) else null, 8, 2, 0, 7777777777.0, 4 | 8)
}

FnOct2Hex :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return ValToBase(*args[0], ifx count >= 2 then (*args[1]) else null, 8, 16, 0, 7777777777.0, 4 | 8)
}

FnHex2Bin :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return ValToBase(*args[0], ifx count >= 2 then (*args[1]) else null, 16, 2, 0, 9999999999.0, 4 | 8)
}

FnHex2Oct :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return ValToBase(*args[0], ifx count >= 2 then (*args[1]) else null, 16, 8, 0, 9999999999.0, 4 | 8)
}

FnDelta :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    x: float64 = 0
    y: float64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    x = CoerceNumber(*args[0])
    y = ifx count >= 2 then CoerceNumber(*args[1]) else 0
    if x == y {
        return ValNumber(1)
    }
    return ValNumber(0)
}

FnGestep :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    x: float64 = 0
    y: float64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    x = CoerceNumber(*args[0])
    y = ifx count >= 2 then CoerceNumber(*args[1]) else 0
    if x >= y {
        return ValNumber(1)
    }
    return ValNumber(0)
}

FnErfc :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    return ValNumber(Erfc(CoerceNumber(*args[0])))
}

FnHexrep :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    out: [64]s8
    v: float64 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    v = CoerceNumber(*args[0])
    FormatText(*out[0], 64, CText("%a"), v)
    return ValString(wb_strdup(*out[0]))
}

FnInvsuminv :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    list: NumList
    CollectNumbers(args, count, *list)
    suminv: float64 = 0
    zerop: s32 = 0
    i: s32 = 0
    x: float64 = 0
    while i < list.count {
        x = list.data[i]
        if x < 0 {
            return ValError(ERR_VALUE)
        }
        if x == 0 {
            zerop = 1
        } else {
            suminv += 1 / x
        }
        i += 1
    }
    if list.count <= 0 {
        return ValError(ERR_VALUE)
    }
    if zerop != 0 {
        return ValNumber(0)
    }
    return ValNumber(1 / suminv)
}

BIT_MAX :: () -> float64 {
    v: float64 = 2 / 2.2204460492503131e-16
    if v > 18446744073709551615.0 {
        return 18446744073709551615.0
    }
    return v
}

FnBitAgg :: (args: *Val, count: s32, op: s32) -> Val {
    list: NumList
    CollectNumbers(args, count, *list)
    acc: u64 = 0
    if op == 0 {
        acc = 18446744073709551615
    }
    i: s32 = 0
    xf: float64 = 0
    bmax: float64 = BIT_MAX()
    while i < list.count {
        xf = Floor(list.data[i])
        if xf < 0 || xf > bmax {
            return ValError(ERR_VALUE)
        }
        if op == 0 {
            acc = acc & TruncateToU64(xf)
        } else if op == 1 {
            acc = acc | TruncateToU64(xf)
        } else {
            acc = acc ^ TruncateToU64(xf)
        }
        i += 1
    }
    if list.count == 0 {
        return ValError(ERR_VALUE)
    }
    return ValNumber(cast(float64)acc)
}

FnBitand :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return FnBitAgg(args, count, 0)
}

FnBitor :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return FnBitAgg(args, count, 1)
}

FnBitxor :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return FnBitAgg(args, count, 2)
}

FnBitshift :: (args: *Val, count: s32, left: s32) -> Val {
    l: float64 = 0
    r: float64 = 0
    bmax: float64 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    l = CoerceNumber(*args[0])
    r = Floor(CoerceNumber(*args[1]))
    bmax = BIT_MAX()
    if l < 0 || l > bmax {
        return ValError(ERR_NUM)
    }
    if r >= 64 || r <= -64 {
        return ValNumber(0)
    }
    if r < 0 {
        if left != 0 {
            return ValNumber(cast(float64)(TruncateToU64(l) >> TruncateToU64(-r)))
        }
        return ValNumber(cast(float64)(TruncateToU64(l) << TruncateToU64(-r)))
    }
    if left != 0 {
        return ValNumber(cast(float64)(TruncateToU64(l) << TruncateToU64(r)))
    }
    return ValNumber(cast(float64)(TruncateToU64(l) >> TruncateToU64(r)))
}

FnBitlshift :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return FnBitshift(args, count, 1)
}

FnBitrshift :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    return FnBitshift(args, count, 0)
}

kmax_i :: (a: s32, b: s32) -> s32 {
    if a > b {
        return a
    }
    return b
}

kmin_i :: (a: s32, b: s32) -> s32 {
    if a < b {
        return a
    }
    return b
}

r_pow_di :: (x: float64, n: s32) -> float64 {
    xn: float64 = x
    y: float64 = 1
    n2: s32 = n
    if n2 < 0 {
        n2 = -n2
        if xn != 0 {
            xn = 1 / xn
        }
    }
    while n2 > 0 {
        if (n2 & 1) != 0 {
            y *= xn
        }
        n2 >>= 1
        if n2 > 0 {
            xn *= xn
        }
    }
    return y
}

swap_log_tail :: (lp: float64) -> float64 {
    if lp > (-1 / Log(2)) {
        return Log(0 - Expm1(lp))
    }
    return Log1p(0 - Exp(lp))
}

logspace_add_go :: (logx: float64, logy: float64) -> float64 {
    return Fmax(logx, logy) + Log1p(Exp(0 - Fabs(logx - logy)))
}

logspace_sub_go :: (logx: float64, logy: float64) -> float64 {
    return logx + swap_log_tail(logy - logx)
}

chebyshev_eval :: (x: float64, a: *float64, n: s32) -> float64 {
    b0: float64 = 0
    b1: float64 = 0
    b2: float64 = 0
    i: s32 = 0
    if x < -1.0001 || x > 1.0001 || n < 1 || n > 1000 {
        return 0.0 / 0.0
    }
    nx: float64 = 2 * x
    i = n - 1
    while i >= 0 {
        b2 = b1
        b1 = b0
        b0 = nx * b1 - b2 + a[i]
        i -= 1
    }
    return 0.5 * (b0 - b2)
}

lgammacor :: (x: float64) -> float64 {
    algmcs: [15]float64 = .[0.1666389480451863247205729650822, 0 - 0.1384948176067563840732986059135e-4, 0.9810825646924729426157171547487e-8, 0 - 0.1809129475572494194263306266719e-10, 0.6221098041892605227126015543416e-13, 0 - 0.3399615005417721944303330599666e-15, 0.2683181998482698748957538846666e-17, 0 - 0.2868042435334643284144622399999e-19, 0.3962837061046434803679306666666e-21, 0 - 0.6831888753985766870111999999999e-23, 0.1429227355942498147573333333333e-24, 0 - 0.3547598158101070547199999999999e-26, 0.1025680058010470912000000000000e-27, 0 - 0.3401102254316748799999999999999e-29, 0.1276642195630062933333333333333e-30]
    tmp: float64 = 0
    if x < 10 {
        return 0.0 / 0.0
    }
    if x >= 3.745194030963158e306 {
        return 0.0
    }
    if x < 94906265.62425156 {
        tmp = 10 / x
        return chebyshev_eval(tmp * tmp * 2 - 1, *algmcs[0], 5) / x
    }
    return 1 / (x * 12)
}

lbeta_go :: (a: float64, b: float64) -> float64 {
    corr: float64 = 0
    p: float64 = 0
    q: float64 = 0
    if a != a || b != b {
        return a + b
    }
    q = a
    p = q
    if b < p {
        p = b
    }
    if b > q {
        q = b
    }
    if p < 0 {
        return 0.0 / 0.0
    }
    if p == 0 {
        return 1e308 * 10
    }
    if IsFinite(q) == 0 {
        return -1e308 * 10
    }
    if p >= 10 {
        corr = lgammacor(p) + lgammacor(q) - lgammacor(p + q)
        return Log(q) * -0.5 + 0.918938533204672741780329736406 + corr + (p - 0.5) * Log(p / (p + q)) + q * Log1p(0 - p / (p + q))
    }
    if q >= 10 {
        corr = lgammacor(q) - lgammacor(p + q)
        return Lgamma(p) + corr + p - p * Log(p + q) + (q - 0.5) * Log1p(0 - p / (p + q))
    }
    if p < 1e-306 {
        return Lgamma(p) + (Lgamma(q) - Lgamma(p + q))
    }
    return Lgamma(p) + Lgamma(q) - Lgamma(p + q)
}

gnm_fact_port :: (x: float64) -> float64 {
    mant: Quad
    e: s32 = 0
    r: float64 = 0
    if x != x {
        return 0.0 / 0.0
    }
    if x < 0 && x == Floor(x) {
        return 0.0 / 0.0
    }
    if x >= 536870911 {
        return 1e308 * 10
    }
    if x != Floor(x) {
        return Tgamma(x + 1)
    }
    if qfactf(x, *mant, *e) != 0 {
        return 0.0 / 0.0
    }
    r = QuadVal(*mant)
    return Scalbn(r, e)
}

rescale_mantexp :: (mant: *Quad, expb: *s32) {
    e: s32 = Ilogb(QuadVal(mant))
    if e != -1 {
        qs: Quad
        QuadInit(*qs, Scalbn(1.0, -e - 1))
        QuadMul(mant, mant, *qs)
        expb[0] += e + 1
    }
}

qfacti :: (n: s32, mant: *Quad, expb: *s32) -> s32 {
    if n < 0 || n >= 10000 {
        mant.h = 0
        mant.l = 0
        expb[0] = 0
        return 1
    }
    if QFACT_BUILT == 0 {
        m0: Quad
        QuadInit(*m0, 0.5)
        QFACT_MANT_H[0] = m0.h
        QFACT_MANT_L[0] = m0.l
        QFACT_EXP[0] = 1
        QFACT_BUILT = 1
    }
    while n >= QFACT_BUILT {
        m: Quad
        nxt: Quad
        e: s32 = 0
        QuadInit(*m, cast(float64)QFACT_BUILT)
        nxt.h = QFACT_MANT_H[QFACT_BUILT - 1]
        nxt.l = QFACT_MANT_L[QFACT_BUILT - 1]
        QuadMul(*m, *m, *nxt)
        e = QFACT_EXP[QFACT_BUILT - 1]
        rescale_mantexp(*m, *e)
        QFACT_MANT_H[QFACT_BUILT] = m.h
        QFACT_MANT_L[QFACT_BUILT] = m.l
        QFACT_EXP[QFACT_BUILT] = e
        QFACT_BUILT += 1
    }
    mant.h = QFACT_MANT_H[n]
    mant.l = QFACT_MANT_L[n]
    expb[0] = QFACT_EXP[n]
    return 0
}

qfactf :: (x: float64, mant: *Quad, expb: *s32) -> s32 {
    res: s32 = 0
    w: float64 = 0
    f: float64 = 0
    efw: s32 = 0
    expb[0] = 0
    if x != x || (x < 0 && x == Floor(x)) {
        mant.h = 0.0 / 0.0
        mant.l = 0.0 / 0.0
        return 2
    }
    if x >= 536870911 {
        mant.h = 1e308 * 10
        mant.l = 0
        return 1
    }
    if x == Floor(x) {
        if qfacti(TruncateToS32(x), mant, expb) == 0 {
            return 0
        }
    }
    if x < -1 {
        if qfactf(0 - x - 1, mant, expb) != 0 {
            res = 1
        } else {
            b: Quad
            z: float64 = 0 - x
            k: float64 = Round(z)
            fr: float64 = z - k
            sv: float64 = Sin(3.14159265358979323846 * fr)
            if Fmod(k, 2) != 0 {
                sv = 0 - sv
            }
            QuadInit(*b, sv)
            QuadMul(*b, *b, mant)
            piq: Quad = Quad.{3.141592653589793, 1.2246467991473532e-16}
            QuadDiv(mant, *piq, *b)
            expb[0] = 0 - expb[0]
        }
    } else if x >= 9999.5 {
        y: Quad
        f1: Quad
        f2: Quad
        f3: Quad
        f4: Quad
        eq: Quad = Quad.{2.718281828459045, 1.4456468917292502e-16}
        ef2: float64 = 0
        QuadInit(*y, x + 1)
        expb[0] = 0
        twopi: Quad = Quad.{6.283185307179586, 2.4492935982947064e-16}
        QuadSqrt(*f1, *twopi)
        QuadDiv(*f2, *y, *eq)
        QuadPow(*f2, *ef2, *f2, *y)
        if ef2 > 1073741823 || ef2 < -1073741823 {
            res = 1
            f2.h = 1e308 * 10
            f2.l = 0
        } else {
            expb[0] += TruncateToS32(ef2)
        }
        QuadSqrt(*f3, *y)
        GammaErrorFactor(*f4, *y)
        QuadMul(mant, *f1, *f2)
        QuadDiv(mant, mant, *f3)
        QuadMul(mant, mant, *f4)
    } else {
        qx: Quad
        s: Quad
        one2: Quad = Quad.{1, 0}
        mfw: Quad
        r2: Quad
        w = Round(x)
        f = x - w
        QuadInit(*qx, x)
        QuadInit(*s, 1)
        while w < 20 {
            QuadAdd(*qx, *qx, *one2)
            w += 1
            QuadMul(*s, *s, *qx)
        }
        if qfacti(TruncateToS32(w), *mfw, *efw) != 0 {
            mant.h = 1e308 * 10
            mant.l = 0
            res = 1
        } else {
            PochhammerSmallN(w + 1, f, *r2)
            QuadMul(mant, *mfw, *r2)
            QuadDiv(mant, mant, *s)
            expb[0] = efw
        }
    }
    if res == 0 {
        rescale_mantexp(mant, expb)
    }
    return res
}

do_search :: (y_in: float64, z: *float64, p: float64, n: float64, pr: float64, incr: float64) -> float64 {
    y: float64 = y_in
    newz: float64 = 0
    if z[0] >= p {
        while true {
            if y == 0 {
                return y
            }
            newz = pbinom(y - incr, n, pr, 1, 0)
            if newz < p {
                return y
            }
            y = Fmax(0, y - incr)
            z[0] = newz
        }
    }
    while true {
        y = Fmin(y + incr, n)
        if y == n {
            return y
        }
        z[0] = pbinom(y, n, pr, 1, 0)
        if z[0] >= p {
            return y
        }
    }
}

dstirlerr_go :: (x: float64) -> float64 {
    xph: float64 = x + 0.5
    if x < 0.5 {
        return 1 - xph * Log1p(1 / x)
    }
    if x < 2 {
        return -1 / (2 * x) - xph * Log1pmx(1 / x)
    }
    return 0 - (x + 2) / (12 * x * x * x) - xph * GoLogTaylor4(1 / x, 4)
}

GoLogTaylor4 :: (x: float64, k: s32) -> float64 {
    return x - (x * x) / 2 + (x * x * x) / 3 - (x * x * x * x) / 4
}

TaylorLog1p :: (x: float64, k_in: s32) -> float64 {
    xn: [100]float64
    lim: float64 = 0
    term: float64 = 0
    sum2: float64 = 0
    i: s32 = 0
    k: s32 = k_in
    if Fabs(x) > 0.58 {
        return 0.0 / 0.0
    }
    if k < 1 {
        k = 1
    }
    if k > 100 {
        k = 100
    }
    if k == 1 {
        return Log1p(x)
    }
    xn[1] = x
    i = 2
    while i < k {
        xn[i] = xn[i / 2] * xn[(i + 1) / 2]
        i += 1
    }
    i = k
    while i < 100 {
        xn[i] = xn[i / 2] * xn[(i + 1) / 2]
        if (i & 1) != 0 {
            term = xn[i] / cast(float64)i
        } else {
            term = xn[i] / cast(float64)(0 - i)
        }
        sum2 += term
        if i == k {
            lim = xn[i] * (2.2204460492503131e-16 / 100)
        } else if Fabs(term) <= lim {
            break
        }
        i += 1
    }
    return sum2
}

log1px3 :: (x: float64) -> float64 {
    c1: float64 = 0.6065306597126334
    d1: float64 = 0.64872127070012814684865
    c2: float64 = 0.6451311644197896784284
    d2: float64 = 0.5500723808612904238765
    l0: float64 = -0.5727756120801021849831095
    l1: float64 = -0.643439019336053015559896
    l2: float64 = -0.75
    l3: float64 = -0.9423152993887941976504422
    if x != x {
        return x
    }
    if x >= 2 {
        return Log1p(x) + (x * (x - 2)) / 2
    }
    if x >= d1 {
        return Log1p(c1 * (x - d1)) + ((x - 1) * (x - 1)) / 2
    }
    if x >= d2 {
        return Log1p(c2 * (x - d2)) + ((x - d1) * (x - 1 - (1 - d1))) / 2
    }
    if x > l0 {
        return TaylorLog1p(x, 3)
    }
    if x > l1 {
        r1: float64 = 2 - l1
        f1: float64 = 2.3406903451108563844727
        return Log((1 + x) * f1) + ((x - l1) * (x - r1)) / 2
    }
    if x > l2 {
        r2: float64 = 2 - l2
        f2: float64 = 2.80456935623722661204591
        return Log((1 + x) * f2) + ((x - l2) * (x - r2)) / 2
    }
    if x > l3 {
        r3: float64 = 2 - l3
        f3: float64 = 4
        return Log((1 + x) * f3) + ((x - l3) * (x - r3)) / 2
    }
    return Log1p(x) + (x * (x - 2)) / 2
}

Lgamma1p :: (a: float64) -> float64 {
    return Lgamma(1 + a)
}

dgamma_go :: (x: float64, shape: float64, scale: float64, give_log: s32) -> float64 {
    if x != x || shape != shape || scale != scale {
        return x + shape + scale
    }
    if shape < 0 || scale <= 0 {
        return 0.0 / 0.0
    }
    if x < 0 {
        return ifx give_log != 0 then (-1e308 * 10) else 0.0
    }
    if shape == 0 {
        if x == 0 {
            return 1e308 * 10
        }
        return ifx give_log != 0 then (-1e308 * 10) else 0.0
    }
    if x == 0 {
        if shape < 1 {
            return 1e308 * 10
        }
        if shape > 1 {
            return ifx give_log != 0 then (-1e308 * 10) else 0.0
        }
        if give_log != 0 {
            return 0 - Log(scale)
        }
        return 1 / scale
    }
    if x <= 0 || shape <= 0 || scale <= 0 {
        return ifx give_log != 0 then (-1e308 * 10) else 0.0
    }
    if shape < 1 {
        pr3: float64 = dpois_raw(shape, x / scale, give_log)
        if give_log != 0 {
            if IsFinite(shape / x) != 0 {
                return pr3 + Log(shape / x)
            }
            return pr3 + Log(shape) - Log(x)
        }
        return (pr3 * shape) / x
    }
    pr2: float64 = dpois_raw(shape - 1, x / scale, give_log)
    if give_log != 0 {
        return pr2 - Log(scale)
    }
    return pr2 / scale
}

dnorm_go :: (x: float64, mu: float64, sigma: float64, give_log: s32) -> float64 {
    c: float64 = 0
    if x != x || mu != mu || sigma != sigma {
        return x + mu + sigma
    }
    if sigma < 0 {
        return 0.0 / 0.0
    }
    if sigma == 0 {
        return ifx x == mu then 1.0 else 0.0
    }
    x = (x - mu) / sigma
    if (x * x) >= (-2.0 * (ifx give_log != 0 then (-745.1332191019412) else 3.6205246350374e-155)) {
        c = (0.398942280401432677939946059934 * Exp(0 - (x * x) / 2)) / sigma
        if give_log != 0 {
            return Log(c)
        }
        return c
    }
    if give_log != 0 {
        return 0 - 745.1332191019412 - Log(Fabs(sigma)) - (x * x) / 2
    }
    return 0.0
}

bd0 :: (x: float64, M: float64) -> float64 {
    yh: float64 = 0
    yl: float64 = 0
    Ebd0(x, M, *yh, *yl)
    return yh + yl
}

stirlerr :: (n: float64) -> float64 {
