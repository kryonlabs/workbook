    nn: float64 = 0
    y: float64 = 0
    if cast(s32)(n > 0) == 0 {
        return 0.0 / 0.0
    }
    if n <= 15 {
        nn: float64 = n + n
        if nn == cast(float64)TruncateToS32(nn) {
            return sferr_halves[TruncateToS32(nn)]
        }
    }
    nn = n * n
    if n > 3043.0 {
        return (S0 - S1 / nn) / n
    }
    if n > 200.2 {
        return (S0 - (S1 - S2 / nn) / nn) / n
    }
    if n > 55.57 {
        return (S0 - (S1 - (S2 - S3 / nn) / nn) / nn) / n
    }
    if n > 27.01 {
        return (S0 - (S1 - (S2 - (S3 - S4 / nn) / nn) / nn) / nn) / n
    }
    if n > 17.23 {
        return (S0 - (S1 - (S2 - (S3 - (S4 - S5 / nn) / nn) / nn) / nn) / nn) / n
    }
    if n > 12.77 {
