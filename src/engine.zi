        QuadInit(*ql, lambda)
        QuadPow(*qf1, *e1, *ql, *qx)
        QuadNeg(*ql, *ql)
        QuadExp(*qf2, *e2, *ql)
        qfactf(x, *qf3, *e3)
        QuadMul(*qres, *qf1, *qf2)
        QuadDiv(*qres, *qres, *qf3)
        res = QuadVal(*qres)
        eres = e1 + e2 - cast(float64)e3
        return Scalbn(res, TruncateToS32(eres))
    }
    if give_log != 0 && lambda <= 1 {
        t1: float64 = x * Log(lambda)
        t2: float64 = -lambda
        t3: float64 = -Lgamma1p(x)
        return t1 + t2 + t3
    }
    if x >= 0.16 && x <= (2 * lambda) {
        t1: float64 = -x * log1px3(d_l)
        t2: float64 = d_l * d_l * 0.5 * (d - lambda)
        t3: float64 = Log(2 * 3.141592653589793238462643383279502884197169399375105820974944592307816406286208998628034825342117 * x) * -0.5
        t4: float64 = -stirlerr(x)
        res = t1 + t2 + t3 + t4
    } else {
