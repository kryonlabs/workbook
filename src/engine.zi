lfbaccdif :: (a: float64, b: float64) -> float64 {
    if a > (0.03 * (a + b)) {
        return logfbit(a + b) - logfbit(b)
    } else {
        a2: float64 = a * a
        ab2: float64 = a / 2 + b
        return a * (logfbit1(ab2) + (a2 / 24) * (logfbit3(ab2) + (a2 / 80) * (logfbit5(ab2) + (a2 / 168) * logfbit7(ab2))))
    }
}

compbfunc :: (x: float64, a: float64, b: float64) -> float64 {
