        res -= stirlerr(x)
        res -= Log(2 * 3.141592653589793238462643383279502884197169399375105820974944592307816406286208998628034825342117 * x) * 0.5
    }
    return ifx give_log != 0 then res else Exp(res)
}

dbinom :: (x: float64, n: float64, p: float64, give_log: s32) -> float64 {
    if x != x || n != n || p != p {
        return x + n + p
    }
    if p < 0 || p > 1 || n < 0 || n != Floor(n) {
        return 0.0 / 0.0
    }
    if x != Floor(x) {
        return 0.0
    }
    if x < 0 || IsFinite(x) == 0 {
        return 0.0
    }
    n = Round(n)
    x = Round(x)
    return dbinom_raw(x, n, p, 1 - p, give_log)
}

dbinom_raw :: (x: float64, n: float64, p: float64, q: float64, give_log: s32) -> float64 {
    lf: float64 = 0
    lc: float64 = 0
    if p == 0 {
        return ifx x == 0 then 1.0 else 0.0
    }
    if q == 0 {
        return ifx x == n then 1.0 else 0.0
    }
    if x == 0 {
        if p > q {
            return ifx give_log != 0 then (n * Log(q)) else Pow(q, n)
        } else {
            return ifx give_log != 0 then (n * Log1p(-p)) else Pow1p(-p, n)
        }
    }
    if x == n {
        if p > q {
            return ifx give_log != 0 then (n * Log1p(-q)) else Pow1p(-q, n)
        } else {
            return ifx give_log != 0 then (n * Log(p)) else Pow(p, n)
        }
    }
    if x < 0 || x > n {
        return 0.0
    }
    if give_log == 0 {
        qp: Quad
        qq: Quad
        qx: Quad
        qnmx: Quad
        qf1: Quad
        qf2: Quad
        qf3: Quad
        qf4: Quad
        qf5: Quad
        qres: Quad
        e1: s32 = 0
        e2: s32 = 0
        e3: s32 = 0
        bad: s32 = 0
        e4: float64 = 0
        e5: float64 = 0
        e: float64 = 0
        QuadInit(*qp, p)
        QuadInit(*qq, q)
        QuadInit(*qx, x)
        QuadInit(*qnmx, n - x)
        bad += qfactf(n, *qf1, *e1)
        bad += qfactf(x, *qf2, *e2)
        bad += qfactf(n - x, *qf3, *e3)
        QuadPow(*qf4, *e4, *qp, *qx)
        QuadPow(*qf5, *e5, *qq, *qnmx)
        QuadMul(*qres, *qf2, *qf3)
        QuadDiv(*qres, *qf1, *qres)
        QuadMul(*qres, *qres, *qf4)
        QuadMul(*qres, *qres, *qf5)
        e = e4 + e5 + cast(float64)e1 - cast(float64)e2 - cast(float64)e3
        if bad == 0 && IsFinite(qres.h) != 0 && qres.h > 0 {
            e = e
            return Scalbn(QuadVal(*qres), TruncateToS32(e))
        }
    }
    lc = stirlerr(n) - stirlerr(x) - stirlerr(n - x) - bd0(x, n * p) - bd0(n - x, n * q)
    lf = 1.837877066409345483560659472811 + Log(x) + Log1p(-x / n)
    return Exp(lc - 0.5 * lf)
}

pnorm :: (x: float64, mu: float64, sigma: float64, lower_tail: s32, log_p: s32) -> float64 {
    p: float64 = 0
    cp: float64 = 0.0 / 0.0
    if x != x || mu != mu || sigma != sigma {
        return x + mu + sigma
    }
    if IsFinite(x) == 0 && mu == x {
        return 0.0 / 0.0
    }
    if sigma <= 0 {
        if sigma < 0 {
            return 0.0 / 0.0
        }
        return ifx x < mu then (ifx lower_tail != 0 then 0.0 else 1.0) else (ifx lower_tail != 0 then 1.0 else 0.0)
    }
    p = (x - mu) / sigma
    if IsFinite(p) == 0 {
        return ifx x < mu then (ifx lower_tail != 0 then 0.0 else 1.0) else (ifx lower_tail != 0 then 1.0 else 0.0)
    }
    x = p
    pnorm_both(x, *p, *cp, ifx lower_tail != 0 then 0 else 1, log_p)
    return ifx lower_tail != 0 then p else cp
}

