    BD0_CH[128] = CText("0 0 0 0")
    while i < 129 {
        p = BD0_CH[i]
        k = 0
        while k < 4 {
            BD0_V[i * 4 + k] = ParseDouble(p, null)
            while p[0] != 0 && p[0] != 32 {
                p = *p[1]
            }
            if p[0] == 32 {
                p = *p[1]
            }
            k += 1
        }
        i += 1
    }
    BD0_READY = 1
    return BD0_READY
}

PairAdd :: (d: float64, h: *float64, l: *float64) {
    dh: float64 = Round(d * 65536) / 65536
    dl: float64 = d - dh
    l[0] += dl
    h[0] += dh
}

GoLogcf :: (x: float64, iv: float64, dv: float64, eps: float64) -> float64 {
    c1: float64 = 2 * dv
    c2: float64 = iv + dv
    c4: float64 = c2 + dv
    a1: float64 = c2
    b1: float64 = iv * (c2 - iv * x)
    b2: float64 = dv * dv * x
    a2: float64 = c4 * c2 - b2
    scalefactor: float64 = 1.157920892373162e+77
    b2 = c4 * b1 - iv * b2
    while Fabs(a2 * b1 - a1 * b2) > Fabs(eps * b1 * b2) {
        c3: float64 = c2 * c2 * x
        c2 += dv
        c4 += dv
        a1 = c4 * a2 - c3 * a1
        b1 = c4 * b2 - c3 * b1
        c3 = c1 * c1 * x
        c1 += dv
        c4 += dv
        a2 = c4 * a1 - c3 * a2
        b2 = c4 * b1 - c3 * b2
        if Fabs(b2) > 115792089237316195423570985008687907853269984665640564039457584007913129639936.0 {
            a1 /= 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
            b1 /= 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
            a2 /= 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
            b2 /= 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
        } else if Fabs(b2) < (1 / 115792089237316195423570985008687907853269984665640564039457584007913129639936.0) {
            a1 *= 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
            b1 *= 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
            a2 *= 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
            b2 *= 115792089237316195423570985008687907853269984665640564039457584007913129639936.0
        }
    }
    return a2 / b2
}

Log1pmx :: (x: float64) -> float64 {
    if x > 1 || x < -0.79149064 {
        return Log1p(x) - x
    }
    r: float64 = x / (2 + x)
    y: float64 = r * r
    if Fabs(x) < 1e-2 {
        return r * (((((2.0 / 9) * y + 2.0 / 7) * y + 2.0 / 5) * y + 2.0 / 3) * y - x)
    }
    return r * (2 * y * GoLogcf(y, 3, 2, 1e-14) - x)
}

FrexpM :: (x: float64, e: *s32) -> float64 {
    ee: s32 = Ilogb(x)
    e[0] = ee + 1
    return Scalbn(x, -ee - 1)
}

Ebd0 :: (x: float64, m: float64, yh: *float64, yl: *float64) {
    if BD0_READY == 0 {
        Bd0Init()
    }
    yh[0] = 0
    yl[0] = 0
    if x == m {
        return
    }
    e4: float64 = 2.2204460492503131e-16 * 2.2204460492503131e-16 * 2.2204460492503131e-16 * 2.2204460492503131e-16
    if x < (m * e4) {
        PairAdd(m, yh, yl)
        return
    }
    if m == 0 {
        yh[0] = 1.0 / 0.0
        return
    }
    if m < (x * e4) {
        PairAdd(x * (Log(x) - 1), yh, yl)
        PairAdd(-x * Log(m), yh, yl)
        return
    }
    e: s32 = 0
    r: float64 = FrexpM(m / x, *e)
    i: s32 = TruncateToS32(Round((r - 0.5) * 256))
    f: float64 = Round(1024 / (0.5 + cast(float64)i / 256))
    fg: float64 = Scalbn(f, -e - 10)
    j: s32 = 3
    while j >= 0 {
        PairAdd(x * BD0_V[i * 4 + j], yh, yl)
        PairAdd(-x * cast(float64)e * BD0_V[j], yh, yl)
        j -= 1
    }
    PairAdd(m, yh, yl)
    m1: float64 = Round(m)
    PairAdd(-m1 * fg, yh, yl)
    PairAdd(-(m - m1) * fg, yh, yl)
    PairAdd(-x * Log1pmx((m * fg - x) / x), yh, yl)
}

Pow1p :: (x: float64, y: float64) -> float64 {
    if (x + 1 - 1) == x || x > 0.5 || x < -0.5 || x != x || y != y {
        return Pow(1 + x, y)
    }
    if y < 0 {
        return 1 / Pow1p(x, -y)
    }
    x1: float64 = Round(x * 65536) / 65536
    x2: float64 = x - x1
    h: float64 = 0
    l: float64 = 0
    Ebd0(y, y * (x + 1), *h, *l)
    PairAdd(-y * x1, *h, *l)
    PairAdd(-y * x2, *h, *l)
    return Exp(-l) * Exp(-h)
}

Pow1pm1 :: (x: float64, y: float64) -> float64 {
    if x <= -1 {
        return Pow(1 + x, y) - 1
    }
    return Expm1(y * Log1p(x))
}

CalcPvif :: (rate: float64, nper: float64) -> float64 {
    return Pow1p(rate, nper)
}

CalcFvifa :: (rate: float64, nper: float64) -> float64 {
    if rate == 0 {
        return nper
    }
    return Pow1pm1(rate, nper) / rate
}

CalcPmt :: (rate: float64, nper: float64, pv: float64, fv: float64, ptype: s32) -> float64 {
    pvif: float64 = CalcPvif(rate, nper)
    fvifa: float64 = CalcFvifa(rate, nper)
    return (-pv * pvif - fv) / ((1 + rate * cast(float64)ptype) * fvifa)
}

CalcIpmtGo :: (rate: float64, per: float64, nper: float64, pv: float64, fv: float64, ptype: s32) -> float64 {
    pmt: float64 = CalcPmt(rate, nper, pv, fv, 0)
    ipmt: float64 = -(pv * Pow1p(rate, per - 1) * rate + pmt * Pow1pm1(rate, per - 1))
    if ptype == 0 {
        return ipmt
    }
    return ipmt / (1 + rate)
}

GetRmz :: (r: float64, n: float64, pv: float64, fv: float64, ptype: s32) -> float64 {
    rmz: float64 = 0
    term: float64 = 0
    if r == 0 {
        rmz = (pv + fv) / n
        return -rmz
    }
    term = Pow1p(r, n)
    if ptype > 0 {
        rmz = ((fv * r) / (term - 1) + (pv * r) / (1 - 1 / term)) / (1 + r)
    } else {
        rmz = (fv * r) / (term - 1) + (pv * r) / (1 - 1 / term)
    }
    return -rmz
}

GetZw :: (r: float64, n: float64, pmt: float64, pv: float64, ptype: s32) -> float64 {
    zw: float64 = 0
    term: float64 = 0
    if r == 0 {
        zw = pv + pmt * n
        return -zw
    }
    term = Pow1p(r, n)
    if ptype > 0 {
        zw = pv * term + (pmt * (1 + r) * (term - 1)) / r
    } else {
        zw = pv * term + (pmt * (term - 1)) / r
    }
    return -zw
}

AnnualBasis :: (serial: s32, basis: s32) -> s32 {
    y: s32 = 0
    m: s32 = 0
    d: s32 = 0
    if basis == 0 || basis == 2 || basis == 4 {
        return 360
    }
    if basis == 3 {
        return 365
    }
    SerialToYmd(serial, *y, *m, *d)
    if IsLeapYear(y) != 0 {
        return 366
    }
    return 365
}

DaysMonthlyBasis :: (s1: s32, s2: s32, basis: s32) -> s32 {
    iy: s32 = 0
    im: s32 = 0
    id: s32 = 0
    my: s32 = 0
    mm: s32 = 0
    md: s32 = 0
    SerialToYmd(s1, *iy, *im, *id)
    SerialToYmd(s2, *my, *mm, *md)
    years: s32 = my - iy
    months: s32 = mm - im
    days: s32 = md - id
    months = years * 12 + months
    if basis == 0 {
        if im == 2 && mm != 2 && iy == my {
            if IsLeapYear(iy) != 0 {
                return months * 30 + days - 1
            }
            return months * 30 + days - 2
        }
        return months * 30 + days
    }
    if basis == 1 || basis == 2 || basis == 3 {
        return s2 - s1
    }
    if basis == 4 {
        return months * 30 + days
    }
    return -1
}

FnPmt :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    r: float64 = 0
    n: float64 = 0
    pv: float64 = 0
    fv: float64 = 0
    ptype: s32 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    r = ArgAt(args, count, 0, 0)
    n = ArgAt(args, count, 1, 0)
    pv = ArgAt(args, count, 2, 0)
    fv = ArgAt(args, count, 3, 0)
    ptype = ArgAtInt(args, count, 4, 0)
    return ValNumber(CalcPmt(r, n, pv, fv, ptype))
}

FnFv :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    r: float64 = 0
    n: float64 = 0
    pmt: float64 = 0
    pv: float64 = 0
    ptype: s32 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    r = ArgAt(args, count, 0, 0)
    n = ArgAt(args, count, 1, 0)
    pmt = ArgAt(args, count, 2, 0)
    pv = ArgAt(args, count, 3, 0)
    ptype = ArgAtInt(args, count, 4, 0)
    pvif: float64 = CalcPvif(r, n)
    fvifa: float64 = CalcFvifa(r, n)
    return ValNumber(-(pv * pvif + pmt * (1 + r * cast(float64)ptype) * fvifa))
}

FnPv :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    r: float64 = 0
    n: float64 = 0
    pmt: float64 = 0
    fv: float64 = 0
    ptype: s32 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    r = ArgAt(args, count, 0, 0)
    n = ArgAt(args, count, 1, 0)
    pmt = ArgAt(args, count, 2, 0)
    fv = ArgAt(args, count, 3, 0)
    ptype = ArgAtInt(args, count, 4, 0)
    pvif: float64 = CalcPvif(r, n)
    fvifa: float64 = CalcFvifa(r, n)
    if pvif == 0 {
        return ValError(ERR_DIV0)
    }
    return ValNumber((-fv - pmt * (1 + r * cast(float64)ptype) * fvifa) / pvif)
}

FnNper :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    r: float64 = 0
    pmt: float64 = 0
    pv: float64 = 0
    fv: float64 = 0
    ptype: s32 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    r = ArgAt(args, count, 0, 0)
    pmt = ArgAt(args, count, 1, 0)
    pv = ArgAt(args, count, 2, 0)
    fv = ArgAt(args, count, 3, 0)
    ptype = ArgAtInt(args, count, 4, 0)
    if r == 0 {
        if pmt == 0 {
            return ValError(ERR_DIV0)
        }
        return ValNumber(-(pv + fv) / pmt)
    }
    if r <= -1 {
        return ValError(ERR_NUM)
    }
    adj: float64 = pmt * (1 + r * cast(float64)ptype)
    num: float64 = adj - fv * r
    den: float64 = pv * r + adj
    if num <= 0 {
        return ValError(ERR_VALUE)
    }
    return ValNumber(Log(num / den) / Log1p(r))
}

FnIpmt :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    r: float64 = 0
    per: float64 = 0
    n: float64 = 0
    pv: float64 = 0
    fv: float64 = 0
    ptype: s32 = 0
    if count < 4 {
        return ValError(ERR_VALUE)
    }
    r = ArgAt(args, count, 0, 0)
    per = ArgAt(args, count, 1, 0)
    n = ArgAt(args, count, 2, 0)
    pv = ArgAt(args, count, 3, 0)
    fv = ArgAt(args, count, 4, 0)
    ptype = ArgAtInt(args, count, 5, 0)
    if per < 1 || per >= (n + 1) {
        return ValError(ERR_NUM)
    }
    return ValNumber(CalcIpmtGo(r, per, n, pv, fv, ptype))
}

FnPpmt :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    r: float64 = 0
    n: float64 = 0
    ptype: s32 = 0
    pmt: float64 = 0
    ipmt: Val
    v: float64 = 0
    if count < 4 {
        return ValError(ERR_VALUE)
    }
    r = ArgAt(args, count, 0, 0)
    n = ArgAt(args, count, 2, 0)
    ptype = ArgAtInt(args, count, 5, 0)
    pv: float64 = ArgAt(args, count, 3, 0)
    fv: float64 = ArgAt(args, count, 4, 0)
    per: float64 = ArgAt(args, count, 1, 0)
    if per < 1 || per >= (n + 1) {
        return ValError(ERR_NUM)
    }
    pmt = CalcPmt(r, n, pv, fv, ptype)
    ipmt_v: float64 = CalcIpmtGo(r, per, n, pv, fv, ptype)
    v = pmt - ipmt_v
    return ValNumber(v)
}

FnIspmt :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    r: float64 = 0
    per: float64 = 0
    n: float64 = 0
    pv: float64 = 0
    if count < 4 {
        return ValError(ERR_VALUE)
    }
    r = ArgAt(args, count, 0, 0)
    per = ArgAt(args, count, 1, 0)
    n = ArgAt(args, count, 2, 0)
    pv = ArgAt(args, count, 3, 0)
    if n == 0 {
        return ValError(ERR_DIV0)
    }
    tmp: float64 = -pv * r
    return ValNumber(tmp - (tmp / n) * per)
}

CumulativeLoanPart :: (st: *EvalState, args: *Val, count: s32, marks: *s32, want_interest: s32) -> Val {
    r: float64 = 0
    n: s32 = 0
    pv: float64 = 0
    start: s32 = 0
    endi: s32 = 0
    ptype: s32 = 0
    if count < 6 {
        return ValError(ERR_VALUE)
    }
    r = ArgAt(args, count, 0, 0)
    n = ArgAtInt(args, count, 1, 0)
    pv = ArgAt(args, count, 2, 0)
    start = ArgAtInt(args, count, 3, 1)
    endi = ArgAtInt(args, count, 4, 1)
    ptype = ArgAtInt(args, count, 5, 0)
    if start < 1 || endi < start || endi > n || n < 1 || pv <= 0 {
        return ValError(ERR_NUM)
    }
    rmz: float64 = GetRmz(r, cast(float64)n, pv, 0, ptype)
    total: float64 = 0
    i: s32 = 0
    if start == 1 {
        if want_interest != 0 {
            if ptype <= 0 {
                total = -pv
            }
        } else {
            if ptype <= 0 {
                total = rmz + pv * r
            } else {
                total = rmz
            }
        }
        start += 1
    }
    i = start
    while i <= endi {
        if want_interest != 0 {
            if ptype > 0 {
                total += GetZw(r, cast(float64)(i - 2), rmz, pv, 1) - rmz
            } else {
                total += GetZw(r, cast(float64)(i - 1), rmz, pv, 0)
            }
        } else {
            if ptype > 0 {
                total += rmz - (GetZw(r, cast(float64)(i - 2), rmz, pv, 1) - rmz) * r
            } else {
                total += rmz - GetZw(r, cast(float64)(i - 1), rmz, pv, 0) * r
            }
        }
        i += 1
    }
    if want_interest != 0 {
        total *= r
    }
    return ValNumber(total)
}

FnNpv :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    r: float64 = 0
    total: float64 = 0
    i: s32 = 0
    if count < 1 {
        return ValError(ERR_VALUE)
    }
    r = ArgAt(args, count, 0, 0)
    if r == -1 {
        return ValError(ERR_DIV0)
    }
    total = 0
    f: float64 = 1
    ff: float64 = 1 / (1 + r)
    i = 1
    while i < count {
        if args[i].kind == VAL_ERROR {
            return ValError(args[i].err)
        }
        if args[i].kind == VAL_FLOAT {
            f *= ff
            total += args[i].number * f
        }
        i += 1
    }
    return ValNumber(total)
}

CashList :: (args: *Val, count: s32, out: *float64) -> s32 {
    n: s32 = 0
    i: s32 = 0
    while i < count {
        if args[i].kind == VAL_ERROR {
            return -1
        }
        if args[i].kind == VAL_FLOAT {
            if n < 4096 {
                out[n] = args[i].number
                n += 1
            }
        }
        i += 1
    }
    return n
}

FnSln :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    c: float64 = 0
    s: float64 = 0
    life: float64 = 0
    if count < 3 {
        return ValError(ERR_VALUE)
    }
    c = ArgAt(args, count, 0, 0)
    s = ArgAt(args, count, 1, 0)
    life = ArgAt(args, count, 2, 0)
    if life == 0 {
        return ValError(ERR_DIV0)
    }
    return ValNumber((c - s) / life)
}

FnSyd :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    c: float64 = 0
    s: float64 = 0
    life: float64 = 0
    per: float64 = 0
    if count < 4 {
        return ValError(ERR_VALUE)
    }
    c = ArgAt(args, count, 0, 0)
    s = ArgAt(args, count, 1, 0)
    life = ArgAt(args, count, 2, 0)
    per = ArgAt(args, count, 3, 0)
    if life <= 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber(((c - s) * (life - per + 1) * 2) / (life * (life + 1)))
}

FnDdb :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    c: float64 = 0
    s: float64 = 0
    life: float64 = 0
    per: float64 = 0
    factor: float64 = 0
    if count < 4 {
        return ValError(ERR_VALUE)
    }
    c = ArgAt(args, count, 0, 0)
    s = ArgAt(args, count, 1, 0)
    life = ArgAt(args, count, 2, 0)
    per = ArgAt(args, count, 3, 0)
    factor = ArgAt(args, count, 4, 2)
    if life <= 0 || per < 1 || per > life {
        return ValError(ERR_NUM)
    }
    total: float64 = 0
    p: s32 = 1
    while p <= TruncateToS32(per) {
        dep: float64 = ((c - total) * factor) / life
        if (c - total - dep) < s {
            dep = c - total - s
        }
        if p == TruncateToS32(per) {
            return ValNumber(dep)
        }
        total += dep
        p += 1
    }
    return ValNumber(0)
}

FnDb :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    c: float64 = 0
    s: float64 = 0
    life: float64 = 0
    per: float64 = 0
    month: float64 = 0
    rate: float64 = 0
    if count < 4 {
        return ValError(ERR_VALUE)
    }
    c = ArgAt(args, count, 0, 0)
    s = ArgAt(args, count, 1, 0)
    life = ArgAt(args, count, 2, 0)
    per = ArgAt(args, count, 3, 0)
    month = ArgAt(args, count, 4, 12)
    if c <= 0 || life <= 0 {
        return ValError(ERR_NUM)
    }
    rate = 1.0 - FinPower(s / c, 1.0 / life)
    rate = cast(float64)TruncateToS64(rate * 1000.0 + 0.5) / 1000.0
    first: float64 = (c * rate * month) / 12.0
    if per == 1 {
        return ValNumber(first)
    }
    total: float64 = first
    p: s32 = 2
    while p <= TruncateToS32(per) {
        dep: float64 = (c - total) * rate
        if p == (TruncateToS32(life) + 1) {
            dep = ((c - total) * rate * (12.0 - month)) / 12.0
        }
        if p == TruncateToS32(per) {
            return ValNumber(dep)
        }
        total += dep
        p += 1
    }
    return ValNumber(0)
}

FnVdb :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    c: float64 = 0
    s: float64 = 0
    life: float64 = 0
    start: float64 = 0
    endi: float64 = 0
    factor: float64 = 0
    no_switch: s32 = 0
    if count < 5 {
        return ValError(ERR_VALUE)
    }
    c = ArgAt(args, count, 0, 0)
    s = ArgAt(args, count, 1, 0)
    life = ArgAt(args, count, 2, 0)
    start = ArgAt(args, count, 3, 0)
    endi = ArgAt(args, count, 4, 0)
    factor = ArgAt(args, count, 5, 2)
    no_switch = ArgAtInt(args, count, 6, 0)
    if life <= 0 {
        return ValError(ERR_NUM)
    }
    if no_switch != 0 {
        dep: float64 = (c * factor) / life
        if start > 0 {
            dep = 0
        }
        if endi <= 1 {
            dep = (c * factor) / life
        }
        return ValNumber(dep)
    }
    total_before: float64 = 0
    p: s32 = 0
    while cast(float64)p < start {
        dep2: float64 = ((c - total_before) * factor) / life
        if (c - total_before - dep2) < s {
            dep2 = c - total_before - s
        }
        total_before += dep2
        p += 1
    }
    total: float64 = total_before
    while cast(float64)p < endi {
        dep3: float64 = ((c - total) * factor) / life
        straight: float64 = (c - total - s) / (life - cast(float64)p)
        if straight > dep3 {
            dep3 = straight
        }
        if (c - total - dep3) < s {
            dep3 = c - total - s
        }
        total += dep3
        p += 1
    }
    return ValNumber(total - total_before)
}

FnYearfrac :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    s1: s32 = 0
    s2: s32 = 0
    basis: s32 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    s1 = ArgDate(args, count, 0, -1)
    s2 = ArgDate(args, count, 1, -1)
    basis = ArgBasis(args, count, 2)
    if s1 < 0 || s2 < 0 || basis < 0 {
        return ValError(ERR_NUM)
    }
    return ValNumber(YearFracBasis(s1, s2, basis))
}

CouponDate :: (settle: s32, mature: s32, freq: s32, eom: s32, want_next: s32) -> s32 {
    sy: s32 = 0
    sm: s32 = 0
    sd: s32 = 0
    my: s32 = 0
    mm: s32 = 0
    md: s32 = 0
    SerialToYmd(settle, *sy, *sm, *sd)
    SerialToYmd(mature, *my, *mm, *md)
    eom_special: s32 = 0
    if eom != 0 && IsLastOfMonth(my, mm, md) != 0 {
        eom_special = 1
    }
    months: s32 = 12 / freq
    periods: s32 = my - sy
    if periods > 0 {
        periods = (periods - 1) * freq
    }
    result: s32 = mature
    while true {
        result = mature
        periods += 1
        result = AddMonthsSerial(result, -periods * months)
        if eom_special != 0 {
            ry: s32 = 0
            rm: s32 = 0
            rd: s32 = 0
            SerialToYmd(result, *ry, *rm, *rd)
            result = YmdToSerial(ry, rm, DaysInMonthGo(ry, rm))
        }
        if settle >= result {
            break
        }
    }
    if want_next != 0 {
        result = mature
        periods -= 1
        result = AddMonthsSerial(result, -periods * months)
        if eom_special != 0 {
            ry: s32 = 0
            rm: s32 = 0
            rd: s32 = 0
            SerialToYmd(result, *ry, *rm, *rd)
            result = YmdToSerial(ry, rm, DaysInMonthGo(ry, rm))
        }
    }
    return result
}

CouponNext :: (settle: s32, mature: s32, freq: s32) -> s32 {
    return CouponDate(settle, mature, freq, 1, 1)
}

CouponPrev :: (settle: s32, mature: s32, freq: s32) -> s32 {
    return CouponDate(settle, mature, freq, 1, 0)
}

CouponCount :: (settle: s32, mature: s32, freq: s32) -> s32 {
    sy: s32 = 0
    sm: s32 = 0
    sd: s32 = 0
    my: s32 = 0
    mm: s32 = 0
    md: s32 = 0
    SerialToYmd(settle, *sy, *sm, *sd)
    SerialToYmd(mature, *my, *mm, *md)
    months: s32 = mm - sm + 12 * (my - sy)
    this_coupon: s32 = AddMonthsSerial(mature, -months)
    if IsLastOfMonth(my, mm, md) != 0 {
        while true {
            cy: s32 = 0
            cm: s32 = 0
            cd: s32 = 0
            SerialToYmd(this_coupon, *cy, *cm, *cd)
            if cd == DaysInMonthGo(cy, cm) {
                break
            }
            this_coupon += 1
        }
    }
    cy2: s32 = 0
    cm2: s32 = 0
    cd2: s32 = 0
    SerialToYmd(this_coupon, *cy2, *cm2, *cd2)
    if sd >= cd2 {
        months -= 1
    }
    return 1 + months / (12 / freq)
}

CoupDaysBs :: (settle: s32, mature: s32, freq: s32, basis: s32) -> float64 {
    return cast(float64)BasisDaysBetween(CouponPrev(settle, mature, freq), settle, basis)
}

CoupDaysNc :: (settle: s32, mature: s32, freq: s32, basis: s32) -> float64 {
    return cast(float64)BasisDaysBetween(settle, CouponNext(settle, mature, freq), basis)
}

CoupDaysGo :: (settle: s32, mature: s32, freq: s32, basis: s32) -> float64 {
    if basis == 1 {
        return cast(float64)BasisDaysBetween(CouponPrev(settle, mature, freq), CouponNext(settle, mature, freq), 1)
    }
    if basis == 3 {
        return 365.0 / cast(float64)freq
    }
    return 360.0 / cast(float64)freq
}

FnCoupncd :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    settle: s32 = 0
    mature: s32 = 0
    freq: s32 = 0
    if count < 2 {
        return ValError(ERR_VALUE)
    }
    settle = ArgDate(args, count, 0, -1)
    mature = ArgDate(args, count, 1, -1)
    freq = ArgAtInt(args, count, 2, 1)
    basis: s32 = ArgBasis(args, count, 3)
    if settle < 0 || mature < 0 || freq == 0 || basis < 0 {
        return ValError(ERR_NUM)
    }
    if settle >= mature {
        return ValError(ERR_NUM)
    }
    return ValNumber(cast(float64)CouponNext(settle, mature, freq))
}

FnCouppcd :: (st: *EvalState, args: *Val, count: s32, marks: *s32) -> Val {
    settle: s32 = 0
    mature: s32 = 0
