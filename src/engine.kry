}

FnCounta :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    n: int = 0
    i: int = 0
    while i < count {
        if args[i].kind != VAL_EMPTY { n += 1 }
        i += 1
    }
    return ValNumber(n)
}

FnCountblank :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    n: int = 0
    i: int = 0
    while i < count {
        if args[i].kind == VAL_EMPTY { n += 1 }
        else if args[i].kind == VAL_STRING && args[i].text != NULL && args[i].text[0] == 0 { n += 1 }
        i += 1
    }
    return ValNumber(n)
}

FnMinMax :: (st: EvalState *, args: Val *, count: int, marks: int *, want_max: int) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    if list.saw_error { return FirstError(args,count) }
    if list.count == 0 { return ValNumber(0) }
    best: double = list.data[0]
    i: int = 1
    while i < list.count {
        if (want_max) {
            if list.data[i] > best { best = list.data[i] }
        }
else {
            if list.data[i] < best { best = list.data[i] }
        }
        i += 1
    }
    return ValNumber(best)
}

FnProduct :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    if list.saw_error { return FirstError(args,count) }
    total: double = 1
    i: int = 0
    while i < list.count {
        total *= list.data[i]
        i += 1
    }
    return ValNumber(total)
}

FnSumSq :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    if list.saw_error { return FirstError(args,count) }
    total: double = 0
    i: int = 0
    while i < list.count {
        total += list.data[i] * list.data[i]
        i += 1
    }
    return ValNumber(total)
}

SortDoubles :: (data: double *, n: int) {
    i: int = 1
    while i < n {
        x: double = data[i]
        j: int = i - 1
        while j >= 0 && data[j] > x {
            data[j + 1] = data[j]
            j -= 1
        }
        data[j + 1] = x
        i += 1
    }
}

FnMedian :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    if list.saw_error { return FirstError(args,count) }
    if list.count == 0 { return ValError(ERR_NUM) }
    SortDoubles(list.data,list.count)
    mid: int = list.count / 2
    if list.count % 2 != 0 { return ValNumber(list.data[mid]) }
    return ValNumber((list.data[mid - 1] + list.data[mid]) / 2.0)
}

FnVar :: (st: EvalState *, args: Val *, count: int, marks: int *, sample: int) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    if list.saw_error { return FirstError(args,count) }
    if (sample && list.count < 2) || (!sample && list.count < 1) { return ValError(ERR_DIV0) }
    total: double = 0
    i: int = 0
    while i < list.count {
        total += list.data[i]
        i += 1
    }
    mean: double = total / list.count
    sq: double = 0
    i = 0
    while i < list.count {
        d: double = list.data[i] - mean
        sq += d * d
        i += 1
    }
    div: double = sample ? list.count - 1 : list.count
    return ValNumber(sq / div)
}

FnStdev :: (st: EvalState *, args: Val *, count: int, marks: int *, sample: int) -> Val {
    v: Val = FnVar(st,args,count,marks,sample)
    if v.kind == VAL_ERROR { return v }
    return ValNumber(sqrt(v.number))
}

FnLargeSmall :: (st: EvalState *, args: Val *, count: int, marks: int *, large: int) -> Val {
    list: NumList = {0}
    k: double = 0
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if args[count - 1].kind == VAL_ERROR { return ValError(args[count - 1].err) }
    CollectNumbers(args,count - 1,&list)
    k = ArgNumberAt(args,count,count - 1)
    if k < 1 || k != (double)(long long)k || (int)k > list.count { return ValError(ERR_NUM) }
    SortDoubles(list.data,list.count)
    idx: int = large ? list.count - (int)k : (int)k - 1
    return ValNumber(list.data[idx])
}

FnIf :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    cond: int = 0
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    cond = CoerceBool(&args[0])
    if cond < 0 { return ValError(ERR_VALUE) }
    if (cond) { return ValCopy(&args[1]) }
    if count >= 3 { return ValCopy(&args[2]) }
    return ValBool(0)
}

FnIfError :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValCopy(&args[1]) }
    return ValCopy(&args[0])
}

FnIfNa :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR && args[0].err == ERR_NA { return ValCopy(&args[1]) }
    return ValCopy(&args[0])
}

FnNot :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    flag: int = 0
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    flag = CoerceBool(&args[0])
    if flag < 0 { return ValError(ERR_VALUE) }
    return ValBool(flag == 0)
}

FnAndOr :: (st: EvalState *, args: Val *, count: int, marks: int *, is_and: int) -> Val {
    seen: int = 0
    result: int = is_and
    i: int = 0
    while i < count {
        v: Val * = &args[i]
        if v->kind == VAL_ERROR { return ValError(v->err) }
        if v->kind == VAL_FLOAT || v->kind == VAL_BOOL {
            seen = 1
            flag: int = v->number != 0
            if (is_and) { result = result && flag }
else { result = result || flag }
        }
        i += 1
    }
    if seen == 0 { return ValError(ERR_VALUE) }
    return ValBool(result)
}

FnXor :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    parity: int = 0
    i: int = 0
    while i < count {
        if args[i].kind == VAL_ERROR { return ValError(args[i].err) }
        if args[i].kind == VAL_FLOAT || args[i].kind == VAL_BOOL {
            if args[i].number != 0 { parity += 1 }
        }
        i += 1
    }
    return ValBool(parity % 2 != 0)
}

FnIsError :: (st: EvalState *, args: Val *, count: int, marks: int *, include_na: int) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR {
        if !include_na && args[0].err == ERR_NA { return ValBool(0) }
        return ValBool(1)
    }
    return ValBool(0)
}

FnIsType :: (st: EvalState *, args: Val *, count: int, marks: int *, kind: int) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    return ValBool(args[0].kind == kind)
}

FnN :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_FLOAT || args[0].kind == VAL_BOOL { return ValNumber(args[0].number) }
    return ValNumber(0)
}

TextArg :: (args: Val *, count: int, index: int, out: char *, cap: int) -> int {
    if index >= count { return 0 }
    if args[index].kind == VAL_ERROR { return -1 }
    CoerceText(&args[index],out,cap)
    return 1
}

FnLen :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    text: [WB_TEXT_MAX * 2] char = ""
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    return ValNumber(strlen(text))
}

FnUpper :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    text: [WB_TEXT_MAX * 2] char = ""
    i: int = 0
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    i = 0
    while text[i] != 0 {
        text[i] = (char)toupper((unsigned char)text[i])
        i += 1
    }
    return ValString(wb_strdup(text))
}

FnLower :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    text: [WB_TEXT_MAX * 2] char = ""
    i: int = 0
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    i = 0
    while text[i] != 0 {
        text[i] = (char)tolower((unsigned char)text[i])
        i += 1
    }
    return ValString(wb_strdup(text))
}

FnTrim :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    src: [WB_TEXT_MAX * 2] char = ""
    out: [WB_TEXT_MAX * 2] char = ""
    n: int = 0
    pending_space: int = 0
    i: int = 0
    if TextArg(args,count,0,src,sizeof(src)) < 0 { return ValError(ERR_VALUE) }
    i = 0
    while src[i] != 0 {
        if src[i] == ' ' {
            if n > 0 { pending_space = 1 }
        }
else {
            if pending_space && n > 0 {
                if n < (int)sizeof(out) - 1 { out[n] = ' '; n += 1 }
                pending_space = 0
            }
            if n < (int)sizeof(out) - 1 { out[n] = src[i]; n += 1 }
        }
        i += 1
    }
    out[n] = 0
    return ValString(wb_strdup(out))
}

FnLeftRight :: (st: EvalState *, args: Val *, count: int, marks: int *, left: int) -> Val {
    text: [WB_TEXT_MAX * 2] char = ""
    n: double = 1
    len: int = 0
    take: int = 0
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    if count >= 2 {
        if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
        n = CoerceNumber(&args[1])
    }
    if n < 0 { return ValError(ERR_VALUE) }
    len = (int)strlen(text)
    take = (int)n
    if take > len { take = len }
    if (left) { return ValString(wb_strndup(text,take)) }
    return ValString(wb_strndup(text + len - take,take))
}

FnMid :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    text: [WB_TEXT_MAX * 2] char = ""
    start: double = 0
    n: double = 0
    len: int = 0
    take: int = 0
    if count < 3 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
    if args[2].kind == VAL_ERROR { return ValError(args[2].err) }
    start = CoerceNumber(&args[1])
    n = CoerceNumber(&args[2])
    if start < 1 || n < 0 { return ValError(ERR_VALUE) }
    len = (int)strlen(text)
    if start - 1 >= len { return ValString(wb_strdup("")) }
    take = (int)n
    if start - 1 + take > len { take = len - (int)start + 1 }
    return ValString(wb_strndup(text + (int)start - 1,take))
}

FnRepeatText :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    text: [WB_TEXT_MAX] char = ""
    out: [WB_TEXT_MAX * 2] char = ""
    n: double = 0
    i: int = 0
    if count < 2 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
    n = CoerceNumber(&args[1])
    if n < 0 { return ValError(ERR_VALUE) }
    if (int)n * (int)strlen(text) >= (int)sizeof(out) { return ValError(ERR_VALUE) }
    i = 0
    while i < (int)n {
        strcat(out,text)
        i += 1
    }
    return ValString(wb_strdup(out))
}

FnConcatenate :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    out: [WB_TEXT_MAX * 4] char = ""
    piece: [WB_TEXT_MAX * 2] char = ""
    i: int = 0
    while i < count {
        if args[i].kind == VAL_ERROR { return ValError(args[i].err) }
        CoerceText(&args[i],piece,sizeof(piece))
        if strlen(out) + strlen(piece) >= sizeof(out) { return ValError(ERR_VALUE) }
        strcat(out,piece)
        i += 1
    }
    return ValString(wb_strdup(out))
}

FnFind :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    needle: [WB_TEXT_MAX] char = ""
    hay: [WB_TEXT_MAX * 2] char = ""
    start: double = 1
    hit: CString = 0
    if count < 2 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,needle,sizeof(needle)) < 0 { return ValError(ERR_VALUE) }
    if TextArg(args,count,1,hay,sizeof(hay)) < 0 { return ValError(ERR_VALUE) }
    if count >= 3 {
        if args[2].kind == VAL_ERROR { return ValError(args[2].err) }
        start = CoerceNumber(&args[2])
    }
    if start < 1 || start - 1 > (double)strlen(hay) { return ValError(ERR_VALUE) }
    hit = strstr(hay + (int)start - 1,needle)
    if hit == NULL { return ValError(ERR_VALUE) }
    return ValNumber(hit - hay + 1)
}

FnSearch :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    needle: [WB_TEXT_MAX] char = ""
    hay: [WB_TEXT_MAX * 2] char = ""
    start: double = 1
    i: int = 0
    if count < 2 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,needle,sizeof(needle)) < 0 { return ValError(ERR_VALUE) }
    if TextArg(args,count,1,hay,sizeof(hay)) < 0 { return ValError(ERR_VALUE) }
    if count >= 3 {
        if args[2].kind == VAL_ERROR { return ValError(args[2].err) }
        start = CoerceNumber(&args[2])
    }
    if start < 1 || start - 1 > (double)strlen(hay) { return ValError(ERR_VALUE) }
    i = (int)start - 1
    while hay[i] != 0 {
        j: int = 0
        while needle[j] != 0 {
            if hay[i + j] == 0 { break }
            if tolower((unsigned char)hay[i + j]) != tolower((unsigned char)needle[j]) { break }
            j += 1
        }
        if needle[j] == 0 { return ValNumber(i + 1) }
        i += 1
    }
    return ValError(ERR_VALUE)
}

FnSubstitute :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    text: [WB_TEXT_MAX * 2] char = ""
    old: [WB_TEXT_MAX] char = ""
    new: [WB_TEXT_MAX] char = ""
    out: [WB_TEXT_MAX * 4] char = ""
    n: int = 0
    i: int = 0
    which: int = -1
    replaced: int = 0
    if count < 3 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    if TextArg(args,count,1,old,sizeof(old)) < 0 { return ValError(ERR_VALUE) }
    if TextArg(args,count,2,new,sizeof(new)) < 0 { return ValError(ERR_VALUE) }
    if count >= 4 {
        if args[3].kind == VAL_ERROR { return ValError(args[3].err) }
        which = (int)CoerceNumber(&args[3])
        if which < 1 { return ValError(ERR_VALUE) }
    }
    if old[0] == 0 { return ValString(wb_strdup(text)) }
    while text[i] != 0 {
        if strncmp(text + i,old,strlen(old)) == 0 {
            replaced += 1
            if which < 0 || replaced == which {
                j: int = 0
                while new[j] != 0 && n < (int)sizeof(out) - 1 { out[n] = new[j]; n += 1; j += 1 }
                i += (int)strlen(old)
                continue
            }
        }
        if n < (int)sizeof(out) - 1 { out[n] = text[i]; n += 1 }
        i += 1
    }
    out[n] = 0
    return ValString(wb_strdup(out))
}

FnExact :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    a: [WB_TEXT_MAX * 2] char = ""
    b: [WB_TEXT_MAX * 2] char = ""
    if count < 2 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,a,sizeof(a)) < 0 { return ValError(ERR_VALUE) }
    if TextArg(args,count,1,b,sizeof(b)) < 0 { return ValError(ERR_VALUE) }
    return ValBool(strcmp(a,b) == 0)
}

FnChar :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    code: int = 0
    out: [8] char = ""
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    code = (int)CoerceNumber(&args[0])
    if code < 1 || code > 255 { return ValError(ERR_VALUE) }
    out[0] = (char)code
    return ValString(wb_strdup(out))
}

FnCode :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    text: [WB_TEXT_MAX * 2] char = ""
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    if text[0] == 0 { return ValError(ERR_VALUE) }
    return ValNumber((unsigned char)text[0])
}

FnValue :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    text: [WB_TEXT_MAX * 2] char = ""
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    if !TextLooksNumeric(text) { return ValError(ERR_VALUE) }
    return ValNumber(strtod(text,NULL))
}

FnT :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_STRING { return ValCopy(&args[0]) }
    return ValString(wb_strdup(""))
}

FormatThousands :: (digits: const char *, out: char *, cap: int) {
    dot: CString = strchr(digits,'.')
    int_len: int = dot != NULL ? (int)(dot - digits) : (int)strlen(digits)
    negative: int = digits[0] == '-'
    start: int = negative ? 1 : 0
    n: int = 0
    i: int = start
    if negative && cap > 1 { out[0] = '-'; n = 1 }
    while i < int_len {
        if (int_len - i) % 3 == 0 && i > start && n + 1 < cap {
            out[n] = ','
            n += 1
        }
        if n + 1 < cap { out[n] = digits[i]; n += 1 }
        i += 1
    }
    if dot != NULL {
        i = 0
        while dot[i] != 0 && n + 1 < cap { out[n] = dot[i]; n += 1; i += 1 }
    }
    out[n] = 0
}

FormatWithPattern :: (value: double, fmt: const char *, out: char *, cap: int) {
    percent: int = 0
    decimals: int = -1
    comma: int = 0
    i: int = 0
    while fmt[i] != 0 {
        if fmt[i] == '%' { percent = 1 }
        if fmt[i] == ',' { comma = 1 }
        if fmt[i] == '.' {
            decimals = 0
            j: int = i + 1
            while fmt[j] >= '0' && fmt[j] <= '9' { decimals += 1; j += 1 }
        }
        i += 1
    }
    v: double = percent ? value * 100.0 : value
    if decimals < 0 { decimals = 0 }
    tmp: [64] char = ""
    snprintf(tmp,sizeof(tmp),"%.*f",decimals,v)
    if (comma) {
        FormatThousands(tmp,out,cap)
    }
else {
        snprintf(out,cap,"%s",tmp)
    }
    if (percent) {
        len: int = (int)strlen(out)
        if len + 1 < cap {
            out[len] = '%'
            out[len + 1] = 0
        }
    }
}

FnText :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    fmt: [WB_TEXT_MAX] char = ""
    out: [WB_TEXT_MAX * 2] char = ""
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if TextArg(args,count,1,fmt,sizeof(fmt)) < 0 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_STRING { return ValCopy(&args[0]) }
    FormatWithPattern(CoerceNumber(&args[0]),fmt,out,sizeof(out))
    return ValString(wb_strdup(out))
}

DaysFromCivil :: (y: int, m: int, d: int) -> int {
    yy: int = m <= 2 ? y - 1 : y
    era: int = 0
    yoe: int = 0
    mp: int = (m + 9) % 12
    doy: int = (153 * mp + 2) / 5 + d - 1
    doe: int = 0
    if yy >= 0 { era = yy / 400 }
else { era = (yy - 399) / 400 }
    yoe = yy - era * 400
    doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

CivilFromDays :: (z_in: int, y: int *, m: int *, d: int *) {
    z: int = z_in + 719468
    era: int = 0
    doe: int = 0
    yoe: int = 0
    cy: int = 0
    doy: int = 0
    cm: int = 0
    if z >= 0 { era = z / 146097 }
else { era = (z - 146096) / 146097 }
    doe = z - era * 146097
    yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    cy = yoe + era * 400
    doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    cm = (5 * doy + 2) / 153
    d[0] = doy - (153 * cm + 2) / 5 + 1
    m[0] = cm + 3
    if m[0] > 12 { m[0] -= 12 }
    y[0] = cy + (m[0] <= 2 ? 1 : 0)
}


SerialEpoch :: () -> int {
    return DaysFromCivil(1899,12,30)
}

FnDate :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    y: int = 0
    m: int = 0
    d: int = 0
    i: int = 0
    if count < 3 { return ValError(ERR_VALUE) }
    while i < 3 {
        if args[i].kind == VAL_ERROR { return ValError(args[i].err) }
        i += 1
    }
    y = (int)CoerceNumber(&args[0])
    m = (int)CoerceNumber(&args[1])
    d = (int)CoerceNumber(&args[2])
    if y >= 0 && y < 100 { y += 1900 }
    if m < 1 || m > 12 || d < 1 || d > 31 { return ValError(ERR_NUM) }
    serial: int = DaysFromCivil(y,m,d) - SerialEpoch()
    if serial < 61 { serial -= 1 }
    return ValNumber(serial)
}

DatePart :: (args: Val *, count: int, part: int) -> Val {
    serial: int = 0
    days: int = 0
    y: int = 0
    m: int = 0
    d: int = 0
    dow: int = 0
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    serial = (int)CoerceNumber(&args[0])
    days = serial + SerialEpoch()
    CivilFromDays(days,&y,&m,&d)
    if part == 0 { return ValNumber(y) }
    if part == 1 { return ValNumber(m) }
    if part == 2 { return ValNumber(d) }
    dow = ((days % 7) + 4) % 7 + 1
    if dow < 1 { dow += 7 }
    return ValNumber(dow)
}

FnTime :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    total: double = 0
    if count < 3 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
    if args[2].kind == VAL_ERROR { return ValError(args[2].err) }
    total = (CoerceNumber(&args[0]) * 3600.0 + CoerceNumber(&args[1]) * 60.0 + CoerceNumber(&args[2])) / 86400.0
    while total >= 1 { total -= 1 }
    while total < 0 { total += 1 }
    return ValNumber(total)
}

TimePart :: (args: Val *, count: int, part: int) -> Val {
    frac: double = 0
    seconds: double = 0
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    frac = CoerceNumber(&args[0])
    while frac >= 1 { frac -= 1 }
    while frac < 0 { frac += 1 }
    seconds = frac * 86400.0
    if part == 0 { return ValNumber((int)(seconds / 3600.0)) }
    if part == 1 { return ValNumber(((int)(seconds / 60.0)) % 60) }
    return ValNumber((int)seconds % 60)
}

ParseIsoDate :: (text: const char *, y: int *, m: int *, d: int *) -> int {
    pos: int = 0
    parts: [3] int = {0,0,0}
    n: int = 0
    while text[pos] != 0 && n < 3 {
        if text[pos] == '-' || text[pos] == '/' {
            pos += 1
            continue
        }
        if !isdigit((unsigned char)text[pos]) { return 0 }
        value: int = 0
        while isdigit((unsigned char)text[pos]) {
            value = value * 10 + (text[pos] - '0')
            pos += 1
        }
        parts[n] = value
        n += 1
    }
    if n != 3 { return 0 }
    if parts[0] > 31 {
        y[0] = parts[0]
        m[0] = parts[1]
        d[0] = parts[2]
    }
else {
        y[0] = parts[2]
        m[0] = parts[0]
        d[0] = parts[1]
    }
    return 1
}

FnDateValue :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    text: [WB_TEXT_MAX] char = ""
    y: int = 0
    m: int = 0
    d: int = 0
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    if ParseIsoDate(text,&y,&m,&d) { return ValNumber(DaysFromCivil(y,m,d) - SerialEpoch()) }
    return ValError(ERR_VALUE)
}

FnToday :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    now: time_t = time(NULL)
    return ValNumber((double)(now / 86400) + 25569.0)
}

FnNow :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    now: time_t = time(NULL)
    return ValNumber((double)now / 86400.0 + 25569.0)
}

FnEdate :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    total: int = 0
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
    serial: int = (int)CoerceNumber(&args[0])
    months: int = (int)CoerceNumber(&args[1])
    days: int = serial + SerialEpoch()
    y: int = 0
    m: int = 0
    d: int = 0
    CivilFromDays(days,&y,&m,&d)
    total = y * 12 + (m - 1) + months
    y = total / 12
    m = total % 12 + 1
    if d > DaysFromCivil(y,m + 1,1) - DaysFromCivil(y,m,1) {
        d = DaysFromCivil(y,m + 1,1) - DaysFromCivil(y,m,1)
    }
    return ValNumber(DaysFromCivil(y,m,d) - SerialEpoch())
}

FnEomonth :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    total: int = 0
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    serial: int = (int)CoerceNumber(&args[0])
    months: int = 0
    if count >= 2 {
        if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
        months = (int)CoerceNumber(&args[1])
    }
    days: int = serial + SerialEpoch()
    y: int = 0
    m: int = 0
    d: int = 0
    CivilFromDays(days,&y,&m,&d)
    total = y * 12 + (m - 1) + months
    y = total / 12
    m = total % 12 + 1
    return ValNumber(DaysFromCivil(y,m + 1,1) - 1 - SerialEpoch())
}

FnDatedif :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    unit: [16] char = ""
    if count < 3 { return ValError(ERR_VALUE) }
    if TextArg(args,count,2,unit,sizeof(unit)) < 0 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
    a: int = (int)CoerceNumber(&args[0])
    b: int = (int)CoerceNumber(&args[1])
    if b < a { return ValError(ERR_NUM) }
    da: int = a + SerialEpoch()
    db: int = b + SerialEpoch()
    ya: int = 0
    ma: int = 0
    dla: int = 0
    yb: int = 0
    mb: int = 0
    dlb: int = 0
    CivilFromDays(da,&ya,&ma,&dla)
    CivilFromDays(db,&yb,&mb,&dlb)
    if strcasecmp(unit,"d") == 0 { return ValNumber(b - a) }
    if strcasecmp(unit,"y") == 0 {
        years: int = yb - ya
        if mb < ma || (mb == ma && dlb < dla) { years -= 1 }
        return ValNumber(years)
    }
    if strcasecmp(unit,"m") == 0 {
        months: int = (yb - ya) * 12 + (mb - ma)
        if dlb < dla { months -= 1 }
        return ValNumber(months)
    }
    if strcasecmp(unit,"ym") == 0 {
        months: int = mb - ma
        if dlb < dla { months -= 1 }
        if months < 0 { months += 12 }
        return ValNumber(months)
    }
    if strcasecmp(unit,"md") == 0 {
        if dlb >= dla { return ValNumber(dlb - dla) }
        pm: int = mb - 1
        py: int = yb
        dim: int = 0
        if pm == 0 { pm = 12; py -= 1 }
        dim = DaysFromCivil(py,pm + 1,1) - DaysFromCivil(py,pm,1)
        return ValNumber(dlb + dim - dla)
    }
    return ValError(ERR_VALUE)
}

FnDays360 :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
    a: int = (int)CoerceNumber(&args[0])
    b: int = (int)CoerceNumber(&args[1])
    european: int = 0
    ya: int = 0
    ma: int = 0
    da: int = 0
    yb: int = 0
    mb: int = 0
    db: int = 0
    if count >= 3 {
        if args[2].kind == VAL_ERROR { return ValError(args[2].err) }
        if args[2].kind == VAL_STRING {
            method: [16] char = ""
            CoerceText(&args[2],method,sizeof(method))
            european = strcasecmp(method,"TRUE") == 0
        }
else {
            european = CoerceNumber(&args[2]) != 0
        }
    }
    CivilFromDays(a + SerialEpoch(),&ya,&ma,&da)
    CivilFromDays(b + SerialEpoch(),&yb,&mb,&db)
    if (european) {
        if da == 31 { da = 30 }
        if db == 31 { db = 30 }
    }
else {
        last_feb_a: int = ma == 2 && da == DaysFromCivil(ya,3,1) - DaysFromCivil(ya,2,1)
        if (last_feb_a) {
            da = 30
        }
else if da >= 30 {
            da = 30
        }
        if db >= 30 && da == 30 { db = 30 }
    }
    return ValNumber((yb - ya) * 360 + (mb - ma) * 30 + (db - da))
}

FnRound :: (st: EvalState *, args: Val *, count: int, marks: int *, mode: int) -> Val {
    digits: double = 0
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if count >= 2 {
        if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
        digits = CoerceNumber(&args[1])
    }
    v: double = CoerceNumber(&args[0])
    if v >= 1e307 { return ValError(ERR_VALUE) }
    scale: double = pow(10.0,digits)
    scaled: double = v * scale
    r: double = 0
    if mode == 0 {
        if scaled >= 0 { r = floor(scaled + 0.5) }
        else { r = ceil(scaled - 0.5) }
    }
else if mode == 1 {
        if scaled >= 0 { r = floor(scaled) }
        else { r = ceil(scaled) }
    }
else {
        if scaled >= 0 { r = ceil(scaled) }
        else { r = floor(scaled) }
    }
    return ValNumber(r / scale)
}

FnInt :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    v: double = CoerceNumber(&args[0])
    if v >= 1e307 { return ValError(ERR_VALUE) }
    return ValNumber(floor(v))
}

FnMod :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
    a: double = CoerceNumber(&args[0])
    b: double = CoerceNumber(&args[1])
    if b == 0 { return ValError(ERR_DIV0) }
    return ValNumber(a - b * floor(a / b))
}

FnAbs :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    v: double = CoerceNumber(&args[0])
    if v >= 1e307 { return ValError(ERR_VALUE) }
    return ValNumber(fabs(v))
}

FnSign :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    v: double = CoerceNumber(&args[0])
    if v >= 1e307 { return ValError(ERR_VALUE) }
    if v > 0 { return ValNumber(1) }
    if v < 0 { return ValNumber(-1) }
    return ValNumber(0)
}

DomainOk :: (code: int, v: double) -> int {
    if code == 0 && v < 0 { return 0 }
    if (code == 2 || code == 3 || code == 13) && v <= 0 { return 0 }
    if (code == 7 || code == 8) && (v < -1 || v > 1) { return 0 }
    return 1
}

ApplyMathOne :: (code: int, v: double) -> double {
    if code == 0 { return sqrt(v) }
    if code == 1 { return exp(v) }
    if code == 2 { return log(v) }
    if code == 3 { return log10(v) }
    if code == 4 { return sin(v) }
    if code == 5 { return cos(v) }
    if code == 6 { return tan(v) }
    if code == 7 { return asin(v) }
    if code == 8 { return acos(v) }
    if code == 9 { return atan(v) }
    if code == 10 { return floor(v) }
    if code == 11 { return ceil(v) }
    if code == 12 { return expm1(v) }
    if code == 13 { return log1p(v) }
    if code == 14 { return sinh(v) }
    if code == 15 { return cosh(v) }
    if code == 16 { return tanh(v) }
    return 0
}

FnMathOne :: (st: EvalState *, args: Val *, count: int, marks: int *, code: int) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    v: double = CoerceNumber(&args[0])
    if v >= 1e307 { return ValError(ERR_VALUE) }
    if !DomainOk(code,v) { return ValError(ERR_NUM) }
    r: double = ApplyMathOne(code,v)
    if r != r { return ValError(ERR_NUM) }
    return ValNumber(r)
}

FnPower :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
    a: double = CoerceNumber(&args[0])
    b: double = CoerceNumber(&args[1])
    if a >= 1e307 || b >= 1e307 { return ValError(ERR_VALUE) }
    r: double = pow(a,b)
    if r != r { return ValError(ERR_NUM) }
    return ValNumber(r)
}

FnAtan2 :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
    y: double = CoerceNumber(&args[0])
    x: double = CoerceNumber(&args[1])
    if x == 0 && y == 0 { return ValError(ERR_DIV0) }
    return ValNumber(atan2(y,x))
}

FnFact :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    n: double = CoerceNumber(&args[0])
    if n < 0 || n != (double)(long long)n || n > 170 { return ValError(ERR_NUM) }
    r: double = 1
    i: int = 2
    while i <= (int)n {
        r *= i
        i += 1
    }
    return ValNumber(r)
}

FnFactDouble :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    n: int = (int)CoerceNumber(&args[0])
    if n < -1 || n > 300 { return ValError(ERR_NUM) }
    if n <= 1 { return ValNumber(1) }
    r: double = 1
    i: int = n
    while i >= 2 {
        r *= i
        i -= 2
    }
    return ValNumber(r)
}

GcdImpl :: (a: int, b: int) -> int {
    while b != 0 {
        t: int = a % b
        a = b
        b = t
    }
    return a < 0 ? -a : a
}

FnGcd :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    if list.count == 0 { return ValError(ERR_VALUE) }
    g: int = (int)list.data[0]
    i: int = 1
    while i < list.count {
        g = GcdImpl(g,(int)list.data[i])
        i += 1
    }
    return ValNumber(g)
}

FnLcm :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    if list.count == 0 { return ValError(ERR_VALUE) }
    l: int = (int)list.data[0]
    i: int = 1
    while i < list.count {
        g: int = GcdImpl(l,(int)list.data[i])
        if g == 0 { return ValError(ERR_NUM) }
        l = l / g * (int)list.data[i]
        i += 1
    }
    return ValNumber(l < 0 ? -l : l)
}

FnCombin :: (st: EvalState *, args: Val *, count: int, marks: int *, with_repeats: int) -> Val {
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
    n: int = (int)CoerceNumber(&args[0])
    k: int = (int)CoerceNumber(&args[1])
    r: double = 1
    i: int = 0
    if n < 0 || k < 0 { return ValError(ERR_NUM) }
    if (with_repeats) {
        if k > n { return ValError(ERR_NUM) }
        i = 0
        while i < k {
            r = r * (n + k - 1 - i) / (i + 1)
            i += 1
        }
        return ValNumber(r)
    }
    if k > n { return ValError(ERR_NUM) }
    i = 0
    while i < k {
        r = r * (n - i) / (i + 1)
        i += 1
    }
    return ValNumber(r)
}

FnDegreesRadians :: (st: EvalState *, args: Val *, count: int, marks: int *, to_deg: int) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    v: double = CoerceNumber(&args[0])
    if v >= 1e307 { return ValError(ERR_VALUE) }
    if (to_deg) { return ValNumber(v * 180.0 / 3.14159265358979323846) }
    return ValNumber(v * 3.14159265358979323846 / 180.0)
}

FnChoose :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    n: int = (int)CoerceNumber(&args[0])
    if n < 1 || n >= count { return ValError(ERR_VALUE) }
    return ValCopy(&args[n])
}

CriterionMatch :: (criterion: Val *, v: Val *) -> int {
    op: int = 0
    cmp: Val = {0}
    c: int = 0
    if criterion->kind == VAL_ERROR { return -1 }
    if v->kind == VAL_RANGE { return 0 }
    if criterion->kind == VAL_STRING {
        spec: CString = criterion->text
        if spec[0] == '>' && spec[1] == '=' { op = 4; spec += 2 }
        else if spec[0] == '<' && spec[1] == '=' { op = 5; spec += 2 }
        else if spec[0] == '<' && spec[1] == '>' { op = 2; spec += 2 }
        else if spec[0] == '>' { op = 6; spec += 1 }
        else if spec[0] == '<' { op = 3; spec += 1 }
        else if spec[0] == '=' { op = 1; spec += 1 }
        if TextLooksNumeric(spec) {
            cmp = ValNumber(strtod(spec,NULL))
        }
else {
            cmp = ValString(spec)
        }
    }
else {
        cmp = criterion[0]
    }
    if cmp.kind == VAL_STRING && v->kind == VAL_STRING {
        raw: int = strcasecmp(v->text,cmp.text)
        c = raw < 0 ? -1 : (raw > 0 ? 1 : 0)
    }
else if cmp.kind == VAL_STRING {
        if v->kind == VAL_EMPTY && cmp.text[0] == 0 {
            c = 0
        }
else {
            c = 1
        }
    }
else {
        c = CompareVals(v,&cmp)
        if c == -2 { return 0 }
    }
    if op == 0 || op == 1 { return c == 0 }
    if op == 2 { return c != 0 }
    if op == 3 { return c < 0 }
    if op == 4 { return c >= 0 }
    if op == 5 { return c <= 0 }
    return c > 0
}

ReduceHalfPos :: (x_in: double, pk: int *) -> double {
    x: double = x_in
    k: int = 0
    x = fmod(x,2)
    if x >= 1 {
        x -= 1
        k += 2
    }
    if x >= 0.5 {
        x -= 0.5
        k += 1
    }
    if x > 0.25 {
        x -= 0.5
        k += 1
    }
    pk[0] = k & 3
    return x
}

GoSinpi :: (x_in: double) -> double {
    x: double = x_in
    x0: double = x_in
    k: int = 0
    y: double = 0
    if x < 0 {
        k2: int = 0
        x = 0 - ReduceHalfPos(0 - x,&k2)
        k = 4 - k2
        if x == -0.25 {
            x += 0.5
            k += 3
        }
    }
else {
        x = ReduceHalfPos(x,&k)
    }
    if (x == 0 && (k & 1) == 0) { return copysign(0,x0) }
    if x == 0 {
        y = (k & 1) != 0 ? 1 : 0
    }
else if x == 0.25 {
        y = 0.707106781186547524400844362104849039284835937688474036588339
    }
else {
        if (k & 1) != 0 {
            y = cos(3.141592653589793 * x)
        }
else {
            y = sin(3.141592653589793 * x)
        }
    }
    if (k & 2) != 0 { return 0 - y }
    return y
}

BesselICore :: (x: double, nu: double, nb: int, bi: double *) -> int {
    nend: int = 0
    intx: int = 0
    nbmx: int = 0
    k: int = 0
    l: int = 0
    n: int = 0
    nstart: int = 0
    pold: double = 0
    test: double = 0
    p: double = 0
    em: double = 0
    en: double = 0
    empal: double = 0
    emp2al: double = 0
    halfx: double = 0
    aa: double = 0
    bb: double = 0
    cc: double = 0
    psave: double = 0
    plast: double = 0
    tover: double = 0
    psavel: double = 0
    sum: double = 0
    twonu: double = nu + nu
    const_: double = 1.585
    goto120: int = 0
    goto220: int = 0
    goto230: int = 0
    overflow_hit: int = 0
    if (nb > 0 && x >= 0 && nu >= 0 && nu < 1) {
        if x > 709 {
            k = 1
            while k <= nb {
                bi[k] = 1e308 * 10
                k += 1
            }
            return 1
        }
        intx = (int)x
        if x >= 1e-4 {
            nbmx = nb - intx
            n = intx + 1
            en = (double)(n + n) + twonu
            plast = 1
            p = en / x
            test = 1e16 + 1e16
            if (intx * 2 > 16 * 5) {
                test = sqrt(test * p)
            }
else {
                test /= pow(const_,(double)intx)
            }
            if nbmx >= 3 {
                tover = 1e308 / 1e16
                nstart = intx + 2
                nend = nb - 1
                k = nstart
                while k <= nend {
                    n = k
                    en += 2
                    pold = plast
                    plast = p
                    p = en * plast / x + pold
                    if p > tover {
                        overflow_hit = 1
                        tover = 1e308
                        p /= tover
                        plast /= tover
                        psave = p
                        psavel = plast
                        nstart = n + 1
                        while 1 {
                            n += 1
                            en += 2
                            pold = plast
                            plast = p
                            p = en * plast / x + pold
                            if p > 1 { break }
                        }
                        bb = en / x
                        test = pold * plast / 1e16
                        test *= 0.5 - 0.5 / (bb * bb)
                        p = plast * tover
                        n -= 1
                        en -= 2
                        nend = nb < n ? nb : n
                        l = nstart
                        while l <= nend {
                            pold = psavel
                            psavel = psave
                            psave = en * psavel / x + pold
                            if (psave * psavel > test) { break }
                            l += 1
                        }
                        goto120 = 1
                    }
                    if overflow_hit != 0 { break }
                    k += 1
                }
                if goto120 == 0 {
                    n = nend
                    en = (double)(n + n) + twonu
                    test = (test > sqrt(plast * 1e16) * sqrt(p + p) ? test : sqrt(plast * 1e16) * sqrt(p + p))
                }
            }
            if goto120 == 0 {
                while 1 {
                    n += 1
                    en += 2
                    pold = plast
                    plast = p
                    p = en * plast / x + pold
                    if p >= test { break }
                }
            }
            n += 1
            en += 2
            bb = 0
            aa = 1 / p
            em = (double)n - 1
            empal = em + nu
            emp2al = em - 1 + twonu
            sum = aa * empal * emp2al / em
            nend = n - nb
            if nend < 0 {
                bi[n] = aa
                nend = -nend
                l = 1
                while l <= nend {
                    bi[n + l] = 0
                    l += 1
                }
            }
else {
                if nend > 0 {
                    l = 1
                    while l <= nend {
                        n -= 1
                        en -= 2
                        cc = bb
                        bb = aa
                        if (nend > 100 && aa > 1e200) {
                            cc = ldexp(cc,-900)
                            bb = ldexp(bb,-900)
                            sum = ldexp(sum,-900)
                        }
                        aa = en * bb / x + cc
                        em -= 1
                        emp2al -= 1
                        if n == 1 { break }
                        if n == 2 { emp2al = 1 }
                        empal -= 1
                        sum = (sum + aa * empal) * emp2al / em
                        l += 1
                    }
                }
                bi[n] = aa
                if nb <= 1 {
                    sum = sum + sum + aa
                    goto230 = 1
                }
                if goto230 == 0 {
                    n -= 1
                    en -= 2
                    bi[n] = en * aa / x + bb
                    if n == 1 {
                        goto220 = 1
                    }
else {
                        em -= 1
                        if n == 2 {
                            emp2al = 1
                        }
else {
                            emp2al -= 1
                        }
                        empal -= 1
                        sum = (sum + bi[n] * empal) * emp2al / em
                    }
                }
            }
            if goto220 == 0 && goto230 == 0 {
                nend = n - 2
                if nend > 0 {
                    l = 1
                    while l <= nend {
                        n -= 1
                        en -= 2
                        bi[n] = en * bi[n + 1] / x + bi[n + 2]
                        em -= 1
                        if n == 2 {
                            emp2al = 1
                        }
else {
                            emp2al -= 1
                        }
                        empal -= 1
                        sum = (sum + bi[n] * empal) * emp2al / em
                        l += 1
                    }
                }
                bi[1] = 2 * empal * bi[2] / x + bi[3]
                sum = sum + sum + bi[1]
            }
            if goto220 != 0 {
                sum = sum + sum + bi[1]
            }
            if nu != 0 {
                sum *= tgamma(1 + nu) * pow(x * 0.5,-nu)
            }
            sum *= exp(-x)
            aa = 8.9e-308
            if sum > 1 { aa *= sum }
            n = 1
            while n <= nb {
                if bi[n] < aa {
                    bi[n] = 0
                }
else {
                    bi[n] /= sum
                }
                n += 1
            }
            return 0
        }
else {
            aa = 1
            empal = 1 + nu
            halfx = 0.5 * x
            if nu != 0 {
                aa = pow(halfx,nu) / tgamma(empal)
            }
            bb = halfx * halfx
            bi[1] = aa + aa * bb / empal
            if nb > 1 {
                if x == 0 {
                    n = 2
                    while n <= nb {
                        bi[n] = 0
                        n += 1
                    }
                }
else {
                    cc = halfx
                    tover = (8.9e-308 + 8.9e-308) / x
                    if bb != 0 { tover = 8.9e-308 / bb }
                    n = 2
                    while n <= nb {
                        aa /= empal
                        empal += 1
                        aa *= cc
                        if (aa <= tover * empal) {
                            bi[n] = 0
                            aa = 0
                        }
else {
                            bi[n] = aa + aa * bb / empal
                        }
                        n += 1
                    }
                }
            }
            return 0
        }
    }
    return 1
}

BesselI :: (x: double, alpha_in: double) -> double {
    alpha: double = alpha_in
    na: double = 0
    nb: int = 0
    bi: [64] double = {0}
    ncalc: int = 0
    if (x != x || alpha != alpha) { return x + alpha }
    if x < 0 { return 0.0 / 0.0 }
    na = floor(alpha)
    if alpha < 0 {
        if alpha == na { return BesselI(x,-alpha) }
        return BesselI(x,-alpha) + BesselK(x,-alpha) * 2 / 3.141592653589793 * GoSinpi(-alpha)
    }
    nb = 1 + (int)na
    if nb > 60 { nb = 60 }
    alpha -= (double)(nb - 1)
    ncalc = BesselICore(x,alpha,nb,bi)
    return bi[nb]
}

BesselKCore :: (x: double, nu_in: double, nb: int, bk: double *) -> int {
    nu: double = nu_in
    ex: double = x
    iend: int = 0
    i: int = 0
    j: int = 0
    k: int = 0
    m: int = 0
    ii: int = 0
    mplus1: int = 0
    x2by4: double = 0
    twox: double = 0
    c: double = 0
    blpha: double = 0
    ratio: double = 0
    wminf: double = 0
    d1: double = 0
    d2: double = 0
    d3: double = 0
    f0: double = 0
    f1: double = 0
    f2: double = 0
    p0: double = 0
    q0: double = 0
    t1: double = 0
    t2: double = 0
    twonu: double = 0
    dm: double = 0
    bk1: double = 0
    bk2: double = 0
    ncalc_v: int = 1
    a_const: double = 0.11593151565841244881
    p1: [8] double = {0.805629875690432845,20.4045500205365151,157.705605106676174,536.671116469207504,900.382759291288778,730.923886650660393,229.299301509425145,0.822467033424113231}
    q1: [7] double = {29.4601986247850434,277.577868510221208,1206.70325591027438,2762.91444159791519,3443.74050506564618,2210.63190113378647,572.267338359892221}
    r1: [5] double = {-0.48672575865218401848,13.079485869097804016,-101.96490580880537526,347.65409106507813131,3.495898124521934782e-4}
    s1: [4] double = {-25.579105509976461286,212.57260432226544008,-610.69018684944109624,422.69668805777760407}
    t1arr: [6] double = {1.6125990452916363814e-10,2.5051878502858255354e-8,2.7557319615147964774e-6,1.9841269840928373686e-4,0.0083333333333334751799,0.16666666666666666446}
    estm: [6] double = {52.0583,5.7607,2.7782,14.4303,185.3004,9.3715}
    estf: [7] double = {41.8341,7.1075,6.4306,42.511,1.35633,84.5096,20}
    sqrt2dpi: double = 0.797884560802865355879892119869
    twonu = nu + nu
    if (nb > 0 && nu >= 0 && nu < 1) {
        if (ex <= 0 || ex > 705.342) {
            i = 0
            while i < nb {
                if ex <= 0 {
                    bk[i] = 1e308 * 10
                }
else {
                    bk[i] = 0
                }
                i += 1
            }
            return 0
        }
        k = 0
        if (nu < 1.49e-154) {
            nu = 0
        }
else if nu > 0.5 {
            k = 1
            nu -= 1
        }
        twonu = nu + nu
        iend = nb + k - 1
        c = nu * nu
        d3 = -c
        if ex <= 1 {
            d1 = 0
            d2 = p1[0]
            t1 = 1
            t2 = q1[0]
            i = 2
            while i <= 7 {
                d1 = c * d1 + p1[i - 1]
                d2 = c * d2 + p1[i]
                t1 = c * t1 + q1[i - 1]
                t2 = c * t2 + q1[i]
                i += 2
            }
            d1 = nu * d1
            t1 = nu * t1
            f1 = log(ex)
            f0 = a_const + nu * (p1[7] - nu * (d1 + d2) / (t1 + t2)) - f1
            q0 = exp(-nu * (a_const - nu * (p1[7] + nu * (d1 - d2) / (t1 - t2)) - f1))
            f1 = nu * f0
            p0 = exp(f1)
            d1 = r1[4]
            t1 = 1
            i = 0
            while i < 4 {
                d1 = c * d1 + r1[i]
                t1 = c * t1 + s1[i]
                i += 1
            }
            if (fabs(f1) <= 0.5) {
                f1 *= f1
                d2 = 0
                i = 0
                while i < 6 {
                    d2 = f1 * d2 + t1arr[i]
                    i += 1
                }
                d2 = f0 + f0 * f1 * d2
            }
else {
                d2 = sinh(f1) / nu
            }
            f0 = d2 - nu * d1 / (t1 * p0)
            if ex <= 1e-10 {
                bk[0] = f0 + ex * f0
                bk[0] -= ex * bk[0]
                ratio = p0 / f0
                c = ex * 1.7976931348623157e308
                if k != 0 {
                    if bk[0] >= c / ratio {
                        return 1
                    }
                    bk[0] = ratio * bk[0] / ex
                    twonu += 2
                    ratio = twonu
                }
                if nb == 1 { return 0 }
                i = 1
                while i < nb {
                    if ratio >= c { return 1 }
                    bk[i] = ratio / ex
                    twonu += 2
                    ratio = twonu
                    i += 1
                }
                i = 1
                while i < nb {
                    bk[i] *= bk[i - 1]
                    i += 1
                }
                return 0
            }
else {
                c = 1
                x2by4 = ex * ex / 4
                p0 = 0.5 * p0
                q0 = 0.5 * q0
                d1 = -1
                d2 = 0
                bk1 = 0
                bk2 = 0
                f1 = f0
                f2 = p0
                while 1 {
                    d1 += 2
                    d2 += 1
                    d3 = d1 + d3
                    c = x2by4 * c / d2
                    f0 = (d2 * f0 + p0 + q0) / d3
                    p0 /= d2 - nu
                    q0 /= d2 + nu
                    t1 = c * f0
                    t2 = c * (p0 - d2 * f0)
                    bk1 += t1
                    bk2 += t2
                    if (fabs(t1 / (f1 + bk1)) <= 2.2204460492503131e-16 && fabs(t2 / (f2 + bk2)) <= 2.2204460492503131e-16) { break }
                }
                bk1 = f1 + bk1
                bk2 = 2 * (f2 + bk2) / ex
                wminf = estf[0] * ex + estf[1]
            }
        }
else if (2.2204460492503131e-16 * ex > 1) {
            i = 0
            while i < nb {
                bk[i] = 1 / (sqrt2dpi * sqrt(ex))
                i += 1
            }
            return 0
        }
else {
            twox = ex + ex
            blpha = 0
            ratio = 0
            if ex <= 4 {
                d2 = trunc(estm[0] / ex + estm[1])
                m = (int)d2
                d1 = d2 + d2
                d2 -= 0.5
                d2 *= d2
                i = 2
                while i <= m {
                    d1 -= 2
                    d2 -= d1
                    ratio = (d3 + d2) / (twox + d1 - ratio)
                    i += 1
                }
                d2 = trunc(estm[2] * ex + estm[3])
                m = (int)d2
                c = fabs(nu)
                d3 = c + c
                d1 = d3 - 1
                f1 = 2.2250738585072014e-308
                f0 = (2 * (c + d2) / ex + 0.5 * ex / (c + d2 + 1)) * 2.2250738585072014e-308
                i = 3
                while i <= m {
                    d2 -= 1
                    f2 = (d3 + d2 + d2) * f0
                    blpha = (1 + d1 / d2) * (f2 + blpha)
                    f2 = f2 / ex + f1
                    f1 = f0
                    f0 = f2
                    i += 1
                }
                f1 = (d3 + 2) * f0 / ex + f1
                d1 = 0
                t1 = 1
                i = 1
                while i <= 7 {
                    d1 = c * d1 + p1[i - 1]
                    t1 = c * t1 + q1[i - 1]
                    i += 1
                }
                p0 = exp(c * (a_const + c * (p1[7] - c * d1 / t1) - log(ex))) / ex
                f2 = (c + 0.5 - ratio) * f1 / ex
                bk1 = p0 + (d3 * f0 - f2 + f0 + blpha) / (f2 + f1 + f0) * p0
                bk1 *= exp(-ex)
                wminf = estf[2] * ex + estf[3]
            }
else {
                dm = trunc(estm[4] / ex + estm[5])
                m = (int)dm
                d2 = dm - 0.5
                d2 *= d2
                d1 = dm + dm
                i = 2
                while i <= m {
                    dm -= 1
                    d1 -= 2
                    d2 -= d1
                    ratio = (d3 + d2) / (twox + d1 - ratio)
                    blpha = (ratio + ratio * blpha) / dm
                    i += 1
                }
                bk1 = 1 / ((sqrt2dpi + sqrt2dpi * blpha) * sqrt(ex))
                bk1 *= exp(-ex)
                wminf = estf[4] * (ex - fabs(ex - estf[6])) + estf[5]
            }
            bk2 = bk1 + bk1 * (nu + 0.5 - ratio) / ex
        }
        bk[0] = bk1
        if iend == 0 { return 0 }
        j = 1 - k
        if j >= 0 { bk[j] = bk2 }
        if iend == 1 { return 0 }
        m = (int)(wminf - nu)
        if m > iend { m = iend }
        i = 2
        ii = 0
        while i <= m {
            t1 = bk1
            bk1 = bk2
            twonu += 2
            if ex < 1 {
                if (bk1 >= 1.7976931348623157e308 / twonu * ex) { break }
            }
else {
                if (bk1 / ex >= 1.7976931348623157e308 / twonu) { break }
            }
            bk2 = twonu / ex * bk1 + t1
            ii = i
            j += 1
            if j >= 0 { bk[j] = bk2 }
            i += 1
        }
        m = ii
        if m == iend { return 0 }
        ratio = bk2 / bk1
        mplus1 = m + 1
        i = mplus1
        while i <= iend {
            twonu += 2
            ratio = twonu / ex + 1 / ratio
            j += 1
            if j >= 1 {
                bk[j] = ratio
            }
else {
                if bk2 >= 1.7976931348623157e308 / ratio { return 1 }
                bk2 *= ratio
            }
            i += 1
        }
        ncalc_v = mplus1 - k
        if ncalc_v < 1 { ncalc_v = 1 }
        if ncalc_v == 1 { bk[0] = bk2 }
        if nb == 1 { return 0 }
        i = ncalc_v
        while i < nb {
            bk[i] *= bk[i - 1]
            i += 1
        }
        return 0
    }
    return 1
}

BesselK :: (x: double, alpha_in: double) -> double {
    alpha: double = alpha_in
    nb: int = 0
    bk: [64] double = {0}
    ncalc: int = 0
    if (x != x || alpha != alpha) { return x + alpha }
    if x < 0 { return 0.0 / 0.0 }
    if alpha < 0 { alpha = -alpha }
    nb = 1 + (int)floor(alpha)
    if nb > 60 { nb = 60 }
    alpha -= (double)(nb - 1)
    ncalc = BesselKCore(x,alpha,nb,bk)
    return bk[nb - 1]
}

FnBesseli :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 2 { return ValError(ERR_VALUE) }
    return ValNumber(BesselI(CoerceNumber(&args[0]),CoerceNumber(&args[1])))
}

FnBesselk :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 2 { return ValError(ERR_VALUE) }
    return ValNumber(BesselK(CoerceNumber(&args[0]),CoerceNumber(&args[1])))
}

FnBesselj :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    x: double = 0
    order: double = 0
    n: int = 0
    if count < 2 { return ValError(ERR_VALUE) }
    x = CoerceNumber(&args[0])
    order = CoerceNumber(&args[1])
    if (order < 0 || order != floor(order) || order > 1000) { return ValError(ERR_NUM) }
    n = (int)order
    if x < 0 {
        if (n % 2) != 0 { return ValNumber(0 - jn(n,-x)) }
        return ValNumber(jn(n,-x))
    }
    return ValNumber(jn(n,x))
}

FnBessely :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    x: double = 0
    order: double = 0
    n: int = 0
    if count < 2 { return ValError(ERR_VALUE) }
    x = CoerceNumber(&args[0])
    order = CoerceNumber(&args[1])
    if (order < 0 || order != floor(order) || order > 1000) { return ValError(ERR_NUM) }
    if x < 0 { return ValError(ERR_NUM) }
    n = (int)order
    return ValNumber(yn(n,x))
}

