        if strcmp(name,"Nmi^3") == 0 { c[0] = 7.7594146898721952e-16; return 1 }
        if strcmp(name,"Pica3") == 0 { c[0] = 112266.00000000001; return 1 }
        if strcmp(name,"Pica^3") == 0 { c[0] = 112266.00000000001; return 1 }
        if strcmp(name,"Picapt3") == 0 { c[0] = 112266.00000000001; return 1 }
        if strcmp(name,"Picapt^3") == 0 { c[0] = 112266.00000000001; return 1 }
        return 0
    }
    if cat == 9 {
        if strcmp(name,"byte") == 0 { c[0] = 1; return 1 }
        if strcmp(name,"bit") == 0 { c[0] = 8; return 1 }
        return 0
    }
    if cat == 10 {
        if strcmp(name,"m/h") == 0 { c[0] = 1; return 1 }
        if strcmp(name,"m/hr") == 0 { c[0] = 1; return 1 }
        if strcmp(name,"admkn") == 0 { c[0] = 0.00053961182483768476; return 1 }
        if strcmp(name,"kn") == 0 { c[0] = 0.00053995680345572358; return 1 }
        if strcmp(name,"m/s") == 0 { c[0] = 0.00027777777777777778; return 1 }
        if strcmp(name,"m/sec") == 0 { c[0] = 0.00027777777777777778; return 1 }
        if strcmp(name,"mph") == 0 { c[0] = 0.00062137119223733403; return 1 }
        return 0
    }
    if cat == 11 {
        if strcmp(name,"m2") == 0 { c[0] = 1; return 1 }
        if strcmp(name,"m^2") == 0 { c[0] = 1; return 1 }
        if strcmp(name,"uk_acre") == 0 { c[0] = 0.00024710538146716532; return 1 }
        if strcmp(name,"us_acre") == 0 { c[0] = 0.0002471043930466279; return 1 }
        if strcmp(name,"ang2") == 0 { c[0] = 1e+20; return 1 }
        if strcmp(name,"ang^2") == 0 { c[0] = 1e+20; return 1 }
        if strcmp(name,"ar") == 0 { c[0] = 0.01; return 1 }
        if strcmp(name,"ha") == 0 { c[0] = 0.0001; return 1 }
        if strcmp(name,"in2") == 0 { c[0] = 1550.0031000062002; return 1 }
        if strcmp(name,"in^2") == 0 { c[0] = 1550.0031000062002; return 1 }
        if strcmp(name,"ft2") == 0 { c[0] = 10.763910416709724; return 1 }
        if strcmp(name,"ft^2") == 0 { c[0] = 10.763910416709724; return 1 }
        if strcmp(name,"ly2") == 0 { c[0] = 1.1172507631287325e-32; return 1 }
        if strcmp(name,"ly^2") == 0 { c[0] = 1.1172507631287325e-32; return 1 }
        if strcmp(name,"mi2") == 0 { c[0] = 3.8610215854244592e-07; return 1 }
        if strcmp(name,"mi^2") == 0 { c[0] = 3.8610215854244592e-07; return 1 }
        if strcmp(name,"Nmi2") == 0 { c[0] = 2.915533495981229e-07; return 1 }
        if strcmp(name,"Nmi^2") == 0 { c[0] = 2.915533495981229e-07; return 1 }
        if strcmp(name,"yd2") == 0 { c[0] = 1.1959900463010804; return 1 }
        if strcmp(name,"yd^2") == 0 { c[0] = 1.1959900463010804; return 1 }
        if strcmp(name,"Picapt2") == 0 { c[0] = 8035216.0704321424; return 1 }
        if strcmp(name,"Picapt^2") == 0 { c[0] = 8035216.0704321424; return 1 }
        if strcmp(name,"Pica2") == 0 { c[0] = 8035216.0704321424; return 1 }
        if strcmp(name,"Pica^2") == 0 { c[0] = 8035216.0704321424; return 1 }
        if strcmp(name,"Morgen") == 0 { c[0] = 0.00040000000000000002; return 1 }
        return 0
    }
    return 0
}

ConvPrefix :: (binp: int, name: const char *, prefix: double *, plen: int *) -> int {
    if binp != 0 {
        if strncmp(name,"Yi",2) == 0 { prefix[0] = 1.2089258196146292e+24; plen[0] = 2; return 1 }
        if strncmp(name,"Zi",2) == 0 { prefix[0] = 1.1805916207174113e+21; plen[0] = 2; return 1 }
        if strncmp(name,"Ei",2) == 0 { prefix[0] = 1.152921504606847e+18; plen[0] = 2; return 1 }
        if strncmp(name,"Pi",2) == 0 { prefix[0] = 1125899906842624; plen[0] = 2; return 1 }
        if strncmp(name,"Ti",2) == 0 { prefix[0] = 1099511627776; plen[0] = 2; return 1 }
        if strncmp(name,"Gi",2) == 0 { prefix[0] = 1073741824; plen[0] = 2; return 1 }
        if strncmp(name,"Mi",2) == 0 { prefix[0] = 1048576; plen[0] = 2; return 1 }
        if strncmp(name,"ki",2) == 0 { prefix[0] = 1024; plen[0] = 2; return 1 }
        return 0
    }
    if strncmp(name,"Y",1) == 0 { prefix[0] = 9.9999999999999998e+23; plen[0] = 1; return 1 }
    if strncmp(name,"Z",1) == 0 { prefix[0] = 1e+21; plen[0] = 1; return 1 }
    if strncmp(name,"E",1) == 0 { prefix[0] = 1e+18; plen[0] = 1; return 1 }
    if strncmp(name,"P",1) == 0 { prefix[0] = 1000000000000000; plen[0] = 1; return 1 }
    if strncmp(name,"T",1) == 0 { prefix[0] = 1000000000000; plen[0] = 1; return 1 }
    if strncmp(name,"G",1) == 0 { prefix[0] = 1000000000; plen[0] = 1; return 1 }
    if strncmp(name,"M",1) == 0 { prefix[0] = 1000000; plen[0] = 1; return 1 }
    if strncmp(name,"k",1) == 0 { prefix[0] = 1000; plen[0] = 1; return 1 }
    if strncmp(name,"h",1) == 0 { prefix[0] = 100; plen[0] = 1; return 1 }
    if strncmp(name,"e",1) == 0 { prefix[0] = 10; plen[0] = 1; return 1 }
    if strncmp(name,"d",1) == 0 { prefix[0] = 0.10000000000000001; plen[0] = 1; return 1 }
    if strncmp(name,"c",1) == 0 { prefix[0] = 0.01; plen[0] = 1; return 1 }
    if strncmp(name,"m",1) == 0 { prefix[0] = 0.001; plen[0] = 1; return 1 }
    if strncmp(name,"u",1) == 0 { prefix[0] = 9.9999999999999995e-07; plen[0] = 1; return 1 }
    if strncmp(name,"n",1) == 0 { prefix[0] = 1.0000000000000001e-09; plen[0] = 1; return 1 }
    if strncmp(name,"p",1) == 0 { prefix[0] = 9.9999999999999998e-13; plen[0] = 1; return 1 }
    if strncmp(name,"f",1) == 0 { prefix[0] = 1.0000000000000001e-15; plen[0] = 1; return 1 }
    if strncmp(name,"a",1) == 0 { prefix[0] = 1.0000000000000001e-18; plen[0] = 1; return 1 }
    if strncmp(name,"z",1) == 0 { prefix[0] = 9.9999999999999991e-22; plen[0] = 1; return 1 }
    if strncmp(name,"y",1) == 0 { prefix[0] = 9.9999999999999992e-25; plen[0] = 1; return 1 }
    return 0
}

ConvGetConstant :: (cat: int, binp: int, use_prefixes: int, name: const char *, c: double *, prefix: double *) -> int {
    plen: int = 0
    prefix[0] = 1
    if ConvUnit(cat,name,c) != 0 { return 1 }
    if use_prefixes != 0 {
        if ConvPrefix(binp,name,prefix,&plen) != 0 {
            return ConvUnit(cat,name + plen,c)
        }
    }
    return 0
}

ConvertOne :: (cat: int, binp: int, use_prefixes: int, from_unit: const char *, to_unit: const char *, n: double, handled: int *, result: double *) -> int {
    from_c: double = 0
    from_prefix: double = 1
    to_c: double = 0
    to_prefix: double = 1
    if ConvGetConstant(cat,binp,use_prefixes,from_unit,&from_c,&from_prefix) != 0 {
        handled[0] = 1
        if ConvGetConstant(cat,binp,use_prefixes,to_unit,&to_c,&to_prefix) == 0 {
            return 0
        }
        if (from_c == 0 || to_prefix == 0) { return 0 }
        result[0] = ((n * from_prefix) / from_c) * to_c / to_prefix
        return 1
    }
    handled[0] = 0
    return 0
}

ConvTempUnit :: (unit: const char *) -> int {
    if strcmp(unit,"K") == 0 { return 1 }
    if strcmp(unit,"C") == 0 { return 2 }
    if strcmp(unit,"F") == 0 { return 3 }
    if strcmp(unit,"Reau") == 0 { return 5 }
    if strcmp(unit,"Rank") == 0 { return 4 }
    return 0
}

ConvertTemp :: (from_unit: const char *, to_unit: const char *, n_in: double, handled: int *, result: double *) -> int {
    n: double = n_in
    nO: double = n_in
    ck: double = 273.15
    ft: int = ConvTempUnit(from_unit)
    tt: int = ConvTempUnit(to_unit)
    if (ft == 0 || tt == 0) {
        handled[0] = 0
        return 0
    }
    handled[0] = 1
    if ft == 2 {
        n += ck
    }
    if ft == 3 {
        n = (n - 32) * 5 / 9 + ck
    }
    if ft == 4 {
        n = n * 5 / 9
    }
    if ft == 5 {
        n = n * 5 / 4 + ck
    }
    if n < 0 { return 0 }
    if ft == tt {
        result[0] = nO
        return 1
    }
    if tt == 2 {
        n -= ck
    }
    if tt == 3 {
        n = (n - ck) * 9 / 5 + 32
    }
    if tt == 4 {
        n = n * 9 / 5
    }
    if tt == 5 {
        n = (n - ck) * 4 / 5
    }
    result[0] = n
    return 1
}

FnConvert :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    n: double = 0
    from_u: [32] char = ""
    to_u: [32] char = ""
    handled: int = 0
    result: double = 0
    ok: int = 0
    if count < 3 { return ValError(ERR_VALUE) }
    n = CoerceNumber(&args[0])
    if TextArg(args,count,1,from_u,sizeof(from_u)) < 0 { return ValError(ERR_VALUE) }
    if TextArg(args,count,2,to_u,sizeof(to_u)) < 0 { return ValError(ERR_VALUE) }
    ok = ConvertTemp(from_u,to_u,n,&handled,&result)
    if handled != 0 {
        if ok == 0 { return ValError(ERR_NUM) }
        return ValNumber(result)
    }
    if ConvertOne(0,0,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(1,0,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(2,0,0,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(3,0,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(4,0,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(5,0,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(6,0,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(7,0,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(8,0,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(9,0,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(9,1,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(10,0,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(11,0,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    return ValError(ERR_NA)
}
V2BGeneral :: (v: Val *, out: double *) -> int {
    txt: const char * = ""
    if v->kind != VAL_STRING { return 0 }
    txt = v->text
    if DbParseNumber(txt,out) == 0 { return 0 }
    return 1
}

V2BIsAlnum :: (c: int) -> int {
    if (c >= 48 && c <= 57) { return 1 }
    if (c >= 65 && c <= 90) { return 1 }
    if (c >= 97 && c <= 122) { return 1 }
    return 0
}

V2BDigitChar :: (d: int) -> int {
    if d < 10 { return 48 + d }
    return 65 + d - 10
}

ValToBase :: (value: Val *, places_v: Val *, src_base: int, dest_base: int, min_value: double, max_value: double, flags: int) -> Val {
    v_float: double = 0
    err: char * = NULL
    txt: const char * = ""
    hsuffix: int = 0
    len: int = 0
    min_d: int = 1
    max_d: int = 10
    places: int = 1
    out: [24] char = ""
    v_u: unsigned long long = 0
    digit: int = 0
    buf: [64] char = ""
    val: double = 0
    fplaces: double = 0
    float_path: int = 0
    did_parse: int = 0
    if value->kind == VAL_BOOL { return ValError(ERR_VALUE) }
    if places_v != NULL && places_v->kind == VAL_BOOL { return ValError(ERR_VALUE) }
    if (flags & 1) != 0 {
        if value->kind == VAL_STRING {
            if V2BGeneral(value,&v_float) == 0 { return ValError(ERR_VALUE) }
            float_path = 1
        }
else if value->kind == VAL_FLOAT {
            v_float = value->number
            float_path = 1
        }
else {
            return ValError(ERR_NUM)
        }
    }
else if value->kind == VAL_STRING {
        txt = value->text
        hsuffix = 0
        if (flags & 8) != 0 && txt[0] == 0 { txt = "0" }
        if V2BIsAlnum(txt[0]) == 0 { return ValError(ERR_NUM) }
        len = (int)strlen(txt)
        if (flags & 4) != 0 && len > 10 { return ValError(ERR_NUM) }
        if (flags & 2) != 0 {
            if (txt[0] == 48 && (txt[1] == 120 || txt[1] == 88)) {
                txt = txt + 2
            }
else if (txt[len - 1] == 104 || txt[len - 1] == 72) {
                hsuffix = 1
            }
        }
        v_float = (double)strtoll(txt,&err,src_base)
        if (err == txt || err[hsuffix] != 0) { return ValError(ERR_NUM) }
        if (v_float < min_value || v_float > max_value) { return ValError(ERR_NUM) }
        did_parse = 1
    }
else if value->kind == VAL_FLOAT {
        v_float = value->number
        float_path = 1
    }
else {
        return ValError(ERR_NUM)
    }
    if float_path != 0 {
        val = trunc(v_float)
        if (val < min_value || val > max_value) { return ValError(ERR_NUM) }
        snprintf(buf,sizeof(buf),"%.0f",val)
        v_float = (double)strtoll(buf,&err,src_base)
        if err[0] != 0 { return ValError(ERR_NUM) }
    }
    if src_base != 10 {
        b10: double = pow((double)src_base,10)
        if v_float >= b10 / 2 { v_float = v_float - b10 }
    }
    if (flags & 16) != 0 { return ValNumber(v_float) }
    if v_float < 0 {
        min_d = 1
        max_d = 10
        v_float += pow((double)dest_base,10)
    }
else {
        if v_float == 0 {
            min_d = 1
            max_d = 1
        }
else {
            min_d = (int)(log(v_float + 0.5) / log((double)dest_base)) + 1
            max_d = min_d
        }
    }
    if places_v != NULL {
        fplaces = CoerceNumber(places_v)
        if (fplaces < (double)min_d || fplaces > 10) { return ValError(ERR_NUM) }
        places = (int)fplaces
        if (v_float >= 0 && places > max_d) { max_d = places }
    }
    v_u = (unsigned long long)(v_float + 0.5)
    digit = max_d - 1
    while digit >= 0 {
        out[digit] = (char)V2BDigitChar((int)(v_u % (unsigned long long)dest_base))
        v_u /= (unsigned long long)dest_base
        digit -= 1
    }
    out[max_d] = 0
    return ValString(wb_strdup(out))
}

FnBase :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    base_v: double = 0
    max_v: double = 1 / 2.2204460492503131e-16
    if count < 2 { return ValError(ERR_VALUE) }
    base_v = CoerceNumber(&args[1])
    if (base_v < 2 || base_v >= 37) { return ValError(ERR_NUM) }
    return ValToBase(&args[0],count >= 3 ? &args[2] : NULL,10,(int)base_v,-max_v,max_v,1 | 2)
}

FnDecimal :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    base_v: double = 0
    if count < 2 { return ValError(ERR_VALUE) }
    base_v = CoerceNumber(&args[1])
    if (base_v < 2 || base_v >= 37) { return ValError(ERR_NUM) }
    return ValToBase(&args[0],NULL,(int)base_v,10,0,1099511627776.0 - 1,4 | 8 | 16)
}

FnBin2Oct :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return ValToBase(&args[0],count >= 2 ? &args[1] : NULL,2,8,0,1111111111.0,4 | 8)
}

FnBin2Hex :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return ValToBase(&args[0],count >= 2 ? &args[1] : NULL,2,16,0,1111111111.0,4 | 8)
}

FnOct2Bin :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return ValToBase(&args[0],count >= 2 ? &args[1] : NULL,8,2,0,7777777777.0,4 | 8)
}

FnOct2Hex :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return ValToBase(&args[0],count >= 2 ? &args[1] : NULL,8,16,0,7777777777.0,4 | 8)
}

FnHex2Bin :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return ValToBase(&args[0],count >= 2 ? &args[1] : NULL,16,2,0,9999999999.0,4 | 8)
}

FnHex2Oct :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return ValToBase(&args[0],count >= 2 ? &args[1] : NULL,16,8,0,9999999999.0,4 | 8)
}

FnDelta :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    x: double = 0
    y: double = 0
    if count < 1 { return ValError(ERR_VALUE) }
    x = CoerceNumber(&args[0])
    y = count >= 2 ? CoerceNumber(&args[1]) : 0
    if x == y { return ValNumber(1) }
    return ValNumber(0)
}

FnGestep :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    x: double = 0
    y: double = 0
    if count < 1 { return ValError(ERR_VALUE) }
    x = CoerceNumber(&args[0])
    y = count >= 2 ? CoerceNumber(&args[1]) : 0
    if x >= y { return ValNumber(1) }
    return ValNumber(0)
}

FnErfc :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    return ValNumber(erfc(CoerceNumber(&args[0])))
}

FnHexrep :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    out: [20] char = ""
    data: [8] unsigned char = {0}
    hexd: CString = "0123456789abcdef"
    v: double = 0
    i: int = 0
    if count < 1 { return ValError(ERR_VALUE) }
    v = CoerceNumber(&args[0])
    memcpy(data,&v,8)
    while i < 8 {
        out[i * 2] = hexd[data[i] >> 4]
        out[i * 2 + 1] = hexd[data[i] & 15]
        i += 1
    }
    out[16] = 0
    return ValString(wb_strdup(out))
}

FnInvsuminv :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    suminv: double = 0
    zerop: int = 0
    i: int = 0
    x: double = 0
    while i < list.count {
        x = list.data[i]
        if x < 0 { return ValError(ERR_VALUE) }
        if x == 0 {
            zerop = 1
        }
else {
            suminv += 1 / x
        }
        i += 1
    }
    if list.count <= 0 { return ValError(ERR_VALUE) }
    if zerop != 0 { return ValNumber(0) }
    return ValNumber(1 / suminv)
}

BIT_MAX :: () -> double {
    v: double = 2 / 2.2204460492503131e-16
    if (v > 18446744073709551615.0) { return 18446744073709551615.0 }
    return v
}

FnBitAgg :: (args: Val *, count: int, op: int) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    acc: unsigned long long = 0
    if op == 0 { acc = 18446744073709551615ULL }
    i: int = 0
    xf: double = 0
    bmax: double = BIT_MAX()
    while i < list.count {
        xf = floor(list.data[i])
        if (xf < 0 || xf > bmax) { return ValError(ERR_VALUE) }
        if op == 0 {
            acc = acc & (unsigned long long)xf
        }
else if op == 1 {
            acc = acc | (unsigned long long)xf
        }
else {
            acc = acc ^ (unsigned long long)xf
        }
        i += 1
    }
    if list.count == 0 { return ValError(ERR_VALUE) }
    return ValNumber((double)acc)
}

FnBitand :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return FnBitAgg(args,count,0)
}

FnBitor :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return FnBitAgg(args,count,1)
}

FnBitxor :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return FnBitAgg(args,count,2)
}

FnBitshift :: (args: Val *, count: int, left: int) -> Val {
    l: double = 0
    r: double = 0
    bmax: double = 0
    if count < 2 { return ValError(ERR_VALUE) }
    l = CoerceNumber(&args[0])
    r = floor(CoerceNumber(&args[1]))
    bmax = BIT_MAX()
    if (l < 0 || l > bmax) { return ValError(ERR_NUM) }
    if (r >= 64 || r <= -64) { return ValNumber(0) }
    if r < 0 {
        if left != 0 {
            return ValNumber((double)((unsigned long long)l >> (unsigned long long)(-r)))
        }
        return ValNumber((double)((unsigned long long)l << (unsigned long long)(-r)))
    }
    if left != 0 {
        return ValNumber((double)((unsigned long long)l << (unsigned long long)r))
    }
    return ValNumber((double)((unsigned long long)l >> (unsigned long long)r))
}

FnBitlshift :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return FnBitshift(args,count,1)
}

FnBitrshift :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return FnBitshift(args,count,0)
}

DbCond :: struct {
    op: int
    is_num: int
    num: double
    text: [48] char
}

DbParseNumber :: (text: const char *, out: double *) -> int {
    p: const char * = text
    end: char * = NULL
    v: double = 0
    while p[0] == 32 || (p[0] >= 9 && p[0] <= 13) { p += 1 }
    v = strtod(p,&end)
    if end == p { return 0 }
    while end[0] == 32 || (end[0] >= 9 && end[0] <= 13) { end += 1 }
    if end[0] != 0 { return 0 }
    out[0] = v
    return 1
}

DbWildMatch :: (pat: const char *, s: const char *) -> int {
    si: int = 0
    star: int = -1
    ss: int = 0
    pi: int = 0
    lc: [64] char = ""
    ls: [256] char = ""
    i: int = 0
    while i < 63 && s[i] != 0 {
        lc[i] = (char)tolower((unsigned char)s[i])
        i += 1
    }
    lc[i] = 0
    i = 0
    while i < 63 && pat[i] != 0 {
        ls[i] = (char)tolower((unsigned char)pat[i])
        i += 1
    }
    ls[i] = 0
    while lc[si] != 0 {
        if (ls[pi] == 63 || ls[pi] == lc[si]) && ls[pi] != 0 {
            si += 1
            pi += 1
        }
else if ls[pi] == 42 && ls[pi] != 0 {
            star = pi
            pi += 1
            ss = si
        }
else if star >= 0 {
            pi = star + 1
            ss += 1
            si = ss
        }
else {
            return 0
        }
    }
    while ls[pi] == 42 { pi += 1 }
    if ls[pi] == 0 { return 1 }
    return 0
}

DbParseCond :: (v: Val *, out: DbCond *) -> int {
    txt: const char * = ""
    rest: const char * = ""
    num: double = 0
    out->op = 0
    out->is_num = 0
    out->num = 0
    out->text[0] = 0
    if v->kind == VAL_FLOAT {
        out->op = 0
        out->is_num = 1
        out->num = v->number
        return 1
    }
    if v->kind == VAL_BOOL {
        out->op = 0
        out->is_num = 1
        out->num = v->number
        return 1
    }
    if v->kind != VAL_STRING { out->op = 9; return 1 }
    txt = v->text
    if txt[0] == 0 { out->op = 10; return 1 }
    if txt[0] == 60 && txt[1] == 61 {
        rest = txt + 2
        out->op = 5
    }
else if txt[0] == 62 && txt[1] == 61 {
        rest = txt + 2
        out->op = 3
    }
else if txt[0] == 60 && txt[1] == 62 {
        rest = txt + 2
        if rest[0] == 0 {
            out->op = 7
            return 1
        }
        out->op = 1
    }
else if txt[0] == 60 {
        rest = txt + 1
        out->op = 4
    }
else if txt[0] == 61 {
        rest = txt + 1
        if rest[0] == 0 {
            out->op = 8
            return 1
        }
        out->op = 0
    }
else if txt[0] == 62 {
        rest = txt + 1
        out->op = 2
    }
else {
        rest = txt
        out->op = 6
    }
    if DbParseNumber(rest,&num) != 0 {
        out->is_num = 1
        out->num = num
        if out->op == 6 { out->op = 0 }
    }
else {
        i: int = 0
        while i < 47 && rest[i] != 0 {
            out->text[i] = rest[i]
            i += 1
        }
        out->text[i] = 0
    }
    return 1
}

DbTestCond :: (x: Val *, cond: DbCond *) -> int {
    wrong: int = 0
    xf: double = 0
    c: int = 0
    if cond->op == 9 { return 0 }
    if cond->op == 7 {
        if x->kind == VAL_EMPTY { return 0 }
        return 1
    }
    if cond->op == 8 {
        if x->kind == VAL_EMPTY { return 1 }
        return 0
    }
    if cond->op == 10 {
        if x->kind == VAL_EMPTY { return 1 }
        if x->kind == VAL_STRING && x->text[0] == 0 { return 1 }
        return 0
    }
    if cond->op == 6 {
        if x->kind != VAL_STRING { return 0 }
        return DbWildMatch(cond->text,x->text)
    }
    if cond->is_num != 0 {
        if x->kind == VAL_BOOL || x->kind == VAL_ERROR { wrong = 1 }
    else if x->kind == VAL_FLOAT { xf = x->number }
    else if x->kind == VAL_STRING && cond->op == 0 {
            if DbParseNumber(x->text,&xf) == 0 { wrong = 1 }
        }
    else { wrong = 1 }
        if wrong != 0 {
            if cond->op == 1 { return 1 }
            return 0
        }
        if cond->op == 0 { return xf == cond->num ? 1 : 0 }
        if cond->op == 1 { return xf != cond->num ? 1 : 0 }
        if cond->op == 2 { return xf > cond->num ? 1 : 0 }
        if cond->op == 3 { return xf >= cond->num ? 1 : 0 }
        if cond->op == 4 { return xf < cond->num ? 1 : 0 }
        return xf <= cond->num ? 1 : 0
    }
    if x->kind != VAL_STRING { wrong = 1 }
    if wrong != 0 {
        if cond->op == 1 { return 1 }
        return 0
    }
    c = strcasecmp(x->text,cond->text)
    if cond->op == 0 { return c == 0 ? 1 : 0 }
    if cond->op == 1 { return c != 0 ? 1 : 0 }
    if cond->op == 2 { return c > 0 ? 1 : 0 }
    if cond->op == 3 { return c >= 0 ? 1 : 0 }
    if cond->op == 4 { return c < 0 ? 1 : 0 }
    return c <= 0 ? 1 : 0
}

DbFindColumn :: (args: Val *, db_start: int, db_cols: int, db_rows: int, field: Val *) -> int {
    n: int = 0
    hdr: const char * = ""
    if field->kind == VAL_FLOAT || field->kind == VAL_BOOL {
        return (int)field->number - 1
    }
    if field->kind != VAL_STRING { return -2 }
    n = 0
    while n < db_cols {
        cell: Val * = &args[db_start + n]
        if cell->kind == VAL_STRING {
            hdr = cell->text
        }
else if cell->kind == VAL_FLOAT {
            hdr = ""
        }
else {
            hdr = ""
        }
        if cell->kind == VAL_STRING && strcasecmp(field->text,hdr) == 0 { return n }
        n += 1
    }
    return -2
}

DbSetup :: (st: EvalState *, args: Val *, count: int, marks: int *, allow_missing: int, db_start: int *, db_cols: int *, db_rows: int *, fieldno: int *, crit_start: int *, crit_cols: int *, crit_rows: int *, conds: DbCond *, cond_cols: int *, cond_counts: int *, crit_row_count: int *) -> int {
    groups: int = 0
    field: Val * = NULL
    crit_header: [16] int = {0}
    r: int = 0
    c: int = 0
    ci: int = 0
    db_start[0] = 0
    db_cols[0] = 0
    db_rows[0] = 0
    fieldno[0] = -1
    crit_start[0] = 0
    crit_cols[0] = 0
    crit_rows[0] = 0
    crit_row_count[0] = 0
    groups = ArgGroupCount(args,marks,count)
    if groups < 2 { return 0 }
    GroupBounds(marks,count,0,db_start,&db_rows[0])
    db_cols[0] = st->call_group_cols[db_start[0]]
    if db_cols[0] < 1 { return 0 }
    db_rows[0] = db_rows[0] / db_cols[0]
    if db_rows[0] < 2 { return 0 }
    field_missing: int = 0
    if allow_missing != 0 {
        if groups < 3 {
            field_missing = 1
        }
else {
            field = &args[db_start[0] + db_cols[0] * db_rows[0]]
            if (field->kind != VAL_STRING && field->kind != VAL_FLOAT && field->kind != VAL_BOOL) { field_missing = 1 }
        }
    }
    if field_missing != 0 {
        fieldno[0] = -1
        GroupBounds(marks,count,groups - 1,crit_start,&crit_rows[0])
    }
else {
        field = &args[db_start[0] + db_cols[0] * db_rows[0]]
        fieldno[0] = DbFindColumn(args,db_start[0],db_cols[0],db_rows[0],field)
        if fieldno[0] == -2 { return 0 }
        if (fieldno[0] < 0 || fieldno[0] >= db_cols[0]) { fieldno[0] = -3 }
        GroupBounds(marks,count,groups - 1,crit_start,&crit_rows[0])
    }
    if crit_rows[0] < 1 { return 0 }
    crit_cols[0] = st->call_group_cols[crit_start[0]]
    if crit_cols[0] < 1 { return 0 }
    crit_rows[0] = crit_rows[0] / crit_cols[0]
    if crit_rows[0] < 2 { return 0 }
    c = 0
    while c < crit_cols[0] && c < 16 {
        hcell: Val * = &args[crit_start[0] + c]
        crit_header[c] = -2
        if hcell->kind == VAL_STRING && hcell->text[0] != 0 {
            crit_header[c] = DbFindColumn(args,db_start[0],db_cols[0],db_rows[0],hcell)
            if crit_header[c] == -2 { return 0 }
        }
else if hcell->kind == VAL_FLOAT {
            crit_header[c] = DbFindColumn(args,db_start[0],db_cols[0],db_rows[0],hcell)
            if crit_header[c] == -2 { crit_header[c] = -2 }
        }
        c += 1
    }
    r = 1
    while r < crit_rows[0] {
        cnt: int = 0
        c = 0
        while c < crit_cols[0] && c < 16 {
            cc: Val * = &args[crit_start[0] + r * crit_cols[0] + c]
            if cc->kind != VAL_EMPTY {
                if ci < 128 {
                    cond_cols[ci] = crit_header[c]
                    DbParseCond(cc,&conds[ci])
                    ci += 1
                    cnt += 1
                }
            }
            c += 1
        }
        cond_counts[r] = cnt
        r += 1
    }
    crit_row_count[0] = crit_rows[0]
    return 1
}

DbRowMatches :: (args: Val *, db_start: int, db_cols: int, row: int, conds: DbCond *, cond_cols: int *, cond_counts: int *, crit_rows: int) -> int {
    cr: int = 1
    k: int = 0
    ci: int = 0
    while cr < crit_rows {
        all: int = 1
        k = 0
        while k < cond_counts[cr] {
            cond: DbCond * = &conds[ci]
            xv: Val * = NULL
            empty_v: Val = {VAL_EMPTY,0.0,NULL,0,0}
            if cond_cols[ci] >= 0 {
                xv = &args[db_start + row * db_cols + cond_cols[ci]]
            }
else {
                xv = &empty_v
            }
            if DbTestCond(xv,cond) == 0 {
                all = 0
                break
            }
            k += 1
            ci += 1
        }
        if all != 0 { return 1 }
        ci = ci + (cond_counts[cr] - k)
        cr += 1
    }
    return 0
}

DbCollectFloats :: (st: EvalState *, args: Val *, count: int, marks: int *, allow_missing: int, out: double *, out_n: int *, err: int *) -> int {
    db_start: int = 0
    db_cols: int = 0
    db_rows: int = 0
    fieldno: int = -1
    crit_start: int = 0
    crit_cols: int = 0
    crit_rows: int = 0
    conds: [128] DbCond = {0}
    cond_cols: [128] int = {0}
    cond_counts: [64] int = {0}
    crit_row_count: int = 0
    row: int = 1
    n: int = 0
    if DbSetup(st,args,count,marks,allow_missing,&db_start,&db_cols,&db_rows,&fieldno,&crit_start,&crit_cols,&crit_rows,conds,cond_cols,cond_counts,&crit_row_count) == 0 {
        err[0] = ERR_NUM
        return 0
    }
    while row < db_rows {
        cellv: Val * = NULL
        if fieldno == -3 { break }
        if fieldno >= 0 {
            cellv = &args[db_start + row * db_cols + fieldno]
            if cellv->kind == VAL_EMPTY { row += 1; continue }
        }
        if DbRowMatches(args,db_start,db_cols,row,conds,cond_cols,cond_counts,crit_rows) != 0 {
            if fieldno < 0 {
                cellv = &args[db_start + row * db_cols]
                if cellv->kind == VAL_EMPTY { row += 1; continue }
            }
            if cellv->kind == VAL_ERROR { err[0] = cellv->err; return 0 }
            if cellv->kind == VAL_STRING || cellv->kind == VAL_BOOL || cellv->kind == VAL_EMPTY { row += 1; continue }
            if n < 512 {
                out[n] = cellv->number
                n += 1
            }
        }
        row += 1
    }
    out_n[0] = n
    return 1
}

DbCollectValues :: (st: EvalState *, args: Val *, count: int, marks: int *, allow_missing: int, ignore_strings: int, out: Val *, out_n: int *, err: int *) -> int {
    db_start: int = 0
    db_cols: int = 0
    db_rows: int = 0
    fieldno: int = -1
    crit_start: int = 0
    crit_cols: int = 0
    crit_rows: int = 0
    conds: [128] DbCond = {0}
    cond_cols: [128] int = {0}
    cond_counts: [64] int = {0}
    crit_row_count: int = 0
    row: int = 1
    n: int = 0
    if DbSetup(st,args,count,marks,allow_missing,&db_start,&db_cols,&db_rows,&fieldno,&crit_start,&crit_cols,&crit_rows,conds,cond_cols,cond_counts,&crit_row_count) == 0 {
        err[0] = ERR_NUM
        return 0
    }
    while row < db_rows {
        cellv: Val * = NULL
        if fieldno == -3 { break }
        if fieldno >= 0 {
            cellv = &args[db_start + row * db_cols + fieldno]
            if cellv->kind == VAL_EMPTY { row += 1; continue }
        }
        if DbRowMatches(args,db_start,db_cols,row,conds,cond_cols,cond_counts,crit_rows) != 0 {
            if fieldno < 0 {
                cellv = &args[db_start + row * db_cols]
                if n < 512 {
                    out[n] = cellv[0]
                    if cellv->kind == VAL_STRING && cellv->text != NULL {
                        out[n].text = wb_strdup(cellv->text)
                    }
                    n += 1
                }
                row += 1
                continue
            }
            if (ignore_strings != 0 && cellv->kind == VAL_STRING) || cellv->kind == VAL_BOOL || cellv->kind == VAL_EMPTY { row += 1; continue }
            if n < 512 {
                out[n] = cellv[0]
                if cellv->kind == VAL_STRING && cellv->text != NULL {
                    out[n].text = wb_strdup(cellv->text)
                }
                n += 1
            }
        }
        row += 1
    }
    out_n[0] = n
    return 1
}

DbFloatAgg :: (st: EvalState *, args: Val *, count: int, marks: int *, agg: int, zero_num_error: int) -> Val {
    vals: [512] double = {0}
    n: int = 0
    err: int = 0
    i: int = 0
    total: double = 0
    prod: double = 1
    mean: double = 0
    m2: double = 0
    if DbCollectFloats(st,args,count,marks,0,vals,&n,&err) == 0 {
        return ValError(err)
    }
    if n == 0 && zero_num_error != 0 { return ValError(ERR_NUM) }
    if agg == 0 {
        if n == 0 { return ValError(ERR_NUM) }
        i = 0
        while i < n { total += vals[i]; i += 1 }
        return ValNumber(total / (double)n)
    }
    if agg == 1 {
        if n == 0 { return ValError(ERR_NUM) }
        best: double = vals[0]
        i = 1
        while i < n {
            if vals[i] > best { best = vals[i] }
            i += 1
        }
        return ValNumber(best)
    }
    if agg == 2 {
        if n == 0 { return ValError(ERR_NUM) }
        best2: double = vals[0]
        i = 1
        while i < n {
            if vals[i] < best2 { best2 = vals[i] }
            i += 1
        }
        return ValNumber(best2)
    }
    if agg == 3 {
        i = 0
        while i < n { total += vals[i]; i += 1 }
        return ValNumber(total)
    }
    if agg == 4 {
        i = 0
        while i < n { prod *= vals[i]; i += 1 }
        return ValNumber(prod)
    }
    i = 0
    while i < n { total += vals[i]; i += 1 }
    if n == 0 { return ValError(ERR_NUM) }
    mean = total / (double)n
    i = 0
    while i < n {
        d: double = vals[i] - mean
        m2 += d * d
        i += 1
    }
    if agg == 5 {
        if n < 2 { return ValError(ERR_NUM) }
        return ValNumber(sqrt(m2 / (double)(n - 1)))
    }
    if agg == 6 {
        return ValNumber(sqrt(m2 / (double)n))
    }
    if agg == 7 {
        if n < 2 { return ValError(ERR_NUM) }
        return ValNumber(m2 / (double)(n - 1))
    }
    return ValNumber(m2 / (double)n)
}

FnDaverage :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return DbFloatAgg(st,args,count,marks,0,1)
}

FnDmax :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return DbFloatAgg(st,args,count,marks,1,1)
}

FnDmin :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return DbFloatAgg(st,args,count,marks,2,1)
}

FnDsum :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return DbFloatAgg(st,args,count,marks,3,0)
}

FnDproduct :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return DbFloatAgg(st,args,count,marks,4,0)
}

FnDstdev :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return DbFloatAgg(st,args,count,marks,5,0)
}

FnDstdevp :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return DbFloatAgg(st,args,count,marks,6,0)
}

FnDvar :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return DbFloatAgg(st,args,count,marks,7,0)
}

FnDvarp :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return DbFloatAgg(st,args,count,marks,8,0)
}

FnDcount :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    vals: [512] Val = {0}
    n: int = 0
    err: int = 0
    i: int = 0
    n2: int = 0
    if DbCollectValues(st,args,count,marks,1,1,vals,&n,&err) == 0 {
        return ValError(err)
    }
    i = 0
    while i < n {
        if vals[i].kind == VAL_ERROR { i += 1; continue }
        n2 += 1
        i += 1
    }
    return ValNumber((double)n2)
}

FnDcounta :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    vals: [512] Val = {0}
    n: int = 0
    err: int = 0
    if DbCollectValues(st,args,count,marks,1,0,vals,&n,&err) == 0 {
        return ValError(err)
    }
    return ValNumber((double)n)
}

FnDget :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    vals: [512] Val = {0}
    n: int = 0
    err: int = 0
    res: Val = {VAL_EMPTY,0.0,NULL,0,0}
    if DbCollectValues(st,args,count,marks,0,0,vals,&n,&err) == 0 {
        return ValError(err)
    }
    if n == 0 { return ValError(ERR_VALUE) }
    res = vals[0]
    cleanup_i: int = 1
    while cleanup_i < n {
        if vals[cleanup_i].kind == VAL_STRING && vals[cleanup_i].text != NULL {
            free((void *)vals[cleanup_i].text)
        }
        cleanup_i += 1
    }
    return res
}

FnGetpivotdata :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    db_start: int = 0
    db_cols: int = 0
    db_rows: int = 0
    groups: int = 0
    fieldno: int = -1
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].from_range == 0 { return ValError(ERR_VALUE) }
    groups = ArgGroupCount(args,marks,count)
    if groups < 1 { return ValError(ERR_REF) }
    GroupBounds(marks,count,0,&db_start,&db_rows)
    db_cols = st->call_group_cols[db_start]
    if db_cols < 1 { return ValError(ERR_REF) }
    db_rows = db_rows / db_cols
    if db_rows < 1 { return ValError(ERR_REF) }
    fieldno = DbFindColumn(args,db_start,db_cols,db_rows,&args[db_start + db_cols * db_rows])
    if fieldno < 0 || fieldno >= db_cols { return ValError(ERR_REF) }
    cellv: Val * = &args[db_start + (db_rows - 1) * db_cols + fieldno]
    if cellv->kind != VAL_FLOAT { return ValError(ERR_REF) }
    return ValNumber(cellv->number)
}

GoTanpi :: (x_in: double) -> double {
    x: double = x_in
    x = fmod(x,1.0)
    if x == 0 { return copysign(0.0,x) }
    if fabs(x) == 0.5 { return copysign(0.0 / 0.0,x) }
    return GoSinpi(x) / GoCosPi(x)
}

GoCotpi :: (x_in: double) -> double {
    x: double = x_in
    x = fmod(x,1.0)
    if x == 0 { return copysign(0.0 / 0.0,x) }
    if fabs(x) == 0.5 { return copysign(0.0,x) }
    return GoCosPi(x) / GoSinpi(x)
}

FnMath1 :: (op: int, args: Val *, count: int) -> Val {
    v: double = 0
    if count < 1 { return ValError(ERR_VALUE) }
    v = CoerceNumber(&args[0])
    if op == 0 { return ValNumber(atan(1 / v)) }
    if op == 1 {
        if fabs(v) > 2 { return ValNumber(0.5 * log1p(2 / (v - 1))) }
        return ValNumber(0.5 * log((v + 1) / (v - 1)))
    }
    if op == 2 { return ValNumber(acosh(v)) }
    if op == 3 { return ValNumber(asinh(v)) }
    if op == 4 { return ValNumber(atanh(v)) }
    if op == 5 { return ValNumber(expm1(v)) }
    if op == 6 { return ValNumber(log2(v)) }
    if op == 7 { return ValNumber(sqrt(v * 3.141592653589793)) }
    if op == 8 { return ValNumber(GoSinpi(v)) }
    if op == 9 { return ValNumber(GoCosPi(v)) }
    if op == 10 { return ValNumber(GoTanpi(v)) }
    return ValNumber(GoCotpi(v))
}

FnHypot :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    a: double = 0
    b: double = 0
    if count < 2 { return ValError(ERR_VALUE) }
    a = CoerceNumber(&args[0])
    b = CoerceNumber(&args[1])
    return ValNumber(hypot(a,b))
}

FnCeiling :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    x: double = 0
    s: double = 0
    if count < 1 { return ValError(ERR_VALUE) }
    x = CoerceNumber(&args[0])
    s = count >= 2 ? CoerceNumber(&args[1]) : (x > 0 ? 1 : -1)
    if (x == 0 || s == 0) { return ValNumber(0) }
    if (x > 0 && s < 0) { return ValError(ERR_NUM) }
    return ValNumber(ceil(x / s) * s)
}

FnMround :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    number: double = 0
    multiple: double = 0
    sign: int = 1
    mod: double = 0
    div: double = 0
    if count < 2 { return ValError(ERR_VALUE) }
    number = CoerceNumber(&args[0])
    multiple = CoerceNumber(&args[1])
    if multiple == 0 { return ValNumber(0) }
    if ((number > 0 && multiple < 0) || (number < 0 && multiple > 0)) { return ValError(ERR_NUM) }
    if number < 0 {
        sign = -1
        number = -number
        multiple = -multiple
    }
    mod = fmod(number,multiple)
    div = (mod >= multiple / 2 ? multiple : 0) + (number - mod)
    return ValNumber(sign * div)
}

FnIsEvenOdd :: (even: int, args: Val *, count: int) -> Val {
    v: double = 0
    r: double = 0
    if count < 1 { return ValError(ERR_VALUE) }
    v = CoerceNumber(&args[0])
    r = fmod(fabs(v),2)
    if even != 0 { return ValBool(r < 1 ? 1 : 0) }
    return ValBool(r >= 1 ? 1 : 0)
}

FnPairAgg :: (op: int, args: Val *, count: int, marks: int *) -> Val {
    xs: [4096] double = {0}
    ys: [4096] double = {0}
    s: double = 0
    i: int = 0
    n: int = 0
    gx: int = 0
    gl: int = 0
    hy: int = 0
    hl: int = 0
    xn: int = 0
    yn: int = 0
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].from_range != 0 || args[1].from_range != 0 { return ValError(ERR_VALUE) }
    if GroupBounds(marks,count,0,&gx,&gl) == 0 { return ValError(ERR_VALUE) }
    if GroupBounds(marks,count,1,&hy,&hl) == 0 { return ValError(ERR_VALUE) }
    xn = CashList(args + gx,gl,xs)
    yn = CashList(args + hy,hl,ys)
    if (xn < 0 || yn < 0) { return ValError(ERR_VALUE) }
    if (xn != yn || xn == 0) { return ValError(ERR_NA) }
    n = xn
    i = 0
    while i < n {
        if op == 0 {
            s += xs[i] * xs[i] - ys[i] * ys[i]
        }
else if op == 1 {
            s += xs[i] * xs[i] + ys[i] * ys[i]
        }
else {
            s += (xs[i] - ys[i]) * (xs[i] - ys[i])
        }
        i += 1
    }
    return ValNumber(s)
}

FnSumsq :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    s: double = 0
    i: int = 0
    CollectNumbers(args,count,&list)
    while i < list.count {
        s += list.data[i] * list.data[i]
        i += 1
    }
    return ValNumber(s)
}

FnMultinomial :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    result: double = 1
    sum: int = 0
    i: int = 0
    j: int = 0
    CollectNumbers(args,count,&list)
    while i < list.count {
        x: double = list.data[i]
        xi: int = 0
        if (x < 0 || x > 2147483647) { return ValError(ERR_NUM) }
        xi = (int)x
        if (sum != 0 && xi != 0) {
            f: int = sum + xi
            result *= f
            f -= 1
            j = 2
            while j <= xi {
                result = result * f / j
                f -= 1
                j += 1
            }
        }
        sum += xi
        i += 1
    }
    return ValNumber(result)
}

Cplx :: struct {
    re: double
    im: double
}

CxParse :: (src_in: const char *, dst: Cplx *, unit: int *) -> int {
    src: const char * = src_in
    end: char * = NULL
    x: double = 0
    y: double = 0
    sign: int = 0
    unit[0] = 105
    dst->re = 0
    dst->im = 0
    while (src[0] == 32 || (src[0] >= 9 && src[0] <= 13)) { src += 1 }
    if src[0] == 45 {
        sign = -1
        src += 1
        while (src[0] == 32 || (src[0] >= 9 && src[0] <= 13)) { src += 1 }
    }
else if src[0] == 43 {
        sign = 1
        src += 1
        while (src[0] == 32 || (src[0] >= 9 && src[0] <= 13)) { src += 1 }
    }
else {
        sign = 0
    }
    if (src[0] == 105 || src[0] == 106) {
        x = 1
    }
else {
        x = strtod(src,&end)
        if (end == src || x - x != 0) { return -1 }
        src = end
        while (src[0] == 32 || (src[0] >= 9 && src[0] <= 13)) { src += 1 }
    }
    if sign < 0 { x = 0 - x }
    if src[0] == 0 {
        dst->re = x
        dst->im = 0
        unit[0] = 105
        return 0
    }
    if (src[0] == 105 || src[0] == 106) && src[1] == 0 {
        unit[0] = src[0]
        dst->re = 0
        dst->im = x
        return 0
    }
    if src[0] == 43 {
        sign = 1
        src += 1
        while (src[0] == 32 || (src[0] >= 9 && src[0] <= 13)) { src += 1 }
    }
else if src[0] == 45 {
        sign = -1
        src += 1
        while (src[0] == 32 || (src[0] >= 9 && src[0] <= 13)) { src += 1 }
    }
else {
        return -1
    }
    if (src[0] == 105 || src[0] == 106) {
        y = 1
    }
else {
        y = strtod(src,&end)
        if (end == src || y - y != 0) { return -1 }
        src = end
        while (src[0] == 32 || (src[0] >= 9 && src[0] <= 13)) { src += 1 }
    }
    if sign < 0 { y = 0 - y }
    if (src[0] == 105 || src[0] == 106) && src[1] == 0 {
        unit[0] = src[0]
        dst->re = x
        dst->im = y
        return 0
    }
    return -1
}

CxArg :: (args: Val *, count: int, index: int, dst: Cplx *, unit: int *) -> int {
    txt: [256] char = ""
    if index >= count { return -1 }
    if args[index].kind == VAL_FLOAT || args[index].kind == VAL_BOOL {
        dst->re = args[index].number
        dst->im = 0
        return 0
    }
    if TextArg(args,count,index,txt,sizeof(txt)) < 0 { return -1 }
    return CxParse(txt,dst,unit)
}

CxToString :: (c: Cplx, unit: int, out: char *, cap: int) {
    have_real: int = 0
    tmp: [64] char = ""
    n: int = 0
    out[0] = 0
    if (c.re != 0 || c.im == 0) {
        FormatNumber(c.re,tmp,sizeof(tmp))
        snprintf(out,cap,"%s",tmp)
        have_real = 1
    }
    if c.im != 0 {
        if c.im == 1 {
            if have_real != 0 {
                n = (int)strlen(out)
                snprintf(out + n,cap - n,"+")
            }
        }
else if c.im == -1 {
            n = (int)strlen(out)
            snprintf(out + n,cap - n,"-")
        }
else {
            FormatNumber(c.im,tmp,sizeof(tmp))
            n = (int)strlen(out)
            if (have_real != 0 && tmp[0] != 45 && tmp[0] != 43) {
                if c.im >= 0 {
                    snprintf(out + n,cap - n,"+%s",tmp)
                }
else {
                    snprintf(out + n,cap - n,"%s",tmp)
                }
            }
else {
                snprintf(out + n,cap - n,"%s",tmp)
            }
        }
        n = (int)strlen(out)
        out[n] = (char)unit
        out[n + 1] = 0
    }
}

CxVal :: (c: Cplx, unit: int) -> Val {
    buf: [128] char = ""
    if (c.re - c.re != 0 || c.im - c.im != 0) { return ValError(ERR_NUM) }
    CxToString(c,unit,buf,sizeof(buf))
    return ValString(wb_strdup(buf))
}

CxAdd :: (a: Cplx, b: Cplx) -> Cplx {
    r: Cplx = {a.re + b.re,a.im + b.im}
    return r
}

CxSub :: (a: Cplx, b: Cplx) -> Cplx {
    r: Cplx = {a.re - b.re,a.im - b.im}
    return r
}

CxNeg :: (a: Cplx) -> Cplx {
    r: Cplx = {0 - a.re,0 - a.im}
    return r
}

CxConj :: (a: Cplx) -> Cplx {
    r: Cplx = {a.re,0 - a.im}
    return r
}

CxScale :: (a: Cplx, s: double) -> Cplx {
    r: Cplx = {a.re * s,a.im * s}
    return r
}

CxMul :: (a: Cplx, b: Cplx) -> Cplx {
    r: Cplx = {a.re * b.re - a.im * b.im,a.re * b.im + a.im * b.re}
    return r
}

CxMulImag :: (a: Cplx, y: double) -> Cplx {
    r: Cplx = {0 - y * a.im,y * a.re}
    return r
}

CxDiv :: (a: Cplx, b: Cplx) -> Cplx {
    a_re: double = a.re
    a_im: double = a.im
    b_re: double = b.re
    b_im: double = b.im
    asize: double = fabs(a_re) > fabs(a_im) ? fabs(a_re) : fabs(a_im)
    bsize: double = fabs(b_re) > fabs(b_im) ? fabs(b_re) : fabs(b_im)
    bmodsqr: double = 0
    q_re: double = 0
    q_im: double = 0
    e: int = 0
    r: Cplx = {0.0 / 0.0,0.0 / 0.0}
    if (asize - asize != 0 || bsize - bsize != 0 || bsize == 0) { return r }
    if b_im == 0 {
        r.re = a_re / b_re
        r.im = a_im / b_re
        return r
    }
    if b_re == 0 {
        r.re = a_im / b_im
        r.im = 0 - a_re / b_im
        return r
    }
    if (asize + bsize > 1e100 || asize < 1e-100 || bsize < 1e-100) {
        ea: int = ilogb(asize)
        eb: int = ilogb(bsize)
        a_re = scalbn(a_re,-ea)
        a_im = scalbn(a_im,-ea)
        b_re = scalbn(b_re,-eb)
        b_im = scalbn(b_im,-eb)
        e = ea - eb
    }
    bmodsqr = b_re * b_re + b_im * b_im
    q_re = (a_re * b_re + a_im * b_im) / bmodsqr
    q_im = (a_im * b_re - a_re * b_im) / bmodsqr
    if e != 0 {
        q_re = scalbn(q_re,e)
        q_im = scalbn(q_im,e)
    }
    r.re = q_re
    r.im = q_im
    return r
}

CxInv :: (a: Cplx) -> Cplx {
    one: Cplx = {1,0}
    return CxDiv(one,a)
}

CxMod :: (a: Cplx) -> double {
    return hypot(a.re,a.im)
}

CxAngle :: (a: Cplx) -> double {
    return atan2(a.im,a.re)
}

CxAnglePi :: (a: Cplx) -> double {
    return GoAtan2Pi(a.im,a.re)
}

CxFromPolar :: (mod: double, angle: double) -> Cplx {
    r: Cplx = {mod * cos(angle),mod * sin(angle)}
    return r
}

CxFromPolarPi :: (mod: double, angle: double) -> Cplx {
    r: Cplx = {mod * GoCosPi(angle),mod * GoSinpi(angle)}
    return r
}

CxSqrt :: (a: Cplx) -> Cplx {
    msrc: Cplx = {0,0}
    rr: Cplx = {0,0}
    m: double = 0
    sm: double = 0
    r: Cplx = {0,0}
    if (a.re < 0 && 0 - a.re > fabs(a.im)) {
        msrc.re = 0 - a.re
        msrc.im = 0 - a.im
        rr = CxSqrt(msrc)
        if a.im >= 0 {
            r.re = 0 - rr.im
            r.im = rr.re
        }
else {
            r.re = rr.im
            r.im = 0 - rr.re
        }
        return r
    }
    m = CxMod(a)
    if (m - m == 0) {
        sm = sqrt(m)
    }
else {
        sm = 2 * sqrt(hypot(a.re / 4,a.im / 4))
    }
    return CxFromPolarPi(sm,CxAnglePi(a) / 2)
}

CxExp :: (a: Cplx) -> Cplx {
    return CxFromPolar(exp(a.re),a.im)
}

CxLn :: (a: Cplx) -> Cplx {
    x: double = fabs(a.re)
    y: double = fabs(a.im)
    lm: double = 0
    r: Cplx = {0,0}
    if x > y {
        lm = log(x) + 0.5 * log1p((y / x) * (y / x))
    }
else {
        lm = log(y) + 0.5 * log1p((x / y) * (x / y))
    }
    r.re = lm
    r.im = CxAngle(a)
    return r
}

CxSin :: (a: Cplx) -> Cplx {
    r: Cplx = {sin(a.re) * cosh(a.im),cos(a.re) * sinh(a.im)}
    return r
}

CxCos :: (a: Cplx) -> Cplx {
    r: Cplx = {cos(a.re) * cosh(a.im),0 - sin(a.re) * sinh(a.im)}
    return r
}

CxTan :: (a: Cplx) -> Cplx {
    R: double = a.re
    I: double = a.im
    sr: double = sin(R)
    cr: double = cos(R)
    r: Cplx = {0,0}
    if fabs(I) < 1 {
        shi: double = sinh(I)
        D: double = cr * cr + shi * shi
        r.re = sr * cr / D
        r.im = 0.5 * sinh(2 * I) / D
    }
else {
        u: double = exp(0 - fabs(I))
        C: double = 2 * u / (1 - u * u)
        S: double = C * C
        D: double = 1 + cr * cr * S
        T: double = 1 / tanh(fabs(I))
        r.re = sr * cr * S / D
        if I < 0 {
            r.im = 0 - T / D
        }
else {
            r.im = T / D
        }
    }
    return r
}

CxPowInt :: (x: Cplx, n: int) -> Cplx {
    res: Cplx = {1,0}
    xn: Cplx = x
    dy: int = n
    while dy > 0 {
        if (dy % 2) != 0 {
            res = CxMul(res,xn)
            dy -= 1
            if dy == 0 { break }
        }
        dy /= 2
        xn = CxMul(xn,xn)
    }
    return res
}

CxPow :: (a: Cplx, b: Cplx) -> Cplx {
    r: Cplx = {0,0}
    if b.im == 0 {
        if (a.im == 0 && a.re >= 0) {
            r.re = pow(a.re,b.re)
            r.im = 0
            return r
        }
        if b.re == 0 {
            r.re = 1
            r.im = 0
            return r
        }
        if b.re == 1 { return a }
        if b.re == 2 { return CxMul(a,a) }
        if (b.re == floor(b.re) && fabs(b.re) < 1024) {
            n: int = (int)b.re
            if n > 0 { return CxPowInt(a,n) }
            if (a.re == 0 && a.im == 0) { return r }
            return CxGslInverse(CxPowInt(a,0 - n))
        }
    }
    mod: double = CxMod(a)
    arg: double = CxAngle(a)
    lm: double = log(mod)
    newmod: double = exp(b.re * lm - b.im * arg)
    newarg: double = b.re * arg + b.im * lm
    return CxFromPolar(newmod,newarg)
}

CxSinh :: (a: Cplx) -> Cplx {
    r: Cplx = {sinh(a.re) * cos(a.im),cosh(a.re) * sin(a.im)}
    return r
}

CxCosh :: (a: Cplx) -> Cplx {
    r: Cplx = {cosh(a.re) * cos(a.im),sinh(a.re) * sin(a.im)}
    return r
}

CxTanh :: (a: Cplx) -> Cplx {
    R: double = a.re
    I: double = a.im
    r: Cplx = {0,0}
    if fabs(R) < 1 {
        D: double = pow(cos(I),2.0) + pow(sinh(R),2.0)
        r.re = sinh(R) * cosh(R) / D
        r.im = 0.5 * sin(2 * I) / D
    }
else {
        D2: double = pow(cos(I),2.0) + pow(sinh(R),2.0)
        F: double = 1 + pow(cos(I) / sinh(R),2.0)
        r.re = 1 / (tanh(R) * F)
        r.im = 0.5 * sin(2 * I) / D2
    }
    return r
}

CxGslInverse :: (a: Cplx) -> Cplx {
    s: double = 1 / CxMod(a)
    r: Cplx = {(a.re * s) * s,0 - (a.im * s) * s}
    return r
}

CxSech :: (a: Cplx) -> Cplx {
    return CxGslInverse(CxCosh(a))
}

CxCsch :: (a: Cplx) -> Cplx {
    return CxGslInverse(CxSinh(a))
}

CxCoth :: (a: Cplx) -> Cplx {
    return CxGslInverse(CxTanh(a))
}

CxArcsinReal :: (a: double) -> Cplx {
    r: Cplx = {0,0}
    if fabs(a) <= 1 {
        r.re = asin(a)
        r.im = 0
    }
else {
        if a < 0 {
            r.re = 0 - 1.5707963267948966
            r.im = acosh(0 - a)
        }
else {
            r.re = 1.5707963267948966
            r.im = 0 - acosh(a)
        }
    }
    return r
}

CxArcsin :: (a: Cplx) -> Cplx {
    R: double = a.re
    I: double = a.im
    r: Cplx = {0,0}
    if I == 0 { return CxArcsinReal(R) }
    x: double = fabs(R)
    y: double = fabs(I)
    rr: double = hypot(x + 1,y)
    s: double = hypot(x - 1,y)
    A: double = 0.5 * (rr + s)
    B: double = x / A
    y2: double = y * y
    real: double = 0
    imag: double = 0
    A_crossover: double = 1.5
    B_crossover: double = 0.6417
    if B <= B_crossover {
        real = asin(B)
    }
else {
        if x <= 1 {
            D: double = 0.5 * (A + x) * (y2 / (rr + x + 1) + (s + (1 - x)))
            real = atan(x / sqrt(D))
        }
else {
            Apx: double = A + x
            D2: double = 0.5 * (Apx / (rr + x + 1) + Apx / (s + (x - 1)))
            real = atan(x / (y * sqrt(D2)))
        }
    }
    if A <= A_crossover {
        Am1: double = 0
        if x < 1 {
            Am1 = 0.5 * (y2 / (rr + (x + 1)) + y2 / (s + (1 - x)))
        }
else {
            Am1 = 0.5 * (y2 / (rr + (x + 1)) + (s + (x - 1)))
        }
        imag = log1p(Am1 + sqrt(Am1 * (A + 1)))
    }
else {
        imag = log(A + sqrt(A * A - 1))
    }
    r.re = R >= 0 ? real : 0 - real
    r.im = I >= 0 ? imag : 0 - imag
    return r
}

CxArccosReal :: (a: double) -> Cplx {
    r: Cplx = {0,0}
    if fabs(a) <= 1 {
        r.re = acos(a)
        r.im = 0
    }
else {
        if a < 0 {
            r.re = 3.141592653589793
            r.im = 0 - acosh(0 - a)
        }
else {
            r.re = 0
            r.im = acosh(a)
        }
    }
    return r
}

CxArccos :: (a: Cplx) -> Cplx {
    R: double = a.re
    I: double = a.im
    r: Cplx = {0,0}
    if I == 0 { return CxArccosReal(R) }
    x: double = fabs(R)
    y: double = fabs(I)
    rr: double = hypot(x + 1,y)
    s: double = hypot(x - 1,y)
    A: double = 0.5 * (rr + s)
    B: double = x / A
    y2: double = y * y
    real: double = 0
    imag: double = 0
    A_crossover: double = 1.5
    B_crossover: double = 0.6417
    if B <= B_crossover {
        real = acos(B)
    }
else {
        if x <= 1 {
            D: double = 0.5 * (A + x) * (y2 / (rr + x + 1) + (s + (1 - x)))
            real = atan(sqrt(D) / x)
        }
else {
            Apx: double = A + x
            D2: double = 0.5 * (Apx / (rr + x + 1) + Apx / (s + (x - 1)))
            real = atan((y * sqrt(D2)) / x)
        }
    }
    if A <= A_crossover {
        Am1: double = 0
        if x < 1 {
            Am1 = 0.5 * (y2 / (rr + (x + 1)) + y2 / (s + (1 - x)))
        }
else {
            Am1 = 0.5 * (y2 / (rr + (x + 1)) + (s + (x - 1)))
        }
        imag = log1p(Am1 + sqrt(Am1 * (A + 1)))
    }
else {
        imag = log(A + sqrt(A * A - 1))
    }
    if R >= 0 {
        r.re = real
    }
else {
        r.re = 3.141592653589793 - real
    }
    if I >= 0 {
        r.im = 0 - imag
    }
else {
        r.im = imag
    }
    return r
}

CxArctan :: (a: Cplx) -> Cplx {
    R: double = a.re
    I: double = a.im
    r: Cplx = {0,0}
    if I == 0 {
        r.re = atan(R)
        r.im = 0
        return r
    }
    rr: double = hypot(R,I)
    imag: double = 0
    u: double = 2 * I / (1 + rr * rr)
    if fabs(u) < 0.1 {
        imag = 0.25 * (log1p(u) - log1p(0 - u))
    }
else {
        A: double = hypot(R,I + 1)
        B: double = hypot(R,I - 1)
        imag = 0.5 * log(A / B)
    }
    if R == 0 {
        if I > 1 {
            r.re = 1.5707963267948966
            r.im = imag
        }
else if I < -1 {
            r.re = 0 - 1.5707963267948966
            r.im = imag
        }
else {
            r.re = 0
            r.im = imag
        }
    }
else {
        r.re = 0.5 * atan2(2 * R,(1 + rr) * (1 - rr))
        r.im = imag
    }
    return r
}

CxArcsec :: (a: Cplx) -> Cplx {
    return CxArccos(CxGslInverse(a))
}

CxArccsc :: (a: Cplx) -> Cplx {
    return CxArcsin(CxGslInverse(a))
}

CxArccot :: (a: Cplx) -> Cplx {
    if (a.re == 0 && a.im == 0) {
        r0: Cplx = {1.5707963267948966,0}
        return r0
    }
    return CxArctan(CxGslInverse(a))
}

CxArcsinh :: (a: Cplx) -> Cplx {
    return CxMulImag(CxArcsin(CxMulImag(a,1)),0 - 1)
}

CxArccosh :: (a: Cplx) -> Cplx {
    zero: Cplx = {0,0}
    if (a.im == 0 && a.re == 1) { return zero }
    t: Cplx = CxArccos(a)
    if t.im > 0 {
        return CxMulImag(t,0 - 1)
    }
    return CxMulImag(t,1)
}

CxArctanhReal :: (a: double) -> Cplx {
    r: Cplx = {0,0}
    if (a > -1 && a < 1) {
        r.re = atanh(a)
        r.im = 0
    }
else {
        r.re = acothGo(a)
        if a < 0 {
            r.im = 1.5707963267948966
        }
else {
            r.im = 0 - 1.5707963267948966
        }
    }
    return r
}

acothGo :: (a: double) -> double {
    return 0.5 * log((a + 1) / (a - 1))
}

CxArctanh :: (a: Cplx) -> Cplx {
    if a.im == 0 { return CxArctanhReal(a.re) }
    return CxMulImag(CxArctan(CxMulImag(a,1)),0 - 1)
}

CxArcsech :: (a: Cplx) -> Cplx {
    return CxArccosh(CxGslInverse(a))
}

CxArccsch :: (a: Cplx) -> Cplx {
    return CxArcsinh(CxGslInverse(a))
}

CxArccoth :: (a: Cplx) -> Cplx {
    return CxArctanh(CxGslInverse(a))
}

CxFact :: (a: Cplx) -> Cplx {
    r: Cplx = {0,0}
    i: int = 0
    acc: double = 1
    if a.im == 0 {
        if (a.re < 0 && a.re == floor(a.re)) {
            r.re = 0.0 / 0.0
            r.im = 0.0 / 0.0
            return r
        }
        if (a.re == floor(a.re) && a.re >= 0 && a.re < 170) {
            i = 1
            while i <= (int)a.re {
                acc *= (double)i
                i += 1
            }
            r.re = acc
            r.im = 0
            return r
        }
        r.re = tgamma(a.re + 1)
        r.im = 0
        return r
    }
    return CxMul(CxGamma(a),a)
}

CxGamma :: (a: Cplx) -> Cplx {
    r: Cplx = {0,0}
    if a.im == 0 {
        if (a.re < 0 && a.re == floor(a.re)) {
            r.re = 0.0 / 0.0
            r.im = 0.0 / 0.0
            return r
        }
        r.re = tgamma(a.re)
        r.im = 0
        return r
    }
    if a.re < 0 {
        b: Cplx = {3.141592653589793 * fmod(a.re,2),3.141592653589793 * a.im}
        pi_c: Cplx = {3.141592653589793,0}
        return CxDiv(pi_c,CxMul(CxFact(CxNeg(a)),CxSin(b)))
    }
    return CxPow2Lanczos(a)
}

CxPow2Lanczos :: (a: Cplx) -> Cplx {
    lanczos_g: double = 808618867.0 / 134217728
    lanczos_num: [13] double = {56906521.913471563880907910335591226868592353221448,103794043.11634454519062710536160702385539539810110,86363131.288138591455469272889778684223419113014358,43338889.324676138347737237405905333160850993321475,14605578.087685068084141699827913592185707234229516,3481712.1549806459088207101896477455646802362321652,601859.61716810987866702265336993523025071425740828,75999.293040145426498753034435989091370919973262979,6955.9996025153761403563101155151989875259157712039,449.94455690631681194468586076509884096232715968614,19.519927882476174828478609662356521362076846583112,0.50984166556566761881251786448046945099926051133936,0.0060618423462489065257837539645559368832224636654970}
    lanczos_denom: [13] double = {0,39916800,120543840,150917976,105258076,45995730,13339535,2637558,357423,32670,1925,66,1}
    p: Cplx = {lanczos_num[12],0}
    q: Cplx = {lanczos_denom[12],0}
    zmh: Cplx = {0,0}
    f: Cplx = {0,0}
    t1: Cplx = {0,0}
    t2: Cplx = {0,0}
    lg: Cplx = {lanczos_g,0}
    i: int = 11
    while i >= 0 {
        p = CxMul(p,a)
        p.re += lanczos_num[i]
        q = CxMul(q,a)
        q.re += lanczos_denom[i]
        i -= 1
    }
    zmh.re = a.re - 0.5
    zmh.im = a.im
    t1 = CxAdd(zmh,lg)
    f = CxPow(t1,CxScale(zmh,0.5))
    t2 = CxDiv(p,q)
    return CxMul(CxMul(CxMul(f,CxExp(CxNeg(zmh))),f),t2)
}

FnCx1 :: (name_op: int, args: Val *, count: int) -> Val {
    a: Cplx = {0,0}
    unit: int = 105
    if CxArg(args,count,0,&a,&unit) < 0 { return ValError(ERR_VALUE) }
    if name_op == 0 { return CxVal(CxConj(a),unit) }
    if name_op == 1 { return CxVal(CxInv(a),unit) }
    if name_op == 2 { return CxVal(CxNeg(a),unit) }
    if name_op == 3 { return CxVal(CxCos(a),unit) }
    if name_op == 4 { return CxVal(CxTan(a),unit) }
    if name_op == 5 { return CxVal(CxInv(CxCos(a)),unit) }
    if name_op == 6 { return CxVal(CxInv(CxSin(a)),unit) }
    if name_op == 7 { return CxVal(CxInv(CxTan(a)),unit) }
    if name_op == 8 { return CxVal(CxExp(a),unit) }
    if name_op == 9 { return CxVal(CxLn(a),unit) }
    if name_op == 10 { return CxVal(CxScale(CxLn(a),1 / 0.693147180559945309417232121458),unit) }
    if name_op == 11 { return CxVal(CxScale(CxLn(a),0.434294481903251827651128918917),unit) }
    if name_op == 12 { return CxVal(CxSqrt(a),unit) }
    if name_op == 13 { return CxVal(CxSin(a),unit) }
    if name_op == 14 { return CxVal(CxSinh(a),unit) }
    if name_op == 15 { return CxVal(CxCosh(a),unit) }
    if name_op == 16 { return CxVal(CxTanh(a),unit) }
    if name_op == 17 { return CxVal(CxSech(a),unit) }
    if name_op == 18 { return CxVal(CxCsch(a),unit) }
    if name_op == 19 { return CxVal(CxCoth(a),unit) }
    if name_op == 20 { return CxVal(CxArcsin(a),unit) }
    if name_op == 21 { return CxVal(CxArccos(a),unit) }
    if name_op == 22 { return CxVal(CxArctan(a),unit) }
    if name_op == 23 { return CxVal(CxArcsec(a),unit) }
    if name_op == 24 { return CxVal(CxArccsc(a),unit) }
    if name_op == 25 { return CxVal(CxArccot(a),unit) }
    if name_op == 26 { return CxVal(CxArcsinh(a),unit) }
    if name_op == 27 { return CxVal(CxArccosh(a),unit) }
    if name_op == 28 { return CxVal(CxArctanh(a),unit) }
    if name_op == 29 { return CxVal(CxArcsech(a),unit) }
    if name_op == 30 { return CxVal(CxArccsch(a),unit) }
    return CxVal(CxArccoth(a),unit)
}

FnCxReal1 :: (name_op: int, args: Val *, count: int) -> Val {
    a: Cplx = {0,0}
    unit: int = 105
    if CxArg(args,count,0,&a,&unit) < 0 { return ValError(ERR_VALUE) }
    if name_op == 0 { return ValNumber(CxMod(a)) }
    if name_op == 1 { return ValNumber(a.im) }
    if name_op == 2 { return ValNumber(a.re) }
    return ValNumber(CxAngle(a))
}


GoCosPi :: (x_in: double) -> double {
    x: double = x_in
    k: int = 0
    y: double = 0
    if x < 0 {
        k2: int = 0
        x = 0 - ReduceHalfPos(0 - x,&k2)
        k = 4 - k2
        if x == -0.25 {
            x += 0.5
            k += 3
        }
    }
else {
        x = ReduceHalfPos(x,&k)
    }
    if (x == 0 && (k & 1) == 1) { return 0.0 }
    k += 1
    if x == 0 {
        y = (k & 1) != 0 ? 1 : 0
    }
else if x == 0.25 {
        y = 0.707106781186547524400844362104849039284835937688474036588339
    }
else {
        if (k & 1) != 0 {
            y = cos(3.141592653589793 * x)
        }
else {
            y = sin(3.141592653589793 * x)
        }
    }
    if (k & 2) != 0 { return 0 - y }
    return y
}

GoAtan2Pi :: (y: double, x: double) -> double {
    return atan2(y,x) / 3.141592653589793
}

FnComplexFn :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    c: Cplx = {0,0}
    suffix: [8] char = ""
    if count < 2 { return ValError(ERR_VALUE) }
    c.re = CoerceNumber(&args[0])
    c.im = CoerceNumber(&args[1])
    if TextArg(args,count,2,suffix,sizeof(suffix)) < 0 { return ValError(ERR_VALUE) }
    if count >= 3 {
        if (strcmp(suffix,"i") != 0 && strcmp(suffix,"j") != 0) { return ValError(ERR_VALUE) }
        return CxVal(c,suffix[0])
    }
    return CxVal(c,105)
}

FnImdiv :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    a: Cplx = {0,0}
    b: Cplx = {0,0}
    unit: int = 105
    if count < 2 { return ValError(ERR_VALUE) }
    if CxArg(args,count,0,&a,&unit) < 0 { return ValError(ERR_VALUE) }
    if CxArg(args,count,1,&b,&unit) < 0 { return ValError(ERR_VALUE) }
    if (b.re == 0 && b.im == 0) { return ValError(ERR_DIV0) }
    return CxVal(CxDiv(a,b),unit)
}

FnImpower :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    a: Cplx = {0,0}
    b: Cplx = {0,0}
    unit: int = 105
    if count < 2 { return ValError(ERR_VALUE) }
    if CxArg(args,count,0,&a,&unit) < 0 { return ValError(ERR_VALUE) }
    if CxArg(args,count,1,&b,&unit) < 0 { return ValError(ERR_VALUE) }
    if (a.re == 0 && a.im == 0 && b.re == 0 && b.im == 0) { return ValError(ERR_NUM) }
    return CxVal(CxPow(a,b),unit)
}

FnImsub :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    a: Cplx = {0,0}
    b: Cplx = {0,0}
    unit: int = 105
    if count < 2 { return ValError(ERR_VALUE) }
    if CxArg(args,count,0,&a,&unit) < 0 { return ValError(ERR_VALUE) }
    if CxArg(args,count,1,&b,&unit) < 0 { return ValError(ERR_VALUE) }
    return CxVal(CxSub(a,b),unit)
}

CxIterate :: (args: Val *, count: int, product: int, unit: int *) -> Val {
    res: Cplx = {0,0}
    c: Cplx = {0,0}
    i: int = 0
    unit2: int = 106
    if product != 0 {
        res.re = 1
    }
else {
        res.re = 0
    }
    while i < count {
        if args[i].kind == VAL_ERROR { return ValError(args[i].err) }
        if args[i].kind != VAL_EMPTY {
            if CxArg(args,count,i,&c,&unit2) < 0 { return ValError(ERR_VALUE) }
            if args[i].kind != VAL_FLOAT && args[i].kind != VAL_BOOL {
                unit[0] = unit2
            }
            if product != 0 {
                res = CxMul(res,c)
            }
else {
                res = CxAdd(res,c)
            }
        }
        i += 1
    }
    return CxVal(res,unit[0])
}

FnImsum :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    unit: int = 106
    return CxIterate(args,count,0,&unit)
}

FnImproduct :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    unit: int = 106
    return CxIterate(args,count,1,&unit)
}

FnImfact :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    a: Cplx = {0,0}
    unit: int = 105
    if CxArg(args,count,0,&a,&unit) < 0 { return ValError(ERR_VALUE) }
    return CxVal(CxFact(a),unit)
}

FnImgamma :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    a: Cplx = {0,0}
    unit: int = 105
    if CxArg(args,count,0,&a,&unit) < 0 { return ValError(ERR_VALUE) }
    return CxVal(CxGamma(a),unit)
}


