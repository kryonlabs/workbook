/* == qnorm == */
qnorm :: (p: double, mu: double, sigma: double, lower_tail: int, log_p: int) -> double {
    p_: double = 0
    q: double = 0
    r: double = 0
    val: double = 0
    if (p != p || mu != mu || sigma != sigma) {
        return p + mu + sigma
    }
    if log_p != 0 {
        if p > 0 {
            return 0.0 / 0.0
        }
        if p == 0 {
            return lower_tail != 0 ? 1e308 * 10 : -1e308 * 10
        }
        if p == -1e308 * 10 {
            return lower_tail != 0 ? -1e308 * 10 : 1e308 * 10
        }
    }
else {
        if (p < 0 || p > 1) {
            return 0.0 / 0.0
        }
        if p == 0 {
            return lower_tail != 0 ? -1e308 * 10 : 1e308 * 10
        }
        if p == 1 {
            return lower_tail != 0 ? 1e308 * 10 : -1e308 * 10
        }
    }
    if sigma < 0 {
        return 0.0 / 0.0
    }
    if sigma == 0 {
        return mu
