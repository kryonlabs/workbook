#import "kryon.h"
#import "kry_xml.h"
#import "kry_gzip.h"
#import "ctype.h"
#import "math.h"
#import "stdio.h"
#import "stdlib.h"
#import "string.h"
#import "strings.h"
#import "time.h"

state {
    QFACT_MANT_H: [10000] double
    QFACT_MANT_L: [10000] double
    QFACT_EXP: [10000] int
    QFACT_BUILT: int = 0
    BD0_CH: [129] CString = {0}
    BD0_V: [516] double
    BD0_READY: int = 0
    GS_R_NPER: double = 0
    GS_R_PMT: double = 0
    GS_R_PV: double = 0
    GS_R_FV: double = 0
    GS_R_TYPE: int = 0
    GSV_A: [512] double
    GSD_A: [512] double
    GS_CASH_N: int = 0
    GS_Y_SETTLE: int = 0
    GS_Y_MAT: int = 0
    GS_Y_RATE: double = 0
    GS_Y_RED: double = 0
    GS_Y_PAR: double = 0
    GS_Y_FREQ: int = 0
    GS_Y_BASIS: int = 0
}

#enum {
    WB_MAX_SHEETS = 64
    WB_MAX_COLS = 256
    WB_MAX_ROWS = 65536
    WB_TEXT_MAX = 512
    WB_ARGS_MAX = 4096
    WB_DEPTH_MAX = 64
}

#enum {
    VAL_EMPTY = 0
    VAL_FLOAT = 1
    VAL_STRING = 2
    VAL_BOOL = 3
    VAL_ERROR = 4
    VAL_RANGE = 5
}

#enum {
    ERR_DIV0 = 0
    ERR_VALUE = 1
    ERR_REF = 2
    ERR_NAME = 3
    ERR_NUM = 4
    ERR_NA = 5
    ERR_NULL = 6
    ERR_CYCLE = 7
}

#enum {
    CELL_LITERAL = 0
    CELL_FORMULA = 1
}

CString :: const char * #type

Cell :: struct {
    key: int
    text: CString
    kind: int
    cached_kind: int
    cached_number: double
    cached_text: CString
    cached_err: int
    computed: int
    evaluating: int
    hint: int
    serialized: CString
}

Sheet :: struct {
    name: [128] char
    cells: Cell*
    cell_count: int
    cell_cap: int
    max_col: int
    max_row: int
}

Workbook :: struct {
    sheets: Sheet*
    sheet_count: int
    sheet_cap: int
}

Val :: struct {
    kind: int
    number: double
    text: CString
    err: int
    from_range: int
}

SlotRef :: struct {
    kind: int
    row: int
    col: int
    row2: int
    col2: int
}

EvalState :: struct {
    wb: Workbook*
    sheet: Sheet*
    depth: int
    args: Val*
    marks: int*
    group_cols: int*
    arg_count: int
    args_overflow: int
    hint: int
    this_row: int
    this_col: int
    last_cols: int
    call_group_cols: int*
    refs: SlotRef*
    call_refs: SlotRef*
    pend_kind: int
    pend_row: int
    pend_col: int
    pend_row2: int
    pend_col2: int
}

ErrText :: (code: int) -> CString {
    if code == ERR_DIV0 { return "#DIV/0!" }
    if code == ERR_VALUE { return "#VALUE!" }
    if code == ERR_REF { return "#REF!" }
    if code == ERR_NAME { return "#NAME?" }
    if code == ERR_NUM { return "#NUM!" }
    if code == ERR_NA { return "#N/A" }
    if code == ERR_NULL { return "#NULL!" }
    return "#CYCLE!"
}

ErrFromText :: (text: CString) -> int {
    if strcmp(text,"#DIV/0!") == 0 { return ERR_DIV0 }
    if strcmp(text,"#VALUE!") == 0 { return ERR_VALUE }
    if strcmp(text,"#REF!") == 0 { return ERR_REF }
    if strcmp(text,"#NAME?") == 0 { return ERR_NAME }
    if strcmp(text,"#NUM!") == 0 { return ERR_NUM }
    if strcmp(text,"#N/A") == 0 { return ERR_NA }
    if strcmp(text,"#NULL!") == 0 { return ERR_NULL }
    if strcmp(text,"#CYCLE!") == 0 { return ERR_CYCLE }
    return -1
}

wb_strndup :: (src: const char *, n: int) -> CString {
    out: char * = malloc(n + 1)
    if out == NULL { return NULL }
    if n > 0 { memcpy(out,src,n) }
    out[n] = 0
    return out
}

wb_strdup :: (src: const char *) -> CString {
    if src == NULL { src = "" }
    return wb_strndup(src,(int)strlen(src))
}

wb_replace_text :: (slot: CString *, text: CString) {
    free((void *)*slot)
    *slot = wb_strdup(text)
}

wb_free_val :: (cell: Cell *) {
    free((void *)cell->cached_text)
    cell->cached_text = NULL
}

FormatNumber :: (value: double, out: char *, cap: int) {
    tmp: [64] char = ""
    sci: [64] char = ""
    precision: int = 15
    digits: int = 0
    exp10: int = 0
    i: int = 0
    mant_len: int = 0
    decimals: int = 0
    epos: int = -1
    sign: int = 0
    explen: int = 0
    mant: [32] char = ""
    if value != value {
        snprintf(out,cap,"#NUM!")
        return
    }
    if value == 0 {
        snprintf(out,cap,"0")
        return
    }
    if value == (double)(long long)value && value > -1e17 && value < 1e17 {
        snprintf(out,cap,"%lld",(long long)value)
        return
    }
    while precision <= 17 {
        snprintf(tmp,sizeof(tmp),"%.*g",precision,value)
        if strtod(tmp,NULL) == value { break }
        precision += 1
    }
    snprintf(sci,sizeof(sci),"%.*e",precision - 1,value)
    mant[0] = sci[0]
    mant_len = 1
    i = 1
    while sci[i] != 0 && sci[i] != 101 && sci[i] != 69 {
        if sci[i] != 46 {
            mant[mant_len] = sci[i]
            mant_len += 1
        }
        i += 1
    }
    while mant_len > 1 && mant[mant_len - 1] == 48 { mant_len -= 1 }
    mant[mant_len] = 0
    if mant[0] == 45 {
        digits = mant_len - 1
    }
else {
        digits = mant_len
    }
    if sci[i] == 101 || sci[i] == 69 {
        exp10 = (int)strtol(sci + i + 1,NULL,10)
    }
    if (exp10 >= -4 && exp10 <= 16) {
        decimals = digits - 1 - exp10
        if decimals < 0 { decimals = 0 }
        snprintf(out,cap,"%.*f",decimals,value)
        return
    }
    snprintf(out,cap,"%.*e",digits - 1,value)
    epos = -1
    i = 0
    while out[i] != 0 {
        if out[i] == 101 { epos = i }
        i += 1
    }
    if epos >= 0 {
        out[epos] = 69
        sign = 0
        if out[epos + 1] == 43 || out[epos + 1] == 45 { sign = 1 }
        explen = 0
        while out[epos + 1 + sign + explen] != 0 { explen += 1 }
        if explen < 2 {
            shift: int = explen + 1
            while shift >= 1 {
                out[epos + 1 + sign + shift] = out[epos + 1 + sign + shift - 1]
                shift -= 1
            }
            out[epos + 1 + sign] = 48
        }
    }
}

TextLooksNumeric :: (text: const char *) -> int {
    end: char * = NULL
    if text == NULL || text[0] == 0 { return 0 }
    strtod(text,&end)
    if end == text { return 0 }
    while end != NULL && *end != 0 && isspace((unsigned char)*end) { end += 1 }
    return *end == 0
}

WorkbookNew :: () -> Workbook * {
    wb: Workbook * = calloc(1,sizeof(Workbook))
    if wb == NULL { return NULL }
    wb->sheet_cap = 4
    wb->sheets = calloc(wb->sheet_cap,sizeof(Sheet))
    if wb->sheets == NULL {
        free(wb)
        return NULL
    }
    return wb
}

SheetFree :: (sheet: Sheet *) {
    i: int = 0
    while i < sheet->cell_count {
        free((void *)sheet->cells[i].text)
        free((void *)sheet->cells[i].cached_text)
        free((void *)sheet->cells[i].serialized)
        i += 1
    }
    free(sheet->cells)
}

WorkbookFree :: (wb: Workbook *) {
    i: int = 0
    if wb == NULL { return }
    while i < wb->sheet_count {
        SheetFree(&wb->sheets[i])
        i += 1
    }
    free(wb->sheets)
    free(wb)
}

WorkbookAddSheet :: (wb: Workbook *, name: const char *) -> Sheet * {
    if wb->sheet_count >= WB_MAX_SHEETS { return NULL }
    if wb->sheet_count >= wb->sheet_cap {
        new_cap: int = wb->sheet_cap * 2
        grown: Sheet * = realloc(wb->sheets,sizeof(Sheet) * new_cap)
        if grown == NULL { return NULL }
        wb->sheets = grown
        wb->sheet_cap = new_cap
    }
    sheet: Sheet * = &wb->sheets[wb->sheet_count]
    memset(sheet,0,sizeof(Sheet))
    snprintf(sheet->name,sizeof(sheet->name),"%s",name)
    wb->sheet_count += 1
    return sheet
}

WorkbookFindSheet :: (wb: Workbook *, name: const char *) -> Sheet * {
    i: int = 0
    while i < wb->sheet_count {
        if strcmp(wb->sheets[i].name,name) == 0 { return &wb->sheets[i] }
        i += 1
    }
    return NULL
}

CellKey :: (row: int, col: int) -> int {
    return row * WB_MAX_COLS + col
}

CellKeyRow :: (key: int) -> int {
    return key / WB_MAX_COLS
}

CellKeyCol :: (key: int) -> int {
    return key % WB_MAX_COLS
}

CellSearch :: (sheet: Sheet *, key: int, at: int *) -> int {
    lo: int = 0
    hi: int = sheet->cell_count
    while lo < hi {
        mid: int = (lo + hi) / 2
        if sheet->cells[mid].key < key { lo = mid + 1 }
        else { hi = mid }
    }
    *at = lo
    return lo < sheet->cell_count && sheet->cells[lo].key == key
}

CellAt :: (sheet: Sheet *, row: int, col: int) -> Cell * {
    index: int = 0
    if row < 0 || row >= WB_MAX_ROWS || col < 0 || col >= WB_MAX_COLS { return NULL }
    if CellSearch(sheet,CellKey(row,col),&index) { return &sheet->cells[index] }
    return NULL
}

CellObtain :: (sheet: Sheet *, row: int, col: int) -> Cell * {
    index: int = 0
    key: int = CellKey(row,col)
    if CellSearch(sheet,key,&index) { return &sheet->cells[index] }
    if sheet->cell_count >= sheet->cell_cap {
        new_cap: int = sheet->cell_cap != 0 ? sheet->cell_cap * 2 : 64
        grown: Cell * = realloc(sheet->cells,sizeof(Cell) * new_cap)
        if grown == NULL { return NULL }
        sheet->cells = grown
        sheet->cell_cap = new_cap
    }
    if index < sheet->cell_count {
        memmove(&sheet->cells[index + 1],&sheet->cells[index],sizeof(Cell) * (sheet->cell_count - index))
    }
    sheet->cell_count += 1
    cell: Cell * = &sheet->cells[index]
    memset(cell,0,sizeof(Cell))
    cell->key = key
    return cell
}

SheetDrop :: (sheet: Sheet *, row: int, col: int) {
    index: int = 0
    if CellSearch(sheet,CellKey(row,col),&index) {
        free((void *)sheet->cells[index].text)
        free((void *)sheet->cells[index].cached_text)
        free((void *)sheet->cells[index].serialized)
        memmove(&sheet->cells[index],&sheet->cells[index + 1],sizeof(Cell) * (sheet->cell_count - index - 1))
        sheet->cell_count -= 1
    }
    SheetExtent(sheet)
}

SheetExtent :: (sheet: Sheet *) {
    i: int = 0
    sheet->max_col = -1
    sheet->max_row = -1
    while i < sheet->cell_count {
        if sheet->cells[i].text != NULL && sheet->cells[i].text[0] != 0 {
            col: int = CellKeyCol(sheet->cells[i].key)
            row: int = CellKeyRow(sheet->cells[i].key)
            if col > sheet->max_col { sheet->max_col = col }
            if row > sheet->max_row { sheet->max_row = row }
        }
        i += 1
    }
}

ClassifyCell :: (cell: Cell *) {
    text: CString = cell->text
    if text != NULL && text[0] == '=' {
        cell->kind = CELL_FORMULA
        cell->computed = 0
        cell->cached_kind = VAL_EMPTY
        return
    }
    cell->kind = CELL_LITERAL
    if text[0] == '#' {
        code: int = ErrFromText(text)
        if code >= 0 {
            cell->cached_kind = VAL_ERROR
            cell->cached_err = code
            return
        }
    }
    if TextLooksNumeric(text) {
        cell->cached_kind = VAL_FLOAT
        cell->cached_number = strtod(text,NULL)
        return
    }
    if strcasecmp(text,"TRUE") == 0 {
        cell->cached_kind = VAL_BOOL
        cell->cached_number = 1
        return
    }
    if strcasecmp(text,"FALSE") == 0 {
        cell->cached_kind = VAL_BOOL
        cell->cached_number = 0
        return
    }
    cell->cached_kind = VAL_STRING
    wb_replace_text(&cell->cached_text,text)
}

SetCellText :: (wb: Workbook *, sheet_index: int, row: int, col: int, text: const char *) -> int {
    sheet: Sheet* = NULL
    cell: Cell* = NULL
    if wb == NULL || sheet_index < 0 || sheet_index >= wb->sheet_count { return 0 }
    sheet = &wb->sheets[sheet_index]
    if row < 0 || row >= WB_MAX_ROWS || col < 0 || col >= WB_MAX_COLS { return 0 }
    if text == NULL || text[0] == 0 {
        SheetDrop(sheet,row,col)
        return 1
    }
    cell = CellObtain(sheet,row,col)
    if cell == NULL { return 0 }
    wb_replace_text(&cell->text,text)
    free((void *)cell->serialized)
    cell->serialized = NULL
    ClassifyCell(cell)
    if col > sheet->max_col { sheet->max_col = col }
    if row > sheet->max_row { sheet->max_row = row }
    return 1
}

ValNumber :: (value: double) -> Val {
    v: Val = {VAL_FLOAT,value,NULL,0,0}
    return v
}

ValBool :: (flag: int) -> Val {
    v: Val = {VAL_BOOL,flag ? 1.0 : 0.0,NULL,0,0}
    return v
}

ValString :: (text: CString) -> Val {
    v: Val = {VAL_STRING,0.0,text,0,0}
    return v
}

ValError :: (code: int) -> Val {
    v: Val = {VAL_ERROR,0.0,NULL,code,0}
    return v
}

ValEmpty :: () -> Val {
    v: Val = {VAL_EMPTY,0.0,NULL,0,0}
    return v
}

ValCopy :: (src: Val *) -> Val {
    v: Val = src[0]
    if v.kind == VAL_STRING && v.text != NULL {
        v.text = wb_strdup(v.text)
    }
    return v
}

ValFree :: (v: Val *) {
    if v->kind == VAL_STRING { free((void *)v->text) }
    v->text = NULL
}

HintWrap :: (st: EvalState *, hint: int, v: Val) -> Val {
    if v.kind == VAL_FLOAT { st->hint = hint }
    return v
}

CoerceNumber :: (v: Val *) -> double {
    if v->kind == VAL_FLOAT || v->kind == VAL_BOOL { return v->number }
    if v->kind == VAL_EMPTY { return 0 }
    if v->kind == VAL_STRING && TextLooksNumeric(v->text) { return strtod(v->text,NULL) }
    return 1e308
}

CoerceBool :: (v: Val *) -> int {
    if v->kind == VAL_BOOL { return v->number != 0 }
    if v->kind == VAL_FLOAT { return v->number != 0 }
    if v->kind == VAL_EMPTY { return 0 }
    if v->kind == VAL_STRING && TextLooksNumeric(v->text) { return strtod(v->text,NULL) != 0 }
    return -1
}

CoerceText :: (v: Val *, out: char *, cap: int) {
    if v->kind == VAL_STRING {
        snprintf(out,cap,"%s",v->text != NULL ? v->text : "")
        return
    }
    if v->kind == VAL_BOOL {
        snprintf(out,cap,"%s",v->number != 0 ? "TRUE" : "FALSE")
        return
    }
    if v->kind == VAL_FLOAT {
        FormatNumber(v->number,out,cap)
        return
    }
    if v->kind == VAL_ERROR {
        snprintf(out,cap,"%s",ErrText(v->err))
        return
    }
    out[0] = 0
}

CompareVals :: (a: Val *, b: Val *) -> int {
    an: double = 0
    bn: double = 0
    a_text: int = 0
    b_text: int = 0
    if a->kind == VAL_ERROR || b->kind == VAL_ERROR { return -2 }
    if a->kind == VAL_RANGE || b->kind == VAL_RANGE { return -2 }
    an = CoerceNumber(a)
    bn = CoerceNumber(b)
    a_text = a->kind == VAL_STRING && an >= 1e307
    b_text = b->kind == VAL_STRING && bn >= 1e307
    if a->kind == VAL_EMPTY && b->kind == VAL_EMPTY { return 0 }
    if a->kind == VAL_EMPTY {
        if (b_text) { return b->text[0] == 0 ? 0 : -1 }
        return bn == 0 ? 0 : -1
    }
    if b->kind == VAL_EMPTY {
        if (a_text) { return a->text[0] == 0 ? 0 : 1 }
        return an == 0 ? 0 : 1
    }
    if a->kind == VAL_STRING && b->kind == VAL_STRING {
        cmp: int = strcasecmp(a->text,b->text)
        return cmp < 0 ? -1 : (cmp > 0 ? 1 : 0)
    }
    if (a_text) { return 1 }
    if (b_text) { return -1 }
    if an < bn { return -1 }
    if an > bn { return 1 }
    return 0
}

SkipFormulaSpace :: (text: const char *, pos: int *) {
    while text[pos[0]] == ' ' || text[pos[0]] == '\t' || text[pos[0]] == '\n' || text[pos[0]] == '\r' {
        pos[0] += 1
    }
}

IdentChar :: (ch: int) -> int {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_' || ch == '.'
}

ParseColLetters :: (text: const char *, pos: int *) -> int {
    col: int = 0
    start: int = pos[0]
    while text[pos[0]] != 0 {
        ch: int = text[pos[0]]
        if ch >= 'A' && ch <= 'Z' { col = col * 26 + (ch - 'A' + 1) }
        else if ch >= 'a' && ch <= 'z' { col = col * 26 + (ch - 'a' + 1) }
        else { break }
        pos[0] += 1
        if col > WB_MAX_COLS { return -1 }
    }
    if pos[0] == start { return -1 }
    return col - 1
}

ParseRowDigits :: (text: const char *, pos: int *) -> int {
    row: int = 0
    start: int = pos[0]
    while text[pos[0]] != 0 {
        ch: int = text[pos[0]]
        if ch < '0' || ch > '9' { break }
        row = row * 10 + (ch - '0')
        pos[0] += 1
        if row > WB_MAX_ROWS { return -1 }
    }
    if pos[0] == start || row < 1 { return -1 }
    return row - 1
}

EvalPush :: (st: EvalState *, v: Val) {
    if st->arg_count >= WB_ARGS_MAX { st->args_overflow = 1; ValFree(&v); return }
    st->args[st->arg_count] = v
    st->marks[st->arg_count] = 0
    st->group_cols[st->arg_count] = 0
    st->refs[st->arg_count].kind = 0
    st->refs[st->arg_count].row = 0
    st->refs[st->arg_count].col = 0
    st->refs[st->arg_count].row2 = 0
    st->refs[st->arg_count].col2 = 0
    st->arg_count += 1
}

ArgGroupCount :: (args: Val *, marks: int *, count: int) -> int {
    groups: int = 0
    i: int = 0
    while i < count {
        if marks[i] { groups += 1 }
        i += 1
    }
    return groups
}

GroupBounds :: (marks: int *, count: int, group: int, start: int *, len: int *) -> int {
    found: int = -1
    i: int = 0
    begin: int = -1
    while i <= count {
        boundary: int = i == count || marks[i]
        if boundary && begin >= 0 {
            found += 1
            if found == group {
                start[0] = begin
                len[0] = i - begin
                return 1
            }
            begin = -1
        }
        if i < count && marks[i] { begin = i }
        i += 1
    }
    return 0
}

ParseSheetPrefix :: (st: EvalState *, text: const char *, pos: int *, sheet_out: Sheet * *) -> int {
    here: int = pos[0]
    end: int = here
    name: [160] char = ""
    len: int = 0
    target: Sheet* = NULL
    quoted: int = 0
    inner: [160] char = ""
    while IdentChar(text[end]) || text[end] == ' ' { end += 1 }
    if text[end] != '!' || end == here { return 0 }
    len = end - here
    while len > 0 && text[here + len - 1] == ' ' { len -= 1 }
    if len >= (int)sizeof(name) { return 0 }
    memcpy(name,text + here,len)
    name[len] = 0
    quoted = 0
    if len >= 2 && name[0] == '\'' && name[len - 1] == '\'' {
        memcpy(inner,name + 1,len - 2)
        inner[len - 2] = 0
        quoted = 1
    }
    target = WorkbookFindSheet(st->wb,quoted ? inner : name)
    if target == NULL { return -1 }
    pos[0] = end + 1
    sheet_out[0] = target
    return 1
}

TryParseReference :: (st: EvalState *, text: const char *, pos: int *, out_row: int *, out_col: int *, out_row2: int *, out_col2: int *, out_sheet: Sheet * *, out_is_range: int *) -> int {
    sheet: Sheet * = st->sheet
    local_pos: int = pos[0]
    col: int = 0
    row: int = 0
    look: int = 0
    prefix: int = ParseSheetPrefix(st,text,&local_pos,&sheet)
    if prefix < 0 { return 0 }
    if text[local_pos] == '$' { local_pos += 1 }
    col = ParseColLetters(text,&local_pos)
    if col < 0 { return 0 }
    if text[local_pos] == '$' { local_pos += 1 }
    row = ParseRowDigits(text,&local_pos)
    if row < 0 { return 0 }
    look = local_pos
    SkipFormulaSpace(text,&look)
    if text[look] == ':' {
        col2: int = 0
        row2: int = 0
        look += 1
        SkipFormulaSpace(text,&look)
        if text[look] == '$' { look += 1 }
        col2 = ParseColLetters(text,&look)
        if col2 < 0 { return 0 }
        if text[look] == '$' { look += 1 }
        row2 = ParseRowDigits(text,&look)
        if row2 < 0 { return 0 }
        pos[0] = look
        out_sheet[0] = sheet
        out_row[0] = row
        out_col[0] = col
        out_row2[0] = row2
        out_col2[0] = col2
        out_is_range[0] = 1
        return 1
    }
    pos[0] = local_pos
    out_sheet[0] = sheet
    out_row[0] = row
    out_col[0] = col
    out_row2[0] = row
    out_col2[0] = col
    out_is_range[0] = 0
    return 1
}

ParseQuotedString :: (text: const char *, pos: int *) -> Val {
    buf: [WB_TEXT_MAX * 2] char = ""
    n: int = 0
    pos[0] += 1
    while text[pos[0]] != 0 {
        ch: char = text[pos[0]]
        if ch == '"' {
            if text[pos[0] + 1] == '"' {
                if n < (int)sizeof(buf) - 1 { buf[n] = '"'; n += 1 }
                pos[0] += 2
                continue
            }
            pos[0] += 1
            return ValString(wb_strndup(buf,n))
        }
        if n < (int)sizeof(buf) - 1 { buf[n] = ch; n += 1 }
        pos[0] += 1
    }
    return ValError(ERR_VALUE)
}

TryParseError :: (text: const char *, pos: int *) -> int {
    here: int = pos[0]
    names: [8] CString = {"#DIV/0!","#VALUE!","#REF!","#NAME?","#NUM!","#N/A","#NULL!","#CYCLE!"}
    i: int = 0
    if text[here] != '#' { return -1 }
    while i < 8 {
        len: int = (int)strlen(names[i])
        if strncmp(text + here,names[i],len) == 0 {
            pos[0] = here + len
            return ErrFromText(names[i])
        }
        i += 1
    }
    return -1
}

CellToValue :: (cell: Cell *) -> Val {
    v: Val = {0}
    if cell == NULL { return ValEmpty() }
    v.kind = cell->cached_kind
    v.number = cell->cached_number
    v.text = cell->cached_kind == VAL_STRING && cell->cached_text != NULL
                 ? wb_strdup(cell->cached_text)
                 : NULL
    v.err = cell->cached_err
    v.from_range = 0
    return v
}

EvaluateCell :: (st: EvalState *, sheet: Sheet *, row: int, col: int) -> Val {
    cell: Cell * = CellAt(sheet,row,col)
    if cell == NULL { return ValEmpty() }
    if cell->kind != CELL_FORMULA { return CellToValue(cell) }
    if cell->evaluating { return ValError(ERR_CYCLE) }
    if cell->computed {
        v: Val = {cell->cached_kind,cell->cached_number,NULL,cell->cached_err,0}
        if v.kind == VAL_STRING && cell->cached_text != NULL {
            v.text = wb_strdup(cell->cached_text)
        }
        return v
    }
    if st->depth >= WB_DEPTH_MAX { return ValError(ERR_CYCLE) }
    cell->evaluating = 1
    pos: int = 0
    inner: EvalState = {st->wb,sheet,st->depth + 1,st->args,st->marks,st->group_cols,st->arg_count,st->args_overflow,0,st->this_row,st->this_col,st->last_cols,st->call_group_cols,st->refs,st->call_refs,0,0,0,0,0}
    result: Val = EvalExpression(&inner,cell->text + 1,&pos)
    SkipFormulaSpace(cell->text + 1,&pos)
    if cell->text[1 + pos] != 0 { result = ValError(ERR_VALUE) }
    wb_free_val(cell)
    if result.kind == VAL_STRING {
        cell->cached_kind = VAL_STRING
        cell->cached_text = result.text != NULL ? result.text : wb_strdup("")
        cell->cached_number = 0
        cell->cached_err = 0
    }
else {
        cell->cached_kind = result.kind
        cell->cached_number = result.number
        cell->cached_text = NULL
        cell->cached_err = result.err
    }
    cell->computed = 1
    cell->evaluating = 0
    {
        v2: Val = {cell->cached_kind,cell->cached_number,NULL,cell->cached_err,0}
        if v2.kind == VAL_STRING && cell->cached_text != NULL {
            v2.text = wb_strdup(cell->cached_text)
        }
        return v2
    }
}

RangeToValues :: (st: EvalState *, sheet: Sheet *, row: int, col: int, row2: int, col2: int) -> Val {
    v: Val = {VAL_RANGE,0.0,NULL,0,1}
    if row2 < row { swap: int = row; row = row2; row2 = swap }
    if col2 < col { swap: int = col; col = col2; col2 = swap }
    st->last_cols = col2 - col + 1
    st->pend_kind = 2
    st->pend_row = row
    st->pend_col = col
    st->pend_row2 = row2
    st->pend_col2 = col2
    if row2 < -1 + 0 { return v }
    r: int = row
    while r <= row2 {
        c: int = col
        while c <= col2 {
            cell: Cell * = CellAt(sheet,r,c)
            if cell != NULL {
                one: Val = EvaluateCell(st,sheet,r,c)
                one.from_range = 1
                EvalPush(st,one)
            }
else {
                empty: Val = {VAL_EMPTY,0.0,NULL,0,1}
                EvalPush(st,empty)
            }
            c += 1
        }
        r += 1
    }
    return v
}


EvalFunction :: (st: EvalState *, text: const char *, pos: int *, name: const char *, name_len: int) -> Val {
    base: int = st->arg_count
    lower: [64] char = ""
    if name_len >= (int)sizeof(lower) { pos[0] += 1; return ValError(ERR_NAME) }
    i: int = 0
    while i < name_len {
        lower[i] = (char)tolower((unsigned char)name[i])
        i += 1
    }
    lower[name_len] = 0
    pos[0] += 1
    SkipFormulaSpace(text,pos)
    if text[pos[0]] != ')' {
        while 1 {
            arg_pos: int = pos[0]
            arg_slot: int = st->arg_count
            st->pend_kind = 0
            one: Val = EvalExpression(st,text,&arg_pos)
            if one.kind == VAL_ERROR && arg_pos == pos[0] && (text[arg_pos] == ',' || text[arg_pos] == ')') {
                one = ValEmpty()
            }
            if one.kind == VAL_RANGE {
                ValFree(&one)
                if arg_slot < WB_ARGS_MAX {
                    st->group_cols[arg_slot] = st->last_cols
                }
            }
else {
                st->arg_count = arg_slot
                EvalPush(st,one)
            }
            if st->pend_kind != 0 && arg_slot < WB_ARGS_MAX {
                st->refs[arg_slot].kind = st->pend_kind
                st->refs[arg_slot].row = st->pend_row
                st->refs[arg_slot].col = st->pend_col
                st->refs[arg_slot].row2 = st->pend_row2
                st->refs[arg_slot].col2 = st->pend_col2
            }
            if st->arg_count > arg_slot && arg_slot < WB_ARGS_MAX {
                st->marks[arg_slot] = 1
            }
            SkipFormulaSpace(text,&arg_pos)
            if text[arg_pos] != ',' { pos[0] = arg_pos; break }
            arg_pos += 1
            pos[0] = arg_pos
        }
    }
    if text[pos[0]] != ')' { return ValError(ERR_VALUE) }
    pos[0] += 1
    st->call_group_cols = st->group_cols + base
    st->call_refs = st->refs + base
    st->pend_kind = 0
    result: Val = CallFunction(st,lower,st->args + base,st->arg_count - base,st->marks + base)
    i2: int = base
    while i2 < st->arg_count {
        ValFree(&st->args[i2])
        i2 += 1
    }
    st->arg_count = base
    return result
}

EvalFactor :: (st: EvalState *, text: const char *, pos: int *) -> Val {
    SkipFormulaSpace(text,pos)
    ch: int = text[pos[0]]
    if ch == 0 { return ValError(ERR_VALUE) }
    if ch == '(' {
        pos[0] += 1
        v: Val = EvalExpression(st,text,pos)
        SkipFormulaSpace(text,pos)
        if text[pos[0]] != ')' { ValFree(&v); return ValError(ERR_VALUE) }
        pos[0] += 1
        return v
    }
    if ch == '"' {
        return ParseQuotedString(text,pos)
    }
    if ch == '-' || ch == '+' {
        return EvalUnary(st,text,pos)
    }
    err: int = TryParseError(text,pos)
    if err >= 0 { return ValError(err) }
    if ch >= '0' && ch <= '9' {
        end: char * = NULL
        value: double = strtod(text + pos[0],&end)
        pos[0] += (int)(end - (text + pos[0]))
        return ValNumber(value)
    }
    if (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') || ch == '$' || ch == '\'' {
        row: int = 0
        col: int = 0
        row2: int = 0
        col2: int = 0
        sheet: Sheet * = NULL
        is_range: int = 0
        save: int = pos[0]
        if TryParseReference(st,text,pos,&row,&col,&row2,&col2,&sheet,&is_range) {
            if (is_range) {
                return RangeToValues(st,sheet,row,col,row2,col2)
            }
            st->pend_kind = 1
            st->pend_row = row
            st->pend_col = col
            st->pend_row2 = row
            st->pend_col2 = col
            return EvaluateCell(st,sheet,row,col)
        }
        pos[0] = save
        endpos: int = pos[0]
        while IdentChar(text[endpos]) { endpos += 1 }
        if endpos == pos[0] { return ValError(ERR_VALUE) }
        name_len: int = endpos - pos[0]
        while text[endpos] == ' ' { endpos += 1 }
        if text[endpos] == '(' {
            call: Val = EvalFunction(st,text,&endpos,text + pos[0],name_len)
            pos[0] = endpos
            return call
        }
        if name_len == 4 && strncasecmp(text + pos[0],"TRUE",4) == 0 {
            pos[0] += 4
            return ValBool(1)
        }
        if name_len == 5 && strncasecmp(text + pos[0],"FALSE",5) == 0 {
            pos[0] += 5
            return ValBool(0)
        }
        pos[0] = endpos
        return ValError(ERR_NAME)
    }
    return ValError(ERR_VALUE)
}

EvalPostfix :: (st: EvalState *, text: const char *, pos: int *) -> Val {
    v: Val = EvalFactor(st,text,pos)
    while v.kind != VAL_ERROR {
        SkipFormulaSpace(text,pos)
        if text[pos[0]] != '%' { break }
        pos[0] += 1
        n: double = CoerceNumber(&v)
        if n >= 1e307 { ValFree(&v); return ValError(ERR_VALUE) }
        ValFree(&v)
        st->pend_kind = 0
        v = ValNumber(n / 100.0)
    }
    return v
}

EvalUnary :: (st: EvalState *, text: const char *, pos: int *) -> Val {
    SkipFormulaSpace(text,pos)
    if text[pos[0]] == '-' {
        pos[0] += 1
        operand: Val = EvalUnary(st,text,pos)
        if operand.kind == VAL_ERROR { return operand }
        n: double = CoerceNumber(&operand)
        if n >= 1e307 { ValFree(&operand); return ValError(ERR_VALUE) }
        ValFree(&operand)
        st->pend_kind = 0
        return ValNumber(-n)
    }
    if text[pos[0]] == '+' {
        pos[0] += 1
        return EvalUnary(st,text,pos)
    }
    return EvalPostfix(st,text,pos)
}

EvalPower :: (st: EvalState *, text: const char *, pos: int *) -> Val {
    left: Val = EvalUnary(st,text,pos)
    while left.kind != VAL_ERROR {
        SkipFormulaSpace(text,pos)
        if text[pos[0]] != '^' { break }
        pos[0] += 1
        right: Val = EvalUnary(st,text,pos)
        if right.kind == VAL_ERROR { ValFree(&left); return right }
        a: double = CoerceNumber(&left)
        b: double = CoerceNumber(&right)
        ValFree(&left)
        ValFree(&right)
        if a >= 1e307 || b >= 1e307 { return ValError(ERR_VALUE) }
        r: double = pow(a,b)
        if r != r { return ValError(ERR_NUM) }
        st->pend_kind = 0
        left = ValNumber(r)
    }
    return left
}

EvalMul :: (st: EvalState *, text: const char *, pos: int *) -> Val {
    left: Val = EvalPower(st,text,pos)
    while left.kind != VAL_ERROR {
        SkipFormulaSpace(text,pos)
        op: int = text[pos[0]]
        if op != '*' && op != '/' { break }
        pos[0] += 1
        right: Val = EvalPower(st,text,pos)
        if right.kind == VAL_ERROR { ValFree(&left); return right }
        a: double = CoerceNumber(&left)
        b: double = CoerceNumber(&right)
        ValFree(&left)
        ValFree(&right)
        if a >= 1e307 || b >= 1e307 { return ValError(ERR_VALUE) }
        st->pend_kind = 0
        if op == '*' {
            left = ValNumber(a * b)
        }
else {
            if b == 0 { return ValError(ERR_DIV0) }
            left = ValNumber(a / b)
        }
    }
    return left
}

EvalAdd :: (st: EvalState *, text: const char *, pos: int *) -> Val {
    left: Val = EvalMul(st,text,pos)
    while left.kind != VAL_ERROR {
        SkipFormulaSpace(text,pos)
        op: int = text[pos[0]]
        if op != '+' && op != '-' { break }
        pos[0] += 1
        right: Val = EvalMul(st,text,pos)
        if right.kind == VAL_ERROR { ValFree(&left); return right }
        a: double = CoerceNumber(&left)
        b: double = CoerceNumber(&right)
        ValFree(&left)
        ValFree(&right)
        if a >= 1e307 || b >= 1e307 { return ValError(ERR_VALUE) }
        st->pend_kind = 0
        if op == '+' { left = ValNumber(a + b) }
        else { left = ValNumber(a - b) }
    }
    return left
}

EvalConcat :: (st: EvalState *, text: const char *, pos: int *) -> Val {
    left: Val = EvalAdd(st,text,pos)
    while left.kind != VAL_ERROR {
        SkipFormulaSpace(text,pos)
        if text[pos[0]] != '&' { break }
        pos[0] += 1
        right: Val = EvalAdd(st,text,pos)
        if right.kind == VAL_ERROR { ValFree(&left); return right }
        a: [WB_TEXT_MAX * 2] char = ""
        b: [WB_TEXT_MAX * 2] char = ""
        joined: [WB_TEXT_MAX * 4] char = ""
        CoerceText(&left,a,sizeof(a))
        CoerceText(&right,b,sizeof(b))
        snprintf(joined,sizeof(joined),"%s%s",a,b)
        ValFree(&left)
        ValFree(&right)
        st->pend_kind = 0
        left = ValString(wb_strdup(joined))
    }
    return left
}

EvalCompare :: (st: EvalState *, text: const char *, pos: int *) -> Val {
    left: Val = EvalConcat(st,text,pos)
    while left.kind != VAL_ERROR {
        SkipFormulaSpace(text,pos)
        op: int = 0
        if text[pos[0]] == '=' { op = 1 }
        else if text[pos[0]] == '<' && text[pos[0] + 1] == '>' { op = 2 }
        else if text[pos[0]] == '<' && text[pos[0] + 1] == '=' { op = 3 }
        else if text[pos[0]] == '>' && text[pos[0] + 1] == '=' { op = 4 }
        else if text[pos[0]] == '<' { op = 5 }
        else if text[pos[0]] == '>' { op = 6 }
        if op == 0 { break }
        if op == 1 || op == 5 || op == 6 {
            pos[0] += 1
        }
else {
            pos[0] += 2
        }
        right: Val = EvalConcat(st,text,pos)
        if right.kind == VAL_ERROR { ValFree(&left); return right }
        if left.kind == VAL_ERROR { ValFree(&right); return left }
        cmp: int = CompareVals(&left,&right)
        ValFree(&left)
        ValFree(&right)
        if cmp == -2 { return ValError(ERR_VALUE) }
        truth: int = 0
        if op == 1 { truth = cmp == 0 }
        else if op == 2 { truth = cmp != 0 }
        else if op == 3 { truth = cmp <= 0 }
        else if op == 4 { truth = cmp >= 0 }
        else if op == 5 { truth = cmp < 0 }
        else { truth = cmp > 0 }
        st->pend_kind = 0
        left = ValBool(truth)
    }
    return left
}

EvalExpression :: (st: EvalState *, text: const char *, pos: int *) -> Val {
    return EvalCompare(st,text,pos)
}

WbCellValueText :: (v: Val *, out: char *, cap: int) {
    if v->kind == VAL_ERROR { snprintf(out,cap,"%s",ErrText(v->err)); return }
    if v->kind == VAL_BOOL { snprintf(out,cap,"%s",v->number != 0 ? "TRUE" : "FALSE"); return }
    if v->kind == VAL_FLOAT { FormatNumber(v->number,out,cap); return }
    if v->kind == VAL_STRING { snprintf(out,cap,"%s",v->text != NULL ? v->text : ""); return }
    out[0] = 0
}

SerialToDateText :: (serial: int, out: char *, cap: int) {
    days: int = serial + SerialEpoch()
    y: int = 0
    m: int = 0
    d: int = 0
    if serial < 61 { days = serial + 1 + SerialEpoch() }
    CivilFromDays(days,&y,&m,&d)
    snprintf(out,cap,"%04d/%02d/%02d",y,m,d)
}

SerialToTimeText :: (frac: double, out: char *, cap: int) {
    seconds: int = (int)(frac * 86400.0 + 0.5)
    while seconds < 0 { seconds += 86400 }
    seconds = seconds % 86400
    snprintf(out,cap,"%02d:%02d:%02d",seconds / 3600,(seconds / 60) % 60,seconds % 60)
}

CellDisplayText :: (cell: Cell *, out: char *, cap: int) {
    v: Val = {cell->cached_kind,cell->cached_number,cell->cached_text,cell->cached_err,0}
    if cell->cached_kind == VAL_FLOAT && cell->hint == 1 {
        SerialToDateText((int)cell->cached_number,out,cap)
        return
    }
    if cell->cached_kind == VAL_FLOAT && cell->hint == 2 {
        SerialToTimeText(cell->cached_number,out,cap)
        return
    }
    WbCellValueText(&v,out,cap)
}

EvaluateOne :: (wb: Workbook *, sheet: Sheet *, cell: Cell *, args: Val *, marks: int *, group_cols: int *, refs: SlotRef *) {
    st: EvalState = {wb,sheet,0,args,marks,group_cols,0,0,0,CellKeyRow(cell->key),CellKeyCol(cell->key),0,NULL,refs,refs,0,0,0,0,0}
    pos: int = 0
    if cell->computed { return }
    result: Val = EvalExpression(&st,cell->text + 1,&pos)
    SkipFormulaSpace(cell->text + 1,&pos)
    if cell->text[1 + pos] != 0 { result = ValError(ERR_VALUE) }
    wb_free_val(cell)
    if result.kind == VAL_STRING {
        cell->cached_kind = VAL_STRING
        cell->cached_text = result.text != NULL ? result.text : wb_strdup("")
        cell->cached_number = 0
        cell->cached_err = 0
    }
else {
        cell->cached_kind = result.kind
        cell->cached_number = result.number
        cell->cached_text = NULL
        cell->cached_err = result.err
        cell->hint = st.hint
    }
    cell->computed = 1
}

EvaluateSheet :: (wb: Workbook *, sheet: Sheet *) {
    pass: int = 0
    changed: int = 1
    args: Val * = malloc(sizeof(Val) * WB_ARGS_MAX)
    marks: int * = malloc(sizeof(int) * WB_ARGS_MAX)
    group_cols: int * = malloc(sizeof(int) * WB_ARGS_MAX)
    refs: SlotRef * = malloc(sizeof(SlotRef) * WB_ARGS_MAX)
    if args == NULL || marks == NULL || group_cols == NULL || refs == NULL { free(args); free(marks); free(group_cols); free(refs); return }
    while changed && pass < 100 {
        i: int = 0
        changed = 0
        while i < sheet->cell_count {
            cell: Cell * = &sheet->cells[i]
            if cell->kind == CELL_FORMULA && cell->text != NULL && cell->text[0] == '=' && cell->text[1] != 0 {
                before: [WB_TEXT_MAX] char = ""
                after: [WB_TEXT_MAX] char = ""
                v_before: Val = {cell->cached_kind,cell->cached_number,cell->cached_text,cell->cached_err,0}
                WbCellValueText(&v_before,before,sizeof(before))
                cell->computed = 0
                EvaluateOne(wb,sheet,cell,args,marks,group_cols,refs)
                v_after: Val = {cell->cached_kind,cell->cached_number,cell->cached_text,cell->cached_err,0}
                WbCellValueText(&v_after,after,sizeof(after))
                if strcmp(before,after) != 0 { changed = 1 }
            }
            i += 1
        }
        pass += 1
    }
    free(args)
    free(marks)
    free(group_cols)
    free(refs)
}

SheetInsertRow :: (sheet: Sheet *, at_row: int) -> int {
    i: int = sheet->cell_count - 1
    moved: int = 0
    while i >= 0 {
        row: int = CellKeyRow(sheet->cells[i].key)
        col: int = CellKeyCol(sheet->cells[i].key)
        if row >= at_row {
            if row + 1 >= WB_MAX_ROWS { return moved }
            sheet->cells[i].key = CellKey(row + 1,col)
            moved += 1
        }
        i -= 1
    }
    SheetExtent(sheet)
    return moved
}

SheetDeleteRow :: (sheet: Sheet *, at_row: int) -> int {
    write: int = 0
    read: int = 0
    removed: int = 0
    while read < sheet->cell_count {
        row: int = CellKeyRow(sheet->cells[read].key)
        col: int = CellKeyCol(sheet->cells[read].key)
        if row == at_row {
            free((void *)sheet->cells[read].text)
            free((void *)sheet->cells[read].cached_text)
            free((void *)sheet->cells[read].serialized)
            removed += 1
        }
else {
            if row > at_row { sheet->cells[read].key = CellKey(row - 1,col) }
            if write != read { sheet->cells[write] = sheet->cells[read] }
            write += 1
        }
        read += 1
    }
    sheet->cell_count = write
    SheetExtent(sheet)
    return removed
}

SheetInsertColumn :: (sheet: Sheet *, at_col: int) -> int {
    i: int = sheet->cell_count - 1
    moved: int = 0
    while i >= 0 {
        row: int = CellKeyRow(sheet->cells[i].key)
        col: int = CellKeyCol(sheet->cells[i].key)
        if col >= at_col {
            if col + 1 >= WB_MAX_COLS { return moved }
            sheet->cells[i].key = CellKey(row,col + 1)
            moved += 1
        }
        i -= 1
    }
    SheetExtent(sheet)
    return moved
}

SheetDeleteColumn :: (sheet: Sheet *, at_col: int) -> int {
    write: int = 0
    read: int = 0
    removed: int = 0
    while read < sheet->cell_count {
        row: int = CellKeyRow(sheet->cells[read].key)
        col: int = CellKeyCol(sheet->cells[read].key)
        if col == at_col {
            free((void *)sheet->cells[read].text)
            free((void *)sheet->cells[read].cached_text)
            free((void *)sheet->cells[read].serialized)
            removed += 1
        }
else {
            if col > at_col { sheet->cells[read].key = CellKey(row,col - 1) }
            if write != read { sheet->cells[write] = sheet->cells[read] }
            write += 1
        }
        read += 1
    }
    sheet->cell_count = write
    SheetExtent(sheet)
    return removed
}

WorkbookInsertRow :: (wb: Workbook *, sheet_index: int, row: int) -> int {
    if sheet_index < 0 || sheet_index >= wb->sheet_count { return 0 }
    return SheetInsertRow(&wb->sheets[sheet_index],row)
}

WorkbookDeleteRow :: (wb: Workbook *, sheet_index: int, row: int) -> int {
    if sheet_index < 0 || sheet_index >= wb->sheet_count { return 0 }
    return SheetDeleteRow(&wb->sheets[sheet_index],row)
}

WorkbookInsertColumn :: (wb: Workbook *, sheet_index: int, col: int) -> int {
    if sheet_index < 0 || sheet_index >= wb->sheet_count { return 0 }
    return SheetInsertColumn(&wb->sheets[sheet_index],col)
}

WorkbookDeleteColumn :: (wb: Workbook *, sheet_index: int, col: int) -> int {
    if sheet_index < 0 || sheet_index >= wb->sheet_count { return 0 }
    return SheetDeleteColumn(&wb->sheets[sheet_index],col)
}

WorkbookEvaluate :: (wb: Workbook *) {
    i: int = 0
    while i < wb->sheet_count {
        EvaluateSheet(wb,&wb->sheets[i])
        i += 1
    }
}

NumList :: struct {
    data: [4096] double
    count: int
    saw_error: int
}

CollectNumbers :: (args: Val *, count: int, out: NumList *) {
    i: int = 0
    while i < count {
        v: Val * = &args[i]
        if v->kind == VAL_ERROR { out->saw_error = 1 }
        else if v->kind == VAL_FLOAT {
            if out->count < 4096 { out->data[out->count] = v->number; out->count += 1 }
        }
else if v->kind == VAL_STRING && !v->from_range && TextLooksNumeric(v->text) {
            if out->count < 4096 { out->data[out->count] = strtod(v->text,NULL); out->count += 1 }
        }
        i += 1
    }
}

FirstError :: (args: Val *, count: int) -> Val {
    i: int = 0
    while i < count {
        if args[i].kind == VAL_ERROR { return ValError(args[i].err) }
        i += 1
    }
    return ValError(ERR_VALUE)
}

ArgNumberAt :: (args: Val *, count: int, index: int) -> double {
    if index >= count { return 1e308 }
    if args[index].kind == VAL_ERROR { return 1e308 }
    return CoerceNumber(&args[index])
}


FnRowColumn :: (st: EvalState *, args: Val *, count: int, marks: int *, want_row: int) -> Val {
    if count == 0 {
        if want_row { return ValNumber(st->this_row + 1) }
        return ValNumber(st->this_col + 1)
    }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if want_row { return ValNumber(st->this_row + 1) }
    return ValNumber(st->this_col + 1)
}

FnRowsColumns :: (st: EvalState *, args: Val *, count: int, marks: int *, want_rows: int) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if want_rows { return ValNumber(count) }
    ncols: int = st->call_group_cols[0]
    if ncols < 1 { ncols = 1 }
    return ValNumber(ncols)
}

FnSumProduct :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    groups: int = ArgGroupCount(args,marks,count)
    start: int = 0
    len: int = 0
    total: double = 0
    i: int = 0
    if groups < 1 { return ValError(ERR_VALUE) }
    GroupBounds(marks,count,0,&start,&len)
    i = 0
    while i < len {
        product: double = 1
        g: int = 0
        while g < groups {
            gstart: int = 0
            glen: int = 0
            v: Val * = NULL
            GroupBounds(marks,count,g,&gstart,&glen)
            v = &args[gstart + (i < glen ? i : 0)]
            if v->kind == VAL_ERROR { return ValError(v->err) }
            if v->kind == VAL_FLOAT {
                product *= v->number
            }
else {
                product *= 0
            }
            g += 1
        }
        total += product
        i += 1
    }
    return ValNumber(total)
}

ValTextEquals :: (a: Val *, b: Val *) -> int {
    ta: [WB_TEXT_MAX] char = ""
    tb: [WB_TEXT_MAX] char = ""
    if a->kind == VAL_ERROR || b->kind == VAL_ERROR { return 0 }
    CoerceText(a,ta,sizeof(ta))
    CoerceText(b,tb,sizeof(tb))
    return strcasecmp(ta,tb) == 0
}

FnVlookupHlookup :: (st: EvalState *, args: Val *, count: int, marks: int *, vertical: int) -> Val {
    groups: int = ArgGroupCount(args,marks,count)
    needle: Val * = NULL
    table_start: int = 0
    table_len: int = 0
    index: double = 0
    lookup_col: int = 0
    i: int = 0
    if groups < 3 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    needle = &args[0]
    GroupBounds(marks,count,1,&table_start,&table_len)
    index = CoerceNumber(&args[table_start + table_len])
    if index < 1 { return ValError(ERR_VALUE) }
    lookup_col = (int)index - 1
    if table_len == 0 { return ValError(ERR_REF) }
    ncols: int = st->call_group_cols[table_start]
    if ncols < 1 { ncols = 1 }
    if vertical {
        stride: int = ncols
        table_rows: int = table_len / stride
        i = 0
        while i < table_rows {
            first: Val * = &args[table_start + i * stride]
            if first->kind == VAL_ERROR { return ValError(first->err) }
            hit: int = 0
            if needle->kind == VAL_STRING && first->kind == VAL_STRING {
                hit = strcasecmp(needle->text,first->text) == 0
            }
else if needle->kind == VAL_FLOAT && first->kind == VAL_FLOAT {
                hit = needle->number == first->number
            }
else if needle->kind == VAL_BOOL && first->kind == VAL_BOOL {
                hit = needle->number == first->number
            }
            if hit {
                target: int = table_start + i * stride + lookup_col
                if target < table_start + table_len {
                    return ValCopy(&args[target])
                }
                return ValError(ERR_REF)
            }
            i += 1
        }
        approximate: int = 1
        if groups >= 4 {
            flagarg: int = 0
            flen: int = 0
            GroupBounds(marks,count,3,&flagarg,&flen)
            if flen == 1 {
                approximate = CoerceBool(&args[flagarg]) != 0
            }
        }
        if approximate {
            best: int = -1
            i = 0
            while i < table_rows {
                first: Val * = &args[table_start + i * stride]
                below: int = 0
                if first->kind == VAL_STRING && needle->kind == VAL_STRING {
                    below = strcasecmp(first->text,needle->text) <= 0
                }
else if first->kind == VAL_FLOAT && needle->kind == VAL_FLOAT {
                    below = first->number <= needle->number
                }
                if below { best = i }
                i += 1
            }
            if best >= 0 {
                target: int = table_start + best * stride + lookup_col
                if target < table_start + table_len {
                    return ValCopy(&args[target])
                }
            }
        }
        return ValError(ERR_NA)
    }
    return ValError(ERR_NA)
}

FnMatch :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    groups: int = ArgGroupCount(args,marks,count)
    needle: Val * = NULL
    start: int = 0
    len: int = 0
    i: int = 0
    if groups < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    needle = &args[0]
    GroupBounds(marks,count,1,&start,&len)
    i = 0
    while i < len {
        v: Val * = &args[start + i]
        if v->kind == VAL_ERROR { return ValError(v->err) }
        hit: int = 0
        if needle->kind == VAL_STRING && v->kind == VAL_STRING {
            hit = strcasecmp(needle->text,v->text) == 0
        }
else if needle->kind == VAL_FLOAT && v->kind == VAL_FLOAT {
            hit = needle->number == v->number
        }
else if needle->kind == VAL_BOOL && v->kind == VAL_BOOL {
            hit = needle->number == v->number
        }
        if hit { return ValNumber(i + 1) }
        i += 1
    }
    return ValError(ERR_NA)
}

FnIndex :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    groups: int = ArgGroupCount(args,marks,count)
    start: int = 0
    len: int = 0
    row: double = 0
    col: double = 0
    if groups < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    GroupBounds(marks,count,0,&start,&len)
    row = CoerceNumber(&args[count - 2])
    if count >= 3 {
        col = CoerceNumber(&args[count - 1])
    }
else {
        col = 1
    }
    if row < 1 || col < 1 { return ValError(ERR_VALUE) }
    if groups >= 3 {
        ncols: int = st->call_group_cols[start]
        if ncols < 1 { ncols = 1 }
        idx: int = (int)((row - 1) * ncols + (col - 1))
        if idx >= len { return ValError(ERR_REF) }
        return ValCopy(&args[start + idx])
    }
    if (int)row > len { return ValError(ERR_REF) }
    return ValCopy(&args[start + (int)row - 1])
}

FnGeomean :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    total: double = 0
    i: int = 0
    CollectNumbers(args,count,&list)
    if list.saw_error { return FirstError(args,count) }
    if list.count == 0 { return ValError(ERR_NUM) }
    i = 0
    while i < list.count {
        if list.data[i] <= 0 { return ValError(ERR_NUM) }
        total += log(list.data[i])
        i += 1
    }
    return ValNumber(exp(total / list.count))
}

FnHarmean :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    total: double = 0
    i: int = 0
    CollectNumbers(args,count,&list)
    if list.saw_error { return FirstError(args,count) }
    if list.count == 0 { return ValError(ERR_NUM) }
    i = 0
    while i < list.count {
        if list.data[i] == 0 { return ValError(ERR_NUM) }
        total += 1.0 / list.data[i]
        i += 1
    }
    return ValNumber(list.count / total)
}

FnAvedev :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    total: double = 0
    mean: double = 0
    dev: double = 0
    i: int = 0
    CollectNumbers(args,count,&list)
    if list.saw_error { return FirstError(args,count) }
    if list.count == 0 { return ValError(ERR_NUM) }
    i = 0
    while i < list.count {
        total += list.data[i]
        i += 1
    }
    mean = total / list.count
    i = 0
    while i < list.count {
        dev += fabs(list.data[i] - mean)
        i += 1
    }
    return ValNumber(dev / list.count)
}

FnMode :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    best: double = 0
    best_count: int = 0
    i: int = 0
    CollectNumbers(args,count,&list)
    if list.saw_error { return FirstError(args,count) }
    i = 0
    while i < list.count {
        same: int = 0
        j: int = 0
        while j < list.count {
            if list.data[j] == list.data[i] { same += 1 }
            j += 1
        }
        if same > best_count {
            best_count = same
            best = list.data[i]
        }
        i += 1
    }
    if best_count < 2 { return ValError(ERR_NA) }
    return ValNumber(best)
}

FnTruncEvenOdd :: (st: EvalState *, args: Val *, count: int, marks: int *, code: int) -> Val {
    v: double = 0
    digits: double = 0
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    v = CoerceNumber(&args[0])
    if v >= 1e307 { return ValError(ERR_VALUE) }
    if code == 0 {
        if count >= 2 {
            if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
            digits = CoerceNumber(&args[1])
        }
        scale: double = pow(10.0,digits)
        return ValNumber(trunc(v * scale) / scale)
    }
    {
        away: double = v < 0 ? -v : v
        n: double = ceil(away)
        target: int = code == 1 ? 0 : 1
        if ((int)n) % 2 == target { return ValNumber(v < 0 ? -n : n) }
        n += 1
        return ValNumber(v < 0 ? -n : n)
    }
}

FnQuotient :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    a: double = 0
    b: double = 0
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
    a = CoerceNumber(&args[0])
    b = CoerceNumber(&args[1])
    if b == 0 { return ValError(ERR_DIV0) }
    return ValNumber(trunc(a / b))
}

FnProper :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    text: [WB_TEXT_MAX * 2] char = ""
    out: [WB_TEXT_MAX * 2] char = ""
    i: int = 0
    word_start: int = 1
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    while text[i] != 0 {
        is_alpha: int = isalpha((unsigned char)text[i]) != 0
        if is_alpha && word_start {
            out[i] = (char)toupper((unsigned char)text[i])
        }
else if is_alpha {
            out[i] = (char)tolower((unsigned char)text[i])
        }
else {
            out[i] = text[i]
        }
        word_start = !isalpha((unsigned char)text[i]) && text[i] != 39
        i += 1
    }
    out[i] = 0
    return ValString(wb_strdup(out))
}

FnReplace :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    text: [WB_TEXT_MAX] char = ""
    new: [WB_TEXT_MAX] char = ""
    out: [WB_TEXT_MAX * 2] char = ""
    start: double = 0
    n: double = 0
    len: int = 0
    if count < 4 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
    if args[2].kind == VAL_ERROR { return ValError(args[2].err) }
    if TextArg(args,count,3,new,sizeof(new)) < 0 { return ValError(ERR_VALUE) }
    start = CoerceNumber(&args[1])
    n = CoerceNumber(&args[2])
    len = (int)strlen(text)
    if start < 1 || n < 0 { return ValError(ERR_VALUE) }
    memcpy(out,text,(int)start - 1 < len ? (int)start - 1 : len)
    out[(int)start - 1 < len ? (int)start - 1 : len] = 0
    strcat(out,new)
    if (int)start - 1 + (int)n < len {
        strcat(out,text + (int)start - 1 + (int)n)
    }
    return ValString(wb_strdup(out))
}

FnFixed :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    decimals: double = 2
    commas: double = 1
    v: double = 0
    out: [WB_TEXT_MAX] char = ""
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    v = CoerceNumber(&args[0])
    if count >= 2 {
        if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
        decimals = CoerceNumber(&args[1])
    }
    if count >= 3 {
        if args[2].kind == VAL_ERROR { return ValError(args[2].err) }
        commas = CoerceNumber(&args[2])
    }
    if decimals < 0 { decimals = 0 }
    if decimals > 30 { decimals = 30 }
    FormatWithPattern(v,commas != 0 ? "#,##0.000000" : "0.000000",out,sizeof(out))
    return ValString(wb_strdup(out))
}

ConvertRadix :: (value: long, from_base: int, to_base: int, out: char *, cap: int) -> int {
    digits: CString = "0123456789ABCDEF"
    buf: [80] char = ""
    n: int = 0
    negative: int = value < 0
    uv: unsigned long = 0
    if negative { uv = (unsigned long)(-value) }
else { uv = (unsigned long)value }
    if value == 0 {
        snprintf(out,cap,"0")
        return 1
    }
    while uv != 0 && n < 70 {
        buf[n] = digits[uv % (unsigned long)to_base]
        uv /= (unsigned long)to_base
        n += 1
    }
    if negative && n < 70 {
        buf[n] = '-'
        n += 1
    }
    i: int = n - 1
    w: int = 0
    while i >= 0 && w + 1 < cap {
        out[w] = buf[i]
        w += 1
        i -= 1
    }
    out[w] = 0
    return 1
}

CharToDigit :: (ch: int) -> int {
    if ch >= '0' && ch <= '9' { return ch - '0' }
    if ch >= 'a' && ch <= 'f' { return ch - 'a' + 10 }
    if ch >= 'A' && ch <= 'F' { return ch - 'A' + 10 }
    return -1
}

ParseRadix :: (text: const char *, base: int) -> double {
    value: long = 0
    i: int = 0
    if text[0] == 0 { return 1e308 }
    while text[i] != 0 {
        d: int = CharToDigit((unsigned char)text[i])
        if d < 0 || d >= base { return 1e308 }
        value = value * base + d
        i += 1
    }
    return (double)value
}

FnRadixConvert :: (st: EvalState *, args: Val *, count: int, marks: int *, to_base: int) -> Val {
    text: [WB_TEXT_MAX] char = ""
    out: [80] char = ""
    v: double = 0
    if count < 1 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    v = ParseRadix(text,10)
    if v >= 1e307 { return ValError(ERR_NUM) }
    ConvertRadix((long)v,10,to_base,out,sizeof(out))
    return ValString(wb_strdup(out))
}

FnRadixParse :: (st: EvalState *, args: Val *, count: int, marks: int *, from_base: int) -> Val {
    text: [WB_TEXT_MAX] char = ""
    v: double = 0
    if count < 1 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    v = ParseRadix(text,from_base)
    if v >= 1e307 { return ValError(ERR_NUM) }
    return ValNumber(v)
}



IsLeapYear :: (y: int) -> int {
    return (y % 4 == 0 && y % 100 != 0) || y % 400 == 0
}

DaysInYear :: (y: int) -> int {
    if IsLeapYear(y) { return 366 }
    return 365
}

SerialToYmd :: (serial: int, y: int *, m: int *, d: int *) {
    CivilFromDays(serial + SerialEpoch(),y,m,d)
}

YmdToSerial :: (y: int, m: int, d: int) -> int {
    return DaysFromCivil(y,m,d) - SerialEpoch()
}

MonthAdd :: (y: int, m: int, months: int, out_y: int *, out_m: int *) {
    total: int = y * 12 + (m - 1) + months
    out_y[0] = total / 12
    out_m[0] = total % 12 + 1
}

DaysInMonthGo :: (y: int, m: int) -> int {
    if m == 4 || m == 6 || m == 9 || m == 11 { return 30 }
    if m == 2 {
        if IsLeapYear(y) { return 29 }
        return 28
    }
    return 31
}

IsLastOfMonth :: (y: int, m: int, d: int) -> int {
    if d == DaysInMonthGo(y,m) { return 1 }
    return 0
}

Days30_360 :: (s1: int, s2: int) -> int {
    y1: int = 0
    m1: int = 0
    d1: int = 0
    y2: int = 0
    m2: int = 0
    d2: int = 0
    SerialToYmd(s1,&y1,&m1,&d1)
    SerialToYmd(s2,&y2,&m2,&d2)
    if (d1 == d2 && m1 == m2 && y1 == y2) { return 0 }
    if d1 == 31 { d1 = 30 }
    if (d2 == 31 && d1 == 30) { d2 = 30 }
    if (m1 == 2 && IsLastOfMonth(y1,m1,d1) != 0) {
        if (m2 == 2 && IsLastOfMonth(y2,m2,d2) != 0) { d2 = 30 }
        d1 = 30
    }
    return (y2 - y1) * 360 + (m2 - m1) * 30 + (d2 - d1)
}

Days30E :: (s1: int, s2: int) -> int {
    y1: int = 0
    m1: int = 0
    d1: int = 0
    y2: int = 0
    m2: int = 0
    d2: int = 0
    SerialToYmd(s1,&y1,&m1,&d1)
    SerialToYmd(s2,&y2,&m2,&d2)
    if d1 == 31 { d1 = 30 }
    if d2 == 31 { d2 = 30 }
    return (y2 - y1) * 360 + (m2 - m1) * 30 + (d2 - d1)
}

BasisDaysBetween :: (s1: int, s2: int, basis: int) -> int {
    sign: int = 1
    f: int = s1
    t: int = s2
    if f > t {
        sign = -1
        f = s2
        t = s1
    }
    if (basis == 1 || basis == 2 || basis == 3) { return sign * (t - f) }
    if basis == 4 { return sign * Days30E(f,t) }
    return sign * Days30_360(f,t)
}

AddMonthsSerial :: (serial: int, n: int) -> int {
    y: int = 0
    m: int = 0
    d: int = 0
    ny: int = 0
    nm: int = 0
    SerialToYmd(serial,&y,&m,&d)
    MonthAdd(y,m,n,&ny,&nm)
    nd: int = d
    if (nd > DaysInMonthGo(ny,nm)) { nd = DaysInMonthGo(ny,nm) }
    return YmdToSerial(ny,nm,nd)
}

AddYearsSerial :: (serial: int, n: int) -> int {
    y: int = 0
    m: int = 0
    d: int = 0
    SerialToYmd(serial,&y,&m,&d)
    nd: int = d
    if (m == 2 && nd == 29 && IsLeapYear(y + n) == 0) { nd = 28 }
    return YmdToSerial(y + n,m,nd)
}

YearFracBasis :: (s1: int, s2: int, basis: int) -> double {
    from_s: int = s1
    to_s: int = s2
    days: int = BasisDaysBetween(from_s,to_s,basis)
    if days < 0 {
        from_s = s2
        to_s = s1
        days = -days
    }
    if basis == 1 {
        y1: int = 0
        m1: int = 0
        d1: int = 0
        y2: int = 0
        m2: int = 0
        d2: int = 0
        SerialToYmd(from_s,&y1,&m1,&d1)
        SerialToYmd(to_s,&y2,&m2,&d2)
        plus1: int = AddYearsSerial(from_s,1)
        feb29s: int = 0
        years: int = 1
        if to_s > plus1 {
            years = y2 + 1 - y1
            j1: int = YmdToSerial(y1,1,1)
            j2: int = YmdToSerial(y2 + 1,1,1)
            feb29s = j2 - j1 - 365 * years
        }
else {
            if ((IsLeapYear(y1) != 0 && m1 < 3) || (IsLeapYear(y2) != 0 && (m2 * 256 + d2 >= 2 * 256 + 29))) {
                feb29s = 1
            }
else {
                feb29s = 0
            }
        }
        peryear: double = 365 + (double)feb29s / (double)years
        return (double)days / peryear
    }
    if basis == 3 { return (double)days / 365.0 }
    return (double)days / 360.0
}

ArgAt :: (args: Val *, count: int, index: int, fallback: double) -> double {
    if index >= count { return fallback }
    if args[index].kind == VAL_ERROR { return 1e308 }
    n: double = CoerceNumber(&args[index])
    return n
}

ArgAtInt :: (args: Val *, count: int, index: int, fallback: int) -> int {
    v: double = ArgAt(args,count,index,(double)fallback)
    if v >= 1e307 { return fallback }
    return (int)v
}

ArgDate :: (args: Val *, count: int, index: int, fallback: int) -> int {
    v: double = ArgAt(args,count,index,(double)fallback)
    if v >= 1e307 { return fallback }
    return (int)v
}

ArgBasis :: (args: Val *, count: int, index: int) -> int {
    b: int = ArgAtInt(args,count,index,0)
    if b < 0 || b > 4 { return -1 }
    return b
}

FinPower :: (base: double, e: double) -> double {
    return pow(base,e)
}


