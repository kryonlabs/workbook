    if strcmp(name,"cosh") == 0 { return FnMathOne(st,args,count,marks,15) }
    if strcmp(name,"tanh") == 0 { return FnMathOne(st,args,count,marks,16) }
    if strcmp(name,"power") == 0 { return FnPower(st,args,count,marks) }
    if strcmp(name,"atan2") == 0 { return FnAtan2(st,args,count,marks) }
    if strcmp(name,"fact") == 0 { return FnFact(st,args,count,marks) }
    if strcmp(name,"factdouble") == 0 { return FnFactDouble(st,args,count,marks) }
    if strcmp(name,"gcd") == 0 { return FnGcd(st,args,count,marks) }
    if strcmp(name,"lcm") == 0 { return FnLcm(st,args,count,marks) }
    if strcmp(name,"combin") == 0 { return FnCombin(st,args,count,marks,0) }
    if strcmp(name,"combina") == 0 { return FnCombin(st,args,count,marks,1) }
    if strcmp(name,"degrees") == 0 { return FnDegreesRadians(st,args,count,marks,1) }
    if strcmp(name,"radians") == 0 { return FnDegreesRadians(st,args,count,marks,0) }
    if strcmp(name,"pi") == 0 { return ValNumber(3.14159265358979323846) }
    if strcmp(name,"choose") == 0 { return FnChoose(st,args,count,marks) }
    if strcmp(name,"address") == 0 { return FnAddress(st,args,count,marks) }
    if strcmp(name,"areas") == 0 { return FnAreas(st,args,count,marks) }
    if strcmp(name,"indirect") == 0 { return FnIndirect(st,args,count,marks) }
    if strcmp(name,"offset") == 0 { return FnOffset(st,args,count,marks) }
    if strcmp(name,"hyperlink") == 0 { return FnHyperlink(st,args,count,marks) }
    if strcmp(name,"isref") == 0 { return FnIsref(st,args,count,marks) }
    if strcmp(name,"columnnumber") == 0 { return FnColumnnumber(st,args,count,marks) }
    if strcmp(name,"sumif") == 0 { return FnSumIf(st,args,count,marks,0) }
    if strcmp(name,"sumifs") == 0 { return FnIfs(st,args,count,marks,1) }
    if strcmp(name,"averageifs") == 0 { return FnIfs(st,args,count,marks,2) }
    if strcmp(name,"countifs") == 0 { return FnIfs(st,args,count,marks,0) }
    if strcmp(name,"maxifs") == 0 { return FnIfs(st,args,count,marks,3) }
    if strcmp(name,"minifs") == 0 { return FnIfs(st,args,count,marks,4) }
    if strcmp(name,"suma") == 0 { return FnSumA(st,args,count,marks) }
    if strcmp(name,"prob") == 0 { return FnProb(st,args,count,marks) }
    if strcmp(name,"subtotal") == 0 { return FnSubtotal(st,args,count,marks) }
    if strcmp(name,"ssmedian") == 0 { return FnSsMedian(st,args,count,marks) }
    if strcmp(name,"mmult") == 0 { return FnMmult(st,args,count,marks) }
    if strcmp(name,"mdeterm") == 0 { return FnMdeterm(st,args,count,marks) }
    if strcmp(name,"minverse") == 0 { return FnMinverse(st,args,count,marks) }
    if strcmp(name,"linsolve") == 0 { return FnLinsolve(st,args,count,marks) }
    if strcmp(name,"transpose") == 0 { return FnTranspose(st,args,count,marks) }
    if strcmp(name,"munit") == 0 { return FnMunit(st,args,count,marks) }
    if strcmp(name,"sort") == 0 { return FnSortFn(st,args,count,marks) }
    if strcmp(name,"unique") == 0 { return FnUnique(st,args,count,marks) }
    if strcmp(name,"eigen") == 0 { return FnEigen(st,args,count,marks) }
    if strcmp(name,"cholesky") == 0 { return FnCholesky(st,args,count,marks) }
    if strcmp(name,"linest") == 0 { return FnLinEstLogEst(st,args,count,marks,0) }
    if strcmp(name,"logest") == 0 { return FnLinEstLogEst(st,args,count,marks,1) }
    if strcmp(name,"trend") == 0 { return FnTrend(st,args,count,marks) }
    if strcmp(name,"growth") == 0 { return FnGrowth(st,args,count,marks) }
    if strcmp(name,"averageif") == 0 { return FnSumIf(st,args,count,marks,1) }
    if strcmp(name,"countif") == 0 { return FnCountIf(st,args,count,marks) }
    return ValError(ERR_NAME)
}

FnSumIf :: (st: EvalState *, args: Val *, count: int, marks: int *, average: int) -> Val {
    groups: int = ArgGroupCount(args,marks,count)
    start0: int = 0
    len0: int = 0
    start1: int = 0
    len1: int = 0
    start2: int = 0
    len2: int = 0
    criterion: Val* = NULL
    total: double = 0
    matched: int = 0
    i: int = 0
    if groups < 2 { return ValError(ERR_VALUE) }
    GroupBounds(marks,count,0,&start0,&len0)
    GroupBounds(marks,count,1,&start1,&len1)
    if groups >= 3 { GroupBounds(marks,count,2,&start2,&len2) }
    if len1 != 1 { return ValError(ERR_VALUE) }
    criterion = &args[start1]
    i = 0
    while i < len0 {
        hit: int = CriterionMatch(criterion,&args[start0 + i])
        if hit < 0 { return ValError(ERR_VALUE) }
        if (hit) {
            value: Val * = NULL
            if groups >= 3 && i < len2 {
                value = &args[start2 + i]
            }
else {
                value = &args[start0 + i]
            }
            if value->kind == VAL_FLOAT {
                total += value->number
                matched += 1
            }
        }
        i += 1
    }
    if (average) {
        if matched == 0 { return ValError(ERR_DIV0) }
        return ValNumber(total / matched)
    }
    return ValNumber(total)
}

FnCountIf :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    groups: int = ArgGroupCount(args,marks,count)
    start0: int = 0
    len0: int = 0
    start1: int = 0
    len1: int = 0
    criterion: Val* = NULL
    matched: int = 0
    i: int = 0
    if groups < 2 { return ValError(ERR_VALUE) }
    GroupBounds(marks,count,0,&start0,&len0)
    GroupBounds(marks,count,1,&start1,&len1)
    if len1 != 1 { return ValError(ERR_VALUE) }
    criterion = &args[start1]
    i = 0
    while i < len0 {
        hit: int = CriterionMatch(criterion,&args[start0 + i])
        if hit < 0 { return ValError(ERR_VALUE) }
        if (hit) { matched += 1 }
        i += 1
    }
    return ValNumber(matched)
}

FnIfs :: (st: EvalState *, args: Val *, count: int, marks: int *, which: int) -> Val {
    groups: int = ArgGroupCount(args,marks,count)
    pairs: int = 0
    p: int = 0
    base_start: int = 0
    base_len: int = 0
    base_cols: int = 0
    crange_start: [16] int = {0}
    crange_len: [16] int = {0}
    crit_start: [16] int = {0}
    i: int = 0
    matched: int = 0
    total: double = 0
    vmax: double = 0
    vmin: double = 0
    first_hit: int = 1
    if which == 0 {
        if groups < 2 || groups % 2 != 0 { return ValError(ERR_VALUE) }
        pairs = groups / 2
    }
else {
        if groups < 1 || groups % 2 != 1 { return ValError(ERR_VALUE) }
        if st->call_refs[0].kind == 0 { return ValError(ERR_VALUE) }
        pairs = (groups - 1) / 2
    }
    if pairs > 16 { return ValError(ERR_VALUE) }
    GroupBounds(marks,count,0,&base_start,&base_len)
    if which != 0 {
        base_cols = st->call_group_cols[base_start]
        if base_cols < 1 { base_cols = base_len }
    }
    p = 0
    while p < pairs {
        rstart: int = 0
        rlen: int = 0
        cstart: int = 0
        clen: int = 0
        gidx: int = (which == 0 ? 0 : 1) + 2 * p
        GroupBounds(marks,count,gidx,&rstart,&rlen)
        GroupBounds(marks,count,gidx + 1,&cstart,&clen)
        if clen != 1 { return ValError(ERR_VALUE) }
        if args[cstart].kind == VAL_ERROR { return ValError(args[cstart].err) }
        if rlen != base_len { return ValError(ERR_VALUE) }
        if which != 0 {
            rcols: int = st->call_group_cols[rstart]
            if rcols < 1 { rcols = rlen }
            if rcols != base_cols { return ValError(ERR_VALUE) }
        }
        crange_start[p] = rstart
        crange_len[p] = rlen
        crit_start[p] = cstart
        p += 1
    }
    i = 0
    while i < base_len {
        hit: int = 1
        p = 0
        while p < pairs {
            one: int = CriterionMatch(&args[crit_start[p]],&args[crange_start[p] + i])
            if one < 0 { return ValError(ERR_VALUE) }
            if one == 0 { hit = 0 }
            p += 1
        }
        if hit != 0 {
            v: Val * = NULL
            if which == 0 {
                v = &args[base_start + i]
                if v->kind == VAL_ERROR { return ValError(v->err) }
                matched += 1
            }
else {
                v = &args[base_start + i]
                if v->kind == VAL_ERROR { return ValError(v->err) }
                if v->kind == VAL_FLOAT {
                    total += v->number
                    if first_hit != 0 {
                        vmax = v->number
                        vmin = v->number
                        first_hit = 0
                    }
else {
                        if v->number > vmax { vmax = v->number }
                        if v->number < vmin { vmin = v->number }
                    }
                    matched += 1
                }
            }
        }
        i += 1
    }
    if which == 0 { return ValNumber(matched) }
    if which == 1 { return ValNumber(total) }
    if matched == 0 { return ValError(ERR_DIV0) }
    if which == 2 { return ValNumber(total / matched) }
    return ValNumber(which == 3 ? vmax : vmin)
}

FnSumA :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    total: double = 0
    i: int = 0
    while i < count {
        v: Val * = &args[i]
        if v->kind == VAL_ERROR { return ValError(v->err) }
        if v->kind == VAL_FLOAT || v->kind == VAL_BOOL {
            total += v->number
        }
        i += 1
    }
    return ValNumber(total)
}

FnProb :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    groups: int = ArgGroupCount(args,marks,count)
    xs: [4096] double = {0}
    ps: [4096] double = {0}
    gx0: int = 0
    gl0: int = 0
    gx1: int = 0
    gl1: int = 0
    gx2: int = 0
    gl2: int = 0
    xn: int = 0
    pn: int = 0
    low: double = 0
    high: double = 0
    total: double = 0
    sum: double = 0
    i: int = 0
    if groups < 3 { return ValError(ERR_VALUE) }
    GroupBounds(marks,count,0,&gx0,&gl0)
    GroupBounds(marks,count,1,&gx1,&gl1)
    GroupBounds(marks,count,2,&gx2,&gl2)
    xn = CashList(args + gx0,gl0,xs)
    pn = CashList(args + gx1,gl1,ps)
    if xn < 0 || pn < 0 { return ValError(ERR_VALUE) }
    if xn != pn { return ValError(ERR_NA) }
    if gl2 < 1 { return ValError(ERR_VALUE) }
    low = CoerceNumber(&args[gx2])
    if groups >= 4 {
        gx3: int = 0
        gl3: int = 0
        GroupBounds(marks,count,3,&gx3,&gl3)
        if gl3 < 1 { return ValError(ERR_VALUE) }
        high = CoerceNumber(&args[gx3])
    }
else {
        high = low
    }
    i = 0
    while i < xn {
        prob: double = ps[i]
        if prob <= 0 || prob > 1 { return ValError(ERR_NUM) }
        total += prob
        if xs[i] >= low && xs[i] <= high { sum += prob }
        i += 1
    }
    if fabs(total - 1) > xn * 2 * 2.220446049250313e-16 { return ValError(ERR_NUM) }
    return ValNumber(sum)
}

FnSubtotal :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    fun: int = 0
    if count < 1 { return ValError(ERR_NUM) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    fun = (int)CoerceNumber(&args[0])
    if fun == 1 { return FnAverage(st,args + 1,count - 1,marks + 1) }
    if fun == 2 { return FnCount(st,args + 1,count - 1,marks + 1) }
    if fun == 3 { return FnCounta(st,args + 1,count - 1,marks + 1) }
    if fun == 4 { return FnMinMax(st,args + 1,count - 1,marks + 1,1) }
    if fun == 5 { return FnMinMax(st,args + 1,count - 1,marks + 1,0) }
    if fun == 6 { return FnProduct(st,args + 1,count - 1,marks + 1) }
    if fun == 7 { return FnVar(st,args + 1,count - 1,marks + 1,1,1) }
    if fun == 8 { return FnVar(st,args + 1,count - 1,marks + 1,0,1) }
    if fun == 9 { return FnSum(st,args + 1,count - 1,marks + 1) }
    if fun == 10 { return FnVar(st,args + 1,count - 1,marks + 1,1,0) }
    if fun == 11 { return FnVar(st,args + 1,count - 1,marks + 1,0,0) }
    return ValError(ERR_NUM)
}

SsMedianCalc :: (sorted_data: double *, len: int, mid_val: double, interval: double) -> double {
    l_lower: double = mid_val - interval / 2
    l_upper: double = mid_val + interval / 2
    f_below: int = 0
    f_within: int = 0
    i: int = 0
    while i < len {
        if sorted_data[i] < l_lower {
            f_below += 1
        }
else if sorted_data[i] <= l_upper {
            f_within += 1
        }
else {
            break
        }
        i += 1
    }
    return l_lower + (len / 2.0 - f_below) * interval / f_within
}

FnSsMedian :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    groups: int = ArgGroupCount(args,marks,count)
    data: [4096] double = {0}
    gx0: int = 0
    gl0: int = 0
    gx1: int = 0
    gl1: int = 0
    n: int = 0
    interval: double = 1
    if groups < 1 { return ValError(ERR_VALUE) }
    if groups > 2 { return ValError(ERR_NA) }
    GroupBounds(marks,count,0,&gx0,&gl0)
    n = CashList(args + gx0,gl0,data)
    if n < 0 { return ValError(ERR_VALUE) }
    if groups >= 2 {
        GroupBounds(marks,count,1,&gx1,&gl1)
        if gl1 >= 1 { interval = CoerceNumber(&args[gx1]) }
    }
    if interval <= 0 || n == 0 { return ValError(ERR_NUM) }
    SortDoubles(data,n)
    if n == 1 { return ValNumber(data[0]) }
    if n == 2 { return ValNumber((data[0] + data[1]) / 2) }
    if n % 2 == 0 {
        m1: double = data[n / 2]
        m0: double = data[n / 2 - 1]
        if m0 == m1 {
            return ValNumber(SsMedianCalc(data,n,m1,interval))
        }
        return ValNumber((m0 + m1) / 2)
    }
    return ValNumber(SsMedianCalc(data,n,data[n / 2],interval))
}

/* ==== quad matrix core: exact ports of goffice go-matrix.c/go-accumulator.c ==== */
QMat :: struct {
    m: int
    n: int
    data: [16][16] Qd
}

QQR :: struct {
    V: QMat
    R: QMat
    qdet: int
}

QAcc :: struct {
    partials: [128] double
    len: int
}

QAccClear :: (acc: QAcc *) {
    acc->len = 0
}

QAccAdd :: (acc: QAcc *, x: double) {
    ui: int = 0
    uj: int = 0
    y: double = 0
    hi: double = 0
    lo: double = 0
    t: double = 0
    uj = 0
    while uj < acc->len {
        y = acc->partials[uj]
        if fabs(x) < fabs(y) {
            t = x
            x = y
            y = t
        }
        hi = x + y
        if isfinite(hi) == 0 {
            x = hi
            ui = 0
            break
        }
        lo = y - (hi - x)
        if lo != 0 {
            acc->partials[ui] = lo
            ui += 1
        }
        x = hi
        uj += 1
    }
    acc->len = ui + 1
    acc->partials[ui] = x
}

QAccAddQuad :: (acc: QAcc *, x: Qd *) {
    QAccAdd(acc,x->h)
    QAccAdd(acc,x->l)
}

QZero :: (r: Qd *) {
    r->h = 0
    r->l = 0
}

QAccValue :: (acc: QAcc *) -> double {
    sum: double = 0
    ui: int = 0
    while ui < acc->len {
        sum += acc->partials[ui]
        ui += 1
    }
    return sum
}

QQRNew :: (A: QMat *) -> QQR {
    qr: QQR = {0}
    qdet: int = 1
    R: QMat = {0}
    i: int = 0
    j: int = 0
    k: int = 0
    m: int = A->m
    n: int = A->n
    L: Qd = {0,0}
    L2: Qd = {0,0}
    L2p: Qd = {0,0}
    s: Qd = {0,0}
    p: Qd = {0,0}
    tmp: [16] Qd = {0}
    qr.V.m = m
    qr.V.n = n
    qr.R.m = n
    qr.R.n = n
    R.m = m
    R.n = n
    i = 0
    while i < m {
        j = 0
        while j < n {
            R.data[i][j] = A->data[i][j]
            j += 1
        }
        i += 1
    }
    k = 0
    while k < n {
        QZero(&L2)
        QZero(&L2p)
        i = m - 1
        while i >= k {
            qr.V.data[i][k] = R.data[i][k]
            Q_Mul(&s,&qr.V.data[i][k],&qr.V.data[i][k])
            L2p = L2
            Q_Add(&L2,&L2,&s)
            i -= 1
        }
        Q_Sqrt(&L,&L2)
        if Q_Val(&qr.V.data[k][k]) < 0 {
            Q_Sub(&qr.V.data[k][k],&qr.V.data[k][k],&L)
        }
else {
            Q_Add(&qr.V.data[k][k],&qr.V.data[k][k],&L)
        }
        Q_Mul(&s,&qr.V.data[k][k],&qr.V.data[k][k])
        Q_Add(&L2p,&L2p,&s)
        Q_Sqrt(&L,&L2p)
        if Q_Val(&L) == 0 {
            k += 1
            continue
        }
        i = k
        while i < m {
            Q_Div(&qr.V.data[i][k],&qr.V.data[i][k],&L)
            i += 1
        }
        qdet = -qdet
        j = k
        while j < n {
            QZero(&tmp[j])
            i = k
            while i < m {
                Q_Mul(&p,&qr.V.data[i][k],&R.data[i][j])
                Q_Add(&tmp[j],&tmp[j],&p)
                i += 1
            }
            j += 1
        }
        j = k
        while j < n {
            i = k
            while i < m {
                Q_Mul(&p,&qr.V.data[i][k],&tmp[j])
                Q_Add(&p,&p,&p)
                Q_Sub(&R.data[i][j],&R.data[i][j],&p)
                i += 1
            }
            j += 1
        }
        i = k + 1
        while i < m {
            QZero(&R.data[i][k])
            i += 1
        }
        k += 1
    }
    i = 0
    while i < n {
        j = 0
        while j < n {
            qr.R.data[i][j] = R.data[i][j]
            j += 1
        }
        i += 1
    }
    qr.qdet = qdet
    return qr
}

QQRMultiplyQt :: (qr: QQR *, x: Qd *) {
    k: int = 0
    i: int = 0
    s: Qd = {0,0}
    p: Qd = {0,0}
    k = 0
    while k < qr->V.n {
        QZero(&s)
        i = k
        while i < qr->V.m {
            Q_Mul(&p,&x[i],&qr->V.data[i][k])
            Q_Add(&s,&s,&p)
            i += 1
        }
        Q_Add(&s,&s,&s)
        i = k
        while i < qr->V.m {
            Q_Mul(&p,&s,&qr->V.data[i][k])
            Q_Sub(&x[i],&x[i],&p)
            i += 1
        }
        k += 1
    }
}

QMatBackSolve :: (R: QMat *, x: Qd *, b: Qd *, allow_degenerate: int) -> int {
    i: int = 0
    j: int = 0
    n: int = R->m
    d: Qd = {0,0}
    Rii: Qd = {0,0}
    p: Qd = {0,0}
    i = n - 1
    while i >= 0 {
        d = b[i]
        Rii = R->data[i][i]
        if Q_Val(&Rii) == 0 {
            if allow_degenerate != 0 {
                QZero(&x[i])
                i -= 1
                continue
            }
            while i >= 0 {
                QZero(&x[i])
                i -= 1
            }
            return 1
        }
        j = i + 1
        while j < n {
            Q_Mul(&p,&R->data[i][j],&x[j])
            Q_Sub(&d,&d,&p)
            j += 1
        }
        Q_Div(&x[i],&d,&Rii)
        i -= 1
    }
    return 0
}

QMatEigenRange :: (A: QMat *, emin: double *, emax: double *) {
    i: int = 0
    abs_e: double = 0
    abs_e = fabs(Q_Val(&A->data[0][0]))
    emin[0] = abs_e
    emax[0] = abs_e
    i = 1
    while i < A->m {
        abs_e = fabs(Q_Val(&A->data[i][i]))
        if abs_e < emin[0] { emin[0] = abs_e }
        if abs_e > emax[0] { emax[0] = abs_e }
        i += 1
    }
}

QMatDetQuad :: (A: QMat *, res: Qd *) {
    qr: QQR = {0}
    a: Qd = {0,0}
    b: Qd = {0,0}
    i: int = 0
    if A->m == 1 {
        res[0] = A->data[0][0]
        return
    }
    if A->m == 2 {
        Q_Mul(&a,&A->data[0][0],&A->data[1][1])
        Q_Mul(&b,&A->data[1][0],&A->data[0][1])
        Q_Sub(res,&a,&b)
        return
    }
    qr = QQRNew(A)
    Q_Init(res,qr.qdet)
    i = 0
    while i < qr.R.n {
        Q_Mul(res,res,&qr.R.data[i][i])
        i += 1
    }
}

QMatInverse :: (A: QMat *, threshold: double, Z: QMat *) -> int {
    qr: QQR = {0}
    n: int = A->n
    i: int = 0
    k: int = 0
    ok: int = 0
    emin: double = 0
    emax: double = 0
    x: [16] Qd = {0}
    QTk: [16] Qd = {0}
    qr = QQRNew(A)
    Z->m = n
    Z->n = n
    QMatEigenRange(&qr.R,&emin,&emax)
    ok = emin > emax * threshold ? 1 : 0
    k = 0
    while ok != 0 && k < n {
        i = 0
        while i < n {
            Q_Init(&QTk[i],i == k ? 1.0 : 0.0)
            i += 1
        }
        QQRMultiplyQt(&qr,QTk)
        if QMatBackSolve(&qr.R,x,QTk,0) != 0 {
            ok = 0
            break
        }
        i = 0
        while i < n {
            Z->data[i][k] = x[i]
            i += 1
        }
        k += 1
    }
    return ok
}

GoMatrixDeterminant :: (a: double *, n: int) -> double {
    qA: QMat = {0}
    qres: Qd = {0,0}
    i: int = 0
    j: int = 0
    if n < 1 { return 0 }
    qA.m = n
    qA.n = n
    i = 0
    while i < n {
        j = 0
        while j < n {
            Q_Init(&qA.data[i][j],a[i * 16 + j])
            j += 1
        }
        i += 1
    }
    QMatDetQuad(&qA,&qres)
    return Q_Val(&qres)
}

GoMatrixInvert :: (a: double *, n: int) -> int {
    qA: QMat = {0}
    qZ: QMat = {0}
    i: int = 0
    j: int = 0
    qA.m = n
    qA.n = n
    i = 0
    while i < n {
        j = 0
        while j < n {
            Q_Init(&qA.data[i][j],a[i * 16 + j])
            j += 1
        }
        i += 1
    }
    if QMatInverse(&qA,256 * 2.220446049250313e-16,&qZ) == 0 { return 0 }
    i = 0
    while i < n {
        j = 0
        while j < n {
            a[i * 16 + j] = Q_Val(&qZ.data[i][j])
            j += 1
        }
        i += 1
    }
    return 1
}

GoLinearSolveMultiple :: (a: double *, n: int, b: double *, bn: int) -> int {
    qA: QMat = {0}
    qr: QQR = {0}
    i: int = 0
    j: int = 0
    regres: int = 0
    QTb: [16] Qd = {0}
    x: [16] Qd = {0}
    if n < 1 || bn < 1 { return 2 }
    if n == 1 {
        d0: double = a[0]
        if d0 == 0 { return 1 }
        i = 0
        while i < bn {
            b[i] /= d0
            i += 1
        }
        return 0
    }
    qA.m = n
    qA.n = n
    i = 0
    while i < n {
        j = 0
        while j < n {
            Q_Init(&qA.data[i][j],a[i * 16 + j])
            j += 1
        }
        i += 1
    }
    qr = QQRNew(&qA)
    regres = 0
    j = 0
    while j < bn {
        i = 0
        while i < n {
            Q_Init(&QTb[i],b[i * 16 + j])
            i += 1
        }
        QQRMultiplyQt(&qr,QTb)
        if QMatBackSolve(&qr.R,x,QTb,0) != 0 { regres = 1 }
        i = 0
        while i < n {
            b[i * 16 + j] = Q_Val(&x[i])
            i += 1
        }
        j += 1
    }
    return regres
}

MatFromGroup :: (args: Val *, start: int, len: int, cols: int, a: double *, rows: int *, out_cols: int *) -> int {
    i: int = 0
    r: int = 0
    c: int = 0
    if cols < 1 { return 0 }
    if len % cols != 0 { return 0 }
    r = len / cols
    if r < 1 || r > 16 || cols > 16 { return 0 }
    i = 0
    while i < len {
        v: Val * = &args[start + i]
        if v->kind == VAL_ERROR { return -1 }
        a[(i / cols) * 16 + i % cols] = CoerceNumber(v)
        i += 1
    }
    rows[0] = r
    out_cols[0] = cols
    return 1
}

FnMmult :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    groups: int = ArgGroupCount(args,marks,count)
    gx0: int = 0
    gl0: int = 0
    gx1: int = 0
    gl1: int = 0
    a: [16][16] double = {0}
    b: [16][16] double = {0}
    ar: int = 0
    ac: int = 0
    br: int = 0
    bc: int = 0
    ok1: int = 0
    ok2: int = 0
    acc: QAcc = {0}
    p: Qd = {0,0}
    sum: double = 0
    i: int = 0
    if groups < 2 { return ValError(ERR_VALUE) }
    if groups > 2 { return ValError(ERR_NA) }
    GroupBounds(marks,count,0,&gx0,&gl0)
    GroupBounds(marks,count,1,&gx1,&gl1)
    ok1 = MatFromGroup(args,gx0,gl0,st->call_group_cols[gx0],&a[0][0],&ar,&ac)
    ok2 = MatFromGroup(args,gx1,gl1,st->call_group_cols[gx1],&b[0][0],&br,&bc)
    if ok1 < 0 { return ValError(args[gx0].err) }
    if ok2 < 0 { return ValError(args[gx1].err) }
    if ok1 == 0 || ok2 == 0 { return ValError(ERR_VALUE) }
    if ac != br { return ValError(ERR_VALUE) }
    i = 0
    while i < ac {
        Q_Mul12(&p,a[0][i],b[i][0])
        QAccAddQuad(&acc,&p)
        i += 1
    }
    sum = QAccValue(&acc)
    return ValNumber(sum)
}

FnMdeterm :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    groups: int = ArgGroupCount(args,marks,count)
    gx0: int = 0
    gl0: int = 0
    a: [16][16] double = {0}
    ar: int = 0
    ac: int = 0
    ok: int = 0
    if groups < 1 { return ValError(ERR_VALUE) }
    if groups > 1 { return ValError(ERR_NA) }
    GroupBounds(marks,count,0,&gx0,&gl0)
    ok = MatFromGroup(args,gx0,gl0,st->call_group_cols[gx0],&a[0][0],&ar,&ac)
    if ok < 0 { return ValError(args[gx0].err) }
    if ok == 0 { return ValError(ERR_VALUE) }
    if ar != ac { return ValError(ERR_VALUE) }
    return ValNumber(GoMatrixDeterminant(&a[0][0],ar))
}

FnMinverse :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    groups: int = ArgGroupCount(args,marks,count)
    gx0: int = 0
    gl0: int = 0
    a: [16][16] double = {0}
    ar: int = 0
    ac: int = 0
    ok: int = 0
    if groups < 1 { return ValError(ERR_VALUE) }
    if groups > 1 { return ValError(ERR_NA) }
    GroupBounds(marks,count,0,&gx0,&gl0)
    ok = MatFromGroup(args,gx0,gl0,st->call_group_cols[gx0],&a[0][0],&ar,&ac)
    if ok < 0 { return ValError(args[gx0].err) }
    if ok == 0 { return ValError(ERR_VALUE) }
    if ar != ac { return ValError(ERR_VALUE) }
    if GoMatrixInvert(&a[0][0],ar) == 0 { return ValError(ERR_NUM) }
    return ValNumber(a[0][0])
}

FnLinsolve :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    groups: int = ArgGroupCount(args,marks,count)
    gx0: int = 0
    gl0: int = 0
    gx1: int = 0
    gl1: int = 0
    a: [16][16] double = {0}
    b: [16][16] double = {0}
    ar: int = 0
    ac: int = 0
    br: int = 0
    bc: int = 0
    ok1: int = 0
    ok2: int = 0
    regres: int = 0
    if groups < 2 { return ValError(ERR_VALUE) }
    if groups > 2 { return ValError(ERR_NA) }
    GroupBounds(marks,count,0,&gx0,&gl0)
    GroupBounds(marks,count,1,&gx1,&gl1)
    ok1 = MatFromGroup(args,gx0,gl0,st->call_group_cols[gx0],&a[0][0],&ar,&ac)
    ok2 = MatFromGroup(args,gx1,gl1,st->call_group_cols[gx1],&b[0][0],&br,&bc)
    if ok1 < 0 { return ValError(args[gx0].err) }
    if ok2 < 0 { return ValError(args[gx1].err) }
    if ok1 == 0 || ok2 == 0 { return ValError(ERR_VALUE) }
    if ar != ac || br != ar { return ValError(ERR_VALUE) }
    regres = GoLinearSolveMultiple(&a[0][0],ar,&b[0][0],bc)
    if regres != 0 { return ValError(ERR_NUM) }
    return ValNumber(b[0][0])
}

FnTranspose :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    groups: int = ArgGroupCount(args,marks,count)
    gx0: int = 0
    gl0: int = 0
    if groups < 1 { return ValError(ERR_VALUE) }
    if groups > 1 { return ValError(ERR_NA) }
    GroupBounds(marks,count,0,&gx0,&gl0)
    if gl0 < 1 { return ValError(ERR_VALUE) }
    if args[gx0].kind == VAL_ERROR { return ValError(args[gx0].err) }
    return ValNumber(CoerceNumber(&args[gx0]))
}

FnMunit :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    n: double = 0
    if count < 1 { return ValError(ERR_VALUE) }
    if count > 1 { return ValError(ERR_NA) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    n = CoerceNumber(&args[0])
    if n < 1 { return ValError(ERR_NUM) }
    if n > 5000 { return ValError(ERR_NUM) }
    return ValNumber(1)
}

FnSortFn :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    groups: int = ArgGroupCount(args,marks,count)
    gx0: int = 0
    gl0: int = 0
    gx1: int = 0
    gl1: int = 0
    data: [4096] double = {0}
    n: int = 0
    order: int = 0
    if groups < 1 { return ValError(ERR_VALUE) }
    if groups > 2 { return ValError(ERR_NA) }
    GroupBounds(marks,count,0,&gx0,&gl0)
    n = CashList(args + gx0,gl0,data)
    if n < 0 { return ValError(args[gx0].err) }
    if groups >= 2 {
        GroupBounds(marks,count,1,&gx1,&gl1)
        if gl1 >= 1 {
            if args[gx1].kind == VAL_ERROR { return ValError(args[gx1].err) }
            order = (int)CoerceNumber(&args[gx1])
        }
    }
    if order != 0 && order != 1 { return ValError(ERR_VALUE) }
    if n == 0 { return ValError(ERR_VALUE) }
    SortDoubles(data,n)
    if order == 0 {
        return ValNumber(data[n - 1])
    }
    return ValNumber(data[0])
}

RowColEqual :: (args: Val *, start: int, cols: int, i: int, j: int) -> int {
    c: int = 0
    while c < cols {
        cmp: int = CompareVals(&args[start + i * cols + c],&args[start + j * cols + c])
        if cmp != 0 { return 0 }
        c += 1
    }
    return 1
}

FnUnique :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    groups: int = ArgGroupCount(args,marks,count)
    gx0: int = 0
    gl0: int = 0
    gx1: int = 0
    gl1: int = 0
    gx2: int = 0
    gl2: int = 0
    cols: int = 0
    rows: int = 0
    by_col: int = 0
    exactly_once: int = 0
    ncount: int = 0
    keep: [256] int = {0}
    i: int = 0
    j: int = 0
    first: int = -1
    if groups < 1 { return ValError(ERR_VALUE) }
    if groups > 3 { return ValError(ERR_NA) }
    GroupBounds(marks,count,0,&gx0,&gl0)
    if gl0 < 1 { return ValError(ERR_VALUE) }
    if args[gx0].kind == VAL_ERROR { return ValError(args[gx0].err) }
    cols = st->call_group_cols[gx0]
    if cols < 1 { cols = gl0 }
    if gl0 % cols != 0 { return ValError(ERR_VALUE) }
    rows = gl0 / cols
    if groups >= 2 {
        GroupBounds(marks,count,1,&gx1,&gl1)
        if gl1 >= 1 { by_col = CoerceNumber(&args[gx1]) != 0 ? 1 : 0 }
    }
    if groups >= 3 {
        GroupBounds(marks,count,2,&gx2,&gl2)
        if gl2 >= 1 { exactly_once = CoerceNumber(&args[gx2]) != 0 ? 1 : 0 }
    }
    ncount = by_col != 0 ? cols : rows
    if ncount > 256 { ncount = 256 }
    i = 0
    while i < ncount {
        keep[i] = 1
        i += 1
    }
    i = 0
    while i < ncount {
        j = 0
        while j < i {
            same: int = 0
            if by_col != 0 {
                c2: int = 0
                same = 1
                while c2 < rows {
                    cmp: int = CompareVals(&args[gx0 + c2 * cols + i],&args[gx0 + c2 * cols + j])
                    if cmp != 0 { same = 0 }
                    c2 += 1
                }
            }
else {
                same = RowColEqual(args,gx0,cols,i,j)
            }
            if same != 0 {
                keep[i] = 0
                if exactly_once != 0 { keep[j] = 0 }
            }
            j += 1
        }
        i += 1
    }
    i = 0
    while i < ncount {
        if keep[i] != 0 { first = i; break }
        i += 1
    }
    if first < 0 { return ValError(ERR_VALUE) }
    if by_col != 0 {
        return ValNumber(CoerceNumber(&args[gx0 + first]))
    }
    return ValNumber(CoerceNumber(&args[gx0 + first * cols]))
}

EigenMaxIndex :: (matrix: [16][16] double, row: int, row_n: int, size: int) -> int {
    i: int = 0
    res: int = row_n + 1
    maxv: double = 0
    if res >= size {
        return size - 1
    }
    maxv = fabs(matrix[row][res])
    i = res + 1
    while i < size {
        if fabs(matrix[row][i]) > maxv {
            res = i
            maxv = fabs(matrix[row][i])
        }
        i += 1
    }
    return res
}

FnEigen :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    groups: int = ArgGroupCount(args,marks,count)
    gx0: int = 0
    gl0: int = 0
    a: [16][16] double = {0}
    ar: int = 0
    ac: int = 0
    ok: int = 0
    n: int = 0
    c: int = 0
    r: int = 0
    k: int = 0
    i: int = 0
    m: int = 0
    l: int = 0
    state: int = 0
    counter: int = 0
    ind: [16] int = {0}
    changed: [16] int = {0}
    eigv: [16][16] double = {0}
    eigenvalues: [16] double = {0}
    evsort_val: [16] double = {0}
    evsort_idx: [16] int = {0}
    pivot: double = 0
    y: double = 0
    t: double = 0
    s: double = 0
    cc: double = 0
    if groups < 1 { return ValError(ERR_VALUE) }
    if groups > 1 { return ValError(ERR_NA) }
    GroupBounds(marks,count,0,&gx0,&gl0)
    ok = MatFromGroup(args,gx0,gl0,st->call_group_cols[gx0],&a[0][0],&ar,&ac)
    if ok < 0 { return ValError(args[gx0].err) }
    if ok == 0 { return ValError(ERR_VALUE) }
    if ar != ac { return ValError(ERR_VALUE) }
    n = ar
    c = 0
    while c < n {
        r = c + 1
        while r < n {
            av: double = (a[r][c] + a[c][r]) / 2
            a[r][c] = av
            a[c][r] = av
            r += 1
        }
        c += 1
    }
    state = n
    i = 0
    while i < n {
        j2: int = 0
        while j2 < n {
            eigv[j2][i] = 0
            j2 += 1
        }
        eigv[i][i] = 1
        eigenvalues[i] = a[i][i]
        ind[i] = EigenMaxIndex(a,i,i,n)
        changed[i] = 1
        i += 1
    }
    while n > 1 && state != 0 {
        counter += 1
        if counter > 400000 { return ValError(ERR_NUM) }
        m = 0
        k = 1
        while k < n - 1 {
            if fabs(a[k][ind[k]]) > fabs(a[m][ind[m]]) { m = k }
            k += 1
        }
        l = ind[m]
        pivot = a[m][l]
        if pivot == 0 { break }
        y = (eigenvalues[l] - eigenvalues[m]) / 2
        t = fabs(y) + hypot(pivot,y)
        s = hypot(pivot,t)
        cc = t / s
        s = pivot / s
        t = pivot * pivot / t
        if y < 0 {
            s = -s
            t = -t
        }
        a[m][l] = 0
        i = 0
        while i < n {
            yk: double = eigenvalues[i]
            if i == m { eigenvalues[i] -= t }
            if i == l { eigenvalues[i] += t }
            unchanged: int = yk == eigenvalues[i] ? 1 : 0
            if i == m || i == l {
                if changed[i] != 0 && unchanged != 0 {
                    changed[i] = 0
                    state -= 1
                }
else if changed[i] == 0 && unchanged == 0 {
                    changed[i] = 1
                    state += 1
                }
            }
            i += 1
        }
        i = 0
        while i < m {
            x2: double = cc * a[i][m] - s * a[i][l]
            y2: double = s * a[i][m] + cc * a[i][l]
            a[i][m] = x2
            a[i][l] = y2
            i += 1
        }
        i = m + 1
        while i < l {
            x2: double = cc * a[m][i] - s * a[i][l]
            y2: double = s * a[m][i] + cc * a[i][l]
            a[m][i] = x2
            a[i][l] = y2
            i += 1
        }
        i = l + 1
        while i < n {
            x2: double = cc * a[m][i] - s * a[l][i]
            y2: double = s * a[m][i] + cc * a[l][i]
            a[m][i] = x2
            a[l][i] = y2
            i += 1
        }
        i = 0
        while i < n {
            x3: double = cc * eigv[i][m] - s * eigv[i][l]
            y3: double = s * eigv[i][m] + cc * eigv[i][l]
            eigv[i][m] = x3
            eigv[i][l] = y3
            i += 1
        }
        ind[m] = EigenMaxIndex(a,m,m,n)
        ind[l] = EigenMaxIndex(a,l,l,n)
    }
    i = 0
    while i < n {
        evsort_val[i] = eigenvalues[i]
        evsort_idx[i] = i
        i += 1
    }
    i = 1
    while i < n {
        v2: double = evsort_val[i]
        i2: int = evsort_idx[i]
        j3: int = i - 1
        while j3 >= 0 {
            va: double = fabs(evsort_val[j3])
            vb: double = fabs(v2)
            keep: int = 0
            if vb > va { keep = 1 }
            else if vb < va { keep = 0 }
            else if v2 > evsort_val[j3] { keep = 1 }
            if keep == 0 { break }
            evsort_val[j3 + 1] = evsort_val[j3]
            evsort_idx[j3 + 1] = evsort_idx[j3]
            j3 -= 1
        }
        evsort_val[j3 + 1] = v2
        evsort_idx[j3 + 1] = i2
        i += 1
    }
    return ValNumber(eigenvalues[evsort_idx[0]])
}

FnCholesky :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    groups: int = ArgGroupCount(args,marks,count)
    gx0: int = 0
    gl0: int = 0
    a: [16][16] double = {0}
    b: [16][16] double = {0}
    ar: int = 0
    ac: int = 0
    ok: int = 0
    n: int = 0
    r: int = 0
    c: int = 0
    k: int = 0
    sum: double = 0
    if groups < 1 { return ValError(ERR_VALUE) }
    if groups > 1 { return ValError(ERR_NA) }
    GroupBounds(marks,count,0,&gx0,&gl0)
    ok = MatFromGroup(args,gx0,gl0,st->call_group_cols[gx0],&a[0][0],&ar,&ac)
    if ok < 0 { return ValError(args[gx0].err) }
    if ok == 0 { return ValError(ERR_VALUE) }
    if ar != ac { return ValError(ERR_VALUE) }
    n = ar
    c = 0
    while c < n {
        r = c + 1
        while r < n {
            av: double = (a[r][c] + a[c][r]) / 2
            a[r][c] = av
            a[c][r] = av
            r += 1
        }
        c += 1
    }
    r = 0
    while r < n {
        c = 0
        while c < r {
            sum = 0
            k = 0
            while k < c {
                sum += b[r][k] * b[c][k]
                k += 1
            }
            b[c][r] = 0
            b[r][c] = (a[r][c] - sum) / b[c][c]
            c += 1
        }
        sum = 0
        k = 0
        while k < r {
            sum += b[r][k] * b[r][k]
            k += 1
        }
        b[r][r] = sqrt(a[r][r] - sum)
        r += 1
    }
    return ValNumber(b[0][0])
}

/* ==== regression: exact port of goffice go-regression.c ==== */
CalcScale :: (xs: double *, m: int) -> double {
    mabs: double = 0
    e: int = 0
    i: int = 1
    if m < 1 { return 1 }
    mabs = fabs(xs[0])
    i = 1
    while i < m {
        xabs: double = fabs(xs[i])
        if xabs > mabs { mabs = xabs }
        i += 1
    }
    if mabs == 0 { return 1 }
    frexp(mabs,&e)
    return ldexp(1.0,e - 1)
}

GoRangeSumsq :: (xs: double *, n: int) -> double {
    acc: QAcc = {0}
    q: Qd = {0,0}
    while n > 0 {
        n -= 1
        Q_Mul12(&q,xs[n],xs[n])
        QAccAddQuad(&acc,&q)
    }
    return QAccValue(&acc)
}

CalcResidual :: (xsst: double *, ys: double *, m: int, n: int, y: double *) -> double {
    n2: Qd = {0,0}
    d: Qd = {0,0}
    e: Qd = {0,0}
    i: int = 0
    j: int = 0
    i = 0
    while i < m {
        Q_Init(&d,ys[i])
        j = 0
        while j < n {
            Q_Mul12(&e,xsst[j * 64 + i],y[j])
            Q_Sub(&d,&d,&e)
            j += 1
        }
        Q_Mul(&d,&d,&d)
        Q_Add(&n2,&n2,&d)
        i += 1
    }
    return Q_Val(&n2)
}

GenLinReg :: (xsst: double *, dim: int, ys: double *, n: int, affine: int, result: double *) -> int {
    qss: QMat = {0}
    qr: QQR = {0}
    xscale: [16] double = {0}
    qty: [64] Qd = {0}
    qresult: [16] Qd = {0}
    emax: double = 0
    emin_dummy: double = 0
    df_resid: int = 0
    ss_total: double = 0
    ss_resid: double = 0
    sqr_r: double = 0
    i: int = 0
    j: int = 0
    if dim < 1 || n < 1 { return 3 }
    if dim > n { return 3 }
    if dim > 16 || n > 64 { return 3 }
    qss.m = n
    qss.n = dim
    j = 0
    while j < dim {
        xscale[j] = CalcScale(&xsst[j * 64],n)
        i = 0
        while i < n {
            Q_Init(&qss.data[i][j],xsst[j * 64 + i] / xscale[j])
            i += 1
        }
        j += 1
    }
    qr = QQRNew(&qss)
    QMatEigenRange(&qr.R,&emin_dummy,&emax)
    df_resid = n - dim
    i = 0
    while i < dim {
        ei: double = Q_Val(&qr.R.data[i][i])
        if fabs(ei) >= emax * (256 * 2.220446049250313e-16) {
            /* not degenerate */
        }
else {
            QZero(&qr.R.data[i][i])
            df_resid += 1
        }
        i += 1
    }
    i = 0
    while i < n {
        Q_Init(&qty[i],ys[i])
        i += 1
    }
    QQRMultiplyQt(&qr,qty)
    QMatBackSolve(&qr.R,qresult,qty,1)
    i = 0
    while i < dim {
        result[i] = Q_Val(&qresult[i]) / xscale[i]
        i += 1
    }
    ss_resid = CalcResidual(xsst,ys,n,dim,result)
    if affine != 0 {
        ss_total = StatDevsq(ys,n)
    }
else {
        ss_total = GoRangeSumsq(ys,n)
    }
    sqr_r = ss_total == 0 ? 1 : 1 - ss_resid / ss_total
    if sqr_r < 0 { return 1 }
    return 0
}

CollectStrictGroup :: (args: Val *, start: int, len: int, out: double *) -> int {
    n: int = 0
    i: int = 0
    while i < len {
        v: Val * = &args[start + i]
        if v->kind == VAL_ERROR { return -1 }
        if v->kind != VAL_FLOAT { return -2 }
        if n < 4096 {
            out[n] = v->number
            n += 1
        }
        i += 1
    }
    return n
}

FnLinEstLogEst :: (st: EvalState *, args: Val *, count: int, marks: int *, want_exp: int) -> Val {
    groups: int = ArgGroupCount(args,marks,count)
    gx0: int = 0
    gl0: int = 0
    gx1: int = 0
    gl1: int = 0
    gx2: int = 0
    gl2: int = 0
    gx3: int = 0
    gl3: int = 0
    ys: [64] double = {0}
    xscols: [64] double = {0}
    xsst: [17][64] double = {0}
    n: int = 0
    ny2: int = 0
    dim: int = 1
    rtype: int = 0
    affine: int = 1
    xcols: int = 0
    ycols: int = 0
    xrows: int = 0
    yrows: int = 0
    linres: [17] double = {0}
    regres: int = 0
    i: int = 0
    j: int = 0
    if groups < 1 { return ValError(ERR_VALUE) }
    if groups > 4 { return ValError(ERR_NA) }
    GroupBounds(marks,count,0,&gx0,&gl0)
    n = CollectStrictGroup(args,gx0,gl0,ys)
    if n == -1 { return ValError(args[gx0].err) }
    if n < -1 { return ValError(ERR_VALUE) }
    if n < 1 { return ValError(ERR_VALUE) }
    if n > 64 { return ValError(ERR_VALUE) }
    ycols = st->call_group_cols[gx0]
    if ycols < 1 { ycols = n }
    yrows = gl0 / ycols
    if groups >= 2 {
        GroupBounds(marks,count,1,&gx1,&gl1)
        if gl1 >= 1 && args[gx1].kind == VAL_EMPTY { return ValError(ERR_REF) }
        ny2 = CollectStrictGroup(args,gx1,gl1,xscols)
        if ny2 == -1 { return ValError(args[gx1].err) }
        if ny2 < -1 { return ValError(ERR_VALUE) }
        xcols = st->call_group_cols[gx1]
        if xcols < 1 { xcols = gl1 }
        xrows = gl1 / xcols
        if ycols == 1 {
            if xrows != yrows { return ValError(ERR_REF) }
            dim = xcols
            rtype = 1
            i = 0
            while i < dim {
                j = 0
                while j < ny2 {
                    xsst[i + 1][j] = xscols[j * xcols + i]
                    j += 1
                }
                i += 1
            }
        }
else if yrows == 1 {
            if xcols != ycols { return ValError(ERR_REF) }
            dim = xrows
            rtype = 2
            i = 0
            while i < dim {
                j = 0
                while j < ny2 {
                    xsst[i + 1][j] = xscols[i * xcols + j]
                    j += 1
                }
                i += 1
            }
        }
else {
            if xrows != yrows || xcols != ycols { return ValError(ERR_REF) }
            dim = 1
            rtype = 0
            i = 0
            while i < n {
                xsst[1][i] = xscols[i]
                i += 1
            }
        }
    }
else {
        i = 0
        while i < n {
            xsst[1][i] = i + 1
            i += 1
        }
    }
    if dim > 16 { return ValError(ERR_VALUE) }
    if groups >= 3 {
        GroupBounds(marks,count,2,&gx2,&gl2)
        if gl2 >= 1 { affine = CoerceNumber(&args[gx2]) != 0 ? 1 : 0 }
    }
    if want_exp != 0 {
        i = 0
        while i < n {
            if ys[i] <= 0 { return ValError(ERR_NUM) }
            ys[i] = log(ys[i])
            i += 1
        }
    }
    if affine != 0 {
        i = 0
        while i < n {
            xsst[0][i] = 1
            i += 1
        }
        regres = GenLinReg(&xsst[0][0],dim + 1,ys,n,1,linres)
    }
else {
        linres[0] = 0
        regres = GenLinReg(&xsst[1][0],dim,ys,n,0,&linres[1])
    }
    if regres != 0 { return ValError(ERR_NUM) }
    if want_exp != 0 {
        i = 0
        while i < dim + 1 {
            linres[i] = exp(linres[i])
            i += 1
        }
    }
    return ValNumber(linres[dim])
}

FnTrend :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    groups: int = ArgGroupCount(args,marks,count)
    gx0: int = 0
    gl0: int = 0
    gx1: int = 0
    gl1: int = 0
    gx3: int = 0
    gl3: int = 0
    ys: [64] double = {0}
    xscols: [64] double = {0}
    nxs: [64] double = {0}
    xsst: [17][64] double = {0}
    linres: [17] double = {0}
    n: int = 0
    nx2: int = 0
    dim: int = 1
    rtype: int = 0
    affine: int = 1
    xcols: int = 0
    ycols: int = 0
    xrows: int = 0
    yrows: int = 0
    regres: int = 0
    i: int = 0
    j: int = 0
    res: double = 0
    if groups < 1 { return ValError(ERR_VALUE) }
    if groups > 4 { return ValError(ERR_NA) }
    GroupBounds(marks,count,0,&gx0,&gl0)
    n = CollectStrictGroup(args,gx0,gl0,ys)
    if n == -1 { return ValError(args[gx0].err) }
    if n < -1 { return ValError(ERR_VALUE) }
    if n < 1 || n > 64 { return ValError(ERR_VALUE) }
    ycols = st->call_group_cols[gx0]
    if ycols < 1 { ycols = n }
    yrows = gl0 / ycols
    if groups >= 2 {
        GroupBounds(marks,count,1,&gx1,&gl1)
        if gl1 >= 1 && args[gx1].kind == VAL_EMPTY { return ValError(ERR_REF) }
        nx2 = CollectStrictGroup(args,gx1,gl1,xscols)
        if nx2 == -1 { return ValError(args[gx1].err) }
        if nx2 < -1 { return ValError(ERR_VALUE) }
        xcols = st->call_group_cols[gx1]
        if xcols < 1 { xcols = gl1 }
        xrows = gl1 / xcols
        if ycols == 1 {
            if xrows != yrows { return ValError(ERR_REF) }
            dim = xcols
            rtype = 1
        }
else if yrows == 1 {
            if xcols != ycols { return ValError(ERR_REF) }
            dim = xrows
            rtype = 2
        }
else {
            if xrows != yrows || xcols != ycols { return ValError(ERR_REF) }
            dim = 1
            rtype = 0
        }
        i = 0
        while i < dim {
            j = 0
            while j < nx2 {
                if rtype == 2 {
                    xsst[i + 1][j] = xscols[i * xcols + j]
                }
else {
                    xsst[i + 1][j] = xscols[j * xcols + i]
                }
                j += 1
            }
            i += 1
        }
    }
else {
        i = 0
        while i < n {
            xsst[1][i] = i + 1
            i += 1
        }
    }
    if dim == 1 { rtype = 0 }
    if dim > 16 { return ValError(ERR_VALUE) }
    if groups >= 4 {
        GroupBounds(marks,count,3,&gx3,&gl3)
        if gl3 >= 1 { affine = CoerceNumber(&args[gx3]) != 0 ? 1 : 0 }
    }
    if affine != 0 {
        i = 0
        while i < n {
            xsst[0][i] = 1
            i += 1
        }
        regres = GenLinReg(&xsst[0][0],dim + 1,ys,n,1,linres)
    }
else {
        linres[0] = 0
        regres = GenLinReg(&xsst[1][0],dim,ys,n,0,&linres[1])
    }
    if regres != 0 { return ValError(ERR_NUM) }
    if groups >= 3 {
        gxn: int = 0
        gln: int = 0
        GroupBounds(marks,count,2,&gxn,&gln)
        nx2 = CollectStrictGroup(args,gxn,gln,nxs)
        if nx2 == -1 { return ValError(args[gxn].err) }
        if nx2 < -1 { return ValError(ERR_VALUE) }
        if rtype == 1 {
            if dim != st->call_group_cols[gxn] { return ValError(ERR_NUM) }
        }
        res = linres[0]
        if rtype == 1 {
            j = 0
            while j < dim {
                res += nxs[j] * linres[j + 1]
                j += 1
            }
        }
else {
            res += nxs[0] * linres[1]
        }
        return ValNumber(res)
    }
    if groups >= 2 {
        res = linres[0]
        if rtype == 1 {
            j = 0
            while j < dim {
                res += xscols[j] * linres[j + 1]
                j += 1
            }
        }
else if rtype == 2 {
            res += xscols[0] * linres[1]
        }
else {
            res += xscols[0] * linres[1]
        }
        return ValNumber(res)
    }
    return ValNumber(linres[0] + 1 * linres[1])
}

FnGrowth :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    groups: int = ArgGroupCount(args,marks,count)
    gx0: int = 0
    gl0: int = 0
    gx1: int = 0
    gl1: int = 0
    gx2: int = 0
    gl2: int = 0
    gx3: int = 0
    gl3: int = 0
    ys: [64] double = {0}
    xs: [64] double = {0}
    nxs: [64] double = {0}
    xsst: [17][64] double = {0}
    expres: [17] double = {0}
    n: int = 0
    nx2: int = 0
    affine: int = 1
    regres: int = 0
    i: int = 0
    if groups < 1 { return ValError(ERR_VALUE) }
    if groups > 4 { return ValError(ERR_NA) }
    GroupBounds(marks,count,0,&gx0,&gl0)
    n = CollectStrictGroup(args,gx0,gl0,ys)
    if n == -1 { return ValError(args[gx0].err) }
    if n < -1 { return ValError(ERR_VALUE) }
    if n < 1 || n > 64 { return ValError(ERR_VALUE) }
    if groups >= 2 {
        GroupBounds(marks,count,1,&gx1,&gl1)
        if gl1 >= 1 && args[gx1].kind == VAL_EMPTY { return ValError(ERR_REF) }
        nx2 = CollectStrictGroup(args,gx1,gl1,xs)
        if nx2 == -1 { return ValError(args[gx1].err) }
        if nx2 < -1 { return ValError(ERR_VALUE) }
        if nx2 != n { return ValError(ERR_NUM) }
    }
else {
        i = 0
        while i < n {
            xs[i] = i + 1
            i += 1
        }
    }
    if groups >= 3 {
        GroupBounds(marks,count,2,&gx2,&gl2)
        nx2 = CollectStrictGroup(args,gx2,gl2,nxs)
        if nx2 == -1 { return ValError(args[gx2].err) }
        if nx2 < -1 { return ValError(ERR_VALUE) }
    }
else {
        i = 0
        while i < n {
            nxs[i] = xs[i]
            i += 1
        }
        nx2 = n
    }
    if nx2 < 1 { return ValError(ERR_NUM) }
    if groups >= 4 {
        GroupBounds(marks,count,3,&gx3,&gl3)
        if gl3 >= 1 { affine = CoerceNumber(&args[gx3]) != 0 ? 1 : 0 }
    }
    i = 0
    while i < n {
        if ys[i] <= 0 { return ValError(ERR_NUM) }
        ys[i] = log(ys[i])
        xsst[1][i] = xs[i]
        i += 1
    }
    if affine != 0 {
        i = 0
        while i < n {
            xsst[0][i] = 1
            i += 1
        }
        regres = GenLinReg(&xsst[0][0],2,ys,n,1,expres)
    }
else {
        expres[0] = 0
        regres = GenLinReg(&xsst[1][0],1,ys,n,0,&expres[1])
    }
    if regres != 0 { return ValError(ERR_NUM) }
    i = 0
    while i < 2 {
        expres[i] = exp(expres[i])
        i += 1
    }
    return ValNumber(pow(expres[1],nxs[0]) * expres[0])
}



WorkbookLoadFile :: (wb: Workbook *, path: const char *) -> int {
    raw: unsigned char * = NULL
    bytes: unsigned char * = NULL
    size: int = 0
    text: char * = NULL
    is_gzip: int = 0
    ok: int = 0
    raw = LoadFileData(path,&size)
    if raw == NULL { return 0 }
    bytes = malloc(size + 1)
    if bytes == NULL { UnloadFileData(raw); return 0 }
    if size > 0 { memcpy(bytes,raw,size) }
    bytes[size] = 0
    UnloadFileData(raw)
    is_gzip = kry_gzip_is(bytes,(unsigned long)size)
    if (is_gzip) {
        inflated_len: unsigned long = 0
        text = (char *)kry_gzip_decompress(bytes,(unsigned long)size,&inflated_len)
        UnloadFileData(bytes)
        if text == NULL { return 0 }
    }
else {
        text = (char *)bytes
    }
    ok = 0
    if strncmp(text,"<?xml",5) == 0 || strstr(text,"<gnm:Workbook") != NULL || strstr(text,"<Workbook") != NULL {
        ok = ParseGnumericXml(wb,text)
    }
else {
        ok = ParseCsvIntoSheet(wb,text)
    }
    if (is_gzip) { free(text) }
else { UnloadFileData((unsigned char *)text) }
    if (ok) {
        WorkbookEvaluate(wb)
        return 1
    }
    return 0
}

ParseGnumericXml :: (wb: Workbook *, text: const char *) -> int {
    root: KryXml * = kry_xml_parse(text)
    sheets_node: KryXml * = NULL
    i: int = 0
    if root == NULL { return 0 }
    sheets_node = kry_xml_find_local(root,"Sheets")
    if sheets_node == NULL {
        kry_xml_free(root)
        return 0
    }
    i = 0
    while i < sheets_node->count {
        sheet_node: KryXml * = kry_xml_child(sheets_node,i)
        if sheet_node != NULL && strcmp(kry_xml_name_local(sheet_node),"Sheet") == 0 {
            ParseGnumericSheet(wb,sheet_node)
        }
        i += 1
    }
    kry_xml_free(root)
    return wb->sheet_count > 0
}

ParseGnumericSheet :: (wb: Workbook *, node: KryXml *) {
    name_node: KryXml * = kry_xml_find_local(node,"Name")
    name: [128] char = "Sheet"
    cells_node: KryXml * = NULL
    i: int = 0
    if name_node != NULL {
        snprintf(name,sizeof(name),"%s",kry_xml_text(name_node))
    }
    if WorkbookFindSheet(wb,name) != NULL { return }
    sheet: Sheet * = WorkbookAddSheet(wb,name)
    if sheet == NULL { return }
    cells_node = kry_xml_find_local(node,"Cells")
    if cells_node == NULL { return }
    i = 0
    while i < cells_node->count {
        cell_node: KryXml * = kry_xml_child(cells_node,i)
        if cell_node != NULL {
            ParseGnumericCell(sheet,cell_node)
        }
        i += 1
    }
    SheetExtent(sheet)
}

ParseGnumericCell :: (sheet: Sheet *, node: KryXml *) {
    row: long = kry_xml_attr_long(node,"Row",-1)
    col: long = kry_xml_attr_long(node,"Col",-1)
    type_attr: CString = kry_xml_attr(node,"ValueType")
    value_type: long = type_attr != NULL ? strtol(type_attr,NULL,10) : -1
    content: CString = kry_xml_text(node)
    cell: Cell* = NULL
    if row < 0 || col < 0 || row >= WB_MAX_ROWS || col >= WB_MAX_COLS { return }
    cell = CellObtain(sheet,(int)row,(int)col)
    if cell == NULL { return }
    if value_type == 10 || (value_type == -1 && content[0] != '=') {
        SheetDrop(sheet,(int)row,(int)col)
        return
    }
    wb_replace_text(&cell->serialized,content)
    if content[0] == '=' && value_type == -1 {
        wb_replace_text(&cell->text,content)
        cell->kind = CELL_FORMULA
        cell->computed = 0
        return
    }
    if value_type == 20 {
        cell->kind = CELL_LITERAL
        cell->cached_kind = VAL_BOOL
        cell->cached_number = strcmp(content,"TRUE") == 0 ? 1 : 0
        wb_replace_text(&cell->text,content)
        return
    }
    if value_type == 30 || value_type == 40 {
        cell->kind = CELL_LITERAL
        cell->cached_kind = VAL_FLOAT
        cell->cached_number = strtod(content,NULL)
        wb_replace_text(&cell->text,content)
        return
    }
    if value_type == 50 {
        cell->kind = CELL_LITERAL
        cell->cached_kind = VAL_ERROR
        cell->cached_err = ErrFromText(content)
        wb_replace_text(&cell->text,content)
        return
    }
    if value_type == 60 {
        cell->kind = CELL_LITERAL
        cell->cached_kind = VAL_STRING
        wb_replace_text(&cell->text,content)
        wb_replace_text(&cell->cached_text,content)
        return
    }
    wb_replace_text(&cell->text,content)
    ClassifyCell(cell)
}

WorkbookWriteGnumeric :: (wb: Workbook *, path: const char *) -> int {
    buf: KryXmlBuf = {0}
    ok: int = 0
    sheet_index: int = 0
    kry_xml_buf_raw(&buf,"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n")
    kry_xml_buf_raw(&buf,"<gnm:Workbook xmlns:gnm=\"http://www.gnumeric.org/v10.dtd\">\n")
    kry_xml_buf_raw(&buf,"  <gnm:Version Epoch=\"1\" Major=\"12\" Minor=\"57\" Full=\"1.12.57\"/>\n")
    kry_xml_buf_raw(&buf,"  <gnm:SheetNameIndex>\n")
    sheet_index = 0
    while sheet_index < wb->sheet_count {
        kry_xml_buf_raw(&buf,"    <gnm:SheetName gnm:Cols=\"256\" gnm:Rows=\"65536\">")
        kry_xml_buf_esc(&buf,wb->sheets[sheet_index].name)
        kry_xml_buf_raw(&buf,"</gnm:SheetName>\n")
        sheet_index += 1
    }
    kry_xml_buf_raw(&buf,"  </gnm:SheetNameIndex>\n")
    kry_xml_buf_raw(&buf,"  <gnm:Sheets>\n")
    sheet_index = 0
    while sheet_index < wb->sheet_count {
        WriteGnumericSheet(&buf,&wb->sheets[sheet_index])
        sheet_index += 1
    }
    kry_xml_buf_raw(&buf,"  </gnm:Sheets>\n")
    kry_xml_buf_raw(&buf,"  <gnm:UIData SelectedTab=\"0\"/>\n")
    kry_xml_buf_raw(&buf,"</gnm:Workbook>\n")
    ok = SaveFileText(path,kry_xml_buf_finish(&buf)) ? 1 : 0
    kry_xml_buf_free(&buf)
    return ok
}

WriteGnumericSheet :: (buf: KryXmlBuf *, sheet: Sheet *) {
    tmp: [32] char = ""
    kry_xml_buf_raw(buf,"    <gnm:Sheet>\n      <gnm:Name>")
    kry_xml_buf_esc(buf,sheet->name)
    kry_xml_buf_raw(buf,"</gnm:Name>\n")
    FormatNumber(sheet->max_col > 0 ? sheet->max_col : 0,tmp,sizeof(tmp))
    kry_xml_buf_raw(buf,"      <gnm:MaxCol>")
    kry_xml_buf_raw(buf,tmp)
    kry_xml_buf_raw(buf,"</gnm:MaxCol>\n")
    FormatNumber(sheet->max_row > 0 ? sheet->max_row : 0,tmp,sizeof(tmp))
    kry_xml_buf_raw(buf,"      <gnm:MaxRow>")
    kry_xml_buf_raw(buf,tmp)
    kry_xml_buf_raw(buf,"</gnm:MaxRow>\n")
    kry_xml_buf_raw(buf,"      <gnm:Cells>\n")
    i: int = 0
    while i < sheet->cell_count {
        cell: Cell * = &sheet->cells[i]
        if cell->text != NULL && cell->text[0] != 0 {
            WriteGnumericCell(buf,cell)
        }
        i += 1
    }
    kry_xml_buf_raw(buf,"      </gnm:Cells>\n")
    kry_xml_buf_raw(buf,"      <gnm:SheetLayout TopLeft=\"A1\"/>\n")
    kry_xml_buf_raw(buf,"    </gnm:Sheet>\n")
}

WriteGnumericCell :: (buf: KryXmlBuf *, cell: Cell *) {
    row: int = CellKeyRow(cell->key)
    col: int = CellKeyCol(cell->key)
    tmp: [32] char = ""
    out: [64] char = ""
    kry_xml_buf_raw(buf,"        <gnm:Cell Row=\"")
    FormatNumber(row,tmp,sizeof(tmp))
    kry_xml_buf_raw(buf,tmp)
    kry_xml_buf_raw(buf,"\" Col=\"")
    FormatNumber(col,tmp,sizeof(tmp))
    kry_xml_buf_raw(buf,tmp)
    kry_xml_buf_raw(buf,"\"")
    if cell->kind == CELL_FORMULA {
        kry_xml_buf_raw(buf,">")
        kry_xml_buf_esc(buf,cell->text)
        kry_xml_buf_raw(buf,"</gnm:Cell>\n")
        return
    }
    if cell->cached_kind == VAL_BOOL {
        kry_xml_buf_raw(buf," ValueType=\"20\">")
        kry_xml_buf_esc(buf,cell->cached_number != 0 ? "TRUE" : "FALSE")
        kry_xml_buf_raw(buf,"</gnm:Cell>\n")
        return
    }
    if cell->cached_kind == VAL_FLOAT {
        FormatNumber(cell->cached_number,out,sizeof(out))
        if cell->serialized != NULL && TextLooksNumeric(cell->serialized) {
            snprintf(out,sizeof(out),"%s",cell->serialized)
        }
        kry_xml_buf_raw(buf," ValueType=\"40\">")
        kry_xml_buf_esc(buf,out)
        kry_xml_buf_raw(buf,"</gnm:Cell>\n")
        return
    }
    if cell->cached_kind == VAL_ERROR {
        kry_xml_buf_raw(buf," ValueType=\"50\">")
        kry_xml_buf_esc(buf,ErrText(cell->cached_err))
        kry_xml_buf_raw(buf,"</gnm:Cell>\n")
        return
    }
    kry_xml_buf_raw(buf," ValueType=\"60\">")
    kry_xml_buf_esc(buf,cell->text != NULL ? cell->text : "")
    kry_xml_buf_raw(buf,"</gnm:Cell>\n")
}

ParseCsvIntoSheet :: (wb: Workbook *, text: const char *) -> int {
    sheet: Sheet * = WorkbookAddSheet(wb,"Sheet1")
    pos: int = 0
    row: int = 0
    col: int = 0
    if sheet == NULL { return 0 }
    while text[pos] != 0 {
        field: [WB_TEXT_MAX] char = ""
        n: int = 0
        if text[pos] == '"' {
            pos += 1
            while text[pos] != 0 {
                if text[pos] == '"' {
                    if text[pos + 1] == '"' {
                        if n < (int)sizeof(field) - 1 { field[n] = '"'; n += 1 }
                        pos += 2
                        continue
                    }
                    pos += 1
                    break
                }
                if n < (int)sizeof(field) - 1 { field[n] = text[pos]; n += 1 }
                pos += 1
            }
        }
else {
            while text[pos] != 0 && text[pos] != ',' && text[pos] != '\n' && text[pos] != '\r' {
                if n < (int)sizeof(field) - 1 { field[n] = text[pos]; n += 1 }
                pos += 1
            }
        }
        field[n] = 0
        if field[0] != 0 {
            SetCellText(wb,wb->sheet_count - 1,row,col,field)
        }
        if text[pos] == ',' { col += 1; pos += 1; continue }
        if text[pos] == '\r' { pos += 1 }
        if text[pos] == '\n' { pos += 1 }
        row += 1
        col = 0
    }
    SheetExtent(sheet)
    return 1
}

CsvNeedsQuotes :: (text: const char *) -> int {
    i: int = 0
    while text[i] != 0 {
        c: char = text[i]
        if c == ',' || c == '"' || c == ' ' || c == '\n' || c == '\r' { return 1 }
        i += 1
    }
    return 0
}

WriteCsvField :: (buf: KryXmlBuf *, text: const char *) {
    if !CsvNeedsQuotes(text) {
        kry_xml_buf_raw(buf,text)
        return
    }
    kry_xml_buf_raw(buf,"\"")
    i: int = 0
    while text[i] != 0 {
        if text[i] == '"' {
            kry_xml_buf_raw(buf,"\"\"")
        }
else {
            one: [2] char = ""
            one[0] = text[i]
            kry_xml_buf_raw(buf,one)
        }
        i += 1
    }
    kry_xml_buf_raw(buf,"\"")
}

WorkbookExportCsv :: (wb: Workbook *, path: const char *) -> int {
    buf: KryXmlBuf = {0}
    ok: int = 0
    if wb->sheet_count == 0 { return 0 }
    sheet: Sheet * = &wb->sheets[0]
    min_col: int = WB_MAX_COLS
    min_row: int = WB_MAX_ROWS
    max_col: int = -1
    max_row: int = -1
    r: int = 0
    c: int = 0
    r = 0
    while r <= sheet->max_row {
        c = 0
        while c <= sheet->max_col {
            cell: Cell * = CellAt(sheet,r,c)
            display: [WB_TEXT_MAX] char = ""
            v: Val = {0}
            if cell == NULL { c += 1; continue }
            CellDisplayText(cell,display,sizeof(display))
            if display[0] != 0 {
                if c < min_col { min_col = c }
                if r < min_row { min_row = r }
                if c > max_col { max_col = c }
                if r > max_row { max_row = r }
            }
            c += 1
        }
        r += 1
    }
    if max_row < 0 {
        return SaveFileText(path,"") ? 1 : 0
    }
    r = min_row
    while r <= max_row {
        c = min_col
        while c <= max_col {
            if c > min_col { kry_xml_buf_raw(&buf,",") }
            cell: Cell * = CellAt(sheet,r,c)
            display: [WB_TEXT_MAX] char = ""
            v: Val = {0}
            if cell != NULL {
                CellDisplayText(cell,display,sizeof(display))
            }
else {
                display[0] = 0
            }
            WriteCsvField(&buf,display)
            c += 1
        }
        kry_xml_buf_raw(&buf,"\n")
        r += 1
    }
    ok = SaveFileText(path,kry_xml_buf_finish(&buf)) ? 1 : 0
    kry_xml_buf_free(&buf)
    return ok
}

WorkbookSheetCount :: (wb: Workbook *) -> int {
    return wb->sheet_count
}

WorkbookSheetName :: (wb: Workbook *, index: int) -> CString {
    if index < 0 || index >= wb->sheet_count { return "" }
    return wb->sheets[index].name
}

WorkbookSheetColumns :: (wb: Workbook *, index: int) -> int {
    if index < 0 || index >= wb->sheet_count { return 0 }
    return wb->sheets[index].max_col + 1
}

WorkbookSheetRows :: (wb: Workbook *, index: int) -> int {
    if index < 0 || index >= wb->sheet_count { return 0 }
    return wb->sheets[index].max_row + 1
}

WorkbookSetCell :: (wb: Workbook *, sheet_index: int, row: int, col: int, text: const char *) -> int {
    return SetCellText(wb,sheet_index,row,col,text)
}

WorkbookCellText :: (wb: Workbook *, index: int, row: int, col: int) -> CString {
    cell: Cell* = NULL
    if index < 0 || index >= wb->sheet_count { return "" }
    cell = CellAt(&wb->sheets[index],row,col)
    if cell == NULL { return "" }
    return cell->text != NULL ? cell->text : ""
}

WorkbookCellDisplay :: (wb: Workbook *, index: int, row: int, col: int, out: char *, cap: int) {
    cell: Cell* = NULL
    v: Val = {0}
    if index < 0 || index >= wb->sheet_count { out[0] = 0; return }
    cell = CellAt(&wb->sheets[index],row,col)
    if cell == NULL { out[0] = 0; return }
    v.kind = cell->cached_kind
    v.number = cell->cached_number
    v.text = cell->cached_text
    v.err = cell->cached_err
    v.from_range = 0
    WbCellValueText(&v,out,cap)
}
