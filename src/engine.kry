/* == lfbaccdif == */
lfbaccdif :: (a: double, b: double) -> double {
    if a > (0.03) * (a + b) {
        return logfbit (a + b) - logfbit (b)
    } else {
        a2: double = a * a
        ab2: double = a / 2 + b
        return a * (logfbit1 (ab2) + a2 / 24 *
			    (logfbit3 (ab2) + a2 / 80 *
			     (logfbit5 (ab2) + a2 / 168 *
			      logfbit7 (ab2))))
    }
}

/* == compbfunc == */
compbfunc :: (x: double, a: double, b: double) -> double {
    sumAcc: double = (5E-16)
    term: double = x
    d: double = 2
    sum: double = term / (a + 1)
    while fabs (term) > fabs (sum * sumAcc) {
        term *= (d - b) * x / d
        sum += term / (a + d)
        d += 1
    }
    return a * (b - 1) * sum
}

/* == tdistexp == */
tdistexp :: (p: double, q: double, logqk2: double, k: double, log_p: int, approxtdistDens: double *) -> double {
    sumAcc: double = (5E-16)
    cfVSmall: double = (1.0e-14)
    lstpi: double = log (2 * 3.141592653589793238462643383279502884197169399375105820974944592307816406286208998628034825342117) / 2
    if floor (k / 2) * 2 == k {
        ldens: double = logqk2 + logfbit (k - 1) - 2 * logfbit (k * (0.5) - 1) - lstpi
        *approxtdistDens = exp(ldens)
    } else {
        ldens: double = logqk2 + k * Log1pmx(1 / k) + 2 * logfbit ((k - 1) * (0.5)) - logfbit (k - 1) - lstpi
        *approxtdistDens = exp(ldens)
    }
    if k * p < 4 * q {
        sum: double = 0
        aki: double = k + 1
        ai: double = 3
        term: double = aki * p / ai
        while term > sumAcc * sum {
            sum += term
            ai += 2
            aki += 2
            term *= aki * p / ai
        }
        sum += term
        return log_p
			? logspace_sub_go(-0.693147180559945309417232121458, *approxtdistDens + log1p (sum) + log (k * p) / 2)
			: (0.5) - *approxtdistDens * (sum + 1) * sqrt (k * p)
    } else {
        q1: double = 2 * (1 + q)
        q8: double = 8 * q
        a1: double = 0
        b1: double = 1
        c1: double = -6 * q
        a2: double = 1
        b2: double = (k - 1) * p + 3
        cadd: double = -14 * q
        c2: double = b2 + q1
        while fabs (a2 * b1 - a1 * b2) > fabs (cfVSmall * b1 * b2) {
            a1 = c2 * a2 + c1 * a1
            b1 = c2 * b2 + c1 * b1
            c1 += cadd
            cadd -= q8
            c2 += q1
            a2 = c2 * a1 + c1 * a2
            b2 = c2 * b1 + c1 * b2
            c1 += cadd
            cadd -= q8
            c2 += q1
            if fabs (b2) > (115792089237316195423570985008687907853269984665640564039457584007913129639936.0) {
                a1 *= 1 / (115792089237316195423570985008687907853269984665640564039457584007913129639936.0)
                b1 *= 1 / (115792089237316195423570985008687907853269984665640564039457584007913129639936.0)
                a2 *= 1 / (115792089237316195423570985008687907853269984665640564039457584007913129639936.0)
                b2 *= 1 / (115792089237316195423570985008687907853269984665640564039457584007913129639936.0)
            } else if fabs (b2) < 1 / (115792089237316195423570985008687907853269984665640564039457584007913129639936.0) {
                a1 *= (115792089237316195423570985008687907853269984665640564039457584007913129639936.0)
                b1 *= (115792089237316195423570985008687907853269984665640564039457584007913129639936.0)
                a2 *= (115792089237316195423570985008687907853269984665640564039457584007913129639936.0)
                b2 *= (115792089237316195423570985008687907853269984665640564039457584007913129639936.0)
            }
        }
        return log_p
			? *approxtdistDens + log1p (-q * a2 / b2) - log (k * p) / 2
			: *approxtdistDens * (1 - q * a2 / b2) / sqrt (k * p)
    }
}

/* == logspace_signed_add == */
logspace_signed_add :: (logx: double, logabsy: double, ypos: int) -> double {
    return ypos
		? logspace_add_go(logx, logabsy)
		: logspace_sub_go(logx, logabsy)
}

/* == binomialTerm == */
binomialTerm :: (i: double, j: double, p: double, q: double, diffFromMean: double, log_p: int) -> double {
    minLog1Value: double = (-0.79149064)
    c1: double = 0
    c2: double = 0
    c3: double = 0
    c4: double = 0
    c5: double = 0
    c6: double = 0
    ps: double = 0
    logbinomialTerm: double = 0
    dfm: double = 0
    t: double = 0
    if i == 0 && j <= 0 {
        return 1.0
    }
    if i <= -1 || j < 0 {
        return 0.0
    }
    c1 = (i + 1) + j
    if p < q {
        c2 = i
        c3 = j
        ps = p
        dfm = diffFromMean
    } else {
        c3 = i
        c2 = j
        ps = q
        dfm = -diffFromMean
    }
    c5 = (dfm - (1 - ps)) / (c2 + 1)
    c6 = -(dfm + ps) / (c3 + 1)
    if c5 < minLog1Value {
        if c2 == 0 {
            logbinomialTerm = c3 * log1p (-ps)
            return log_p ? logbinomialTerm : exp (logbinomialTerm)
        } else if ps == 0 && c2 > 0 {
            return 0.0
        } else {
            t = log ((ps * c1) / (c2 + 1)) - c5
        }
    } else {
        t = Log1pmx(c5)
    }
    c4 = logfbit (i + j) - logfbit (i) - logfbit (j)
    logbinomialTerm = c4 + c2 * t - c5 + (c3 * Log1pmx(c6) - c6)
    return log_p
		? logbinomialTerm + (0.5) * log (c1 / ((c2 + 1) * (c3 + 1) * 2 * 3.141592653589793238462643383279502884197169399375105820974944592307816406286208998628034825342117))
		: exp (logbinomialTerm) * sqrt (c1 / ((c2 + 1) * (c3 + 1) * 2 * 3.141592653589793238462643383279502884197169399375105820974944592307816406286208998628034825342117))
}

/* == logfbit == */
logfbitdif :: (x: double) -> double {
    y: double = 1 / (2 * x + 3)
