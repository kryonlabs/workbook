FnSumIf :: (st: EvalState *, args: Val *, count: int, marks: int *, average: int) -> Val {
    groups: int = ArgGroupCount(args,marks,count)
    start0: int = 0
    len0: int = 0
    start1: int = 0
    len1: int = 0
    start2: int = 0
    len2: int = 0
    criterion: Val* = NULL
    total: double = 0
    matched: int = 0
    i: int = 0
    if groups < 2 { return ValError(ERR_VALUE) }
    GroupBounds(marks,count,0,&start0,&len0)
    GroupBounds(marks,count,1,&start1,&len1)
    if groups >= 3 { GroupBounds(marks,count,2,&start2,&len2) }
    if len1 != 1 { return ValError(ERR_VALUE) }
    criterion = &args[start1]
    i = 0
    while i < len0 {
        hit: int = CriterionMatch(criterion,&args[start0 + i])
        if hit < 0 { return ValError(ERR_VALUE) }
        if (hit) {
            value: Val * = NULL
            if groups >= 3 && i < len2 {
                value = &args[start2 + i]
            }
else {
                value = &args[start0 + i]
            }
            if value->kind == VAL_FLOAT {
                total += value->number
                matched += 1
            }
        }
        i += 1
    }
    if (average) {
        if matched == 0 { return ValError(ERR_DIV0) }
        return ValNumber(total / matched)
    }
    return ValNumber(total)
}

FnCountIf :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    groups: int = ArgGroupCount(args,marks,count)
    start0: int = 0
    len0: int = 0
    start1: int = 0
    len1: int = 0
    criterion: Val* = NULL
    matched: int = 0
    i: int = 0
    if groups < 2 { return ValError(ERR_VALUE) }
    GroupBounds(marks,count,0,&start0,&len0)
    GroupBounds(marks,count,1,&start1,&len1)
    if len1 != 1 { return ValError(ERR_VALUE) }
    criterion = &args[start1]
    i = 0
    while i < len0 {
        hit: int = CriterionMatch(criterion,&args[start0 + i])
        if hit < 0 { return ValError(ERR_VALUE) }
        if (hit) { matched += 1 }
        i += 1
    }
    return ValNumber(matched)
}



WorkbookLoadFile :: (wb: Workbook *, path: const char *) -> int {
    raw: unsigned char * = NULL
    bytes: unsigned char * = NULL
    size: int = 0
    text: char * = NULL
    is_gzip: int = 0
    ok: int = 0
    raw = LoadFileData(path,&size)
    if raw == NULL { return 0 }
    bytes = malloc(size + 1)
    if bytes == NULL { UnloadFileData(raw); return 0 }
    if size > 0 { memcpy(bytes,raw,size) }
    bytes[size] = 0
    UnloadFileData(raw)
    is_gzip = kry_gzip_is(bytes,(unsigned long)size)
    if (is_gzip) {
        inflated_len: unsigned long = 0
        text = (char *)kry_gzip_decompress(bytes,(unsigned long)size,&inflated_len)
        UnloadFileData(bytes)
        if text == NULL { return 0 }
    }
else {
        text = (char *)bytes
    }
    ok = 0
    if strncmp(text,"<?xml",5) == 0 || strstr(text,"<gnm:Workbook") != NULL || strstr(text,"<Workbook") != NULL {
        ok = ParseGnumericXml(wb,text)
    }
else {
        ok = ParseCsvIntoSheet(wb,text)
    }
    if (is_gzip) { free(text) }
else { UnloadFileData((unsigned char *)text) }
    if (ok) {
        WorkbookEvaluate(wb)
        return 1
    }
    return 0
}

ParseGnumericXml :: (wb: Workbook *, text: const char *) -> int {
    root: KryXml * = kry_xml_parse(text)
    sheets_node: KryXml * = NULL
    i: int = 0
    if root == NULL { return 0 }
    sheets_node = kry_xml_find_local(root,"Sheets")
    if sheets_node == NULL {
        kry_xml_free(root)
        return 0
    }
    i = 0
    while i < sheets_node->count {
        sheet_node: KryXml * = kry_xml_child(sheets_node,i)
        if sheet_node != NULL && strcmp(kry_xml_name_local(sheet_node),"Sheet") == 0 {
            ParseGnumericSheet(wb,sheet_node)
        }
        i += 1
    }
    kry_xml_free(root)
    return wb->sheet_count > 0
}

ParseGnumericSheet :: (wb: Workbook *, node: KryXml *) {
    name_node: KryXml * = kry_xml_find_local(node,"Name")
    name: [128] char = "Sheet"
    cells_node: KryXml * = NULL
    i: int = 0
    if name_node != NULL {
        snprintf(name,sizeof(name),"%s",kry_xml_text(name_node))
    }
    if WorkbookFindSheet(wb,name) != NULL { return }
    sheet: Sheet * = WorkbookAddSheet(wb,name)
    if sheet == NULL { return }
    cells_node = kry_xml_find_local(node,"Cells")
    if cells_node == NULL { return }
    i = 0
    while i < cells_node->count {
        cell_node: KryXml * = kry_xml_child(cells_node,i)
        if cell_node != NULL {
            ParseGnumericCell(sheet,cell_node)
        }
        i += 1
    }
    SheetExtent(sheet)
}

ParseGnumericCell :: (sheet: Sheet *, node: KryXml *) {
    row: long = kry_xml_attr_long(node,"Row",-1)
    col: long = kry_xml_attr_long(node,"Col",-1)
    type_attr: CString = kry_xml_attr(node,"ValueType")
    value_type: long = type_attr != NULL ? strtol(type_attr,NULL,10) : -1
    content: CString = kry_xml_text(node)
    cell: Cell* = NULL
    if row < 0 || col < 0 || row >= WB_MAX_ROWS || col >= WB_MAX_COLS { return }
    cell = CellObtain(sheet,(int)row,(int)col)
    if cell == NULL { return }
    if value_type == 10 || (value_type == -1 && content[0] != '=') {
        SheetDrop(sheet,(int)row,(int)col)
        return
    }
    wb_replace_text(&cell->serialized,content)
    if content[0] == '=' {
        wb_replace_text(&cell->text,content)
        cell->kind = CELL_FORMULA
        cell->computed = 0
        return
    }
    if value_type == 20 {
        cell->kind = CELL_LITERAL
        cell->cached_kind = VAL_BOOL
        cell->cached_number = strcmp(content,"TRUE") == 0 ? 1 : 0
        wb_replace_text(&cell->text,content)
        return
    }
    if value_type == 30 || value_type == 40 {
        cell->kind = CELL_LITERAL
        cell->cached_kind = VAL_FLOAT
        cell->cached_number = strtod(content,NULL)
        wb_replace_text(&cell->text,content)
        return
    }
    if value_type == 50 {
        cell->kind = CELL_LITERAL
        cell->cached_kind = VAL_ERROR
        cell->cached_err = ErrFromText(content)
        wb_replace_text(&cell->text,content)
        return
    }
    if value_type == 60 {
        cell->kind = CELL_LITERAL
        cell->cached_kind = VAL_STRING
        wb_replace_text(&cell->text,content)
        wb_replace_text(&cell->cached_text,content)
        return
    }
    wb_replace_text(&cell->text,content)
    ClassifyCell(cell)
}

WorkbookWriteGnumeric :: (wb: Workbook *, path: const char *) -> int {
    buf: KryXmlBuf = {0}
    ok: int = 0
    sheet_index: int = 0
    kry_xml_buf_raw(&buf,"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n")
    kry_xml_buf_raw(&buf,"<gnm:Workbook xmlns:gnm=\"http://www.gnumeric.org/v10.dtd\">\n")
    kry_xml_buf_raw(&buf,"  <gnm:Version Epoch=\"1\" Major=\"12\" Minor=\"57\" Full=\"1.12.57\"/>\n")
    kry_xml_buf_raw(&buf,"  <gnm:SheetNameIndex>\n")
    sheet_index = 0
    while sheet_index < wb->sheet_count {
        kry_xml_buf_raw(&buf,"    <gnm:SheetName gnm:Cols=\"256\" gnm:Rows=\"65536\">")
        kry_xml_buf_esc(&buf,wb->sheets[sheet_index].name)
        kry_xml_buf_raw(&buf,"</gnm:SheetName>\n")
        sheet_index += 1
    }
    kry_xml_buf_raw(&buf,"  </gnm:SheetNameIndex>\n")
    kry_xml_buf_raw(&buf,"  <gnm:Sheets>\n")
    sheet_index = 0
    while sheet_index < wb->sheet_count {
        WriteGnumericSheet(&buf,&wb->sheets[sheet_index])
        sheet_index += 1
    }
    kry_xml_buf_raw(&buf,"  </gnm:Sheets>\n")
    kry_xml_buf_raw(&buf,"  <gnm:UIData SelectedTab=\"0\"/>\n")
    kry_xml_buf_raw(&buf,"</gnm:Workbook>\n")
    ok = SaveFileText(path,kry_xml_buf_finish(&buf)) ? 1 : 0
    kry_xml_buf_free(&buf)
    return ok
}

WriteGnumericSheet :: (buf: KryXmlBuf *, sheet: Sheet *) {
    tmp: [32] char = ""
    kry_xml_buf_raw(buf,"    <gnm:Sheet>\n      <gnm:Name>")
    kry_xml_buf_esc(buf,sheet->name)
    kry_xml_buf_raw(buf,"</gnm:Name>\n")
    FormatNumber(sheet->max_col > 0 ? sheet->max_col : 0,tmp,sizeof(tmp))
    kry_xml_buf_raw(buf,"      <gnm:MaxCol>")
    kry_xml_buf_raw(buf,tmp)
    kry_xml_buf_raw(buf,"</gnm:MaxCol>\n")
    FormatNumber(sheet->max_row > 0 ? sheet->max_row : 0,tmp,sizeof(tmp))
    kry_xml_buf_raw(buf,"      <gnm:MaxRow>")
    kry_xml_buf_raw(buf,tmp)
    kry_xml_buf_raw(buf,"</gnm:MaxRow>\n")
    kry_xml_buf_raw(buf,"      <gnm:Cells>\n")
    i: int = 0
    while i < sheet->cell_count {
        cell: Cell * = &sheet->cells[i]
        if cell->text != NULL && cell->text[0] != 0 {
            WriteGnumericCell(buf,cell)
        }
        i += 1
    }
    kry_xml_buf_raw(buf,"      </gnm:Cells>\n")
    kry_xml_buf_raw(buf,"      <gnm:SheetLayout TopLeft=\"A1\"/>\n")
    kry_xml_buf_raw(buf,"    </gnm:Sheet>\n")
}

WriteGnumericCell :: (buf: KryXmlBuf *, cell: Cell *) {
    row: int = CellKeyRow(cell->key)
    col: int = CellKeyCol(cell->key)
    tmp: [32] char = ""
    out: [64] char = ""
    kry_xml_buf_raw(buf,"        <gnm:Cell Row=\"")
    FormatNumber(row,tmp,sizeof(tmp))
    kry_xml_buf_raw(buf,tmp)
    kry_xml_buf_raw(buf,"\" Col=\"")
    FormatNumber(col,tmp,sizeof(tmp))
    kry_xml_buf_raw(buf,tmp)
    kry_xml_buf_raw(buf,"\"")
    if cell->kind == CELL_FORMULA {
        kry_xml_buf_raw(buf,">")
        kry_xml_buf_esc(buf,cell->text)
        kry_xml_buf_raw(buf,"</gnm:Cell>\n")
        return
    }
    if cell->cached_kind == VAL_BOOL {
        kry_xml_buf_raw(buf," ValueType=\"20\">")
        kry_xml_buf_esc(buf,cell->cached_number != 0 ? "TRUE" : "FALSE")
        kry_xml_buf_raw(buf,"</gnm:Cell>\n")
        return
    }
    if cell->cached_kind == VAL_FLOAT {
        FormatNumber(cell->cached_number,out,sizeof(out))
        if cell->serialized != NULL && TextLooksNumeric(cell->serialized) {
            snprintf(out,sizeof(out),"%s",cell->serialized)
        }
        kry_xml_buf_raw(buf," ValueType=\"40\">")
        kry_xml_buf_esc(buf,out)
        kry_xml_buf_raw(buf,"</gnm:Cell>\n")
        return
    }
    if cell->cached_kind == VAL_ERROR {
        kry_xml_buf_raw(buf," ValueType=\"50\">")
        kry_xml_buf_esc(buf,ErrText(cell->cached_err))
        kry_xml_buf_raw(buf,"</gnm:Cell>\n")
        return
    }
    kry_xml_buf_raw(buf," ValueType=\"60\">")
    kry_xml_buf_esc(buf,cell->text != NULL ? cell->text : "")
    kry_xml_buf_raw(buf,"</gnm:Cell>\n")
}

ParseCsvIntoSheet :: (wb: Workbook *, text: const char *) -> int {
    sheet: Sheet * = WorkbookAddSheet(wb,"Sheet1")
    pos: int = 0
    row: int = 0
    col: int = 0
    if sheet == NULL { return 0 }
    while text[pos] != 0 {
        field: [WB_TEXT_MAX] char = ""
        n: int = 0
        if text[pos] == '"' {
            pos += 1
            while text[pos] != 0 {
                if text[pos] == '"' {
                    if text[pos + 1] == '"' {
                        if n < (int)sizeof(field) - 1 { field[n] = '"'; n += 1 }
                        pos += 2
                        continue
                    }
                    pos += 1
                    break
                }
                if n < (int)sizeof(field) - 1 { field[n] = text[pos]; n += 1 }
                pos += 1
            }
        }
else {
            while text[pos] != 0 && text[pos] != ',' && text[pos] != '\n' && text[pos] != '\r' {
                if n < (int)sizeof(field) - 1 { field[n] = text[pos]; n += 1 }
                pos += 1
            }
        }
        field[n] = 0
        if field[0] != 0 {
            SetCellText(wb,wb->sheet_count - 1,row,col,field)
        }
        if text[pos] == ',' { col += 1; pos += 1; continue }
        if text[pos] == '\r' { pos += 1 }
        if text[pos] == '\n' { pos += 1 }
        row += 1
        col = 0
    }
    SheetExtent(sheet)
    return 1
}

CsvNeedsQuotes :: (text: const char *) -> int {
    i: int = 0
    while text[i] != 0 {
        c: char = text[i]
        if c == ',' || c == '"' || c == ' ' || c == '\n' || c == '\r' { return 1 }
        i += 1
    }
    return 0
}

WriteCsvField :: (buf: KryXmlBuf *, text: const char *) {
    if !CsvNeedsQuotes(text) {
        kry_xml_buf_raw(buf,text)
        return
    }
    kry_xml_buf_raw(buf,"\"")
    i: int = 0
    while text[i] != 0 {
        if text[i] == '"' {
            kry_xml_buf_raw(buf,"\"\"")
        }
else {
            one: [2] char = ""
            one[0] = text[i]
            kry_xml_buf_raw(buf,one)
        }
        i += 1
    }
    kry_xml_buf_raw(buf,"\"")
}

WorkbookExportCsv :: (wb: Workbook *, path: const char *) -> int {
    buf: KryXmlBuf = {0}
    ok: int = 0
    if wb->sheet_count == 0 { return 0 }
    sheet: Sheet * = &wb->sheets[0]
    min_col: int = WB_MAX_COLS
    min_row: int = WB_MAX_ROWS
    max_col: int = -1
    max_row: int = -1
    r: int = 0
    c: int = 0
    r = 0
    while r <= sheet->max_row {
        c = 0
        while c <= sheet->max_col {
            cell: Cell * = CellAt(sheet,r,c)
            display: [WB_TEXT_MAX] char = ""
            v: Val = {0}
            if cell == NULL { c += 1; continue }
            CellDisplayText(cell,display,sizeof(display))
            if display[0] != 0 {
                if c < min_col { min_col = c }
                if r < min_row { min_row = r }
                if c > max_col { max_col = c }
                if r > max_row { max_row = r }
            }
            c += 1
        }
        r += 1
    }
    if max_row < 0 {
        return SaveFileText(path,"") ? 1 : 0
    }
    r = min_row
    while r <= max_row {
        c = min_col
        while c <= max_col {
            if c > min_col { kry_xml_buf_raw(&buf,",") }
            cell: Cell * = CellAt(sheet,r,c)
            display: [WB_TEXT_MAX] char = ""
            v: Val = {0}
            if cell != NULL {
                CellDisplayText(cell,display,sizeof(display))
            }
else {
                display[0] = 0
            }
            WriteCsvField(&buf,display)
            c += 1
        }
        kry_xml_buf_raw(&buf,"\n")
        r += 1
    }
    ok = SaveFileText(path,kry_xml_buf_finish(&buf)) ? 1 : 0
    kry_xml_buf_free(&buf)
    return ok
}

WorkbookSheetCount :: (wb: Workbook *) -> int {
    return wb->sheet_count
}

WorkbookSheetName :: (wb: Workbook *, index: int) -> CString {
    if index < 0 || index >= wb->sheet_count { return "" }
    return wb->sheets[index].name
}

WorkbookSheetColumns :: (wb: Workbook *, index: int) -> int {
    if index < 0 || index >= wb->sheet_count { return 0 }
    return wb->sheets[index].max_col + 1
}

WorkbookSheetRows :: (wb: Workbook *, index: int) -> int {
    if index < 0 || index >= wb->sheet_count { return 0 }
    return wb->sheets[index].max_row + 1
}

WorkbookSetCell :: (wb: Workbook *, sheet_index: int, row: int, col: int, text: const char *) -> int {
    return SetCellText(wb,sheet_index,row,col,text)
}

WorkbookCellText :: (wb: Workbook *, index: int, row: int, col: int) -> CString {
    cell: Cell* = NULL
    if index < 0 || index >= wb->sheet_count { return "" }
    cell = CellAt(&wb->sheets[index],row,col)
    if cell == NULL { return "" }
    return cell->text != NULL ? cell->text : ""
}

WorkbookCellDisplay :: (wb: Workbook *, index: int, row: int, col: int, out: char *, cap: int) {
    cell: Cell* = NULL
    v: Val = {0}
    if index < 0 || index >= wb->sheet_count { out[0] = 0; return }
    cell = CellAt(&wb->sheets[index],row,col)
    if cell == NULL { out[0] = 0; return }
    v.kind = cell->cached_kind
    v.number = cell->cached_number
    v.text = cell->cached_text
    v.err = cell->cached_err
    v.from_range = 0
    WbCellValueText(&v,out,cap)
}
