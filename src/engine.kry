logfbit :: (x: double) -> double {
    if x >= (1e10) {
        return 1 / (12 * (x + 1))
    } else if x >= 6 {
        x1: double = x + 1
        x2: double = 1 / (x1 * x1)
        x3: double = 0
        x3 =
			x2 * ((1.0/30) - x2 *
			      ((1.0/105) - x2 *
			       ((1.0/140) - x2 *
				((1.0/99) - x2 *
				 ((691.0/30030) - x2 *
				  ((1.0/13) - x2 *
				   (0.35068606896459316479 - x2 *
				    1.6769998201671114808)))))))
        return (1.0/12) * (1 - x3) / x1
    } else if x == 5 {
        return (0.13876128823070747998745727023762908562e-1)
    } else if x == 4 {
        return (0.16644691189821192163194865373593391145e-1)
    } else if x == 3 {
        return (0.20790672103765093111522771767848656333e-1)
    } else if x == 2 {
        return (0.27677925684998339148789292746244666596e-1)
    } else if x == 1 {
        return (0.41340695955409294093822081407117508025e-1)
    } else if x == 0 {
        return (0.81061466795327258219670263594382360138e-1)
    } else if x > -1 {
        x1: double = x
        x2: double = 0
        while x1 < 6 {
            x2 += logfbitdif (x1)
            x1 += 1
        }
        return x2 + logfbit (x1)
    } else {
        return (1e308*10)
    }
}

/* == logfbit1 == */
logfbit1dif :: (x: double) -> double {
    return (logfbitdif(x) - 1 / (4 * (x + 1) * (x + 2))) / (x + 1.5)
}

logfbit3dif :: (x: double) -> double {
    return 0 - (2 * x + 3) * pow((x + 1) * (x + 2),-3)
