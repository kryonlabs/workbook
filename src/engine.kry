			x2 * (2520 * (1.0/30) - x2 *
			      (15120 * (1.0/105) - x2 *
			       (55440 * (1.0/140) - x2 *
				(154440 * (1.0/99) - x2 *
				 (360360 * (691.0/30030) - x2 *
				  (742560 * (1.0/13) - x2 *
				   (1395360 * 0.35068606896459316479 - x2 *
				    2441880 * 1.6769998201671114808)))))))
        return -(1.0/12) * (120 - x3) * x2 * x2 * x2
    } else if x > -1 {
        x1: double = x
        x2: double = 0
        while x1 < 6 {
            x2 += logfbit5dif (x1)
            x1 += 1
        }
        return x2 + logfbit5 (x1)
    } else {
        return (-1e308*10)
    }
}

/* == logfbit7 == */
logfbit7 :: (x: double) -> double {
    if x >= (1e10) {
        return -420 * pow (x + 1, -8)
    } else if x >= 6 {
        x1: double = x + 1
        x2: double = 1 / (x1 * x1)
        x3: double = 0
        x3 =
			x2 * (181440 * (1.0/30) - x2 *
			      (1663200 * (1.0/105) - x2 *
			       (8648640 * (1.0/140) - x2 *
				(32432400 * (1.0/99) - x2 *
				 (98017920 * (691.0/30030) - x2 *
				  (253955520 * (1.0/13) - x2 *
				   (586051200 * 0.35068606896459316479 - x2 *
				    1235591280 * 1.6769998201671114808)))))))
        return -(1.0/12) * (5040 - x3) * x2 * x2 * x2 * x2
    } else if x > -1 {
        x1: double = x
        x2: double = 0
        while x1 < 6 {
            x2 += logfbit7dif (x1)
            x1 += 1
        }
        return x2 + logfbit7 (x1)
    } else {
        return (-1e308*10)
    }
}

/* == logspace_signed_add == */

/* == dt == */
dt :: (x: double, n: double, give_log: int) -> double {
    if (x) != (x) || (n) != (n) {
        return x + n
    }
    if n <= 0 {
        return (0.0/0.0)
    }
    if (isfinite(x) == 0) {
        return 0.0
    }
    if (isfinite(n) == 0) {
        return dnorm_go(x, 0, 1, give_log)
    }
    u: double = 0
    t: double = 0 - bd0(n / 2,(n + 1) / 2) + stirlerr((n + 1) / 2) - stirlerr(n / 2)
    x2n: double = x * x / n
    ax: double = 0
    l_x2n: double = 0
    lrg_x2n: int = x2n > 1 / 2.2204460492503131e-16
    if lrg_x2n {
        ax = fabs(x)
        l_x2n = log(ax) - log(n)/(2.0)
        u = 
	    n * l_x2n
    } else if x2n > (0.2) {
        l_x2n = log1p (x2n)/(2.0)
        u = n * l_x2n
    } else {
        l_x2n = log1p(x2n)/(2.0)
        u = -bd0(n/(2.0),(n+x*x)/(2.0)) + x*x/(2.0)
    }
    if give_log {
        return t-u - (0.918938533204672741780329736406 + l_x2n)
    }
    I_sqrt_: double = (lrg_x2n ? sqrt(n)/ax : exp(-l_x2n))
    return exp(t-u) * 0.398942280401432677939946059934 * I_sqrt_
}

pt :: (x: double, n: double, lower_tail: int, log_p: int) -> double {
    val: double = 0
    nx: double = 0
    if (x) != (x) || (n) != (n) {
        return x + n
    }
    if n <= 0 {
        return (0.0/0.0)
    }
    if (isfinite(x) == 0) {
        return (x < 0) ? (lower_tail != 0 ? 0.0 : 1.0) : (lower_tail != 0 ? 1.0 : 0.0)
    }
    if (isfinite(n) == 0) {
        return pnorm(x, (0.0), (1.0), lower_tail, log_p)
    }
    if n > (4e5) {
        val = (1.0)/((4.0)*n)
        return pnorm(x*((1.0) - val)/sqrt((1.0) + x*x*(2.0)*val), (0.0), (1.0),
		     lower_tail, log_p)
    }
    nx = 1 + (x/n)*x
    if nx > (1e100) {
        lval: double = 0
        lval = (-0.5)*n*(2*log(fabs(x)) - log(n))
		- lbeta_go((0.5)*n, (0.5)) - log((0.5)*n)
        val = log_p ? lval : exp(lval)
    } else {
        val = (n > x * x)
	    ? pbeta(x * x / (n + x * x), (0.5), n / (2.0),               0, log_p)
	    : pbeta((1.0) / nx,             n / (2.0), (0.5),               1, log_p)
    }
    if x <= 0 {
        lower_tail = (lower_tail == 0)
    }
    if log_p != 0 {
        if lower_tail {
            return log1p((-0.5)*exp(val))
        } else {
            return val - 0.693147180559945309417232121458
        }
    } else {
        val /= 2
        return (lower_tail != 0 ? 1 - val : val)
    }
}

/* == qt == */
dt_go :: (x: double, n: double, give_log: int) -> double {
    u: double = 0
    t: double = 0
    x2n: double = 0
    ax: double = 0
    l_x2n: double = 0
    lrg_x2n: int = 0
    if (x != x || n != n) {
        return x + n
    }
    if n <= 0 {
        return 0.0 / 0.0
    }
    if isfinite(x) == 0 {
        return 0.0
    }
    if isfinite(n) == 0 {
        return dnorm_go(x,0,1,give_log)
    }
    t = 0 - bd0(n / 2,(n + 1) / 2) + stirlerr((n + 1) / 2) - stirlerr(n / 2)
    x2n = x * x / n
    ax = 0
    l_x2n = 0
    lrg_x2n = x2n > 1 / 2.2204460492503131e-16 ? 1 : 0
    if lrg_x2n != 0 {
        ax = fabs(x)
        l_x2n = log(ax) - log(n) / 2
        u = n * l_x2n
    }
else if x2n > 0.2 {
        l_x2n = log1p(x2n) / 2
        u = n * l_x2n
    }
else {
        l_x2n = log1p(x2n) / 2
        u = 0 - bd0(n / 2,(n + x * x) / 2) + x * x / 2
    }
    if give_log != 0 {
        return t - u - (0.918938533204672741780329736406 + l_x2n)
    }
    i_sqrt: double = lrg_x2n != 0 ? sqrt(n) / ax : exp(0 - l_x2n)
    return exp(t - u) * 0.398942280401432677939946059934 * i_sqrt
}

qt :: (p: double, ndf: double, lower_tail: int, log_p: int) -> double {
    eps: double = 1.0e-12
    P: double = 0
    q: double = 0
    if (p != p || ndf != ndf) {
        return p + ndf
    }
    if log_p != 0 {
        if p > 0 {
            return 0.0 / 0.0
        }
        if p == 0 {
            return lower_tail != 0 ? 1e308 * 10 : -1e308 * 10
        }
        if p == -1e308 * 10 {
            return lower_tail != 0 ? -1e308 * 10 : 1e308 * 10
        }
    }
else {
        if (p < 0 || p > 1) {
            return 0.0 / 0.0
        }
        if p == 0 {
            return lower_tail != 0 ? -1e308 * 10 : 1e308 * 10
        }
        if p == 1 {
            return lower_tail != 0 ? 1e308 * 10 : -1e308 * 10
        }
    }
    if ndf <= 0 {
        return 0.0 / 0.0
    }
    if ndf < 1 {
        accu: double = 1e-13
        Eps: double = 1e-11
        ux: double = 0
        lx: double = 0
        nx2: double = 0
        pp: double = 0
        iter: int = 0
        if p > 1 - 2.2204460492503131e-16 {
            return 1e308 * 10
        }
        pp = fmin(1 - 2.2204460492503131e-16,p * (1 + Eps))
        ux = 1
        while ux < 1.7976931348623157e308 && pt(ux,ndf,1,0) < pp {
            ux *= 2
        }
        pp = p * (1 - Eps)
        lx = -1.0
        while lx > -1.7976931348623157e308 && pt(lx,ndf,1,0) > pp {
            lx *= 2
        }
        while iter < 1000 {
            nx2 = 0.5 * (lx + ux)
            if (ux - lx > accu * fabs(nx2)) == 0 {
                break
            }
            if pt(nx2,ndf,1,0) > p {
                ux = nx2
            }
else {
                lx = nx2
            }
            iter += 1
        }
        return 0.5 * (lx + ux)
    }
    if ndf > 1e20 {
        return qnorm(p,0,1,lower_tail,log_p)
    }
    P = log_p != 0 ? exp(p) : p
    neg: int = ((lower_tail == 0 || P < 0.5) && (lower_tail != 0 || P > 0.5)) ? 1 : 0
    is_neg_lower: int = lower_tail == neg ? 1 : 0
    if neg != 0 {
        if log_p != 0 {
            if lower_tail != 0 {
                P = 2 * P
            }
else {
                P = 2 * (0 - expm1(p))
            }
        }
else {
            P = 2 * (lower_tail != 0 ? P : 0.5 - p + 0.5)
        }
    }
else {
        if log_p != 0 {
            if lower_tail != 0 {
                P = 2 * (0 - expm1(p))
            }
else {
                P = 2 * P
            }
        }
else {
            P = 2 * (lower_tail != 0 ? 0.5 - p + 0.5 : p)
        }
    }
    if fabs(ndf - 2) < eps {
        if P > 2.2250738585072014e-308 {
            if (3 * P < 2.2204460492503131e-16) {
                q = 1 / sqrt(P)
            }
else if P > 0.9 {
                q = (1 - P) * sqrt(2 / (P * (2 - P)))
            }
else {
                q = sqrt(2 / (P * (2 - P)) - 2)
            }
        }
else {
            if log_p != 0 {
                if is_neg_lower != 0 {
                    q = exp(0 - p / 2) / 1.4142135623730950488016887242096980785696718753769480731766797379907324784621070388503875343276415727350138846229
                }
else {
                    q = 1 / sqrt(0 - expm1(p))
                }
            }
else {
                q = 1e308 * 10
            }
        }
    }
else if ndf < 1 + eps {
        if P == 1 {
            q = 0
        }
else if P > 0 {
            q = 1 / GoTanpi(P / 2)
        }
else {
            if log_p != 0 {
                if is_neg_lower != 0 {
                    q = 0.3183098861837906715377675267450287240689192914809128974953346881177953537 * exp(0 - p)
                }
else {
                    q = -1 / (0.3183098861837906715377675267450287240689192914809128974953346881177953537 * expm1(p))
                }
            }
else {
                q = 1e308 * 10
            }
        }
    }
else {
        x: double = 0
        y: double = 0
        log_P2: double = 0
        a: double = 1 / (ndf - 0.5)
        b: double = 48 / (a * a)
        c: double = ((20700 * a / b - 98) * a - 16) * a + 96.36
        d: double = ((94.5 / (b + c) - 3) / b + 1) * sqrt(a * 1.5707963267948966192313216916397514420985846996875529104874722961539082031431044993140174126711) * ndf
        P_ok1: int = (P > 2.2250738585072014e-308 || log_p == 0) ? 1 : 0
        P_ok: int = P_ok1
        if P_ok1 != 0 {
            y = pow(d * P,2.0 / ndf)
            P_ok = y >= 2.2204460492503131e-16 ? 1 : 0
        }
        if P_ok == 0 {
            if is_neg_lower != 0 {
                log_P2 = log_p != 0 ? p : log1p(0 - p)
            }
else {
                log_P2 = log_p != 0 ? swap_log_tail(p) : log1p(0 - p)
            }
            x = (log(d) + 0.693147180559945309417232121458 + log_P2) / ndf
            y = exp(2 * x)
        }
        if ((ndf < 2.1 && P > 0.5) || y > 0.05 + a) {
            if P_ok != 0 {
                x = qnorm(0.5 * P,0,1,1,0)
            }
else {
                x = qnorm(log_P2,0,1,lower_tail,log_p)
            }
            y = x * x
            if ndf < 5 {
                c += 0.3 * (ndf - 4.5) * (x + 0.6)
            }
            c = (((0.05 * d * x - 5) * x - 7) * x - 2) * x + b + c
            y = (((((0.4 * y + 6.3) * y + 36) * y + 94.5) / c - y - 3) / b + 1) * x
            y = expm1(a * y * y)
            q = sqrt(ndf * y)
        }
else if (P_ok == 0 && x < 0 - 0.693147180559945309417232121458 * 53) {
            q = sqrt(ndf) * exp(0 - x)
        }
else {
            y = ((1 / (((ndf + 6) / (ndf * y) - 0.089 * d - 0.822) * (ndf + 2) * 3) + 0.5 / (ndf + 4)) * y - 1) * (ndf + 1) / (ndf + 2) + 1 / y
            q = sqrt(ndf * y)
        }
        if P_ok1 != 0 {
            it: int = 0
            while it < 10 {
                y = dt_go(q,ndf,0)
                if (y > 0) == 0 {
                    break
                }
                x = (pt(q,ndf,0,0) - P / 2) / y
                if (isfinite(x) == 0) {
                    break
                }
                if (fabs(x) > 1e-14 * fabs(q)) == 0 {
                    break
                }
                q += x * (1 + x * q * (ndf + 1) / (2 * (q * q + ndf)))
                it += 1
            }
        }
    }
    if neg != 0 {
        q = 0 - q
    }
    return q
}

/* == pbeta_smalla == */
pbeta_smalla :: (x: double, a: double, b: double, lower_tail: int, log_p: int) -> double {
    r: double = 0



    if x > (0.5) {
        olda: double = a
        a = b
        b = olda
        x = 1 - x
        lower_tail = (lower_tail == 0)
    }
    r = (a + b + (0.5)) * Log1pmx(a / (1 + b)) +
		a * (a - (0.5)) / (1 + b) +
		lfbaccdif (a, b)
    r += a * log((1 + b) * x) - Lgamma1p(a)
    if lower_tail {
        if log_p != 0 {
            return r + log1p(-compbfunc (x, a, b)) + log(b / (a + b))
        } else {
            return exp(r) * (1 - compbfunc (x, a, b)) * (b / (a + b))
        }
    } else {
        if log_p != 0 {
            return swap_log_tail (r + log1p(-compbfunc (x, a, b)) + log(b / (a + b)))
        } else {
            r = -expm1 (r)
            r += compbfunc (x, a, b) * (1 - r)
            r += (a / (a + b)) * (1 - r)
            return r
        }
    }
}

/* == binomial == */
binomial :: (ii: double, jj: double, pp: double, qq: double, diffFromMean: double, lower_tail: int, log_p: int) -> double {
    mij: double = fmin(ii, jj)
    if mij > 500 && fabs(diffFromMean) < (0.01) * mij {
        return binApprox (jj - 1, ii, diffFromMean, lower_tail, log_p)
    }
    return binomialcf (ii, jj, pp, qq, diffFromMean, lower_tail, log_p)
}

/* == binomialcf == */
binomialcf :: (ii: double, jj: double, pp: double, qq: double, diffFromMean: double, lower_tail: int, log_p: int) -> double {
    sumAlways: double = 0
    sumFactor: double = 6
    cfSmall: double = (1.0e-15)
    prob: double = 0
    p: double = 0
    q: double = 0
    a1: double = 0
    a2: double = 0
    b1: double = 0
    b2: double = 0
    c1: double = 0
    c2: double = 0
    c3: double = 0
    c4: double = 0
    n1: double = 0
    q1: double = 0
    dfm: double = 0
    i: double = 0
    j: double = 0
    ni: double = 0
    nj: double = 0
    numb: double = 0
    ip1: double = 0
    swapped: int = 0
    ip1 = ii + 1
    if ii > -1 && (jj <= 0 || pp == 0) {
        return (lower_tail != 0 ? 1.0 : 0.0)
    } else if ii > -1 && ii < 0 {
        f: double = 0
        ii = -ii
        ip1 = ii
        f = ii / ((ii + jj) * pp)
        prob = binomialTerm (ii, jj, pp, qq, (ii + jj) * pp - ii, log_p)
        prob = log_p ? prob + log(f) : prob * f
        ii -= 1
        diffFromMean = (ii + jj) * pp - ii
    } else {
        prob = binomialTerm (ii, jj, pp, qq, diffFromMean, log_p)
    }
    n1 = (ii + 3) + jj
    if ii < 0 {
        swapped = 0
    } else if pp > qq {
        swapped = (n1 * qq >= jj + 1)
    } else {
        swapped = (n1 * pp <= ii + 2)
    }
    if prob == 0.0 {
        if swapped == (lower_tail == 0) {
            return 0.0
        } else {
            return 1.0
        }
    }
    if swapped {
        j = ip1
        ip1 = jj
        i = jj - 1
        p = qq
        q = pp
        dfm = 1 - diffFromMean
    } else {
        i = ii
        j = jj
        p = pp
        q = qq
        dfm = diffFromMean
    }
    if i > sumAlways {
        numb = floor(sumFactor * sqrt(p + (0.5)) * exp(log(n1 * p * q) / 3))
        numb = floor(numb - dfm)
        if numb > i {
            numb = floor(i)
        }
    } else {
        numb = floor(i)
    }
    if numb < 0 {
        numb = 0
    }
    a1 = 0
    b1 = 1
    q1 = q + 1
    a2 = (i - numb) * q
    b2 = dfm + numb + 1
    c1 = 0
    c2 = a2
    c4 = b2
    while fabs(a2 * b1 - a1 * b2) > fabs(cfSmall * b1 * b2) {
        c1 += 1
        c2 -= q
        c3 = c1 * c2
        c4 += q1
        a1 = c4 * a2 + c3 * a1
        b1 = c4 * b2 + c3 * b1
        c1 += 1
        c2 -= q
        c3 = c1 * c2
        c4 += q1
        a2 = c4 * a1 + c3 * a2
        b2 = c4 * b1 + c3 * b2
        if fabs(b2) > (115792089237316195423570985008687907853269984665640564039457584007913129639936.0) {
            a1 *= 1 / (115792089237316195423570985008687907853269984665640564039457584007913129639936.0)
            b1 *= 1 / (115792089237316195423570985008687907853269984665640564039457584007913129639936.0)
            a2 *= 1 / (115792089237316195423570985008687907853269984665640564039457584007913129639936.0)
            b2 *= 1 / (115792089237316195423570985008687907853269984665640564039457584007913129639936.0)
        } else if fabs(b2) < 1 / (115792089237316195423570985008687907853269984665640564039457584007913129639936.0) {
            a1 *= (115792089237316195423570985008687907853269984665640564039457584007913129639936.0)
            b1 *= (115792089237316195423570985008687907853269984665640564039457584007913129639936.0)
            a2 *= (115792089237316195423570985008687907853269984665640564039457584007913129639936.0)
            b2 *= (115792089237316195423570985008687907853269984665640564039457584007913129639936.0)
        }
    }
    a1 = a2 / b2
    ni = (i - numb + 1) * q
    nj = (j + numb) * p
    while numb > 0 {
        a1 = (1 + a1) * (ni / nj)
        ni = ni + q
        nj = nj - p
        numb -= 1
    }
    prob = log_p ? prob + log1p(a1) : prob * (1 + a1)
    if swapped {
        if log_p != 0 {
            prob += log(ip1 * q / nj)
        } else {
            prob *= ip1 * q / nj
        }
    }
    if swapped == (lower_tail == 0) {
        return prob
    } else {
        return log_p ? swap_log_tail (prob) : 1 - prob
    }
}

/* == binApprox == */
binApprox :: (a: double, b: double, diffFromMean: double, lower_tail: int, log_p: int) -> double {
    pq1: double = 0
    res: double = 0
    t: double = 0
    ib05: double = 0
    ib15: double = 0
    ib25: double = 0
    ib35: double = 0
    ib3: double = 0
    elfb: double = 0
    coef15: double = 0
    coef25: double = 0
    coef35: double = 0
    approxtdistDens: double = 0
    n: double = a + b
    n1: double = n + 1
    lvv: double = b - n * diffFromMean
    lval: double = (a * Log1pmx(lvv / (a * n1)) + b * Log1pmx(0 - lvv / (b * n1))) / n
    tp: double = -expm1 (lval)
    mfac: double = n1 * tp
    ib2: double = 1 + mfac
    t1: double = (n + 2) * tp
    mfac = 2 * mfac
    ib3 = ib2 + mfac*t1
    ib05 = tdistexp (tp, 1 - tp, n1 * lval, 2 * n1, log_p, &approxtdistDens)
    ib15 = sqrt(mfac)
    mfac = t1 * ((2.0) / 3)
    ib25 = 1 + mfac
    ib35 = ib25 + mfac * (n + 3) * tp * ((2.0) / 5)
    pq1 = (n * n) / (a * b)
    res = (ib2 * (1 + 2 * pq1) / 135 - 2 * ib3 * ((2 * pq1 - 43) * pq1 - 22) / (2835 * (n + 3))) / (n + 2)
    res = ((1.0) / 3 - res) * 2 * sqrt(pq1 / n1) * (a - b) / n
    if lvv > 0 {
        res = -res
        lower_tail = (lower_tail == 0)
    }
    n1 = (n + (1.5)) * (n + (2.5))
    coef15 = (-17 + 2 * pq1) / (24 * (n + (1.5)))
    coef25 = (-503 + 4 * pq1 * (19 + pq1)) / (1152 * n1)
    coef35 = (-315733 + pq1 * (53310 + pq1 * (8196 - 1112 * pq1))) / (414720 * n1 * (n + (3.5)))
    elfb = (coef35 + coef25) + coef15
    res += ib15 * ((coef35 * ib35 + coef25 * ib25) + coef15)
    t = log_p != 0 ? logspace_signed_add(ib05, log(fabs(res)) + approxtdistDens - log1p(elfb), res >= 0 ? 1 : 0) : ib05 + res * approxtdistDens / (1 + elfb)
    return lower_tail
		? t
		: log_p ? swap_log_tail (t) : (1 - t)
}

/* == pbeta == */
pbeta :: (x: double, a: double, b: double, lower_tail: int, log_p: int) -> double {
    am1: double = 0
    if (x) != (x) || (a) != (a) || (b) != (b) {
        return x + a + b
    }
    if x <= 0 {
        return (lower_tail != 0 ? 0.0 : 1.0)
    }
    if x >= 1 {
        return (lower_tail != 0 ? 1.0 : 0.0)
    }
    if a < 1 && (b < 1 || (1 + b) * x <= 1) {
        return pbeta_smalla(x, a, b, lower_tail, log_p)
    }
    if b < 1 && (1 + a) * (1 - x) <= 1 {
        return pbeta_smalla(1 - x, b, a, (lower_tail == 0), log_p)
    }
    if a < 1 {
        return binomial (-a, b, x, 1 - x, 0, (lower_tail == 0), log_p)
    }
    if b < 1 {
        return binomial (-b, a, 1 - x, x, 0, lower_tail, log_p)
    }
    am1 = a - 1
    return binomial (am1, b, x, 1 - x, (am1 + b) * x - am1,
			 (lower_tail == 0), log_p)
}

/* == qbeta == */
abramowitz_stegun :: (p: double, a: double, b: double, lower_tail: int, log_p: int) -> double {
    yp: double = qnorm(p,0,1,lower_tail == 0 ? 1 : 0,log_p)
    ta: double = 1 / (2 * a - 1)
    tb: double = 1 / (2 * b - 1)
    h: double = 2 / (ta + tb)
    l: double = (yp * yp - 3) / 6
    w: double = yp * sqrt(h + l) / h - (tb - ta) * (l + (5 - 4 / h) / 6)
    return a / (a + b * exp(2 * w))
}

qbeta :: (p: double, pin: double, qin: double, lower_tail: int, log_p: int) -> double {
    x0: double = 0
    q: double = 0
    shape: [2] double = {0,0}
    S: double = pin + qin
    if (S) != (S) || (p) != (p) {
        return S + p
    }
    if pin < 0 || qin < 0 {
    }
    if (log_p == 0) && p > (0.9) {
        p = 1 - p
        lower_tail = (lower_tail == 0)
    }
    if pin >= 1 && qin >= 1 {
        x0 = abramowitz_stegun(p, pin, qin, lower_tail, log_p)
    } else {
        phalf: double = pbeta(0.5, pin, qin, lower_tail, log_p)
        lb: double = lbeta_go (pin, qin)
        if (lower_tail == 0) == (p > phalf) {
            x0 = exp((log(pin) + (lower_tail != 0 ? log(p) : log1p(0 - p)) + 0*(p) + lb) / pin)
        } else {
            x0 = -expm1 ((log(qin) + (lower_tail != 0 ? log1p(0 - p) : log(p)) + 0*(p) + lb) / qin)
        }
    }
    shape[0] = pin
    shape[1] = qin
    q = PFuncInverter(1,p,shape,lower_tail,log_p,0,1,x0)
    return q
}

/* == pgamma_raw == */
pd_lower_cf :: (y: double, d: double) -> double {
    f: double = 0
    of: double = 0
    f0: double = 0
    i: double = 0
    c2: double = 0
    c3: double = 0
    c4: double = 0
    a1: double = 0
    b1: double = 0
    a2: double = 0
    b2: double = 0
    scalefactor: double = 1.157920892373162e+77
    f = 0
    of = -1
    if (0 - (0.693147180559945309417232121458 * 1024 / 2.2204460492503131e-16) < y && y <= 0) {
        lf: double = lgamma(y + d) - lgamma(d) - y * log(d)
        if lf >= -0.693147180559945309417232121458 {
            f = 1 - exp(0 - d - y + lf * 0.5)
        }
else {
            f = exp(0 - d - y + lf * 0.5)
            f = 0 - f
        }
        return f
    }
    f0 = y / d
    if f0 > 1 { f0 = 1 }
    c2 = y
    c4 = d
    a1 = 0
    b1 = 1
    a2 = y
    b2 = d
    while b2 > scalefactor {
        a1 /= scalefactor
        b1 /= scalefactor
        a2 /= scalefactor
        b2 /= scalefactor
        if b2 <= scalefactor { break }
    }
    i = 0
    of = -1
    while i < 200000 {
        i += 1
        c2 -= 1
        c3 = i * c2
        c4 += 2
        a1 = c4 * a2 + c3 * a1
        b1 = c4 * b2 + c3 * b1
        i += 1
        c2 -= 1
        c3 = i * c2
        c4 += 2
        a2 = c4 * a1 + c3 * a2
        b2 = c4 * b1 + c3 * b2
        if b2 > scalefactor {
            a1 /= scalefactor
            b1 /= scalefactor
            a2 /= scalefactor
            b2 /= scalefactor
        }
        if b2 != 0 {
            f = a2 / b2
            if (fabs(f - of) <= 2.2204460492503131e-16 * fmax(f0,fabs(f))) {
                return f
            }
            of = f
        }
    }
    return f
}

pd_upper_series :: (x: double, y_in: double, log_p: int) -> double {
    y: double = y_in
    term: double = x / y
    sum: double = term
    while 1 {
        y += 1
        term *= x / y
        sum += term
        if (term > sum * 2.2204460492503131e-16) == 0 {
            break
        }
    }
    if log_p != 0 {
        return log(sum)
    }
    return sum
}

pd_upper_gamma :: (y: double, z: double) -> double {
    z2: double = z * z
    term: double = 0
    sum: double = 0
    i: int = 0
    term = 1
    sum = 1
    i = 1
    while i < 100 {
        term *= z2 / (y + i)
        sum += term
        if term < sum * 2.2204460492503131e-16 {
            break
        }
        i += 1
    }
    return 1 / y + z / y / y * (1 + y * sum)
}

dpois_wrap :: (x_plus_1: double, lambda: double, give_log: int) -> double {
    if isfinite(lambda) == 0 {
        return 0.0
    }
    if x_plus_1 > 1 {
        return dpois_raw(x_plus_1 - 1,lambda,give_log)
    }
    if (lambda > fabs(x_plus_1 - 1) * 3.196577e18) {
        return exp(0 - lambda - lgamma(x_plus_1))
    }
    d: double = dpois_raw(x_plus_1,lambda,give_log)
    if give_log != 0 {
        return d + log(x_plus_1 / lambda)
    }
    return d * (x_plus_1 / lambda)
}


PFuncInverter :: (which: int, p: double, shape: double *, lower_tail: int, log_p: int, xlow_in: double, xhigh_in: double, x0_in: double) -> double {
    have_xlow: int = isfinite(xlow_in) != 0 ? 1 : 0
    have_xhigh: int = isfinite(xhigh_in) != 0 ? 1 : 0
    xlow: double = xlow_in
    xhigh: double = xhigh_in
    exlow: double = 0
    exhigh: double = 0
    x: double = 0
    e: double = 0
    px: double = 0
    i: int = 0
    dt_0: double = lower_tail != 0 ? 0.0 : 1.0
    dt_1: double = lower_tail != 0 ? 1.0 : 0.0
    if log_p != 0 {
        if p > 0 { return 0.0 / 0.0 }
    }
else {
        if (p < 0 || p > 1) { return 0.0 / 0.0 }
    }
    if p == dt_0 { return xlow }
    if p == dt_1 { return xhigh }
    exlow = dt_0 - p
    exhigh = dt_1 - p
    if lower_tail == 0 {
        exlow = 0 - exlow
        exhigh = 0 - exhigh
    }
    i = 0
    while i < 100 {
        if i == 0 {
            if (x0_in > xlow && x0_in < xhigh) {
                x = x0_in
            }
else if (have_xlow != 0 && x0_in <= xlow) {
                x = have_xhigh != 0 ? xlow + (xhigh - xlow) / 100 : xlow + 1
            }
else if (have_xhigh != 0 && x0_in >= xhigh) {
                x = have_xlow != 0 ? xhigh - (xhigh - xlow) / 100 : xhigh - 1
            }
else {
                x = 0
            }
        }
else if i == 1 {
            if (have_xlow != 0 && have_xhigh != 0) {
                x = (xlow + xhigh) / 2
            }
else if have_xlow != 0 {
                x = xlow * 1.1
            }
else {
                x = xhigh / 1.1
            }
        }
else if (have_xlow != 0 && have_xhigh != 0) {
            m8: int = i % 8
            if m8 == 0 {
                x = xhigh - (xhigh - xlow) * (exhigh / (exhigh - exlow))
            }
else if m8 == 4 {
                if (xlow >= 0 && xhigh >= 0) {
                    x = sqrt(fmax(2.2250738585072014e-308,xlow)) * sqrt(xhigh)
                }
else if (xlow <= 0 && xhigh <= 0) {
                    x = 0 - sqrt(0 - xlow) * sqrt(fmax(2.2250738585072014e-308,0 - xhigh))
                }
else {
                    x = 0
                }
            }
else if m8 == 2 {
                x = (xhigh + 1000 * xlow) / 1001
            }
else if m8 == 6 {
                x = (1000 * xhigh + xlow) / 1001
            }
else {
                x = (xhigh + xlow) / 2
            }
        }
else if have_xlow != 0 {
            x = xlow < 1 ? 1 : (2 * i) * xlow
        }
else {
            x = xhigh > -1 ? -1 : (2 * i) * xhigh
        }
        if (have_xlow != 0 && x <= xlow) || (have_xhigh != 0 && x >= xhigh) {
            i += 1
            continue
        }
        if which == 1 {
            px = pbeta(x,shape[0],shape[1],lower_tail,log_p)
        }
else {
            px = pgamma(x,shape[0],1,lower_tail,log_p)
        }
        e = px - p
        if lower_tail == 0 { e = 0 - e }
        if e == 0 {
            break
        }
else if e > 0 {
            xhigh = x
            exhigh = e
            have_xhigh = 1
        }
else if e < 0 {
            xlow = x
            exlow = e
            have_xlow = 1
        }
        if (have_xlow != 0 && have_xhigh != 0) {
            prec: double = (xhigh - xlow) / (fabs(xlow) + fabs(xhigh))
            if prec < 2.2204460492503131e-16 * 4 {
                x = (xhigh + xlow) / 2
                if which == 1 {
                    e = pbeta(x,shape[0],shape[1],lower_tail,log_p) - p
                }
else {
                    e = pgamma(x,shape[0],1,lower_tail,log_p) - p
                }
                if lower_tail == 0 { e = 0 - e }
                break
            }
            if i % 3 < 2 {
                d2: double = 0
                if which == 1 {
                    d2 = dbeta(x,shape[0],shape[1],0)
                }
else {
                    d2 = dgamma_go(x,shape[0],1,0)
                }
                if d2 != 0 {
                    xn2: double = x - e / d2 * 1.000001
                    if (xn2 > xlow && xn2 < xhigh) {
                        x = xn2
                        i += 1
                        if which == 1 {
                            px = pbeta(x,shape[0],shape[1],lower_tail,log_p)
                        }
else {
                            px = pgamma(x,shape[0],1,lower_tail,log_p)
                        }
                        e = px - p
                        if lower_tail == 0 { e = 0 - e }
                        if e == 0 {
                            break
                        }
else if e > 0 {
                            xhigh = x
                            exhigh = e
                            have_xhigh = 1
                        }
else if e < 0 {
                            xlow = x
                            exlow = e
                            have_xlow = 1
                        }
                    }
                }
            }
        }
        i += 1
    }
    if (have_xhigh != 0 && fabs(e) > exhigh) {
        x = xhigh
    }
    if (have_xlow != 0 && fabs(e) > 0 - exlow) {
        x = xlow
    }
    return x
}

dbeta :: (x: double, a: double, b: double, give_log: int) -> double {
    if (x < 0 || x > 1 || a <= 0 || b <= 0) {
        return 0.0
    }
    l: double = (a - 1) * log(x) + (b - 1) * log1p(0 - x) - lbeta_go(a,b)
    if give_log != 0 {
        return l
    }
    return exp(l)
}

pbeta1_go :: (x: double, shape: double *, lower_tail: int, log_p: int) -> double {
    return pbeta(x,shape[0],shape[1],lower_tail,log_p)
}

(0.693147180559945309417232121458 * 1024 / 2.2204460492503131e-16): double = 0.693147180559945309417232121458 * 1024 / 2.2204460492503131e-16

pd_lower_series :: (lambda: double, y_in: double) -> double {
    term: double = 1
    sum: double = 0
    y: double = y_in
    while (y >= 1 && term > sum * 2.2204460492503131e-16) {
        term *= y / lambda
        sum += term
        y -= 1
    }
    if y != floor(y) {
        f: double = pd_lower_cf(y,lambda + 1 - y)
        sum += term * f
    }
    return sum
}

ppois_asymp :: (x: double, lambda: double, lower_tail: int, log_p: int) -> double {
    coefs_a: [8] double = {1e-99,0.666666666666666666666666666666,0 - 4 / 135,8 / 2835,16 / 8505,0 - 8992 / 12629925,0 - 334144 / 492567075,698752 / 1477701225}
    coefs_b: [8] double = {1e-99,1 / 12,1 / 288,0 - 139 / 51840,0 - 571 / 2488320,163879 / 209018880,5246819 / 75246796800,0 - 534703531 / 902961561600}
    elfb: double = 0
    elfb_term: double = 0
    res12: double = 0
    res1_term: double = 0
    res1_ig: double = 0
    res2_term: double = 0
    res2_ig: double = 0
    dfm: double = 0
    pt_: double = 0
    s2pt: double = 0
    f: double = 0
    np: double = 0
    sum: double = 0
    ib: double = 0
    dfm = lambda - x
    pt_ = x / lambda
    s2pt = sqrt(2 * (lambda - x - x * log(pt_)))
    np = 1 / (4 * lambda)
    f = dfm - s2pt
    elfb = 0
    elfb_term = 0
    ib = 1
    while ib < 8 {
        elfb_term = f * elfb_term + coefs_b[(int)ib]
        elfb = f * elfb + elfb_term
        ib += 1
    }
    elfb *= np
    res12 = 0
    res1_term = 1
    res1_ig = 1
    res2_term = 0.666666666666666666666666666666
    res2_ig = 0.666666666666666666666666666666
    ib = 2
    while ib < 8 {
        res1_term *= s2pt / (2 * ib - 1)
        res1_ig += res1_term
        res2_term *= s2pt / (2 * ib)
        res2_ig += res2_term
        ib += 1
    }
    res12 = res1_ig * 0.398942280401432677939946059934 * exp(0 - s2pt * s2pt / 2) + res2_ig * (1 - 0.5) / s2pt
    sum = elfb * res12
    if log_p != 0 {
        return log(0.5) + log(sum)
    }
    if lower_tail != 0 {
        return 0.5 * sum
    }
    return 1 - 0.5 * sum
}


lgamma1p_raw :: (a: double) -> double {
    return lgamma(1 + a)
}

pgamma_smallx :: (x: double, alph: double, lower_tail: int, log_p: int) -> double {
    sum: double = 0
    c: double = alph
    n: double = 0
    term: double = 0
    while 1 {
        n += 1
        c *= 0 - x / n
        term = c / (alph + n)
        sum += term
        if (fabs(term) > 2.2204460492503131e-16 * fabs(sum)) == 0 {
            break
        }
    }
    if lower_tail != 0 {
        f1: double = 1 + sum
        f2: double = 0
        if (alph > 1) {
            f2 = dpois_raw(alph,x,0)
            f2 = f2 * exp(x)
        }
else {
            f2 = pow(x,alph) / exp(lgamma1p_raw(alph))
        }
        return f1 * f2
    }
    lf2: double = alph * log(x) - lgamma1p_raw(alph)
    f1m1: double = sum
    f2m1: double = expm1(lf2)
    return 0 - (f1m1 + f2m1 + f1m1 * f2m1)
}

pgamma_raw :: (x: double, alph: double, lower_tail: int, log_p: int) -> double {
    res: double = 0
    if x <= 0 { return (lower_tail != 0 ? 0.0 : 1.0) }
    if x >= 1e308 * 10 { return (lower_tail != 0 ? 1.0 : 0.0) }
    if x < 1 {
        res = pgamma_smallx (x, alph, lower_tail, log_p)
    } else if x <= alph - 1 && x < (0.8) * (alph + 50) {
        sum: double = pd_upper_series (x, alph, log_p)
        d: double = dpois_wrap (alph, x, log_p)
        if (lower_tail == 0) {
            res = log_p
		? swap_log_tail (d + sum)
		: 1 - d * sum
        } else {
            res = log_p ? sum + d : sum * d
        }
    } else if alph - 1 < x && alph < (0.8) * (x + 50) {
        sum: double = 0
        d: double = dpois_wrap (alph, x, log_p)
        if alph < 1 {
            if x * 2.2204460492503131e-16 > 1 - alph {
                sum = 1.0
            } else {
                f: double = pd_lower_cf (alph, x - (alph - 1)) * x / alph
                sum = log_p ? log(f) : f
            }
        } else {
            sum = pd_lower_series (x, alph - 1)
            sum = log_p ? log1p(sum) : 1 + sum
        }
        if (lower_tail == 0) {
            res = log_p ? sum + d : sum * d
        } else {
            res = log_p
		? swap_log_tail (d + sum)
		: 1 - d * sum
        }
    } else {
        res = ppois_asymp (alph - 1, x, (lower_tail == 0), log_p)
    }
    if (log_p == 0) && res < 2.2250738585072014e-308 / 2.2204460492503131e-16 {
        return exp(pgamma_raw (x, alph, lower_tail, 1))
    } else {
        return res
    }
}

/* == pgamma == */
pgamma :: (x: double, alph: double, scale: double, lower_tail: int, log_p: int) -> double {
    if (x) != (x) || (alph) != (alph) || (scale) != (scale) {
        return x + alph + scale
    }
    if alph < 0 || scale <= 0 {
        return (0.0/0.0)
    }
    x /= scale
    if (x) != (x) {
        return x
    }
    if alph == 0 {
        return (x <= 0) ? (lower_tail != 0 ? 0.0 : 1.0): (lower_tail != 0 ? 1.0 : 0.0)
    }
    return pgamma_raw (x, alph, lower_tail, log_p)
}

/* == qgamma == */
qgamma :: (p: double, alpha: double, scale: double, lower_tail: int, log_p: int) -> double {
    res1: double = 0
    x0: double = 0
    v: double = 0
    if (p) != (p) || (alpha) != (alpha) || (scale) != (scale) {
        return p + alpha + scale
    }
    if alpha <= 0 {
    }
    if (log_p == 0) && p > (0.9) {
        p = 1 - p
        lower_tail = (lower_tail == 0)
    }
    v = 2 * alpha
    if v < (-1.24) * (lower_tail != 0 ? log(p) : log1p(0 - p)) + 0*(p) {
        x0 = pow((p) * alpha * exp(lgamma (alpha) + alpha * 0.693147180559945309417232121458),
			      1 / alpha) / 2
    } else {
        x1: double = qnorm(p, 0, 1, lower_tail, log_p)
        p1: double = (0.222222) / v
        x0 = v * pow(x1 * sqrt(p1) + 1 - p1, 3) / 2
    }
    res1 = PFuncInverter(0,p,&alpha,lower_tail,log_p,0,1e308 * 10,x0)
    return res1 * scale
}

/* == pchisq == */
pchisq :: (x: double, df: double, lower_tail: int, log_p: int) -> double {
    return pgamma(x, df/(2.0), (2.0), lower_tail, log_p)
}

/* == qchisq == */
qchisq :: (p: double, df: double, lower_tail: int, log_p: int) -> double {
    return qgamma(p, (0.5) * df, (2.0), lower_tail, log_p)
}

/* == pf == */
pf :: (x: double, n1: double, n2: double, lower_tail: int, log_p: int) -> double {
    if (x) != (x) || (n1) != (n1) || (n2) != (n2) {
        return x + n2 + n1
    }
    if n1 <= 0 || n2 <= 0 {
    }
    if x <= 0 {
        return (lower_tail != 0 ? 0.0 : 1.0)
    }
    if n1 * x > n2 {
        return pbeta(n2 / (n2 + n1 * x), n2 / 2, n1 / 2,
			  (lower_tail == 0), log_p)
    } else {
        return pbeta(n1 * x / (n2 + n1 * x), n1 / 2, n2 / 2,
			  lower_tail, log_p)
    }
}

/* == qf == */
qf :: (p: double, n1: double, n2: double, lower_tail: int, log_p: int) -> double {
    q: double = 0
    qc: double = 0
    if (p) != (p) || (n1) != (n1) || (n2) != (n2) {
        return p + n1 + n2
    }
    if n1 <= 0 || n2 <= 0 {
    }
    if p == (lower_tail != 0 ? 0.0 : 1.0) {
        return 0
    }
    q = qbeta(p, n2 / 2, n1 / 2, (lower_tail == 0), log_p)
    if q < (0.9) {
        qc = 1 - q
    } else {
        qc = qbeta(p, n1 / 2, n2 / 2, lower_tail, log_p)
    }
    return (qc / q) * (n2 / n1)
}

/* == ppois == */
ppois :: (x: double, lambda: double, lower_tail: int, log_p: int) -> double {
    if (x) != (x) || (lambda) != (lambda) {
        return x + lambda
    }
    if lambda < 0 {
        return (0.0/0.0)
    }
    if x < 0 {
        return (lower_tail != 0 ? 0.0 : 1.0)
    }
    if lambda == 0 {
        return (lower_tail != 0 ? 1.0 : 0.0)
    }
    if (isfinite(x) == 0) {
        return (lower_tail != 0 ? 1.0 : 0.0)
    }
    x = floor(x)
    return pgamma(lambda, x + 1, (1.0), (lower_tail == 0), log_p)
}

/* == dpois == */
dpois :: (x: double, lambda: double, give_log: int) -> double {
    if (x) != (x) || (lambda) != (lambda) {
        return x + lambda
    }
    if lambda < 0 {
        return (0.0/0.0)
    }
    
    if x < 0 || (isfinite(x) == 0) {
        return 0.0
    }
    x = round(x)
    return( dpois_raw(x,lambda,give_log) )
}

/* == pbinom == */
pbinom :: (x: double, n: double, p: double, lower_tail: int, log_p: int) -> double {
    if (x) != (x) || (n) != (n) || (p) != (p) {
        return x + n + p
    }
    if (isfinite(n) == 0) || (isfinite(p) == 0) {
        return (0.0/0.0)
    }
    if n != floor(n) {
        return (lower_tail != 0 ? 0.0 : 1.0)
    }
    n = round(n)
    if n < 0 || p < 0 || p > 1 {
        return (0.0/0.0)
    }
    if x < 0 {
        return (lower_tail != 0 ? 0.0 : 1.0)
    }
    x = floor(x)
    if n <= x {
        return (lower_tail != 0 ? 1.0 : 0.0)
    }
    return pbeta(p, x + 1, n - x, (lower_tail == 0), log_p)
}

/* == pbinom2 == */
pbinom2 :: (x0: double, x1: double, n: double, p: double) -> double {
    Pl: double = 0
    if x0 > n || x1 < 0 || x0 > x1 {
        return 0
    }
    if x0 == x1 {
        return dbinom (x0, n, p, 0)
    }
    if x0 <= 0 {
        return pbinom(x1, n, p, 1, 0)
    }
    if x1 >= n {
        return pbinom(x0 - 1, n, p, 0, 0)
    }
    Pl = pbinom(x0 - 1, n, p, 1, 0)
    if Pl > (0.75) {
        PlC: double = pbinom(x0 - 1, n, p, 0, 0)
        PrC: double = pbinom(x1, n, p, 0, 0)
        return PlC - PrC
    } else {
        Pr: double = pbinom(x1, n, p, 1, 0)
        return Pr - Pl
    }
}

/* == qbinom == */
qbinom :: (p: double, n: double, pr: double, lower_tail: int, log_p: int) -> double {
    q: double = 0
    mu: double = 0
    sigma: double = 0
    gamma: double = 0
    z: double = 0
    y: double = 0
    if (p) != (p) || (n) != (n) || (pr) != (pr) {
        return p + n + pr
    }
    if (isfinite(n) == 0) || (isfinite(pr) == 0) {
        return (0.0/0.0)
    }
    if (isfinite(p) == 0) && (log_p == 0) {
        return (0.0/0.0)
    }
    if n != floor(n + (0.5)) {
        return (0.0/0.0)
    }
    if pr < 0 || pr > 1 || n < 0 {
        return (0.0/0.0)
    }
    if log_p != 0 {
        if p > 0 {
            return (0.0/0.0)
        }
        if p == 0 {
            return (lower_tail ? n : 0)
        }
        if p == (-1e308*10) {
            return (lower_tail ? 0 : n)
        }
    } else {
        if p < 0 || p > 1 {
            return (0.0/0.0)
        }
        if p == 0 {
            return (lower_tail ? 0 : n)
        }
        if p == 1 {
            return (lower_tail ? n : 0)
        }
    }
    if pr == 0 || n == 0 {
        return (0.0)
    }
    q = 1 - pr
    if q == 0 {
        return n
    }
    mu = n * pr
    sigma = sqrt(n * pr * q)
    gamma = (q - pr) / sigma
    if (lower_tail == 0) || log_p {
        p = (p)
        if p == 0 {
            return (0.0)
        }
        if p == 1 {
            return n
        }
    }
    if p + (1.01)*2.2204460492503131e-16 >= 1 {
        return n
    }
    z = qnorm(p, (0.0), (1.0),               1,          0)
    y = floor(mu + sigma * (z + gamma * (z*z - 1) / 6) + (0.5))
    if y > n {
        y = n
    }
    z = pbinom(y, n, pr,               1,          0)
    p *= 1 - 64*2.2204460492503131e-16
    if n < (1e5) {
        return do_search(y, &z, p, n, pr, 1)
    }
    incr: double = floor(n * (0.001)), oldincr
    while 1 {
        oldincr = incr
        y = do_search(y, &z, p, n, pr, incr)
        incr = fmax(1, floor(incr/100))
        if (oldincr > 1 && incr > n*(1e-15)) == 0 { break }
    }
    return y
}

/* == pnbinom == */
pnbinom :: (x: double, size: double, prob: double, lower_tail: int, log_p: int) -> double {
    if (x) != (x) || (size) != (size) || (prob) != (prob) {
        return x + size + prob
    }
    if (isfinite(size) == 0) || (isfinite(prob) == 0) {
        return (0.0/0.0)
    }
    if size < 0 || prob <= 0 || prob > 1 {
        return (0.0/0.0)
    }
    if size == 0 {
        return (x >= 0) ? (lower_tail != 0 ? 1.0 : 0.0) : (lower_tail != 0 ? 0.0 : 1.0)
    }
    if x < 0 {
        return (lower_tail != 0 ? 0.0 : 1.0)
    }
    if (isfinite(x) == 0) {
        return (lower_tail != 0 ? 1.0 : 0.0)
    }
    x = floor(x)
    return pbeta(prob, size, x + 1, lower_tail, log_p)
}

/* == dnbinom == */
dnbinom :: (x: double, size: double, prob: double, give_log: int) -> double {
    ans: double = 0
    p: double = 0
    if (x) != (x) || (size) != (size) || (prob) != (prob) {
        return x + size + prob
    }
    if prob <= 0 || prob > 1 || size < 0 {
        return (0.0/0.0)
    }
    
    if x < 0 || (isfinite(x) == 0) {
        return 0.0
    }
    if x == 0 && size==0 {
        return 1.0
    }
    x = round(x)
    if (isfinite(size) == 0) {
        size = 1.7976931348623157e308
    }
    ans = dbinom_raw(size, x+size, prob, 1-prob, give_log)
    p = (size)/(size+x)
    return((give_log) ? log(p) + ans : p * ans)
}

/* == phyper == */

pdhyper :: (x_in: double, NR: double, NB: double, n: double, log_p: int) -> double {
    sum: double = 0
    term: double = 1
    x: double = x_in
    while (x > 0 && term >= 2.2204460492503131e-16 * sum) {
        term *= x * (NB - n + x) / (n + 1 - x) / (NR + 1 - x)
        sum += term
        x -= 1
    }
    if log_p != 0 {
        return log1p(sum)
    }
    return 1 + sum
}

phyper :: (x: double, NR: double, NB: double, n: double, lower_tail: int, log_p: int) -> double {
    d: double = 0
    pd: double = 0
    if (x) != (x) || (NR) != (NR) || (NB) != (NB) || (n) != (n) {
        return x + NR + NB + n
    }
    x = floor(x)
    NR = round(NR)
    NB = round(NB)
    n  = round(n)
    if NR < 0 || NB < 0 || (isfinite(NR + NB) == 0) || n < 0 || n > NR + NB {
        return (0.0/0.0)
    }
    if x * (NR + NB) > n * NR {
        oldNB: double = NB
        NB = NR
        NR = oldNB
        x = n - x - 1
        lower_tail = (lower_tail == 0)
    }
    if x < 0 {
        return (lower_tail != 0 ? 0.0 : 1.0)
    }
    if x >= NR || x >= n {
        return (lower_tail != 0 ? 1.0 : 0.0)
    }
    d  = dhyper (x, NR, NB, n, log_p)
    pd = pdhyper(x, NR, NB, n, log_p)
    return log_p != 0 ? (lower_tail != 0 ? (d + pd) : swap_log_tail(d + pd)) : (d * pd)
}

/* == dhyper == */
dhyper :: (x: double, r: double, b: double, n: double, give_log: int) -> double {
    p: double = 0
    q: double = 0
    p1: double = 0
    p2: double = 0
    p3: double = 0
    if (x) != (x) || (r) != (r) || (b) != (b) || (n) != (n) {
        return x + r + b + n
    }
    if (r < 0 || r != floor(r)) || (b < 0 || b != floor(b)) || (n < 0 || n != floor(n)) || n > r+b {
        return (0.0/0.0)
    }
    if x < 0 {
        return(0.0)
    }
    
    x = round(x)
    r = round(r)
    b = round(b)
    n = round(n)
    if n < x || r < x || n - x > b {
        return(0.0)
    }
    if n == 0 {
        return((x == 0) ? 1.0 : 0.0)
    }
    p = (n)/((r+b))
    q = ((r+b-n))/((r+b))
    p1 = dbinom_raw(x,	r, p,q,give_log)
    p2 = dbinom_raw(n-x,b, p,q,give_log)
    p3 = dbinom_raw(n,r+b, p,q,give_log)
    return( (give_log) ? p1 + p2 - p3 : p1*p2/p3 )
}

StatAggArgs :: (args: Val *, count: int, marks: int *, xs: double *, ys: double *, xn: int *, yn: int *, need_y: int) -> int {
    list: NumList = {0}
    list2: NumList = {0}
    gx: int = 0
    gl: int = 0
    hx: int = 0
    hl: int = 0
    CollectNumbers(args,count,&list)
    xn[0] = list.count
    if need_y != 0 {
        if GroupBounds(marks,count,0,&gx,&gl) == 0 { return 0 }
        if GroupBounds(marks,count,1,&hx,&hl) == 0 { return 0 }
        gx2: int = 0
        gl2: int = 0
        gx2 = gx
        gl2 = gl
        xn[0] = CashList(args + gx2,gl2,xs)
        yn[0] = CashList(args + hx,hl,ys)
        if (xn[0] != yn[0]) { return 0 }
    }
else {
        i: int = 0
        while i < xn[0] {
            xs[i] = list.data[i]
            i += 1
        }
    }
    return 1
}

StatAverage :: (xs: double *, n: int) -> double {
    acc: Qd = {0,0}
    one: Qd = {1,0}
    q: Qd = {0,0}
    i: int = 0
    while i < n {
        Q_Init(&q,xs[i])
        Q_Add(&acc,&acc,&q)
        i += 1
    }
    qn: Qd = {0,0}
    Q_Init(&qn,(double)n)
    Q_Div(&acc,&acc,&qn)
    return Q_Val(&acc)
}

StatDevsq :: (xs: double *, n: int) -> double {
    sumh: double = 0
    suml: double = 0
    qavg: Qd = {0,0}
    acc: Qd = {0,0}
    q: Qd = {0,0}
    i: int = 0
    StatAccSum(xs,n,&sumh,&suml)
    Q_Init(&qavg,sumh)
    Q_Init(&q,suml)
    Q_Add(&qavg,&qavg,&q)
    qn: Qd = {0,0}
    Q_Init(&qn,(double)n)
    Q_Div(&qavg,&qavg,&qn)
    i = 0
    while i < n {
        Q_Init(&q,xs[i])
        Q_Sub(&q,&q,&qavg)
        Q_Mul(&q,&q,&q)
        Q_Add(&acc,&acc,&q)
        i += 1
    }
    return Q_Val(&acc)
}

StatAccSum :: (xs: double *, n: int, sumh: double *, suml: double *) {
    partials: [128] double = {0}
    np: int = 0
    i: int = 0
    ui: int = 0
    uj: int = 0
    x: double = 0
    y: double = 0
    hi: double = 0
    lo: double = 0
    i = 0
    while i < n {
        x = xs[i]
        ui = 0
        uj = 0
        while uj < np {
            y = partials[uj]
            if fabs(x) < fabs(y) {
                t: double = x
                x = y
                y = t
            }
            hi = x + y
            lo = y - (hi - x)
            if lo != 0 {
                partials[ui] = lo
                ui += 1
            }
            x = hi
            uj += 1
        }
        np = ui
        if np < 128 {
            partials[np] = x
            np += 1
        }
        i += 1
    }
    total: double = 0
    i = 0
    while i < np {
        total += partials[i]
        i += 1
    }
    sumh[0] = total
    suml[0] = 0
}


CollectRangeGroup :: (args: Val *, count: int, marks: int *, out: double *) -> int {
    gx: int = 0
    gl: int = 0
    if GroupBounds(marks,count,0,&gx,&gl) != 0 {
        return CashList(args + gx,gl,out)
    }
    return CashList(args,count,out)
}

FnCorrel :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    xs: [4096] double = {0}
    ys: [4096] double = {0}
    xn: int = 0
    yn: int = 0
    i: int = 0
    if StatAggArgs(args,count,marks,xs,ys,&xn,&yn,1) == 0 { return ValError(ERR_VALUE) }
    ux: double = StatAverage(xs,xn)
    uy: double = StatAverage(ys,xn)
    sxy: double = 0
    sxx: double = 0
    syy: double = 0
    while i < xn {
        sxy += (xs[i] - ux) * (ys[i] - uy)
        sxx += (xs[i] - ux) * (xs[i] - ux)
        syy += (ys[i] - uy) * (ys[i] - uy)
        i += 1
    }
    den: double = sqrt(sxx) * sqrt(syy)
    if den == 0 { return ValError(ERR_VALUE) }
    c: double = sxy / den
    if c > 1 { c = 1 }
    if c < -1 { c = -1 }
    return ValNumber(c)
}

FnCovar :: (st: EvalState *, args: Val *, count: int, marks: int *, sample: int) -> Val {
    xs: [4096] double = {0}
    ys: [4096] double = {0}
    xn: int = 0
    yn: int = 0
    if StatAggArgs(args,count,marks,xs,ys,&xn,&yn,1) == 0 { return ValError(ERR_VALUE) }
    ux: double = StatAverage(xs,xn)
    uy: double = StatAverage(ys,xn)
    s: double = 0
    i: int = 0
    while i < xn {
        s += (xs[i] - ux) * (ys[i] - uy)
        i += 1
    }
    if sample != 0 {
        return ValNumber(s / (double)(xn - 1))
    }
    return ValNumber(s / (double)xn)
}

FnLinReg :: (st: EvalState *, args: Val *, count: int, marks: int *, which: int) -> Val {
    xs: [4096] double = {0}
    ys: [4096] double = {0}
    tmp: [4096] double = {0}
    xn: int = 0
    yn: int = 0
    i: int = 0
    px_in: double = 0
    if which == 3 {
        px_in = CoerceNumber(&args[0])
        if StatAggArgs(args + 1,count - 1,marks + 1,tmp,xs,&yn,&xn,1) == 0 { return ValError(ERR_VALUE) }
    }
else {
        if StatAggArgs(args,count,marks,tmp,xs,&yn,&xn,1) == 0 { return ValError(ERR_VALUE) }
    }
    i = 0
    while i < xn {
        ys[i] = tmp[i]
        i += 1
    }
    ux: double = StatAverage(xs,xn)
    uy: double = StatAverage(ys,xn)
    sxy: double = 0
    sxx: double = 0
    syy: double = 0
    i = 0
    while i < xn {
        sxy += (xs[i] - ux) * (ys[i] - uy)
        sxx += (xs[i] - ux) * (xs[i] - ux)
        syy += (ys[i] - uy) * (ys[i] - uy)
        i += 1
    }
    if sxx == 0 { return ValError(ERR_VALUE) }
    slope: double = sxy / sxx
    if which == 0 { return ValNumber(slope) }
    if which == 1 { return ValNumber(uy - slope * ux) }
    if which == 2 {
        n2: double = xn
        ssres: double = syy - slope * sxy
        if ssres < 0 { ssres = 0 }
        return ValNumber(sqrt(ssres / (n2 - 2)))
    }
    if which == 3 { return ValNumber(uy - slope * ux + slope * px_in) }
    return ValNumber(0)
}

FnKurtSkew :: (st: EvalState *, args: Val *, count: int, marks: int *, which: int, pop: int) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    n: int = list.count
    if (n < 4 && which == 0) || (n < 3 && which == 1) { return ValError(ERR_VALUE) }
    m: double = StatAverage(list.data,n)
    s2: double = 0
    i: int = 0
    while i < n {
        d: double = list.data[i] - m
        s2 += d * d
        i += 1
    }
    if pop != 0 {
        s2 /= (double)n
    }
else {
        s2 = s2 / (double)(n - 1)
    }
    s: double = sqrt(s2)
    if s == 0 { return ValError(ERR_VALUE) }
    m3: double = 0
    m4: double = 0
    i = 0
    while i < n {
        d: double = list.data[i] - m
        dxn: double = d / s
        m3 += dxn * dxn * dxn
        m4 += (dxn * dxn) * (dxn * dxn)
        i += 1
    }
    if which == 1 {
        if pop != 0 { return ValNumber(m3 / (double)n) }
        return ValNumber((m3 * (double)n / (double)(n - 1)) / (double)(n - 2))
    }
    if pop != 0 { return ValNumber(m4 / (double)n - 3) }
    common_den: double = (double)(n - 2) * (double)(n - 3)
    nth: double = (double)n * (double)(n + 1) / ((double)(n - 1) * common_den)
    three: double = 3.0 * (double)(n - 1) * (double)(n - 1) / common_den
    return ValNumber(m4 * nth - three)
}

FnStandardize :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    x: double = 0
    m: double = 0
    sd: double = 0
    if count < 3 { return ValError(ERR_VALUE) }
    x = CoerceNumber(&args[0])
    m = CoerceNumber(&args[1])
    sd = CoerceNumber(&args[2])
    if sd <= 0 { return ValError(ERR_NUM) }
    return ValNumber((x - m) / sd)
}

FnFisher :: (st: EvalState *, args: Val *, count: int, marks: int *, inv: int) -> Val {
    x: double = 0
    if count < 1 { return ValError(ERR_VALUE) }
    x = CoerceNumber(&args[0])
    if inv != 0 { return ValNumber(tanh(x)) }
    if (x <= -1 || x >= 1) { return ValError(ERR_NUM) }
    return ValNumber(atanh(x))
}

FnVar :: (st: EvalState *, args: Val *, count: int, marks: int *, sample: int, stddev: int) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    n: int = list.count
    if (sample != 0 && n < 2) || n < 1 { return ValError(ERR_VALUE) }
    m: double = StatAverage(list.data,n)
    s: double = 0
    i: int = 0
    while i < n {
        d: double = list.data[i] - m
        s += d * d
        i += 1
    }
    v: double = 0
    if sample != 0 {
        v = s / (double)(n - 1)
    }
else {
        v = s / (double)n
    }
    if stddev != 0 { return ValNumber(sqrt(v)) }
    return ValNumber(v)
}

FnAveragA :: (st: EvalState *, args: Val *, count: int, marks: int *, op: int) -> Val {
    list: NumList = {0}
    i: int = 0
    total: double = 0
    n: int = 0
    CollectNumbers(args,count,&list)
    if op == 0 {
        i = 0
        while i < count {
            if args[i].kind == VAL_FLOAT || args[i].kind == VAL_BOOL || args[i].kind == VAL_STRING {
                n += 1
            }
            i += 1
        }
        if n == 0 { return ValError(ERR_VALUE) }
        i = 0
        while i < list.count {
            total += list.data[i]
            i += 1
        }
        return ValNumber(total / (double)n)
    }
    if op == 1 {
        if list.count == 0 { return ValNumber(0) }
        best: double = list.data[0]
        i = 1
        while i < list.count {
            if op == 1 {
                if list.data[i] > best { best = list.data[i] }
            }
            i += 1
        }
        return ValNumber(best)
    }
    if list.count == 0 { return ValNumber(0) }
    best2: double = list.data[0]
    i = 1
    while i < list.count {
        if list.data[i] < best2 { best2 = list.data[i] }
        i += 1
    }
    return ValNumber(best2)
}

FnVarA :: (st: EvalState *, args: Val *, count: int, marks: int *, sample: int, stddev: int) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    n: int = list.count
    if (sample != 0 && n < 2) || n < 1 { return ValError(ERR_VALUE) }
    m: double = StatAverage(list.data,n)
    s: double = 0
    i: int = 0
    while i < n {
        d: double = list.data[i] - m
        s += d * d
        i += 1
    }
    if sample != 0 {
        if stddev != 0 { return ValNumber(sqrt(s / (double)(n - 1))) }
        return ValNumber(s / (double)(n - 1))
    }
    if stddev != 0 { return ValNumber(sqrt(s / (double)n)) }
    return ValNumber(s / (double)n)
}

FnTrimmean :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    vals0: [4096] double = {0}
    n0: int = CollectRangeGroup(args,count,marks,vals0)
    i0: int = 0
    while i0 < n0 {
        list.data[i0] = vals0[i0]
        i0 += 1
    }
    list.count = n0
    n: int = list.count
    p: double = 0
    p = CoerceNumber(&args[count - 1])
    if (p < 0 || p >= 1) { return ValError(ERR_NUM) }
    SortDoubles(list.data,n)
    tc: int = (int)floor((n * p) / 2)
    c: int = n - 2 * tc
    if c <= 0 { return ValError(ERR_VALUE) }
    shifted: [4096] double = {0}
    k2: int = 0
    while k2 < c {
        shifted[k2] = list.data[tc + k2]
        k2 += 1
    }
    return ValNumber(StatAverage(shifted,c))
}

FractileInterSorted :: (xs: double *, n: int, f: double) -> double {
    fpos: double = 0
    pos: int = 0
    residual: double = 0
    if (n <= 0 || f < 0 || f > 1) {
        return 0.0 / 0.0
    }
    fpos = (double)(n - 1) * f
    pos = (int)fpos
    residual = fpos - (double)pos
    if (residual == 0 || pos + 1 >= n) {
        return xs[pos]
    }
    return (1 - residual) * xs[pos] + residual * xs[pos + 1]
}

FnPercentile :: (st: EvalState *, args: Val *, count: int, marks: int *, exc: int) -> Val {
    list: NumList = {0}
    vals0: [4096] double = {0}
    n0: int = CollectRangeGroup(args,count,marks,vals0)
    i0: int = 0
    while i0 < n0 {
        list.data[i0] = vals0[i0]
        i0 += 1
    }
    list.count = n0
    n: int = list.count
    p: double = CoerceNumber(&args[count - 1])
    if n == 0 { return ValError(ERR_NUM) }
    SortDoubles(list.data,n)
    if exc != 0 {
        if n <= 1 { return ValError(ERR_NUM) }
        fr: double = (p * (double)(n + 1) - 1) / (double)(n - 1)
        res: double = FractileInterSorted(list.data,n,fr)
        if (res != res) { return ValError(ERR_NUM) }
        return ValNumber(res)
    }
    res2: double = FractileInterSorted(list.data,n,p)
    if (res2 != res2) { return ValError(ERR_NUM) }
    return ValNumber(res2)
}

FnQuartile :: (st: EvalState *, args: Val *, count: int, marks: int *, exc: int) -> Val {
    list: NumList = {0}
    vals0: [4096] double = {0}
    n0: int = CollectRangeGroup(args,count,marks,vals0)
    i0: int = 0
    while i0 < n0 {
        list.data[i0] = vals0[i0]
        i0 += 1
    }
    list.count = n0
    n: int = list.count
    q: double = floor(CoerceNumber(&args[count - 1]))
    if n == 0 { return ValError(ERR_NUM) }
    if (q < 0 || q > 4) { return ValError(ERR_NUM) }
    SortDoubles(list.data,n)
    if exc != 0 {
        if n <= 1 { return ValError(ERR_NUM) }
        fr: double = ((q / 4) * (double)(n + 1) - 1) / (double)(n - 1)
        if (fr < 0 || fr > 1) { return ValError(ERR_NUM) }
        return ValNumber(FractileInterSorted(list.data,n,fr))
    }
    return ValNumber(FractileInterSorted(list.data,n,q / 4))
}

FnPercentrank :: (st: EvalState *, args: Val *, count: int, marks: int *, exc: int) -> Val {
    list: NumList = {0}
    vals0: [4096] double = {0}
    n0: int = CollectRangeGroup(args,count,marks,vals0)
    i0: int = 0
    while i0 < n0 {
        list.data[i0] = vals0[i0]
        i0 += 1
    }
    list.count = n0
    n: int = list.count
    x: double = CoerceNumber(&args[count - 1])
    sig: double = count >= 3 ? CoerceNumber(&args[2]) : 3
    n_equal: int = 0
    n_smaller: int = 0
    n_larger: int = 0
    x_larger: double = 0
    x_smaller: double = 0
    i: int = 0
    r: double = 0
    if n == 0 { return ValError(ERR_NUM) }
    i = 0
    while i < n {
        y: double = list.data[i]
        if y < x {
            if (n_smaller == 0 || x_smaller < y) { x_smaller = y }
            n_smaller += 1
        }
else if y > x {
            if (n_larger == 0 || x_larger > y) { x_larger = y }
            n_larger += 1
        }
else {
            n_equal += 1
        }
        i += 1
    }
    if (n_smaller + n_equal == 0 || n_larger + n_equal == 0) { return ValError(ERR_NA) }
    if n == 1 {
        r = 1
    }
else {
        if exc != 0 {
            if n_equal > 0 {
                r = (double)(n_smaller + 1) / (double)(n + 1)
            }
else {
                re1: double = (double)n_smaller / (double)(n + 1)
                re2: double = (double)(n_smaller + 1) / (double)(n + 1)
                r = (re1 * (x_larger - x) + re2 * (x - x_smaller)) / (x_larger - x_smaller)
            }
        }
else if n_equal > 0 {
            r = (double)n_smaller / (double)(n - 1)
        }
else {
            r1: double = (double)(n_smaller - 1) / (double)(n - 1)
            r2: double = (double)n_smaller / (double)(n - 1)
            r = (r1 * (x_larger - x) + r2 * (x - x_smaller)) / (x_larger - x_smaller)
        }
        if sig < 1 { return ValError(ERR_NUM) }
        s10: double = pow(10,-sig)
        if s10 <= 0 { return ValError(ERR_DIV0) }
        r = trunc(r / s10) * s10
    }
    return ValNumber(r)
}

FnRank :: (st: EvalState *, args: Val *, count: int, marks: int *, avg: int) -> Val {
    list: NumList = {0}
    vals0: [4096] double = {0}
    g1: int = 0
    l1: int = 0
    n0: int = 0
    if GroupBounds(marks,count,1,&g1,&l1) != 0 {
        n0 = CashList(args + g1,l1,vals0)
    }
    if n0 < 1 { return ValError(ERR_VALUE) }
    i0: int = 0
    while i0 < n0 {
        list.data[i0] = vals0[i0]
        i0 += 1
    }
    list.count = n0
    n: int = list.count
    x: double = CoerceNumber(&args[0])
    increasing: int = count > n0 + 1 ? (CoerceNumber(&args[n0 + 1]) != 0 ? 1 : 0) : 0
    r: int = 1
    t: int = 0
    i: int = 0
    i = 0
    while i < n {
        y: double = list.data[i]
        if (increasing != 0 ? y < x : y > x) {
            r += 1
        }
        if x == y {
            t += 1
        }
        i += 1
    }
    if avg != 0 {
        s: double = (double)r
        k: int = 1
        while k < t {
            s += (double)(r + k)
            k += 1
        }
        return ValNumber(s / (double)t)
    }
    return ValNumber((double)r)
}

FnModeMult :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    n: int = list.count
    if n <= 1 { return ValError(ERR_NA) }
    SortDoubles(list.data,n)
    best: double = 0
    bestrun: int = 0
    i: int = 0
    while i < n {
        j: int = i
        while (j + 1 < n && list.data[j + 1] == list.data[i]) {
            j += 1
        }
        run: int = j - i + 1
        if run > bestrun {
            bestrun = run
            best = list.data[i]
        }
        i = j + 1
    }
    if bestrun <= 1 { return ValError(ERR_NA) }
    return ValNumber(best)
}

FnFrequency :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    data: [4096] double = {0}
    bins: [4096] double = {0}
    gx: int = 0
    gl: int = 0
    bx: int = 0
    bl: int = 0
    rest: int = 0
    nd: int = 0
    nb: int = 0
    if GroupBounds(marks,count,0,&gx,&gl) == 0 {
        gx = 0
        gl = count
    }
    nd = CashList(args + gx,gl,data)
    if nd < 0 { return FirstError(args,count) }
    if GroupBounds(marks,count,1,&bx,&bl) != 0 {
        nb = CashList(args + bx,bl,bins)
    }
else {
        rest = gx + gl
        nb = CashList(args + rest,count - rest,bins)
    }
    if nb < 0 { return FirstError(args,count) }
    if nb == 0 { return ValNumber(nd) }
    SortDoubles(bins,nb)
    firstcount: int = 0
    i: int = 0
    while i < nd {
        v: double = data[i]
        j: int = 0
        while j < nb {
            if v <= bins[j] { break }
            j += 1
        }
        if j == 0 { firstcount += 1 }
        i += 1
    }
    return ValNumber(firstcount)
}

FnZtest :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    vals0: [4096] double = {0}
    n0: int = CollectRangeGroup(args,count,marks,vals0)
    i0: int = 0
    while i0 < n0 {
        list.data[i0] = vals0[i0]
        i0 += 1
    }
    list.count = n0
    n: int = list.count
    x: double = CoerceNumber(&args[n])
    s: double = 0
    m: double = 0
    if n == 0 { return ValError(ERR_DIV0) }
    m = StatAverage(list.data,n)
    if count > n + 1 {
        s = CoerceNumber(&args[n + 1])
    }
else {
        if n < 2 { return ValError(ERR_DIV0) }
        s = sqrt(StatDevsq(list.data,n) / (double)(n - 1))
    }
    if s <= 0 { return ValError(ERR_DIV0) }
    return ValNumber(pnorm(x,m,s / sqrt((double)n),1,0))
}

FnTtest :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    xs: [4096] double = {0}
    ys: [4096] double = {0}
    xn: int = 0
    yn: int = 0
    tails: double = 0
    typ: double = 0
    mx: double = 0
    vx: double = 0
    my: double = 0
    vy: double = 0
    dof: double = 0
    t: double = 0
    if count < 4 { return ValError(ERR_VALUE) }
    tails = CoerceNumber(&args[count - 2])
    typ = CoerceNumber(&args[count - 1])
    if (tails != 1 && tails != 2) { return ValError(ERR_NUM) }
    if (typ != 1 && typ != 2 && typ != 3) { return ValError(ERR_NUM) }
    g0: int = 0
    l0: int = 0
    g1: int = 0
    l1: int = 0
    if GroupBounds(marks,count,0,&g0,&l0) == 0 { return ValError(ERR_VALUE) }
    if GroupBounds(marks,count,1,&g1,&l1) == 0 { return ValError(ERR_VALUE) }
    xn = CashList(args + g0,l0,xs)
    yn = CashList(args + g1,l1,ys)
    if (xn < 0 || yn < 0) { return ValError(ERR_VALUE) }
    if typ == 1 {
        if xn != yn { return ValError(ERR_NA) }
        zm: double = 0
        zs: double = 0
        zs2: double = 0
        i: int = 0
        while i < xn {
            d: double = xs[i] - ys[i]
            zm += d
            zs2 += d * d
            i += 1
        }
        zm /= (double)xn
        zs2 = zs2 - (double)xn * zm * zm
        zs = sqrt(zs2 / (double)(xn - 1))
        if zs == 0 { return ValError(ERR_DIV0) }
        t = sqrt((double)xn) * (zm / zs)
        dof = (double)(xn - 1)
        return ValNumber(tails * pt(fabs(t),dof,0,0))
    }
    mx = StatAverage(xs,xn)
    vx = StatDevsq(xs,xn) / (double)(xn - 1)
    my = StatAverage(ys,yn)
    vy = StatDevsq(ys,yn) / (double)(yn - 1)
    if (vx == 0 && vy == 0) { return ValError(ERR_DIV0) }
    if typ == 3 {
        S: double = vx / (double)xn + vy / (double)yn
        c: double = (vx / (double)xn) / S
        cC: double = (vy / (double)yn) / S
        dof = 1 / (c * c / (double)(xn - 1) + cC * cC / (double)(yn - 1))
        t = fabs(mx - my) / sqrt(S)
    }
else {
        dof = (double)(xn + yn - 2)
        t = fabs(mx - my) * sqrt(dof * (double)xn * (double)yn / ((double)(xn + yn) * ((double)(xn - 1) * vx + (double)(yn - 1) * vy)))
    }
    return ValNumber(tails * pt(t,dof,0,0))
}

SubEpsilon :: (x: double) -> double {
    e: int = 0
    mant: double = 0
    ax: double = 0
    if isfinite(x) == 0 || x == 0 { return x }
    ax = fabs(x)
    mant = frexp(ax,&e)
    if x < 0 {
        return 0 - ldexp(mant + 2.220446049250313e-16 / 2,e)
    }
    return ldexp(mant - 2.220446049250313e-16 / 2,e)
}

AddEpsilon :: (x: double) -> double {
    e: int = 0
    mant: double = 0
    ax: double = 0
    if isfinite(x) == 0 || x == 0 { return x }
    ax = fabs(x)
    mant = frexp(ax,&e)
    if x < 0 {
        return 0 - ldexp(mant - 2.220446049250313e-16 / 2,e)
    }
    return ldexp(mant + 2.220446049250313e-16 / 2,e)
}

FakeFloor :: (x: double) -> double {
    if x == floor(x) { return x }
    return floor(AddEpsilon(x))
}

FakeRound :: (x: double) -> double {
    y: double = 0
    if x == floor(x) { return x }
    y = FakeFloor(fabs(x) + 0.5)
    if x < 0 { return 0 - y }
    return y
}

FakeTrunc :: (x: double) -> double {
    if x == floor(x) { return x }
    if x >= 0 {
        return floor(AddEpsilon(x))
    }
    return 0 - floor(AddEpsilon(0 - x))
}

FakeCeil :: (x: double) -> double {
    if x == floor(x) { return x }
    return ceil(SubEpsilon(x))
}

FnConfidence :: (st: EvalState *, args: Val *, count: int, marks: int *, t_based: int) -> Val {
    alpha: double = 0
    sd: double = 0
    n: double = 0
    if count < 3 { return ValError(ERR_VALUE) }
    alpha = CoerceNumber(&args[0])
    sd = CoerceNumber(&args[1])
    n = FakeFloor(CoerceNumber(&args[2]))
    if t_based != 0 {
        if n == 1 { return ValError(ERR_DIV0) }
        if (n <= 1 || sd <= 0) { return ValError(ERR_NUM) }
        return ValNumber(0 - qt(alpha / 2,n - 1,1,0) * (sd / sqrt(n)))
    }
    if n == 0 { return ValError(ERR_DIV0) }
    if (n <= 0 || sd <= 0) { return ValError(ERR_NUM) }
    return ValNumber(0 - qnorm(alpha / 2,0,1,1,0) * (sd / sqrt(n)))
}

FnDistr3 :: (which: int, args: Val *, count: int) -> Val {
    a: double = 0
    b: double = 0
    c: double = 0
    if count < 2 { return ValError(ERR_VALUE) }
    a = CoerceNumber(&args[0])
    b = CoerceNumber(&args[1])
    c = count >= 3 ? CoerceNumber(&args[2]) : 0
    if which == 0 { return ValNumber(pnorm(a,b,c,1,0)) }
    if which == 1 { return ValNumber(qnorm(a,b,c,1,0)) }
    if which == 2 { return ValNumber(pchisq(a,b,1,0)) }
    if which == 3 { return ValNumber(qchisq(a,b,1,0)) }
    if which == 4 { return ValNumber(pf(a,b,c,1,0)) }
    if which == 5 { return ValNumber(qf(a,b,c,1,0)) }
    if which == 6 { return ValNumber(pt(a,b,1,0)) }
    if which == 7 { return ValNumber(qt(a,b,1,0)) }
    if which == 8 { return ValNumber(pgamma(a,b,c,1,0)) }
    if which == 9 { return ValNumber(qgamma(a,b,c,1,0)) }
    return ValNumber(0)
}


pexp_go :: (x: double, scale: double, lower_tail: int, log_p: int) -> double {
    if (x <= 0) {
        return lower_tail != 0 ? 0.0 : 1.0
    }
    if lower_tail != 0 {
        return 1 - exp(0 - x / scale)
    }
    return exp(0 - x / scale)
}

dexp_go :: (x: double, scale: double) -> double {
    if x <= 0 {
        return 0.0
    }
    return exp(0 - x / scale) / scale
}

pweibull_go :: (x: double, shape: double, scale: double, lower_tail: int, log_p: int) -> double {
    if x <= 0 {
        return lower_tail != 0 ? 0.0 : 1.0
    }
    v: double = exp(0 - pow(x / scale,shape))
    if lower_tail != 0 {
        return 1 - v
    }
    return v
}

pow1p_plain :: (x: double, y: double) -> double {
    if ((x + 1) - 1 == x || x > 0.5 || x < -0.5 || x != x || y != y) { return pow(1 + x,y) }
    if (y < 0) { return 1 / pow1p_plain(x,-y) }
    x1: double = round(x * 65536) / 65536
    x2: double = x - x1
    h: double = 0
    l: double = 0
    Ebd0(y,y * (x + 1),&h,&l)
    PairAdd(0 - y * x1,&h,&l)
    PairAdd(0 - y * x2,&h,&l)
    return exp(0 - l) * exp(0 - h)
}

dweibull_go :: (x: double, shape: double, scale: double) -> double {
    if x <= 0 {
        return 0.0
    }
    xscal: double = pow(x / scale,shape - 1)
    return shape * xscal * exp(0 - xscal * x / scale) / scale
}

DbCond :: struct {
    op: int
    is_num: int
    num: double
    text: [48] char
}

DbParseNumber :: (text: const char *, out: double *) -> int {
    p: const char * = text
    end: char * = NULL
    v: double = 0
    while p[0] == 32 || (p[0] >= 9 && p[0] <= 13) { p += 1 }
    v = strtod(p,&end)
    if end == p { return 0 }
    while end[0] == 32 || (end[0] >= 9 && end[0] <= 13) { end += 1 }
    if end[0] != 0 { return 0 }
    out[0] = v
    return 1
}

DbWildMatch :: (pat: const char *, s: const char *) -> int {
    si: int = 0
    star: int = -1
    ss: int = 0
    pi: int = 0
    lc: [64] char = ""
    ls: [256] char = ""
    i: int = 0
    while i < 63 && s[i] != 0 {
        lc[i] = (char)tolower((unsigned char)s[i])
        i += 1
    }
    lc[i] = 0
    i = 0
    while i < 63 && pat[i] != 0 {
        ls[i] = (char)tolower((unsigned char)pat[i])
        i += 1
    }
    ls[i] = 0
    while lc[si] != 0 {
        if (ls[pi] == 63 || ls[pi] == lc[si]) && ls[pi] != 0 {
            si += 1
            pi += 1
        }
else if ls[pi] == 42 && ls[pi] != 0 {
            star = pi
            pi += 1
            ss = si
        }
else if star >= 0 {
            pi = star + 1
            ss += 1
            si = ss
        }
else {
            return 0
        }
    }
    while ls[pi] == 42 { pi += 1 }
    if ls[pi] == 0 { return 1 }
    return 0
}

DbParseCond :: (v: Val *, out: DbCond *) -> int {
    txt: const char * = ""
    rest: const char * = ""
    num: double = 0
    out->op = 0
    out->is_num = 0
    out->num = 0
    out->text[0] = 0
    if v->kind == VAL_FLOAT {
        out->op = 0
        out->is_num = 1
        out->num = v->number
        return 1
    }
    if v->kind == VAL_BOOL {
        out->op = 0
        out->is_num = 1
        out->num = v->number
        return 1
    }
    if v->kind != VAL_STRING { out->op = 9; return 1 }
    txt = v->text
    if txt[0] == 0 { out->op = 10; return 1 }
    if txt[0] == 60 && txt[1] == 61 {
        rest = txt + 2
        out->op = 5
    }
else if txt[0] == 62 && txt[1] == 61 {
        rest = txt + 2
        out->op = 3
    }
else if txt[0] == 60 && txt[1] == 62 {
        rest = txt + 2
        if rest[0] == 0 {
            out->op = 7
            return 1
        }
        out->op = 1
    }
else if txt[0] == 60 {
        rest = txt + 1
        out->op = 4
    }
else if txt[0] == 61 {
        rest = txt + 1
        if rest[0] == 0 {
            out->op = 8
            return 1
        }
        out->op = 0
    }
else if txt[0] == 62 {
        rest = txt + 1
        out->op = 2
    }
else {
        rest = txt
        out->op = 6
    }
    if DbParseNumber(rest,&num) != 0 {
        out->is_num = 1
        out->num = num
        if out->op == 6 { out->op = 0 }
    }
else {
        i: int = 0
        while i < 47 && rest[i] != 0 {
            out->text[i] = rest[i]
            i += 1
        }
        out->text[i] = 0
    }
    return 1
}

DbTestCond :: (x: Val *, cond: DbCond *) -> int {
    wrong: int = 0
    xf: double = 0
    c: int = 0
    if cond->op == 9 { return 0 }
    if cond->op == 7 {
        if x->kind == VAL_EMPTY { return 0 }
        return 1
    }
    if cond->op == 8 {
        if x->kind == VAL_EMPTY { return 1 }
        return 0
    }
    if cond->op == 10 {
        if x->kind == VAL_EMPTY { return 1 }
        if x->kind == VAL_STRING && x->text[0] == 0 { return 1 }
        return 0
    }
    if cond->op == 6 {
        if x->kind != VAL_STRING { return 0 }
        return DbWildMatch(cond->text,x->text)
    }
    if cond->is_num != 0 {
        if x->kind == VAL_BOOL || x->kind == VAL_ERROR { wrong = 1 }
    else if x->kind == VAL_FLOAT { xf = x->number }
    else if x->kind == VAL_STRING && cond->op == 0 {
            if DbParseNumber(x->text,&xf) == 0 { wrong = 1 }
        }
    else { wrong = 1 }
        if wrong != 0 {
            if cond->op == 1 { return 1 }
            return 0
        }
        if cond->op == 0 { return xf == cond->num ? 1 : 0 }
        if cond->op == 1 { return xf != cond->num ? 1 : 0 }
        if cond->op == 2 { return xf > cond->num ? 1 : 0 }
        if cond->op == 3 { return xf >= cond->num ? 1 : 0 }
        if cond->op == 4 { return xf < cond->num ? 1 : 0 }
        return xf <= cond->num ? 1 : 0
    }
    if x->kind != VAL_STRING { wrong = 1 }
    if wrong != 0 {
        if cond->op == 1 { return 1 }
        return 0
    }
    c = strcasecmp(x->text,cond->text)
    if cond->op == 0 { return c == 0 ? 1 : 0 }
    if cond->op == 1 { return c != 0 ? 1 : 0 }
    if cond->op == 2 { return c > 0 ? 1 : 0 }
    if cond->op == 3 { return c >= 0 ? 1 : 0 }
    if cond->op == 4 { return c < 0 ? 1 : 0 }
    return c <= 0 ? 1 : 0
}

DbFindColumn :: (args: Val *, db_start: int, db_cols: int, db_rows: int, field: Val *) -> int {
    n: int = 0
    hdr: const char * = ""
    if field->kind == VAL_FLOAT || field->kind == VAL_BOOL {
        return (int)field->number - 1
    }
    if field->kind != VAL_STRING { return -2 }
    n = 0
    while n < db_cols {
        cell: Val * = &args[db_start + n]
        if cell->kind == VAL_STRING {
            hdr = cell->text
        }
else if cell->kind == VAL_FLOAT {
            hdr = ""
        }
else {
            hdr = ""
        }
        if cell->kind == VAL_STRING && strcasecmp(field->text,hdr) == 0 { return n }
        n += 1
    }
    return -2
}

DbSetup :: (st: EvalState *, args: Val *, count: int, marks: int *, allow_missing: int, db_start: int *, db_cols: int *, db_rows: int *, fieldno: int *, crit_start: int *, crit_cols: int *, crit_rows: int *, conds: DbCond *, cond_cols: int *, cond_counts: int *, crit_row_count: int *) -> int {
    groups: int = 0
    field: Val * = NULL
    crit_header: [16] int = {0}
    r: int = 0
    c: int = 0
    ci: int = 0
    db_start[0] = 0
    db_cols[0] = 0
    db_rows[0] = 0
    fieldno[0] = -1
    crit_start[0] = 0
    crit_cols[0] = 0
    crit_rows[0] = 0
    crit_row_count[0] = 0
    groups = ArgGroupCount(args,marks,count)
    if groups < 2 { return 0 }
    GroupBounds(marks,count,0,db_start,&db_rows[0])
    db_cols[0] = st->call_group_cols[db_start[0]]
    if db_cols[0] < 1 { return 0 }
    db_rows[0] = db_rows[0] / db_cols[0]
    if db_rows[0] < 2 { return 0 }
    field_missing: int = 0
    if allow_missing != 0 {
        if groups < 3 {
            field_missing = 1
        }
else {
            field = &args[db_start[0] + db_cols[0] * db_rows[0]]
            if (field->kind != VAL_STRING && field->kind != VAL_FLOAT && field->kind != VAL_BOOL) { field_missing = 1 }
        }
    }
    if field_missing != 0 {
        fieldno[0] = -1
        GroupBounds(marks,count,groups - 1,crit_start,&crit_rows[0])
    }
else {
        field = &args[db_start[0] + db_cols[0] * db_rows[0]]
        fieldno[0] = DbFindColumn(args,db_start[0],db_cols[0],db_rows[0],field)
        if fieldno[0] == -2 { return 0 }
        if (fieldno[0] < 0 || fieldno[0] >= db_cols[0]) { fieldno[0] = -3 }
        GroupBounds(marks,count,groups - 1,crit_start,&crit_rows[0])
    }
    if crit_rows[0] < 1 { return 0 }
    crit_cols[0] = st->call_group_cols[crit_start[0]]
    if crit_cols[0] < 1 { return 0 }
    crit_rows[0] = crit_rows[0] / crit_cols[0]
    if crit_rows[0] < 2 { return 0 }
    c = 0
    while c < crit_cols[0] && c < 16 {
        hcell: Val * = &args[crit_start[0] + c]
        crit_header[c] = -2
        if hcell->kind == VAL_STRING && hcell->text[0] != 0 {
            crit_header[c] = DbFindColumn(args,db_start[0],db_cols[0],db_rows[0],hcell)
            if crit_header[c] == -2 { return 0 }
        }
else if hcell->kind == VAL_FLOAT {
            crit_header[c] = DbFindColumn(args,db_start[0],db_cols[0],db_rows[0],hcell)
            if crit_header[c] == -2 { crit_header[c] = -2 }
        }
        c += 1
    }
    r = 1
    while r < crit_rows[0] {
        cnt: int = 0
        c = 0
        while c < crit_cols[0] && c < 16 {
            cc: Val * = &args[crit_start[0] + r * crit_cols[0] + c]
            if cc->kind != VAL_EMPTY {
                if ci < 128 {
                    cond_cols[ci] = crit_header[c]
                    DbParseCond(cc,&conds[ci])
                    ci += 1
                    cnt += 1
                }
            }
            c += 1
        }
        cond_counts[r] = cnt
        r += 1
    }
    crit_row_count[0] = crit_rows[0]
    return 1
}

DbRowMatches :: (args: Val *, db_start: int, db_cols: int, row: int, conds: DbCond *, cond_cols: int *, cond_counts: int *, crit_rows: int) -> int {
    cr: int = 1
    k: int = 0
    ci: int = 0
    while cr < crit_rows {
        all: int = 1
        k = 0
        while k < cond_counts[cr] {
            cond: DbCond * = &conds[ci]
            xv: Val * = NULL
            empty_v: Val = {VAL_EMPTY,0.0,NULL,0,0}
            if cond_cols[ci] >= 0 {
                xv = &args[db_start + row * db_cols + cond_cols[ci]]
            }
else {
                xv = &empty_v
            }
            if DbTestCond(xv,cond) == 0 {
                all = 0
                break
            }
            k += 1
            ci += 1
        }
        if all != 0 { return 1 }
        ci = ci + (cond_counts[cr] - k)
        cr += 1
    }
    return 0
}

DbCollectFloats :: (st: EvalState *, args: Val *, count: int, marks: int *, allow_missing: int, out: double *, out_n: int *, err: int *) -> int {
    db_start: int = 0
    db_cols: int = 0
    db_rows: int = 0
    fieldno: int = -1
    crit_start: int = 0
    crit_cols: int = 0
    crit_rows: int = 0
    conds: [128] DbCond = {0}
    cond_cols: [128] int = {0}
    cond_counts: [64] int = {0}
    crit_row_count: int = 0
    row: int = 1
    n: int = 0
    if DbSetup(st,args,count,marks,allow_missing,&db_start,&db_cols,&db_rows,&fieldno,&crit_start,&crit_cols,&crit_rows,conds,cond_cols,cond_counts,&crit_row_count) == 0 {
        err[0] = ERR_NUM
        return 0
    }
    while row < db_rows {
        cellv: Val * = NULL
        if fieldno == -3 { break }
        if fieldno >= 0 {
            cellv = &args[db_start + row * db_cols + fieldno]
            if cellv->kind == VAL_EMPTY { row += 1; continue }
        }
        if DbRowMatches(args,db_start,db_cols,row,conds,cond_cols,cond_counts,crit_rows) != 0 {
            if fieldno < 0 {
                cellv = &args[db_start + row * db_cols]
                if cellv->kind == VAL_EMPTY { row += 1; continue }
            }
            if cellv->kind == VAL_ERROR { err[0] = cellv->err; return 0 }
            if cellv->kind == VAL_STRING || cellv->kind == VAL_BOOL || cellv->kind == VAL_EMPTY { row += 1; continue }
            if n < 512 {
                out[n] = cellv->number
                n += 1
            }
        }
        row += 1
    }
    out_n[0] = n
    return 1
}

DbCollectValues :: (st: EvalState *, args: Val *, count: int, marks: int *, allow_missing: int, ignore_strings: int, out: Val *, out_n: int *, err: int *) -> int {
    db_start: int = 0
    db_cols: int = 0
    db_rows: int = 0
    fieldno: int = -1
    crit_start: int = 0
    crit_cols: int = 0
    crit_rows: int = 0
    conds: [128] DbCond = {0}
    cond_cols: [128] int = {0}
    cond_counts: [64] int = {0}
    crit_row_count: int = 0
    row: int = 1
    n: int = 0
    if DbSetup(st,args,count,marks,allow_missing,&db_start,&db_cols,&db_rows,&fieldno,&crit_start,&crit_cols,&crit_rows,conds,cond_cols,cond_counts,&crit_row_count) == 0 {
        err[0] = ERR_NUM
        return 0
    }
    while row < db_rows {
        cellv: Val * = NULL
        if fieldno == -3 { break }
        if fieldno >= 0 {
            cellv = &args[db_start + row * db_cols + fieldno]
            if cellv->kind == VAL_EMPTY { row += 1; continue }
        }
        if DbRowMatches(args,db_start,db_cols,row,conds,cond_cols,cond_counts,crit_rows) != 0 {
            if fieldno < 0 {
                cellv = &args[db_start + row * db_cols]
                if n < 512 {
                    out[n] = cellv[0]
                    if cellv->kind == VAL_STRING && cellv->text != NULL {
                        out[n].text = wb_strdup(cellv->text)
                    }
                    n += 1
                }
                row += 1
                continue
            }
            if (ignore_strings != 0 && cellv->kind == VAL_STRING) || cellv->kind == VAL_BOOL || cellv->kind == VAL_EMPTY { row += 1; continue }
            if n < 512 {
                out[n] = cellv[0]
                if cellv->kind == VAL_STRING && cellv->text != NULL {
                    out[n].text = wb_strdup(cellv->text)
                }
                n += 1
            }
        }
        row += 1
    }
    out_n[0] = n
    return 1
}

DbFloatAgg :: (st: EvalState *, args: Val *, count: int, marks: int *, agg: int, zero_num_error: int) -> Val {
    vals: [512] double = {0}
    n: int = 0
    err: int = 0
    i: int = 0
    total: double = 0
    prod: double = 1
    mean: double = 0
    m2: double = 0
    if DbCollectFloats(st,args,count,marks,0,vals,&n,&err) == 0 {
        return ValError(err)
    }
    if n == 0 && zero_num_error != 0 { return ValError(ERR_NUM) }
    if agg == 0 {
        if n == 0 { return ValError(ERR_NUM) }
        i = 0
        while i < n { total += vals[i]; i += 1 }
        return ValNumber(total / (double)n)
    }
    if agg == 1 {
        if n == 0 { return ValError(ERR_NUM) }
        best: double = vals[0]
        i = 1
        while i < n {
            if vals[i] > best { best = vals[i] }
            i += 1
        }
        return ValNumber(best)
    }
    if agg == 2 {
        if n == 0 { return ValError(ERR_NUM) }
        best2: double = vals[0]
        i = 1
        while i < n {
            if vals[i] < best2 { best2 = vals[i] }
            i += 1
        }
        return ValNumber(best2)
    }
    if agg == 3 {
        i = 0
        while i < n { total += vals[i]; i += 1 }
        return ValNumber(total)
    }
    if agg == 4 {
        i = 0
        while i < n { prod *= vals[i]; i += 1 }
        return ValNumber(prod)
    }
    i = 0
    while i < n { total += vals[i]; i += 1 }
    if n == 0 { return ValError(ERR_NUM) }
    mean = total / (double)n
    i = 0
    while i < n {
        d: double = vals[i] - mean
        m2 += d * d
        i += 1
    }
    if agg == 5 {
        if n < 2 { return ValError(ERR_NUM) }
        return ValNumber(sqrt(m2 / (double)(n - 1)))
    }
    if agg == 6 {
        return ValNumber(sqrt(m2 / (double)n))
    }
    if agg == 7 {
        if n < 2 { return ValError(ERR_NUM) }
        return ValNumber(m2 / (double)(n - 1))
    }
    return ValNumber(m2 / (double)n)
}

FnDaverage :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return DbFloatAgg(st,args,count,marks,0,1)
}

FnDmax :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return DbFloatAgg(st,args,count,marks,1,1)
}

FnDmin :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return DbFloatAgg(st,args,count,marks,2,1)
}

FnDsum :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return DbFloatAgg(st,args,count,marks,3,0)
}

FnDproduct :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return DbFloatAgg(st,args,count,marks,4,0)
}

FnDstdev :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return DbFloatAgg(st,args,count,marks,5,0)
}

FnDstdevp :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return DbFloatAgg(st,args,count,marks,6,0)
}

FnDvar :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return DbFloatAgg(st,args,count,marks,7,0)
}

FnDvarp :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return DbFloatAgg(st,args,count,marks,8,0)
}

FnDcount :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    vals: [512] Val = {0}
    n: int = 0
    err: int = 0
    i: int = 0
    n2: int = 0
    if DbCollectValues(st,args,count,marks,1,1,vals,&n,&err) == 0 {
        return ValError(err)
    }
    i = 0
    while i < n {
        if vals[i].kind == VAL_ERROR { i += 1; continue }
        n2 += 1
        i += 1
    }
    return ValNumber((double)n2)
}

FnDcounta :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    vals: [512] Val = {0}
    n: int = 0
    err: int = 0
    if DbCollectValues(st,args,count,marks,1,0,vals,&n,&err) == 0 {
        return ValError(err)
    }
    return ValNumber((double)n)
}

FnDget :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    vals: [512] Val = {0}
    n: int = 0
    err: int = 0
    res: Val = {VAL_EMPTY,0.0,NULL,0,0}
    if DbCollectValues(st,args,count,marks,0,0,vals,&n,&err) == 0 {
        return ValError(err)
    }
    if n == 0 { return ValError(ERR_VALUE) }
    res = vals[0]
    cleanup_i: int = 1
    while cleanup_i < n {
        if vals[cleanup_i].kind == VAL_STRING && vals[cleanup_i].text != NULL {
            free((void *)vals[cleanup_i].text)
        }
        cleanup_i += 1
    }
    return res
}

FnGetpivotdata :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    db_start: int = 0
    db_cols: int = 0
    db_rows: int = 0
    groups: int = 0
    fieldno: int = -1
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].from_range == 0 { return ValError(ERR_VALUE) }
    groups = ArgGroupCount(args,marks,count)
    if groups < 1 { return ValError(ERR_REF) }
    GroupBounds(marks,count,0,&db_start,&db_rows)
    db_cols = st->call_group_cols[db_start]
    if db_cols < 1 { return ValError(ERR_REF) }
    db_rows = db_rows / db_cols
    if db_rows < 1 { return ValError(ERR_REF) }
    fieldno = DbFindColumn(args,db_start,db_cols,db_rows,&args[db_start + db_cols * db_rows])
    if fieldno < 0 || fieldno >= db_cols { return ValError(ERR_REF) }
    cellv: Val * = &args[db_start + (db_rows - 1) * db_cols + fieldno]
    if cellv->kind != VAL_FLOAT { return ValError(ERR_REF) }
    return ValNumber(cellv->number)
}

FnSwitch :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    ref: Val * = NULL
    a: int = 1
    matched: int = 0
    if count < 1 { return ValError(ERR_VALUE) }
    ref = &args[0]
    if ref->kind == VAL_ERROR { return ValError(ref->err) }
    a = 1
    while (a + 1 < count) {
        v: Val * = &args[a]
        if v->kind == VAL_ERROR { return ValError(v->err) }
        eq: int = 0
        if (ref->kind == VAL_FLOAT && v->kind == VAL_FLOAT && ref->number == v->number) { eq = 1 }
        if (ref->kind == VAL_STRING && v->kind == VAL_STRING && strcmp(ref->text,v->text) == 0) { eq = 1 }
        if (ref->kind == VAL_BOOL && v->kind == VAL_BOOL && ref->number == v->number) { eq = 1 }
        if eq != 0 {
            if args[a + 1].kind == VAL_ERROR { return ValError(args[a + 1].err) }
            if args[a + 1].kind == VAL_STRING { return ValString(wb_strdup(args[a + 1].text)) }
            return args[a + 1]
        }
        a += 2
    }
    if a < count {
        if args[a].kind == VAL_ERROR { return ValError(args[a].err) }
        if args[a].kind == VAL_STRING { return ValString(wb_strdup(args[a].text)) }
        return args[a]
    }
    return ValError(ERR_NA)
}

FnSheetFn :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return ValNumber(1)
}

FnSheetsFn :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return ValNumber((double)st->wb->sheet_count)
}

EasterForYear :: (year: int, y: int *, m: int *, d: int *) {
    century: int = year / 100
    n: int = year - 19 * (year / 19)
    k: int = (century - 17) / 25
    i: int = century - century / 4 - (century - k) / 3 + 19 * n + 15
    j: int = 0
    l: int = 0
    i = i % 30
    i = i - i / 28 * (1 - i / 28 * (29 / (i + 1)) * ((21 - n) / 11))
    j = year + year / 4 + i + 2 - century + century / 4
    j = j % 7
    l = i - j
    m[0] = 3 + (l + 40) / 44
    d[0] = l + 28 - 31 * (m[0] / 4)
    y[0] = year
}

AdjustYear :: (year: int) -> int {
    if year < 0 { return -1 }
    if year <= 29 { return 2000 + year }
    if year <= 99 { return 1900 + year }
    if year < 1582 { return -1 }
    if year > 9956 { return -1 }
    return year
}

FnEaster :: (diff: int, args: Val *, count: int) -> Val {
    year_in: double = 0
    year: int = 0
    y: int = 0
    m: int = 0
    d: int = 0
    serial: int = 0
    if count >= 1 {
        year_in = CoerceNumber(&args[0])
        year = AdjustYear((int)year_in)
        if year < 0 { return ValError(ERR_NUM) }
        EasterForYear(year,&y,&m,&d)
    }
else {
        return ValError(ERR_VALUE)
    }
    serial = YmdToSerial(y,m,d) + diff
    return ValNumber((double)serial)
}

FnDate2julian :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    serial: int = 0
    y: int = 0
    m: int = 0
    d: int = 0
    if count < 1 { return ValError(ERR_VALUE) }
    serial = (int)CoerceNumber(&args[0])
    if serial < 61 { return ValError(ERR_NUM) }
    SerialToYmd(serial,&y,&m,&d)
    return ValNumber((double)(DaysFromCivil(y,m,d) + 2440588))
}

FnNotAvail :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return ValError(ERR_NA)
}

WeekdayMon0 :: (serial: int) -> int {
    wd: int = (serial - 2) % 7
    if wd < 0 { wd += 7 }
    return wd
}

IsoYearStart :: (y: int) -> int {
    jan4: int = YmdToSerial(y,1,4)
    return jan4 - WeekdayMon0(jan4)
}

IsoWeekNum :: (serial: int) -> int {
    thu: int = serial + 3 - WeekdayMon0(serial)
    ty: int = 0
    m: int = 0
    d: int = 0
    SerialToYmd(thu,&ty,&m,&d)
    return (thu - IsoYearStart(ty)) / 7 + 1
}

FnIsoWeekYear :: (which: int, args: Val *, count: int) -> Val {
    serial: int = 0
    wk: int = 0
    y: int = 0
    m: int = 0
    d: int = 0
    if count < 1 { return ValError(ERR_VALUE) }
    serial = (int)CoerceNumber(&args[0])
    if serial < 1 { return ValError(ERR_VALUE) }
    if which == 0 { return ValNumber((double)IsoWeekNum(serial)) }
    SerialToYmd(serial,&y,&m,&d)
    wk = IsoWeekNum(serial)
    if (wk >= 52 && m == 1) { y -= 1 }
    if (wk == 1 && m == 12) { y += 1 }
    return ValNumber((double)y)
}

IsWeekend :: (serial: int) -> int {
    wd: int = WeekdayMon0(serial)
    if wd >= 5 { return 1 }
    return 0
}

CollectHolidays :: (args: Val *, count: int, index: int, hol: int *, max_n: int) -> int {
    n: int = 0
    i: int = 0
    if index >= count { return 0 }
    i = index
    while i < count {
        if args[i].kind == VAL_FLOAT {
            s: int = (int)args[i].number
            dup: int = 0
            j: int = 0
            while j < n {
                if hol[j] == s { dup = 1 }
                j += 1
            }
            if (dup == 0 && n < max_n) {
                hol[n] = s
                n += 1
            }
        }
        i += 1
    }
    return n
}

FnWorkday :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    serial: int = 0
    days: double = 0
    idays: int = 0
    hol: [256] int = {0}
    nhol: int = 0
    step: int = 0
    moved: int = 0
    if count < 2 { return ValError(ERR_VALUE) }
    serial = (int)CoerceNumber(&args[0])
    days = CoerceNumber(&args[1])
    idays = (int)days
    nhol = CollectHolidays(args,count,2,hol,256)
    if idays == 0 { return ValNumber((double)serial) }
    step = idays > 0 ? 1 : -1
    while moved < (idays > 0 ? idays : -idays) {
        serial += step
        if IsWeekend(serial) == 0 {
            ishol: int = 0
            k: int = 0
            while k < nhol {
                if hol[k] == serial { ishol = 1 }
                k += 1
            }
            if ishol == 0 { moved += 1 }
        }
    }
    return ValNumber((double)serial)
}

FnNetworkdays :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    start_s: int = 0
    end_s: int = 0
    total: int = 0
    hol: [256] int = {0}
    nhol: int = 0
    s: int = 0
    if count < 2 { return ValError(ERR_VALUE) }
    start_s = (int)CoerceNumber(&args[0])
    end_s = (int)CoerceNumber(&args[1])
    if start_s > end_s {
        t: int = start_s
        start_s = end_s
        end_s = t
    }
    nhol = CollectHolidays(args,count,2,hol,256)
    s = start_s
    while s <= end_s {
        if IsWeekend(s) == 0 {
            ishol: int = 0
            k: int = 0
            while k < nhol {
                if hol[k] == s { ishol = 1 }
                k += 1
            }
            if ishol == 0 { total += 1 }
        }
        s += 1
    }
    return ValNumber((double)total)
}

FnIsNontext :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_STRING { return ValBool(0) }
    return ValBool(1)
}

FnErrorType :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 1 { return ValError(ERR_NA) }
    if args[0].kind != VAL_ERROR { return ValError(ERR_NA) }
    if args[0].err == ERR_NULL { return ValNumber(1) }
    if args[0].err == ERR_DIV0 { return ValNumber(2) }
    if args[0].err == ERR_VALUE { return ValNumber(3) }
    if args[0].err == ERR_REF { return ValNumber(4) }
    if args[0].err == ERR_NAME { return ValNumber(5) }
    if args[0].err == ERR_NUM { return ValNumber(6) }
    return ValNumber(7)
}

FnGetenv :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    name: [128] char = ""
    v: CString = NULL
    if count < 1 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,name,sizeof(name)) < 0 { return ValError(ERR_VALUE) }
    v = getenv(name)
    if v == NULL { return ValError(ERR_VALUE) }
    return ValString(wb_strdup(v))
}

FnInfoFn :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    key: [32] char = ""
    if count < 1 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,key,sizeof(key)) < 0 { return ValError(ERR_VALUE) }
    if strcmp(key,"release") == 0 { return ValString(wb_strdup("1.12.57")) }
    if strcmp(key,"os-version") == 0 { return ValString(wb_strdup("Linux")) }
    if strcmp(key,"version") == 0 { return ValNumber(1) }
    return ValError(ERR_VALUE)
}

FnIlog :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    x: double = 0
    b: double = 0
    r: double = 0
    if count < 1 { return ValError(ERR_VALUE) }
    x = CoerceNumber(&args[0])
    b = count >= 2 ? CoerceNumber(&args[1]) : 2
    if (b <= 1 || x < 1) { return ValError(ERR_NUM) }
    r = floor(log(x) / log(b))
    while (pow(b,r + 1) <= x) { r += 1 }
    while (pow(b,r) > x) { r -= 1 }
    return ValNumber(r)
}

FnLambertw :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    x: double = 0
    k: int = 0
    w: double = 0
    wmin: double = 0
    wmax: double = 0
    i: int = 0
    one_over_e: double = 1 / 2.718281828459045235360287
    sqooe: double = 0
    if count < 1 { return ValError(ERR_VALUE) }
    x = CoerceNumber(&args[0])
    k = count >= 2 ? (int)CoerceNumber(&args[1]) : 0
    sqooe = sqrt(1 / 2.718281828459045235360287)
    if (x != x || x < -one_over_e) { return ValError(ERR_NUM) }
    if x == -one_over_e { return ValNumber(-1) }
    if k == 0 {
        if x < 0 {
            w = 1.5 * (sqrt(x + one_over_e) - sqooe)
        }
else if x < 10 {
            w = sqrt(x) / 1.7
        }
else {
            w = log(x) - log(log(x))
        }
        wmin = -1
        wmax = 1e308 * 10
    }
else if k == -1 {
        if x >= 0 { return ValError(ERR_NUM) }
        if x < -0.1 {
            w = -1 - 3 * sqrt(x + one_over_e)
        }
else {
            w = log(-x) - log(0 - log(-x))
        }
        wmin = -1e308 * 10
        wmax = -1
    }
else {
        return ValError(ERR_NUM)
    }
    i = 0
    while i < 20 {
        ew: double = exp(w)
        wew: double = w * ew
        d1: double = ew * (w + 1)
        d2: double = ew * (w + 2)
        wold: double = w
        dw: double = -2 * ((wew - x) * d1) / (2 * d1 * d1 - (wew - x) * d2)
        w += dw
        if (w <= wmin || w >= wmax) {
            l: double = w < wmin ? wmin : wmax
            dw = (l - wold) * 15 / 16
            w = wold + dw
        }
        if (fabs(dw) <= 2 * 2.2204460492503131e-16 * fabs(w)) { break }
        i += 1
    }
    return ValNumber(w)
}

FnClean :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    txt: [512] char = ""
    out: [512] char = ""
    n: int = 0
    i: int = 0
    if count < 1 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,txt,sizeof(txt)) < 0 { return ValError(ERR_VALUE) }
    i = 0
    while txt[i] != 0 {
        if (unsigned char)txt[i] >= 32 {
            out[n] = txt[i]
            n += 1
        }
        i += 1
    }
    out[n] = 0
    return ValString(wb_strdup(out))
}

Utf8Encode :: (cp: int, out: char *) -> int {
    if cp < 0 {
        return 0
    }
    if cp < 128 {
        out[0] = (char)cp
        out[1] = 0
        return 1
    }
    if cp < 2048 {
        out[0] = (char)(192 | cp >> 6)
        out[1] = (char)(128 | (cp & 63))
        out[2] = 0
        return 2
    }
    if cp < 65536 {
        out[0] = (char)(224 | cp >> 12)
        out[1] = (char)(128 | ((cp >> 6) & 63))
        out[2] = (char)(128 | (cp & 63))
        out[3] = 0
        return 3
    }
    if cp < 1114112 {
        out[0] = (char)(240 | cp >> 18)
        out[1] = (char)(128 | ((cp >> 12) & 63))
        out[2] = (char)(128 | ((cp >> 6) & 63))
        out[3] = (char)(128 | (cp & 63))
        out[4] = 0
        return 4
    }
    return 0
}

Utf8Decode1 :: (s: const char *) -> int {
    b0: int = (unsigned char)s[0]
    if b0 < 128 { return b0 }
    if (b0 & 224) == 192 {
        return ((b0 & 31) << 6) | ((unsigned char)s[1] & 63)
    }
    if (b0 & 240) == 224 {
        return ((b0 & 15) << 12) | (((unsigned char)s[1] & 63) << 6) | ((unsigned char)s[2] & 63)
    }
    if (b0 & 248) == 240 {
        return ((b0 & 7) << 18) | (((unsigned char)s[1] & 63) << 12) | (((unsigned char)s[2] & 63) << 6) | ((unsigned char)s[3] & 63)
    }
    return b0
}

FnUnichar :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    out: [8] char = ""
    n: int = 0
    cp: int = 0
    if count < 1 { return ValError(ERR_VALUE) }
    cp = (int)CoerceNumber(&args[0])
    if (cp < 0 || cp > 1114111) { return ValError(ERR_VALUE) }
    if (cp >= 55296 && cp <= 57343) { return ValError(ERR_VALUE) }
    n = Utf8Encode(cp,out)
    if n == 0 { return ValError(ERR_VALUE) }
    return ValString(wb_strdup(out))
}

FnUnicode :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    txt: [512] char = ""
    if count < 1 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,txt,sizeof(txt)) < 0 { return ValError(ERR_VALUE) }
    if txt[0] == 0 { return ValError(ERR_VALUE) }
    return ValNumber((double)Utf8Decode1(txt))
}

FnTextjoin :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    delim: [64] char = ""
    ignore_empty: int = 1
    out: [2048] char = ""
    n: int = 0
    first: int = 1
    i: int = 2
    piece: [512] char = ""
    if count < 3 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,delim,sizeof(delim)) < 0 { return ValError(ERR_VALUE) }
    if count >= 2 { ignore_empty = CoerceNumber(&args[1]) != 0 ? 1 : 0 }
    while i < count {
        if args[i].kind == VAL_ERROR { return ValError(args[i].err) }
        if args[i].kind == VAL_FLOAT {
            FormatNumber(args[i].number,piece,sizeof(piece))
        }
else if args[i].kind == VAL_STRING {
            snprintf(piece,sizeof(piece),"%s",args[i].text)
        }
else {
            piece[0] = 0
        }
        if (piece[0] != 0 || ignore_empty == 0) {
            if first == 0 {
                n = (int)strlen(out)
                snprintf(out + n,sizeof(out) - n,"%s",delim)
            }
            n = (int)strlen(out)
            snprintf(out + n,sizeof(out) - n,"%s",piece)
            first = 0
        }
        i += 1
    }
    return ValString(wb_strdup(out))
}

FnArabic :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    txt: [256] char = ""
    result: int = 0
    last: int = 0
    i: int = 0
    this_val: int = 0
    if count < 1 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,txt,sizeof(txt)) < 0 { return ValError(ERR_VALUE) }
    i = (int)strlen(txt) - 1
    while i >= 0 {
        this_val = 0
        if (txt[i] == 105 || txt[i] == 73) { this_val = 1 }
        if (txt[i] == 118 || txt[i] == 86) { this_val = 5 }
        if (txt[i] == 120 || txt[i] == 88) { this_val = 10 }
        if (txt[i] == 108 || txt[i] == 76) { this_val = 50 }
        if (txt[i] == 99 || txt[i] == 67) { this_val = 100 }
        if (txt[i] == 100 || txt[i] == 68) { this_val = 500 }
        if (txt[i] == 109 || txt[i] == 77) { this_val = 1000 }
        if this_val > 0 {
            if this_val < last {
                result -= this_val
            }
else {
                result += this_val
                last = this_val
            }
        }
        i -= 1
    }
    return ValNumber((double)result)
}

RomanSub2 :: (buf: char *, find: const char *, a: int, b: int, shrink: int) {
    p: CString = strstr(buf,find)
    i: int = 0
    j: int = 0
    if p == NULL { return }
    i = (int)(p - buf)
    buf[i] = (char)a
    buf[i + 1] = (char)b
    j = i + 2
    while buf[j + shrink] != 0 {
        buf[j] = buf[j + shrink]
        j += 1
    }
    buf[j] = 0
}

RomanSub3 :: (buf: char *, find: const char *, a: int, b: int, c: int, shrink: int) {
    p: CString = strstr(buf,find)
    i: int = 0
    j: int = 0
    if p == NULL { return }
    i = (int)(p - buf)
    buf[i] = (char)a
    buf[i + 1] = (char)b
    buf[i + 2] = (char)c
    j = i + 3
    while buf[j + shrink] != 0 {
        buf[j] = buf[j + shrink]
        j += 1
    }
    buf[j] = 0
}

RomanSub4 :: (buf: char *, find: const char *, c0: int, c1: int, c2: int, c3: int) {
    p: CString = strstr(buf,find)
    i: int = 0
    if p == NULL { return }
    i = (int)(p - buf)
    buf[i] = (char)c0
    buf[i + 1] = (char)c1
    buf[i + 2] = (char)c2
    buf[i + 3] = (char)c3
}

FnRoman :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    letter: [7] char = {'M','D','C','L','X','V','I'}
    buf: [256] char = ""
    n: double = 0
    form: double = 0
    dec: int = 1000
    i: int = 0
    j: int = 0
    if count < 1 { return ValError(ERR_VALUE) }
    n = floor(CoerceNumber(&args[0]))
    form = count >= 2 ? floor(CoerceNumber(&args[1])) : 0
    if (n < 0 || n > 3999) { return ValError(ERR_VALUE) }
    if (form < 0 || form > 4) { return ValError(ERR_VALUE) }
    if n == 0 { return ValString(wb_strdup("")) }
    dec = 1000
    j = 0
    while dec > 1 {
        while n > 0 {
            if n >= dec {
                buf[i] = letter[j]
                i += 1
                n -= dec
            }
else if n >= dec - dec / 10 {
                buf[i] = letter[j + 2]
                i += 1
                buf[i] = letter[j]
                i += 1
                n -= dec - dec / 10
            }
else if n >= dec / 2 {
                buf[i] = letter[j + 1]
                i += 1
                n -= dec / 2
            }
else if n >= dec / 2 - dec / 10 {
                buf[i] = letter[j + 2]
                i += 1
                buf[i] = letter[j + 1]
                i += 1
                n -= dec / 2 - dec / 10
            }
else if dec == 10 {
                buf[i] = letter[j + 2]
                i += 1
                n -= 1
            }
else {
                break
            }
        }
        dec /= 10
        j += 2
    }
    buf[i] = 0
    if form > 0 {
        RomanSub2(buf,"XLV",'V','L',1)
        RomanSub2(buf,"XCV",'V','C',1)
        RomanSub2(buf,"CDL",'L','D',1)
        RomanSub2(buf,"CML",'L','M',1)
        RomanSub4(buf,"CMVC",'L','M','V','L')
    }
    if form == 1 {
        RomanSub4(buf,"CDXC",'L','D','X','L')
        RomanSub4(buf,"CDVC",'L','D','V','L')
        RomanSub4(buf,"CMXC",'L','M','X','L')
        RomanSub4(buf,"XCIX",'V','C','I','V')
        RomanSub4(buf,"XLIX",'V','L','I','V')
    }
    if form > 1 {
        RomanSub2(buf,"XLIX",'I','L',2)
        RomanSub2(buf,"XCIX",'I','C',2)
        RomanSub2(buf,"CDXC",'X','D',2)
        RomanSub2(buf,"CDVC",'X','D',1)
        RomanSub4(buf,"CDIC",'X','D','I','X')
        RomanSub3(buf,"LMVL",'X','M','V',1)
        RomanSub4(buf,"CMIC",'X','M','I','X')
        RomanSub2(buf,"CMXC",'X','M',2)
    }
    if form > 2 {
        RomanSub2(buf,"XDV",'V','D',1)
        RomanSub4(buf,"XDIX",'V','D','I','V')
        RomanSub2(buf,"XMV",'V','M',1)
        RomanSub4(buf,"XMIX",'V','M','I','V')
    }
    if form == 4 {
        RomanSub2(buf,"VDIV",'I','D',2)
        RomanSub2(buf,"VMIV",'I','M',2)
    }
    return ValString(wb_strdup(buf))
}

FnEncodeurl :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    txt: [512] char = ""
    out: [2048] char = ""
    n: int = 0
    i: int = 0
    c: int = 0
    hexd: CString = "0123456789ABCDEF"
    if count < 1 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,txt,sizeof(txt)) < 0 { return ValError(ERR_VALUE) }
    if txt[0] == 0 { return ValError(ERR_VALUE) }
    i = 0
    while txt[i] != 0 {
        c = (unsigned char)txt[i]
        if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 || c == 46 || c == 95 || c == 126 || c == 33 || c == 36 || c == 38 || c == 39 || c == 40 || c == 41 || c == 42 || c == 43 || c == 44 || c == 59 || c == 61 || c == 58 || c == 64 || c == 47) {
            out[n] = (char)c
            n += 1
        }
else {
            out[n] = 37
            out[n + 1] = hexd[c >> 4]
            out[n + 2] = hexd[c & 15]
            n += 3
        }
        i += 1
    }
    out[n] = 0
    return ValString(wb_strdup(out))
}

FnLenb :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    txt: [512] char = ""
    if count < 1 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,txt,sizeof(txt)) < 0 { return ValError(ERR_VALUE) }
    return ValNumber((double)strlen(txt))
}

FnLeftb :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    txt: [512] char = ""
    out: [512] char = ""
    cnt: double = 1
    icount: int = 0
    len: int = 0
    newlen: int = 0
    if count < 1 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,txt,sizeof(txt)) < 0 { return ValError(ERR_VALUE) }
    cnt = count >= 2 ? CoerceNumber(&args[1]) : 1
    if cnt < 0 { return ValError(ERR_VALUE) }
    icount = (int)cnt
    len = (int)strlen(txt)
    if icount >= len { return ValString(wb_strdup(txt)) }
    newlen = icount
    while (newlen > 0 && ((unsigned char)txt[newlen] & 192) == 128) { newlen -= 1 }
    memcpy(out,txt,(size_t)newlen)
    out[newlen] = 0
    return ValString(wb_strdup(out))
}

FnRightb :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    txt: [512] char = ""
    cnt: double = 1
    icount: int = 0
    len: int = 0
    start: int = 0
    if count < 1 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,txt,sizeof(txt)) < 0 { return ValError(ERR_VALUE) }
    cnt = count >= 2 ? CoerceNumber(&args[1]) : 1
    if cnt < 0 { return ValError(ERR_VALUE) }
    icount = (int)cnt
    len = (int)strlen(txt)
    if icount >= len { return ValString(wb_strdup(txt)) }
    start = len - icount
    while (start < len && ((unsigned char)txt[start] & 192) == 128) { start += 1 }
    return ValString(wb_strdup(txt + start))
}

FnMidb :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    txt: [512] char = ""
    out: [512] char = ""
    pos: double = 0
    cnt: double = 0
    ipos: int = 0
    icnt: int = 0
    len: int = 0
    start: int = 0
    endp: int = 0
    if count < 3 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,txt,sizeof(txt)) < 0 { return ValError(ERR_VALUE) }
    pos = CoerceNumber(&args[1])
    cnt = CoerceNumber(&args[2])
    if (pos < 1 || cnt < 0) { return ValError(ERR_VALUE) }
    ipos = (int)pos
    icnt = (int)cnt
    len = (int)strlen(txt)
    if ipos > len { return ValError(ERR_VALUE) }
    start = ipos - 1
    while (start < len && ((unsigned char)txt[start] & 192) == 128) { start += 1 }
    endp = start + icnt
    if endp > len { endp = len }
    while (endp > start && endp < len && ((unsigned char)txt[endp] & 192) == 128) { endp -= 1 }
    memcpy(out,txt + start,(size_t)(endp - start))
    out[endp - start] = 0
    return ValString(wb_strdup(out))
}

FnNumbervalue :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return ValError(ERR_NA)
}

FnNumbervalueUnused :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    txt: [256] char = ""
    sep: [8] char = "."
    grp: [8] char = ","
    out: [256] char = ""
    n: int = 0
    i: int = 0
    v: double = 0
    end: char * = NULL
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_FLOAT { return ValNumber(args[0].number) }
    if TextArg(args,count,0,txt,sizeof(txt)) < 0 { return ValError(ERR_VALUE) }
    if count >= 2 {
        if TextArg(args,count,1,sep,sizeof(sep)) < 0 { return ValError(ERR_VALUE) }
    }
    if count >= 3 {
        if TextArg(args,count,2,grp,sizeof(grp)) < 0 { return ValError(ERR_VALUE) }
    }
    if strcmp(sep,grp) == 0 { return ValError(ERR_VALUE) }
    i = 0
    while txt[i] != 0 {
        c: int = (unsigned char)txt[i]
        if c == 32 {
            i += 1
            continue
        }
        if grp[0] != 0 && c == (unsigned char)grp[0] && sep[0] != 0 {
            i += 1
            continue
        }
        if sep[0] != 0 && c == (unsigned char)sep[0] {
            out[n] = 46
        }
else {
            out[n] = (char)c
        }
        n += 1
        i += 1
    }
    out[n] = 0
    v = strtod(out,&end)
    if end == out || end[0] != 0 { return ValError(ERR_VALUE) }
    return ValNumber(v)
}

GoTanpi :: (x_in: double) -> double {
    x: double = x_in
    x = fmod(x,1.0)
    if x == 0 { return copysign(0.0,x) }
    if fabs(x) == 0.5 { return copysign(0.0 / 0.0,x) }
    return GoSinpi(x) / GoCosPi(x)
}

GoCotpi :: (x_in: double) -> double {
    x: double = x_in
    x = fmod(x,1.0)
    if x == 0 { return copysign(0.0 / 0.0,x) }
    if fabs(x) == 0.5 { return copysign(0.0,x) }
    return GoCosPi(x) / GoSinpi(x)
}

FnMath1 :: (op: int, args: Val *, count: int) -> Val {
    v: double = 0
    if count < 1 { return ValError(ERR_VALUE) }
    v = CoerceNumber(&args[0])
    if op == 0 { return ValNumber(atan(1 / v)) }
    if op == 1 {
        if fabs(v) > 2 { return ValNumber(0.5 * log1p(2 / (v - 1))) }
        return ValNumber(0.5 * log((v + 1) / (v - 1)))
    }
    if op == 2 { return ValNumber(acosh(v)) }
    if op == 3 { return ValNumber(asinh(v)) }
    if op == 4 { return ValNumber(atanh(v)) }
    if op == 5 { return ValNumber(expm1(v)) }
    if op == 6 { return ValNumber(log2(v)) }
    if op == 7 { return ValNumber(sqrt(v * 3.141592653589793)) }
    if op == 8 { return ValNumber(GoSinpi(v)) }
    if op == 9 { return ValNumber(GoCosPi(v)) }
    if op == 10 { return ValNumber(GoTanpi(v)) }
    return ValNumber(GoCotpi(v))
}

FnHypot :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    a: double = 0
    b: double = 0
    if count < 2 { return ValError(ERR_VALUE) }
    a = CoerceNumber(&args[0])
    b = CoerceNumber(&args[1])
    return ValNumber(hypot(a,b))
}

FnCeiling :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    x: double = 0
    s: double = 0
    if count < 1 { return ValError(ERR_VALUE) }
    x = CoerceNumber(&args[0])
    s = count >= 2 ? CoerceNumber(&args[1]) : (x > 0 ? 1 : -1)
    if (x == 0 || s == 0) { return ValNumber(0) }
    if (x > 0 && s < 0) { return ValError(ERR_NUM) }
    return ValNumber(ceil(x / s) * s)
}

FnMround :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    number: double = 0
    multiple: double = 0
    sign: int = 1
    mod: double = 0
    div: double = 0
    if count < 2 { return ValError(ERR_VALUE) }
    number = CoerceNumber(&args[0])
    multiple = CoerceNumber(&args[1])
    if multiple == 0 { return ValNumber(0) }
    if ((number > 0 && multiple < 0) || (number < 0 && multiple > 0)) { return ValError(ERR_NUM) }
    if number < 0 {
        sign = -1
        number = -number
        multiple = -multiple
    }
    mod = fmod(number,multiple)
    div = (mod >= multiple / 2 ? multiple : 0) + (number - mod)
    return ValNumber(sign * div)
}

FnIsEvenOdd :: (even: int, args: Val *, count: int) -> Val {
    v: double = 0
    r: double = 0
    if count < 1 { return ValError(ERR_VALUE) }
    v = CoerceNumber(&args[0])
    r = fmod(fabs(v),2)
    if even != 0 { return ValBool(r < 1 ? 1 : 0) }
    return ValBool(r >= 1 ? 1 : 0)
}

FnPairAgg :: (op: int, args: Val *, count: int, marks: int *) -> Val {
    xs: [4096] double = {0}
    ys: [4096] double = {0}
    s: double = 0
    i: int = 0
    n: int = 0
    gx: int = 0
    gl: int = 0
    hy: int = 0
    hl: int = 0
    xn: int = 0
    yn: int = 0
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].from_range != 0 || args[1].from_range != 0 { return ValError(ERR_VALUE) }
    if GroupBounds(marks,count,0,&gx,&gl) == 0 { return ValError(ERR_VALUE) }
    if GroupBounds(marks,count,1,&hy,&hl) == 0 { return ValError(ERR_VALUE) }
    xn = CashList(args + gx,gl,xs)
    yn = CashList(args + hy,hl,ys)
    if (xn < 0 || yn < 0) { return ValError(ERR_VALUE) }
    if (xn != yn || xn == 0) { return ValError(ERR_NA) }
    n = xn
    i = 0
    while i < n {
        if op == 0 {
            s += xs[i] * xs[i] - ys[i] * ys[i]
        }
else if op == 1 {
            s += xs[i] * xs[i] + ys[i] * ys[i]
        }
else {
            s += (xs[i] - ys[i]) * (xs[i] - ys[i])
        }
        i += 1
    }
    return ValNumber(s)
}

FnSumsq :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    s: double = 0
    i: int = 0
    CollectNumbers(args,count,&list)
    while i < list.count {
        s += list.data[i] * list.data[i]
        i += 1
    }
    return ValNumber(s)
}

FnMultinomial :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    result: double = 1
    sum: int = 0
    i: int = 0
    j: int = 0
    CollectNumbers(args,count,&list)
    while i < list.count {
        x: double = list.data[i]
        xi: int = 0
        if (x < 0 || x > 2147483647) { return ValError(ERR_NUM) }
        xi = (int)x
        if (sum != 0 && xi != 0) {
            f: int = sum + xi
            result *= f
            f -= 1
            j = 2
            while j <= xi {
                result = result * f / j
                f -= 1
                j += 1
            }
        }
        sum += xi
        i += 1
    }
    return ValNumber(result)
}

Cplx :: struct {
    re: double
    im: double
}

CxParse :: (src_in: const char *, dst: Cplx *, unit: int *) -> int {
    src: const char * = src_in
    end: char * = NULL
    x: double = 0
    y: double = 0
    sign: int = 0
    unit[0] = 105
    dst->re = 0
    dst->im = 0
    while (src[0] == 32 || (src[0] >= 9 && src[0] <= 13)) { src += 1 }
    if src[0] == 45 {
        sign = -1
        src += 1
        while (src[0] == 32 || (src[0] >= 9 && src[0] <= 13)) { src += 1 }
    }
else if src[0] == 43 {
        sign = 1
        src += 1
        while (src[0] == 32 || (src[0] >= 9 && src[0] <= 13)) { src += 1 }
    }
else {
        sign = 0
    }
    if (src[0] == 105 || src[0] == 106) {
        x = 1
    }
else {
        x = strtod(src,&end)
        if (end == src || x - x != 0) { return -1 }
        src = end
        while (src[0] == 32 || (src[0] >= 9 && src[0] <= 13)) { src += 1 }
    }
    if sign < 0 { x = 0 - x }
    if src[0] == 0 {
        dst->re = x
        dst->im = 0
        unit[0] = 105
        return 0
    }
    if (src[0] == 105 || src[0] == 106) && src[1] == 0 {
        unit[0] = src[0]
        dst->re = 0
        dst->im = x
        return 0
    }
    if src[0] == 43 {
        sign = 1
        src += 1
        while (src[0] == 32 || (src[0] >= 9 && src[0] <= 13)) { src += 1 }
    }
else if src[0] == 45 {
        sign = -1
        src += 1
        while (src[0] == 32 || (src[0] >= 9 && src[0] <= 13)) { src += 1 }
    }
else {
        return -1
    }
    if (src[0] == 105 || src[0] == 106) {
        y = 1
    }
else {
        y = strtod(src,&end)
        if (end == src || y - y != 0) { return -1 }
        src = end
        while (src[0] == 32 || (src[0] >= 9 && src[0] <= 13)) { src += 1 }
    }
    if sign < 0 { y = 0 - y }
    if (src[0] == 105 || src[0] == 106) && src[1] == 0 {
        unit[0] = src[0]
        dst->re = x
        dst->im = y
        return 0
    }
    return -1
}

CxArg :: (args: Val *, count: int, index: int, dst: Cplx *, unit: int *) -> int {
    txt: [256] char = ""
    if index >= count { return -1 }
    if args[index].kind == VAL_FLOAT || args[index].kind == VAL_BOOL {
        dst->re = args[index].number
        dst->im = 0
        return 0
    }
    if TextArg(args,count,index,txt,sizeof(txt)) < 0 { return -1 }
    return CxParse(txt,dst,unit)
}

CxToString :: (c: Cplx, unit: int, out: char *, cap: int) {
    have_real: int = 0
    tmp: [64] char = ""
    n: int = 0
    out[0] = 0
    if (c.re != 0 || c.im == 0) {
        FormatNumber(c.re,tmp,sizeof(tmp))
        snprintf(out,cap,"%s",tmp)
        have_real = 1
    }
    if c.im != 0 {
        if c.im == 1 {
            if have_real != 0 {
                n = (int)strlen(out)
                snprintf(out + n,cap - n,"+")
            }
        }
else if c.im == -1 {
            n = (int)strlen(out)
            snprintf(out + n,cap - n,"-")
        }
else {
            FormatNumber(c.im,tmp,sizeof(tmp))
            n = (int)strlen(out)
            if (have_real != 0 && tmp[0] != 45 && tmp[0] != 43) {
                if c.im >= 0 {
                    snprintf(out + n,cap - n,"+%s",tmp)
                }
else {
                    snprintf(out + n,cap - n,"%s",tmp)
                }
            }
else {
                snprintf(out + n,cap - n,"%s",tmp)
            }
        }
        n = (int)strlen(out)
        out[n] = (char)unit
        out[n + 1] = 0
    }
}

CxVal :: (c: Cplx, unit: int) -> Val {
    buf: [128] char = ""
    if (c.re - c.re != 0 || c.im - c.im != 0) { return ValError(ERR_NUM) }
    CxToString(c,unit,buf,sizeof(buf))
    return ValString(wb_strdup(buf))
}

CxAdd :: (a: Cplx, b: Cplx) -> Cplx {
    r: Cplx = {a.re + b.re,a.im + b.im}
    return r
}

CxSub :: (a: Cplx, b: Cplx) -> Cplx {
    r: Cplx = {a.re - b.re,a.im - b.im}
    return r
}

CxNeg :: (a: Cplx) -> Cplx {
    r: Cplx = {0 - a.re,0 - a.im}
    return r
}

CxConj :: (a: Cplx) -> Cplx {
    r: Cplx = {a.re,0 - a.im}
    return r
}

CxScale :: (a: Cplx, s: double) -> Cplx {
    r: Cplx = {a.re * s,a.im * s}
    return r
}

CxMul :: (a: Cplx, b: Cplx) -> Cplx {
    r: Cplx = {a.re * b.re - a.im * b.im,a.re * b.im + a.im * b.re}
    return r
}

CxMulImag :: (a: Cplx, y: double) -> Cplx {
    r: Cplx = {0 - y * a.im,y * a.re}
    return r
}

CxDiv :: (a: Cplx, b: Cplx) -> Cplx {
    a_re: double = a.re
    a_im: double = a.im
    b_re: double = b.re
    b_im: double = b.im
    asize: double = fabs(a_re) > fabs(a_im) ? fabs(a_re) : fabs(a_im)
    bsize: double = fabs(b_re) > fabs(b_im) ? fabs(b_re) : fabs(b_im)
    bmodsqr: double = 0
    q_re: double = 0
    q_im: double = 0
    e: int = 0
    r: Cplx = {0.0 / 0.0,0.0 / 0.0}
    if (asize - asize != 0 || bsize - bsize != 0 || bsize == 0) { return r }
    if b_im == 0 {
        r.re = a_re / b_re
        r.im = a_im / b_re
        return r
    }
    if b_re == 0 {
        r.re = a_im / b_im
        r.im = 0 - a_re / b_im
        return r
    }
    if (asize + bsize > 1e100 || asize < 1e-100 || bsize < 1e-100) {
        ea: int = ilogb(asize)
        eb: int = ilogb(bsize)
        a_re = scalbn(a_re,-ea)
        a_im = scalbn(a_im,-ea)
        b_re = scalbn(b_re,-eb)
        b_im = scalbn(b_im,-eb)
        e = ea - eb
    }
    bmodsqr = b_re * b_re + b_im * b_im
    q_re = (a_re * b_re + a_im * b_im) / bmodsqr
    q_im = (a_im * b_re - a_re * b_im) / bmodsqr
    if e != 0 {
        q_re = scalbn(q_re,e)
        q_im = scalbn(q_im,e)
    }
    r.re = q_re
    r.im = q_im
    return r
}

CxInv :: (a: Cplx) -> Cplx {
    one: Cplx = {1,0}
    return CxDiv(one,a)
}

CxMod :: (a: Cplx) -> double {
    return hypot(a.re,a.im)
}

CxAngle :: (a: Cplx) -> double {
    return atan2(a.im,a.re)
}

CxAnglePi :: (a: Cplx) -> double {
    return GoAtan2Pi(a.im,a.re)
}

CxFromPolar :: (mod: double, angle: double) -> Cplx {
    r: Cplx = {mod * cos(angle),mod * sin(angle)}
    return r
}

CxFromPolarPi :: (mod: double, angle: double) -> Cplx {
    r: Cplx = {mod * GoCosPi(angle),mod * GoSinpi(angle)}
    return r
}

CxSqrt :: (a: Cplx) -> Cplx {
    msrc: Cplx = {0,0}
    rr: Cplx = {0,0}
    m: double = 0
    sm: double = 0
    r: Cplx = {0,0}
    if (a.re < 0 && 0 - a.re > fabs(a.im)) {
        msrc.re = 0 - a.re
        msrc.im = 0 - a.im
        rr = CxSqrt(msrc)
        if a.im >= 0 {
            r.re = 0 - rr.im
            r.im = rr.re
        }
else {
            r.re = rr.im
            r.im = 0 - rr.re
        }
        return r
    }
    m = CxMod(a)
    if (m - m == 0) {
        sm = sqrt(m)
    }
else {
        sm = 2 * sqrt(hypot(a.re / 4,a.im / 4))
    }
    return CxFromPolarPi(sm,CxAnglePi(a) / 2)
}

CxExp :: (a: Cplx) -> Cplx {
    return CxFromPolar(exp(a.re),a.im)
}

CxLn :: (a: Cplx) -> Cplx {
    x: double = fabs(a.re)
    y: double = fabs(a.im)
    lm: double = 0
    r: Cplx = {0,0}
    if x > y {
        lm = log(x) + 0.5 * log1p((y / x) * (y / x))
    }
else {
        lm = log(y) + 0.5 * log1p((x / y) * (x / y))
    }
    r.re = lm
    r.im = CxAngle(a)
    return r
}

CxSin :: (a: Cplx) -> Cplx {
    r: Cplx = {sin(a.re) * cosh(a.im),cos(a.re) * sinh(a.im)}
    return r
}

CxCos :: (a: Cplx) -> Cplx {
    r: Cplx = {cos(a.re) * cosh(a.im),0 - sin(a.re) * sinh(a.im)}
    return r
}

CxTan :: (a: Cplx) -> Cplx {
    R: double = a.re
    I: double = a.im
    sr: double = sin(R)
    cr: double = cos(R)
    r: Cplx = {0,0}
    if fabs(I) < 1 {
        shi: double = sinh(I)
        D: double = cr * cr + shi * shi
        r.re = sr * cr / D
        r.im = 0.5 * sinh(2 * I) / D
    }
else {
        u: double = exp(0 - fabs(I))
        C: double = 2 * u / (1 - u * u)
        S: double = C * C
        D: double = 1 + cr * cr * S
        T: double = 1 / tanh(fabs(I))
        r.re = sr * cr * S / D
        if I < 0 {
            r.im = 0 - T / D
        }
else {
            r.im = T / D
        }
    }
    return r
}

CxPowInt :: (x: Cplx, n: int) -> Cplx {
    res: Cplx = {1,0}
    xn: Cplx = x
    dy: int = n
    while dy > 0 {
        if (dy % 2) != 0 {
            res = CxMul(res,xn)
            dy -= 1
            if dy == 0 { break }
        }
        dy /= 2
        xn = CxMul(xn,xn)
    }
    return res
}

CxPow :: (a: Cplx, b: Cplx) -> Cplx {
    r: Cplx = {0,0}
    if b.im == 0 {
        if (a.im == 0 && a.re >= 0) {
            r.re = pow(a.re,b.re)
            r.im = 0
            return r
        }
        if b.re == 0 {
            r.re = 1
            r.im = 0
            return r
        }
        if b.re == 1 { return a }
        if b.re == 2 { return CxMul(a,a) }
        if (b.re == floor(b.re) && fabs(b.re) < 1024) {
            n: int = (int)b.re
            if n > 0 { return CxPowInt(a,n) }
            if (a.re == 0 && a.im == 0) { return r }
            return CxGslInverse(CxPowInt(a,0 - n))
        }
    }
    mod: double = CxMod(a)
    arg: double = CxAngle(a)
    lm: double = log(mod)
    newmod: double = exp(b.re * lm - b.im * arg)
    newarg: double = b.re * arg + b.im * lm
    return CxFromPolar(newmod,newarg)
}

CxSinh :: (a: Cplx) -> Cplx {
    r: Cplx = {sinh(a.re) * cos(a.im),cosh(a.re) * sin(a.im)}
    return r
}

CxCosh :: (a: Cplx) -> Cplx {
    r: Cplx = {cosh(a.re) * cos(a.im),sinh(a.re) * sin(a.im)}
    return r
}

CxTanh :: (a: Cplx) -> Cplx {
    R: double = a.re
    I: double = a.im
    r: Cplx = {0,0}
    if fabs(R) < 1 {
        D: double = pow(cos(I),2.0) + pow(sinh(R),2.0)
        r.re = sinh(R) * cosh(R) / D
        r.im = 0.5 * sin(2 * I) / D
    }
else {
        D2: double = pow(cos(I),2.0) + pow(sinh(R),2.0)
        F: double = 1 + pow(cos(I) / sinh(R),2.0)
        r.re = 1 / (tanh(R) * F)
        r.im = 0.5 * sin(2 * I) / D2
    }
    return r
}

CxGslInverse :: (a: Cplx) -> Cplx {
    s: double = 1 / CxMod(a)
    r: Cplx = {(a.re * s) * s,0 - (a.im * s) * s}
    return r
}

CxSech :: (a: Cplx) -> Cplx {
    return CxGslInverse(CxCosh(a))
}

CxCsch :: (a: Cplx) -> Cplx {
    return CxGslInverse(CxSinh(a))
}

CxCoth :: (a: Cplx) -> Cplx {
    return CxGslInverse(CxTanh(a))
}

CxArcsinReal :: (a: double) -> Cplx {
    r: Cplx = {0,0}
    if fabs(a) <= 1 {
        r.re = asin(a)
        r.im = 0
    }
else {
        if a < 0 {
            r.re = 0 - 1.5707963267948966
            r.im = acosh(0 - a)
        }
else {
            r.re = 1.5707963267948966
            r.im = 0 - acosh(a)
        }
    }
    return r
}

CxArcsin :: (a: Cplx) -> Cplx {
    R: double = a.re
    I: double = a.im
    r: Cplx = {0,0}
    if I == 0 { return CxArcsinReal(R) }
    x: double = fabs(R)
    y: double = fabs(I)
    rr: double = hypot(x + 1,y)
    s: double = hypot(x - 1,y)
    A: double = 0.5 * (rr + s)
    B: double = x / A
    y2: double = y * y
    real: double = 0
    imag: double = 0
    A_crossover: double = 1.5
    B_crossover: double = 0.6417
    if B <= B_crossover {
        real = asin(B)
    }
else {
        if x <= 1 {
            D: double = 0.5 * (A + x) * (y2 / (rr + x + 1) + (s + (1 - x)))
            real = atan(x / sqrt(D))
        }
else {
            Apx: double = A + x
            D2: double = 0.5 * (Apx / (rr + x + 1) + Apx / (s + (x - 1)))
            real = atan(x / (y * sqrt(D2)))
        }
    }
    if A <= A_crossover {
        Am1: double = 0
        if x < 1 {
            Am1 = 0.5 * (y2 / (rr + (x + 1)) + y2 / (s + (1 - x)))
        }
else {
            Am1 = 0.5 * (y2 / (rr + (x + 1)) + (s + (x - 1)))
        }
        imag = log1p(Am1 + sqrt(Am1 * (A + 1)))
    }
else {
        imag = log(A + sqrt(A * A - 1))
    }
    r.re = R >= 0 ? real : 0 - real
    r.im = I >= 0 ? imag : 0 - imag
    return r
}

CxArccosReal :: (a: double) -> Cplx {
    r: Cplx = {0,0}
    if fabs(a) <= 1 {
        r.re = acos(a)
        r.im = 0
    }
else {
        if a < 0 {
            r.re = 3.141592653589793
            r.im = 0 - acosh(0 - a)
        }
else {
            r.re = 0
            r.im = acosh(a)
        }
    }
    return r
}

CxArccos :: (a: Cplx) -> Cplx {
    R: double = a.re
    I: double = a.im
    r: Cplx = {0,0}
    if I == 0 { return CxArccosReal(R) }
    x: double = fabs(R)
    y: double = fabs(I)
    rr: double = hypot(x + 1,y)
    s: double = hypot(x - 1,y)
    A: double = 0.5 * (rr + s)
    B: double = x / A
    y2: double = y * y
    real: double = 0
    imag: double = 0
    A_crossover: double = 1.5
    B_crossover: double = 0.6417
    if B <= B_crossover {
        real = acos(B)
    }
else {
        if x <= 1 {
            D: double = 0.5 * (A + x) * (y2 / (rr + x + 1) + (s + (1 - x)))
            real = atan(sqrt(D) / x)
        }
else {
            Apx: double = A + x
            D2: double = 0.5 * (Apx / (rr + x + 1) + Apx / (s + (x - 1)))
            real = atan((y * sqrt(D2)) / x)
        }
    }
    if A <= A_crossover {
        Am1: double = 0
        if x < 1 {
            Am1 = 0.5 * (y2 / (rr + (x + 1)) + y2 / (s + (1 - x)))
        }
else {
            Am1 = 0.5 * (y2 / (rr + (x + 1)) + (s + (x - 1)))
        }
        imag = log1p(Am1 + sqrt(Am1 * (A + 1)))
    }
else {
        imag = log(A + sqrt(A * A - 1))
    }
    if R >= 0 {
        r.re = real
    }
else {
        r.re = 3.141592653589793 - real
    }
    if I >= 0 {
        r.im = 0 - imag
    }
else {
        r.im = imag
    }
    return r
}

CxArctan :: (a: Cplx) -> Cplx {
    R: double = a.re
    I: double = a.im
    r: Cplx = {0,0}
    if I == 0 {
        r.re = atan(R)
        r.im = 0
        return r
    }
    rr: double = hypot(R,I)
    imag: double = 0
    u: double = 2 * I / (1 + rr * rr)
    if fabs(u) < 0.1 {
        imag = 0.25 * (log1p(u) - log1p(0 - u))
    }
else {
        A: double = hypot(R,I + 1)
        B: double = hypot(R,I - 1)
        imag = 0.5 * log(A / B)
    }
    if R == 0 {
        if I > 1 {
            r.re = 1.5707963267948966
            r.im = imag
        }
else if I < -1 {
            r.re = 0 - 1.5707963267948966
            r.im = imag
        }
else {
            r.re = 0
            r.im = imag
        }
    }
else {
        r.re = 0.5 * atan2(2 * R,(1 + rr) * (1 - rr))
        r.im = imag
    }
    return r
}

CxArcsec :: (a: Cplx) -> Cplx {
    return CxArccos(CxGslInverse(a))
}

CxArccsc :: (a: Cplx) -> Cplx {
    return CxArcsin(CxGslInverse(a))
}

CxArccot :: (a: Cplx) -> Cplx {
    if (a.re == 0 && a.im == 0) {
        r0: Cplx = {1.5707963267948966,0}
        return r0
    }
    return CxArctan(CxGslInverse(a))
}

CxArcsinh :: (a: Cplx) -> Cplx {
    return CxMulImag(CxArcsin(CxMulImag(a,1)),0 - 1)
}

CxArccosh :: (a: Cplx) -> Cplx {
    zero: Cplx = {0,0}
    if (a.im == 0 && a.re == 1) { return zero }
    t: Cplx = CxArccos(a)
    if t.im > 0 {
        return CxMulImag(t,0 - 1)
    }
    return CxMulImag(t,1)
}

CxArctanhReal :: (a: double) -> Cplx {
    r: Cplx = {0,0}
    if (a > -1 && a < 1) {
        r.re = atanh(a)
        r.im = 0
    }
else {
        r.re = acothGo(a)
        if a < 0 {
            r.im = 1.5707963267948966
        }
else {
            r.im = 0 - 1.5707963267948966
        }
    }
    return r
}

acothGo :: (a: double) -> double {
    return 0.5 * log((a + 1) / (a - 1))
}

CxArctanh :: (a: Cplx) -> Cplx {
    if a.im == 0 { return CxArctanhReal(a.re) }
    return CxMulImag(CxArctan(CxMulImag(a,1)),0 - 1)
}

CxArcsech :: (a: Cplx) -> Cplx {
    return CxArccosh(CxGslInverse(a))
}

CxArccsch :: (a: Cplx) -> Cplx {
    return CxArcsinh(CxGslInverse(a))
}

CxArccoth :: (a: Cplx) -> Cplx {
    return CxArctanh(CxGslInverse(a))
}

CxFact :: (a: Cplx) -> Cplx {
    r: Cplx = {0,0}
    i: int = 0
    acc: double = 1
    if a.im == 0 {
        if (a.re < 0 && a.re == floor(a.re)) {
            r.re = 0.0 / 0.0
            r.im = 0.0 / 0.0
            return r
        }
        if (a.re == floor(a.re) && a.re >= 0 && a.re < 170) {
            i = 1
            while i <= (int)a.re {
                acc *= (double)i
                i += 1
            }
            r.re = acc
            r.im = 0
            return r
        }
        r.re = tgamma(a.re + 1)
        r.im = 0
        return r
    }
    return CxMul(CxGamma(a),a)
}

CxGamma :: (a: Cplx) -> Cplx {
    r: Cplx = {0,0}
    if a.im == 0 {
        if (a.re < 0 && a.re == floor(a.re)) {
            r.re = 0.0 / 0.0
            r.im = 0.0 / 0.0
            return r
        }
        r.re = tgamma(a.re)
        r.im = 0
        return r
    }
    if a.re < 0 {
        b: Cplx = {3.141592653589793 * fmod(a.re,2),3.141592653589793 * a.im}
        pi_c: Cplx = {3.141592653589793,0}
        return CxDiv(pi_c,CxMul(CxFact(CxNeg(a)),CxSin(b)))
    }
    return CxPow2Lanczos(a)
}

CxPow2Lanczos :: (a: Cplx) -> Cplx {
    lanczos_g: double = 808618867.0 / 134217728
    lanczos_num: [13] double = {56906521.913471563880907910335591226868592353221448,103794043.11634454519062710536160702385539539810110,86363131.288138591455469272889778684223419113014358,43338889.324676138347737237405905333160850993321475,14605578.087685068084141699827913592185707234229516,3481712.1549806459088207101896477455646802362321652,601859.61716810987866702265336993523025071425740828,75999.293040145426498753034435989091370919973262979,6955.9996025153761403563101155151989875259157712039,449.94455690631681194468586076509884096232715968614,19.519927882476174828478609662356521362076846583112,0.50984166556566761881251786448046945099926051133936,0.0060618423462489065257837539645559368832224636654970}
    lanczos_denom: [13] double = {0,39916800,120543840,150917976,105258076,45995730,13339535,2637558,357423,32670,1925,66,1}
    p: Cplx = {lanczos_num[12],0}
    q: Cplx = {lanczos_denom[12],0}
    zmh: Cplx = {0,0}
    f: Cplx = {0,0}
    t1: Cplx = {0,0}
    t2: Cplx = {0,0}
    lg: Cplx = {lanczos_g,0}
    i: int = 11
    while i >= 0 {
        p = CxMul(p,a)
        p.re += lanczos_num[i]
        q = CxMul(q,a)
        q.re += lanczos_denom[i]
        i -= 1
    }
    zmh.re = a.re - 0.5
    zmh.im = a.im
    t1 = CxAdd(zmh,lg)
    f = CxPow(t1,CxScale(zmh,0.5))
    t2 = CxDiv(p,q)
    return CxMul(CxMul(CxMul(f,CxExp(CxNeg(zmh))),f),t2)
}

FnCx1 :: (name_op: int, args: Val *, count: int) -> Val {
    a: Cplx = {0,0}
    unit: int = 105
    if CxArg(args,count,0,&a,&unit) < 0 { return ValError(ERR_VALUE) }
    if name_op == 0 { return CxVal(CxConj(a),unit) }
    if name_op == 1 { return CxVal(CxInv(a),unit) }
    if name_op == 2 { return CxVal(CxNeg(a),unit) }
    if name_op == 3 { return CxVal(CxCos(a),unit) }
    if name_op == 4 { return CxVal(CxTan(a),unit) }
    if name_op == 5 { return CxVal(CxInv(CxCos(a)),unit) }
    if name_op == 6 { return CxVal(CxInv(CxSin(a)),unit) }
    if name_op == 7 { return CxVal(CxInv(CxTan(a)),unit) }
    if name_op == 8 { return CxVal(CxExp(a),unit) }
    if name_op == 9 { return CxVal(CxLn(a),unit) }
    if name_op == 10 { return CxVal(CxScale(CxLn(a),1 / 0.693147180559945309417232121458),unit) }
    if name_op == 11 { return CxVal(CxScale(CxLn(a),0.434294481903251827651128918917),unit) }
    if name_op == 12 { return CxVal(CxSqrt(a),unit) }
    if name_op == 13 { return CxVal(CxSin(a),unit) }
    if name_op == 14 { return CxVal(CxSinh(a),unit) }
    if name_op == 15 { return CxVal(CxCosh(a),unit) }
    if name_op == 16 { return CxVal(CxTanh(a),unit) }
    if name_op == 17 { return CxVal(CxSech(a),unit) }
    if name_op == 18 { return CxVal(CxCsch(a),unit) }
    if name_op == 19 { return CxVal(CxCoth(a),unit) }
    if name_op == 20 { return CxVal(CxArcsin(a),unit) }
    if name_op == 21 { return CxVal(CxArccos(a),unit) }
    if name_op == 22 { return CxVal(CxArctan(a),unit) }
    if name_op == 23 { return CxVal(CxArcsec(a),unit) }
    if name_op == 24 { return CxVal(CxArccsc(a),unit) }
    if name_op == 25 { return CxVal(CxArccot(a),unit) }
    if name_op == 26 { return CxVal(CxArcsinh(a),unit) }
    if name_op == 27 { return CxVal(CxArccosh(a),unit) }
    if name_op == 28 { return CxVal(CxArctanh(a),unit) }
    if name_op == 29 { return CxVal(CxArcsech(a),unit) }
    if name_op == 30 { return CxVal(CxArccsch(a),unit) }
    return CxVal(CxArccoth(a),unit)
}

FnCxReal1 :: (name_op: int, args: Val *, count: int) -> Val {
    a: Cplx = {0,0}
    unit: int = 105
    if CxArg(args,count,0,&a,&unit) < 0 { return ValError(ERR_VALUE) }
    if name_op == 0 { return ValNumber(CxMod(a)) }
    if name_op == 1 { return ValNumber(a.im) }
    if name_op == 2 { return ValNumber(a.re) }
    return ValNumber(CxAngle(a))
}


GoCosPi :: (x_in: double) -> double {
    x: double = x_in
    k: int = 0
    y: double = 0
    if x < 0 {
        k2: int = 0
        x = 0 - ReduceHalfPos(0 - x,&k2)
        k = 4 - k2
        if x == -0.25 {
            x += 0.5
            k += 3
        }
    }
else {
        x = ReduceHalfPos(x,&k)
    }
    if (x == 0 && (k & 1) == 1) { return 0.0 }
    k += 1
    if x == 0 {
        y = (k & 1) != 0 ? 1 : 0
    }
else if x == 0.25 {
        y = 0.707106781186547524400844362104849039284835937688474036588339
    }
else {
        if (k & 1) != 0 {
            y = cos(3.141592653589793 * x)
        }
else {
            y = sin(3.141592653589793 * x)
        }
    }
    if (k & 2) != 0 { return 0 - y }
    return y
}

GoAtan2Pi :: (y: double, x: double) -> double {
    return atan2(y,x) / 3.141592653589793
}

FnComplexFn :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    c: Cplx = {0,0}
    suffix: [8] char = ""
    if count < 2 { return ValError(ERR_VALUE) }
    c.re = CoerceNumber(&args[0])
    c.im = CoerceNumber(&args[1])
    if TextArg(args,count,2,suffix,sizeof(suffix)) < 0 { return ValError(ERR_VALUE) }
    if count >= 3 {
        if (strcmp(suffix,"i") != 0 && strcmp(suffix,"j") != 0) { return ValError(ERR_VALUE) }
        return CxVal(c,suffix[0])
    }
    return CxVal(c,105)
}

FnImdiv :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    a: Cplx = {0,0}
    b: Cplx = {0,0}
    unit: int = 105
    if count < 2 { return ValError(ERR_VALUE) }
    if CxArg(args,count,0,&a,&unit) < 0 { return ValError(ERR_VALUE) }
    if CxArg(args,count,1,&b,&unit) < 0 { return ValError(ERR_VALUE) }
    if (b.re == 0 && b.im == 0) { return ValError(ERR_DIV0) }
    return CxVal(CxDiv(a,b),unit)
}

FnImpower :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    a: Cplx = {0,0}
    b: Cplx = {0,0}
    unit: int = 105
    if count < 2 { return ValError(ERR_VALUE) }
    if CxArg(args,count,0,&a,&unit) < 0 { return ValError(ERR_VALUE) }
    if CxArg(args,count,1,&b,&unit) < 0 { return ValError(ERR_VALUE) }
    if (a.re == 0 && a.im == 0 && b.re == 0 && b.im == 0) { return ValError(ERR_NUM) }
    return CxVal(CxPow(a,b),unit)
}

FnImsub :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    a: Cplx = {0,0}
    b: Cplx = {0,0}
    unit: int = 105
    if count < 2 { return ValError(ERR_VALUE) }
    if CxArg(args,count,0,&a,&unit) < 0 { return ValError(ERR_VALUE) }
    if CxArg(args,count,1,&b,&unit) < 0 { return ValError(ERR_VALUE) }
    return CxVal(CxSub(a,b),unit)
}

CxIterate :: (args: Val *, count: int, product: int, unit: int *) -> Val {
    res: Cplx = {0,0}
    c: Cplx = {0,0}
    i: int = 0
    unit2: int = 106
    if product != 0 {
        res.re = 1
    }
else {
        res.re = 0
    }
    while i < count {
        if args[i].kind == VAL_ERROR { return ValError(args[i].err) }
        if args[i].kind != VAL_EMPTY {
            if CxArg(args,count,i,&c,&unit2) < 0 { return ValError(ERR_VALUE) }
            if args[i].kind != VAL_FLOAT && args[i].kind != VAL_BOOL {
                unit[0] = unit2
            }
            if product != 0 {
                res = CxMul(res,c)
            }
else {
                res = CxAdd(res,c)
            }
        }
        i += 1
    }
    return CxVal(res,unit[0])
}

FnImsum :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    unit: int = 106
    return CxIterate(args,count,0,&unit)
}

FnImproduct :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    unit: int = 106
    return CxIterate(args,count,1,&unit)
}

FnImfact :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    a: Cplx = {0,0}
    unit: int = 105
    if CxArg(args,count,0,&a,&unit) < 0 { return ValError(ERR_VALUE) }
    return CxVal(CxFact(a),unit)
}

FnImgamma :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    a: Cplx = {0,0}
    unit: int = 105
    if CxArg(args,count,0,&a,&unit) < 0 { return ValError(ERR_VALUE) }
    return CxVal(CxGamma(a),unit)
}


