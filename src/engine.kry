    if strncmp(name,"f",1) == 0 { prefix[0] = 1.0000000000000001e-15; plen[0] = 1; return 1 }
    if strncmp(name,"a",1) == 0 { prefix[0] = 1.0000000000000001e-18; plen[0] = 1; return 1 }
    if strncmp(name,"z",1) == 0 { prefix[0] = 9.9999999999999991e-22; plen[0] = 1; return 1 }
    if strncmp(name,"y",1) == 0 { prefix[0] = 9.9999999999999992e-25; plen[0] = 1; return 1 }
    return 0
}

ConvGetConstant :: (cat: int, binp: int, use_prefixes: int, name: const char *, c: double *, prefix: double *) -> int {
    plen: int = 0
    prefix[0] = 1
    if ConvUnit(cat,name,c) != 0 { return 1 }
    if use_prefixes != 0 {
        if ConvPrefix(binp,name,prefix,&plen) != 0 {
            return ConvUnit(cat,name + plen,c)
        }
    }
    return 0
}

ConvertOne :: (cat: int, binp: int, use_prefixes: int, from_unit: const char *, to_unit: const char *, n: double, handled: int *, result: double *) -> int {
    from_c: double = 0
    from_prefix: double = 1
    to_c: double = 0
    to_prefix: double = 1
    if ConvGetConstant(cat,binp,use_prefixes,from_unit,&from_c,&from_prefix) != 0 {
        handled[0] = 1
        if ConvGetConstant(cat,binp,use_prefixes,to_unit,&to_c,&to_prefix) == 0 {
            return 0
        }
        if (from_c == 0 || to_prefix == 0) { return 0 }
        result[0] = ((n * from_prefix) / from_c) * to_c / to_prefix
        return 1
    }
    handled[0] = 0
    return 0
}

ConvTempUnit :: (unit: const char *) -> int {
    if strcmp(unit,"K") == 0 { return 1 }
    if strcmp(unit,"C") == 0 { return 2 }
    if strcmp(unit,"F") == 0 { return 3 }
    if strcmp(unit,"Reau") == 0 { return 5 }
    if strcmp(unit,"Rank") == 0 { return 4 }
    return 0
}

ConvertTemp :: (from_unit: const char *, to_unit: const char *, n_in: double, handled: int *, result: double *) -> int {
    n: double = n_in
    nO: double = n_in
    ck: double = 273.15
    ft: int = ConvTempUnit(from_unit)
    tt: int = ConvTempUnit(to_unit)
    if (ft == 0 || tt == 0) {
        handled[0] = 0
        return 0
    }
    handled[0] = 1
    if ft == 2 {
        n += ck
    }
    if ft == 3 {
        n = (n - 32) * 5 / 9 + ck
    }
    if ft == 4 {
        n = n * 5 / 9
    }
    if ft == 5 {
        n = n * 5 / 4 + ck
    }
    if n < 0 { return 0 }
    if ft == tt {
        result[0] = nO
        return 1
    }
    if tt == 2 {
        n -= ck
    }
    if tt == 3 {
        n = (n - ck) * 9 / 5 + 32
    }
    if tt == 4 {
        n = n * 9 / 5
    }
    if tt == 5 {
        n = (n - ck) * 4 / 5
    }
    result[0] = n
    return 1
}

FnConvert :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    n: double = 0
    from_u: [32] char = ""
    to_u: [32] char = ""
    handled: int = 0
    result: double = 0
    ok: int = 0
    if count < 3 { return ValError(ERR_VALUE) }
    n = CoerceNumber(&args[0])
    if TextArg(args,count,1,from_u,sizeof(from_u)) < 0 { return ValError(ERR_VALUE) }
    if TextArg(args,count,2,to_u,sizeof(to_u)) < 0 { return ValError(ERR_VALUE) }
    ok = ConvertTemp(from_u,to_u,n,&handled,&result)
    if handled != 0 {
        if ok == 0 { return ValError(ERR_NUM) }
        return ValNumber(result)
    }
    if ConvertOne(0,0,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(1,0,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(2,0,0,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(3,0,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(4,0,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(5,0,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(6,0,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(7,0,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(8,0,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(9,0,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(9,1,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(10,0,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    if ConvertOne(11,0,1,from_u,to_u,n,&handled,&result) != 0 { return ValNumber(result) }
    if handled != 0 { return ValError(ERR_NUM) }
    return ValError(ERR_NA)
}
V2BGeneral :: (v: Val *, out: double *) -> int {
    txt: const char * = ""
    if v->kind != VAL_STRING { return 0 }
    txt = v->text
    if DbParseNumber(txt,out) == 0 { return 0 }
    return 1
}

V2BIsAlnum :: (c: int) -> int {
    if (c >= 48 && c <= 57) { return 1 }
    if (c >= 65 && c <= 90) { return 1 }
    if (c >= 97 && c <= 122) { return 1 }
    return 0
}

V2BDigitChar :: (d: int) -> int {
    if d < 10 { return 48 + d }
    return 65 + d - 10
}

ValToBase :: (value: Val *, places_v: Val *, src_base: int, dest_base: int, min_value: double, max_value: double, flags: int) -> Val {
    v_float: double = 0
    err: char * = NULL
    txt: const char * = ""
    hsuffix: int = 0
    len: int = 0
    min_d: int = 1
    max_d: int = 10
    places: int = 1
    out: [24] char = ""
    v_u: unsigned long long = 0
    digit: int = 0
    buf: [64] char = ""
    val: double = 0
    fplaces: double = 0
    float_path: int = 0
    did_parse: int = 0
    if value->kind == VAL_BOOL { return ValError(ERR_VALUE) }
    if places_v != NULL && places_v->kind == VAL_BOOL { return ValError(ERR_VALUE) }
    if (flags & 1) != 0 {
        if value->kind == VAL_STRING {
            if V2BGeneral(value,&v_float) == 0 { return ValError(ERR_VALUE) }
            float_path = 1
        }
else if value->kind == VAL_FLOAT {
            v_float = value->number
            float_path = 1
        }
else {
            return ValError(ERR_NUM)
        }
    }
else if value->kind == VAL_STRING {
        txt = value->text
        hsuffix = 0
        if (flags & 8) != 0 && txt[0] == 0 { txt = "0" }
        if V2BIsAlnum(txt[0]) == 0 { return ValError(ERR_NUM) }
        len = (int)strlen(txt)
        if (flags & 4) != 0 && len > 10 { return ValError(ERR_NUM) }
        if (flags & 2) != 0 {
            if (txt[0] == 48 && (txt[1] == 120 || txt[1] == 88)) {
                txt = txt + 2
            }
else if (txt[len - 1] == 104 || txt[len - 1] == 72) {
                hsuffix = 1
            }
        }
        v_float = (double)strtoll(txt,&err,src_base)
        if (err == txt || err[hsuffix] != 0) { return ValError(ERR_NUM) }
        if (v_float < min_value || v_float > max_value) { return ValError(ERR_NUM) }
        did_parse = 1
    }
else if value->kind == VAL_FLOAT {
        v_float = value->number
        float_path = 1
    }
else {
        return ValError(ERR_NUM)
    }
    if float_path != 0 {
        val = trunc(v_float)
        if (val < min_value || val > max_value) { return ValError(ERR_NUM) }
        snprintf(buf,sizeof(buf),"%.0f",val)
        v_float = (double)strtoll(buf,&err,src_base)
        if err[0] != 0 { return ValError(ERR_NUM) }
    }
    if src_base != 10 {
        b10: double = pow((double)src_base,10)
        if v_float >= b10 / 2 { v_float = v_float - b10 }
    }
    if (flags & 16) != 0 { return ValNumber(v_float) }
    if v_float < 0 {
        min_d = 1
        max_d = 10
        v_float += pow((double)dest_base,10)
    }
else {
        if v_float == 0 {
            min_d = 1
            max_d = 1
        }
else {
            min_d = (int)(log(v_float + 0.5) / log((double)dest_base)) + 1
            max_d = min_d
        }
    }
    if places_v != NULL {
        fplaces = CoerceNumber(places_v)
        if (fplaces < (double)min_d || fplaces > 10) { return ValError(ERR_NUM) }
        places = (int)fplaces
        if (v_float >= 0 && places > max_d) { max_d = places }
    }
    v_u = (unsigned long long)(v_float + 0.5)
    digit = max_d - 1
    while digit >= 0 {
        out[digit] = (char)V2BDigitChar((int)(v_u % (unsigned long long)dest_base))
        v_u /= (unsigned long long)dest_base
        digit -= 1
    }
    out[max_d] = 0
    return ValString(wb_strdup(out))
}

FnBase :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    base_v: double = 0
    max_v: double = 1 / 2.2204460492503131e-16
    if count < 2 { return ValError(ERR_VALUE) }
    base_v = CoerceNumber(&args[1])
    if (base_v < 2 || base_v >= 37) { return ValError(ERR_NUM) }
    return ValToBase(&args[0],count >= 3 ? &args[2] : NULL,10,(int)base_v,-max_v,max_v,1 | 2)
}

FnDecimal :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    base_v: double = 0
    if count < 2 { return ValError(ERR_VALUE) }
    base_v = CoerceNumber(&args[1])
    if (base_v < 2 || base_v >= 37) { return ValError(ERR_NUM) }
    return ValToBase(&args[0],NULL,(int)base_v,10,0,1099511627776.0 - 1,4 | 8 | 16)
}

FnBin2Oct :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return ValToBase(&args[0],count >= 2 ? &args[1] : NULL,2,8,0,1111111111.0,4 | 8)
}

FnBin2Hex :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return ValToBase(&args[0],count >= 2 ? &args[1] : NULL,2,16,0,1111111111.0,4 | 8)
}

FnOct2Bin :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return ValToBase(&args[0],count >= 2 ? &args[1] : NULL,8,2,0,7777777777.0,4 | 8)
}

FnOct2Hex :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return ValToBase(&args[0],count >= 2 ? &args[1] : NULL,8,16,0,7777777777.0,4 | 8)
}

FnHex2Bin :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return ValToBase(&args[0],count >= 2 ? &args[1] : NULL,16,2,0,9999999999.0,4 | 8)
}

FnHex2Oct :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return ValToBase(&args[0],count >= 2 ? &args[1] : NULL,16,8,0,9999999999.0,4 | 8)
}

FnDelta :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    x: double = 0
    y: double = 0
    if count < 1 { return ValError(ERR_VALUE) }
    x = CoerceNumber(&args[0])
    y = count >= 2 ? CoerceNumber(&args[1]) : 0
    if x == y { return ValNumber(1) }
    return ValNumber(0)
}

FnGestep :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    x: double = 0
    y: double = 0
    if count < 1 { return ValError(ERR_VALUE) }
    x = CoerceNumber(&args[0])
    y = count >= 2 ? CoerceNumber(&args[1]) : 0
    if x >= y { return ValNumber(1) }
    return ValNumber(0)
}

FnErfc :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    return ValNumber(erfc(CoerceNumber(&args[0])))
}

FnHexrep :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    out: [20] char = ""
    data: [8] unsigned char = {0}
    hexd: CString = "0123456789abcdef"
    v: double = 0
    i: int = 0
    if count < 1 { return ValError(ERR_VALUE) }
    v = CoerceNumber(&args[0])
    memcpy(data,&v,8)
    while i < 8 {
        out[i * 2] = hexd[data[i] >> 4]
        out[i * 2 + 1] = hexd[data[i] & 15]
        i += 1
    }
    out[16] = 0
    return ValString(wb_strdup(out))
}

FnInvsuminv :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    suminv: double = 0
    zerop: int = 0
    i: int = 0
    x: double = 0
    while i < list.count {
        x = list.data[i]
        if x < 0 { return ValError(ERR_VALUE) }
        if x == 0 {
            zerop = 1
        }
else {
            suminv += 1 / x
        }
        i += 1
    }
    if list.count <= 0 { return ValError(ERR_VALUE) }
    if zerop != 0 { return ValNumber(0) }
    return ValNumber(1 / suminv)
}

BIT_MAX :: () -> double {
    v: double = 2 / 2.2204460492503131e-16
    if (v > 18446744073709551615.0) { return 18446744073709551615.0 }
    return v
}

FnBitAgg :: (args: Val *, count: int, op: int) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    acc: unsigned long long = 0
    if op == 0 { acc = 18446744073709551615ULL }
    i: int = 0
    xf: double = 0
    bmax: double = BIT_MAX()
    while i < list.count {
        xf = floor(list.data[i])
        if (xf < 0 || xf > bmax) { return ValError(ERR_VALUE) }
        if op == 0 {
            acc = acc & (unsigned long long)xf
        }
else if op == 1 {
            acc = acc | (unsigned long long)xf
        }
else {
            acc = acc ^ (unsigned long long)xf
        }
        i += 1
    }
    if list.count == 0 { return ValError(ERR_VALUE) }
    return ValNumber((double)acc)
}

FnBitand :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return FnBitAgg(args,count,0)
}

FnBitor :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return FnBitAgg(args,count,1)
}

FnBitxor :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return FnBitAgg(args,count,2)
}

FnBitshift :: (args: Val *, count: int, left: int) -> Val {
    l: double = 0
    r: double = 0
    bmax: double = 0
    if count < 2 { return ValError(ERR_VALUE) }
    l = CoerceNumber(&args[0])
    r = floor(CoerceNumber(&args[1]))
    bmax = BIT_MAX()
    if (l < 0 || l > bmax) { return ValError(ERR_NUM) }
    if (r >= 64 || r <= -64) { return ValNumber(0) }
    if r < 0 {
        if left != 0 {
            return ValNumber((double)((unsigned long long)l >> (unsigned long long)(-r)))
        }
        return ValNumber((double)((unsigned long long)l << (unsigned long long)(-r)))
    }
    if left != 0 {
        return ValNumber((double)((unsigned long long)l << (unsigned long long)r))
    }
    return ValNumber((double)((unsigned long long)l >> (unsigned long long)r))
}

FnBitlshift :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return FnBitshift(args,count,1)
}

FnBitrshift :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return FnBitshift(args,count,0)
}

kmax_i :: (a: int, b: int) -> int {
    if a > b { return a }
    return b
}

kmin_i :: (a: int, b: int) -> int {
    if a < b { return a }
    return b
}

r_pow_di :: (x: double, n: int) -> double {
    xn: double = x
    y: double = 1
    n2: int = n
    if n2 < 0 {
        n2 = -n2
        if xn != 0 { xn = 1 / xn }
    }
    while n2 > 0 {
        if (n2 & 1) != 0 { y *= xn }
        n2 >>= 1
        if n2 > 0 { xn *= xn }
    }
    return y
}

swap_log_tail :: (lp: double) -> double {
    if (lp > -1 / log(2)) {
        return log(0 - expm1(lp))
    }
    return log1p(0 - exp(lp))
}

logspace_add_go :: (logx: double, logy: double) -> double {
    return fmax(logx,logy) + log1p(exp(0 - fabs(logx - logy)))
}

logspace_sub_go :: (logx: double, logy: double) -> double {
    return logx + swap_log_tail(logy - logx)
}

chebyshev_eval :: (x: double, a: double *, n: int) -> double {
    b0: double = 0
    b1: double = 0
    b2: double = 0
    i: int = 0
    if (x < -1.0001 || x > 1.0001 || n < 1 || n > 1000) {
        return 0.0 / 0.0
    }
    nx: double = 2 * x
    i = n - 1
    while i >= 0 {
        b2 = b1
        b1 = b0
        b0 = nx * b1 - b2 + a[i]
        i -= 1
    }
    return 0.5 * (b0 - b2)
}

lgammacor :: (x: double) -> double {
    algmcs: [15] double = {0.1666389480451863247205729650822,0 - 0.1384948176067563840732986059135e-4,0.9810825646924729426157171547487e-8,0 - 0.1809129475572494194263306266719e-10,0.6221098041892605227126015543416e-13,0 - 0.3399615005417721944303330599666e-15,0.2683181998482698748957538846666e-17,0 - 0.2868042435334643284144622399999e-19,0.3962837061046434803679306666666e-21,0 - 0.6831888753985766870111999999999e-23,0.1429227355942498147573333333333e-24,0 - 0.3547598158101070547199999999999e-26,0.1025680058010470912000000000000e-27,0 - 0.3401102254316748799999999999999e-29,0.1276642195630062933333333333333e-30}
    tmp: double = 0
    if x < 10 {
        return 0.0 / 0.0
    }
    if x >= 3.745194030963158e306 {
        return 0.0
    }
    if x < 94906265.62425156 {
        tmp = 10 / x
        return chebyshev_eval(tmp * tmp * 2 - 1,algmcs,5) / x
    }
    return 1 / (x * 12)
}

lbeta_go :: (a: double, b: double) -> double {
    corr: double = 0
    p: double = 0
    q: double = 0
    if (a != a || b != b) {
        return a + b
    }
    q = a
    p = q
    if b < p {
        p = b
    }
    if b > q {
        q = b
    }
    if p < 0 {
        return 0.0 / 0.0
    }
    if p == 0 {
        return (1e308*10)
    }
    if isfinite(q) == 0 {
        return (-1e308*10)
    }
    if p >= 10 {
        corr = lgammacor(p) + lgammacor(q) - lgammacor(p + q)
        return log(q) * -0.5 + 0.918938533204672741780329736406 + corr + (p - 0.5) * log(p / (p + q)) + q * log1p(0 - p / (p + q))
    }
    if q >= 10 {
        corr = lgammacor(q) - lgammacor(p + q)
        return lgamma(p) + corr + p - p * log(p + q) + (q - 0.5) * log1p(0 - p / (p + q))
    }
    if p < 1e-306 {
        return lgamma(p) + (lgamma(q) - lgamma(p + q))
    }
    return lgamma(p) + lgamma(q) - lgamma(p + q)
}

gnm_fact_port :: (x: double) -> double {
    mant: Qd = {0,0}
    e: int = 0
    r: double = 0
    if x != x {
        return 0.0 / 0.0
    }
    if (x < 0 && x == floor(x)) {
        return 0.0 / 0.0
    }
    if x >= 536870911 {
        return (1e308*10)
    }
    if x != floor(x) {
        return tgamma(x + 1)
    }
    if qfactf(x,&mant,&e) != 0 {
        return 0.0 / 0.0
    }
    r = Q_Val(&mant)
    return scalbn(r,e)
}

Qd :: struct {
    h: double
    l: double
}

Q_Init :: (r: Qd *, hv: double) {
    r->h = hv
    r->l = 0
}

Q_Val :: (a: Qd *) -> double {
    return a->h + a->l
}

Q_Neg :: (r: Qd *, a: Qd *) {
    r->h = 0 - a->h
    r->l = 0 - a->l
}

Q_Add :: (r: Qd *, a: Qd *, b: Qd *) {
    rr: double = a->h + b->h
    s: double = fabs(a->h) > fabs(b->h) ? a->h - rr + b->h + b->l + a->l : b->h - rr + a->h + a->l + b->l
    r->h = rr + s
    r->l = rr - r->h + s
}

Q_Sub :: (r: Qd *, a: Qd *, b: Qd *) {
    rr: double = a->h - b->h
    s: double = fabs(a->h) > fabs(b->h) ? a->h - rr - b->h - b->l + a->l : 0 - b->h - rr + a->h + a->l - b->l
    r->h = rr + s
    r->l = rr - r->h + s
}

Q_Split1 :: (x_in: double, h: double *, t: double *) -> double {
    x: double = x_in
    p: double = x * 134217729.0
    if (isfinite(p) == 0 && isfinite(x) != 0) {
        x *= 2.2204460492503131e-16
        p = x * 134217729.0
        h[0] = x - p + p
        t[0] = x - h[0]
        h[0] *= (1 / 2.2204460492503131e-16)
        t[0] *= (1 / 2.2204460492503131e-16)
    }
else {
        h[0] = x - p + p
        t[0] = x - h[0]
    }
    return x
}

Q_Mul12 :: (r: Qd *, xv: double, yv: double) {
    hx: double = 0
    tx: double = 0
    hy: double = 0
    ty: double = 0
    p: double = 0
    q: double = 0
    x: double = Q_Split1(xv,&hx,&tx)
    y: double = Q_Split1(yv,&hy,&ty)
    p = hx * hy
    q = hx * ty + tx * hy
    r->h = p + q
    r->l = p - r->h + q + tx * ty
}

Q_Mul :: (r: Qd *, a: Qd *, b: Qd *) {
    c: Qd = {0,0}
    Q_Mul12(&c,a->h,b->h)
    c.l = a->h * b->l + a->l * b->h + c.l
    r->h = c.h + c.l
    r->l = c.h - r->h + c.l
}

Q_Div :: (r: Qd *, a: Qd *, b: Qd *) {
    c_h: double = a->h / b->h
    u: Qd = {0,0}
    Q_Mul12(&u,c_h,b->h)
    c_l: double = (a->h - u.h - u.l + a->l - c_h * b->l) / b->h
    r->h = c_h + c_l
    r->l = c_h - r->h + c_l
}

Q_Scalbn :: (r: Qd *, a: Qd *, n: int) {
    r->h = scalbn(a->h,n)
    r->l = scalbn(a->l,n)
}

Q_Sqrt :: (r: Qd *, a: Qd *) {
    if a->h > 0 {
        c_h: double = sqrt(a->h)
        u: Qd = {0,0}
        Q_Mul12(&u,c_h,c_h)
        c_l: double = (a->h - u.h - u.l + a->l) * 0.5 / c_h
        r->h = c_h + c_l
        r->l = c_h - r->h + c_l
    }
else {
        r->h = 0
        r->l = 0
    }
}

Q_Floor :: (r: Qd *, a: Qd *) {
    qh: Qd = {0,0}
    ql: Qd = {0,0}
    q: Qd = {0,0}
    rr: Qd = {0,0}
    Q_Init(&qh,floor(a->h))
    Q_Init(&ql,floor(a->l))
    Q_Add(&q,&qh,&ql)
    Q_Sub(&rr,a,&q)
    if Q_Val(&rr) < 0 {
        one: Qd = {1,0}
        Q_Sub(r,&q,&one)
    }
else {
        r->h = q.h
        r->l = q.l
    }
}

Q_Compare :: (a: Qd *, b: Qd *) -> int {
    sa: int = a->h < 0 ? 1 : 0
    sb: int = b->h < 0 ? 1 : 0
    d: Qd = {0,0}
    if sa != sb {
        if sa != 0 { return -1 }
        return 1
    }
    Q_Sub(&d,a,b)
    if d.h > 0 { return 1 }
    if d.h == 0 { return 0 }
    return -1
}

Q_RescaleBase :: (x: Qd *, e: double *) {
    xe: int = ilogb(Q_Val(x))
    if xe != 0 {
        qs: Qd = {0,0}
        Q_Init(&qs,scalbn(1.0,-xe))
        Q_Mul(x,x,&qs)
        e[0] += xe
    }
}

Q_PowInt :: (r: Qd *, exp2: double *, x: Qd *, y: Qd *) {
    xn: Qd = {0,0}
    xe: double = 0
    dy: double = 0
    xn.h = x->h
    xn.l = x->l
    exp2[0] = 0
    dy = Q_Val(y)
    r->h = 1
    r->l = 0
    Q_RescaleBase(&xn,&xe)
    while dy > 0 {
        if fmod(dy,2) > 0 {
            Q_Mul(r,r,&xn)
            exp2[0] += xe
            Q_RescaleBase(r,exp2)
            dy -= 1
            if dy == 0 { break }
        }
        dy /= 2
        Q_Mul(&xn,&xn,&xn)
        xe *= 2
        Q_RescaleBase(&xn,&xe)
    }
}

Q_Sqrt1pm1 :: (r: Qd *, a: Qd *) {
    x0: Qd = {0,0}
    x1: Qd = {0,0}
    d: Qd = {0,0}
    one: Qd = {1,0}
    Q_Add(&x0,a,&one)
    Q_Sqrt(&x0,&x0)
    while 1 {
        Q_Add(&x1,&x0,&one)
        Q_Sub(&d,&x1,&x0)
        if Q_Val(&d) == 0 { break }
        Q_Mul(&d,&x0,&d)
        Q_Sub(&x1,&one,&d)
        Q_Div(&x1,&x1,&d)
        Q_Mul(&x1,&x0,&x1)
        Q_Sub(&x1,&x1,&x0)
        if (Q_Val(&x1) == Q_Val(&x0) && x1.h == x0.h && x1.l == x0.l) { break }
        x0.h = x1.h
        x0.l = x1.l
    }
    r->h = x0.h
    r->l = x0.l
}

Q_PowFrac :: (r: Qd *, x: Qd *, y: Qd *) {
    qx: Qd = {0,0}
    qr: Qd = {0,0}
    qy: Qd = {0,0}
    dy: double = 0
    x1m: int = 0
    one: Qd = {1,0}
    qy.h = y->h
    qy.l = y->l
    x1m = fabs(Q_Val(x)) >= 0.5 ? 1 : 0
    if x1m != 0 {
        Q_Sub(&qx,x,&one)
    }
else {
        qx.h = x->h
        qx.l = x->l
    }
    qr.h = 0
    qr.l = 0
    while 1 {
        dy = Q_Val(&qy)
        if dy <= 0 { break }
        Q_Add(&qy,&qy,&qy)
        if x1m != 0 {
            Q_Sqrt1pm1(&qx,&qx)
            if Q_Val(&qx) == 0 { break }
        }
else {
            Q_Sqrt(&qx,&qx)
            if Q_Val(&qx) >= 0.5 {
                x1m = 1
                Q_Sub(&qx,&qx,&one)
            }
        }
        if dy >= 0.5 {
            qp: Qd = {0,0}
            Q_Sub(&qy,&qy,&one)
            Q_Mul(&qp,&qx,&qr)
            qr.h = qp.h
            qr.l = qp.l
        }
    }
    r->h = qr.h
    r->l = qr.l
}

Q_Pow :: (r: Qd *, expb: double *, x: Qd *, y: Qd *) {
    one: Qd = {1,0}
    half: Qd = {0.5,0}
    if expb != NULL { expb[0] = 0 }
    if (y->h == 0 || Q_Compare(x,&one) == 0) {
        r->h = 1
        r->l = 0
        return
    }
    if (x->h == 0 && y->h > 0) {
        r->h = 0
        r->l = 0
        return
    }
    if (x->h != x->h) {
        r->h = x->h
        r->l = x->l
        return
    }
    if (y->h != y->h) {
        r->h = y->h
        r->l = y->l
        return
    }
    if Q_Compare(y,&one) == 0 {
        r->h = x->h
        r->l = x->l
        return
    }
    if (x->h > 0 && Q_Compare(y,&half) == 0) {
        Q_Sqrt(r,x)
        return
    }
    dy: double = Q_Val(y)
    if dy < 0 {
        my: Qd = {0,0}
        zero: Qd = {0,0}
        Q_Sub(&my,&zero,y)
        Q_Pow(r,expb,x,&my)
        one2: Qd = {1,0}
        Q_Div(r,&one2,r)
        if expb != NULL { expb[0] = 0 - expb[0] }
        return
    }
    qew: Qd = {0,0}
    qef: Qd = {0,0}
    exp2ew: double = 0
    Q_Floor(r,y)
    qf: Qd = {0,0}
    Q_Sub(&qf,y,r)
    Q_PowInt(&qew,&exp2ew,x,r)
    Q_PowFrac(&qef,x,&qf)
    Q_Mul(r,&qew,&qef)
    if expb != NULL {
        expb[0] = exp2ew
    }
else {
        e: int = (int)exp2ew
        Q_Scalbn(r,r,e)
    }
}

rescale_mantexp :: (mant: Qd *, expb: int *) {
    e: int = ilogb(Q_Val(mant))
    if e != -1 {
        qs: Qd = {0,0}
        Q_Init(&qs,scalbn(1.0,-e - 1))
        Q_Mul(mant,mant,&qs)
        expb[0] += e + 1
    }
}

qfacti :: (n: int, mant: Qd *, expb: int *) -> int {
    if (n < 0 || n >= 10000) {
        mant->h = 0
        mant->l = 0
        expb[0] = 0
        return 1
    }
    if QFACT_BUILT == 0 {
        m0: Qd = {0,0}
        Q_Init(&m0,0.5)
        QFACT_MANT_H[0] = m0.h
        QFACT_MANT_L[0] = m0.l
        QFACT_EXP[0] = 1
        QFACT_BUILT = 1
    }
    while n >= QFACT_BUILT {
        m: Qd = {0,0}
        nxt: Qd = {0,0}
        e: int = 0
        Q_Init(&m,(double)QFACT_BUILT)
        nxt.h = QFACT_MANT_H[QFACT_BUILT - 1]
        nxt.l = QFACT_MANT_L[QFACT_BUILT - 1]
        Q_Mul(&m,&m,&nxt)
        e = QFACT_EXP[QFACT_BUILT - 1]
        rescale_mantexp(&m,&e)
        QFACT_MANT_H[QFACT_BUILT] = m.h
        QFACT_MANT_L[QFACT_BUILT] = m.l
        QFACT_EXP[QFACT_BUILT] = e
        QFACT_BUILT += 1
    }
    mant->h = QFACT_MANT_H[n]
    mant->l = QFACT_MANT_L[n]
    expb[0] = QFACT_EXP[n]
    return 0
}

qfactf :: (x: double, mant: Qd *, expb: int *) -> int {
    expb[0] = 0
    if (x != x || (x < 0 && x == floor(x))) {
        mant->h = 0.0 / 0.0
        mant->l = 0.0 / 0.0
        return 2
    }
    if x >= 536870911 {
        mant->h = 1e308 * 10
        mant->l = 0
        return 1
    }
    if x == floor(x) {
        if qfacti((int)x,mant,expb) == 0 {
            return 0
        }
    }
    mant->h = tgamma(x + 1)
    mant->l = 0
    return 0
}

do_search :: (y_in: double, z: double *, p: double, n: double, pr: double, incr: double) -> double {
    y: double = y_in
    newz: double = 0
    if z[0] >= p {
        while 1 {
            if y == 0 {
                return y
            }
            newz = pbinom(y - incr,n,pr,1,0)
            if newz < p {
                return y
            }
            y = fmax(0,y - incr)
            z[0] = newz
        }
    }
    while 1 {
        y = fmin(y + incr,n)
        if y == n {
            return y
        }
        z[0] = pbinom(y,n,pr,1,0)
        if z[0] >= p {
            return y
        }
    }
}

/* == bd0 == */
dstirlerr_go :: (x: double) -> double {
    xph: double = x + 0.5
    if x < 0.5 {
        return 1 - xph * log1p(1 / x)
    }
    if x < 2 {
        return -1 / (2 * x) - xph * Log1pmx(1 / x)
    }
    return 0 - (x + 2) / (12 * x * x * x) - xph * GoLogTaylor4(1 / x, 4)
}

GoLogTaylor4 :: (x: double, k: int) -> double {
    return x - x * x / 2 + x * x * x / 3 - x * x * x * x / 4
}

log1px3 :: (x: double) -> double {
    if x < -0.5 {
        return log(1 + x)
    }
    if x < 0 {
        return x - x * x / 2 + x * x * x / 3
    }
    return x
}

Q_Exp :: (r: Qd *, expb: double *, a: Qd *) {
    if expb != NULL { expb[0] = 0 }
    if a->h != a->h {
        r->h = a->h
        r->l = 0
        return
    }
    lnx: double = log(a->h)
    e: int = 0
    fmant: double = frexp(lnx,&e)
    half: double = fmant / 2
    q2: Qd = {0,0}
    Q_Init(&q2,half)
    s: Qd = {0,0}
    Q_Sqrt(&s,&q2)
    if a->l != 0 {
        corr: Qd = {0,0}
        one: Qd = {1,0}
        Q_Init(&corr,a->l / a->h)
        Q_Add(&corr,&corr,&one)
        Q_Mul(&s,&s,&corr)
    }
    k: int = 2 * (e + 1)
    Q_Scalbn(r,&s,k)
}

Lgamma1p :: (a: double) -> double {
    return lgamma(1 + a)
}

dgamma_go :: (x: double, shape: double, scale: double, give_log: int) -> double {
    if (x <= 0 || shape <= 0 || scale <= 0) {
        return give_log != 0 ? -1e308 * 10 : 0.0
    }
    if x < 1 {
        pr: double = Pow1p(x / scale,shape - 1) * exp(0 - x / scale) / scale / shape * exp(lgamma1p_raw(shape))
        if give_log != 0 { return log(pr) }
        return pr
    }
    pr2: double = exp(0 - x / scale + shape * log(x / scale) - lgamma(shape) - log(scale))
    if give_log != 0 { return log(pr2) }
    return pr2
}

dnorm_go :: (x: double, mu: double, sigma: double, give_log: int) -> double {
    c: double = 0
    if (x != x || mu != mu || sigma != sigma) {
        return x + mu + sigma
    }
    if sigma < 0 {
        return 0.0 / 0.0
    }
    if sigma == 0 {
        return x == mu ? 1.0 : 0.0
    }
    x = (x - mu) / sigma
    if (x * x >= -2.0 * (give_log != 0 ? -745.1332191019412 : 3.6205246350374e-155)) {
        c = 0.398942280401432677939946059934 * exp(0 - x * x / 2) / sigma
        if give_log != 0 {
            return log(c)
        }
        return c
    }
    if give_log != 0 {
        return 0 - 745.1332191019412 - log(fabs(sigma)) - x * x / 2
    }
    return 0.0
}

bd0 :: (x: double, M: double) -> double {
    yh: double = 0
    yl: double = 0
    Ebd0(x, M, &yh, &yl)
    return yh + yl
}

/* == stirlerr == */
stirlerr :: (n: double) -> double {
    S0: double = (1.0) / 12
    S1: double = (1.0) / 360
    S2: double = (1.0) / 1260
    S3: double = (1.0) / 1680
    S4: double = (1.0) / 1188
    S5: double = (691.0) / 360360
    S6: double = (1.0) / 156
    S7: double = (3617.0) / 122400
    S8: double = (43867.0) / 244188
    sferr_halves: [31] double = {(0.0/0.0),                                   
		(0.1534264097200273452913848),           
		(0.0810614667953272582196702),           
		(0.0548141210519176538961390),           
		(0.0413406959554092940938221),           
		(0.03316287351993628748511048),          
		(0.02767792568499833914878929),          
		(0.02374616365629749597132920),          
		(0.02079067210376509311152277),          
		(0.01848845053267318523077934),          
		(0.01664469118982119216319487),          
		(0.01513497322191737887351255),          
		(0.01387612882307074799874573),          
		(0.01281046524292022692424986),          
		(0.01189670994589177009505572),          
		(0.01110455975820691732662991),          
		(0.010411265261972096497478567),          
		(0.009799416126158803298389475),          
		(0.009255462182712732917728637),          
		(0.008768700134139385462952823),          
		(0.008330563433362871256469318),           
		(0.007934114564314020547248100),           
		(0.007573675487951840794972024),           
		(0.007244554301320383179543912),           
		(0.006942840107209529865664152),           
		(0.006665247032707682442354394),           
		(0.006408994188004207068439631),           
		(0.006171712263039457647532867),           
		(0.005951370112758847735624416),           
		(0.005746216513010115682023589),           
		(0.005554733551962801371038690)}
    nn: double = 0
    y: double = 0
    if ((n > 0) == 0) {
        return (0.0/0.0)
    }
    if n <= 15 {
        nn: double = n + n
        if nn == (int)nn {
            return (sferr_halves[(int)nn])
        }
    }
    nn = n * n
    if n > (3043.0) {
        return (S0-S1/nn)/n
    }
    if n > (200.2) {
        return (S0-(S1-S2/nn)/nn)/n
    }
    if n > (55.57) {
        return (S0-(S1-(S2-S3/nn)/nn)/nn)/n
    }
    if n > (27.01) {
        return (S0-(S1-(S2-(S3-S4/nn)/nn)/nn)/nn)/n
    }
    if n > (17.23) {
        return (S0-(S1-(S2-(S3-(S4-S5/nn)/nn)/nn)/nn)/nn)/n
    }
    if n > (12.77) {
        return (S0-(S1-(S2-(S3-(S4-(S5-S6/nn)/nn)/nn)/nn)/nn)/nn)/n
    }
    if n > (10.38) {
        return (S0-(S1-(S2-(S3-(S4-(S5-(S6-S7/nn)/nn)/nn)/nn)/nn)/nn)/nn)/n
    }
    if n > (8.946) {
        return (S0-(S1-(S2-(S3-(S4-(S5-(S6-(S7-S8/nn)/nn)/nn)/nn)/nn)/nn)/nn)/nn)/n
    }
    y = 0
    while n < 9 {
        y -= (dstirlerr_go(n))
        n += 1
    }
    return y + stirlerr (n)
}

/* == dpois_raw == */
dpois_raw :: (x: double, lambda: double, give_log: int) -> double {
    d: double = 0
    d_l: double = 0
    res: double = 0
    if isnan (x) || ((lambda >= 0) == 0) {
        return (0.0/0.0)
    }
    if lambda == 0 {
        return( (x == 0) ? 1.0 : 0.0 )
    }
    if lambda == (1e308*10) {
        return 0.0
    }
    if x < 0 {
        return 0.0
    }
    if x <= lambda * 2.2250738585072014e-308 {
        return give_log ? -lambda : exp(-lambda)
    }
    d = x - lambda
    d_l = d / lambda
    if (give_log == 0) && x <= 140 && lambda <= 140 {
        f1: double = pow(lambda, x)
        f2: double = exp(-lambda)
        f3: double = gnm_fact_port(x)
        return f1 * f2 / f3
    }
    if (give_log == 0) && x <= 1000000 && lambda <= 1000000 {
        e1: double = 0
        e2: double = 0
        res: double = 0
        eres: double = 0
        e3: int = 0
        qx: Qd = {0,0}
        ql: Qd = {0,0}
        qf1: Qd = {0,0}
        qf2: Qd = {0,0}
        qf3: Qd = {0,0}
        qres: Qd = {0,0}
        Q_Init(&qx, x)
        Q_Init(&ql, lambda)
        Q_Pow(&qf1, &e1, &ql, &qx)
        Q_Neg(&ql, &ql)
        Q_Exp(&qf2, &e2, &ql)
        qfactf(x, &qf3, &e3)
        Q_Mul(&qres, &qf1, &qf2)
        Q_Div(&qres, &qres, &qf3)
        res = Q_Val(&qres)
        eres = e1 + e2 - e3
        
        return scalbn(res, eres)
    }
    if give_log && lambda <= 1 {
        t1: double = x * log(lambda)
        t2: double = -lambda
        t3: double = -Lgamma1p(x)
        return t1 + t2 + t3
    }
    if x >= (0.16) && x <= 2 * lambda {
        t1: double = -x * log1px3 (d_l)
        t2: double = d_l * d_l * (0.5) * (d - lambda)
        t3: double = log(2 * 3.141592653589793238462643383279502884197169399375105820974944592307816406286208998628034825342117 * x) * (-0.5)
        t4: double = -stirlerr (x)
        res = t1 + t2 + t3 + t4
    } else {
        res = -bd0 (x, lambda)
        res -= stirlerr (x)
        res -= log(2 * 3.141592653589793238462643383279502884197169399375105820974944592307816406286208998628034825342117 * x) * (0.5)
    }
    return give_log ? res : exp(res)
}

/* == dbinom_raw == */

dbinom :: (x: double, n: double, p: double, give_log: int) -> double {
    if (x != x || n != n || p != p) {
        return x + n + p
    }
    if (p < 0 || p > 1 || n < 0 || n != floor(n)) {
        return 0.0 / 0.0
    }
    if (x != floor(x)) {
        return 0.0
    }
    if (x < 0 || isfinite(x) == 0) {
        return 0.0
    }
    n = round(n)
    x = round(x)
    return dbinom_raw(x,n,p,1 - p,give_log)
}

dbinom_raw :: (x: double, n: double, p: double, q: double, give_log: int) -> double {
    lf: double = 0
    lc: double = 0
    if p == 0 {
        return((x == 0) ? 1.0 : 0.0)
    }
    if q == 0 {
        return((x == n) ? 1.0 : 0.0)
    }
    if x == 0 {
        if p > q {
            return give_log ? n * log(q) : pow(q, n)
        } else {
            return give_log ? n * log1p(-p) : Pow1p(-p, n)
        }
    }
    if x == n {
        if p > q {
            return give_log ? n * log1p(-q) : Pow1p(-q, n)
        } else {
            return give_log ? n * log(p) : pow(p, n)
        }
    }
    if x < 0 || x > n {
        return( 0.0 )
    }
    if (give_log == 0) {
                qp: Qd = {0,0}
qq: Qd = {0,0}
qx: Qd = {0,0}
qnmx: Qd = {0,0}
        qf1: Qd = {0,0}
        qf2: Qd = {0,0}
        qf3: Qd = {0,0}
        qf4: Qd = {0,0}
        qf5: Qd = {0,0}
        qres: Qd = {0,0}
        e1: int = 0
        e2: int = 0
        e3: int = 0
        bad: int = 0
        e4: double = 0
        e5: double = 0
        e: double = 0
        Q_Init(&qp, p)
        Q_Init(&qq, q)
        Q_Init(&qx, x)
        Q_Init(&qnmx, n - x)
        bad += qfactf (n, &qf1, &e1)
        bad += qfactf (x, &qf2, &e2)
        bad += qfactf (n - x, &qf3, &e3)
        Q_Pow(&qf4, &e4, &qp, &qx)
        Q_Pow(&qf5, &e5, &qq, &qnmx)
        Q_Mul(&qres, &qf2, &qf3)
        Q_Div(&qres, &qf1, &qres)
        Q_Mul(&qres, &qres, &qf4)
        Q_Mul(&qres, &qres, &qf5)
        e = e4 + e5 + e1 - e2 - e3
        
        if (bad == 0) && isfinite(qres.h) && qres.h > 0 {
            e = e
            return scalbn(Q_Val(&qres), e)
        }
    }
    lc = stirlerr(n) - stirlerr(x) - stirlerr(n-x) - bd0(x,n*p) - bd0(n-x,n*q)
    lf = 1.837877066409345483560659472811 + log(x) + log1p(- x/n)
    return exp(lc - (0.5)*lf)
}

/* == pnorm == */
pnorm :: (x: double, mu: double, sigma: double, lower_tail: int, log_p: int) -> double {
    p: double = 0
    cp: double = (0.0/0.0)
    if (x) != (x) || (mu) != (mu) || (sigma) != (sigma) {
        return x + mu + sigma
    }
    if (isfinite(x) == 0) && mu == x {
        return (0.0/0.0)
    }
    if sigma <= 0 {
        if sigma < 0 {
            return (0.0/0.0)
        }
        return (x < mu) ? (lower_tail != 0 ? 0.0 : 1.0) : (lower_tail != 0 ? 1.0 : 0.0)
    }
    p = (x - mu) / sigma
    if (isfinite(p) == 0) {
        return (x < mu) ? (lower_tail != 0 ? 0.0 : 1.0) : (lower_tail != 0 ? 1.0 : 0.0)
    }
    x = p
    pnorm_both(x, &p, &cp, (lower_tail ? 0 : 1), log_p)
    return(lower_tail ? p : cp)
}

