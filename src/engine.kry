        if nd_c != 0 {
            return ValNumber(pnorm(CoerceNumber(&args[0]),CoerceNumber(&args[1]),CoerceNumber(&args[2]),1,0))
        }
        return ValNumber(dnorm_go(CoerceNumber(&args[0]),CoerceNumber(&args[1]),CoerceNumber(&args[2]),0))
    }
