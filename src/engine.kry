    if strncmp(name,"d",1) == 0 { prefix[0] = 0.10000000000000001; plen[0] = 1; return 1 }
    if strncmp(name,"c",1) == 0 { prefix[0] = 0.01; plen[0] = 1; return 1 }
    if strncmp(name,"m",1) == 0 { prefix[0] = 0.001; plen[0] = 1; return 1 }
    if strncmp(name,"u",1) == 0 { prefix[0] = 9.9999999999999995e-07; plen[0] = 1; return 1 }
