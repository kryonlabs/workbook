    if BD0_READY == 0 { Bd0Init() }
    yh[0] = 0
    yl[0] = 0
    if x == m { return }
    e4: double = 2.2204460492503131e-16 * 2.2204460492503131e-16 * 2.2204460492503131e-16 * 2.2204460492503131e-16
    if (x < m * e4) { PairAdd(m,yh,yl); return }
    if m == 0 { yh[0] = 1.0 / 0.0; return }
    if (m < x * e4) {
        PairAdd(x * (log(x) - 1),yh,yl)
        PairAdd(-x * log(m),yh,yl)
        return
    }
    e: int = 0
    r: double = FrexpM(m / x,&e)
    i: int = (int)round((r - 0.5) * 256)
    f: double = round(1024 / (0.5 + (double)i / 256))
    fg: double = scalbn(f,-e - 10)
    j: int = 3
    while j >= 0 {
        PairAdd(x * BD0_V[i * 4 + j],yh,yl)
        PairAdd(-x * (double)e * BD0_V[j],yh,yl)
        j -= 1
    }
    PairAdd(m,yh,yl)
    m1: double = round(m)
    PairAdd(-m1 * fg,yh,yl)
    PairAdd(-(m - m1) * fg,yh,yl)
    PairAdd(-x * Log1pmx((m * fg - x) / x),yh,yl)
}

Pow1p :: (x: double, y: double) -> double {
    if ((x + 1) - 1 == x || x > 0.5 || x < -0.5 || x != x || y != y) { return pow(1 + x,y) }
    if (y < 0) { return 1 / Pow1p(x,-y) }
    x1: double = round(x * 65536) / 65536
    x2: double = x - x1
    h: double = 0
    l: double = 0
    Ebd0(y,y * (x + 1),&h,&l)
    PairAdd(-y * x1,&h,&l)
    PairAdd(-y * x2,&h,&l)
    return exp(-l) * exp(-h)
}

Pow1pm1 :: (x: double, y: double) -> double {
    if (x <= -1) { return pow(1 + x,y) - 1 }
    return expm1(y * log1p(x))
}

CalcPvif :: (rate: double, nper: double) -> double {
    return Pow1p(rate,nper)
}

CalcFvifa :: (rate: double, nper: double) -> double {
    if rate == 0 { return nper }
    return Pow1pm1(rate,nper) / rate
}

CalcPmt :: (rate: double, nper: double, pv: double, fv: double, ptype: int) -> double {
    pvif: double = CalcPvif(rate,nper)
    fvifa: double = CalcFvifa(rate,nper)
    return (-pv * pvif - fv) / ((1 + rate * (double)ptype) * fvifa)
}

CalcIpmtGo :: (rate: double, per: double, nper: double, pv: double, fv: double, ptype: int) -> double {
    pmt: double = CalcPmt(rate,nper,pv,fv,0)
    ipmt: double = -(pv * Pow1p(rate,per - 1) * rate + pmt * Pow1pm1(rate,per - 1))
    if ptype == 0 { return ipmt }
    return ipmt / (1 + rate)
}

GetRmz :: (r: double, n: double, pv: double, fv: double, ptype: int) -> double {
    rmz: double = 0
    term: double = 0
    if r == 0 {
        rmz = (pv + fv) / n
        return -rmz
    }
    term = Pow1p(r,n)
    if ptype > 0 {
        rmz = (fv * r / (term - 1) + pv * r / (1 - 1 / term)) / (1 + r)
    }
else {
        rmz = fv * r / (term - 1) + pv * r / (1 - 1 / term)
    }
    return -rmz
}

GetZw :: (r: double, n: double, pmt: double, pv: double, ptype: int) -> double {
    zw: double = 0
    term: double = 0
    if r == 0 {
        zw = pv + pmt * n
        return -zw
    }
    term = Pow1p(r,n)
    if ptype > 0 {
        zw = pv * term + pmt * (1 + r) * (term - 1) / r
    }
else {
        zw = pv * term + pmt * (term - 1) / r
    }
    return -zw
}

AnnualBasis :: (serial: int, basis: int) -> int {
    y: int = 0
    m: int = 0
    d: int = 0
    if basis == 0 || basis == 2 || basis == 4 { return 360 }
    if basis == 3 { return 365 }
    SerialToYmd(serial,&y,&m,&d)
    if IsLeapYear(y) { return 366 }
    return 365
}

DaysMonthlyBasis :: (s1: int, s2: int, basis: int) -> int {
    iy: int = 0
    im: int = 0
    id: int = 0
    my: int = 0
    mm: int = 0
    md: int = 0
    SerialToYmd(s1,&iy,&im,&id)
    SerialToYmd(s2,&my,&mm,&md)
    years: int = my - iy
    months: int = mm - im
    days: int = md - id
    months = years * 12 + months
    if basis == 0 {
        if (im == 2 && mm != 2 && iy == my) {
            if IsLeapYear(iy) { return months * 30 + days - 1 }
            return months * 30 + days - 2
        }
        return months * 30 + days
    }
    if (basis == 1 || basis == 2 || basis == 3) { return s2 - s1 }
    if basis == 4 { return months * 30 + days }
    return -1
}

FnPmt :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    r: double
    n: double
    pv: double
    fv: double
    ptype: int
    if count < 3 { return ValError(ERR_VALUE) }
    r = ArgAt(args,count,0,0)
    n = ArgAt(args,count,1,0)
    pv = ArgAt(args,count,2,0)
    fv = ArgAt(args,count,3,0)
    ptype = ArgAtInt(args,count,4,0)
    return ValNumber(CalcPmt(r,n,pv,fv,ptype))
}

FnFv :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    r: double
    n: double
    pmt: double
    pv: double
    ptype: int
    if count < 3 { return ValError(ERR_VALUE) }
    r = ArgAt(args,count,0,0)
    n = ArgAt(args,count,1,0)
    pmt = ArgAt(args,count,2,0)
    pv = ArgAt(args,count,3,0)
    ptype = ArgAtInt(args,count,4,0)
    pvif: double = CalcPvif(r,n)
    fvifa: double = CalcFvifa(r,n)
    return ValNumber(-((pv * pvif) + pmt * (1 + r * (double)ptype) * fvifa))
}

FnPv :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    r: double
    n: double
    pmt: double
    fv: double
    ptype: int
    if count < 3 { return ValError(ERR_VALUE) }
    r = ArgAt(args,count,0,0)
    n = ArgAt(args,count,1,0)
    pmt = ArgAt(args,count,2,0)
    fv = ArgAt(args,count,3,0)
    ptype = ArgAtInt(args,count,4,0)
    pvif: double = CalcPvif(r,n)
    fvifa: double = CalcFvifa(r,n)
    if pvif == 0 { return ValError(ERR_DIV0) }
    return ValNumber((-fv - pmt * (1 + r * (double)ptype) * fvifa) / pvif)
}

FnNper :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    r: double
    pmt: double
    pv: double
    fv: double
    ptype: int
    if count < 3 { return ValError(ERR_VALUE) }
    r = ArgAt(args,count,0,0)
    pmt = ArgAt(args,count,1,0)
    pv = ArgAt(args,count,2,0)
    fv = ArgAt(args,count,3,0)
    ptype = ArgAtInt(args,count,4,0)
    if r == 0 {
        if pmt == 0 { return ValError(ERR_DIV0) }
        return ValNumber(-(pv + fv) / pmt)
    }
    if r <= -1 { return ValError(ERR_NUM) }
    adj: double = pmt * (1 + r * (double)ptype)
    num: double = adj - fv * r
    den: double = pv * r + adj
    if num <= 0 { return ValError(ERR_VALUE) }
    return ValNumber(log(num / den) / log1p(r))
}

FnIpmt :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    r: double
    per: double
    n: double
    pv: double
    fv: double
    ptype: int
    if count < 4 { return ValError(ERR_VALUE) }
    r = ArgAt(args,count,0,0)
    per = ArgAt(args,count,1,0)
    n = ArgAt(args,count,2,0)
    pv = ArgAt(args,count,3,0)
    fv = ArgAt(args,count,4,0)
    ptype = ArgAtInt(args,count,5,0)
    if per < 1 || per >= n + 1 { return ValError(ERR_NUM) }
    return ValNumber(CalcIpmtGo(r,per,n,pv,fv,ptype))
}

FnPpmt :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    r: double
    n: double
    ptype: int
    pmt: double
    ipmt: Val
    v: double
    if count < 4 { return ValError(ERR_VALUE) }
    r = ArgAt(args,count,0,0)
    n = ArgAt(args,count,2,0)
    ptype = ArgAtInt(args,count,5,0)
    pv: double = ArgAt(args,count,3,0)
    fv: double = ArgAt(args,count,4,0)
    per: double = ArgAt(args,count,1,0)
    if per < 1 || per >= n + 1 { return ValError(ERR_NUM) }
    pmt = CalcPmt(r,n,pv,fv,ptype)
    ipmt_v: double = CalcIpmtGo(r,per,n,pv,fv,ptype)
    v = pmt - ipmt_v
    return ValNumber(v)
}

FnIspmt :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    r: double
    per: double
    n: double
    pv: double
    if count < 4 { return ValError(ERR_VALUE) }
    r = ArgAt(args,count,0,0)
    per = ArgAt(args,count,1,0)
    n = ArgAt(args,count,2,0)
    pv = ArgAt(args,count,3,0)
    if n == 0 { return ValError(ERR_DIV0) }
    tmp: double = -pv * r
    return ValNumber(tmp - (tmp / n * per))
}

CumulativeLoanPart :: (st: EvalState *, args: Val *, count: int, marks: int *, want_interest: int) -> Val {
    r: double
    n: int
    pv: double
    start: int
    endi: int
    ptype: int
    if count < 6 { return ValError(ERR_VALUE) }
    r = ArgAt(args,count,0,0)
    n = ArgAtInt(args,count,1,0)
    pv = ArgAt(args,count,2,0)
    start = ArgAtInt(args,count,3,1)
    endi = ArgAtInt(args,count,4,1)
    ptype = ArgAtInt(args,count,5,0)
    if start < 1 || endi < start || endi > n || n < 1 || pv <= 0 { return ValError(ERR_NUM) }
    rmz: double = GetRmz(r,(double)n,pv,0,ptype)
    total: double = 0
    i: int = 0
    if start == 1 {
        if want_interest {
            if ptype <= 0 {
                total = -pv
            }
        }
else {
            if ptype <= 0 {
                total = rmz + pv * r
            }
else {
                total = rmz
            }
        }
        start += 1
    }
    i = start
    while i <= endi {
        if want_interest {
            if ptype > 0 {
                total += GetZw(r,(double)(i - 2),rmz,pv,1) - rmz
            }
else {
                total += GetZw(r,(double)(i - 1),rmz,pv,0)
            }
        }
else {
            if ptype > 0 {
                total += rmz - (GetZw(r,(double)(i - 2),rmz,pv,1) - rmz) * r
            }
else {
                total += rmz - GetZw(r,(double)(i - 1),rmz,pv,0) * r
            }
        }
        i += 1
    }
    if want_interest { total *= r }
    return ValNumber(total)
}

FnNpv :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    r: double
    total: double
    i: int
    if count < 1 { return ValError(ERR_VALUE) }
    r = ArgAt(args,count,0,0)
    if r == -1 { return ValError(ERR_DIV0) }
    total = 0
    f: double = 1
    ff: double = 1 / (1 + r)
    i = 1
    while i < count {
        if args[i].kind == VAL_ERROR { return ValError(args[i].err) }
        if args[i].kind == VAL_FLOAT {
            f *= ff
            total += args[i].number * f
        }
        i += 1
    }
    return ValNumber(total)
}

CashList :: (args: Val *, count: int, out: double *) -> int {
    n: int = 0
    i: int = 0
    while i < count {
        if args[i].kind == VAL_ERROR { return -1 }
        if args[i].kind == VAL_FLOAT {
            if n < 4096 {
                out[n] = args[i].number
                n += 1
            }
        }
        i += 1
    }
    return n
}

FnSln :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    c: double
    s: double
    life: double
    if count < 3 { return ValError(ERR_VALUE) }
    c = ArgAt(args,count,0,0)
    s = ArgAt(args,count,1,0)
    life = ArgAt(args,count,2,0)
    if life == 0 { return ValError(ERR_DIV0) }
    return ValNumber((c - s) / life)
}

FnSyd :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    c: double
    s: double
    life: double
    per: double
    if count < 4 { return ValError(ERR_VALUE) }
    c = ArgAt(args,count,0,0)
    s = ArgAt(args,count,1,0)
    life = ArgAt(args,count,2,0)
    per = ArgAt(args,count,3,0)
    if life <= 0 { return ValError(ERR_NUM) }
    return ValNumber((c - s) * (life - per + 1) * 2 / (life * (life + 1)))
}

FnDdb :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    c: double
    s: double
    life: double
    per: double
    factor: double
    if count < 4 { return ValError(ERR_VALUE) }
    c = ArgAt(args,count,0,0)
    s = ArgAt(args,count,1,0)
    life = ArgAt(args,count,2,0)
    per = ArgAt(args,count,3,0)
    factor = ArgAt(args,count,4,2)
    if life <= 0 || per < 1 || per > life { return ValError(ERR_NUM) }
    total: double = 0
    p: int = 1
    while p <= (int)per {
        dep: double = (c - total) * factor / life
        if c - total - dep < s { dep = c - total - s }
        if p == (int)per { return ValNumber(dep) }
        total += dep
        p += 1
    }
    return ValNumber(0)
}

FnDb :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    c: double
    s: double
    life: double
    per: double
    month: double
    rate: double
    if count < 4 { return ValError(ERR_VALUE) }
    c = ArgAt(args,count,0,0)
    s = ArgAt(args,count,1,0)
    life = ArgAt(args,count,2,0)
    per = ArgAt(args,count,3,0)
    month = ArgAt(args,count,4,12)
    if c <= 0 || life <= 0 { return ValError(ERR_NUM) }
    rate = 1.0 - FinPower(s / c,1.0 / life)
    rate = (double)((long)(rate * 1000.0 + 0.5)) / 1000.0
    first: double = c * rate * month / 12.0
    if per == 1 { return ValNumber(first) }
    total: double = first
    p: int = 2
    while p <= (int)per {
        dep: double = (c - total) * rate
        if p == (int)life + 1 { dep = (c - total) * rate * (12.0 - month) / 12.0 }
        if p == (int)per { return ValNumber(dep) }
        total += dep
        p += 1
    }
    return ValNumber(0)
}

FnVdb :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    c: double
    s: double
    life: double
    start: double
    endi: double
    factor: double
    no_switch: int
    if count < 5 { return ValError(ERR_VALUE) }
    c = ArgAt(args,count,0,0)
    s = ArgAt(args,count,1,0)
    life = ArgAt(args,count,2,0)
    start = ArgAt(args,count,3,0)
    endi = ArgAt(args,count,4,0)
    factor = ArgAt(args,count,5,2)
    no_switch = ArgAtInt(args,count,6,0)
    if life <= 0 { return ValError(ERR_NUM) }
    if no_switch {
        dep: double = c * factor / life
        if start > 0 { dep = 0 }
        if endi <= 1 { dep = c * factor / life }
        return ValNumber(dep)
    }
    total_before: double = 0
    p: int = 0
    while (double)p < start {
        dep2: double = (c - total_before) * factor / life
        if c - total_before - dep2 < s { dep2 = c - total_before - s }
        total_before += dep2
        p += 1
    }
    total: double = total_before
    while (double)p < endi {
        dep3: double = (c - total) * factor / life
        straight: double = (c - total - s) / (life - p)
        if straight > dep3 { dep3 = straight }
        if c - total - dep3 < s { dep3 = c - total - s }
        total += dep3
        p += 1
    }
    return ValNumber(total - total_before)
}

FnYearfrac :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    s1: int
    s2: int
    basis: int
    if count < 2 { return ValError(ERR_VALUE) }
    s1 = ArgDate(args,count,0,-1)
    s2 = ArgDate(args,count,1,-1)
    basis = ArgBasis(args,count,2)
    if s1 < 0 || s2 < 0 || basis < 0 { return ValError(ERR_NUM) }
    return ValNumber(YearFracBasis(s1,s2,basis))
}

CouponDate :: (settle: int, mature: int, freq: int, eom: int, want_next: int) -> int {
    sy: int = 0
    sm: int = 0
    sd: int = 0
    my: int = 0
    mm: int = 0
    md: int = 0
    SerialToYmd(settle,&sy,&sm,&sd)
    SerialToYmd(mature,&my,&mm,&md)
    eom_special: int = 0
    if (eom != 0 && IsLastOfMonth(my,mm,md) != 0) { eom_special = 1 }
    months: int = 12 / freq
    periods: int = my - sy
    if periods > 0 { periods = (periods - 1) * freq }
    result: int = mature
    while 1 {
        result = mature
        periods += 1
        result = AddMonthsSerial(result,-periods * months)
        if eom_special != 0 {
            ry: int = 0
            rm: int = 0
            rd: int = 0
            SerialToYmd(result,&ry,&rm,&rd)
            result = YmdToSerial(ry,rm,DaysInMonthGo(ry,rm))
        }
        if settle >= result { break }
    }
    if want_next != 0 {
        result = mature
        periods -= 1
        result = AddMonthsSerial(result,-periods * months)
        if eom_special != 0 {
            ry: int = 0
            rm: int = 0
            rd: int = 0
            SerialToYmd(result,&ry,&rm,&rd)
            result = YmdToSerial(ry,rm,DaysInMonthGo(ry,rm))
        }
    }
    return result
}

CouponNext :: (settle: int, mature: int, freq: int) -> int {
    return CouponDate(settle,mature,freq,1,1)
}

CouponPrev :: (settle: int, mature: int, freq: int) -> int {
    return CouponDate(settle,mature,freq,1,0)
}

CouponCount :: (settle: int, mature: int, freq: int) -> int {
    sy: int = 0
    sm: int = 0
    sd: int = 0
    my: int = 0
    mm: int = 0
    md: int = 0
    SerialToYmd(settle,&sy,&sm,&sd)
    SerialToYmd(mature,&my,&mm,&md)
    months: int = mm - sm + 12 * (my - sy)
    this_coupon: int = AddMonthsSerial(mature,-months)
    if IsLastOfMonth(my,mm,md) != 0 {
        while 1 {
            cy: int = 0
            cm: int = 0
            cd: int = 0
            SerialToYmd(this_coupon,&cy,&cm,&cd)
            if cd == DaysInMonthGo(cy,cm) { break }
            this_coupon += 1
        }
    }
    cy2: int = 0
    cm2: int = 0
    cd2: int = 0
    SerialToYmd(this_coupon,&cy2,&cm2,&cd2)
    if sd >= cd2 { months -= 1 }
    return 1 + months / (12 / freq)
}

CoupDaysBs :: (settle: int, mature: int, freq: int, basis: int) -> double {
    return (double)BasisDaysBetween(CouponPrev(settle,mature,freq),settle,basis)
}

CoupDaysNc :: (settle: int, mature: int, freq: int, basis: int) -> double {
    return (double)BasisDaysBetween(settle,CouponNext(settle,mature,freq),basis)
}

CoupDaysGo :: (settle: int, mature: int, freq: int, basis: int) -> double {
    if basis == 1 {
        return (double)BasisDaysBetween(CouponPrev(settle,mature,freq),CouponNext(settle,mature,freq),1)
    }
    if basis == 3 { return 365.0 / (double)freq }
    return 360.0 / (double)freq
}

FnCoupncd :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    settle: int
    mature: int
    freq: int
    if count < 2 { return ValError(ERR_VALUE) }
    settle = ArgDate(args,count,0,-1)
    mature = ArgDate(args,count,1,-1)
    freq = ArgAtInt(args,count,2,1)
    basis: int = ArgBasis(args,count,3)
    if settle < 0 || mature < 0 || freq == 0 || basis < 0 { return ValError(ERR_NUM) }
    if settle >= mature { return ValError(ERR_NUM) }
    return ValNumber(CouponNext(settle,mature,freq))
}

FnCouppcd :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    settle: int
    mature: int
    freq: int
    if count < 2 { return ValError(ERR_VALUE) }
    settle = ArgDate(args,count,0,-1)
    mature = ArgDate(args,count,1,-1)
    freq = ArgAtInt(args,count,2,1)
    basis: int = ArgBasis(args,count,3)
    if settle < 0 || mature < 0 || freq == 0 || basis < 0 { return ValError(ERR_NUM) }
    if settle >= mature { return ValError(ERR_NUM) }
    return ValNumber(CouponPrev(settle,mature,freq))
}

FnCoupnum :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    settle: int
    mature: int
    freq: int
    if count < 2 { return ValError(ERR_VALUE) }
    settle = ArgDate(args,count,0,-1)
    mature = ArgDate(args,count,1,-1)
    freq = ArgAtInt(args,count,2,1)
    basis: int = ArgBasis(args,count,3)
    if settle < 0 || mature < 0 || freq == 0 || basis < 0 { return ValError(ERR_NUM) }
    if settle >= mature { return ValError(ERR_NUM) }
    return ValNumber(CouponCount(settle,mature,freq))
}

FnCoupdaybs :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    settle: int
    mature: int
    freq: int
    basis: int
    if count < 2 { return ValError(ERR_VALUE) }
    settle = ArgDate(args,count,0,-1)
    mature = ArgDate(args,count,1,-1)
    freq = ArgAtInt(args,count,2,1)
    basis = ArgBasis(args,count,3)
    if settle < 0 || mature < 0 || basis < 0 { return ValError(ERR_NUM) }
    if settle >= mature { return ValError(ERR_NUM) }
    return ValNumber(CoupDaysBs(settle,mature,freq,basis))
}

FnCoupdays :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    settle: int
    mature: int
    freq: int
    basis: int
    if count < 2 { return ValError(ERR_VALUE) }
    settle = ArgDate(args,count,0,-1)
    mature = ArgDate(args,count,1,-1)
    freq = ArgAtInt(args,count,2,1)
    basis = ArgBasis(args,count,3)
    if settle < 0 || mature < 0 || basis < 0 { return ValError(ERR_NUM) }
    if settle >= mature { return ValError(ERR_NUM) }
    return ValNumber(CoupDaysGo(settle,mature,freq,basis))
}

FnCoupdaysnc :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    settle: int
    mature: int
    freq: int
    basis: int
    if count < 2 { return ValError(ERR_VALUE) }
    settle = ArgDate(args,count,0,-1)
    mature = ArgDate(args,count,1,-1)
    freq = ArgAtInt(args,count,2,1)
    basis = ArgBasis(args,count,3)
    if settle < 0 || mature < 0 || basis < 0 { return ValError(ERR_NUM) }
    if settle >= mature { return ValError(ERR_NUM) }
    return ValNumber(CoupDaysNc(settle,mature,freq,basis))
}

FnAccrint :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    issue: int
    first: int
    settle: int
    rate: double
    par: double
    freq: int
    basis: int
    if count < 4 { return ValError(ERR_VALUE) }
    issue = ArgDate(args,count,0,-1)
    first = ArgDate(args,count,1,-1)
    settle = ArgDate(args,count,2,-1)
    rate = ArgAt(args,count,3,0)
    par = ArgAt(args,count,4,1000)
    freq = ArgAtInt(args,count,5,1)
    basis = ArgBasis(args,count,6)
    if issue < 0 || settle < 0 || basis < 0 { return ValError(ERR_NUM) }
    return ValNumber(par * rate * YearFracBasis(issue,settle,basis))
}

FnAccrintm :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    issue: int
    settle: int
    rate: double
    par: double
    basis: int
    if count < 3 { return ValError(ERR_VALUE) }
    issue = ArgDate(args,count,0,-1)
    settle = ArgDate(args,count,1,-1)
    rate = ArgAt(args,count,2,0)
    par = ArgAt(args,count,3,1000)
    basis = ArgBasis(args,count,4)
    if issue < 0 || settle < 0 || basis < 0 { return ValError(ERR_NUM) }
    a: double = (double)DaysMonthlyBasis(issue,settle,basis)
    d: double = (double)AnnualBasis(issue,basis)
    if a < 0 || d <= 0 || par <= 0 || rate <= 0 { return ValError(ERR_NUM) }
    return ValNumber(par * rate * a / d)
}

FnIntrate :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    settle: int
    mature: int
    invest: double
    red: double
    basis: int
    if count < 4 { return ValError(ERR_VALUE) }
    settle = ArgDate(args,count,0,-1)
    mature = ArgDate(args,count,1,-1)
    invest = ArgAt(args,count,2,0)
    red = ArgAt(args,count,3,0)
    basis = ArgBasis(args,count,4)
    if settle < 0 || mature < 0 || basis < 0 || invest == 0 { return ValError(ERR_NUM) }
    a: double = (double)DaysMonthlyBasis(settle,mature,basis)
    d: double = (double)AnnualBasis(settle,basis)
    if a <= 0 || d <= 0 { return ValError(ERR_NUM) }
    return ValNumber((red - invest) / invest * (d / a))
}

FnReceived :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    settle: int
    mature: int
    invest: double
    disc: double
    basis: int
    if count < 4 { return ValError(ERR_VALUE) }
    settle = ArgDate(args,count,0,-1)
    mature = ArgDate(args,count,1,-1)
    invest = ArgAt(args,count,2,0)
    disc = ArgAt(args,count,3,0)
    basis = ArgBasis(args,count,4)
    if settle < 0 || mature < 0 || basis < 0 { return ValError(ERR_NUM) }
    a: double = (double)DaysMonthlyBasis(settle,mature,basis)
    d: double = (double)AnnualBasis(settle,basis)
    if a <= 0 || d <= 0 { return ValError(ERR_NUM) }
    n: double = 1 - (disc * a / d)
    if n == 0 { return ValError(ERR_NUM) }
    return ValNumber(invest / n)
}

FnDisc :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    settle: int
    mature: int
    par: double
    red: double
    basis: int
    if count < 4 { return ValError(ERR_VALUE) }
    settle = ArgDate(args,count,0,-1)
    mature = ArgDate(args,count,1,-1)
    par = ArgAt(args,count,2,0)
    red = ArgAt(args,count,3,0)
    basis = ArgBasis(args,count,4)
    if settle < 0 || mature < 0 || basis < 0 { return ValError(ERR_NUM) }
    b: double = (double)AnnualBasis(settle,basis)
    dsm: double = (double)DaysMonthlyBasis(settle,mature,basis)
    if (dsm <= 0 || b <= 0 || red == 0) { return ValError(ERR_NUM) }
    return ValNumber((red - par) / red * (b / dsm))
}

FnPricedisc :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    settle: int
    mature: int
    disc: double
    red: double
    basis: int
    if count < 4 { return ValError(ERR_VALUE) }
    settle = ArgDate(args,count,0,-1)
    mature = ArgDate(args,count,1,-1)
    disc = ArgAt(args,count,2,0)
    red = ArgAt(args,count,3,0)
    basis = ArgBasis(args,count,4)
    if settle < 0 || mature < 0 || basis < 0 { return ValError(ERR_NUM) }
    a: double = (double)DaysMonthlyBasis(settle,mature,basis)
    d: double = (double)AnnualBasis(settle,basis)
    if a <= 0 || d <= 0 { return ValError(ERR_NUM) }
    return ValNumber(red - disc * red * a / d)
}

FnTbilleq :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    settle: int
    mature: int
    disc: double
    if count < 3 { return ValError(ERR_VALUE) }
    settle = ArgDate(args,count,0,-1)
    mature = ArgDate(args,count,1,-1)
    disc = ArgAt(args,count,2,0)
    if settle < 0 || mature < 0 { return ValError(ERR_NUM) }
    dsm: double = (double)(mature - settle)
    if (settle > mature || disc < 0 || dsm > 365) { return ValError(ERR_NUM) }
    divisor: double = 360 - disc * dsm
    if divisor == 0 { return ValError(ERR_DIV0) }
    return ValNumber((365 * disc) / divisor)
}

FnTbillprice :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    settle: int
    mature: int
    disc: double
    if count < 3 { return ValError(ERR_VALUE) }
    settle = ArgDate(args,count,0,-1)
    mature = ArgDate(args,count,1,-1)
    disc = ArgAt(args,count,2,0)
    if settle < 0 || mature < 0 || disc <= 0 || disc >= 1 { return ValError(ERR_NUM) }
    dsm: double = (double)(mature - settle)
    if dsm <= 0 { return ValError(ERR_NUM) }
    return ValNumber(100 * (1 - disc * dsm / 360))
}

FnTbillyield :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    settle: int
    mature: int
    price: double
    if count < 3 { return ValError(ERR_VALUE) }
    settle = ArgDate(args,count,0,-1)
    mature = ArgDate(args,count,1,-1)
    price = ArgAt(args,count,2,0)
    if settle < 0 || mature < 0 || price <= 0 { return ValError(ERR_NUM) }
    dsm: double = (double)(mature - settle)
    if dsm <= 0 { return ValError(ERR_NUM) }
    return ValNumber((100 - price) / price * 360 / dsm)
}

FnEffect :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    r: double
    m: double
    if count < 2 { return ValError(ERR_VALUE) }
    r = ArgAt(args,count,0,0)
    m = floor(ArgAt(args,count,1,0))
    if r <= 0 || m < 1 { return ValError(ERR_NUM) }
    return ValNumber(Pow1pm1(r / m,m))
}

FnNominal :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    e: double
    m: double
    if count < 2 { return ValError(ERR_VALUE) }
    e = ArgAt(args,count,0,0)
    m = floor(ArgAt(args,count,1,0))
    if e <= 0 || m < 1 { return ValError(ERR_NUM) }
    return ValNumber(m * Pow1pm1(e,1 / m))
}

FnDollarde :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    v: double
    frac: double
    if count < 2 { return ValError(ERR_VALUE) }
    v = ArgAt(args,count,0,0)
    frac = ArgAt(args,count,1,0)
    if frac < 0 { return ValError(ERR_NUM) }
    whole: double = (double)(long long)v
    rest: double = fabs(v - whole)
    digits: int = 1
    fdigits: double = frac
    while fdigits >= 10 {
        fdigits /= 10
        digits += 1
    }
    return ValNumber(whole + rest * FinPower(10.0,(double)digits) / frac)
}

FnDollarfr :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    v: double
    frac: double
    if count < 2 { return ValError(ERR_VALUE) }
    v = ArgAt(args,count,0,0)
    frac = ArgAt(args,count,1,0)
    if frac < 0 { return ValError(ERR_NUM) }
    whole: double = (double)(long long)v
    rest: double = fabs(v - whole)
    digits: int = 1
    fdigits: double = frac
    while fdigits >= 10 {
        fdigits /= 10
        digits += 1
    }
    numerator: double = rest * frac
    return ValNumber(whole + numerator / FinPower(10.0,(double)digits))
}

FnFvschedule :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    principal: double
    total: double
    i: int
    if count < 1 { return ValError(ERR_VALUE) }
    principal = ArgAt(args,count,0,0)
    total = principal
    i = 1
    while i < count {
        if args[i].kind == VAL_ERROR { return ValError(args[i].err) }
        if args[i].from_range == 0 { return ValError(ERR_NA) }
        if args[i].kind == VAL_FLOAT {
            total *= 1 + args[i].number
        }
        i += 1
    }
    return ValNumber(total)
}

PriceGo :: (settle: int, mature: int, rate: double, yld: double, red: double, freq: int, basis: int) -> double {
    a: double = CoupDaysBs(settle,mature,freq,basis)
    d: double = CoupDaysNc(settle,mature,freq,basis)
    e: double = CoupDaysGo(settle,mature,freq,basis)
    n: int = CouponCount(settle,mature,freq)
    den: double = 100 * rate / (double)freq
    basem1: double = yld / (double)freq
    exponent: double = d / e
    if n == 1 {
        return (red + den) / (1 + exponent * basem1) - a / e * den
    }
    nd: double = (double)n
    sum: double = den * Pow1p(basem1,1 - nd - exponent) * Pow1pm1(basem1,nd) / basem1
    first_term: double = red / Pow1p(basem1,nd - 1 + d / e)
    last_term: double = a / e * den
    return first_term + sum - last_term
}

FnPrice :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    settle: int
    mature: int
    rate: double
    yld: double
    red: double
    freq: int
    basis: int
    if count < 5 { return ValError(ERR_VALUE) }
    settle = ArgDate(args,count,0,-1)
    mature = ArgDate(args,count,1,-1)
    rate = ArgAt(args,count,2,0)
    yld = ArgAt(args,count,3,0)
    red = ArgAt(args,count,4,100)
    freq = ArgAtInt(args,count,5,1)
    basis = ArgBasis(args,count,6)
    if settle < 0 || mature < 0 || basis < 0 || freq < 1 { return ValError(ERR_NUM) }
    if settle > mature { return ValError(ERR_NUM) }
    if (rate < 0 || yld < 0 || red <= 0) { return ValError(ERR_NUM) }
    return ValNumber(PriceGo(settle,mature,rate,yld,red,freq,basis))
}
GS :: struct {
    havexpos: int
    havexneg: int
    have_root: int
    xpos: double
    ypos: double
    xneg: double
    yneg: double
    root: double
    xmin: double
    xmax: double
    precision: double
}

GsEvalF :: (kind: int, x: double, y: double *) -> int {
    sum: double = 0
    f: double = 1
    ff: double = 1
    i: int = 0
    n: int = 0
    dd: double = 0
    if kind == 0 {
        if (x > -1 && x != 0) {
            y[0] = GS_R_PV * CalcPvif(x,GS_R_NPER) + GS_R_PMT * (1 + x * (double)GS_R_TYPE) * CalcFvifa(x,GS_R_NPER) + GS_R_FV
            return 1
        }
        return 0
    }
    if kind == 1 {
        ff = 1 / (x + 1)
        n = GS_CASH_N
        while i < n {
            sum += GSV_A[i] * f
            f *= ff
            i += 1
        }
        y[0] = sum
        if (sum != sum || sum - sum != 0) { return 0 }
        return 1
    }
    if kind == 2 {
        n = GS_CASH_N
        while i < n {
            dd = GSD_A[i] - GSD_A[0]
            if dd < 0 { return 0 }
            sum += GSV_A[i] / Pow1p(x,dd / 365)
            i += 1
        }
        y[0] = sum
        return 1
    }
    y[0] = PriceGo(GS_Y_SETTLE,GS_Y_MAT,GS_Y_RATE,x,GS_Y_RED,GS_Y_FREQ,GS_Y_BASIS) - GS_Y_PAR
    return 1
}

GsEvalDf :: (kind: int, x: double, y: double *) -> int {
    sum: double = 0
    f: double = 1
    ff: double = 1
    i: int = 1
    n: int = 0
    if kind == 0 {
        if (x > -1 && x != 0) {
            y[0] = -GS_R_PMT * CalcFvifa(x,GS_R_NPER) / x + CalcPvif(x,GS_R_NPER - 1) * GS_R_NPER * (GS_R_PV + GS_R_PMT * ((double)GS_R_TYPE + 1 / x))
            return 1
        }
        return 0
    }
    if kind == 1 {
        ff = 1 / (x + 1)
        n = GS_CASH_N
        while i < n {
            sum += GSV_A[i] * (double)(-i) * f
            f *= ff
            i += 1
        }
        y[0] = sum
        if (sum != sum || sum - sum != 0) { return 0 }
        return 1
    }
    return 0
}

GsUpdateData :: (x: double, y: double, data: GS *) -> int {
    if (y != y || y - y != 0) { return 0 }
    if y > 0 {
        if data->havexpos != 0 {
            if data->havexneg != 0 {
                if (fabs(x - data->xneg) < fabs(data->xpos - data->xneg)) {
                    data->xpos = x
                    data->ypos = y
                }
            }
else if (y < data->ypos) {
                data->xpos = x
                data->ypos = y
            }
        }
else {
            data->xpos = x
            data->ypos = y
            data->havexpos = 1
        }
        return 0
    }
else if y < 0 {
        if data->havexneg != 0 {
            if data->havexpos != 0 {
                if (fabs(x - data->xpos) < fabs(data->xpos - data->xneg)) {
                    data->xneg = x
                    data->yneg = y
                }
            }
else if (-y < -data->yneg) {
                data->xneg = x
                data->yneg = y
            }
        }
else {
            data->xneg = x
            data->yneg = y
            data->havexneg = 1
        }
        return 0
    }
    data->have_root = 1
    data->root = x
    return 1
}

GsFakeDf :: (kind: int, x: double, dfx: double *, xstep: double, data: GS *) -> int {
    xl: double = x - xstep
    xr: double = x + xstep
    yl: double = 0
    yr: double = 0
    status: int = 0
    if xl < data->xmin { xl = x }
    if xr > data->xmax { xr = x }
    if xl == xr { return 0 }
    status = GsEvalF(kind,xl,&yl)
    if status != 1 { return status }
    status = GsEvalF(kind,xr,&yr)
    if status != 1 { return status }
    dfx[0] = (yr - yl) / (xr - xl)
    if (dfx[0] != dfx[0] || dfx[0] - dfx[0] != 0) { return 0 }
    return 1
}

GsInit :: (data: GS *) {
    data->havexpos = 0
    data->havexneg = 0
    data->have_root = 0
    data->xpos = 0.0 / 0.0
    data->xneg = 0.0 / 0.0
    data->root = 0.0 / 0.0
    data->ypos = 0.0 / 0.0
    data->yneg = 0.0 / 0.0
    data->xmin = -1e10
    data->xmax = 1e10
    data->precision = 1e-10
}

GsPoint :: (kind: int, data: GS *, x0: double) -> int {
    y0: double = 0
    status: int = 0
    if data->have_root != 0 { return 1 }
    if (x0 < data->xmin || x0 > data->xmax) { return 0 }
    status = GsEvalF(kind,x0,&y0)
    if status != 1 { return status }
    if GsUpdateData(x0,y0,data) != 0 { return 1 }
    return 0
}

GsBisection :: (kind: int, data: GS *) -> int {
    iterations: int = 0
    newton_submethod: int = 0
    stepsize: double = 0
    xmid: double = 0
    ymid: double = 0
    det: double = 0
    x0: double = 0
    y0: double = 0
    xstep: double = 0
    df0: double = 0
    method: int = 0
    fail: int = 0
    status: int = 0
    if data->have_root != 0 { return 1 }
    if (data->havexpos == 0 || data->havexneg == 0) { return 0 }
    stepsize = fabs(data->xpos - data->xneg) / (fabs(data->xpos) + fabs(data->xneg))
    while iterations < 160 {
        fail = 0
        if iterations % 4 == 0 {
            method = 3
        }
else if iterations % 4 == 2 {
            method = 1
        }
else {
            method = 2
        }
        if method == 1 {
            if (stepsize > 0.1) { method = 2 }
        }
        if method == 3 {
            xmid = (data->xpos + data->xneg) / 2
            status = GsEvalF(kind,xmid,&ymid)
            if status != 1 {
                fail = 1
            }
else {
                if ymid == 0 {
                    GsUpdateData(xmid,ymid,data)
                    return 1
                }
                det = sqrt(ymid * ymid - data->ypos * data->yneg)
                if det == 0 {
                    fail = 1
                }
else {
                    xmid += (xmid - data->xpos) * ymid / det
                }
            }
        }
else if method == 1 {
            x0 = 0
            y0 = 0
            fail = 0
            if newton_submethod % 4 == 0 {
                x0 = data->xpos
                y0 = data->ypos
            }
else if newton_submethod % 4 == 2 {
                x0 = data->xneg
                y0 = data->yneg
            }
else {
                x0 = (data->xpos + data->xneg) / 2
                status = GsEvalF(kind,x0,&y0)
                if status != 1 { fail = 1 }
            }
            newton_submethod += 1
            if fail == 0 {
                xstep = fabs(data->xpos - data->xneg) / 1000000
                status = GsFakeDf(kind,x0,&df0,xstep,data)
                if status != 1 { fail = 1 }
            }
            if fail == 0 {
                if df0 == 0 { fail = 1 }
            }
            if fail == 0 {
                xmid = x0 - 1.01 * y0 / df0
            }
        }
else {
            xmid = (data->xpos + data->xneg) / 2
        }
        if fail == 0 {
            if ((xmid < data->xpos && xmid < data->xneg) || (xmid > data->xpos && xmid > data->xneg)) {
                xmid = (data->xpos + data->xneg) / 2
                method = 2
            }
            status = GsEvalF(kind,xmid,&ymid)
            if status != 1 { fail = 1 }
        }
        if fail == 0 {
            if GsUpdateData(xmid,ymid,data) != 0 { return 1 }
            stepsize = fabs(data->xpos - data->xneg) / (fabs(data->xpos) + fabs(data->xneg))
            if stepsize < 2.2204460492503131e-16 {
                if (data->yneg < ymid) {
                    ymid = data->yneg
                    xmid = data->xneg
                }
                if (data->ypos < ymid) {
                    ymid = data->ypos
                    xmid = data->xpos
                }
                data->have_root = 1
                data->root = xmid
                return 1
            }
        }
        iterations += 1
    }
    return 0
}

GsNewtonPolish :: (kind: int, data: GS *, use_df: int, x0: double, y0: double) -> int {
    iterations: int = 0
    last_df0: double = 1
    try_newton: int = 1
    try_square: int = 0
    x1: double = 0
    y1: double = 0
    r: double = 0
    df0: double = 0
    status: int = 0
    if (x0 != 0 && fabs(x0) < 1e10) { try_square = 1 }
    while iterations < 20 {
        if try_square != 0 {
            x1 = x0 * fabs(x0)
            status = GsEvalF(kind,x1,&y1)
            if status == 1 {
                if GsUpdateData(x1,y1,data) != 0 { return 1 }
                r = fabs(y1 / y0)
                if r < 1 {
                    x0 = x1
                    if (r <= 0.5) { try_square = 0 }
                }
else {
                    try_square = 0
                }
            }
else {
                try_square = 0
            }
        }
        if try_newton != 0 {
            if use_df != 0 {
                status = GsEvalDf(kind,x0,&df0)
            }
else {
                status = GsFakeDf(kind,x0,&df0,fabs(x0) / 1000000,data)
            }
            if (status != 1 || df0 == 0) {
                df0 = last_df0
            }
else {
                last_df0 = df0
            }
            x1 = x0 - y0 / df0
            if (x1 >= data->xmin && x1 <= data->xmax) {
                status = GsEvalF(kind,x1,&y1)
                if status == 1 {
                    if GsUpdateData(x1,y1,data) != 0 { return 1 }
                    r = fabs(y1 / y0)
                    if r < 1 {
                        x0 = x1
                        if (r > 0.5) { try_newton = 0 }
                    }
else {
                        try_newton = 0
                    }
                }
else {
                    try_newton = 0
                }
            }
else {
                try_newton = 0
            }
        }
        if (try_square == 0 && try_newton == 0) { break }
        iterations += 1
    }
    if GsBisection(kind,data) == 1 { return 1 }
    data->root = x0
    data->have_root = 1
    return 1
}

GsNewton :: (kind: int, data: GS *, use_df: int, x0_in: double) -> int {
    iterations: int = 0
    x0: double = x0_in
    precision: double = data->precision / 2
    last_df0: double = 1
    step_factor: double = 1e-6
    x1: double = 0
    y0: double = 0
    y1: double = 0
    df0: double = 0
    stepsize: double = 0
    xstep: double = 0
    status: int = 0
    flat: int = 0
    if data->have_root != 0 { return 1 }
    while iterations < 100 {
        if (x0 < data->xmin || x0 > data->xmax) { return 0 }
        status = GsEvalF(kind,x0,&y0)
        if status != 1 { return 0 }
        if GsUpdateData(x0,y0,data) != 0 { return 1 }
        if use_df != 0 {
            status = GsEvalDf(kind,x0,&df0)
        }
else {
            if fabs(x0) < 1e-10 {
                if (data->havexneg != 0 && data->havexpos != 0) {
                    xstep = fabs(data->xpos - data->xneg) / 1000000
                }
else {
                    xstep = (data->xmax - data->xmin) / 1000000
                }
            }
else {
                xstep = step_factor * fabs(x0)
            }
            status = GsFakeDf(kind,x0,&df0,xstep,data)
        }
        if status != 1 { return 0 }
        flat = 0
        if df0 == 0 { flat = 1 }
        if flat != 0 {
            last_df0 /= 2
            if fabs(last_df0) <= 2.2250738585072014e-308 { return 0 }
            df0 = last_df0
        }
else {
            last_df0 = df0
        }
        if (data->havexpos != 0 && data->havexneg != 0) {
            x1 = x0 - y0 / df0
        }
else {
            x1 = x0 - 1.000001 * y0 / df0
        }
        stepsize = fabs(x1 - x0) / (fabs(x0) + fabs(x1))
        if stepsize < precision {
            GsNewtonPolish(kind,data,use_df,x0,y0)
            return 1
        }
        if (flat != 0 && iterations > 0) {
            if (x1 < data->xmin || x1 > data->xmax) { return 0 }
            status = GsEvalF(kind,x1,&y1)
            if status != 1 { return 0 }
            if (fabs(y1) >= 0.9 * fabs(y0)) { return 0 }
        }
        if stepsize < step_factor { step_factor = stepsize }
        x0 = x1
        iterations += 1
    }
    return 0
}

RateGo :: (nper: int, pmt: double, pv: double, fv: double, ptype: int, rate0: double, ok: int *) -> double {
    data: GS = {0}
    status: int = 0
    factor: int = 0
    px: double = 0
    GS_R_NPER = (double)nper
    GS_R_PMT = pmt
    GS_R_PV = pv
    GS_R_FV = fv
    GS_R_TYPE = ptype
    GsInit(&data)
    px = pow(1.7976931348623157e308 / 1e10,1.0 / (double)nper)
    if (-px + 1 > data.xmin) { data.xmin = -px + 1 }
    if (px - 1 < data.xmax) { data.xmax = px - 1 }
    status = GsNewton(0,&data,1,rate0)
    if status != 1 {
        factor = 2
        while (data.havexneg == 0 || data.havexpos == 0) && factor < 100 {
            GsPoint(0,&data,rate0 * (double)factor)
            GsPoint(0,&data,rate0 / (double)factor)
            factor *= 2
        }
        status = GsBisection(0,&data)
    }
    if status != 1 {
        ok[0] = 0
        return 0
    }
    ok[0] = 1
    return data.root
}

IrrGo :: (rate0: double, ok: int *) -> double {
    data: GS = {0}
    status: int = 0
    i: int = 0
    s: double = 0
    xmax_v: double = 0
    GsInit(&data)
    data.xmin = -1
    xmax_v = pow(1.7976931348623157e308 / 1e10,1.0 / (double)GS_CASH_N)
    if (xmax_v - 1 < data.xmax) { data.xmax = xmax_v - 1 }
    status = GsNewton(1,&data,1,rate0)
    if status != 1 {
        i = 0
        s = 2
        while (data.havexneg == 0 || data.havexpos == 0) && i < 10 {
            GsPoint(1,&data,rate0 * s)
            GsPoint(1,&data,rate0 / s)
            i += 1
            s *= 2
        }
        if (data.havexneg == 0 || data.havexpos == 0) {
            status = GsNewton(1,&data,1,-0.99)
        }
        if (data.havexneg == 0 || data.havexpos == 0) {
            GsPoint(1,&data,1 - 2.2204460492503131e-16)
        }
        status = GsBisection(1,&data)
    }
    if status != 1 {
        ok[0] = 0
        return 0
    }
    ok[0] = 1
    return data.root
}

XirrGo :: (rate0: double, ok: int *) -> double {
    data: GS = {0}
    status: int = 0
    i: int = 0
    GsInit(&data)
    data.xmin = -1
    if (1000 < data.xmax) { data.xmax = 1000 }
    status = GsNewton(2,&data,0,rate0)
    if status != 1 {
        GsPoint(2,&data,-1)
        i = 1
        while i <= 1024 {
            GsPoint(2,&data,-1 + 10.0 / (double)(i + 9))
            GsPoint(2,&data,(double)i)
            status = GsBisection(2,&data)
            if status == 1 { break }
            i += i
        }
    }
    if status != 1 {
        ok[0] = 0
        return 0
    }
    ok[0] = 1
    return data.root
}

YieldGo :: (settle: int, mature: int, rate: double, par: double, red: double, freq: int, basis: int, ok: int *) -> double {
    data: GS = {0}
    status: int = 0
    yield0: double = 0
    n: int = 0
    GS_Y_SETTLE = settle
    GS_Y_MAT = mature
    GS_Y_RATE = rate
    GS_Y_PAR = par
    GS_Y_RED = red
    GS_Y_FREQ = freq
    GS_Y_BASIS = basis
    n = CouponCount(settle,mature,freq)
    if n <= 1 {
        a: double = CoupDaysBs(settle,mature,freq,basis)
        d: double = CoupDaysNc(settle,mature,freq,basis)
        e: double = CoupDaysGo(settle,mature,freq,basis)
        coeff: double = (double)freq * e / d
        num: double = (red / 100 + rate / (double)freq) - (par / 100 + (a / e * rate / (double)freq))
        den: double = par / 100 + (a / e * rate / (double)freq)
        ok[0] = 1
        return num / den * coeff
    }
    GsInit(&data)
    if (0 > data.xmin) { data.xmin = 0 }
    if (1000 < data.xmax) { data.xmax = 1000 }
    yield0 = 0.1
    status = GsNewton(3,&data,0,yield0)
    if status != 1 {
        yield0 = 1e-10
        while yield0 < data.xmax {
            GsPoint(3,&data,yield0)
            yield0 *= 2
        }
        status = GsBisection(3,&data)
    }
    if status != 1 {
        ok[0] = 0
        return 0
    }
    ok[0] = 1
    return data.root
}

FnRate :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    n: int
    pmt: double
    pv: double
    fv: double
    ptype: int
    guess: double
    ok: int = 0
    if count < 3 { return ValError(ERR_VALUE) }
    n = ArgAtInt(args,count,0,0)
    pmt = ArgAt(args,count,1,0)
    pv = ArgAt(args,count,2,0)
    fv = ArgAt(args,count,3,0)
    ptype = ArgAtInt(args,count,4,0)
    guess = ArgAt(args,count,5,0.1)
    if n <= 0 { return ValError(ERR_NUM) }
    r: double = RateGo(n,pmt,pv,fv,ptype,guess,&ok)
    if ok == 0 { return ValError(ERR_NUM) }
    return ValNumber(r)
}

FnIrr :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    values: [512] double = {0}
    gs: int = 0
    gl: int = 0
    n: int = 0
    guess: double = 0.1
    ok: int = 0
    i: int = 0
    if count < 1 { return ValError(ERR_VALUE) }
    GroupBounds(marks,count,0,&gs,&gl)
    n = CashList(args + gs,gl,values)
    if n < 1 { return ValError(ERR_VALUE) }
    if count >= 2 && args[count - 1].from_range == 0 { guess = CoerceNumber(&args[count - 1]) }
    GS_CASH_N = n
    while i < n {
        GSV_A[i] = values[i]
        i += 1
    }
    r: double = IrrGo(guess,&ok)
    if ok == 0 { return ValError(ERR_NUM) }
    return ValNumber(r)
}

FnMirr :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    values: [512] double = {0}
    gs: int = 0
    gl: int = 0
    n: int = 0
    fr: double = 0
    rr: double = 0
    npv_neg: double = 0
    npv_pos: double = 0
    i: int = 0
    if count < 3 { return ValError(ERR_VALUE) }
    GroupBounds(marks,count,0,&gs,&gl)
    n = CashList(args + gs,gl,values)
    if n < 2 { return ValError(ERR_VALUE) }
    fr = ArgAt(args,count,count - 2,0)
    rr = ArgAt(args,count,count - 1,0)
    while i < n {
        if values[i] >= 0 {
            npv_pos += values[i] / Pow1p(rr,(double)i)
        }
else {
            npv_neg += values[i] / Pow1p(fr,(double)i)
        }
        i += 1
    }
    if (npv_neg == 0 || npv_pos == 0 || rr <= -1) { return ValError(ERR_DIV0) }
    res: double = pow((-npv_pos * Pow1p(rr,(double)n)) / (npv_neg * (1 + rr)),1.0 / (double)(n - 1)) - 1
    return ValNumber(res)
}


FnYield :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    settle: int
    mature: int
    rate: double
    price: double
    red: double
    freq: int
    basis: int
    if count < 5 { return ValError(ERR_VALUE) }
    settle = ArgDate(args,count,0,-1)
    mature = ArgDate(args,count,1,-1)
    rate = ArgAt(args,count,2,0)
    price = ArgAt(args,count,3,0)
    red = ArgAt(args,count,4,100)
    freq = ArgAtInt(args,count,5,1)
    basis = ArgBasis(args,count,6)
    if settle < 0 || mature < 0 || basis < 0 || freq < 1 { return ValError(ERR_NUM) }
    if settle > mature { return ValError(ERR_NUM) }
    if (rate < 0 || price < 0 || red <= 0) { return ValError(ERR_NUM) }
    ok: int = 0
    y: double = YieldGo(settle,mature,rate,price,red,freq,basis,&ok)
    if ok == 0 { return ValError(ERR_NUM) }
    return ValNumber(y)
}

DurationGo :: (settle: int, mature: int, rate: double, yld: double, freq: int, basis: int) -> double {
    numcoups: double = (double)CouponCount(settle,mature,freq)
    fDur: double = 0
    p: double = 0
    t: double = 0
    fcoup: double = rate * 100 / (double)freq
    fyld: double = yld / (double)freq
    fyld += 1
    t = 1
    while t < numcoups {
        fDur += t * fcoup / pow(fyld,t)
        t += 1
    }
    fDur += numcoups * (fcoup + 100) / pow(fyld,numcoups)
    t = 1
    while t < numcoups {
        p += fcoup / pow(fyld,t)
        t += 1
    }
    p += (fcoup + 100) / pow(fyld,numcoups)
    fDur /= p
    fDur /= (double)freq
    return fDur
}

FnDuration :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    settle: int
    mature: int
    rate: double
    yld: double
    freq: int
    basis: int
    if count < 4 { return ValError(ERR_VALUE) }
    settle = ArgDate(args,count,0,-1)
    mature = ArgDate(args,count,1,-1)
    rate = ArgAt(args,count,2,0)
    yld = ArgAt(args,count,3,0)
    freq = ArgAtInt(args,count,4,1)
    basis = ArgBasis(args,count,5)
    if settle < 0 || mature < 0 || basis < 0 || freq < 1 { return ValError(ERR_NUM) }
    if settle >= mature { return ValError(ERR_NUM) }
    return ValNumber(DurationGo(settle,mature,rate,yld,freq,basis))
}

FnMduration :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    settle: int
    mature: int
    rate: double
    yld: double
    freq: int
    basis: int
    if count < 4 { return ValError(ERR_VALUE) }
    settle = ArgDate(args,count,0,-1)
    mature = ArgDate(args,count,1,-1)
    rate = ArgAt(args,count,2,0)
    yld = ArgAt(args,count,3,0)
    freq = ArgAtInt(args,count,4,1)
    basis = ArgBasis(args,count,5)
    if settle < 0 || mature < 0 || basis < 0 || freq < 1 { return ValError(ERR_NUM) }
    if settle >= mature { return ValError(ERR_NUM) }
    d: double = DurationGo(settle,mature,rate,yld,freq,basis)
    d /= 1 + (yld / (double)freq)
    return ValNumber(d)
}

Price_Mat_Impl :: (settle: int, mature: int, issue: int, rate: double, yld: double, basis: int) -> double {
    dsm: double = (double)DaysMonthlyBasis(settle,mature,basis)
    dim: double = (double)DaysMonthlyBasis(issue,mature,basis)
    a: double = (double)DaysMonthlyBasis(issue,settle,basis)
    b: double = (double)AnnualBasis(settle,basis)
    n: double = 1 + (dsm / b * yld)
    return ((100 + (dim / b * rate * 100)) / n) - (a / b * rate * 100)
}

FnPricemat :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    settle: int
    mature: int
    issue: int
    rate: double
    yld: double
    basis: int
    if count < 5 { return ValError(ERR_VALUE) }
    settle = ArgDate(args,count,0,-1)
    mature = ArgDate(args,count,1,-1)
    issue = ArgDate(args,count,2,-1)
    rate = ArgAt(args,count,3,0)
    yld = ArgAt(args,count,4,0)
    basis = ArgBasis(args,count,5)
    if settle < 0 || mature < 0 || issue < 0 || basis < 0 { return ValError(ERR_NUM) }
    return ValNumber(Price_Mat_Impl(settle,mature,issue,rate,yld,basis))
}

YieldMatAt :: (settle: int, mature: int, issue: int, rate: double, price: double, basis: int) -> double {
    issmat: double = YearFracBasis(issue,mature,basis)
    issset: double = YearFracBasis(issue,settle,basis)
    setmat: double = YearFracBasis(settle,mature,basis)
    y: double = 1 + issmat * rate
    y /= price / 100 + issset * rate
    y -= 1
    y /= setmat
    return y
}

FnYieldmat :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    settle: int
    mature: int
    issue: int
    rate: double
    price: double
    basis: int
    if count < 5 { return ValError(ERR_VALUE) }
    settle = ArgDate(args,count,0,-1)
    mature = ArgDate(args,count,1,-1)
    issue = ArgDate(args,count,2,-1)
    rate = ArgAt(args,count,3,0)
    price = ArgAt(args,count,4,0)
    basis = ArgBasis(args,count,5)
    if settle < 0 || mature < 0 || issue < 0 || basis < 0 || price <= 0 { return ValError(ERR_NUM) }
    return ValNumber(YieldMatAt(settle,mature,issue,rate,price,basis))
}

FnYielddisc :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    settle: int
    mature: int
    price: double
    red: double
    basis: int
    if count < 4 { return ValError(ERR_VALUE) }
    settle = ArgDate(args,count,0,-1)
    mature = ArgDate(args,count,1,-1)
    price = ArgAt(args,count,2,0)
    red = ArgAt(args,count,3,0)
    basis = ArgBasis(args,count,4)
    if settle < 0 || mature < 0 || basis < 0 || price <= 0 { return ValError(ERR_NUM) }
    yf: double = YearFracBasis(settle,mature,basis)
    if yf == 0 || price == 0 { return ValError(ERR_DIV0) }
    return ValNumber((red / price - 1) / yf)
}

OddPriceStub :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return ValError(ERR_VALUE)
}

FnAmorlinc :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    c: double
    settle: int
    first: int
    salvage: double
    per: int
    rate: double
    basis: int
    if count < 6 { return ValError(ERR_VALUE) }
    c = ArgAt(args,count,0,0)
    settle = ArgDate(args,count,1,-1)
    first = ArgDate(args,count,2,-1)
    salvage = ArgAt(args,count,3,0)
    per = ArgAtInt(args,count,4,0)
    rate = ArgAt(args,count,5,0)
    basis = ArgBasis(args,count,6)
    if settle < 0 || first < 0 || basis < 0 || rate < 0 { return ValError(ERR_NUM) }
    one_rate: double = c * rate
    cost_delta: double = c - salvage
    f0rate: double = YearFracBasis(settle,first,basis) * rate * c
    full_periods: int = (int)((cost_delta - f0rate) / one_rate)
    result: double = 0
    if per == 0 {
        result = f0rate
    }
else if per <= full_periods {
        result = one_rate
    }
else if per == full_periods + 1 {
        result = cost_delta - one_rate * (double)full_periods - f0rate
    }
else {
        result = 0
    }
    return ValNumber(result)
}

FnAmordegrc :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    c: double
    settle: int
    first: int
    salvage: double
    per: int
    rate: double
    basis: int
    if count < 6 { return ValError(ERR_VALUE) }
    c = ArgAt(args,count,0,0)
    settle = ArgDate(args,count,1,-1)
    first = ArgDate(args,count,2,-1)
    salvage = ArgAt(args,count,3,0)
    per = ArgAtInt(args,count,4,0)
    rate = ArgAt(args,count,5,0)
    basis = ArgBasis(args,count,6)
    if settle < 0 || first < 0 || basis < 0 || rate < 0 { return ValError(ERR_NUM) }
    use_per: double = 1 / rate
    coeff: double = 0
    if use_per < 3 {
        coeff = 1
    }
else if use_per < 5 {
        coeff = 1.5
    }
else if use_per <= 6 {
        coeff = 2
    }
else {
        coeff = 2.5
    }
    frate: double = rate * coeff
    cost: double = c
    nrate: double = rint(YearFracBasis(settle,first,basis) * frate * cost)
    cost -= nrate
    rest: double = cost - salvage
    n: int = 0
    while n < per {
        nrate = rint(frate * cost)
        rest -= nrate
        if rest < 0 {
            if per - n <= 1 {
                return ValNumber(rint(cost / 2))
            }
            return ValNumber(0)
        }
        cost -= nrate
        n += 1
    }
    return ValNumber(nrate)
}

EuroRate :: (code: const char *) -> double {
    if strcmp(code,"ATS") == 0 { return 13.7603 }
    if strcmp(code,"BEF") == 0 { return 40.3399 }
    if strcmp(code,"DEM") == 0 { return 1.95583 }
    if strcmp(code,"ESP") == 0 { return 166.386 }
    if strcmp(code,"FIM") == 0 { return 5.94573 }
    if strcmp(code,"FRF") == 0 { return 6.55957 }
    if strcmp(code,"IEP") == 0 { return 0.787564 }
    if strcmp(code,"ITL") == 0 { return 1936.27 }
    if strcmp(code,"LUF") == 0 { return 40.3399 }
    if strcmp(code,"NLG") == 0 { return 2.20371 }
    if strcmp(code,"PTE") == 0 { return 200.482 }
    if strcmp(code,"EUR") == 0 { return 1.0 }
    return -1
}

FnEuroconvert :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    value: double
    from: [16] char = ""
    to: [16] char = ""
    full: int
    triang: int
    from_rate: double
    to_rate: double
    if count < 3 { return ValError(ERR_VALUE) }
    value = ArgAt(args,count,0,0)
    if TextArg(args,count,1,from,sizeof(from)) < 0 { return ValError(ERR_VALUE) }
    if TextArg(args,count,2,to,sizeof(to)) < 0 { return ValError(ERR_VALUE) }
    full = ArgAtInt(args,count,3,0)
    triang = ArgAtInt(args,count,4,1)
    from_rate = EuroRate(from)
    to_rate = EuroRate(to)
    if from_rate < 0 || to_rate < 0 { return ValError(ERR_VALUE) }
    in_eur: double = value / from_rate
    out: double = in_eur * to_rate
    return ValNumber(out)
}

FnEuro :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    return ValError(ERR_NA)
}

FnXnpv :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    groups: int
    rate: double
    v_start: int = 0
    v_len: int = 0
    d_start: int = 0
    d_len: int = 0
    total: double = 0
    i: int
    if count < 3 { return ValError(ERR_VALUE) }
    groups = ArgGroupCount(args,marks,count)
    rate = ArgAt(args,count,0,0)
    if groups < 2 { return ValError(ERR_VALUE) }
    GroupBounds(marks,count,1,&v_start,&v_len)
    GroupBounds(marks,count,2,&d_start,&d_len)
    if v_len != d_len { return ValError(ERR_NUM) }
    d0: double = CoerceNumber(&args[d_start])
    i = 0
    while i < v_len {
        if args[v_start + i].kind != VAL_FLOAT { return ValError(ERR_VALUE) }
        di: double = CoerceNumber(&args[d_start + i])
        total += args[v_start + i].number / Pow1p(rate,(di - d0) / 365)
        i += 1
    }
    return ValNumber(total)
}

FnXirr :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    groups: int
    v_start: int = 0
    v_len: int = 0
    d_start: int = 0
    d_len: int = 0
    guess: double = 0.1
    ok: int = 0
    i: int = 0
    if count < 2 { return ValError(ERR_VALUE) }
    groups = ArgGroupCount(args,marks,count)
    if groups < 2 { return ValError(ERR_VALUE) }
    GroupBounds(marks,count,0,&v_start,&v_len)
    GroupBounds(marks,count,1,&d_start,&d_len)
    if v_len != d_len { return ValError(ERR_NUM) }
    if v_len > 512 { return ValError(ERR_NUM) }
    if args[count - 1].from_range == 0 { guess = CoerceNumber(&args[count - 1]) }
    GS_CASH_N = v_len
    while i < v_len {
        GSV_A[i] = args[v_start + i].number
        GSD_A[i] = CoerceNumber(&args[d_start + i])
        i += 1
    }
    r: double = XirrGo(guess,&ok)
    if ok == 0 { return ValError(ERR_NUM) }
    return ValNumber(r)
}

FnDollarText :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    v: double
    decimals: double = 2
    out: [128] char = ""
    if count < 1 { return ValError(ERR_VALUE) }
    v = ArgAt(args,count,0,0)
    decimals = ArgAt(args,count,1,2)
    scaleleft: double = 1
    if decimals < 0 {
        scaleleft = FinPower(10.0,-decimals)
        v = (double)(long long)(v / scaleleft + (v < 0 ? -0.5 : 0.5)) * scaleleft
        decimals = 0
    }
    if decimals > 10 { decimals = 10 }
    tmp: [64] char = ""
    body: [96] char = ""
    snprintf(tmp,sizeof(tmp),"%.*f",(int)decimals,fabs(v))
    FormatWithPattern2(tmp,body,sizeof(body))
    if v < 0 {
        snprintf(out,sizeof(out),"(%s)",body)
    }
else {
        snprintf(out,sizeof(out),"%s",body)
    }
    return ValString(wb_strdup(out))
}

FormatWithPattern2 :: (digits: const char *, out: char *, cap: int) {
    dot: CString = strchr(digits,'.')
    int_len: int = dot != NULL ? (int)(dot - digits) : (int)strlen(digits)
    n: int = 0
    i: int = 0
    out[0] = '$'
    n = 1
    while i < int_len {
        if (int_len - i) % 3 == 0 && i > 0 && n + 1 < cap {
            out[n] = ','
            n += 1
        }
        if n + 1 < cap { out[n] = digits[i]; n += 1 }
        i += 1
    }
    if dot != NULL {
        i = 0
        while dot[i] != 0 && n + 1 < cap { out[n] = dot[i]; n += 1; i += 1 }
    }
    out[n] = 0
}


FnSum :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    if list.saw_error { return FirstError(args,count) }
    total: double = 0
    i: int = 0
    while i < list.count {
        total += list.data[i]
        i += 1
    }
    return ValNumber(total)
}

FnAverage :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    if list.saw_error { return FirstError(args,count) }
    if list.count == 0 { return ValError(ERR_DIV0) }
    total: double = 0
    i: int = 0
    while i < list.count {
        total += list.data[i]
        i += 1
    }
    return ValNumber(total / list.count)
}

FnCount :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    return ValNumber(list.count)
}

FnCounta :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    n: int = 0
    i: int = 0
    while i < count {
        if args[i].kind != VAL_EMPTY { n += 1 }
        i += 1
    }
    return ValNumber(n)
}

FnCountblank :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    n: int = 0
    i: int = 0
    while i < count {
        if args[i].kind == VAL_EMPTY { n += 1 }
        else if args[i].kind == VAL_STRING && args[i].text != NULL && args[i].text[0] == 0 { n += 1 }
        i += 1
    }
    return ValNumber(n)
}

FnMinMax :: (st: EvalState *, args: Val *, count: int, marks: int *, want_max: int) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    if list.saw_error { return FirstError(args,count) }
    if list.count == 0 { return ValNumber(0) }
    best: double = list.data[0]
    i: int = 1
    while i < list.count {
        if (want_max) {
            if list.data[i] > best { best = list.data[i] }
        }
else {
            if list.data[i] < best { best = list.data[i] }
        }
        i += 1
    }
    return ValNumber(best)
}

FnProduct :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    if list.saw_error { return FirstError(args,count) }
    total: double = 1
    i: int = 0
    while i < list.count {
        total *= list.data[i]
        i += 1
    }
    return ValNumber(total)
}

FnSumSq :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    if list.saw_error { return FirstError(args,count) }
    total: double = 0
    i: int = 0
    while i < list.count {
        total += list.data[i] * list.data[i]
        i += 1
    }
    return ValNumber(total)
}

SortDoubles :: (data: double *, n: int) {
    i: int = 1
    while i < n {
        x: double = data[i]
        j: int = i - 1
        while j >= 0 && data[j] > x {
            data[j + 1] = data[j]
            j -= 1
        }
        data[j + 1] = x
        i += 1
    }
}

FnMedian :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    if list.saw_error { return FirstError(args,count) }
    if list.count == 0 { return ValError(ERR_NUM) }
    SortDoubles(list.data,list.count)
    mid: int = list.count / 2
    if list.count % 2 != 0 { return ValNumber(list.data[mid]) }
    return ValNumber((list.data[mid - 1] + list.data[mid]) / 2.0)
}

FnVarOld :: (st: EvalState *, args: Val *, count: int, marks: int *, sample: int) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    if list.saw_error { return FirstError(args,count) }
    if (sample && list.count < 2) || (!sample && list.count < 1) { return ValError(ERR_DIV0) }
    total: double = 0
    i: int = 0
    while i < list.count {
        total += list.data[i]
        i += 1
    }
    mean: double = total / list.count
    sq: double = 0
    i = 0
    while i < list.count {
        d: double = list.data[i] - mean
        sq += d * d
        i += 1
    }
    div: double = sample ? list.count - 1 : list.count
    return ValNumber(sq / div)
}

FnStdev :: (st: EvalState *, args: Val *, count: int, marks: int *, sample: int) -> Val {
    v: Val = FnVarOld(st,args,count,marks,sample)
    if v.kind == VAL_ERROR { return v }
    return ValNumber(sqrt(v.number))
}

FnLargeSmall :: (st: EvalState *, args: Val *, count: int, marks: int *, large: int) -> Val {
    list: NumList = {0}
    k: double = 0
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if args[count - 1].kind == VAL_ERROR { return ValError(args[count - 1].err) }
    CollectNumbers(args,count - 1,&list)
    k = ArgNumberAt(args,count,count - 1)
    if k < 1 || k != (double)(long long)k || (int)k > list.count { return ValError(ERR_NUM) }
    SortDoubles(list.data,list.count)
    idx: int = large ? list.count - (int)k : (int)k - 1
    return ValNumber(list.data[idx])
}

FnIf :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    cond: int = 0
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    cond = CoerceBool(&args[0])
    if cond < 0 { return ValError(ERR_VALUE) }
    if (cond) { return ValCopy(&args[1]) }
    if count >= 3 { return ValCopy(&args[2]) }
    return ValBool(0)
}

FnIfError :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValCopy(&args[1]) }
    return ValCopy(&args[0])
}

FnIfNa :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR && args[0].err == ERR_NA { return ValCopy(&args[1]) }
    return ValCopy(&args[0])
}

FnNot :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    flag: int = 0
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    flag = CoerceBool(&args[0])
    if flag < 0 { return ValError(ERR_VALUE) }
    return ValBool(flag == 0)
}

FnAndOr :: (st: EvalState *, args: Val *, count: int, marks: int *, is_and: int) -> Val {
    seen: int = 0
    result: int = is_and
    i: int = 0
    while i < count {
        v: Val * = &args[i]
        if v->kind == VAL_ERROR { return ValError(v->err) }
        if v->kind == VAL_FLOAT || v->kind == VAL_BOOL {
            seen = 1
            flag: int = v->number != 0
            if (is_and) { result = result && flag }
else { result = result || flag }
        }
        i += 1
    }
    if seen == 0 { return ValError(ERR_VALUE) }
    return ValBool(result)
}

FnXor :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    parity: int = 0
    i: int = 0
    while i < count {
        if args[i].kind == VAL_ERROR { return ValError(args[i].err) }
        if args[i].kind == VAL_FLOAT || args[i].kind == VAL_BOOL {
            if args[i].number != 0 { parity += 1 }
        }
        i += 1
    }
    return ValBool(parity % 2 != 0)
}

FnIsError :: (st: EvalState *, args: Val *, count: int, marks: int *, include_na: int) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR {
        if !include_na && args[0].err == ERR_NA { return ValBool(0) }
        return ValBool(1)
    }
    return ValBool(0)
}

FnIsType :: (st: EvalState *, args: Val *, count: int, marks: int *, kind: int) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    return ValBool(args[0].kind == kind)
}

FnN :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_FLOAT || args[0].kind == VAL_BOOL { return ValNumber(args[0].number) }
    return ValNumber(0)
}

TextArg :: (args: Val *, count: int, index: int, out: char *, cap: int) -> int {
    if index >= count { return 0 }
    if args[index].kind == VAL_ERROR { return -1 }
    CoerceText(&args[index],out,cap)
    return 1
}

FnLen :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    text: [WB_TEXT_MAX * 2] char = ""
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    return ValNumber(strlen(text))
}

FnUpper :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    text: [WB_TEXT_MAX * 2] char = ""
    i: int = 0
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    i = 0
    while text[i] != 0 {
        text[i] = (char)toupper((unsigned char)text[i])
        i += 1
    }
    return ValString(wb_strdup(text))
}

FnLower :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    text: [WB_TEXT_MAX * 2] char = ""
    i: int = 0
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    i = 0
    while text[i] != 0 {
        text[i] = (char)tolower((unsigned char)text[i])
        i += 1
    }
    return ValString(wb_strdup(text))
}

FnTrim :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    src: [WB_TEXT_MAX * 2] char = ""
    out: [WB_TEXT_MAX * 2] char = ""
    n: int = 0
    pending_space: int = 0
    i: int = 0
    if TextArg(args,count,0,src,sizeof(src)) < 0 { return ValError(ERR_VALUE) }
    i = 0
    while src[i] != 0 {
        if src[i] == ' ' {
            if n > 0 { pending_space = 1 }
        }
else {
            if pending_space && n > 0 {
                if n < (int)sizeof(out) - 1 { out[n] = ' '; n += 1 }
                pending_space = 0
            }
            if n < (int)sizeof(out) - 1 { out[n] = src[i]; n += 1 }
        }
        i += 1
    }
    out[n] = 0
    return ValString(wb_strdup(out))
}

FnLeftRight :: (st: EvalState *, args: Val *, count: int, marks: int *, left: int) -> Val {
    text: [WB_TEXT_MAX * 2] char = ""
    n: double = 1
    len: int = 0
    take: int = 0
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    if count >= 2 {
        if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
        n = CoerceNumber(&args[1])
    }
    if n < 0 { return ValError(ERR_VALUE) }
    len = (int)strlen(text)
    take = (int)n
    if take > len { take = len }
    if (left) { return ValString(wb_strndup(text,take)) }
    return ValString(wb_strndup(text + len - take,take))
}

FnMid :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    text: [WB_TEXT_MAX * 2] char = ""
    start: double = 0
    n: double = 0
    len: int = 0
    take: int = 0
    if count < 3 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
    if args[2].kind == VAL_ERROR { return ValError(args[2].err) }
    start = CoerceNumber(&args[1])
    n = CoerceNumber(&args[2])
    if start < 1 || n < 0 { return ValError(ERR_VALUE) }
    len = (int)strlen(text)
    if start - 1 >= len { return ValString(wb_strdup("")) }
    take = (int)n
    if start - 1 + take > len { take = len - (int)start + 1 }
    return ValString(wb_strndup(text + (int)start - 1,take))
}

FnRepeatText :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    text: [WB_TEXT_MAX] char = ""
    out: [WB_TEXT_MAX * 2] char = ""
    n: double = 0
    i: int = 0
    if count < 2 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
    n = CoerceNumber(&args[1])
    if n < 0 { return ValError(ERR_VALUE) }
    if (int)n * (int)strlen(text) >= (int)sizeof(out) { return ValError(ERR_VALUE) }
    i = 0
    while i < (int)n {
        strcat(out,text)
        i += 1
    }
    return ValString(wb_strdup(out))
}

FnConcatenate :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    out: [WB_TEXT_MAX * 4] char = ""
    piece: [WB_TEXT_MAX * 2] char = ""
    i: int = 0
    while i < count {
        if args[i].kind == VAL_ERROR { return ValError(args[i].err) }
        CoerceText(&args[i],piece,sizeof(piece))
        if strlen(out) + strlen(piece) >= sizeof(out) { return ValError(ERR_VALUE) }
        strcat(out,piece)
        i += 1
    }
    return ValString(wb_strdup(out))
}

FnFind :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    needle: [WB_TEXT_MAX] char = ""
    hay: [WB_TEXT_MAX * 2] char = ""
    start: double = 1
    hit: CString = 0
    if count < 2 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,needle,sizeof(needle)) < 0 { return ValError(ERR_VALUE) }
    if TextArg(args,count,1,hay,sizeof(hay)) < 0 { return ValError(ERR_VALUE) }
    if count >= 3 {
        if args[2].kind == VAL_ERROR { return ValError(args[2].err) }
        start = CoerceNumber(&args[2])
    }
    if start < 1 || start - 1 > (double)strlen(hay) { return ValError(ERR_VALUE) }
    hit = strstr(hay + (int)start - 1,needle)
    if hit == NULL { return ValError(ERR_VALUE) }
    return ValNumber(hit - hay + 1)
}

FnSearch :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    needle: [WB_TEXT_MAX] char = ""
    hay: [WB_TEXT_MAX * 2] char = ""
    start: double = 1
    i: int = 0
    if count < 2 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,needle,sizeof(needle)) < 0 { return ValError(ERR_VALUE) }
    if TextArg(args,count,1,hay,sizeof(hay)) < 0 { return ValError(ERR_VALUE) }
    if count >= 3 {
        if args[2].kind == VAL_ERROR { return ValError(args[2].err) }
        start = CoerceNumber(&args[2])
    }
    if start < 1 || start - 1 > (double)strlen(hay) { return ValError(ERR_VALUE) }
    i = (int)start - 1
    while hay[i] != 0 {
        j: int = 0
        while needle[j] != 0 {
            if hay[i + j] == 0 { break }
            if tolower((unsigned char)hay[i + j]) != tolower((unsigned char)needle[j]) { break }
            j += 1
        }
        if needle[j] == 0 { return ValNumber(i + 1) }
        i += 1
    }
    return ValError(ERR_VALUE)
}

FnSubstitute :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    text: [WB_TEXT_MAX * 2] char = ""
    old: [WB_TEXT_MAX] char = ""
    new: [WB_TEXT_MAX] char = ""
    out: [WB_TEXT_MAX * 4] char = ""
    n: int = 0
    i: int = 0
    which: int = -1
    replaced: int = 0
    if count < 3 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    if TextArg(args,count,1,old,sizeof(old)) < 0 { return ValError(ERR_VALUE) }
    if TextArg(args,count,2,new,sizeof(new)) < 0 { return ValError(ERR_VALUE) }
    if count >= 4 {
        if args[3].kind == VAL_ERROR { return ValError(args[3].err) }
        which = (int)CoerceNumber(&args[3])
        if which < 1 { return ValError(ERR_VALUE) }
    }
    if old[0] == 0 { return ValString(wb_strdup(text)) }
    while text[i] != 0 {
        if strncmp(text + i,old,strlen(old)) == 0 {
            replaced += 1
            if which < 0 || replaced == which {
                j: int = 0
                while new[j] != 0 && n < (int)sizeof(out) - 1 { out[n] = new[j]; n += 1; j += 1 }
                i += (int)strlen(old)
                continue
            }
        }
        if n < (int)sizeof(out) - 1 { out[n] = text[i]; n += 1 }
        i += 1
    }
    out[n] = 0
    return ValString(wb_strdup(out))
}

FnExact :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    a: [WB_TEXT_MAX * 2] char = ""
    b: [WB_TEXT_MAX * 2] char = ""
    if count < 2 { return ValError(ERR_VALUE) }
    if TextArg(args,count,0,a,sizeof(a)) < 0 { return ValError(ERR_VALUE) }
    if TextArg(args,count,1,b,sizeof(b)) < 0 { return ValError(ERR_VALUE) }
    return ValBool(strcmp(a,b) == 0)
}

FnChar :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    code: int = 0
    out: [8] char = ""
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    code = (int)CoerceNumber(&args[0])
    if code < 1 || code > 255 { return ValError(ERR_VALUE) }
    out[0] = (char)code
    return ValString(wb_strdup(out))
}

FnCode :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    text: [WB_TEXT_MAX * 2] char = ""
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    if text[0] == 0 { return ValError(ERR_VALUE) }
    return ValNumber((unsigned char)text[0])
}

FnValue :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    text: [WB_TEXT_MAX * 2] char = ""
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    if !TextLooksNumeric(text) { return ValError(ERR_VALUE) }
    return ValNumber(strtod(text,NULL))
}

FnT :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_STRING { return ValCopy(&args[0]) }
    return ValString(wb_strdup(""))
}

FormatThousands :: (digits: const char *, out: char *, cap: int) {
    dot: CString = strchr(digits,'.')
    int_len: int = dot != NULL ? (int)(dot - digits) : (int)strlen(digits)
    negative: int = digits[0] == '-'
    start: int = negative ? 1 : 0
    n: int = 0
    i: int = start
    if negative && cap > 1 { out[0] = '-'; n = 1 }
    while i < int_len {
        if (int_len - i) % 3 == 0 && i > start && n + 1 < cap {
            out[n] = ','
            n += 1
        }
        if n + 1 < cap { out[n] = digits[i]; n += 1 }
        i += 1
    }
    if dot != NULL {
        i = 0
        while dot[i] != 0 && n + 1 < cap { out[n] = dot[i]; n += 1; i += 1 }
    }
    out[n] = 0
}

FormatWithPattern :: (value: double, fmt: const char *, out: char *, cap: int) {
    percent: int = 0
    decimals: int = -1
    comma: int = 0
    i: int = 0
    while fmt[i] != 0 {
        if fmt[i] == '%' { percent = 1 }
        if fmt[i] == ',' { comma = 1 }
        if fmt[i] == '.' {
            decimals = 0
            j: int = i + 1
            while fmt[j] >= '0' && fmt[j] <= '9' { decimals += 1; j += 1 }
        }
        i += 1
    }
    v: double = percent ? value * 100.0 : value
    if decimals < 0 { decimals = 0 }
    tmp: [64] char = ""
    snprintf(tmp,sizeof(tmp),"%.*f",decimals,v)
    if (comma) {
        FormatThousands(tmp,out,cap)
    }
else {
        snprintf(out,cap,"%s",tmp)
    }
    if (percent) {
        len: int = (int)strlen(out)
        if len + 1 < cap {
            out[len] = '%'
            out[len + 1] = 0
        }
    }
}

FnText :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    fmt: [WB_TEXT_MAX] char = ""
    out: [WB_TEXT_MAX * 2] char = ""
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if TextArg(args,count,1,fmt,sizeof(fmt)) < 0 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_STRING { return ValCopy(&args[0]) }
    FormatWithPattern(CoerceNumber(&args[0]),fmt,out,sizeof(out))
    return ValString(wb_strdup(out))
}

DaysFromCivil :: (y: int, m: int, d: int) -> int {
    yy: int = m <= 2 ? y - 1 : y
    era: int = 0
    yoe: int = 0
    mp: int = (m + 9) % 12
    doy: int = (153 * mp + 2) / 5 + d - 1
    doe: int = 0
    if yy >= 0 { era = yy / 400 }
else { era = (yy - 399) / 400 }
    yoe = yy - era * 400
    doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

CivilFromDays :: (z_in: int, y: int *, m: int *, d: int *) {
    z: int = z_in + 719468
    era: int = 0
    doe: int = 0
    yoe: int = 0
    cy: int = 0
    doy: int = 0
    cm: int = 0
    if z >= 0 { era = z / 146097 }
else { era = (z - 146096) / 146097 }
    doe = z - era * 146097
    yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    cy = yoe + era * 400
    doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    cm = (5 * doy + 2) / 153
    d[0] = doy - (153 * cm + 2) / 5 + 1
    m[0] = cm + 3
    if m[0] > 12 { m[0] -= 12 }
    y[0] = cy + (m[0] <= 2 ? 1 : 0)
}


SerialEpoch :: () -> int {
    return DaysFromCivil(1899,12,30)
}

FnDate :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    y: int = 0
    m: int = 0
    d: int = 0
    i: int = 0
    if count < 3 { return ValError(ERR_VALUE) }
    while i < 3 {
        if args[i].kind == VAL_ERROR { return ValError(args[i].err) }
        i += 1
    }
    y = (int)CoerceNumber(&args[0])
    m = (int)CoerceNumber(&args[1])
    d = (int)CoerceNumber(&args[2])
    if y >= 0 && y < 100 { y += 1900 }
    if m < 1 || m > 12 || d < 1 || d > 31 { return ValError(ERR_NUM) }
    serial: int = DaysFromCivil(y,m,d) - SerialEpoch()
    if serial < 61 { serial -= 1 }
    return ValNumber(serial)
}

DatePart :: (args: Val *, count: int, part: int) -> Val {
    serial: int = 0
    days: int = 0
    y: int = 0
    m: int = 0
    d: int = 0
    dow: int = 0
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    serial = (int)CoerceNumber(&args[0])
    days = serial + SerialEpoch()
    CivilFromDays(days,&y,&m,&d)
    if part == 0 { return ValNumber(y) }
    if part == 1 { return ValNumber(m) }
    if part == 2 { return ValNumber(d) }
    dow = ((days % 7) + 4) % 7 + 1
    if dow < 1 { dow += 7 }
    return ValNumber(dow)
}

FnTime :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    total: double = 0
    if count < 3 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
    if args[2].kind == VAL_ERROR { return ValError(args[2].err) }
    total = (CoerceNumber(&args[0]) * 3600.0 + CoerceNumber(&args[1]) * 60.0 + CoerceNumber(&args[2])) / 86400.0
    while total >= 1 { total -= 1 }
    while total < 0 { total += 1 }
    return ValNumber(total)
}

TimePart :: (args: Val *, count: int, part: int) -> Val {
    frac: double = 0
    seconds: double = 0
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    frac = CoerceNumber(&args[0])
    while frac >= 1 { frac -= 1 }
    while frac < 0 { frac += 1 }
    seconds = frac * 86400.0
    if part == 0 { return ValNumber((int)(seconds / 3600.0)) }
    if part == 1 { return ValNumber(((int)(seconds / 60.0)) % 60) }
    return ValNumber((int)seconds % 60)
}

ParseIsoDate :: (text: const char *, y: int *, m: int *, d: int *) -> int {
    pos: int = 0
    parts: [3] int = {0,0,0}
    n: int = 0
    while text[pos] != 0 && n < 3 {
        if text[pos] == '-' || text[pos] == '/' {
            pos += 1
            continue
        }
        if !isdigit((unsigned char)text[pos]) { return 0 }
        value: int = 0
        while isdigit((unsigned char)text[pos]) {
            value = value * 10 + (text[pos] - '0')
            pos += 1
        }
        parts[n] = value
        n += 1
    }
    if n != 3 { return 0 }
    if parts[0] > 31 {
        y[0] = parts[0]
        m[0] = parts[1]
        d[0] = parts[2]
    }
else {
        y[0] = parts[2]
        m[0] = parts[0]
        d[0] = parts[1]
    }
    return 1
}

FnDateValue :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    text: [WB_TEXT_MAX] char = ""
    y: int = 0
    m: int = 0
    d: int = 0
    if TextArg(args,count,0,text,sizeof(text)) < 0 { return ValError(ERR_VALUE) }
    if ParseIsoDate(text,&y,&m,&d) { return ValNumber(DaysFromCivil(y,m,d) - SerialEpoch()) }
    return ValError(ERR_VALUE)
}

FnToday :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    now: time_t = time(NULL)
    return ValNumber((double)(now / 86400) + 25569.0)
}

FnNow :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    now: time_t = time(NULL)
    return ValNumber((double)now / 86400.0 + 25569.0)
}

FnEdate :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    total: int = 0
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
    serial: int = (int)CoerceNumber(&args[0])
    months: int = (int)CoerceNumber(&args[1])
    days: int = serial + SerialEpoch()
    y: int = 0
    m: int = 0
    d: int = 0
    CivilFromDays(days,&y,&m,&d)
    total = y * 12 + (m - 1) + months
    y = total / 12
    m = total % 12 + 1
    if d > DaysFromCivil(y,m + 1,1) - DaysFromCivil(y,m,1) {
        d = DaysFromCivil(y,m + 1,1) - DaysFromCivil(y,m,1)
    }
    return ValNumber(DaysFromCivil(y,m,d) - SerialEpoch())
}

FnEomonth :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    total: int = 0
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    serial: int = (int)CoerceNumber(&args[0])
    months: int = 0
    if count >= 2 {
        if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
        months = (int)CoerceNumber(&args[1])
    }
    days: int = serial + SerialEpoch()
    y: int = 0
    m: int = 0
    d: int = 0
    CivilFromDays(days,&y,&m,&d)
    total = y * 12 + (m - 1) + months
    y = total / 12
    m = total % 12 + 1
    return ValNumber(DaysFromCivil(y,m + 1,1) - 1 - SerialEpoch())
}

FnDatedif :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    unit: [16] char = ""
    if count < 3 { return ValError(ERR_VALUE) }
    if TextArg(args,count,2,unit,sizeof(unit)) < 0 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
    a: int = (int)CoerceNumber(&args[0])
    b: int = (int)CoerceNumber(&args[1])
    if b < a { return ValError(ERR_NUM) }
    da: int = a + SerialEpoch()
    db: int = b + SerialEpoch()
    ya: int = 0
    ma: int = 0
    dla: int = 0
    yb: int = 0
    mb: int = 0
    dlb: int = 0
    CivilFromDays(da,&ya,&ma,&dla)
    CivilFromDays(db,&yb,&mb,&dlb)
    if strcasecmp(unit,"d") == 0 { return ValNumber(b - a) }
    if strcasecmp(unit,"y") == 0 {
        years: int = yb - ya
        if mb < ma || (mb == ma && dlb < dla) { years -= 1 }
        return ValNumber(years)
    }
    if strcasecmp(unit,"m") == 0 {
        months: int = (yb - ya) * 12 + (mb - ma)
        if dlb < dla { months -= 1 }
        return ValNumber(months)
    }
    if strcasecmp(unit,"ym") == 0 {
        months: int = mb - ma
        if dlb < dla { months -= 1 }
        if months < 0 { months += 12 }
        return ValNumber(months)
    }
    if strcasecmp(unit,"md") == 0 {
        if dlb >= dla { return ValNumber(dlb - dla) }
        pm: int = mb - 1
        py: int = yb
        dim: int = 0
        if pm == 0 { pm = 12; py -= 1 }
        dim = DaysFromCivil(py,pm + 1,1) - DaysFromCivil(py,pm,1)
        return ValNumber(dlb + dim - dla)
    }
    return ValError(ERR_VALUE)
}

FnDays360 :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
    a: int = (int)CoerceNumber(&args[0])
    b: int = (int)CoerceNumber(&args[1])
    european: int = 0
    ya: int = 0
    ma: int = 0
    da: int = 0
    yb: int = 0
    mb: int = 0
    db: int = 0
    if count >= 3 {
        if args[2].kind == VAL_ERROR { return ValError(args[2].err) }
        if args[2].kind == VAL_STRING {
            method: [16] char = ""
            CoerceText(&args[2],method,sizeof(method))
            european = strcasecmp(method,"TRUE") == 0
        }
else {
            european = CoerceNumber(&args[2]) != 0
        }
    }
    CivilFromDays(a + SerialEpoch(),&ya,&ma,&da)
    CivilFromDays(b + SerialEpoch(),&yb,&mb,&db)
    if (european) {
        if da == 31 { da = 30 }
        if db == 31 { db = 30 }
    }
else {
        last_feb_a: int = ma == 2 && da == DaysFromCivil(ya,3,1) - DaysFromCivil(ya,2,1)
        if (last_feb_a) {
            da = 30
        }
else if da >= 30 {
            da = 30
        }
        if db >= 30 && da == 30 { db = 30 }
    }
    return ValNumber((yb - ya) * 360 + (mb - ma) * 30 + (db - da))
}

FnRound :: (st: EvalState *, args: Val *, count: int, marks: int *, mode: int) -> Val {
    digits: double = 0
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if count >= 2 {
        if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
        digits = CoerceNumber(&args[1])
    }
    v: double = CoerceNumber(&args[0])
    if v >= 1e307 { return ValError(ERR_VALUE) }
    scale: double = pow(10.0,digits)
    scaled: double = v * scale
    r: double = 0
    if mode == 0 {
        if scaled >= 0 { r = floor(scaled + 0.5) }
        else { r = ceil(scaled - 0.5) }
    }
else if mode == 1 {
        if scaled >= 0 { r = floor(scaled) }
        else { r = ceil(scaled) }
    }
else {
        if scaled >= 0 { r = ceil(scaled) }
        else { r = floor(scaled) }
    }
    return ValNumber(r / scale)
}

FnInt :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    v: double = CoerceNumber(&args[0])
    if v >= 1e307 { return ValError(ERR_VALUE) }
    return ValNumber(floor(v))
}

FnMod :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
    a: double = CoerceNumber(&args[0])
    b: double = CoerceNumber(&args[1])
    if b == 0 { return ValError(ERR_DIV0) }
    return ValNumber(a - b * floor(a / b))
}

FnAbs :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    v: double = CoerceNumber(&args[0])
    if v >= 1e307 { return ValError(ERR_VALUE) }
    return ValNumber(fabs(v))
}

FnSign :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    v: double = CoerceNumber(&args[0])
    if v >= 1e307 { return ValError(ERR_VALUE) }
    if v > 0 { return ValNumber(1) }
    if v < 0 { return ValNumber(-1) }
    return ValNumber(0)
}

DomainOk :: (code: int, v: double) -> int {
    if code == 0 && v < 0 { return 0 }
    if (code == 2 || code == 3 || code == 13) && v <= 0 { return 0 }
    if (code == 7 || code == 8) && (v < -1 || v > 1) { return 0 }
    return 1
}

ApplyMathOne :: (code: int, v: double) -> double {
    if code == 0 { return sqrt(v) }
    if code == 1 { return exp(v) }
    if code == 2 { return log(v) }
    if code == 3 { return log10(v) }
    if code == 4 { return sin(v) }
    if code == 5 { return cos(v) }
    if code == 6 { return tan(v) }
    if code == 7 { return asin(v) }
    if code == 8 { return acos(v) }
    if code == 9 { return atan(v) }
    if code == 10 { return floor(v) }
    if code == 11 { return ceil(v) }
    if code == 12 { return expm1(v) }
    if code == 13 { return log1p(v) }
    if code == 14 { return sinh(v) }
    if code == 15 { return cosh(v) }
    if code == 16 { return tanh(v) }
    return 0
}

FnMathOne :: (st: EvalState *, args: Val *, count: int, marks: int *, code: int) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    v: double = CoerceNumber(&args[0])
    if v >= 1e307 { return ValError(ERR_VALUE) }
    if !DomainOk(code,v) { return ValError(ERR_NUM) }
    r: double = ApplyMathOne(code,v)
    if r != r { return ValError(ERR_NUM) }
    return ValNumber(r)
}

FnPower :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
    a: double = CoerceNumber(&args[0])
    b: double = CoerceNumber(&args[1])
    if a >= 1e307 || b >= 1e307 { return ValError(ERR_VALUE) }
    r: double = pow(a,b)
    if r != r { return ValError(ERR_NUM) }
    return ValNumber(r)
}

FnAtan2 :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
    y: double = CoerceNumber(&args[0])
    x: double = CoerceNumber(&args[1])
    if x == 0 && y == 0 { return ValError(ERR_DIV0) }
    return ValNumber(atan2(y,x))
}

FnFact :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    n: double = CoerceNumber(&args[0])
    if n < 0 || n != (double)(long long)n || n > 170 { return ValError(ERR_NUM) }
    r: double = 1
    i: int = 2
    while i <= (int)n {
        r *= i
        i += 1
    }
    return ValNumber(r)
}

FnFactDouble :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    n: int = (int)CoerceNumber(&args[0])
    if n < -1 || n > 300 { return ValError(ERR_NUM) }
    if n <= 1 { return ValNumber(1) }
    r: double = 1
    i: int = n
    while i >= 2 {
        r *= i
        i -= 2
    }
    return ValNumber(r)
}

GcdImpl :: (a: int, b: int) -> int {
    while b != 0 {
        t: int = a % b
        a = b
        b = t
    }
    return a < 0 ? -a : a
}

FnGcd :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    if list.count == 0 { return ValError(ERR_VALUE) }
    g: int = (int)list.data[0]
    i: int = 1
    while i < list.count {
        g = GcdImpl(g,(int)list.data[i])
        i += 1
    }
    return ValNumber(g)
}

FnLcm :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    list: NumList = {0}
    CollectNumbers(args,count,&list)
    if list.count == 0 { return ValError(ERR_VALUE) }
    l: int = (int)list.data[0]
    i: int = 1
    while i < list.count {
        g: int = GcdImpl(l,(int)list.data[i])
        if g == 0 { return ValError(ERR_NUM) }
        l = l / g * (int)list.data[i]
        i += 1
    }
    return ValNumber(l < 0 ? -l : l)
}

FnCombin :: (st: EvalState *, args: Val *, count: int, marks: int *, with_repeats: int) -> Val {
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
    n: int = (int)CoerceNumber(&args[0])
    k: int = (int)CoerceNumber(&args[1])
    r: double = 1
    i: int = 0
    if n < 0 || k < 0 { return ValError(ERR_NUM) }
    if (with_repeats) {
        if k > n { return ValError(ERR_NUM) }
        i = 0
        while i < k {
            r = r * (n + k - 1 - i) / (i + 1)
            i += 1
        }
        return ValNumber(r)
    }
    if k > n { return ValError(ERR_NUM) }
    i = 0
    while i < k {
        r = r * (n - i) / (i + 1)
        i += 1
    }
    return ValNumber(r)
}

FnDegreesRadians :: (st: EvalState *, args: Val *, count: int, marks: int *, to_deg: int) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    v: double = CoerceNumber(&args[0])
    if v >= 1e307 { return ValError(ERR_VALUE) }
    if (to_deg) { return ValNumber(v * 180.0 / 3.14159265358979323846) }
    return ValNumber(v * 3.14159265358979323846 / 180.0)
}

FnChoose :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    n: int = (int)CoerceNumber(&args[0])
    if n < 1 || n >= count { return ValError(ERR_VALUE) }
    return ValCopy(&args[n])
}

ColNameText :: (col: int, out: char *) -> int {
    c: int = col + 1
    n: int = 0
    buf: [8] char = ""
    i: int = 0
    while c > 0 {
        rem: int = (c - 1) % 26
        buf[n] = (char)('A' + rem)
        n += 1
        c = (c - 1) / 26
    }
    while i < n {
        out[i] = buf[n - 1 - i]
        i += 1
    }
    out[n] = 0
    return n
}

ParseR1C1Index :: (text: const char *, pos: int *, out: int *) -> int {
    neg: int = 0
    val: int = 0
    p: int = pos[0]
    if text[p] == '[' {
        p += 1
        if text[p] == '-' { neg = 1; p += 1 }
        if text[p] < '0' || text[p] > '9' { return -1 }
        while text[p] >= '0' && text[p] <= '9' {
            val = val * 10 + (text[p] - '0')
            p += 1
        }
        if text[p] != ']' { return -1 }
        pos[0] = p + 1
        out[0] = neg != 0 ? -val : val
        return 1
    }
    if text[p] < '0' || text[p] > '9' { return -1 }
    while text[p] >= '0' && text[p] <= '9' {
        val = val * 10 + (text[p] - '0')
        p += 1
    }
    pos[0] = p
    out[0] = val - 1
    return 0
}

SheetNameNeedsQuote :: (name: const char *) -> int {
    i: int = 1
    nletters: int = 0
    ndigits: int = 0
    c0: int = name[0]
    if c0 == 0 { return 0 }
    if (c0 >= 'A' && c0 <= 'Z') || (c0 >= 'a' && c0 <= 'z') {
        nletters = 1
        ndigits = 0
    }
else if c0 == '_' || c0 == '.' {
        nletters = -1
        ndigits = -1
    }
else {
        return 1
    }
    while name[i] != 0 {
        c: int = name[i]
        if (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') {
            if ndigits == 0 { nletters += 1 }
        }
else if c >= '0' && c <= '9' {
            if ndigits >= 0 { ndigits += 1 }
        }
else if c == '.' || c == '_' {
            nletters = -1
            ndigits = -1
        }
else {
            return 1
        }
        i += 1
    }
    if ndigits > 0 {
        probe: int = 0
        col: int = ParseColLetters(name,&probe)
        if col >= 0 {
            while name[probe] == '0' { probe += 1 }
            if ParseRowDigits(name,&probe) >= 0 && name[probe] == 0 { return 1 }
        }
    }
    return 0
}

SheetPrefixText :: (name: const char *, out: char *) -> int {
    n: int = 0
    i: int = 0
    if name[0] == 0 {
        out[0] = '!'
        out[1] = 0
        return 1
    }
    if SheetNameNeedsQuote(name) != 0 {
        out[0] = '\''
        n = 1
        while name[i] != 0 {
            if name[i] == '\'' && n < 250 { out[n] = '\''; n += 1 }
            if n < 250 { out[n] = name[i]; n += 1 }
            i += 1
        }
        out[n] = '\''
        n += 1
    }
else {
        while name[i] != 0 && n < 250 {
            out[n] = name[i]
            n += 1
            i += 1
        }
    }
    out[n] = '!'
    n += 1
    out[n] = 0
    return n
}

FnAddress :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    row: int = 0
    col: int = 0
    absnum: int = 1
    a1: int = 1
    col_relative: int = 0
    row_relative: int = 0
    out: [512] char = ""
    letters: [8] char = ""
    prefix: [256] char = ""
    rbuf: [16] char = ""
    cbuf: [16] char = ""
    if count < 2 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
    row = (int)CoerceNumber(&args[0])
    col = (int)CoerceNumber(&args[1])
    if count >= 3 {
        if args[2].kind == VAL_ERROR { return ValError(args[2].err) }
        absnum = (int)CoerceNumber(&args[2])
    }
    if count >= 4 {
        if args[3].kind == VAL_ERROR { return ValError(args[3].err) }
        a1 = CoerceNumber(&args[3]) != 0 ? 1 : 0
    }
    if absnum == 1 || absnum == 5 { col_relative = 0; row_relative = 0 }
    else if absnum == 2 || absnum == 6 { col_relative = 1; row_relative = 0 }
    else if absnum == 3 || absnum == 7 { col_relative = 0; row_relative = 1 }
    else if absnum == 4 || absnum == 8 { col_relative = 1; row_relative = 1 }
    else { return ValError(ERR_VALUE) }
    if col < 1 || col > WB_MAX_COLS { return ValError(ERR_VALUE) }
    if row < 1 || row > WB_MAX_ROWS { return ValError(ERR_VALUE) }
    if count >= 5 {
        label: [256] char = ""
        CoerceText(&args[4],label,sizeof(label))
        SheetPrefixText(label,prefix)
    }
    if a1 != 0 {
        ColNameText(col - 1,letters)
        if col_relative == 0 && row_relative == 0 {
            snprintf(out,sizeof(out),"%s$%s$%d",prefix,letters,row)
        }
        else if col_relative != 0 && row_relative == 0 {
            snprintf(out,sizeof(out),"%s%s$%d",prefix,letters,row)
        }
        else if col_relative == 0 && row_relative != 0 {
            snprintf(out,sizeof(out),"%s$%s%d",prefix,letters,row)
        }
        else {
            snprintf(out,sizeof(out),"%s%s%d",prefix,letters,row)
        }
    }
else {
        if row_relative != 0 {
            snprintf(rbuf,sizeof(rbuf),"R[%d]",row)
        }
else {
            snprintf(rbuf,sizeof(rbuf),"R%d",row)
        }
        if col_relative != 0 {
            snprintf(cbuf,sizeof(cbuf),"C[%d]",col)
        }
else {
            snprintf(cbuf,sizeof(cbuf),"C%d",col)
        }
        snprintf(out,sizeof(out),"%s%s%s",prefix,rbuf,cbuf)
    }
    return ValString(wb_strdup(out))
}

FnAreas :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    gx: int = 0
    gl: int = 0
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if GroupBounds(marks,count,0,&gx,&gl) != 0 && gx == 0 && gl == count && st->call_refs[0].kind != 0 {
        return ValNumber(1)
    }
    return ValError(ERR_VALUE)
}

FnIndirect :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    text: [512] char = ""
    a1: int = 1
    pos: int = 0
    row: int = 0
    col: int = 0
    row2: int = 0
    col2: int = 0
    sheet: Sheet * = NULL
    is_range: int = 0
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    CoerceText(&args[0],text,sizeof(text))
    if count >= 2 {
        if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
        a1 = CoerceNumber(&args[1]) != 0 ? 1 : 0
    }
    if a1 != 0 {
        if TryParseReference(st,text,&pos,&row,&col,&row2,&col2,&sheet,&is_range) == 0 {
            return ValError(ERR_REF)
        }
    }
else {
        seg: int = 0
        rel: int = 0
        sheet = st->sheet
        if text[pos] != 'R' && text[pos] != 'r' { return ValError(ERR_REF) }
        pos += 1
        rel = ParseR1C1Index(text,&pos,&seg)
        if rel < 0 { return ValError(ERR_REF) }
        row = rel != 0 ? st->this_row + seg : seg
        if text[pos] != 'C' && text[pos] != 'c' { return ValError(ERR_REF) }
        pos += 1
        rel = ParseR1C1Index(text,&pos,&seg)
        if rel < 0 { return ValError(ERR_REF) }
        col = rel != 0 ? st->this_col + seg : seg
    }
    SkipFormulaSpace(text,&pos)
    if text[pos] != 0 { return ValError(ERR_REF) }
    if is_range != 0 {
        t_row: int = 0
        t_col: int = 0
        if row2 < row { swap: int = row; row = row2; row2 = swap }
        if col2 < col { swap2: int = col; col = col2; col2 = swap2 }
        if col == col2 {
            if st->this_row < row || st->this_row > row2 { return ValError(ERR_VALUE) }
            t_row = st->this_row
            t_col = col
        }
else if row == row2 {
            if st->this_col < col || st->this_col > col2 { return ValError(ERR_VALUE) }
            t_row = row
            t_col = st->this_col
        }
else {
            return ValError(ERR_VALUE)
        }
        row = t_row
        col = t_col
    }
    if row < 0 || row >= WB_MAX_ROWS || col < 0 || col >= WB_MAX_COLS { return ValError(ERR_REF) }
    st->pend_kind = 1
    st->pend_row = row
    st->pend_col = col
    st->pend_row2 = row
    st->pend_col2 = col
    res: Val = EvaluateCell(st,sheet,row,col)
    if res.kind == VAL_EMPTY { return ValNumber(0) }
    return res
}

FnOffset :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    a_row: int = 0
    a_col: int = 0
    b_row: int = 0
    b_col: int = 0
    gx: int = 0
    gl: int = 0
    i0: int = 0
    row_offset: int = 0
    col_offset: int = 0
    tmp: int = 0
    if st->call_refs[0].kind == 0 { return ValError(ERR_VALUE) }
    a_row = st->call_refs[0].row
    a_col = st->call_refs[0].col
    b_row = st->call_refs[0].row2
    b_col = st->call_refs[0].col2
    if GroupBounds(marks,count,0,&gx,&gl) == 0 {
        gx = 0
        gl = count
    }
    i0 = gx + gl
    if count < i0 + 2 { return ValError(ERR_VALUE) }
    if args[i0].kind == VAL_ERROR { return ValError(args[i0].err) }
    if args[i0 + 1].kind == VAL_ERROR { return ValError(args[i0 + 1].err) }
    row_offset = (int)CoerceNumber(&args[i0])
    col_offset = (int)CoerceNumber(&args[i0 + 1])
    a_row += row_offset
    a_col += col_offset
    if a_row < 0 || a_col < 0 || a_row >= WB_MAX_ROWS || a_col >= WB_MAX_COLS {
        return ValError(ERR_REF)
    }
    if count >= i0 + 3 {
        if args[i0 + 2].kind == VAL_ERROR { return ValError(args[i0 + 2].err) }
        tmp = (int)CoerceNumber(&args[i0 + 2])
        if tmp < 1 { return ValError(ERR_VALUE) }
        b_row = a_row + tmp - 1
    }
else {
        b_row += row_offset
    }
    if b_col < 0 || b_row >= WB_MAX_ROWS { return ValError(ERR_REF) }
    if count >= i0 + 4 {
        if args[i0 + 3].kind == VAL_ERROR { return ValError(args[i0 + 3].err) }
        tmp = (int)CoerceNumber(&args[i0 + 3])
        if tmp < 1 { return ValError(ERR_VALUE) }
        b_col = a_col + tmp - 1
    }
else {
        b_col += col_offset
    }
    if b_col < 0 || b_col >= WB_MAX_COLS { return ValError(ERR_REF) }
    if b_row != a_row || b_col != a_col {
        t_row: int = a_row
        t_col: int = a_col
        if a_col == b_col {
            if st->this_row < a_row || st->this_row > b_row { return ValError(ERR_VALUE) }
            t_row = st->this_row
        }
else if a_row == b_row {
            if st->this_col < a_col || st->this_col > b_col { return ValError(ERR_VALUE) }
            t_col = st->this_col
        }
else {
            return ValError(ERR_VALUE)
        }
        a_row = t_row
        a_col = t_col
        b_row = t_row
        b_col = t_col
    }
    st->pend_kind = 1
    st->pend_row = a_row
    st->pend_col = a_col
    st->pend_row2 = a_row
    st->pend_col2 = a_col
    res: Val = EvaluateCell(st,st->sheet,a_row,a_col)
    if res.kind == VAL_EMPTY { return ValNumber(0) }
    return res
}

FnHyperlink :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    if count >= 2 {
        if args[1].kind == VAL_ERROR { return ValError(args[1].err) }
        return ValCopy(&args[1])
    }
    return ValCopy(&args[0])
}

FnIsref :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 1 { return ValError(ERR_VALUE) }
    if st->call_refs[0].kind != 0 { return ValBool(1) }
    return ValBool(0)
}

FnColumnnumber :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    text: [512] char = ""
    pos: int = 0
    col: int = 0
    if count < 1 { return ValError(ERR_VALUE) }
    if args[0].kind == VAL_ERROR { return ValError(args[0].err) }
    CoerceText(&args[0],text,sizeof(text))
    if text[0] == 0 { return ValError(ERR_VALUE) }
    col = ParseColLetters(text,&pos)
    if col < 0 || text[pos] != 0 { return ValError(ERR_VALUE) }
    if col + 1 > WB_MAX_COLS { return ValError(ERR_VALUE) }
    return ValNumber(col + 1)
}

CriterionMatch :: (criterion: Val *, v: Val *) -> int {
    op: int = 0
    cmp: Val = {0}
    c: int = 0
    if criterion->kind == VAL_ERROR { return -1 }
    if v->kind == VAL_RANGE { return 0 }
    if criterion->kind == VAL_STRING {
        spec: CString = criterion->text
        if spec[0] == '>' && spec[1] == '=' { op = 4; spec += 2 }
        else if spec[0] == '<' && spec[1] == '=' { op = 5; spec += 2 }
        else if spec[0] == '<' && spec[1] == '>' { op = 2; spec += 2 }
        else if spec[0] == '>' { op = 6; spec += 1 }
        else if spec[0] == '<' { op = 3; spec += 1 }
        else if spec[0] == '=' { op = 1; spec += 1 }
        if TextLooksNumeric(spec) {
            cmp = ValNumber(strtod(spec,NULL))
        }
else {
            cmp = ValString(spec)
        }
    }
else {
        cmp = criterion[0]
    }
    if cmp.kind == VAL_STRING && v->kind == VAL_STRING {
        raw: int = strcasecmp(v->text,cmp.text)
        c = raw < 0 ? -1 : (raw > 0 ? 1 : 0)
    }
else if cmp.kind == VAL_STRING {
        if v->kind == VAL_EMPTY && cmp.text[0] == 0 {
            c = 0
        }
else {
            c = 1
        }
    }
else {
        c = CompareVals(v,&cmp)
        if c == -2 { return 0 }
    }
    if op == 0 || op == 1 { return c == 0 }
    if op == 2 { return c != 0 }
    if op == 3 { return c < 0 }
    if op == 4 { return c >= 0 }
    if op == 5 { return c <= 0 }
    return c > 0
}

ReduceHalfPos :: (x_in: double, pk: int *) -> double {
    x: double = x_in
    k: int = 0
    x = fmod(x,2)
    if x >= 1 {
        x -= 1
        k += 2
    }
    if x >= 0.5 {
        x -= 0.5
        k += 1
    }
    if x > 0.25 {
        x -= 0.5
        k += 1
    }
    pk[0] = k & 3
    return x
}

GoSinpi :: (x_in: double) -> double {
    x: double = x_in
    x0: double = x_in
    k: int = 0
    y: double = 0
    if x < 0 {
        k2: int = 0
        x = 0 - ReduceHalfPos(0 - x,&k2)
        k = 4 - k2
        if x == -0.25 {
            x += 0.5
            k += 3
        }
    }
else {
        x = ReduceHalfPos(x,&k)
    }
    if (x == 0 && (k & 1) == 0) { return copysign(0,x0) }
    if x == 0 {
        y = (k & 1) != 0 ? 1 : 0
    }
else if x == 0.25 {
        y = 0.707106781186547524400844362104849039284835937688474036588339
    }
else {
        if (k & 1) != 0 {
            y = cos(3.141592653589793 * x)
        }
else {
            y = sin(3.141592653589793 * x)
        }
    }
    if (k & 2) != 0 { return 0 - y }
    return y
}

BesselICore :: (x: double, nu: double, nb: int, bi: double *) -> int {
    nend: int = 0
    intx: int = 0
    nbmx: int = 0
    k: int = 0
    l: int = 0
    n: int = 0
    nstart: int = 0
    pold: double = 0
    test: double = 0
    p: double = 0
    em: double = 0
    en: double = 0
    empal: double = 0
    emp2al: double = 0
    halfx: double = 0
    aa: double = 0
    bb: double = 0
    cc: double = 0
    psave: double = 0
    plast: double = 0
    tover: double = 0
    psavel: double = 0
    sum: double = 0
    twonu: double = nu + nu
    const_: double = 1.585
    goto120: int = 0
    goto220: int = 0
    goto230: int = 0
    overflow_hit: int = 0
    if (nb > 0 && x >= 0 && nu >= 0 && nu < 1) {
        if x > 709 {
            k = 1
            while k <= nb {
                bi[k] = 1e308 * 10
                k += 1
            }
            return 1
        }
        intx = (int)x
        if x >= 1e-4 {
            nbmx = nb - intx
            n = intx + 1
            en = (double)(n + n) + twonu
            plast = 1
            p = en / x
            test = 1e16 + 1e16
            if (intx * 2 > 16 * 5) {
                test = sqrt(test * p)
            }
else {
                test /= pow(const_,(double)intx)
            }
            if nbmx >= 3 {
                tover = 1e308 / 1e16
                nstart = intx + 2
                nend = nb - 1
                k = nstart
                while k <= nend {
                    n = k
                    en += 2
                    pold = plast
                    plast = p
                    p = en * plast / x + pold
                    if p > tover {
                        overflow_hit = 1
                        tover = 1e308
                        p /= tover
                        plast /= tover
                        psave = p
                        psavel = plast
                        nstart = n + 1
                        while 1 {
                            n += 1
                            en += 2
                            pold = plast
                            plast = p
                            p = en * plast / x + pold
                            if p > 1 { break }
                        }
                        bb = en / x
                        test = pold * plast / 1e16
                        test *= 0.5 - 0.5 / (bb * bb)
                        p = plast * tover
                        n -= 1
                        en -= 2
                        nend = nb < n ? nb : n
                        l = nstart
                        while l <= nend {
                            pold = psavel
                            psavel = psave
                            psave = en * psavel / x + pold
                            if (psave * psavel > test) { break }
                            l += 1
                        }
                        goto120 = 1
                    }
                    if overflow_hit != 0 { break }
                    k += 1
                }
                if goto120 == 0 {
                    n = nend
                    en = (double)(n + n) + twonu
                    test = (test > sqrt(plast * 1e16) * sqrt(p + p) ? test : sqrt(plast * 1e16) * sqrt(p + p))
                }
            }
            if goto120 == 0 {
                while 1 {
                    n += 1
                    en += 2
                    pold = plast
                    plast = p
                    p = en * plast / x + pold
                    if p >= test { break }
                }
            }
            n += 1
            en += 2
            bb = 0
            aa = 1 / p
            em = (double)n - 1
            empal = em + nu
            emp2al = em - 1 + twonu
            sum = aa * empal * emp2al / em
            nend = n - nb
            if nend < 0 {
                bi[n] = aa
                nend = -nend
                l = 1
                while l <= nend {
                    bi[n + l] = 0
                    l += 1
                }
            }
else {
                if nend > 0 {
                    l = 1
                    while l <= nend {
                        n -= 1
                        en -= 2
                        cc = bb
                        bb = aa
                        if (nend > 100 && aa > 1e200) {
                            cc = ldexp(cc,-900)
                            bb = ldexp(bb,-900)
                            sum = ldexp(sum,-900)
                        }
                        aa = en * bb / x + cc
                        em -= 1
                        emp2al -= 1
                        if n == 1 { break }
                        if n == 2 { emp2al = 1 }
                        empal -= 1
                        sum = (sum + aa * empal) * emp2al / em
                        l += 1
                    }
                }
                bi[n] = aa
                if nb <= 1 {
                    sum = sum + sum + aa
                    goto230 = 1
                }
                if goto230 == 0 {
                    n -= 1
                    en -= 2
                    bi[n] = en * aa / x + bb
                    if n == 1 {
                        goto220 = 1
                    }
else {
                        em -= 1
                        if n == 2 {
                            emp2al = 1
                        }
else {
                            emp2al -= 1
                        }
                        empal -= 1
                        sum = (sum + bi[n] * empal) * emp2al / em
                    }
                }
            }
            if goto220 == 0 && goto230 == 0 {
                nend = n - 2
                if nend > 0 {
                    l = 1
                    while l <= nend {
                        n -= 1
                        en -= 2
                        bi[n] = en * bi[n + 1] / x + bi[n + 2]
                        em -= 1
                        if n == 2 {
                            emp2al = 1
                        }
else {
                            emp2al -= 1
                        }
                        empal -= 1
                        sum = (sum + bi[n] * empal) * emp2al / em
                        l += 1
                    }
                }
                bi[1] = 2 * empal * bi[2] / x + bi[3]
                sum = sum + sum + bi[1]
            }
            if goto220 != 0 {
                sum = sum + sum + bi[1]
            }
            if nu != 0 {
                sum *= tgamma(1 + nu) * pow(x * 0.5,-nu)
            }
            sum *= exp(-x)
            aa = 8.9e-308
            if sum > 1 { aa *= sum }
            n = 1
            while n <= nb {
                if bi[n] < aa {
                    bi[n] = 0
                }
else {
                    bi[n] /= sum
                }
                n += 1
            }
            return 0
        }
else {
            aa = 1
            empal = 1 + nu
            halfx = 0.5 * x
            if nu != 0 {
                aa = pow(halfx,nu) / tgamma(empal)
            }
            bb = halfx * halfx
            bi[1] = aa + aa * bb / empal
            if nb > 1 {
                if x == 0 {
                    n = 2
                    while n <= nb {
                        bi[n] = 0
                        n += 1
                    }
                }
else {
                    cc = halfx
                    tover = (8.9e-308 + 8.9e-308) / x
                    if bb != 0 { tover = 8.9e-308 / bb }
                    n = 2
                    while n <= nb {
                        aa /= empal
                        empal += 1
                        aa *= cc
                        if (aa <= tover * empal) {
                            bi[n] = 0
                            aa = 0
                        }
else {
                            bi[n] = aa + aa * bb / empal
                        }
                        n += 1
                    }
                }
            }
            return 0
        }
    }
    return 1
}

BesselI :: (x: double, alpha_in: double) -> double {
    alpha: double = alpha_in
    na: double = 0
    nb: int = 0
    bi: [64] double = {0}
    ncalc: int = 0
    if (x != x || alpha != alpha) { return x + alpha }
    if x < 0 { return 0.0 / 0.0 }
    na = floor(alpha)
    if alpha < 0 {
        if alpha == na { return BesselI(x,-alpha) }
        return BesselI(x,-alpha) + BesselK(x,-alpha) * 2 / 3.141592653589793 * GoSinpi(-alpha)
    }
    nb = 1 + (int)na
    if nb > 60 { nb = 60 }
    alpha -= (double)(nb - 1)
    ncalc = BesselICore(x,alpha,nb,bi)
    return bi[nb]
}

BesselKCore :: (x: double, nu_in: double, nb: int, bk: double *) -> int {
    nu: double = nu_in
    ex: double = x
    iend: int = 0
    i: int = 0
    j: int = 0
    k: int = 0
    m: int = 0
    ii: int = 0
    mplus1: int = 0
    x2by4: double = 0
    twox: double = 0
    c: double = 0
    blpha: double = 0
    ratio: double = 0
    wminf: double = 0
    d1: double = 0
    d2: double = 0
    d3: double = 0
    f0: double = 0
    f1: double = 0
    f2: double = 0
    p0: double = 0
    q0: double = 0
    t1: double = 0
    t2: double = 0
    twonu: double = 0
    dm: double = 0
    bk1: double = 0
    bk2: double = 0
    ncalc_v: int = 1
    a_const: double = 0.11593151565841244881
    p1: [8] double = {0.805629875690432845,20.4045500205365151,157.705605106676174,536.671116469207504,900.382759291288778,730.923886650660393,229.299301509425145,0.822467033424113231}
    q1: [7] double = {29.4601986247850434,277.577868510221208,1206.70325591027438,2762.91444159791519,3443.74050506564618,2210.63190113378647,572.267338359892221}
    r1: [5] double = {-0.48672575865218401848,13.079485869097804016,-101.96490580880537526,347.65409106507813131,3.495898124521934782e-4}
    s1: [4] double = {-25.579105509976461286,212.57260432226544008,-610.69018684944109624,422.69668805777760407}
    t1arr: [6] double = {1.6125990452916363814e-10,2.5051878502858255354e-8,2.7557319615147964774e-6,1.9841269840928373686e-4,0.0083333333333334751799,0.16666666666666666446}
    estm: [6] double = {52.0583,5.7607,2.7782,14.4303,185.3004,9.3715}
    estf: [7] double = {41.8341,7.1075,6.4306,42.511,1.35633,84.5096,20}
    sqrt2dpi: double = 0.797884560802865355879892119869
    twonu = nu + nu
    if (nb > 0 && nu >= 0 && nu < 1) {
        if (ex <= 0 || ex > 705.342) {
            i = 0
            while i < nb {
                if ex <= 0 {
                    bk[i] = 1e308 * 10
                }
else {
                    bk[i] = 0
                }
                i += 1
            }
            return 0
        }
        k = 0
        if (nu < 1.49e-154) {
            nu = 0
        }
else if nu > 0.5 {
            k = 1
            nu -= 1
        }
        twonu = nu + nu
        iend = nb + k - 1
        c = nu * nu
        d3 = -c
        if ex <= 1 {
            d1 = 0
            d2 = p1[0]
            t1 = 1
            t2 = q1[0]
            i = 2
            while i <= 7 {
                d1 = c * d1 + p1[i - 1]
                d2 = c * d2 + p1[i]
                t1 = c * t1 + q1[i - 1]
                t2 = c * t2 + q1[i]
                i += 2
            }
            d1 = nu * d1
            t1 = nu * t1
            f1 = log(ex)
            f0 = a_const + nu * (p1[7] - nu * (d1 + d2) / (t1 + t2)) - f1
            q0 = exp(-nu * (a_const - nu * (p1[7] + nu * (d1 - d2) / (t1 - t2)) - f1))
            f1 = nu * f0
            p0 = exp(f1)
            d1 = r1[4]
            t1 = 1
            i = 0
            while i < 4 {
                d1 = c * d1 + r1[i]
                t1 = c * t1 + s1[i]
                i += 1
            }
            if (fabs(f1) <= 0.5) {
                f1 *= f1
                d2 = 0
                i = 0
                while i < 6 {
                    d2 = f1 * d2 + t1arr[i]
                    i += 1
                }
                d2 = f0 + f0 * f1 * d2
            }
else {
                d2 = sinh(f1) / nu
            }
            f0 = d2 - nu * d1 / (t1 * p0)
            if ex <= 1e-10 {
                bk[0] = f0 + ex * f0
                bk[0] -= ex * bk[0]
                ratio = p0 / f0
                c = ex * 1.7976931348623157e308
                if k != 0 {
                    if bk[0] >= c / ratio {
                        return 1
                    }
                    bk[0] = ratio * bk[0] / ex
                    twonu += 2
                    ratio = twonu
                }
                if nb == 1 { return 0 }
                i = 1
                while i < nb {
                    if ratio >= c { return 1 }
                    bk[i] = ratio / ex
                    twonu += 2
                    ratio = twonu
                    i += 1
                }
                i = 1
                while i < nb {
                    bk[i] *= bk[i - 1]
                    i += 1
                }
                return 0
            }
else {
                c = 1
                x2by4 = ex * ex / 4
                p0 = 0.5 * p0
                q0 = 0.5 * q0
                d1 = -1
                d2 = 0
                bk1 = 0
                bk2 = 0
                f1 = f0
                f2 = p0
                while 1 {
                    d1 += 2
                    d2 += 1
                    d3 = d1 + d3
                    c = x2by4 * c / d2
                    f0 = (d2 * f0 + p0 + q0) / d3
                    p0 /= d2 - nu
                    q0 /= d2 + nu
                    t1 = c * f0
                    t2 = c * (p0 - d2 * f0)
                    bk1 += t1
                    bk2 += t2
                    if (fabs(t1 / (f1 + bk1)) <= 2.2204460492503131e-16 && fabs(t2 / (f2 + bk2)) <= 2.2204460492503131e-16) { break }
                }
                bk1 = f1 + bk1
                bk2 = 2 * (f2 + bk2) / ex
                wminf = estf[0] * ex + estf[1]
            }
        }
else if (2.2204460492503131e-16 * ex > 1) {
            i = 0
            while i < nb {
                bk[i] = 1 / (sqrt2dpi * sqrt(ex))
                i += 1
            }
            return 0
        }
else {
            twox = ex + ex
            blpha = 0
            ratio = 0
            if ex <= 4 {
                d2 = trunc(estm[0] / ex + estm[1])
                m = (int)d2
                d1 = d2 + d2
                d2 -= 0.5
                d2 *= d2
                i = 2
                while i <= m {
                    d1 -= 2
                    d2 -= d1
                    ratio = (d3 + d2) / (twox + d1 - ratio)
                    i += 1
                }
                d2 = trunc(estm[2] * ex + estm[3])
                m = (int)d2
                c = fabs(nu)
                d3 = c + c
                d1 = d3 - 1
                f1 = 2.2250738585072014e-308
                f0 = (2 * (c + d2) / ex + 0.5 * ex / (c + d2 + 1)) * 2.2250738585072014e-308
                i = 3
                while i <= m {
                    d2 -= 1
                    f2 = (d3 + d2 + d2) * f0
                    blpha = (1 + d1 / d2) * (f2 + blpha)
                    f2 = f2 / ex + f1
                    f1 = f0
                    f0 = f2
                    i += 1
                }
                f1 = (d3 + 2) * f0 / ex + f1
                d1 = 0
                t1 = 1
                i = 1
                while i <= 7 {
                    d1 = c * d1 + p1[i - 1]
                    t1 = c * t1 + q1[i - 1]
                    i += 1
                }
                p0 = exp(c * (a_const + c * (p1[7] - c * d1 / t1) - log(ex))) / ex
                f2 = (c + 0.5 - ratio) * f1 / ex
                bk1 = p0 + (d3 * f0 - f2 + f0 + blpha) / (f2 + f1 + f0) * p0
                bk1 *= exp(-ex)
                wminf = estf[2] * ex + estf[3]
            }
else {
                dm = trunc(estm[4] / ex + estm[5])
                m = (int)dm
                d2 = dm - 0.5
                d2 *= d2
                d1 = dm + dm
                i = 2
                while i <= m {
                    dm -= 1
                    d1 -= 2
                    d2 -= d1
                    ratio = (d3 + d2) / (twox + d1 - ratio)
                    blpha = (ratio + ratio * blpha) / dm
                    i += 1
                }
                bk1 = 1 / ((sqrt2dpi + sqrt2dpi * blpha) * sqrt(ex))
                bk1 *= exp(-ex)
                wminf = estf[4] * (ex - fabs(ex - estf[6])) + estf[5]
            }
            bk2 = bk1 + bk1 * (nu + 0.5 - ratio) / ex
        }
        bk[0] = bk1
        if iend == 0 { return 0 }
        j = 1 - k
        if j >= 0 { bk[j] = bk2 }
        if iend == 1 { return 0 }
        m = (int)(wminf - nu)
        if m > iend { m = iend }
        i = 2
        ii = 0
        while i <= m {
            t1 = bk1
            bk1 = bk2
            twonu += 2
            if ex < 1 {
                if (bk1 >= 1.7976931348623157e308 / twonu * ex) { break }
            }
else {
                if (bk1 / ex >= 1.7976931348623157e308 / twonu) { break }
            }
            bk2 = twonu / ex * bk1 + t1
            ii = i
            j += 1
            if j >= 0 { bk[j] = bk2 }
            i += 1
        }
        m = ii
        if m == iend { return 0 }
        ratio = bk2 / bk1
        mplus1 = m + 1
        i = mplus1
        while i <= iend {
            twonu += 2
            ratio = twonu / ex + 1 / ratio
            j += 1
            if j >= 1 {
                bk[j] = ratio
            }
else {
                if bk2 >= 1.7976931348623157e308 / ratio { return 1 }
                bk2 *= ratio
            }
            i += 1
        }
        ncalc_v = mplus1 - k
        if ncalc_v < 1 { ncalc_v = 1 }
        if ncalc_v == 1 { bk[0] = bk2 }
        if nb == 1 { return 0 }
        i = ncalc_v
        while i < nb {
            bk[i] *= bk[i - 1]
            i += 1
        }
        return 0
    }
    return 1
}

BesselK :: (x: double, alpha_in: double) -> double {
    alpha: double = alpha_in
    nb: int = 0
    bk: [64] double = {0}
    ncalc: int = 0
    if (x != x || alpha != alpha) { return x + alpha }
    if x < 0 { return 0.0 / 0.0 }
    if alpha < 0 { alpha = -alpha }
    nb = 1 + (int)floor(alpha)
    if nb > 60 { nb = 60 }
    alpha -= (double)(nb - 1)
    ncalc = BesselKCore(x,alpha,nb,bk)
    return bk[nb - 1]
}

FnBesseli :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 2 { return ValError(ERR_VALUE) }
    return ValNumber(BesselI(CoerceNumber(&args[0]),CoerceNumber(&args[1])))
}

FnBesselk :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    if count < 2 { return ValError(ERR_VALUE) }
    return ValNumber(BesselK(CoerceNumber(&args[0]),CoerceNumber(&args[1])))
}

FnBesselj :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    x: double = 0
    order: double = 0
    n: int = 0
    if count < 2 { return ValError(ERR_VALUE) }
    x = CoerceNumber(&args[0])
    order = CoerceNumber(&args[1])
    if (order < 0 || order != floor(order) || order > 1000) { return ValError(ERR_NUM) }
    n = (int)order
    if x < 0 {
        if (n % 2) != 0 { return ValNumber(0 - jn(n,-x)) }
        return ValNumber(jn(n,-x))
    }
    return ValNumber(jn(n,x))
}

FnBessely :: (st: EvalState *, args: Val *, count: int, marks: int *) -> Val {
    x: double = 0
    order: double = 0
    n: int = 0
    if count < 2 { return ValError(ERR_VALUE) }
    x = CoerceNumber(&args[0])
    order = CoerceNumber(&args[1])
    if (order < 0 || order != floor(order) || order > 1000) { return ValError(ERR_NUM) }
    if x < 0 { return ValError(ERR_NUM) }
    n = (int)order
    return ValNumber(yn(n,x))
}

