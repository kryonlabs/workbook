    if strcmp(name,"betaln") == 0 { return ValNumber(lbeta_go(CoerceNumber(&args[0]),CoerceNumber(&args[1]))) }
    if strcmp(name,"betadist") == 0 {
        x1: double = CoerceNumber(&args[0])
        al: double = CoerceNumber(&args[1])
        be: double = CoerceNumber(&args[2])
        aa: double = count >= 4 ? CoerceNumber(&args[3]) : 0
        bb: double = count >= 5 ? CoerceNumber(&args[4]) : 1
        if (x1 < aa || x1 > bb || aa >= bb || al <= 0 || be <= 0) { return ValError(ERR_NUM) }
        return ValNumber(pbeta((x1 - aa) / (bb - aa),al,be,1,0))
    }
    if strcmp(name,"betainv") == 0 {
        p1: double = CoerceNumber(&args[0])
        al2: double = CoerceNumber(&args[1])
        be2: double = CoerceNumber(&args[2])
        aa2: double = count >= 4 ? CoerceNumber(&args[3]) : 0
        bb2: double = count >= 5 ? CoerceNumber(&args[4]) : 1
        if (p1 < 0 || p1 > 1 || aa2 >= bb2 || al2 <= 0 || be2 <= 0) { return ValError(ERR_NUM) }
        return ValNumber(aa2 + (bb2 - aa2) * qbeta(p1,al2,be2,1,0))
    }
    if strcmp(name,"lognormdist") == 0 { return ValNumber(pnorm(log(CoerceNumber(&args[0])),CoerceNumber(&args[1]),CoerceNumber(&args[2]),1,0)) }
    if strcmp(name,"loginv") == 0 { return ValNumber(exp(qnorm(CoerceNumber(&args[0]),CoerceNumber(&args[1]),CoerceNumber(&args[2]),1,0))) }
    if strcmp(name,"expondist") == 0 {
        xe: double = CoerceNumber(&args[0])
        ye: double = CoerceNumber(&args[1])
        cuml: int = CoerceNumber(&args[2]) != 0 ? 1 : 0
        if (xe < 0 || ye <= 0) { return ValError(ERR_NUM) }
        if cuml != 0 { return ValNumber(pexp_go(xe,1 / ye,1,0)) }
        return ValNumber(dexp_go(xe,1 / ye))
    }
    if strcmp(name,"weibull") == 0 {
        xw: double = CoerceNumber(&args[0])
        aw: double = CoerceNumber(&args[1])
        bw: double = CoerceNumber(&args[2])
        cumw: int = CoerceNumber(&args[3]) != 0 ? 1 : 0
        if (xw < 0 || aw <= 0 || bw <= 0) { return ValError(ERR_NUM) }
        if cumw != 0 { return ValNumber(pweibull_go(xw,aw,bw,1,0)) }
        return ValNumber(dweibull_go(xw,aw,bw))
    }
    if strcmp(name,"poisson") == 0 {
        xp: double = floor(CoerceNumber(&args[0]))
        mp: double = CoerceNumber(&args[1])
        cump: int = CoerceNumber(&args[2]) != 0 ? 1 : 0
        if (xp < 0 || mp <= 0) { return ValError(ERR_NUM) }
        if cump != 0 { return ValNumber(ppois(xp,mp,1,0)) }
        return ValNumber(dpois(xp,mp,0))
    }
    if strcmp(name,"hypgeomdist") == 0 {
        xh: double = floor(CoerceNumber(&args[0]))
        nh: double = floor(CoerceNumber(&args[1]))
        Mh: double = floor(CoerceNumber(&args[2]))
        Nh: double = floor(CoerceNumber(&args[3]))
        cumh: int = count >= 5 ? (CoerceNumber(&args[4]) != 0 ? 1 : 0) : 0
        if (Nh < Mh || nh > Nh) { return ValError(ERR_NUM) }
        if cumh != 0 { return ValNumber(phyper(xh,Mh,Nh - Mh,nh,1,0)) }
        return ValNumber(dhyper(xh,Mh,Nh - Mh,nh,0))
    }
    if strcmp(name,"negbinomdist") == 0 {
        xn2: double = floor(CoerceNumber(&args[0]))
        rn: double = floor(CoerceNumber(&args[1]))
        pn: double = CoerceNumber(&args[2])
        if (xn2 + rn - 1 <= 0 || pn < 0 || pn > 1) { return ValError(ERR_NUM) }
        return ValNumber(dnbinom(xn2,rn,pn,0))
    }
    if strcmp(name,"critbinom") == 0 {
        tn: double = floor(CoerceNumber(&args[0]))
        pn2: double = CoerceNumber(&args[1])
        an: double = CoerceNumber(&args[2])
        if (tn < 0 || pn2 < 0 || pn2 > 1 || an < 0 || an > 1) { return ValError(ERR_NUM) }
        return ValNumber(qbinom(an,tn,pn2,1,0))
    }
    if strcmp(name,"tdist") == 0 {
        xt: double = CoerceNumber(&args[0])
        dt: double = CoerceNumber(&args[1])
        tl: double = CoerceNumber(&args[2])
        pt_: double = 0
        if dt < 1 { return ValError(ERR_NUM) }
        if tl == 1 {
            lt: int = 0
            if xt < 0 {
                lt = 1
                xt = -xt
            }
            pt_ = pt(xt,dt,lt,0)
        }
else if tl == 2 {
            if xt < 0 { return ValError(ERR_NUM) }
            pt_ = 2 * pt(xt,dt,0,0)
        }
else {
            return ValError(ERR_NUM)
        }
        return ValNumber(pt_)
    }
    if strcmp(name,"tinv") == 0 {
        pt2: double = CoerceNumber(&args[0])
        dt2: double = CoerceNumber(&args[1])
        res: double = 0
        if (pt2 < 0 || pt2 > 1 || dt2 < 1) { return ValError(ERR_NUM) }
        res = qt(pt2 / 2,dt2,0,0)
        if res < 0 { return ValError(ERR_NUM) }
        return ValNumber(res)
    }
    if strcmp(name,"binom.dist.range") == 0 {
