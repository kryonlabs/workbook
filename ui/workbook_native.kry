#import "kryon.h"

app "Workbook Native Smoke" {
    size 1180 720
    fps 30
}

state {
    section: [64] char = "banks"
    label: [64] char = "demo checking"
    row_id: [64] char = "USD"
    units: [64] char = "1250.00"
    notes: [128] char = "startup snapshot"
    scratch: [4096] char = ""
    section_cursor: int = 5
    label_cursor: int = 13
    row_cursor: int = 3
    units_cursor: int = 7
    notes_cursor: int = 16
    notes_scroll: int = 0
    scratch_cursor: int = 0
    scratch_scroll: int = 0
    action: int = 0
}

workbook_frame :: () #ui {
    Screen root: {
        Column workbook_form: {
            bounds = {24, 24, 520, 360}
            gap = 8
            padding = 8
            key = Key("workbook-form")
            Text("Workbook", 0, 0, Text20, GetThemeText())
            Text("Section", 0, 0, Text14, GetThemeText())
            TextField((TextFieldProps){.bounds = {0,0,360,32}, .text = section, .text_size = sizeof(section), .cursor_position = &section_cursor, .focused = NULL, .max_codepoints = 63, .font = Text16, .focus_id = 1001})
            Text("Label", 0, 0, Text14, GetThemeText())
            TextField((TextFieldProps){.bounds = {0,0,360,32}, .text = label, .text_size = sizeof(label), .cursor_position = &label_cursor, .focused = NULL, .max_codepoints = 63, .font = Text16, .focus_id = 1002})
            Text("Row", 0, 0, Text14, GetThemeText())
            TextField((TextFieldProps){.bounds = {0,0,180,32}, .text = row_id, .text_size = sizeof(row_id), .cursor_position = &row_cursor, .focused = NULL, .max_codepoints = 63, .font = Text16, .focus_id = 1003})
            Text("Units", 0, 0, Text14, GetThemeText())
            TextField((TextFieldProps){.bounds = {0,0,180,32}, .text = units, .text_size = sizeof(units), .cursor_position = &units_cursor, .focused = NULL, .max_codepoints = 63, .font = Text16, .focus_id = 1004})
            TextArea((TextAreaProps){.bounds = {0,0,360,72}, .text = notes, .text_size = sizeof(notes), .cursor_position = &notes_cursor, .focused = NULL, .scroll_y = &notes_scroll, .max_codepoints = 127, .font = Text16, .line_gap = 4, .focus_id = 1005, .placeholder = "Notes"})
            TextArea((TextAreaProps){.bounds = {0,0,360,80}, .text = scratch, .text_size = sizeof(scratch), .cursor_position = &scratch_cursor, .focused = NULL, .scroll_y = &scratch_scroll, .max_codepoints = 4095, .font = Text16, .line_gap = 4, .focus_id = 1006, .placeholder = "Scratch"})
            Row workbook_actions: {
                bounds = {0,0,360,40}
                gap = 8
                padding = 0
                key = Key("workbook-actions")
                if Button((ButtonProps){.bounds = {0,0,88,32}, .label = "Save", .style = ButtonStylePrimary, .font = Text16, .id = 1101}) {
                    action += 1
                }
                if Button((ButtonProps){.bounds = {0,0,88,32}, .label = "Add Row", .style = ButtonStyleSecondary, .font = Text16, .id = 1102}) {
                    action += 10
                }
            }
        }
    }
}
